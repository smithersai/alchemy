{
  "extends": "../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.vibe"],
  // Starters: each runs the .vibe module of the same name under Node with
  // VibeLang's loader. Compiling both would emit one .js twice (TS5056).
  "exclude": [
    "node_modules",
    "ensure-built.ts",
    "generate-iam-actions.ts",
    "lint-providers.ts",
    "sync-exports.ts",
    "test-aws-floci.ts",
    "test-example-cli.ts",
    "test-examples.ts",
    "validate-publish-packages.ts",
    "release/discord-notify.ts",
    "release/github-release.ts",
    "release/prepare.ts",
    "release/publish.ts",
    "release/release-notes.ts"
  ],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "../.cache/tsconfig.scripts.tsbuildinfo",
    "types": ["node"]
  },
  "references": [
    { "path": "../submodules/distilled/packages/aws/tsconfig.json" },
    { "path": "../packages/aws/tsconfig.json" }
  ]
}
