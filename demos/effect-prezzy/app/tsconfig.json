{
  "extends": "../../../tsconfig.base.json",
  "include": [
    "alchemy.run.ts",
    "src/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/vite.config.ts",
    "alchemy.run.vibe",
    "alchemy.stack.vibe",
    "src/**/*.vibe",
    "web/src/**/*.vibe",
    "web/src/**/*.vibex",
    "web/vite.config.vibe"
  ],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "types": ["bun", "@cloudflare/workers-types", "vite/client"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext"
  },
  "references": [{ "path": "../../../packages/alchemy/tsconfig.json" }]
}
