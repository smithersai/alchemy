import * as AWS from "@alchemy.run/aws"
import * as Cloudflare from "@alchemy.run/cloudflare"
import { Queues, R2 } from "@alchemy.run/cloudflare"
import * as Alchemy from "alchemy"

// #region show
const api = effect {
  return try effect {
    provide R2.ReadBucketBinding, Queues.WriteQueueBinding {
      return try effect {
        const bucket = try R2.Bucket("Uploads")
        const uploads = try R2.ReadBucket(bucket)
        const queue = try Queues.Queue("Jobs")
        const jobs = try Queues.WriteQueue(queue)
        return {
          fetch: effect {
            return try (effect {
              const file = try uploads.get("hello.txt")
              try jobs.send({ size: file?.size })
              return HttpServerResponse.text("ok")
            }
              |> Effect.orDie(%))
          }, /*end*/
        }
      }
    }
  }
}
// #endregion show
