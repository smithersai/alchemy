import * as AWS from "@alchemy.run/aws"
import * as Layer from "effect/Layer"
import { Files, UploadError } from "./Files.ts"

// #region show
export const FilesS3 = Layer.effect(
  Files,
  effect {
    const bucket = try AWS.S3.Bucket("Files")
    const putObject = try AWS.S3.PutObject(bucket)

    return {
      upload: effect (name: string, body: string) =>
        (effect { return (try (putObject({ Key: name, Body: body })
          |> Effect.asVoid(%))) }) catch effect (cause) => {
            throw new UploadError({ cause })
          }, /*end*/
    }
  },
) /*hide*/
  .pipe(Layer.provide(AWS.S3.PutObjectHttp)) /*end*/
// #endregion show
