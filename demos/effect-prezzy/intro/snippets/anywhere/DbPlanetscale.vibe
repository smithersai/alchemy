import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Planetscale from "@alchemy.run/planetscale"
import * as Postgres from "@alchemy.run/sql/Postgres"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"

// #region show
export const DatabaseLive = Layer.unwrap(
  effect {
    const database = try Planetscale.PostgresDatabase("Db", {
      clusterSize: "PS_10",
      arch: "arm",
    })
    const db = try Planetscale.PostgresRole("Db", { database, inheritedRoles: ["postgres"] })
    const pool = try Cloudflare.Hyperdrive.Connection("Pool", { origin: db.origin })
    const connection = try Cloudflare.Hyperdrive.Connect(pool)
    return Postgres.PostgresLayer({ url: connection.connectionString })
  },
) /*hide*/
  .pipe(Layer.provide(Cloudflare.Hyperdrive.ConnectBinding)) /*end*/
// #endregion show
