import * as AWS from "@alchemy.run/aws"
import * as Effect from "effect/Effect"

// #region show
export default AWS.Lambda.Function(
  "Archive",
  { main: import.meta.url },
  effect {
    return try effect {
      provide AWS.Lambda.QueueEventSource {
        return try effect {
          const source = try AWS.SQS.Queue("Messages")

          try AWS.SQS.consumeQueueMessages(
            source,
            effect (event) => {
              try Effect.log(event.Records)
            },
          )

          return {}
        }
      }
    }
  },
)
// #endregion show
