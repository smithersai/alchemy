import * as Kubernetes from "@alchemy.run/kubernetes"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Files, FilesGCS } from "./Files.ts"
import { Gke } from "./Gke.ts"

// #region show
export default Kubernetes.Deployment(
  "Api",
  effect {
    return { main: import.meta.url, cluster: try Gke, port: 3000 }
  },
  effect {
    return try effect {
      provide FilesGCS {
        return try effect {
          const files = try Effect.service(Files)
          return {
            fetch: effect {
              return try (effect {
                const request = try Effect.service(HttpServerRequest)
                try files.upload(request.url, try request.text)
                return HttpServerResponse.empty({ status: 201 })
              }
                |> Effect.orDie(%))
            }, /*end*/
          }
        }
      }
    }
  },
)
// #endregion show
