import * as Kubernetes from "@alchemy.run/kubernetes"
import * as Effect from "effect/Effect"
import { Files, FilesGCS } from "./Files.ts"
import { Gke } from "./Gke.ts"

// #region show
export default Kubernetes.Job(
  "Report",
  effect {
    return { main: import.meta.url, cluster: try Gke }
  },
  effect {
    return try effect {
      provide FilesGCS {
        return try effect {
          const files = try Effect.service(Files)
          return {
            run: effect {
              const report = `generated at ${new Date().toISOString()}`
              try files.upload("report.txt", report)
            },
          }
        }
      }
    }
  },
)
// #endregion show
