import * as Railway from "@alchemy.run/railway"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Files, FilesRailway } from "./Files.ts"
import { Chat } from "./Hosts.ts"

// #region show
export default Railway.Service(
  "Api",
  effect {
    return { main: import.meta.url, project: try Chat }
  },
  effect {
    return try effect {
      provide FilesRailway {
        return try effect {
          const files = try Effect.service(Files)
          return {
            fetch: effect {
              return try (effect {
                const request = try Effect.service(HttpServerRequest)
                try files.upload(request.url, try request.text)
                return HttpServerResponse.empty({ status: 201 })
              }
                |> Effect.orDie(%))
            }, /*end*/
          }
        }
      }
    }
  },
)
// #endregion show
