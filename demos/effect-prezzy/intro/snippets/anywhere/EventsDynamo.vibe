import * as AWS from "@alchemy.run/aws"
import * as Effect from "effect/Effect"

// #region show
export default AWS.Lambda.Function(
  "Archive",
  { main: import.meta.url },
  effect {
    return try effect {
      provide AWS.Lambda.TableEventSource {
        return try effect {
          const source = try AWS.DynamoDB.Table("Messages", {
            partitionKey: "room",
            attributes: { room: "S" },
          })

          try AWS.DynamoDB.consumeTableChanges(
            source,
            { streamViewType: "NEW_IMAGE" },
            effect (event) => {
              try Effect.log(event.Records)
            },
          )

          return {}
        }
      }
    }
  },
)
// #endregion show
