import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"
import { Files, FilesR2 } from "./Files.ts"
import { summarize } from "./Summarize.vibe"

// #region show
export default class Digest extends Cloudflare.Workflow<Digest>()(
  "Digest",
  effect {
    return try effect {
      provide FilesR2 {
        return try effect {
          const files = try Effect.service(Files)

          return effect (input: { room: string }) => {
            const summary = try Cloudflare.Workflows.task("summarize", summarize(input.room))
            try Cloudflare.Workflows.sleep("wait", "1 day")
            try Cloudflare.Workflows.task("save", files.upload(`${input.room}.txt`, summary))
          }
        }
      }
    }
  },
) {}
// #endregion show
