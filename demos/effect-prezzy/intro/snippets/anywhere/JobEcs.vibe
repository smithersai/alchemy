import * as AWS from "@alchemy.run/aws"
import * as Effect from "effect/Effect"
import { Files, FilesS3 } from "./Files.ts"

// #region show
export default AWS.ECS.Task(
  "Report",
  effect {
    return { main: import.meta.url }
  },
  effect {
    return try effect {
      provide FilesS3 {
        return try effect {
          const files = try Effect.service(Files)
          return {
            run: effect {
              const report = `generated at ${new Date().toISOString()}`
              try files.upload("report.txt", report)
            },
          }
        }
      }
    }
  },
)
// #endregion show
