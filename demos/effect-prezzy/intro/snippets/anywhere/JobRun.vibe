import * as GCP from "@alchemy.run/gcp"
import * as Effect from "effect/Effect"
import { Files, FilesGCS } from "./Files.ts"

// #region show
export default GCP.Run.Job(
  "Report",
  effect {
    return { main: import.meta.url }
  },
  effect {
    return try effect {
      provide FilesGCS {
        return try effect {
          const files = try Effect.service(Files)
          return {
            run: effect {
              const report = `generated at ${new Date().toISOString()}`
              try files.upload("report.txt", report)
            },
          }
        }
      }
    }
  },
)
// #endregion show
