import * as AWS from "@alchemy.run/aws"
import * as Effect from "effect/Effect"
import { Files, FilesS3 } from "./Files.ts"
import { summarize } from "./Summarize.vibe"

// #region show
export default class Digest extends AWS.Lambda.DurableFunction<Digest>()(
  "Digest",
  { main: import.meta.url },
  effect {
    return try effect {
      provide FilesS3 {
        return try effect {
          const files = try Effect.service(Files)

          return effect (input: { room: string }) => {
            const summary = try AWS.Lambda.Durable.step("summarize", summarize(input.room))
            try AWS.Lambda.Durable.sleep("wait", "1 day")
            try AWS.Lambda.Durable.step("save", files.upload(`${input.room}.txt`, summary))
          }
        }
      }
    }
  },
) {}
// #endregion show
