import * as AWS from "@alchemy.run/aws"
import * as Alchemy from "alchemy"
import * as Effect from "effect/Effect"
import * as Schedule from "effect/Schedule"
import { database } from "./database.vibe"

// One atomic, replay-safe initial migration. Application roles never own DDL.
const initialMigration = `DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'app_iam') THEN
    CREATE ROLE app_iam LOGIN;
  END IF;
  GRANT rds_iam TO app_iam;
  REVOKE CREATE ON SCHEMA public FROM PUBLIC;
  CREATE TABLE IF NOT EXISTS public.todos (
    id uuid PRIMARY KEY,
    title text NOT NULL,
    done boolean NOT NULL DEFAULT false
  );
  GRANT CONNECT ON DATABASE app TO app_iam;
  GRANT USAGE ON SCHEMA public TO app_iam;
  GRANT SELECT, INSERT, UPDATE, DELETE ON public.todos TO app_iam;
END $$`

export const bootstrap = effect {
  const db = try database
  // Alchemy.Action carries no @throws contract; a synchronous throw stays a
  // defect, as it was inside Effect.gen.
  const Bootstrap = try Effect.orDie(
    Effect.try({
      try: () =>
        Alchemy.Action(
          "BootstrapDatabase",
          effect {
            const execute = try AWS.RDSData.ExecuteStatement(db.cluster, {
              secret: db.secret,
              database: "app",
            })
            return effect (input: { writer: string; sql: string }) => {
              try execute({ sql: input.sql }).pipe(
                Effect.retry({
                  while: (error) =>
                    error._tag === "DatabaseUnavailableException"
                    || error._tag === "DatabaseResumingException",
                  schedule: Schedule.spaced("5 seconds"),
                  times: 8,
                }),
              )
              return "1"
            }
          } |> Effect.provide(%, AWS.RDSData.ExecuteStatementHttp),
        ),
      catch: (e) => e,
    }),
  )
  return try Bootstrap({
    writer: db.writer.dbInstanceArn,
    sql: initialMigration,
  })
}
