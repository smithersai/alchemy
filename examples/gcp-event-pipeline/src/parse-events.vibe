import * as Effect from "effect/Effect"
import type { EventRow } from "./resources.vibe"

/** Decode a pulled batch before inserting or acknowledging any of its messages. */
export effect function parseEvents(messages: ReadonlyArray<{ readonly text: string }>) {
  return try Effect.orDie(Effect.try({
    try: () => messages.map((message) => JSON.parse(message.text) as EventRow),
    catch: (e) => e,
  }))
}
