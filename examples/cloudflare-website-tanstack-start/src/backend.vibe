import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"

export const Bucket = Cloudflare.R2.Bucket("Bucket", { forceDestroy: true })

export default class Backend extends Cloudflare.Worker<Backend>()(
  "Backend",
  {
    main: import.meta.url,
  },
  effect {
    const bucket = try Cloudflare.R2.ReadWriteBucket(Bucket)

    return {
      // RPC method — read an object from R2 by key, returning the body as
      // text or `null` if the key is missing. Other workers can call this
      // directly via the service binding (option 3 in `api.hello.ts`).
      hello: Effect.fn("Backend.hello")(effect (key: string) => {
        const object = try bucket.get(key)
        if (object === null) return null
        return try object.text()
      }),

      // HTTP handler — supports `GET` and `PUT` against R2 by `?key=...`.
      // Other workers can call this via `env.BACKEND.fetch(...)` (option 2
      // in `api.hello.ts`).
      fetch: effect {
        const request = try HttpServerRequest
        const key = new URL(request.url, "http://backend").searchParams.get("key")
        if (!key) {
          return HttpServerResponse.text("Missing 'key' query parameter", {
            status: 400,
          })
        }

        if (request.method === "GET") {
          const object = try bucket.get(key)
          if (object === null) {
            return HttpServerResponse.text("Not found", { status: 404 })
          }
          return HttpServerResponse.stream(object.body)
        }

        if (request.method === "PUT") {
          try bucket.put(key, request.stream, {
            contentLength: Number(request.headers["content-length"] ?? 0),
          })
          return HttpServerResponse.empty({ status: 204 })
        }

        return HttpServerResponse.text("Method not allowed", { status: 405 })
      }.pipe(
        Effect.catchTag("R2Error", (error) => Effect.succeed(HttpServerResponse.text(error.message, { status: 500 }))),
      ),
    }
  }.pipe(Effect.provide(Cloudflare.R2.ReadWriteBucketBinding)),
) {}
