import * as Drizzle from "@alchemy.run/drizzle/Postgres"
import * as GCP from "@alchemy.run/gcp"
import { eq } from "drizzle-orm"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import * as Schema from "effect/Schema"
import { database } from "./database.vibe"
import { todos } from "./schema.ts"

const Id = Schema.String.check(Schema.isUUID())

/**
 * A todo API on Cloud Run backed by Cloud SQL for PostgreSQL.
 *
 * `GCP.SQL.Connect` mounts the instance's Unix socket into the revision
 * and grants the runtime service account `roles/cloudsql.client` on this
 * instance only; Drizzle then talks Postgres over
 * `/cloudsql/{connectionName}`. Binding the database makes the service
 * deploy after its migrations are applied.
 */
export default class Api extends GCP.Function<Api>()(
  "Api",
  effect {
    const { schema } = try database
    return {
      main: import.meta.url,
      invokerIamDisabled: true,
      // Rolls a new revision whenever the schema changes.
      env: { SCHEMA_VERSION: schema.snapshotHash },
    }
  },
  effect {
    const { instance, db: appDb, user, passwordSecret } = try database
    const connect = try GCP.SQL.Connect(instance, {
      database: appDb,
      user,
      passwordSecret,
    })
    const db = try Drizzle.Postgres(connect.pipe(Effect.map((info) => info.url)))

    return {
      fetch: effect {
        const request = try HttpServerRequest
        const url = new URL(request.originalUrl, "http://localhost")

        if (request.method === "GET" && url.pathname === "/") {
          return HttpServerResponse.text("ok")
        }
        if (url.pathname === "/todos" && request.method === "GET") {
          const query = try Effect.orDie(
            Effect.try({ try: () => db.select().from(todos).orderBy(todos.title), catch: (e) => e }),
          )
          return try HttpServerResponse.json(try query)
        }
        if (url.pathname === "/todos" && request.method === "POST") {
          const input = try request.json.pipe(
            Effect.flatMap(
              Schema.decodeUnknownEffect(Schema.Struct({ id: Id, title: Schema.NonEmptyString })),
            ),
          )
          const query = try Effect.orDie(
            Effect.try({ try: () => db.insert(todos).values(input).returning(), catch: (e) => e }),
          )
          return try HttpServerResponse.json(try query, {
            status: 201,
          })
        }
        if (url.pathname.startsWith("/todos/")) {
          const id = try Schema.decodeUnknownEffect(Id)(url.pathname.slice("/todos/".length))
          if (request.method === "GET") {
            const query = try Effect.orDie(
              Effect.try({ try: () => db.select().from(todos).where(eq(todos.id, id)), catch: (e) => e }),
            )
            const [todo] = try query
            return todo
              ? try HttpServerResponse.json(todo)
              : HttpServerResponse.text("Not found", { status: 404 })
          }
          if (request.method === "PATCH") {
            const input = try request.json.pipe(
              Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ done: Schema.Boolean }))),
            )
            const query = try Effect.orDie(
              Effect.try({
                try: () => db.update(todos).set(input).where(eq(todos.id, id)).returning(),
                catch: (e) => e,
              }),
            )
            const [todo] = try query
            return todo
              ? try HttpServerResponse.json(todo)
              : HttpServerResponse.text("Not found", { status: 404 })
          }
          if (request.method === "DELETE") {
            const query = try Effect.orDie(
              Effect.try({ try: () => db.delete(todos).where(eq(todos.id, id)), catch: (e) => e }),
            )
            try query
            return HttpServerResponse.empty({ status: 204 })
          }
        }
        return HttpServerResponse.text("Not found", { status: 404 })
      }.pipe(
        Effect.catchTag(
          "SchemaError",
          () => Effect.succeed(HttpServerResponse.text("Invalid request", { status: 400 })),
        ),
        Effect.orDie,
      ),
    }
  }.pipe(Effect.provide(GCP.SQL.ConnectHttp)),
) {}
