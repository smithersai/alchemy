import * as GCP from "@alchemy.run/gcp"
import * as Alchemy from "alchemy"
import * as Effect from "effect/Effect"
import * as Redacted from "effect/Redacted"
import { database } from "./database.vibe"

/**
 * Writes the app user's password as the secret's latest version at deploy
 * time, so the service can read it at runtime.
 */
export const storePassword = effect {
  const { password, passwordSecret } = try database

  // Alchemy.Action carries no @throws contract; a synchronous throw stays a
  // defect, as it was inside Effect.gen.
  const StorePassword = try Effect.orDie(
    Effect.try({
      try: () =>
        Alchemy.Action(
          "StorePassword",
          effect {
            const secret = try GCP.SecretManager.ReadWriteSecret(passwordSecret)
            return effect (input: { password: Redacted.Redacted<string> }) => {
              const value = Redacted.value(input.password)
              if ((try secret.access()) !== value) {
                try secret.addVersion(value)
              }
            }
          } |> Effect.provide(%, GCP.SecretManager.ReadWriteSecretHttp),
        ),
      catch: (e) => e,
    }),
  )

  return try StorePassword({ password: password.text })
}
