import * as AWS from "@alchemy.run/aws"
import * as Effect from "effect/Effect"
import { JobNotificationsSNS } from "./JobNotifications.vibe"
import { JobRpcHttpEffect } from "./JobRpcApi.vibe"
import { JobStorageDynamoDB } from "./JobStorage.vibe"

export default class JobFunction extends AWS.Lambda.Function<JobFunction>()(
  "JobFunction",
  {
    main: import.meta.url,
    functionUrl: true,
  },
  effect {
    return try effect {
      provide Layer.mergeAll(JobStorageDynamoDB, JobNotificationsSNS) {
        return try effect {
          const fetch = try JobRpcHttpEffect
          return ({ fetch })
        }
      }
    }
  },
) {}
