import { randomUUID } from "./crypto.platform.ts"
import { Job, JobId } from "./Job.vibe"
import { JobNotifications } from "./JobNotifications.vibe"
import { JobStorage } from "./JobStorage.vibe"

export class JobNotFound extends Schema.TaggedClass<JobNotFound>()("JobNotFound", {
  jobId: JobId,
}) {}

export class GetJobFailed extends Schema.TaggedClass<GetJobFailed>()("GetJobFailed", {
  message: Schema.String,
}) {}

export class PutJobFailed extends Schema.TaggedClass<PutJobFailed>()("PutJobFailed", {
  message: Schema.String,
}) {}

const getJob = Rpc.make("getJob", {
  success: Job,
  error: Schema.Union([JobNotFound, GetJobFailed]),
  payload: { jobId: JobId },
})

const createJob = Rpc.make("createJob", {
  success: JobId,
  error: PutJobFailed,
  payload: { content: Schema.String },
})

export class JobRpcs extends RpcGroup.make(getJob, createJob) {}

export const JobRpcsLive = JobRpcs.toLayer(
  Effect.gen(function*() {
    const jobService = yield* JobStorage
    const notifications = yield* JobNotifications

    return {
      getJob: ({ jobId }) =>
        jobService.getJob(jobId).pipe(
          Effect.mapError((error) => new GetJobFailed({ message: error.message })),
          Effect.flatMap((job) => job ? Effect.succeed(job) : Effect.fail(new JobNotFound({ jobId }))),
        ),
      createJob: ({ content }) =>
        effect {
          const jobId = try randomUUID()
          const job = try jobService.putJob({ id: jobId, content })
          try notifications.notifyJobCreated(job)
          return job.id
        } |> Effect.mapError(%, (error) => new PutJobFailed({ message: error.message })),
    }
  }),
)

export const JobRpcHttpEffect = RpcServer.toHttpEffect(JobRpcs)
  |> Effect.provide(%, Layer.mergeAll(JobRpcsLive, RpcSerialization.layerJson))
