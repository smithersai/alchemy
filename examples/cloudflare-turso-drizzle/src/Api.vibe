import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Drizzle from "@alchemy.run/drizzle/LibSQL"
import * as Turso from "@alchemy.run/turso"
import * as Effect from "effect/Effect"
import * as HttpServerRequest from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Template, Tenants } from "./Db.vibe"
import { Notes } from "./schema.ts"

export default class Api extends Cloudflare.Worker<Api>()(
  "Api",
  {
    main: import.meta.url,
  },
  effect {
    const tenants = try Turso.ManageDatabases(Tenants)
    const template = try Template
    const templateName = try template.name.asEffect()

    return {
      fetch: effect {
        const request = try HttpServerRequest.HttpServerRequest
        // /tenants/:tenant/notes
        const [, root, tenant, resource] = new URL(request.url, "http://api").pathname.split("/")
        if (root !== "tenants") {
          return try HttpServerResponse.json({ error: "Not found" }, { status: 404 })
        }

        if (tenant === undefined || tenant === "") {
          const databases = try tenants.list()
          const template = try templateName
          return try HttpServerResponse.json({
            tenants: databases.map((d) => d.name).filter((name) => name !== template),
          })
        }

        if (resource === undefined) {
          switch (request.method) {
            case "POST": {
              const database = try tenants.create(tenant, {
                seed: { type: "database", name: try templateName },
              })
              return try HttpServerResponse.json({ tenant: database })
            }
            case "DELETE": {
              try tenants.delete(tenant)
              return try HttpServerResponse.json({ deleted: tenant })
            }
          }
        }

        if (resource === "notes") {
          const db = try Drizzle.LibSQL(
            try Effect.orDie(Effect.try({ try: () => tenants.connect(tenant), catch: (e) => e })),
          )
          switch (request.method) {
            case "GET": {
              const notes = try (try Effect.orDie(Effect.try({
                try: () => db.select().from(Notes),
                catch: (e) => e,
              })))
              return try HttpServerResponse.json({ notes })
            }
            case "POST": {
              const { body } = (try request.json) as { body: string }
              const [note] = try (try Effect.orDie(Effect.try({
                try: () => db.insert(Notes).values({ body }).returning(),
                catch: (e) => e,
              })))
              return try HttpServerResponse.json({ note })
            }
          }
        }

        return try HttpServerResponse.json({ error: "Method not allowed" }, { status: 405 })
      }.pipe(
        Effect.catchCause((cause) => HttpServerResponse.json({ error: String(cause) }, { status: 500 })),
      ),
    }
  }.pipe(Effect.provide(Turso.ManageDatabasesHttp)),
) {}
