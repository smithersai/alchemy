import * as Fly from "@alchemy.run/fly"
import * as Effect from "effect/Effect"
import Users from "./users.vibe"

const ORDERS = [
  { id: "o1", userId: "u1", item: "keyboard" },
  { id: "o2", userId: "u2", item: "monitor" },
]

/**
 * Private Service that calls {@link Users} through a binding. Binding
 * `Users` makes Orders deploy after it and hands Orders a typed client.
 */
export default class Orders extends Fly.Service<Orders>()(
  "Orders",
  effect {
    return {
      main: import.meta.url,
      public: false,
      network: try Fly.stackNetwork,
    }
  },
  effect {
    const users = try Fly.bindService(Users)
    return {
      list: effect () =>
        try Effect.forEach(ORDERS, effect (order) =>
          try effect {
            const user = try users.get(order.userId)
            return ({ ...order, user })
          }),
    }
  },
) {}
