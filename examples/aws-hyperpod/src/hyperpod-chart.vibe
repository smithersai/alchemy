import { $platform } from "./hyperpod-chart.platform.js"
import * as Alchemy from "alchemy"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"

const run = effect (bin: string, args: string[], cwd?: string | undefined) => {
  const spawner = try ChildProcessSpawner.ChildProcessSpawner
  const result = try (ChildProcess.make(bin, args, {
    cwd,
    stdin: "ignore",
    stdout: "pipe",
    stderr: "pipe",
    detached: false,
    extendEnv: true,
  }).pipe(
    spawner.spawn,
    Effect.flatMap((child) =>
      Effect.all(
        {
          exitCode: child.exitCode,
          stderr: child.stderr.pipe(Stream.decodeText, Stream.mkString),
        },
        { concurrency: "unbounded" },
      )
    ),
  ))
  if (result.exitCode !== 0) {
    throw new Error(`${bin} ${args.join(" ")} exited ${result.exitCode}: ${result.stderr}`)
  }
}

/**
 * Deploy-time Action that fetches the AWS HyperPod Helm chart (the
 * MANDATORY dependencies — health-monitoring agent, training operators,
 * device plugins, RBAC — that SageMaker validates before an EKS-orchestrated
 * cluster will attach) and vendors its subcharts. Returns the local chart
 * path for `Kubernetes.HelmChart` to render.
 */
export const FetchHyperPodChart = Alchemy.Action("FetchHyperPodChart", effect (input: { repo: string }) => {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const cwd = try $platform()
  const cloneDir = path.join(cwd, ".alchemy", "cache", "hyperpod-cli")
  if (!(try fs.exists(path.join(cloneDir, "helm_chart")))) {
    try run("git", ["clone", "--depth", "1", input.repo, cloneDir])
  }
  const chartPath = path.join(cloneDir, "helm_chart", "HyperPodHelmChart")
  try run("helm", ["dependency", "update", chartPath])
  return { chartPath }
})
