import { CloudflareD1 } from "@alchemy.run/better-auth/CloudflareD1"
import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import { Auth } from "./auth.vibe"
import { AuthDb } from "./database.vibe"
import { HttpLive } from "./http.vibe"

export default class AuthApi extends Cloudflare.Worker<AuthApi>()(
  "AuthApi",
  {
    main: import.meta.url,
    compatibility: { flags: ["nodejs_compat"] },
    assets: { directory: "./public" },
  },
  effect {
    const auth = try Auth
    const http = try HttpRouter.toHttpEffect(HttpLive)
    return {
      fetch: effect {
        const request = try HttpServerRequest
        const pathname = new URL(request.url, "http://localhost").pathname
        if (pathname === "/api/auth" || pathname.startsWith("/api/auth/")) {
          return try auth.fetch
        }
        return try http
      },
    }
  } |> Effect.provide(%, Auth.layer.pipe(Layer.provide(CloudflareD1(AuthDb)))),
) {}
