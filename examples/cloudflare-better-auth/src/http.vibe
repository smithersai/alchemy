import * as Http from "alchemy/Http"
import * as Config from "effect/Config"
import * as Layer from "effect/Layer"
import { Api } from "./api.vibe"
import { CurrentUser } from "./current-user.vibe"
import { Authentication } from "./middleware.vibe"

export const PublicLive = HttpApiBuilder.group(Api, "public", effect (handlers) => {
  const github = try Config.Boolean("GITHUB_ENABLED").pipe(Config.withDefault(false))
  return handlers
    .handle("health", effect () => ({ ok: true as const }))
    .handle("providers", effect () => ({ github }))
})

export const PrivateLive = HttpApiBuilder.group(
  Api,
  "private",
  (handlers) => handlers.handle("me", effect () => try Effect.service(CurrentUser)),
)

export const HttpLive = HttpApiBuilder.layer(Api).pipe(
  Layer.provide([PublicLive, PrivateLive]),
  Layer.provide(Authentication.layer),
  Layer.provide(Http.Platform),
)
