{
  "extends": "../../tsconfig.base.json",
  "include": [
    "alchemy*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "web/src/**/*.ts",
    "alchemy*.vibe",
    "src/**/*.vibe",
    "test/**/*.vibe",
    "web/src/**/*.vibe"
  ],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "types": ["bun", "vite/client"]
  },
  "references": [
    { "path": "../../packages/alchemy/tsconfig.json" },
    { "path": "../../packages/sql/tsconfig.json" },
    { "path": "../../packages/neon/tsconfig.json" }
  ]
}
