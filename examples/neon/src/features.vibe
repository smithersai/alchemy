import * as Config from "effect/Config"
import * as Effect from "effect/Effect"
import { ai } from "./ai/index.ts"
import Events from "./Events.ts"
import { forms } from "./forms/index.ts"

export const features = effect {
  try Events
  const enableAI = try Config.String("NEON_EXAMPLE_AI").pipe(Config.withDefault("false"))
  const enableForms = try Config.String("NEON_EXAMPLE_FORMS").pipe(Config.withDefault("false"))
  return {
    ai: enableAI === "true" ? try ai : undefined,
    forms: enableForms === "true" ? try forms : undefined,
  }
}
