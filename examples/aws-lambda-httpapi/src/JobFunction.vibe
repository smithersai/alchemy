import * as AWS from "@alchemy.run/aws"
import * as Effect from "effect/Effect"
import { JobApiLive } from "./JobApi.vibe"
import { JobNotificationsSNS } from "./JobNotifications.vibe"
import { JobStorageDynamoDB } from "./JobStorage.vibe"

export default class JobFunction extends AWS.Lambda.Function<JobFunction>()(
  "JobFunction",
  {
    main: import.meta.url,
    functionUrl: true,
  },
  effect {
    return try effect {
      provide Layer.mergeAll(
            JobStorageDynamoDB,
            JobNotificationsSNS,
            // TODO(sam): these should be provided to us automatically
            HttpPlatform.layer,
            Etag.layer,
          ) {
        return try effect {
          const fetch = try HttpRouter.toHttpEffect(JobApiLive)
          return ({ fetch })
        }
      }
    }
  },
) {}
