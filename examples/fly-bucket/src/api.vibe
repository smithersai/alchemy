import * as Fly from "@alchemy.run/fly"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import * as Stream from "effect/Stream"
import { API_PORT, Data } from "./shared.ts"

/**
 * HTTP Service that puts and gets an object on a Tigris bucket via
 * the S3 API.
 */
export default class Api extends Fly.Service<Api>()(
  "Api",
  {
    main: import.meta.url,
    region: "iad",
    port: API_PORT,
    guest: { cpuKind: "shared", cpus: 1, memoryMb: 256 },
  },
  effect {
    return try effect {
      provide Fly.PutObjectHttp, Fly.GetObjectHttp {
        return try effect {
          const putObject = try Fly.PutObject(Data)
          const getObject = try Fly.GetObject(Data)

          return {
            fetch: effect {
              const request = try Effect.service(HttpServerRequest)
              const path = new URL(request.url, "http://service").pathname
              if (path === "/health") {
                return try HttpServerResponse.json({ ok: true })
              }
              try (putObject({
                Key: "hello.txt",
                Body: "hello-from-tigris",
                ContentType: "text/plain",
              })
                |> Effect.orDie(%))
              const obj = try (getObject({ Key: "hello.txt" })
                |> Effect.orDie(%))
              const text = obj.Body === undefined
                ? ""
                : try (Stream.mkString(Stream.decodeText(obj.Body))
                  |> Effect.orDie(%))
              return try HttpServerResponse.json({
                ok: text === "hello-from-tigris",
                text,
              })
            },
          }
        }
      }
    }
  },
) {}
