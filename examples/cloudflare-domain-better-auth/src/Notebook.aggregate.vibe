import * as Domain from "@alchemy.run/domain"
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"
import { CurrentUser } from "./CurrentUser.context.vibe"
import { NotYours } from "./NotYours.rejection.ts"
import { UserId } from "./User.id.vibe"
import { NoteWritten, WriteNote } from "./WriteNote.command.vibe"

/** Each user's notebook, keyed by their id. */
export class Notebook extends Domain.Aggregate("Notebook", {
  id: UserId,
  state: Schema.Struct({ notes: Schema.Int }),
  initial: { notes: 0 },
  commands: [WriteNote],
  decide: {
    WriteNote: effect (_s, cmd, { id }) => {
      const user = try Effect.service(CurrentUser)
      if (user.userId !== id) throw new NotYours()
      return [new NoteWritten({ text: cmd.text, author: user.name })]
    },
  },
  evolve: {
    NoteWritten: (s) => ({ notes: s.notes + 1 }),
  },
}) {}
