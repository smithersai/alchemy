import * as Domain from "@alchemy.run/domain"
import * as Schema from "effect/Schema"
import { CurrentUser } from "./CurrentUser.context.vibe"
import { Notebook } from "./Notebook.aggregate.vibe"
import { NotYours } from "./NotYours.rejection.ts"
import { Session } from "./Session.middleware.vibe"

/** The notes in a notebook. Only its owner may read them. */
export class Notes extends Domain.View("Notes", {
  from: [Notebook],
  key: Notebook,
  middleware: [Session],
  rejects: [NotYours],
  state: Schema.Struct({ notes: Schema.Array(Schema.String) }),
  initial: { notes: [] },
  evolve: {
    NoteWritten: (v, e): infer _ => ({ notes: [...v.notes, e.text] }),
  },
  validate: effect (request) => {
    const user = try Effect.service(CurrentUser)
    if (request.key.id !== user.userId) throw new NotYours()
  },
}) {}
