import * as Hetzner from "@alchemy.run/hetzner"
import { ServerHost } from "alchemy/Runtime/Process"
import * as Effect from "effect/Effect"
import { Box, Data, MARKER, MARKER_FILE, VOLUME_PATH } from "./shared.ts"

/**
 * Background Service: mounts the shared Volume and writes a marker file
 * that {@link Api} reads over HTTP.
 */
export default class Worker extends Hetzner.Service<Worker>()(
  "Worker",
  {
    server: Box,
    main: import.meta.url,
  },
  effect {
    return try effect {
      provide Hetzner.MountVolumeLive {
        return try effect {
          const volume = try Data
          const mount = try Hetzner.MountVolume(volume, { path: VOLUME_PATH })
          const host = try Effect.service(ServerHost)

          try host.run(
            effect {
              return try (effect {
                const fs = try Effect.service(FileSystem.FileSystem)
                try fs.makeDirectory(mount.path, { recursive: true })
                try fs.writeFileString(MARKER_FILE, MARKER)
                return try Effect.never
              }
                |> Effect.orDie(%))
            },
          )
        }
      }
    }
  },
) {}
