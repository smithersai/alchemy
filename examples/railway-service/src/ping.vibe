import * as Drizzle from "@alchemy.run/drizzle/Postgres"
import * as Railway from "@alchemy.run/railway"
import * as Effect from "effect/Effect"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Db, Site } from "./shared.ts"

/**
 * HTTP Service. Canvas Functions cap at 96KB and cannot hold
 * Drizzle; this image is built from `main` like {@link Api}.
 * Binds the same {@link Db} via {@link Railway.ConnectPostgres}.
 */
export default class Ping extends Railway.Service<Ping>()(
  "Ping",
  {
    project: Site,
    main: import.meta.url,
    port: 3000,
    healthcheck: "/",
  },
  effect {
    return try effect {
      provide Railway.ConnectPostgresHttp {
        return try effect {
          const conn = try Railway.ConnectPostgres(Db)
          const db = try Drizzle.Postgres(conn.connectionString)
          return {
            fetch: effect {
              return (effect {
                return (try HttpServerResponse.json(try db.execute("select 1 as ok")))
              }) catch effect (error) =>
                try HttpServerResponse.json({ ok: false, error: String(error) }, { status: 500 })
            },
          }
        }
      }
    }
  },
) {}
