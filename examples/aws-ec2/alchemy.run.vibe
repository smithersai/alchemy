import * as AWS from "@alchemy.run/aws"
import * as Alchemy from "alchemy"
import * as Output from "alchemy/Output"
import { NetworkLive } from "./src/Network.vibe"
import Server from "./src/Server.vibe"

export default Alchemy.Stack(
  "AwsEc2Example",
  {
    providers: AWS.providers(),
    state: Alchemy.localState(),
  },
  effect {
    const instance = try Server

    return {
      instanceId: instance.instanceId,
      publicIpAddress: instance.publicIpAddress,
      instanceUrl: try Effect.orDie(
        Effect.try({ try: () => Output.interpolate`http://${instance.publicIpAddress}:3000`, catch: (e) => e }),
      ),
      enqueueExample: try Effect.orDie(
        Effect.try({
          try: () => Output.interpolate`http://${instance.publicIpAddress}:3000/enqueue?message=hello`,
          catch: (e) => e,
        }),
      ),
    }
  } |> Effect.provide(%, NetworkLive),
)
