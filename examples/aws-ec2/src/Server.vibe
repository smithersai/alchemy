import * as AWS from "@alchemy.run/aws"
import { SQSQueueEventSource } from "@alchemy.run/aws/Server/SQSQueueEventSource"
import * as Effect from "effect/Effect"
import * as HttpServerRequest from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Network, NetworkLive } from "./Network.vibe"

export default class Server extends AWS.EC2.Instance<Server>()(
  "ServerInstance",
  effect {
    const network = try Network

    return {
      main: import.meta.url,
      imageId: try Effect.orDie(Effect.try({ try: () => AWS.EC2.amazonLinux(), catch: (e) => e })),
      instanceType: "t3.small",
      subnetId: network.publicSubnetIds[0],
      securityGroupIds: [network.appSecurityGroupId],
      associatePublicIpAddress: true,
      port: 3000,
    }
  },
  effect {
    const queue = try AWS.SQS.Queue("JobsQueue", {
      receiveMessageWaitTime: "20 seconds",
      visibilityTimeout: "60 seconds",
    })

    try AWS.SQS.consumeQueueMessages(
      queue,
      effect (event) => {
        for (const record of event.Records) {
          try Effect.logInfo(record)
        }
      },
    )

    const sendMessage = try AWS.SQS.SendMessage(queue)

    return {
      fetch: do {
        const catchProgram = effect {
          const request = try HttpServerRequest.HttpServerRequest
          const url = new URL(request.originalUrl)

          if (request.method === "GET" && url.pathname === "/") {
            return try HttpServerResponse.json({
              ok: true,
              routes: ["GET /", "GET /enqueue?message=hello"],
            })
          }

          if (request.method === "GET" && url.pathname === "/enqueue") {
            const message = url.searchParams.get("message") ?? "hello from EC2"
            const body = JSON.stringify({
              message,
              enqueuedAt: new Date().toISOString(),
            })

            const result = try sendMessage({
              MessageBody: body,
            })

            return try HttpServerResponse.json({
              ok: true,
              message,
              messageId: result.MessageId,
            })
          }

          return HttpServerResponse.text("Not found", { status: 404 })
        }
        effect {
          return catchProgram catch () => HttpServerResponse.text("Internal server error", { status: 500 })
        }
      },
    }
  }
    |> Effect.provide(
      %,
      Layer.provideMerge(
        Layer.mergeAll(NetworkLive, SQSQueueEventSource),
        Layer.mergeAll(
          AWS.SQS.DeleteMessageBatchHttp,
          AWS.SQS.ReceiveMessageHttp,
          AWS.SQS.SendMessageHttp,
        ),
      ),
    ),
) {}
