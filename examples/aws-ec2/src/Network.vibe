import * as AWS from "@alchemy.run/aws"
import type { Output } from "alchemy/Output"
import * as Context from "effect/Context"
import * as Layer from "effect/Layer"

export interface ExampleNetwork {
  network: AWS.EC2.Network
  publicSubnetIds: Output<AWS.EC2.SubnetId>[]
  appSecurityGroupId: Output<AWS.EC2.SecurityGroupId>
}

export service Network: ExampleNetwork { static readonly key = "Network";}

export const NetworkLive = Layer.effect(
  Network,
  effect {
    const network = try AWS.EC2.Network("Network", {
      cidrBlock: "10.42.0.0/16",
      availabilityZones: 2,
      nat: "single",
    })

    const appSecurityGroup = try AWS.EC2.SecurityGroup("AppSecurityGroup", {
      vpcId: network.vpcId,
      description: "Security group for the EC2 application instance",
      ingress: [
        {
          ipProtocol: "tcp",
          fromPort: 3000,
          toPort: 3000,
          cidrIpv4: "0.0.0.0/0",
        },
      ],
    })

    return {
      network,
      publicSubnetIds: network.publicSubnetIds,
      appSecurityGroupId: appSecurityGroup.groupId,
    }
  },
)
