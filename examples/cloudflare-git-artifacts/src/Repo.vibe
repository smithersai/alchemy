import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"

export type Metadata = {
  description: string
  topics: string[]
  stars: number
  createdAt: number
}

export default class Repo extends Cloudflare.DurableObject<Repo>()(
  "Repo",
  effect {
    const state = try Cloudflare.DurableObjectState
    return effect {
      let meta = (try state.storage.get<Metadata>("meta")) ?? null

      const ensure = effect {
        if (meta === null) {
          return try Effect.fail(new Error("repo not initialized"))
        }
        return meta
      }

      return {
        init: (description: string) =>
          effect {
            if (meta !== null) return meta
            meta = {
              description,
              topics: [],
              stars: 0,
              createdAt: Date.now(),
            }
            try state.storage.put("meta", meta)
            return meta
          },
        get: () => ensure,
        update: (patch: Partial<Pick<Metadata, "description" | "topics">>) =>
          effect {
            const current = try ensure
            meta = { ...current, ...patch }
            try state.storage.put("meta", meta)
            return meta
          },
        star: () =>
          effect {
            const current = try ensure
            meta = { ...current, stars: current.stars + 1 }
            try state.storage.put("meta", meta)
            return meta
          },
      }
    }
  },
) {}
