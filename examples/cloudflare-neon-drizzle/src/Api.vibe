import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Drizzle from "@alchemy.run/drizzle/Postgres"
import { eq } from "drizzle-orm"
import { Layer } from "effect"
import * as Effect from "effect/Effect"
import * as HttpServerRequest from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Hyperdrive } from "./Db.vibe"
import { relations, Users } from "./schema.ts"
import { randomUUID } from "./crypto.platform.ts"

export default class Api extends Cloudflare.Worker<Api>()(
  "Api",
  {
    main: import.meta.url,
  },
  effect {
    const conn = try Cloudflare.Hyperdrive.Connect(Hyperdrive)
    const db = try Drizzle.Postgres(conn.connectionString, {
      relations,
    })

    return {
      fetch: effect {
        const request = try HttpServerRequest.HttpServerRequest
        switch (request.method) {
          case "GET": {
            if (request.url === "/") {
              const users = try (try Effect.orDie(Effect.try({
                try: () => db.select().from(Users),
                catch: (e) => e,
              })))
              return try HttpServerResponse.json({ users })
            }
            const id = Number(request.url.split("/").pop())
            if (Number.isNaN(id)) {
              return try HttpServerResponse.json({ error: "Invalid user ID" }, { status: 400 })
            }
            const user = try db.query.Users.findFirst({
              where: { id },
              with: { posts: true },
            })
            return try HttpServerResponse.json({ user })
          }
          case "POST": {
            const insert = try Effect.orDie(Effect.try({ try: () => db.insert(Users), catch: (e) => e }))
            const values = {
              name: try randomUUID(),
              email: try randomUUID(),
            }
            const user = try (try Effect.orDie(Effect.try({
              try: () => insert.values(values).returning(),
              catch: (e) => e,
            })))
            return try HttpServerResponse.json({ user })
          }
          case "DELETE": {
            const id = Number(request.url.split("/").pop())
            if (Number.isNaN(id)) {
              return try HttpServerResponse.json({ error: "Invalid user ID" }, { status: 400 })
            }
            const [user] = try (try Effect.orDie(Effect.try({
              try: () => db.delete(Users).where(eq(Users.id, id)).returning(),
              catch: (e) => e,
            })))
            return try HttpServerResponse.json({ user })
          }
          default: {
            return try HttpServerResponse.json({ error: "Method not allowed" }, { status: 405 })
          }
        }
      }.pipe(
        Effect.catch((cause: any) => {
          const peel = (e: any): any => (e?.cause ? peel(e.cause) : e)
          const root = peel(cause)
          return HttpServerResponse.json(
            {
              ok: false,
              error: String(cause),
              rootError: root?.message ?? String(root),
              rootCode: root?.code,
            },
            { status: 500 },
          )
        }),
      ),
    }
  }.pipe(Effect.provide(Layer.mergeAll(Cloudflare.Hyperdrive.ConnectBinding))),
) {}
