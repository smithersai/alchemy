import { originalModuleFilename } from "./Api.filename.platform.ts"
import * as Prisma from "@alchemy.run/prisma"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Connection, Project, region, appNameConfig } from "./Database.vibe"

const messageConfig = Config.String("PRISMA_EFFECT_MESSAGE")
  |> Effect.orElseSucceed(%, () => "hello from Effect-native Prisma Compute")

export default class Api extends Prisma.Compute<Api>()(
  "Api",
  effect {
    const project = try Project

    return {
      project,
      appName: try appNameConfig,
      regionId: region,
      branchGitName: "main",
      main: originalModuleFilename,
      port: 3000,
      healthCheck: { path: "/api/health" },
      env: {
        PRISMA_EFFECT_MESSAGE: try messageConfig,
      },
      destroyOldDeployment: true,
    }
  },
  effect {
    const db = try Prisma.Connect(Connection)

    return {
      fetch: effect {
        const request = try HttpServerRequest
        const url = new URL(request.url, "http://localhost")

        if (url.pathname !== "/" && url.pathname !== "/api/health") {
          return HttpServerResponse.text("Not found", { status: 404 })
        }

        if (request.method !== "GET") {
          return HttpServerResponse.text("Method not allowed", { status: 405 })
        }

        try db.databaseUrl

        const response: Record<string, string | boolean> = {
          ok: true,
          mode: "effect-native",
          databaseBinding: "ready",
        }

        if (url.pathname === "/") {
          response.message = try messageConfig
        }

        return try HttpServerResponse.json(response)
      },
    }
  } |> Effect.provide(%, Prisma.ConnectBinding),
) {}
