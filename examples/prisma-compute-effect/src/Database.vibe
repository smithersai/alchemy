import * as Prisma from "@alchemy.run/prisma"
import { Stage } from "alchemy"
import * as Effect from "effect/Effect"

export const region = "eu-west-3" as const

export const appNameConfig = effect {
  const stage = try Stage
  return Config.String("PRISMA_EFFECT_APP") catch () => `alchemy-prisma-compute-effect-${stage}`
}

export const Project = Prisma.Project(
  "Project",
  effect {
    return {
      name: Config.String("PRISMA_PROJECT") catch () => undefined,
      createDatabase: false,
      region,
    }
  },
)

export const Postgres = Prisma.Postgres(
  "Postgres",
  effect {
    const project = try Project
    return {
      project,
      region,
      // Project creation owns the default `main` branch. Select it by its
      // Management API natural key instead of trying to create it again.
      branchGitName: "main",
    }
  },
)

export const Connection = Prisma.Connection(
  "Connection",
  effect {
    const postgres = try Postgres
    return {
      database: postgres,
      name: "api",
    }
  },
)
