{
  "extends": "../../../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "src/**/*.vibe",
    "test/**/*.vibe",
    "vite.config.vibe"
  ],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext"
  },
  "references": [
    {
      "path": "../../../../packages/alchemy/tsconfig.json"
    },
    { "path": "../../../../packages/domain/tsconfig.json" }
  ]
}
