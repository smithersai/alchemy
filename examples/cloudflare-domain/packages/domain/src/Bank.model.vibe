import * as Domain from "@alchemy.run/domain"
import * as Layer from "effect/Layer"
import { Account } from "./Account/Account.aggregate.vibe"
import { AccountActivity } from "./Account/AccountActivity.view.vibe"
import { AccountCard } from "./Account/AccountCard.stream.vibe"
import { AccountCards, AccountCardsLive } from "./Account/AccountCards.projection.vibe"
import { AccountSummary } from "./Account/AccountSummary.view.vibe"
import { Statement } from "./Account/Statement.view.vibe"
import { Customer } from "./Customer/Customer.aggregate.vibe"
import { CustomerDashboard } from "./Customer/CustomerDashboard.view.vibe"
import { MainAccountProvisioning, MainAccountProvisioningLive } from "./Customer/MainAccountProvisioning.policy.vibe"
import { UsernameClaim } from "./Customer/UsernameClaim.aggregate.vibe"
import { UsernameReservation, UsernameReservationLive } from "./Customer/UsernameReservation.policy.vibe"
import { DailyOutflow } from "./Fraud/DailyOutflow.view.vibe"
import { FraudReview, FraudReviewLive } from "./Fraud/FraudReview.policy.vibe"
import { Ledger, LedgerLive } from "./Ledger/Ledger.projection.vibe"
import { SettlementRefund, SettlementRefundLive } from "./Settlement/SettlementRefund.policy.vibe"
import { AccountTransfers } from "./Transfer/AccountTransfers.view.vibe"
import { ExecuteTransfer, ExecuteTransferLive } from "./Transfer/ExecuteTransfer.saga.vibe"
import { Transfer } from "./Transfer/Transfer.aggregate.vibe"
import { TransferApprovalDeadline, TransferApprovalDeadlineLive } from "./Transfer/TransferApprovalDeadline.policy.vibe"
import { TransferExecution, TransferExecutionLive } from "./Transfer/TransferExecution.policy.vibe"
import { TransferStatus } from "./Transfer/TransferStatus.view.vibe"

/** The bank: every aggregate, view, policy, projection, stream and saga, hosted together. */
export class Bank extends Domain.Model("Bank", {
  aggregates: [Customer, UsernameClaim, Account, Transfer],
  views: [
    AccountSummary,
    CustomerDashboard,
    Statement,
    AccountActivity,
    TransferStatus,
    AccountTransfers,
    DailyOutflow,
  ],
  policies: [
    UsernameReservation,
    MainAccountProvisioning,
    TransferExecution,
    TransferApprovalDeadline,
    FraudReview,
    SettlementRefund,
  ],
  projections: [Ledger, AccountCards],
  streams: [AccountCard],
  sagas: [ExecuteTransfer],
}) {}

/**
 * The policies' and projections' implementations. They require the FraudCheck
 * and Payments external systems, and the LedgerStore.
 */
export const BankHandlers = Layer.mergeAll(
  UsernameReservationLive,
  MainAccountProvisioningLive,
  TransferExecutionLive,
  ExecuteTransferLive,
  TransferApprovalDeadlineLive,
  FraudReviewLive,
  SettlementRefundLive,
  LedgerLive,
  AccountCardsLive,
)
