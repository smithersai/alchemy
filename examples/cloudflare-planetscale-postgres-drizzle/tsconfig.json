{
  "extends": "../../tsconfig.base.json",
  "include": [
    "alchemy.run.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "alchemy.run.vibe",
    "src/**/*.vibe",
    "scripts/**/*.vibe",
    "test/**/*.vibe"
  ],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "declaration": false,
    "declarationMap": false
  },
  "references": [
    {
      "path": "../../packages/alchemy/tsconfig.json"
    },
    { "path": "../../packages/cloudflare/tsconfig.json" },
    { "path": "../../packages/planetscale/tsconfig.json" },
    { "path": "../../packages/drizzle/tsconfig.json" }
  ]
}
