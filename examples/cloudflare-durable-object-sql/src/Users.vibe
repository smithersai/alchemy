import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Drizzle from "@alchemy.run/drizzle/Cloudflare"
import * as Effect from "effect/Effect"
import { relations, users } from "./schema.ts"

export default class Users extends Cloudflare.DurableObject<Users>()(
  "Users",
  effect {
    const migrations = try Cloudflare.SqlMigrations("./drizzle")

    return effect {
      const db = try Drizzle.DurableObject({ migrations, relations })

      return {
        addUser: (name: string) => db.insert(users).values({ name }).returning(),
        listUsers: () => db.select().from(users).orderBy(users.id),
      }
    }
  },
) {}
