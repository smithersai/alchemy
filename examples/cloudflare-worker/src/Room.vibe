import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"
import { randomUUID } from "./crypto.platform.ts"

/**
 * Ephemeral chat room: broadcasts each text message to every connected client.
 * Uses Durable Object storage of WebSocket attachments so sessions survive hibernation.
 *
 * Also demonstrates scheduled events: send `/remind <seconds> <message>` to
 * schedule a broadcast that fires after the given delay.
 */
export default class Room extends Cloudflare.DurableObject<Room>()(
  "Rooms",
  effect {
    const state = try Cloudflare.DurableObjectState
    return effect {
      const sessions = new Map<string, Cloudflare.WebSocket>()

      for (const socket of try state.getWebSockets()) {
        const attachment = try Effect.orDie(
          Effect.try({ try: () => socket.deserializeAttachment<{ id: string }>(), catch: (e) => e }),
        )
        if (attachment) {
          sessions.set(attachment.id, socket)
        }
      }

      const broadcast = (text: string) =>
        effect {
          for (const peer of sessions.values()) {
            try peer.send(text)
          }
        }

      return {
        fetch: effect {
          const [response, socket] = try Cloudflare.upgrade()
          const id = try randomUUID()
          try Effect.orDie(Effect.try({ try: () => socket.serializeAttachment({ id }), catch: (e) => e }))
          sessions.set(id, socket)
          return response
        },
        broadcast,
        alarm: () =>
          effect {
            const fired = try Cloudflare.Workers.processScheduledEvents
            for (const event of fired) {
              const payload = event.payload as { message: string }
              try broadcast(`[reminder] ${payload.message}`)
            }
          },
        webSocketMessage: effect (
          socket: Cloudflare.WebSocket,
          message: string | ArrayBuffer,
        ) => {
          const attachment = try Effect.orDie(
            Effect.try({ try: () => socket.deserializeAttachment<{ id: string }>(), catch: (e) => e }),
          )
          if (!attachment) return
          const text = typeof message === "string"
            ? message
            : try Effect.orDie(Effect.try({ try: () => new TextDecoder().decode(message), catch: (e) => e }))

          const remindMatch = text.match(/^\/remind\s+(\d+)\s+(.+)$/)
          if (remindMatch) {
            const delaySec = parseInt(remindMatch[1], 10)
            const msg = remindMatch[2]
            const id = try randomUUID()
            const runAt = new Date(Date.now() + delaySec * 1000)
            try Cloudflare.Workers.scheduleEvent(id, runAt, {
              message: msg,
            })
            try socket.send(`[system] Reminder scheduled in ${delaySec}s: "${msg}"`)
            return
          }

          const label = attachment.id.slice(0, 8)
          for (const peer of sessions.values()) {
            try peer.send(`[${label}] ${text}`)
          }
        },
        webSocketClose: effect (
          ws: Cloudflare.WebSocket,
          code: number,
          reason: string,
          _wasClean: boolean,
        ) => {
          const attachment = try Effect.orDie(
            Effect.try({ try: () => ws.deserializeAttachment<{ id: string }>(), catch: (e) => e }),
          )
          if (attachment) {
            sessions.delete(attachment.id)
          }
          try ws.close(code, reason)
        },
      }
    }
  },
) {}
