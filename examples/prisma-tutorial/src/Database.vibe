import * as Prisma from "@alchemy.run/prisma"

export const Project = effect {
  return try Prisma.Project("Project", {
    createDatabase: false,
    region: "eu-west-3",
  })
}

export const Postgres = effect {
  return try Prisma.Postgres(
    "Postgres",
    effect {
      const project = try Project
      return { project, region: "eu-west-3" as const, branchGitName: "main" }
    },
  )
}

export const Connection = effect {
  return try Prisma.Connection(
    "Connection",
    effect {
      const database = try Postgres
      return { database, name: "api" }
    },
  )
}
