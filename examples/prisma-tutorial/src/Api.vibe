import * as Prisma from "@alchemy.run/prisma"
import * as SQL from "@alchemy.run/sql/Postgres"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { originalModuleFilename } from "./Api.filename.platform.ts"
import { Connection, Project } from "./Database.vibe"

export default class Api extends Prisma.Compute<Api>()(
  "Api",
  effect {
    const project = try Project
    return {
      project,
      main: originalModuleFilename,
      regionId: "eu-west-3",
      branchGitName: "main",
      port: 3000,
      healthCheck: { path: "/api/health" },
      destroyOldDeployment: true,
    }
  },
  effect {
    const db = try Prisma.Connect(Connection)
    const sql = try SQL.Postgres({ url: db.databaseUrl })

    return {
      fetch: effect {
        const request = try HttpServerRequest
        const headers = { "access-control-allow-origin": "*" }
        if (request.method !== "GET") {
          return HttpServerResponse.text("Method not allowed", {
            status: 405,
            headers: { ...headers, allow: "GET" },
          })
        }
        if (request.url === "/api/health") {
          return try HttpServerResponse.json({ ok: true }, { headers })
        }
        if (request.url === "/api/time") {
          const rows = try sql<{
            time: string
          }>`SELECT current_timestamp::text AS time`
          return try HttpServerResponse.json(rows[0], { headers })
        }
        return HttpServerResponse.text("Not found", { status: 404, headers })
      } |> Effect.catchTag(%, "SqlError", () =>
        Effect.succeed(
          HttpServerResponse.text("Database unavailable", {
            status: 503,
            headers: { "access-control-allow-origin": "*" },
          }),
        )),
    }
  } |> Effect.provide(%, Prisma.ConnectBinding),
) {}
