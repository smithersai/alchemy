import * as Hetzner from "@alchemy.run/hetzner"
import * as Alchemy from "alchemy"

const DEFAULT_PUBLIC_KEY =
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINxKqNPbcpc0Hl9QguQ/M5OU1xk9YiNOtfeywcHiBu6d alchemy-hetzner-server-example"

export default Alchemy.Stack(
  "HetznerServerExample",
  {
    providers: Hetzner.providers(),
    state: Alchemy.localState(),
  },
  effect {
    const publicKey = try Effect.suspend(() =>
      Config.String("SSH_PUBLIC_KEY").pipe(
        Config.withDefault(DEFAULT_PUBLIC_KEY),
      )
    )
    const key = try Hetzner.SshKey("deploy", { publicKey })
    const server = try Hetzner.Server("box", {
      serverType: "cx22",
      image: "ubuntu-24.04",
      location: "nbg1",
      sshKeys: [key],
    })

    return {
      ipv4: server.ipv4,
      ipv6: server.ipv6,
    }
  },
)
