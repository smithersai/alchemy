import { Option } from "effect"
import { Server } from "foldkit/experimental"
import * as Url from "foldkit/url"
import { methodNotAllowedResponse, notFoundResponse } from "./entry.server.platform.ts"
import { init, view } from "./main.vibe"
import { urlToAppRoute } from "./route.vibe"

export const renderDocument = Server.renderDocument
export { prerenderPaths } from "./route.vibe"

export const renderPage = (request: Request): Promise<Server.EntryResult> =>
  runPromise(
    effect {
      const route = try Effect.orDie(
        Effect.try({
          try: () => urlToAppRoute(Option.getOrThrow(Url.fromString(request.url))),
          catch: (error) => error,
        }),
      )
      if (route._tag === "NotFound") {
        return try Effect.orDie(
          Effect.try({ try: () => Server.Responded(notFoundResponse()), catch: (error) => error }),
        )
      }
      if (request.method !== "GET" && request.method !== "HEAD") {
        return try Effect.orDie(
          Effect.try({
            try: () => Server.Responded(methodNotAllowedResponse()),
            catch: (error) => error,
          }),
        )
      }
      const renderedApplication = try Server.renderToString(
        { routing: {}, init, view },
        { url: request.url },
      )

      return try Effect.orDie(
        Effect.try({ try: () => Server.Rendered(renderedApplication), catch: (error) => error }),
      )
    },
  )
