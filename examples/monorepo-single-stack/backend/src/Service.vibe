import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"
import { BackendApi, Greeting } from "./Spec.vibe"

export default class Service extends Cloudflare.Worker<Service>()(
  "Service",
  {
    main: import.meta.url,
  },
  effect {
    const helloGroup = HttpApiBuilder.group(
      BackendApi,
      "Hello",
      (handlers) => handlers.handle("hello", effect () => new Greeting({ message: "Hello World" })),
    )

    return {
      fetch: HttpApiBuilder.layer(BackendApi).pipe(
        Layer.provide(helloGroup),
        Layer.provide([HttpPlatform.layer, Etag.layer]),
        HttpRouter.toHttpEffect,
      ),
    }
  },
) {}
