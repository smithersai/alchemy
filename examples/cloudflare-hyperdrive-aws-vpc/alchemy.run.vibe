import * as AWS from "@alchemy.run/aws"
import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Alchemy from "alchemy"
import { Connector } from "./src/Connector.vibe"
import { Hyperdrive } from "./src/Hyperdrive.vibe"

export default Alchemy.Stack(
  "CloudflareHyperdriveAwsVpc",
  {
    providers: Layer.mergeAll(AWS.providers(), Cloudflare.providers(), Alchemy.RandomProvider()),
    state: Alchemy.localState(),
  },
  effect {
    try Connector
    const hd = try Hyperdrive
    const worker = try Cloudflare.Worker("Api", {
      main: "./src/worker.ts",
      compatibility: { flags: ["nodejs_compat"] },
      env: { DB: hd },
    })
    return {
      url: worker.url,
      hyperdriveId: hd.hyperdriveId,
    }
  },
)
