/** Smart HTTP uses the same API middleware and request services as JSON endpoints. */
import * as Git from "@alchemy.run/git"
import * as GitHttp from "@alchemy.run/git/Http"
import * as Effect from "effect/Effect"
import * as HttpApiBuilder from "effect/http-api/HttpApiBuilder"
import { AppApi } from "./api.vibe"
import { checkRefChanges } from "./branch-policy.vibe"

export const ProtocolLive = HttpApiBuilder.group(AppApi, "protocol", (h) =>
  effect {
    const git = try Git.Engine
    const defaults = try Git.Handlers
    return h
      .handleRaw("infoRefs", defaults.protocol.infoRefs)
      .handleRaw("uploadPack", defaults.protocol.uploadPack)
      .handleRaw("receivePack", ({ params, request }) =>
        Effect.scoped(
          effect {
            const repo = try git.repositories
              .get(params)
              .pipe(Effect.catchTag("StoreError", Effect.die))
            const push = try GitHttp.ReceivePack.decode(request)
            if (push._tag === "Probe") {
              return try Effect.orDie(Effect.try({ try: () => GitHttp.ReceivePack.probeResponse(), catch: (e) => e }))
            }
            return try effect {
              try checkRefChanges(repo, push.updates)
              const prepared = try git.preparePush(repo, push.input)
              // Additional application validation can read prepared.readObject(oid) here.
              const committed = try git.commitPush(prepared)
              return try Effect.orDie(
                Effect.try({ try: () => GitHttp.ReceivePack.response(push, committed), catch: (e) => e }),
              )
            }.pipe(
              Effect.catchTag("PushDenied", (error) =>
                Effect.orDie(Effect.try({
                  try: () => GitHttp.ReceivePack.reject(push, error.reason),
                  catch: (e) => e,
                }))),
            )
          },
        ).pipe(
          Effect.catchTag(
            "StoreError",
            (error) =>
              Effect.orDie(Effect.try({ try: () => GitHttp.ReceivePack.failure(error.reason), catch: (e) => e })),
          ),
          Effect.catchTag(
            ["WireProtocolError", "PackIngestError"],
            (error) =>
              Effect.orDie(Effect.try({ try: () => GitHttp.ReceivePack.failure(error.reason), catch: (e) => e })),
          ),
        ))
  })
