/** The application owns the API, including Git's groups and its middleware. */
import * as Git from "@alchemy.run/git"
import * as HttpApi from "effect/http-api/HttpApi"
import { Session, Unauthorized } from "./auth.vibe"
import { Authentication } from "./middleware.vibe"
import { AppRoutes } from "./routes.vibe"

export class AppApi extends HttpApi.make("app")
  .addHttpApi(Git.Api)
  .add(AppRoutes)
  .middleware(Authentication)
{}

export const MeLive = HttpApiBuilder.group(AppApi, "app", (h) =>
  h.handle("me", effect () => {
    const { user } = try Effect.service(Session)
    if (user === null) throw new Unauthorized()
    return user
  }))
