import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Neon from "@alchemy.run/neon"
import * as Prisma from "@alchemy.run/prisma"
import * as Alchemy from "alchemy"
import Api from "./src/Api.ts"
import { Hyperdrive, NeonDb } from "./src/Db.vibe"

export default Alchemy.Stack(
  "CloudflareNeonPrismaExample",
  {
    providers: Layer.mergeAll(Cloudflare.providers(), Prisma.providers(), Neon.providers()),
    state: Alchemy.localState(),
  },
  effect {
    const { branch } = try NeonDb
    const hd = try Hyperdrive
    const api = try Api

    return {
      url: api.url.as<string>(),
      branchId: branch.branchId,
      hyperdriveId: hd.hyperdriveId,
    }
  },
)
