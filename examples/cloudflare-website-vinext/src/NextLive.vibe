import { BackendClient } from "./BackendClient.ts"
import { FrontendApi } from "./NextApi.vibe"
import { FrontendHandlers } from "./NextHandlers.vibe"

const platformLayer = Layer.mergeAll(
  Etag.layer,
  HttpPlatform.layer.pipe(Layer.provide(FileSystem.layerNoop({}))),
  FileSystem.layerNoop({}),
  Path.layer,
)

const FrontendLive = HttpApiBuilder.layer(FrontendApi).pipe(
  Layer.provide(FrontendHandlers.pipe(Layer.provide(BackendClient.Default))),
  Layer.provide(platformLayer),
)

const httpHandler = HttpRouter.toWebHandler(FrontendLive, {
  disableLogger: true,
})

export const handleApiRequest = (request: Request): infer _ => httpHandler.handler(request)
