{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["alchemy.run.ts", "src/**/*.ts", "src/app.d.ts", "test", "alchemy.run.vibe", "src/**/*.vibe"],
  "references": [{ "path": "../../packages/alchemy" }]
}
