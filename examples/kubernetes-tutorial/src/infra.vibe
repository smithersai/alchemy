import * as Kubernetes from "@alchemy.run/kubernetes"
import { Stage } from "alchemy"
import * as Effect from "effect/Effect"

export const Cluster = effect {
  const stage = try Stage
  if (stage === "prod") {
    return try Effect.orDie(
      Effect.try({
        try: () =>
          Kubernetes.KubeConfig({
            context: "prod",
            registry: { server: "ghcr.io/you" },
          }),
        catch: (e) => e,
      }),
    )
  }
  return try Kubernetes.LocalCluster("Cluster", { name: "alchemy" })
}

export const Namespace = effect {
  const cluster = try Cluster
  return try Kubernetes.Manifest("Namespace", {
    cluster,
    manifest: {
      apiVersion: "v1",
      kind: "Namespace",
      metadata: { name: "my-app" },
    },
  })
}

export const Web = effect {
  const cluster = try Cluster
  const namespace = try Namespace
  return try Kubernetes.Deployment("Web", {
    cluster,
    name: "web",
    namespace: namespace.name,
    image: "ghcr.io/stefanprodan/podinfo:6.15.0",
    port: 9898,
    replicas: 2,
    serviceType: "ClusterIP",
    env: {
      PODINFO_UI_MESSAGE: "hello from alchemy",
    },
    resources: {
      requests: { cpu: "10m", memory: "32Mi" },
      limits: { memory: "64Mi" },
    },
  })
}
