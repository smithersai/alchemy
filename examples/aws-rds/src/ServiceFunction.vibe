import * as AWS from "@alchemy.run/aws"
import { Stack } from "alchemy/Stack"
import * as Effect from "effect/Effect"
import { HttpServerRequest } from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { Database, DatabaseAurora } from "./Database.ts"
import { NetworkLive } from "./Network.vibe"

export default class ServiceFunction extends AWS.Lambda.Function<ServiceFunction>()(
  "ServiceFunction",
  Stack.useSync((stack) => ({
    main: import.meta.url,
    memory: stack.stage === "prod" ? 1024 : 512,
    runtime: "nodejs24.x",
  })),
  effect {
    return try effect {
      provide Layer.provideMerge(
            Layer.mergeAll(DatabaseAurora),
            Layer.mergeAll(NetworkLive, AWS.RDS.ConnectHttp),
          ) {
        return try effect {
          const db = try Effect.service(Database)

          return {
            fetch: effect {
              const request = try Effect.service(HttpServerRequest)

              if (request.method === "GET" && new URL(request.originalUrl).pathname === "/") {
                const response = try (db
                  .query<{
                    database: string
                    current_time: string
                    current_user: string
                  }>(
                    "select current_database() as database, now()::text as current_time, current_user::text as current_user",
                  )
                  |> Effect.match(%, {
                    onFailure: (error) => ({
                      status: 500 as const,
                      body: {
                        ok: false,
                        error: error.message,
                      },
                    }),
                    onSuccess: (rows) => ({
                      status: 200 as const,
                      body: {
                        ok: true,
                        connection: rows[0] ?? null,
                      },
                    }),
                  }))

                return try HttpServerResponse.json(response.body, {
                  status: response.status,
                })
              }

              return HttpServerResponse.text("Not found", { status: 404 })
            },
          }
        }
      }
    }
  },
) {}
