{
  "extends": "../../tsconfig.base.json",
  "include": ["alchemy.run.ts", "apps/**/*.ts", "apps/**/*.tsx", "alchemy.run.vibe", "apps/**/*.vibe"],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "noCheck": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx"
  },
  "references": [
    { "path": "../../packages/alchemy/tsconfig.json" },
    { "path": "../../packages/aws/tsconfig.json" }
  ]
}
