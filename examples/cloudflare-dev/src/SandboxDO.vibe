import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Effect from "effect/Effect"
import { HttpServerResponse } from "effect/http"
import { SandboxContainer } from "./SandboxContainer.ts"

export default class SandboxDO extends Cloudflare.DurableObject<SandboxDO>()(
  "SandboxDO",
  effect {
    const container = try SandboxContainer

    return effect {
      // Starting is idempotent: a no-op once the container is running.
      const start = effect {
        return try container.start({ enableInternet: true })
      }
      return {
        fetch: effect {
          try start
          const { fetch } = try container.getTcpPort(3000)
          const response = try fetch(HttpClientRequest.get("http://container/"))
          return HttpServerResponse.text(try response.text, {
            status: response.status,
            headers: response.headers,
          })
        },
      }
    }
  },
) {}
