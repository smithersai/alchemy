import { isResolved } from "../../../packages/alchemy/src/Diff.ts"
import { lazyCredentials } from "../../../packages/alchemy/src/Auth/Resolve.ts"
import { createHostRuntimeContext } from "../../../packages/alchemy/src/Runtime/Process.ts"
import { healthcheckCommand, isHealthcheckDisabled } from "../../../packages/docker/src/HealthcheckCommand.ts"
import { isMissingStripeResource } from "../../../packages/stripe/src/missing.ts"

export const contracts = effect (value: { readonly name: string }) => {
  const resolved = isResolved(value)
  const credentials = lazyCredentials<{ readonly token: string }>()(
    "TestProvider",
    (creds) => creds.token,
  )
  const host = createHostRuntimeContext("TestHost")("host")
  const command = healthcheckCommand(["CMD", "echo", value.name])
  const disabled = isHealthcheckDisabled(["NONE"])
  const missing = isMissingStripeResource({ _tag: "NotFound" } as never)
  return { resolved, credentials, host, command, disabled, missing }
}
