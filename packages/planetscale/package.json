{
  "name": "@alchemy.run/planetscale",
  "version": "2.0.0-beta.84",
  "description": "PlanetScale MySQL and Postgres databases for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "mysql",
    "planetscale",
    "postgres"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/planetscale"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./MySQL": "./src/MySQL/index.ts",
    "./Postgres": "./src/Postgres/index.ts",
    "./Credentials": "./src/Credentials.vibe",
    "./MySQL/MySQLMigrations": "./src/MySQL/MySQLMigrations.vibe",
    "./MySQL/MySQLOrigin": "./src/MySQL/MySQLOrigin.vibe",
    "./MySQL/MySQLPassword": "./src/MySQL/MySQLPassword.vibe",
    "./OAuthClient": "./src/OAuthClient.vibe",
    "./Postgres/PostgresDefaultRole": "./src/Postgres/PostgresDefaultRole.vibe",
    "./Postgres/PostgresMigrations": "./src/Postgres/PostgresMigrations.vibe",
    "./Postgres/PostgresOrigin": "./src/Postgres/PostgresOrigin.vibe",
    "./Providers": "./src/Providers.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./MySQL": {
        "types": "./lib/MySQL/index.d.ts",
        "default": "./lib/MySQL/index.js"
      },
      "./Postgres": {
        "types": "./lib/Postgres/index.d.ts",
        "default": "./lib/Postgres/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/sql": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/planetscale": "workspace:*",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/planetscale/Contributions"
    ]
  }
}
