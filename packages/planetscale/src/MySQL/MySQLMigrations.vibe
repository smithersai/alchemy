import {
  runMigrations,
  withMySqlExecutor,
  type NormalizedMigrationsInput,
  type SqlExecutor,
  type StampedMigrationsState,
} from "@alchemy.run/sql/Migrations"
import { applySqlImports, splitSqlStatements } from "@alchemy.run/sql/SqlFile"
import * as ps from "@distilled.cloud/planetscale"
import * as Effect from "effect/Effect"

const MIGRATION_PASSWORD_TTL_SECONDS = 600

export interface MySQLMigrationTarget {
  organization: string
  database: string
  branch: string
}

/**
 * PlanetScale MySQL's migration adaptation is exactly this: the shared
 * pipeline with a temp-password-scoped mysql2 connection as its executor.
 */
export const runMySQLMigrations = effect (
  target: MySQLMigrationTarget,
  input: NormalizedMigrationsInput,
  stamped: StampedMigrationsState,
) =>
  try runMigrations({
    input,
    stamped,
    withExecutor: effect (apply) => try withMySQLExecutor(target, apply),
  })

/**
 * Apply `importFiles`, each once and again only when it changes. Vitess
 * rejects drizzle-kit's `--> statement-breakpoint` markers, so statements
 * run one at a time.
 */
export const runMySQLImports = effect (
  target: MySQLMigrationTarget,
  importFiles: ReadonlyArray<string>,
  rootDir: string,
  previous: Record<string, string>,
) =>
  try applySqlImports({
    importFiles,
    rootDir,
    previous,
    apply: effect (file) =>
      try withMySQLExecutor(target, effect (executor) =>
        try Effect.forEach(
          try Effect.orDie(Effect.try({
            try: () => splitSqlStatements(file.sql),
            catch: (e) => e,
          })),
          effect (statement) => try executor.query(statement),
          {
            discard: true,
          },
        )),
  })

/** A verified-TLS `mysql2` session as a short-lived admin password. */
const withMySQLExecutor = effect <A, E, R>(
  target: MySQLMigrationTarget,
  use: (executor: SqlExecutor) => A!E!R,
) =>
  try withTemporaryMySQLPassword(target, effect (password) =>
    try withMySqlExecutor(
      {
        host: password.host,
        user: password.username,
        password: Redacted.value(password.password),
        database: target.database,
        multipleStatements: true,
        ssl: { rejectUnauthorized: true },
      },
      use,
    ))

const withTemporaryMySQLPassword = effect <A, E, R>(
  target: MySQLMigrationTarget,
  use: (password: {
    id: string
    host: string
    username: string
    password: Redacted.Redacted<string>
  }) => A!E!R,
) =>
  try Effect.acquireUseRelease(
    effect {
      const created = try ps.createPassword({
        organization: target.organization,
        database: target.database,
        branch: target.branch,
        role: "admin",
        ttl: MIGRATION_PASSWORD_TTL_SECONDS,
      })

      return {
        id: created.id,
        host: created.access_host_url,
        username: created.username,
        password: created.plain_text,
      }
    },
    use,
    effect (password) =>
      (effect {
        return (try (effect {
          return ps
            .deletePassword({
              organization: target.organization,
              database: target.database,
              branch: target.branch,
              id: password.id,
            }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined as void; default: throw e; }
        }
          |> Effect.retry(%, {
            schedule: Schedule.max([Schedule.exponential("500 millis"), Schedule.recurs(5)]),
          })))
      }) catch effect (cause) =>
        try Effect.logWarning(
          `Failed to delete temporary Planetscale migration password after retries. `
            + `It will expire via TTL (~${MIGRATION_PASSWORD_TTL_SECONDS}s). `
            + `organization=${target.organization} database=${target.database} `
            + `branch=${target.branch} id=${password.id}`,
          cause,
        ),
  )
