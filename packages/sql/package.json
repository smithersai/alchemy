{
  "name": "@alchemy.run/sql",
  "version": "2.0.0-beta.84",
  "description": "Postgres and MySQL clients, SQL migrations, and the Postgres state store for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "migrations",
    "mysql",
    "postgres",
    "sql"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/sql"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./Migrations": "./src/Migrations/index.ts",
    "./ConnectionSource": "./src/ConnectionSource.vibe",
    "./Migrations/Detect": "./src/Migrations/Detect.vibe",
    "./Migrations/Executors": "./src/Migrations/Executors.vibe",
    "./Migrations/Format": "./src/Migrations/Format.vibe",
    "./Migrations/MySQLExecutor": "./src/Migrations/MySQLExecutor.vibe",
    "./Migrations/PgExecutor": "./src/Migrations/PgExecutor.vibe",
    "./Migrations/Records": "./src/Migrations/Records.vibe",
    "./MySQL": "./src/MySQL.vibe",
    "./MySQLDriver": "./src/MySQLDriver.vibe",
    "./Postgres": "./src/Postgres.vibe",
    "./PostgresDriver": "./src/PostgresDriver.vibe",
    "./PostgresState": "./src/PostgresState.vibe",
    "./PostgresTls": "./src/PostgresTls.vibe",
    "./SqlFile": "./src/SqlFile.vibe",
    "./SQLite": "./src/SQLite.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./SqlFile.vibe.digest": null,
    "./MySQL.platform": null,
    "./Migrations/Records.platform": null,
    "./PostgresState.helpers": null
  },
  "publishConfig": {
    "exports": {
      "./Migrations": {
        "types": "./lib/Migrations/index.d.ts",
        "default": "./lib/Migrations/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./SqlFile.vibe.digest": null,
      "./MySQL.platform": null,
      "./Migrations/Records.platform": null,
      "./PostgresState.helpers": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "vibelang-runtime": "0.0.14-pre.56c503966164"
  },
  "devDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.56c503966164",
    "vibelang-vite": "0.0.14-pre.56c503966164"
  },
  "peerDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/sql-libsql": {
      "optional": true
    },
    "@effect/sql-mysql2": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
