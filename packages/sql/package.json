{
  "name": "@alchemy.run/sql",
  "version": "2.0.0-beta.84",
  "description": "Postgres and MySQL clients, SQL migrations, and the Postgres state store for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "migrations",
    "mysql",
    "postgres",
    "sql"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/sql"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./Migrations": "./src/Migrations/index.ts",
    "./MySQL": "./src/MySQL.vibe",
    "./MySQLDriver": "./src/MySQLDriver.vibe",
    "./PostgresDriver": "./src/PostgresDriver.vibe",
    "./PostgresTls": "./src/PostgresTls.vibe",
    "./SQLite": "./src/SQLite.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./Migrations": {
        "types": "./lib/Migrations/index.d.ts",
        "bun": "./src/Migrations/index.ts",
        "default": "./lib/Migrations/index.js"
      },
      "./MySQL": {
        "types": "./lib/MySQL.d.ts",
        "default": "./lib/MySQL.js"
      },
      "./MySQLDriver": {
        "types": "./lib/MySQLDriver.d.ts",
        "default": "./lib/MySQLDriver.js"
      },
      "./PostgresDriver": {
        "types": "./lib/PostgresDriver.d.ts",
        "default": "./lib/PostgresDriver.js"
      },
      "./PostgresTls": {
        "types": "./lib/PostgresTls.d.ts",
        "default": "./lib/PostgresTls.js"
      },
      "./SQLite": {
        "types": "./lib/SQLite.d.ts",
        "default": "./lib/SQLite.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-44a71175d967.tgz"
  },
  "devDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-53084d3b6340.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-7e6116042b49.tgz"
  },
  "peerDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/sql-libsql": {
      "optional": true
    },
    "@effect/sql-mysql2": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
