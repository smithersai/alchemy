{
  "name": "@alchemy.run/domain",
  "version": "2.0.0-beta.84",
  "description": "Domain-driven backends for Alchemy: aggregates, commands, events, projections, sagas and stories over Effect.",
  "keywords": [
    "alchemy",
    "domain-driven-design",
    "effect",
    "event-sourcing"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/domain"
  },
  "files": [
    "lib",
    "src",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Api": "./src/Api.vibe",
    "./Command": "./src/Command.vibe",
    "./Event": "./src/Event.vibe",
    "./Filter": "./src/Filter.vibe",
    "./Foldkit": "./src/Foldkit.vibe",
    "./InMemory": "./src/InMemory.vibe",
    "./InMemoryWorkflows": "./src/InMemoryWorkflows.vibe",
    "./internal": "./src/internal.vibe",
    "./Key": "./src/Key.vibe",
    "./Middleware": "./src/Middleware.vibe",
    "./Model": "./src/Model.vibe",
    "./Platform": "./src/Platform.vibe",
    "./Policy": "./src/Policy.vibe",
    "./Projection": "./src/Projection.vibe",
    "./Read": "./src/Read.vibe",
    "./Rejection": "./src/Rejection.vibe",
    "./Saga": "./src/Saga.vibe",
    "./Story": "./src/Story.vibe",
    "./Stream": "./src/Stream.vibe",
    "./Telemetry": "./src/Telemetry.vibe",
    "./View": "./src/View.vibe",
    "./Watch": "./src/Watch.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./internal": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "vibelang-runtime": "0.0.14-pre.b9285da0f2be"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.b9285da0f2be",
    "vibelang-vite": "0.0.14-pre.b9285da0f2be"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "foldkit": "catalog:"
  },
  "peerDependenciesMeta": {
    "foldkit": {
      "optional": true
    }
  }
}
