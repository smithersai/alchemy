{
  "name": "@alchemy.run/domain",
  "version": "2.0.0-beta.84",
  "description": "Domain-driven backends for Alchemy: aggregates, commands, events, projections, sagas and stories over Effect.",
  "keywords": [
    "alchemy",
    "domain-driven-design",
    "effect",
    "event-sourcing"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/domain"
  },
  "files": [
    "lib",
    "src",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Api": "./src/Api.vibe",
    "./Command": "./src/Command.vibe",
    "./Event": "./src/Event.vibe",
    "./Filter": "./src/Filter.vibe",
    "./InMemoryWorkflows": "./src/InMemoryWorkflows.vibe",
    "./internal": "./src/internal.vibe",
    "./Policy": "./src/Policy.vibe",
    "./Projection": "./src/Projection.vibe",
    "./Read": "./src/Read.vibe",
    "./Rejection": "./src/Rejection.vibe",
    "./Saga": "./src/Saga.vibe",
    "./Stream": "./src/Stream.vibe",
    "./View": "./src/View.vibe",
    "./Watch": "./src/Watch.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Api": {
        "types": "./lib/Api.d.ts",
        "default": "./lib/Api.js"
      },
      "./Command": {
        "types": "./lib/Command.d.ts",
        "default": "./lib/Command.js"
      },
      "./Event": {
        "types": "./lib/Event.d.ts",
        "default": "./lib/Event.js"
      },
      "./Filter": {
        "types": "./lib/Filter.d.ts",
        "default": "./lib/Filter.js"
      },
      "./InMemoryWorkflows": {
        "types": "./lib/InMemoryWorkflows.d.ts",
        "default": "./lib/InMemoryWorkflows.js"
      },
      "./internal": null,
      "./Policy": {
        "types": "./lib/Policy.d.ts",
        "default": "./lib/Policy.js"
      },
      "./Projection": {
        "types": "./lib/Projection.d.ts",
        "default": "./lib/Projection.js"
      },
      "./Read": {
        "types": "./lib/Read.d.ts",
        "default": "./lib/Read.js"
      },
      "./Rejection": {
        "types": "./lib/Rejection.d.ts",
        "default": "./lib/Rejection.js"
      },
      "./Saga": {
        "types": "./lib/Saga.d.ts",
        "default": "./lib/Saga.js"
      },
      "./Stream": {
        "types": "./lib/Stream.d.ts",
        "default": "./lib/Stream.js"
      },
      "./View": {
        "types": "./lib/View.d.ts",
        "default": "./lib/View.js"
      },
      "./Watch": {
        "types": "./lib/Watch.d.ts",
        "default": "./lib/Watch.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11.tgz"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11.tgz"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "foldkit": "catalog:"
  },
  "peerDependenciesMeta": {
    "foldkit": {
      "optional": true
    }
  }
}
