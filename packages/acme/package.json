{
  "name": "@alchemy.run/acme",
  "version": "2.0.0-beta.84",
  "description": "ACME (Let's Encrypt, ZeroSSL) certificates for Alchemy, with a Cloudflare DNS-01 solver.",
  "keywords": [
    "acme",
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "letsencrypt",
    "tls"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/acme"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Account": "./src/Account.vibe",
    "./DnsSolver": "./src/DnsSolver.vibe",
    "./Errors": "./src/Errors.vibe",
    "./IssueCertificateHttp": "./src/IssueCertificateHttp.vibe",
    "./Client": "./src/Client.vibe",
    "./Certificate": "./src/Certificate.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Account": {
        "types": "./lib/Account.d.ts",
        "default": "./lib/Account.js"
      },
      "./DnsSolver": {
        "types": "./lib/DnsSolver.d.ts",
        "default": "./lib/DnsSolver.js"
      },
      "./Errors": {
        "types": "./lib/Errors.d.ts",
        "default": "./lib/Errors.js"
      },
      "./IssueCertificateHttp": {
        "types": "./lib/IssueCertificateHttp.d.ts",
        "default": "./lib/IssueCertificateHttp.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/acme": "workspace:*",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-144ebc4c7ea9.tgz"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-57f1d8694651.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-a2b67ac4484b.tgz"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  }
}
