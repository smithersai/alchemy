{
  "name": "@alchemy.run/acme",
  "version": "2.0.0-beta.84",
  "description": "ACME (Let's Encrypt, ZeroSSL) certificates for Alchemy, with a Cloudflare DNS-01 solver.",
  "keywords": [
    "acme",
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "letsencrypt",
    "tls"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/acme"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Account": "./src/Account.vibe",
    "./Certificate": "./src/Certificate.vibe",
    "./Client": "./src/Client.vibe",
    "./DnsSolver": "./src/DnsSolver.vibe",
    "./Errors": "./src/Errors.vibe",
    "./IssueCertificate": "./src/IssueCertificate.vibe",
    "./IssueCertificateHttp": "./src/IssueCertificateHttp.vibe",
    "./Providers": "./src/Providers.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./Dns": "./src/Dns.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/acme": "workspace:*",
    "vibelang-runtime": "0.0.14-pre.6279f9f9fbfc"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.6279f9f9fbfc",
    "vibelang-vite": "0.0.14-pre.6279f9f9fbfc"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  }
}
