import * as Context from "effect/Context"

/** Environment injected into a Neon Function process; never contains the deployment account API key. */
export service FunctionEnvironment: Readonly<Record<string, string | undefined>> {
  static readonly key = "Neon.FunctionEnvironment"
}

/** Native request retained for WebSocket upgrades and Fetch interoperability. */
export service FunctionRequest: Request {
  static readonly key = "Neon.FunctionRequest"
}
