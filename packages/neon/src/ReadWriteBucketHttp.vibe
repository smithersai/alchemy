import * as Layer from "effect/Layer"
import { makeReadBucketClient } from "./ReadBucketHttp.vibe"
import { ReadWriteBucket } from "./ReadWriteBucket.vibe"
import { makeStorageBinding, storageHttpLayer } from "./StorageBinding.vibe"
import { makeWriteBucketClient } from "./WriteBucketHttp.vibe"

/**
 * One injected or managed credential for both interfaces.
 *
 * @layer
 * @product Bucket
 * @provides ReadWriteBucket
 */
export const ReadWriteBucketHttp = Layer.effect(
  ReadWriteBucket,
  makeStorageBinding("storage:write")
    |> Effect.map(%, (bind) => effect (...args: Parameters<typeof bind>) => {
      const client = try bind(...args)
      return {
        ...(try Effect.orDie(Effect.try({ try: () => makeReadBucketClient(client), catch: (e) => e }))),
        ...(try Effect.orDie(Effect.try({ try: () => makeWriteBucketClient(client), catch: (e) => e }))),
      }
    }),
).pipe(Layer.provide(storageHttpLayer))
