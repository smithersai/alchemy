import { waitUntil as nativeWaitUntil } from "@neon/functions"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import * as Scope from "effect/Scope"

/**
 * Run bounded post-response work with its own scope. Failures are logged.
 * Neon limits waitUntil work to fifteen minutes; this is not a durable job.
 */
export const waitUntil = effect <A, E, R>(
  effect: A!E!R,
): void!never!RuntimeContext | Exclude<R, Scope.Scope> => {
  const context = try Effect.context<Exclude<R, Scope.Scope>>()
  const memoMap = try Layer.makeMemoMap
  try Effect.sync(() =>
    effect.pipe(
      Effect.scoped,
      Effect.provideService(Layer.CurrentMemoMap, memoMap),
      Effect.timeout("15 minutes"),
      Effect.tapCause(effect () => try Effect.logError("Neon waitUntil task failed")),
      Effect.runPromiseWith(context),
      nativeWaitUntil,
    )
  )
}
