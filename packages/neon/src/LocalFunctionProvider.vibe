import { $platform, localFunctionModule } from "./LocalFunctionProvider.platform.js"
import * as LocalProvider from "alchemy/Local/LocalProvider"
import { Stack } from "alchemy/Stack"
import { Stage } from "alchemy/Stage"
import { sha256 } from "alchemy/Util/sha256"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"
import { branchScopeOf, Function } from "./Function.vibe"
import { buildFunctionArtifact, validateFunctionZip } from "./FunctionArtifact.vibe"
import { FunctionConfigurationError, functionEnvironment, functionSlug } from "./FunctionConfig.vibe"

export const LocalFunctionProvider = () =>
  LocalProvider.make(
    Function,
    localFunctionModule(),
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const spawner = try ChildProcessSpawner.ChildProcessSpawner
      return {
        resolveConfig: effect (args_0: LocalProvider.LocalProviderInput<Function>) => {
          let { news, bindings } = args_0
          const source = news.main
            ? news.main.startsWith("file:")
              ? try path.fromFileUrl(new URL(news.main))
              : news.main
            : news.artifact?.zip
          const hash = source
            ? try (fs.readFile(source) |> Effect.flatMap(%, sha256))
            : (try buildFunctionArtifact(news)).codeHash
          return { news, bindings, hash }
        },
        start: effect (args_0: LocalProvider.StartContext<Function, LocalProvider.DefaultLocalConfig<Function>>) => {
          let { id, instanceId, news, bindings, invalidate } = args_0
          const command = news.dev?.command ?? "neon"
          const version = (spawner.string(ChildProcess.make(command, ["--version"]))
            |> Effect.timeout(%, "5 seconds")) catch effect (cause) => {
              throw new FunctionConfigurationError({
                message: cause._tag === "PlatformError" && cause.reason._tag === "NotFound"
                  ? `Neon CLI executable '${command}' was not found. Install Neon CLI >=2.45.0: https://neon.com/cli . Ensure '${command}' is on PATH, or set Function.dev.command to its executable path. Local Functions also require Node 24.`
                  : `Could not run '${command} --version': ${cause.message}`,
                cause,
              })
            }
          const cliVersion = Result.getOrUndefined(
            SemVer.parse(version.match(/\d+\.\d+\.\d+/)?.[0] ?? ""),
          )
          if (
            cliVersion === undefined
            || SemVer.isLessThan(cliVersion, SemVer.parseUnsafe("2.45.0"))
          ) {
            throw new FunctionConfigurationError({
              message: "Local Function WebSockets require Neon CLI >=2.45.0",
            })
          }
          const nodeVersion = try spawner.string(ChildProcess.make("node", ["--version"]))
          if (!nodeVersion.trim().startsWith("v24.")) {
            throw new FunctionConfigurationError({
              message: "Local Functions require Node 24",
            })
          }
          const root = try fs.makeTempDirectoryScoped({ prefix: "alchemy-neon-function-" })
          const writeArtifact = effect {
            const artifact = try buildFunctionArtifact(news)
            const files = try validateFunctionZip(artifact.archive)
            for (const [name, content] of Object.entries(files)) {
              if (name.endsWith("/")) continue
              const file = path.join(root, name)
              try fs.makeDirectory(path.dirname(file), { recursive: true })
              try fs.writeFile(file, content)
            }
            return artifact.codeHash
          }
          const codeHash = try writeArtifact
          const slug = try functionSlug(id, news.slug)
          const env = try functionEnvironment(news, bindings)
          const stack = try Stack
          const stage = try Stage
          const base = try $platform()
          const child = try spawner.spawn(
            ChildProcess.make(
              command,
              [
                "dev",
                "--source",
                path.join(root, "index.mjs"),
                ...(news.dev?.port ? ["--port", String(news.dev.port)] : []),
              ],
              {
                cwd: root,
                env: {
                  ...base,
                  ...env,
                  ALCHEMY_STACK_NAME: stack.name,
                  ALCHEMY_STAGE: stage,
                  ALCHEMY_PHASE: "runtime",
                },
                extendEnv: false,
                stdin: "ignore",
                stdout: "pipe",
                stderr: "pipe",
              },
            ),
          )
          const ready = try Deferred.make<string>()
          const capture = (
            stream: Stream.Stream<Uint8Array, import("effect/PlatformError").PlatformError>,
          ) =>
            stream
            |> Stream.decodeText(%)
            |> Stream.runForEach(%, (text) => {
              const url = text.match(/http:\/\/(?:localhost|127\.0\.0\.1):\d+/)?.[0]
              return url ? Deferred.succeed(ready, url) : Effect.void
            })
            |> Effect.forkScoped(%)
          try capture(child.stdout)
          try capture(child.stderr)
          const url = try Effect.raceAllFirst([
            Deferred.await(ready) |> Effect.timeout(%, "15 seconds"),
            child.exitCode.pipe(
              Effect.flatMap(
                () =>
                  new FunctionConfigurationError({
                    message: "Neon local runtime exited before readiness; install Neon CLI >=2.45.0 and Node 24",
                  }),
              ),
            ),
          ])
          try (child.exitCode |> Effect.exit(%) |> Effect.andThen(%, invalidate) |> Effect.forkScoped(%))
          const watched = news.main ?? news.artifact?.directory ?? news.artifact?.zip
          if (watched) {
            const source = watched.startsWith("file:")
              ? try path.fromFileUrl(new URL(watched))
              : path.resolve(watched)
            const directory = news.artifact?.directory ? source : path.dirname(source)
            try (fs.watch(directory, { recursive: true })
              |> Stream.runForEach(%, () =>
                writeArtifact
                |> Effect.ignoreCause({ log: "Error", message: "Neon Function rebuild failed" })(%))
              |> Effect.forkScoped(%))
          }
          const scope = branchScopeOf(news)
          const projectId = scope.branch?.projectId ?? scope.project?.projectId ?? "local"
          const branchId = scope.branch?.branchId ?? "local"
          return {
            projectId,
            branchId,
            functionId: `dev:${instanceId}`,
            slug,
            name: news.name ?? slug,
            url,
            currentDeploymentId: undefined,
            activeDeploymentId: undefined,
            status: "local",
            codeHash,
            environment: Object.keys(env),
          }
        },
      }
    },
  )
