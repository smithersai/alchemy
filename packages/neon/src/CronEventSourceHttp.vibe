import { AlchemyContext } from "alchemy/AlchemyContext"
import * as Namespace from "alchemy/Namespace"
import { ProviderModePolicy } from "alchemy/ProviderMode"
import * as Layer from "effect/Layer"
import { CronEventSource, type CronEventSourceProps, type CronEventSourceService } from "./CronEventSource.vibe"
import { Function } from "./Function.vibe"
import { FunctionRequest } from "./FunctionEnvironment.vibe"
import { FunctionTrigger } from "./FunctionTrigger.vibe"
import { decodeFunctionTriggerEvent, type CronEvent } from "./FunctionTriggerEvent.vibe"

/**
 * Neon Function HTTP schedule dispatch and deployment wiring.
 *
 * ### Subscribe to a schedule
 * **Example:** Provide the subscription implementation
 * ```typescript
 * const application = Effect.gen(function* () {
 *   yield* Neon.CronEventSource("Nightly", { cron: "0 2 * * *" }, event =>
 *     Effect.log(event.invocationId),
 *   );
 *   return { fetch: Effect.succeed(HttpServerResponse.text("ok")) };
 * }).pipe(Effect.provide(Neon.CronEventSourceHttp));
 * ```
 *
 * @layer
 * @product Function
 * @provides Neon.CronEventSource
 */
export const CronEventSourceHttp = Layer.effect(
  CronEventSource,
  effect {
    const host = try Function
    const Trigger = try FunctionTrigger
    return (effect (
      name: string,
      props: CronEventSourceProps,
      handler: (event: CronEvent) => void!unknown,
    ) => {
      const path = `/__alchemy/neon/cron/${encodeURIComponent(name)}`
      const triggerName = `${host.FQN}:${name}`
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        const context = try Effect.service(AlchemyContext)
        const remote = try Effect.service(ProviderModePolicy)
        if (!context.dev || remote) {
          try Namespace.push(
            host.LogicalId,
            Trigger(name, {
              function: host,
              type: "schedule",
              name: triggerName,
              schedule: { cron: props.cron },
              path,
              enabled: props.enabled,
            }),
          )
        }
      }
      try host.route(
        path,
        effect {
          return (effect { return (try effect {
            const event = try decodeFunctionTriggerEvent(try Effect.service(FunctionRequest))
            if (
              event.trigger.type !== "schedule"
              || event.trigger.name !== triggerName
              || !("scheduled_at" in event.data)
            ) {
              return HttpServerResponse.empty({ status: 400 })
            }
            try (handler({
              invocationId: event.invocation_id,
              triggerId: event.trigger.id,
              name,
              scheduledAt: event.data.scheduled_at,
            })
              |> Effect.orDie(%))
            return HttpServerResponse.empty({ status: 204 })
          }) }) catch effect (error) => match (error) {
            when { _tag: "FunctionTriggerEventError" }: HttpServerResponse.empty({ status: error.status });
            default: throw error;
          }
        },
      )
    }) as CronEventSourceService
  },
)
