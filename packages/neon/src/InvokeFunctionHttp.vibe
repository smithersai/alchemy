import { CurrentRuntimeContext, sanitizeKey } from "alchemy/RuntimeContext"
import * as Layer from "effect/Layer"
import type { Function } from "./Function.vibe"
import { InvokeFunction, InvokeFunctionError } from "./InvokeFunction.vibe"

/**
 * URL-only HTTP client. Does not provision an invocation credential or private route.
 *
 * ### Invoke a Function
 * **Example:** Provide the HTTP implementation
 * ```typescript
 * const application = Effect.gen(function* () {
 *   const api = yield* Neon.InvokeFunction(target);
 *   return {
 *     fetch: Effect.gen(function* () {
 *       const response = yield* api.fetch("/health").pipe(Effect.orDie);
 *       return HttpServerResponse.text(String(response.status));
 *     }),
 *   };
 * }).pipe(Effect.provide(Neon.InvokeFunctionHttp));
 * ```
 *
 * @layer
 * @product Function
 * @provides Neon.InvokeFunction
 */
export const InvokeFunctionHttp = Layer.effect(
  InvokeFunction,
  effect {
    const host = try CurrentRuntimeContext
    if (!host) return try Effect.die(new Error("Neon.InvokeFunction requires a Platform host"))
    return effect (fn: Function) => {
      const key = sanitizeKey(
        `NEON_FUNCTION_${Array.from(fn.FQN, (character) => character.codePointAt(0)!.toString(16)).join("_")}_URL`,
      )
      if (!globalThis.__ALCHEMY_RUNTIME__) try host.set(key, fn.url)
      const url = effect {
        return try effect {
          const url = try host
            .get<string>(key)
          return (url ? url : try Effect.die(new Error("Missing Neon Function URL binding")))
        }
      }
      return {
        url,
        fetch: effect (path = "/", init?: RequestInit) => {
          const base = try url
          const target = try Effect.try({
            try: () => new URL(path, base),
            catch: () =>
              new InvokeFunctionError({
                message: "Invalid Function request path",
              }),
          })
          if (target.origin !== new URL(base).origin) {
            throw new InvokeFunctionError({
              message: "Function invocation must remain on the bound origin",
            })
          }
          return try Effect.tryPromise({
            try: (signal) =>
              fetch(target, {
                ...init,
                signal: init?.signal ? AbortSignal.any([signal, init.signal]) : signal,
              }),
            catch: () =>
              new InvokeFunctionError({
                message: "Neon Function HTTP request failed",
              }),
          })
        },
      }
    }
  },
)
