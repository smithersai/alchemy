import * as Neon from "@distilled.cloud/neon"
import { OwnedBySomeoneElse, Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { authPlanScope, authRequest, InvalidManagedAuth } from "./Auth.vibe"
import type { Providers } from "./Providers.vibe"

export error AuthTrustedDomainUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface AuthTrustedDomainProps {
  /** Managed Auth integration to trust the origin on. */
  auth: { projectId: string; branchId: string }
  /** Exact trusted origin, including scheme and optional port. */
  domain: string
}

export interface AuthTrustedDomainAttributes {
  /** Neon project identity. */
  projectId: string
  /** Branch identity. */
  branchId: string
  /** Trusted origin owned by this child. */
  domain: string
}

export interface AuthTrustedDomain extends
  Resource<
    "Neon.AuthTrustedDomain",
    AuthTrustedDomainProps,
    AuthTrustedDomainAttributes,
    never,
    Providers
  >
{}

/**
 * Own one trusted origin without replacing the Auth integration or overwriting
 * other origins. Existing entries require explicit adoption.
 *
 * ### Trust a deployed frontend
 * **Example:** Resolve the site URL after creating Auth
 * ```typescript
 * yield* Neon.AuthTrustedDomain("SiteOrigin", { auth, domain: site.url });
 * ```
 *
 * @resource
 * @product Auth
 */
export const AuthTrustedDomain = Resource<AuthTrustedDomain>("Neon.AuthTrustedDomain")

const observe = effect (scope: { projectId: string; branchId: string }, domain: string) =>
  (effect {
    return ((try Neon.listBranchNeonAuthTrustedDomains(authRequest(scope))).domains.some(
      (item) => item.domain === domain && item.auth_provider === "better_auth",
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: false; default: throw e; }

export const AuthTrustedDomainProvider = (): infer _ =>
  Provider.succeed(AuthTrustedDomain, {
    stables: ["projectId", "branchId", "domain"],
    diff: effect ({ olds, news, output }) => {
      const scope = "auth" in news ? try authPlanScope({ branch: news.auth }) : undefined
      if (
        output
        && (!scope
          || scope.projectId !== output.projectId
          || scope.branchId !== output.branchId
          || !("domain" in news)
          || news.domain !== output.domain)
      ) {
        return { action: "replace" } as const
      }
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return
      if (
        resolved.auth.projectId !== olds.auth.projectId
        || resolved.auth.branchId !== olds.auth.branchId
        || resolved.domain !== olds.domain
      ) {
        return { action: "replace" } as const
      }
      if (!(try observe(resolved.auth, resolved.domain))) return { action: "update" } as const
    },
    read: effect ({ olds, output }) => {
      if (!output && (!olds?.auth?.projectId || !olds.auth.branchId || !olds.domain)) {
        return undefined
      }
      const scope = output ?? olds.auth
      const domain = output?.domain ?? olds.domain
      if (!(try observe(scope, domain))) return undefined
      const attrs = {
        projectId: scope.projectId,
        branchId: scope.branchId,
        domain,
      }
      return output ? attrs : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },
    reconcile: effect ({ news, output }) => {
      if (
        output
        && (news.auth.projectId !== output.projectId
          || news.auth.branchId !== output.branchId
          || news.domain !== output.domain)
      ) {
        throw new InvalidManagedAuth({
          message: "Trusted origin identity changed without replacement; refusing to mutate either origin",
        })
      }
      const request = authRequest(news.auth)
      const current = try observe(news.auth, news.domain)
      if (current && !output) {
        throw new OwnedBySomeoneElse({
          message: "Existing trusted origin requires explicit adoption",
          resourceType: "Neon.AuthTrustedDomain",
        })
      }
      if (!current) {
        Neon.addBranchNeonAuthTrustedDomain({
          ...request,
          auth_provider: "better_auth",
          domain: news.domain,
        }) catch effect (e) => match (e) {
          when { _tag: "Conflict" }: throw new OwnedBySomeoneElse({
            message: "Trusted origin appeared during creation; explicit adoption is required",
            resourceType: "Neon.AuthTrustedDomain",
          });
          default: throw e;
        }
      }
      if (!(try observe(news.auth, news.domain))) {
        throw new AuthTrustedDomainUnexpectedResponse({
          message: "Trusted origin was not visible after reconciliation",
        })
      }
      return {
        projectId: news.auth.projectId,
        branchId: news.auth.branchId,
        domain: news.domain,
      }
    },
    delete: effect ({ output }) => {
      if (try observe(output, output.domain)) {
        Neon.deleteBranchNeonAuthTrustedDomain({
          ...authRequest(output),
          auth_provider: "better_auth",
          domains: [{ domain: output.domain }],
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: (undefined as void); default: throw e; }
      }
    },
  })
