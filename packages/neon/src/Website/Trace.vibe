import { logChildLine } from "alchemy/Util/LogRecord"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"

export error TraceOperationFailed {
  message: string
  cause?: unknown
}

export interface TraceInput {
  readonly seeds: string[]
  readonly base: string
  readonly root: string
  readonly next: boolean
}

/** Keep dependency-parser heaps outside the long-lived deployment process. */
export const traceWebsiteFiles = effect (input: TraceInput) =>
  try (effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const directory = try fs.makeTempDirectoryScoped({
      prefix: "alchemy-neon-trace-",
    })
    const inputPath = path.join(directory, "input.json")
    const outputPath = path.join(directory, "output.json")
    try fs.writeFileString(inputPath, JSON.stringify(input))
    const runner = try path.fromFileUrl(
      new URL(
        new URL(import.meta.url).pathname.endsWith(".js") ? "./TraceRunner.js" : "./TraceRunner.ts",
        import.meta.url,
      ),
    )
    const child = try ChildProcess.make(
      "node",
      ["--max-old-space-size=1536", runner, inputPath, outputPath],
      { stdin: "ignore", stdout: "ignore", stderr: "pipe" },
    )
    // The runner's diagnostics become log records instead of raw terminal writes.
    const [code] = try Effect.all(
      [
        child.exitCode,
        child.stderr.pipe(
          Stream.decodeText,
          Stream.splitLines,
          Stream.runForEach((line) => logChildLine(line, { stream: "stderr" })),
        ),
      ],
      { concurrency: "unbounded" },
    )
    if (code !== 0) {
      throw new TraceOperationFailed({ message: `Website dependency trace exited ${code}` })
    }
    return try (fs
      .readFileString(outputPath)
      |> Effect.flatMap(
        %,
        Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Array(Schema.String))),
      ))
  } |> Effect.scoped(%))
