import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as FetchHttpClient from "effect/http/FetchHttpClient"
import * as Layer from "effect/Layer"
import { packageWebsiteArtifact, type WebsiteArtifactProps } from "./Artifact.vibe"

// Reads the runner's command-line arguments (host access).
module node_process {
  /** @throws {never} */
  export function argv(index: number): string | undefined {
    return process.argv[index]
  }
}

import { argv } from node_process

export class PackageRunnerInvalidProps extends Data.TaggedError("PackageRunnerInvalidProps")<{
  readonly message: string
  readonly cause?: unknown
}> {}

NodeRuntime.runMain(
  (effect {
    const fs = try FileSystem.FileSystem
    const inputPath = argv(2)
    const outputPath = argv(3)
    if (!inputPath || !outputPath) {
      return try new PackageRunnerInvalidProps({ message: "Missing Website packaging paths" })
    }
    const source = try fs.readFileString(inputPath)
    const props = try Effect.try(() => JSON.parse(source) as WebsiteArtifactProps)
    const { archive } = try packageWebsiteArtifact(props)
    try fs.writeFile(outputPath, archive)
  }).pipe(Effect.scoped, Effect.provide(Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer))),
)
