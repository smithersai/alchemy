import * as Neon from "@distilled.cloud/neon"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as Effect from "effect/Effect"
import type { Providers } from "./Providers.ts"

export interface CustomDomainProps {
  /** Target Function. Domain ownership remains independent of Function configuration. */ mutable function: {
    mutable projectId: string
    mutable branchId: string
    mutable slug: string
    mutable url: string
  }
  /** Public DNS hostname. Register the returned target with a DNS-only CNAME. */ mutable hostname: string
}
export interface CustomDomainAttributes {
  /** Owning project. */ mutable projectId: string
  /** Owning branch. */ mutable branchId: string
  /** Target Function slug. */ mutable slug: string
  /** Normalized custom hostname. */ mutable hostname: string
  /** DNS-only CNAME target; returned before DNS activation to avoid dependency cycles. */ mutable cnameTarget: string
  /** Registration state. This is not an independent HTTPS probe. */ mutable status: string | undefined
  /** DNS/CAA check state. */ mutable dnsStatus: string | undefined
  /** Internal routing state. */ mutable bindingStatus: string | undefined
  /** Machine-readable status explanation. */ mutable statusReason: string | undefined
  /** Custom HTTPS URL; not proof that the certificate is ready. */ mutable url: string
  /** Native Function URL. */ mutable nativeUrl: string
}
export interface CustomDomain extends
  Resource<
    "Neon.CustomDomain",
    CustomDomainProps,
    CustomDomainAttributes,
    never,
    Providers
  >
{}

/**
 * Register a branch-local custom Function domain without waiting for DNS.
 * A registration does not prove HTTPS works. Publish a DNS-only CNAME, then
 * verify the custom URL separately. Domains are not inherited by child branches.
 *
 * ### Register a Domain
 * **Example:** Obtain DNS configuration
 * ```typescript
 * const domain = yield* Neon.CustomDomain("Domain", { function: api, hostname: "api.example.com" });
 * // Publish domain.cnameTarget as a DNS-only CNAME for domain.hostname.
 * ```
 *
 * @resource
 * @product Function
 */
export const CustomDomain = Resource<CustomDomain>("Neon.CustomDomain")
export error FunctionDomainConflict {
  mutable hostname: string
}
const normalize = (value: string): infer _ => value.toLowerCase().replace(/\.$/, "")
const scopeOf = (fn: { mutable projectId: string; mutable branchId: string }): infer _ => ({
  project_id: fn.projectId,
  branch_id: fn.branchId,
})
const observe = effect (
  scope: { mutable project_id: string; mutable branch_id: string },
  hostname: string,
) => {
  const domains = try Neon.listProjectBranchCustomDomains.items(scope).pipe(Stream.runCollect)
  return domains.find((domain) => domain.domain === hostname)
}
const attrs = (
  fn: { mutable projectId: string; mutable branchId: string; mutable slug: string; mutable url: string },
  domain: Neon.CustomDomain,
): CustomDomainAttributes => ({
  projectId: fn.projectId,
  branchId: fn.branchId,
  slug: fn.slug,
  hostname: domain.domain,
  cnameTarget: domain.cname_target,
  status: domain.status,
  dnsStatus: domain.dns_status,
  bindingStatus: domain.binding_status,
  statusReason: domain.status_reason,
  url: `https://${domain.domain}`,
  nativeUrl: fn.url,
})
export const CustomDomainProvider = (): infer _ =>
  Provider.succeed(CustomDomain, {
    stables: ["projectId", "branchId", "slug", "hostname", "url"],
    list: effect () => {
      const result: CustomDomainAttributes[] = []
      for (const project of try Neon.listProjects.items({}).pipe(Stream.runCollect)) {
        for (
          const branch of try Neon.listProjectBranches
            .items({ project_id: project.id })
            .pipe(Stream.runCollect)
        ) {
          for (
            const domain of try Neon.listProjectBranchCustomDomains
              .items({ project_id: project.id, branch_id: branch.id })
              .pipe(Stream.runCollect)
          ) {
            result.push(
              attrs(
                {
                  projectId: project.id,
                  branchId: branch.id,
                  slug: domain.entity_id,
                  url: "",
                },
                domain,
              ),
            )
          }
        }
      }
      return result
    },
    diff: effect ({ news, output }) => {
      if (!isResolved(news) || !output) return
      if (
        normalize(news.hostname) !== output.hostname
        || news.function.projectId !== output.projectId
        || news.function.branchId !== output.branchId
        || news.function.slug !== output.slug
      ) {
        return { action: "replace", deleteFirst: true }
      }
    },
    read: effect ({ olds, output }) => {
      if (!output && (!olds?.function || !olds.hostname)) return undefined
      const fn = output ? { ...output, url: output.nativeUrl } : olds!.function
      const domain = try observe(scopeOf(fn), output?.hostname ?? normalize(olds!.hostname))
      if (!domain) return undefined
      const result = attrs(fn, domain)
      return output ? result : Unowned(result)
    },
    reconcile: effect ({ news }) => {
      const scope = scopeOf(news.function)
      const hostname = normalize(news.hostname)
      let domain = try observe(scope, hostname)
      if (!domain) {
        Neon.registerProjectBranchCustomDomain({
          ...scope,
          domain: hostname,
          entity_type: "function",
          entity_id: news.function.slug,
        }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.void; default: throw e; }
        domain = try observe(scope, hostname)
      }
      if (!domain || domain.entity_type !== "function" || domain.entity_id !== news.function.slug) {
        throw new FunctionDomainConflict({ hostname })
      }
      return attrs(news.function, domain)
    },
    delete: effect ({ output }) => {
      const scope = scopeOf(output)
      const domain = try observe(scope, output.hostname)
      if (!domain) return
      if (domain.entity_id !== output.slug || domain.entity_type !== "function") {
        throw new FunctionDomainConflict({ hostname: output.hostname })
      }
      Neon.deleteProjectBranchCustomDomain({
        ...scope,
        domain: output.hostname,
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
    },
  })
