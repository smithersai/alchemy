import * as Neon from "@distilled.cloud/neon"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import type { Providers } from "./Providers.ts"

/** Organization roles supported by Neon; availability depends on the organization. */
export type OrganizationRole = "admin" | "member" | "editor" | "viewer" | "collaborator"

export interface OrganizationMemberRoleProps {
  /** Existing Neon organization ID. Restore and remove this control before changing its identity. */
  mutable orgId: string
  /** Existing membership ID, not a user ID or email. Remove this control before changing the member. */
  mutable memberId: string
  /** Desired organization role. The legacy member role is equivalent to editor. No membership is created or invited. */
  mutable role: OrganizationRole
}

/** Durable ownership and restore evidence, persisted by the engine before reconciliation. */
export interface GovernanceRoleBaseline<Role> {
  /** Resource generation that captured the original role. */
  mutable instanceId: string
  /** Fully qualified logical resource identity. */
  mutable fqn: string
  /** User identity captured with the existing membership. */
  mutable userId: string
  /** Exact role before this resource first managed it. */
  mutable originalRole: Role
  /** Last successfully persisted managed role, never inferred from input properties. */
  mutable managedRole: Role
}

export interface OrganizationMemberRoleAttributes {
  /** Organization containing the membership. */
  mutable orgId: string
  /** Existing membership controlled by this resource. */
  mutable memberId: string
  /** Observed organization role. */
  mutable role: OrganizationRole
  /** Original role and ownership evidence required for safe restoration. */
  mutable baseline: GovernanceRoleBaseline<OrganizationRole>
}

export interface OrganizationMemberRole extends
  Resource<
    "Neon.OrganizationMemberRole",
    OrganizationMemberRoleProps,
    OrganizationMemberRoleAttributes,
    never,
    Providers
  >
{}

/**
 * Manage the role of an existing organization member, never their membership.
 * Existing roles require explicit adoption. Destruction restores the captured
 * original role, but refuses to overwrite a role changed outside this resource.
 * A complete bounded organization-member listing can prove that a removed
 * membership needs no restoration; listing failures never count as absence.
 * Self changes are refused, including restoration, to avoid self-demotion.
 * Neon enforces organization-admin authorization and organization role availability.
 *
 * The engine persists the adoption snapshot before reconciliation. Supply resolved
 * IDs and role values on first deployment; an unresolved first deployment fails
 * before mutation because this engine has no provider checkpoint API. Keep the
 * state: a lost baseline cannot be reconstructed from desired props. An ambiguous
 * interrupted write fails closed and requires operator reconciliation of state.
 * Role mutations have no compare-and-swap API; do not edit the same role concurrently.
 *
 * ### Manage an existing member
 * **Example:** Explicitly adopt a consenting member's role
 * ```typescript
 * const role = yield* Neon.OrganizationMemberRole("DeveloperRole", {
 *   orgId: "org-example",
 *   memberId: authorizedMemberId,
 *   role: "editor",
 * }).pipe(Alchemy.adopt(true));
 * ```
 *
 * @resource
 * @product Organization
 */
export const OrganizationMemberRole = Resource<OrganizationMemberRole>(
  "Neon.OrganizationMemberRole",
)

// @vibelang-diagnostics-next-line EK4830:off
export class GovernanceRoleSafetyError extends Data.TaggedError("NeonGovernanceRoleSafetyError")<{
  mutable message: string
}> {}

/** Validate scope without performing cloud I/O. @internal */
export const validateGovernanceScope = effect (
  scope: { mutable orgId: string; mutable memberId: string } | undefined,
): (void!never!never) | (never!GovernanceRoleSafetyError!never) => (typeof scope?.orgId === "string"
    && scope.orgId.trim().length > 0
    && typeof scope.memberId === "string"
    && scope.memberId.trim().length > 0
  ? try Effect.void
  : throw new GovernanceRoleSafetyError({
    message: "An explicit organization ID and existing membership ID are required",
  }))

/** Runtime validation also guards persisted state and unrecognized SDK enum values. @internal */
export const validateOrganizationRole = effect (role: OrganizationRole): (void!never!never) | (never!GovernanceRoleSafetyError!never) => (role === "admin"
    || role === "member"
    || role === "editor"
    || role === "viewer"
    || role === "collaborator"
  ? try Effect.void
  : throw new GovernanceRoleSafetyError({
    message: "Unsupported organization role",
  }))

/** Check persisted ownership independently of desired properties. @internal */
export const requireGovernanceBaseline = effect <Role>(
  baseline: GovernanceRoleBaseline<Role> | undefined,
  owner: { mutable fqn: string; mutable instanceId: string },
): (never!GovernanceRoleSafetyError!never) | (GovernanceRoleBaseline<Role>!never!never) => (baseline
    && baseline.fqn === owner.fqn
    && baseline.instanceId === owner.instanceId
    && baseline.userId
  ? baseline
  : throw new GovernanceRoleSafetyError({
    message:
      "Missing or foreign durable role baseline; use a resolved initial declaration and explicit adoption, never reconstruct a lost baseline from props",
  }))

/** Observe-before-write guard; a completed restoration is idempotent. @internal */
export const governanceRoleTransition = effect <Role>(
  baseline: GovernanceRoleBaseline<Role>,
  observed: Role,
  desired: Role,
  restoring = false,
): (never!GovernanceRoleSafetyError!never) | (boolean!never!never) => {
  if (restoring && observed === baseline.originalRole) return false
  if (observed !== baseline.managedRole) {
    throw new GovernanceRoleSafetyError({
      message:
        "Observed role differs from the last persisted managed role; refusing an out-of-band edit or ambiguous interrupted write",
    })
  }
  return observed !== desired
}

const normalizeOrganizationRole = (role: OrganizationRole): infer _ => (role === "member" ? "editor" : role)

/** Neon treats member as a legacy spelling of editor. @internal */
export const sameOrganizationRole = (a: OrganizationRole, b: OrganizationRole): infer _ =>
  normalizeOrganizationRole(a) === normalizeOrganizationRole(b)

/** Preserve original spellings while comparing equivalent organization roles. @internal */
export const organizationRoleTransition = effect (
  baseline: GovernanceRoleBaseline<OrganizationRole>,
  observed: OrganizationRole,
  desired: OrganizationRole,
  restoring = false,
): (never!GovernanceRoleSafetyError!never) | (boolean!never!never) =>
  try governanceRoleTransition(
    {
      ...baseline,
      originalRole: normalizeOrganizationRole(baseline.originalRole),
      managedRole: normalizeOrganizationRole(baseline.managedRole),
    },
    normalizeOrganizationRole(observed),
    normalizeOrganizationRole(desired),
    restoring,
  )

/** Never mutate the authenticated actor, including during restoration. @internal */
export const validateGovernanceActor = effect (
  userId: string,
  actorId: string,
): (void!never!never) | (never!GovernanceRoleSafetyError!never) => (userId && actorId && userId !== actorId ? try Effect.void : throw new GovernanceRoleSafetyError({
  message: "Cannot manage the current actor's role or a membership without a verified user identity",
}))

const request = (scope: { mutable orgId: string; mutable memberId: string }): infer _ => ({
  org_id: scope.orgId,
  member_id: scope.memberId,
})

/** Complete membership evidence for cleanup; failed or truncated listings never prove absence. @internal */
export const listGovernanceOrganizationMembers = effect (orgId: string): Neon.Member[]!GovernanceRoleSafetyError | Neon.NeonOpError!Neon.NeonOpContext => {
  const members: Neon.Member[] = []
  const seen = new Set<string>()
  let cursor: string | undefined
  for (let page = 0; page < 10; page++) {
    const response = try Neon.getOrganizationMembers({
      org_id: orgId,
      cursor,
      limit: 100,
    })
    for (const { member } of response.members) {
      if (member.org_id !== orgId) {
        throw new GovernanceRoleSafetyError({
          message: "Organization member listing returned a different organization",
        })
      }
      members.push(member)
    }
    const next = response.pagination?.next
    if (next === undefined) return members
    if (!next || seen.has(next)) {
      throw new GovernanceRoleSafetyError({
        message: "Organization membership listing returned an invalid or repeated cursor",
      })
    }
    seen.add(next)
    cursor = next
  }
  throw new GovernanceRoleSafetyError({
    message: "Organization membership listing exceeded its bounded pagination limit; absence is unproven",
  })
}

const validateObservedMember = effect (
  scope: { mutable orgId: string; mutable memberId: string },
  member: Neon.Member,
) => {
  if (member.id !== scope.memberId || member.org_id !== scope.orgId || !member.user_id) {
    throw new GovernanceRoleSafetyError({
      message: "Organization membership identity does not match the requested scope",
    })
  }
  try validateOrganizationRole(member.role)
  return member
}

const observe = effect (scope: { mutable orgId: string; mutable memberId: string }) => {
  try validateGovernanceScope(scope)
  return try validateObservedMember(scope, try Neon.getOrganizationMember(request(scope)))
}

const validateScope = effect (
  scope: { mutable orgId: string; mutable memberId: string },
  output: OrganizationMemberRoleAttributes,
) => (scope.orgId === output.orgId && scope.memberId === output.memberId
  ? try Effect.void
  : throw new GovernanceRoleSafetyError({
    message: "Membership identity changed without replacement",
  }))

const verifyBaseline = effect (
  output: OrganizationMemberRoleAttributes | undefined,
  owner: { mutable fqn: string; mutable instanceId: string },
) => {
  const baseline = try requireGovernanceBaseline(output?.baseline, owner)
  try validateOrganizationRole(baseline.originalRole)
  try validateOrganizationRole(baseline.managedRole)
  return baseline
}

export const OrganizationMemberRoleProvider = (): infer _ =>
  Provider.succeed(OrganizationMemberRole, {
    nuke: { skip: true },
    stables: ["orgId", "memberId"],
    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return
      try validateGovernanceScope(news)
      try validateOrganizationRole(news.role)
      const previous = output ?? olds
      if (news.orgId !== previous.orgId || news.memberId !== previous.memberId) {
        throw new GovernanceRoleSafetyError({
          message:
            "Restore and remove the existing role control before changing its membership identity; the new membership requires a separate durable adoption snapshot",
        })
      }
    },
    read: effect ({ olds, output, fqn, instanceId }) => {
      const scope = output ?? olds
      try validateGovernanceScope(scope)
      const baseline = output ? try verifyBaseline(output, { fqn, instanceId }) : undefined
      const member = try observe(scope)
      if (output && baseline) {
        if (member.user_id !== baseline.userId) {
          throw new GovernanceRoleSafetyError({
            message: "Membership user changed; refusing to reuse the captured baseline",
          })
        }
        try organizationRoleTransition(baseline, member.role, member.role)
        return { ...output, role: member.role }
      }
      return Unowned({
        orgId: scope.orgId,
        memberId: scope.memberId,
        role: member.role,
        baseline: {
          fqn,
          instanceId,
          userId: member.user_id,
          originalRole: member.role,
          managedRole: member.role,
        },
      })
    },
    reconcile: effect ({ news, output, fqn, instanceId }) => {
      try validateGovernanceScope(news)
      try validateOrganizationRole(news.role)
      const baseline = try verifyBaseline(output, { fqn, instanceId })
      if (!output) {
        throw new GovernanceRoleSafetyError({
          message: "A persisted adoption snapshot is required before changing an organization role",
        })
      }
      try validateScope(news, output)
      const member = try observe(news)
      if (member.user_id !== baseline.userId) {
        throw new GovernanceRoleSafetyError({
          message: "Membership user changed",
        })
      }
      if (try organizationRoleTransition(baseline, member.role, news.role)) {
        try validateGovernanceActor(member.user_id, (try Neon.getCurrentUserInfo({})).id)
        try Neon.updateOrganizationMember({
          ...request(news),
          role: news.role,
        })
      }
      const current = try observe(news)
      if (current.user_id !== baseline.userId || !sameOrganizationRole(current.role, news.role)) {
        throw new GovernanceRoleSafetyError({
          message: "Organization role did not converge; retaining the original baseline",
        })
      }
      return {
        orgId: news.orgId,
        memberId: news.memberId,
        role: current.role,
        baseline: { ...baseline, managedRole: current.role },
      }
    },
    delete: effect ({ output, fqn, instanceId }) => {
      const baseline = try verifyBaseline(output, { fqn, instanceId })
      try validateGovernanceScope(output)
      // getOrganizationMember has no typed missing-member error in the SDK.
      const listed = (try listGovernanceOrganizationMembers(output.orgId)).find(
        (member) => member.id === output.memberId,
      )
      if (!listed) return
      const member = try validateObservedMember(output, listed)
      if (member.user_id !== baseline.userId) {
        throw new GovernanceRoleSafetyError({
          message: "Membership user changed",
        })
      }
      if (try organizationRoleTransition(baseline, member.role, baseline.originalRole, true)) {
        try validateGovernanceActor(member.user_id, (try Neon.getCurrentUserInfo({})).id)
        try Neon.updateOrganizationMember({
          ...request(output),
          role: baseline.originalRole,
        })
        const restored = try observe(output)
        if (
          restored.user_id !== baseline.userId
          || !sameOrganizationRole(restored.role, baseline.originalRole)
        ) {
          throw new GovernanceRoleSafetyError({
            message: "Original organization role was not restored",
          })
        }
      }
    },
  })
