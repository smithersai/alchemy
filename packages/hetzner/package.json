{
  "name": "@alchemy.run/hetzner",
  "version": "2.0.0-beta.84",
  "description": "Hetzner Cloud servers and networking for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "hetzner",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/hetzner"
  },
  "files": [
    "lib",
    "src",
    "!lib/Ssh.platform.d.ts",
    "!lib/Ssh.platform.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./Website": "./src/Website/index.ts",
    "./actions": "./src/actions.vibe",
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./Catalog": "./src/Catalog.vibe",
    "./Certificate": "./src/Certificate.vibe",
    "./Credentials": "./src/Credentials.vibe",
    "./DnsHttp": "./src/DnsHttp.vibe",
    "./DnsRecordList": "./src/DnsRecordList.vibe",
    "./Environment": "./src/Environment.vibe",
    "./Firewall": "./src/Firewall.vibe",
    "./FloatingIp": "./src/FloatingIp.vibe",
    "./FloatingIpAssignment": "./src/FloatingIpAssignment.vibe",
    "./hosted": "./src/hosted.vibe",
    "./Image": "./src/Image.vibe",
    "./Labels": "./src/Labels.vibe",
    "./LoadBalancer": "./src/LoadBalancer.vibe",
    "./MountVolume": "./src/MountVolume.vibe",
    "./Network": "./src/Network.vibe",
    "./PlacementGroup": "./src/PlacementGroup.vibe",
    "./PrimaryIp": "./src/PrimaryIp.vibe",
    "./Providers": "./src/Providers.vibe",
    "./ReadDns": "./src/ReadDns.vibe",
    "./ReadDnsHttp": "./src/ReadDnsHttp.vibe",
    "./ReadWriteDns": "./src/ReadWriteDns.vibe",
    "./ReadWriteDnsHttp": "./src/ReadWriteDnsHttp.vibe",
    "./RecordSet": "./src/RecordSet.vibe",
    "./Service": "./src/Service.vibe",
    "./Ssh": "./src/Ssh.vibe",
    "./SshKey": "./src/SshKey.vibe",
    "./Volume": "./src/Volume.vibe",
    "./VolumeAttachment": "./src/VolumeAttachment.vibe",
    "./Website/Astro": "./src/Website/Astro.vibe",
    "./Website/StaticSite": "./src/Website/StaticSite.vibe",
    "./WriteDns": "./src/WriteDns.vibe",
    "./WriteDnsHttp": "./src/WriteDnsHttp.vibe",
    "./Zone": "./src/Zone.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./SshKey.platform": null,
    "./Website/StaticSite.platform": null,
    "./Ssh.platform": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./Website": {
        "types": "./lib/Website/index.d.ts",
        "default": "./lib/Website/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./SshKey.platform": null,
      "./Website/StaticSite.platform": null,
      "./Ssh.platform": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/hetzner": "workspace:*",
    "rolldown": "catalog:",
    "vibelang-runtime": "0.0.14-pre.6279f9f9fbfc"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.6279f9f9fbfc"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/hetzner/Contributions"
    ]
  }
}
