import * as zoneRrsets from "@distilled.cloud/hetzner/zone_rrsets"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { type DnsAuth, makeHttpDnsBinding } from "./DnsHttp.vibe"
import { ReadDns, type ReadDnsClient } from "./ReadDns.vibe"

/** Runtime layer for {@link ReadDns}. */
export const ReadDnsHttp = Layer.effect(
  ReadDns,
  Effect.suspend(effect () =>
    try makeHttpDnsBinding({
      makeClient: dnsReadClient,
    })
  ),
)

/** Build the read-only client over an injectable auth and zone id. */
export const dnsReadClient = (auth: DnsAuth, zoneId: number!!): ReadDnsClient => {
  const authorize = auth.authorize
  return {
    getRecordSet: effect (name, type) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsets.getZoneRrset({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
            }),
          )
        },
        "Hetzner.DNS.getRecordSet",
      ),
    listRecordSets: effect (request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsets.listZoneRrsets({
              id_or_name: String(try zoneId),
              ...request,
            }),
          )
        },
        "Hetzner.DNS.listRecordSets",
      ),
  }
}
