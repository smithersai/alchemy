  return found
}

/**
 * Resolve a Hetzner Image by name (`ubuntu-24.04`, …) or numeric id.
 */
export const findImage = effect (
  ref: string | number,
): Hetzner.images.GetImageResponseImage | undefined!Hetzner.BadGateway | Hetzner.BadRequest | CatalogNotFound | Hetzner.ConfigError | Hetzner.Conflict | Hetzner.Forbidden | Hetzner.GatewayTimeout | Hetzner.Gone | Hetzner.HetznerParseError | import("effect/http/HttpClientError").HttpClientError | Hetzner.InternalServerError | import("@distilled.cloud/core/errors").InvalidInput | Hetzner.Locked | Hetzner.MethodNotAllowed | Hetzner.NotFound | Hetzner.PreconditionFailed | Hetzner.ServiceUnavailable | Hetzner.TooManyRequests | Hetzner.Unauthorized | Hetzner.UnknownHetznerError | Hetzner.UnprocessableEntity!Hetzner.HetznerOpContext => {
  const id = numericId(ref)
  if (id !== undefined) {
    const { image } = Hetzner.images
      .getImage({ id }) catch effect (e) => match (e) {
        when { _tag: "NotFound" }: throw notFound("image", ref);
        default: throw e;
      }
    return image
  }
  const { images } = try Hetzner.images.listImages({
    name: String(ref),
    include_deprecated: true,
    per_page: 50,
  })
  const found = images.find((item) => item.name === ref)
  if (found === undefined) {
    throw notFound("image", ref)
  }
  return found
}

