import * as Hetzner from "@distilled.cloud/hetzner"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"

export type CatalogKind = "location" | "serverType" | "image" | "iso" | "loadBalancerType"

// @vibelang-diagnostics-next-line EK4830:off
export class CatalogNotFound extends Data.TaggedError("Hetzner.CatalogNotFound")<{
  mutable kind: CatalogKind
  mutable ref: string
}> {}

const numericId = (ref: string | number): number | undefined =>
  typeof ref === "number" ? ref : /^\d+$/.test(ref) ? Number(ref) : undefined

const notFound = (kind: CatalogKind, ref: string | number): infer _ => new CatalogNotFound({ kind, ref: String(ref) })

/**
 * Resolve a Hetzner Location by name (`nbg1`, `fsn1`, `hel1`, …) or
 * numeric id.
 */
export const findLocation = effect (
  ref: string | number,
): Hetzner.locations.GetLocationResponseLocation!Hetzner.BadGateway | Hetzner.BadRequest | CatalogNotFound | Hetzner.ConfigError | Hetzner.Conflict | Hetzner.Forbidden | Hetzner.GatewayTimeout | Hetzner.Gone | Hetzner.HetznerParseError | import("effect/http/HttpClientError").HttpClientError | Hetzner.InternalServerError | import("@distilled.cloud/core/errors").InvalidInput | Hetzner.Locked | Hetzner.MethodNotAllowed | Hetzner.NotFound | Hetzner.PreconditionFailed | Hetzner.ServiceUnavailable | Hetzner.TooManyRequests | Hetzner.Unauthorized | Hetzner.UnknownHetznerError | Hetzner.UnprocessableEntity!Hetzner.HetznerOpContext => {
  const id = numericId(ref)
  if (id !== undefined) {
    const { location } = Hetzner.locations
      .getLocation({ id }) catch effect (e) => match (e) {
        when { _tag: "NotFound" }: throw notFound("location", ref);
        default: throw e;
      }
    return location
  }
  const { locations } = try Hetzner.locations.listLocations({
    name: String(ref),
    per_page: 50,
  })
  const found = locations.find((item) => item.name === ref)
  if (found === undefined) {
    throw notFound("location", ref)
  }
  return found
}

