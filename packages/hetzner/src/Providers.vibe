import { CredentialsStoreLive } from "alchemy/Auth/Credentials"
import { ProfileStoreLive } from "alchemy/Auth/Profile"
import * as Command from "alchemy/Command"
import * as Provider from "alchemy/Provider"
import { Server as WebsiteServer, ServerProvider as WebsiteServerProvider } from "alchemy/Website/Server"
import * as Layer from "effect/Layer"
import { HetznerAuth } from "./AuthProvider.vibe"
import { Certificate, CertificateProvider } from "./Certificate.vibe"
import * as Credentials from "./Credentials.vibe"
import {
  AdapterLive as DnsAdapterLive,
  RecordList as DnsRecordList,
  RecordListProvider as DnsRecordListProvider,
} from "./DNS.ts"
import { fromCredentials } from "./Environment.vibe"
import { Firewall, FirewallProvider } from "./Firewall.vibe"
import { FloatingIp, FloatingIpProvider } from "./FloatingIp.vibe"
import { FloatingIpAssignment, FloatingIpAssignmentProvider } from "./FloatingIpAssignment.vibe"
import { Image, ImageProvider } from "./Image.vibe"
import { LoadBalancer, LoadBalancerProvider } from "./LoadBalancer.vibe"
import { MountVolumeLive } from "./MountVolume.vibe"
import { Network, NetworkProvider } from "./Network.vibe"
import { PlacementGroup, PlacementGroupProvider } from "./PlacementGroup.vibe"
import { PrimaryIp, PrimaryIpProvider } from "./PrimaryIp.vibe"
import { ReadDnsHttp } from "./ReadDnsHttp.vibe"
import { ReadWriteDnsHttp } from "./ReadWriteDnsHttp.vibe"
import { RecordSet, RecordSetProvider } from "./RecordSet.vibe"
import { Server, ServerProvider } from "./Server.ts"
import { Service, ServiceProvider } from "./Service.vibe"
import { SshLive } from "./Ssh.vibe"
import { SshKey, SshKeyProvider } from "./SshKey.vibe"
import { Volume, VolumeProvider } from "./Volume.vibe"
import { VolumeAttachment, VolumeAttachmentProvider } from "./VolumeAttachment.vibe"
import { WriteDnsHttp } from "./WriteDnsHttp.vibe"
import { Zone, ZoneProvider } from "./Zone.vibe"

export class Providers extends Provider.ProviderCollection<Providers>()("Hetzner") {}

export type ProviderRequirements = Layer.Services<ReturnType<typeof providers>>

/**
 * Build a layer that registers all Hetzner resource providers, the Hetzner
 * `AuthProvider`, the resolved `Credentials`, and an `HttpClient`. Include
 * this from your stack alongside other cloud `providers()` layers.
 *
 * Resource providers are inserted into {@link Provider.collection} as they
 * land.
 *
 * @example
 * ```typescript
 * import * as Alchemy from "alchemy";
 * import * as Hetzner from "@alchemy.run/hetzner";
 * import * as Effect from "effect/Effect";
 *
 * export default Alchemy.Stack(
 *   "MyStack",
 *   {
 *     providers: Hetzner.providers(),
 *     state: Alchemy.localState(),
 *   },
 *   Effect.gen(function* () {
 *     return {};
 *   }),
 * );
 * ```
 */
export const providers = (): infer _ =>
  Layer.effect(
    Providers,
    Provider.collection([
      Certificate,
      Firewall,
      FloatingIp,
      FloatingIpAssignment,
      Image,
      LoadBalancer,
      Network,
      PlacementGroup,
      PrimaryIp,
      DnsRecordList,
      RecordSet,
      Server,
      Service,
      SshKey,
      Volume,
      VolumeAttachment,
      WebsiteServer,
      Zone,
    ]),
  ).pipe(
    Layer.provide(
      Layer.mergeAll(
        CertificateProvider(),
        FirewallProvider(),
        FloatingIpProvider(),
        FloatingIpAssignmentProvider(),
        ImageProvider(),
        LoadBalancerProvider(),
        NetworkProvider(),
        PlacementGroupProvider(),
        PrimaryIpProvider(),
        DnsRecordListProvider(),
        RecordSetProvider(),
        ServerProvider(),
        ServiceProvider(),
        SshKeyProvider(),
        VolumeProvider(),
        VolumeAttachmentProvider(),
        WebsiteServerProvider(),
        ZoneProvider(),
      ),
    ),
    // `domain.dns: Hetzner.DNS.Adapter()` on any platform's custom domain.
    Layer.provideMerge(DnsAdapterLive),
    Layer.provideMerge(ReadDnsHttp),
    Layer.provideMerge(WriteDnsHttp),
    Layer.provideMerge(ReadWriteDnsHttp),
    Layer.provideMerge(SshLive),
    Layer.provideMerge(MountVolumeLive),
    Layer.provideMerge(fromCredentials()),
    Layer.provideMerge(Credentials.fromAuthProvider()),
    Layer.provideMerge(HetznerAuth),
    Layer.provideMerge(ProfileStoreLive),
    Layer.provideMerge(CredentialsStoreLive),
    Layer.provideMerge(FetchHttpClient.layer),
    Layer.provideMerge(Command.providers()),
    Layer.orDie,
  )
