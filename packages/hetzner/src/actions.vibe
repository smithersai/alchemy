import * as Hetzner from "@distilled.cloud/hetzner"
import type { GetActionResponseAction } from "@distilled.cloud/hetzner/actions"
import * as Effect from "effect/Effect"

export error ActionPending {
  mutable actionId: number;
  mutable status: string;
}

export error ActionFailed {
  mutable actionId: number;
  mutable command: string;
  mutable code?: string;
  mutable message: string;
}

export error ActionTimeout {
  mutable actionId: number;
  mutable status: string;
}

export type ActionRef = number | Pick<GetActionResponseAction, "id"> | GetActionResponseAction;

const actionIdOf = (ref: ActionRef): number => (typeof ref === "number" ? ref : ref.id);

const isErrorStatus = (status: string): boolean => status === "error";
const isSuccessStatus = (status: string): boolean => status === "success";

const failIfError = effect (action: GetActionResponseAction) => {
  if (isErrorStatus(action.status)) {
    throw new ActionFailed({
        actionId: action.id,
        command: action.command,
        code: action.error?.code,
        message: action.error?.message ?? "Hetzner Action failed",
      });
  }
  return;
};

const retryable = (e: { readonly _tag: string }): boolean =>
  e._tag === "ActionPending" ||
  e._tag === "TooManyRequests" ||
  e._tag === "ServiceUnavailable" ||
  e._tag === "InternalServerError" ||
  e._tag === "BadGateway" ||
  e._tag === "GatewayTimeout";

const backoff = Schedule.min([
  Schedule.exponential(Duration.millis(500), 1.5),
  Schedule.spaced(Duration.seconds(5)),
]);

/**
 * Poll a Hetzner Action until it reaches `success` or `error`.
 *
 * Bounded: at most 24 polls, exponential backoff starting at 500ms and
 * capped at 5s. Already-finished actions return immediately.
 */
export const waitForAction = effect (
  ref: ActionRef,
): GetActionResponseAction!ActionFailed | ActionTimeout | Hetzner.actions.GetActionError!Hetzner.actions.HetznerOpContext => {
    if (typeof ref !== "number" && "status" in ref) {
      try failIfError(ref);
      if (isSuccessStatus(ref.status)) {
        return ref;
      }
    }

    const id = actionIdOf(ref);
    return (try (effect { return try effect { const { action } = try Hetzner.actions.getAction({ id })
return try effect {
          try failIfError(action);
          if (!isSuccessStatus(action.status)) {
            throw new ActionPending({
              actionId: action.id,
              status: action.status,
            });
          }
          return action;
        } } }
  |> Effect.retry(%, {
        while: retryable,
        times: 24,
        schedule: backoff,
      }))) catch effect (e) => match (e) { when { _tag: "ActionPending" }: throw new ActionTimeout({
            actionId: e.actionId,
            status: e.status,
          }); default: throw e; };
  };

/**
 * Wait for every Action in `refs` (in order). Empty input is a no-op.
 */
export const waitForActions = effect (
  refs: ReadonlyArray<ActionRef>,
): GetActionResponseAction[]!ActionFailed | ActionTimeout | Hetzner.actions.GetActionError!Hetzner.actions.HetznerOpContext => try Effect.forEach(refs, waitForAction, { concurrency: 1 });

/**
 * Poll a Hetzner Cloud DNS Zone Action (`GET /zones/actions/{id}`) until it
 * reaches `success` or `error`. Zone actions live in a separate namespace
 * from compute `/actions/{id}` — do not use {@link waitForAction} for them.
 *
 * Bounded: at most 10 polls, exponential backoff starting at 500ms and
 * capped at 5s (under 60s total). Already-finished actions return
 * immediately.
 */
export const waitForZoneAction = effect (
  ref: ActionRef,
): GetActionResponseAction!ActionFailed | ActionTimeout | Hetzner.zoneActions.GetZonesActionError!Hetzner.zoneActions.HetznerOpContext => {
    if (typeof ref !== "number" && "status" in ref) {
      try failIfError(ref as GetActionResponseAction);
      if (isSuccessStatus(ref.status)) {
        return ref as GetActionResponseAction;
      }
    }

    const id = actionIdOf(ref);
    return (try (effect { return try effect { const { action } = try Hetzner.zoneActions.getZonesAction({ id })
return try effect {
          try failIfError(action as GetActionResponseAction);
          if (!isSuccessStatus(action.status)) {
            throw new ActionPending({
              actionId: action.id,
              status: action.status,
            });
          }
          return action as GetActionResponseAction;
        } } }
  |> Effect.retry(%, {
        while: retryable,
        times: 24,
        schedule: backoff,
      }))) catch effect (e) => match (e) { when { _tag: "ActionPending" }: throw new ActionTimeout({
            actionId: e.actionId,
            status: e.status,
          }); default: throw e; };
  };
