import * as zoneRrsetActions from "@distilled.cloud/hetzner/zone_rrset_actions"
import * as zoneRrsets from "@distilled.cloud/hetzner/zone_rrsets"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { type DnsAuth, makeHttpDnsBinding } from "./DnsHttp.vibe"
import { WriteDns, type WriteDnsClient } from "./WriteDns.vibe"

/** Runtime layer for {@link WriteDns}. */
export const WriteDnsHttp = Layer.effect(
  WriteDns,
  Effect.suspend(effect () =>
    try makeHttpDnsBinding({
      makeClient: dnsWriteClient,
    })
  ),
)

/** Build the write client over an injectable auth and zone id. */
export const dnsWriteClient = (auth: DnsAuth, zoneId: number!!): WriteDnsClient => {
  const authorize = auth.authorize
  return {
    createRecordSet: effect (request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsets.createZoneRrset({
              id_or_name: String(try zoneId),
              ...request,
            }),
          )
        },
        "Hetzner.DNS.createRecordSet",
      ),
    updateRecordSet: effect (name, type, request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsets.updateZoneRrset({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              ...request,
            }),
          )
        },
        "Hetzner.DNS.updateRecordSet",
      ),
    deleteRecordSet: effect (name, type) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsets.deleteZoneRrset({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
            }),
          )
        },
        "Hetzner.DNS.deleteRecordSet",
      ),
    addRecordSetRecords: effect (name, type, request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsetActions.addZoneRrsetRecords({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              ...request,
            }),
          )
        },
        "Hetzner.DNS.addRecordSetRecords",
      ),
    removeRecordSetRecords: effect (name, type, request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsetActions.removeZoneRrsetRecords({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              ...request,
            }),
          )
        },
        "Hetzner.DNS.removeRecordSetRecords",
      ),
    setRecordSetRecords: effect (name, type, request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsetActions.setZoneRrsetRecords({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              ...request,
            }),
          )
        },
        "Hetzner.DNS.setRecordSetRecords",
      ),
    updateRecordSetRecords: effect (name, type, request) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsetActions.updateZoneRrsetRecords({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              ...request,
            }),
          )
        },
        "Hetzner.DNS.updateRecordSetRecords",
      ),
    changeRecordSetTtl: effect (name, type, ttl) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsetActions.changeZoneRrsetTtl({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              ttl,
            }),
          )
        },
        "Hetzner.DNS.changeRecordSetTtl",
      ),
    changeRecordSetProtection: effect (name, type, change) =>
      try withSpan(
        effect {
          return try authorize(
            zoneRrsetActions.changeZoneRrsetProtection({
              id_or_name: String(try zoneId),
              rr_name: name,
              rr_type: type,
              change,
            }),
          )
        },
        "Hetzner.DNS.changeRecordSetProtection",
      ),
  }
}
