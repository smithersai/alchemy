{
  "name": "@alchemy.run/kubernetes",
  "version": "2.0.0-beta.84",
  "description": "Kubernetes deployments, jobs, Helm charts, manifests and local clusters for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "helm",
    "infrastructure-as-code",
    "kubernetes"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/kubernetes"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./BuiltinAdapters": "./src/BuiltinAdapters.vibe",
    "./Connection": "./src/Connection.vibe",
    "./Deployment": "./src/Deployment.vibe",
    "./HelmChart": "./src/HelmChart.vibe",
    "./internal/declared": "./src/internal/declared.vibe",
    "./LocalCluster": "./src/LocalCluster.vibe",
    "./Manifest": "./src/Manifest.vibe",
    "./Providers": "./src/Providers.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./Connection.vibe.throwing": null,
    "./internal/declared.vibe.platform": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./Connection.vibe.throwing": null,
      "./internal/declared.vibe.platform": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/docker": "workspace:*",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-2fe05486ecc6.tgz",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-316a192f4c8a.tgz"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    }
  }
}
