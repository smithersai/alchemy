{
  "name": "@alchemy.run/kubernetes",
  "version": "2.0.0-beta.84",
  "description": "Kubernetes deployments, jobs, Helm charts, manifests and local clusters for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "helm",
    "infrastructure-as-code",
    "kubernetes"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/kubernetes"
  },
  "files": [
    "lib",
    "src",
    "!lib/internal/kubeconfig.platform.d.ts",
    "!lib/internal/kubeconfig.platform.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./BuiltinAdapters": "./src/BuiltinAdapters.vibe",
    "./ClusterAdapter": "./src/ClusterAdapter.vibe",
    "./Deployment": "./src/Deployment.vibe",
    "./HelmChart": "./src/HelmChart.vibe",
    "./internal/kubeconfig": "./src/internal/kubeconfig.vibe",
    "./internal/registry": "./src/internal/registry.vibe",
    "./internal/workload": "./src/internal/workload.vibe",
    "./LocalCluster": "./src/LocalCluster.vibe",
    "./Manifest": "./src/Manifest.vibe",
    "./Providers": "./src/Providers.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./internal/kubeconfig.platform": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./internal/kubeconfig.platform": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/docker": "workspace:*",
    "vibelang-runtime": "0.0.14-pre.6279f9f9fbfc",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.6279f9f9fbfc"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    }
  }
}
