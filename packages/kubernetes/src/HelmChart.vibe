import { hashDirectory } from "alchemy/Command/Memo"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { collectRedactedSecrets } from "alchemy/Util/Redaction"
import { sha256Object } from "alchemy/Util/sha256"
import * as FileSystem from "effect/FileSystem"
import {
  connectCluster,
  deleteObjects,
  ifClusterExists,
  readObject,
  reconcileObjects,
  resolveKindSpec,
} from "./Client.ts"
import type { ClusterTransport } from "./ClusterAdapter.ts"
import { toConnection, type ClusterLike, type Connection } from "./Connection.ts"
import { hashDriftSelection } from "./internal/declared.ts"
import { renderHelmChart } from "./internal/helm.ts"
import { connectionIdentity, connectionOfOutput, tryConnectionOf } from "./internal/workload.ts"
import { kubernetesObjectKey, type KubernetesObjectDefinition, type KubernetesObjectRef } from "./Objects.ts"
import type { Providers } from "./Providers.vibe"

export interface HelmChartProps {
  /**
   * Target cluster the chart's objects are applied onto. Pass a managed
   * cluster resource (e.g. `AWS.EKS.Cluster`), a
   * `Kubernetes.KubeConfig(...)`, or a raw `Kubernetes.Connection`.
   */
  mutable cluster: ClusterLike
  /**
   * Chart reference: a repository chart name (used with {@link repo}, e.g.
   * `"ingress-nginx"`), an `oci://` registry reference, or a local chart
   * directory path.
   */
  mutable chart: string
  /**
   * Classic chart repository URL, e.g.
   * `https://kubernetes.github.io/ingress-nginx`. Not needed for `oci://`
   * references or local chart directories.
   */
  mutable repo?: string
  /**
   * Chart version to render. Pin this for repository/OCI charts — without
   * it, helm resolves the latest version at each deploy and the rendered
   * objects can drift between runs. Ignored for local chart directories.
   */
  mutable version?: string
  /**
   * Helm release name the chart's templates render with
   * (`.Release.Name`). If omitted, a deterministic name is derived from
   * the stack, stage, and logical ID.
   */
  mutable releaseName?: string
  /**
   * Kubernetes namespace the objects are rendered into
   * (`.Release.Namespace`; also injected as `metadata.namespace` on
   * namespaced objects the chart leaves namespace-less). The namespace
   * must already exist unless {@link createNamespace} is set.
   * @default "default"
   */
  mutable namespace?: string
  /**
   * Values passed to the chart — a literal object, the same shape as a
   * `values.yaml` file.
   */
  mutable values?: Record<string, unknown>
  /**
   * Render objects from the chart's `crds/` directory too.
   * @default true
   */
  mutable includeCrds?: boolean
  /**
   * Create the target Namespace and track it while this flag stays on.
   * Turning it off leaves the Namespace in the cluster.
   * @default false
   */
  mutable createNamespace?: boolean
}

export interface HelmChart extends
  Resource<
    "Kubernetes.HelmChart",
    HelmChartProps,
    {
      /** The connection of the cluster the chart is applied to. */
      mutable connection: Connection
      /** The Helm release name the chart rendered with. */
      mutable releaseName: string
      /** The namespace the chart rendered into. */
      mutable namespace: string
      /** The chart reference that was rendered. */
      mutable chart: string
      /** The pinned chart version, when one was declared. */
      mutable version: string | undefined
      /** References to the applied Kubernetes objects. */
      mutable objects: KubernetesObjectRef[]
      /** Content hash of the chart inputs (and local chart files). */
      mutable code: {
        mutable hash: string
      }
      /**
       * Set by `read` when an applied object is missing or its fingerprint
       * changed. Reconcile does not persist it; the extra field is what
       * `alchemy drift` compares.
       */
      mutable observedHash?: string
    },
    {},
    Providers
  >
{}

/**
 * Renders a Helm chart and converges its objects onto any Kubernetes
 * cluster via server-side apply.
 *
 * The chart is rendered locally with the `helm` CLI (`helm template` —
 * install helm on the deploying machine, like Docker for image builds);
 * the rendered objects then flow through the same apply machinery as
 * `Kubernetes.Manifest`: Alchemy owns the object lifecycle, re-applies the
 * full render whenever the chart's inputs change, prunes objects that drop
 * out of the render, and deletes everything on destroy. There is no
 * in-cluster Helm release record; the target `cluster` can be a managed
 * cluster resource (e.g. `AWS.EKS.Cluster`) or any cluster your kubeconfig
 * can reach.
 *
 * Helm lifecycle hooks (`helm.sh/hook`-annotated objects: install/upgrade/
 * delete hooks, tests) are neither executed nor applied — the chart is
 * rendered with `--no-hooks`, so they never enter the managed-object graph.
 * Charts that depend on hooks for correctness should be installed with Helm
 * directly.
 * ### Installing a Chart
 * **Example:** Chart from a repository
 * ```typescript
 * const ingress = yield* Kubernetes.HelmChart("IngressNginx", {
 *   cluster,
 *   chart: "ingress-nginx",
 *   repo: "https://kubernetes.github.io/ingress-nginx",
 *   version: "4.11.2",
 *   namespace: "ingress-nginx",
 *   createNamespace: true,
 *   values: {
 *     controller: { replicaCount: 2 },
 *   },
 * });
 * ```
 *
 * **Example:** OCI chart
 * ```typescript
 * const karpenter = yield* Kubernetes.HelmChart("Karpenter", {
 *   cluster,
 *   chart: "oci://public.ecr.aws/karpenter/karpenter",
 *   version: "1.0.6",
 *   namespace: "kube-system",
 * });
 * ```
 *
 * **Example:** Local chart directory
 * ```typescript
 * const app = yield* Kubernetes.HelmChart("App", {
 *   cluster,
 *   chart: "./charts/app",
 *   values: { image: { tag: "v1.2.3" } },
 * });
 * ```
 *
 * @resource
 * @product Helm
 */
export const HelmChart = Resource<HelmChart>("Kubernetes.HelmChart", {
  aliases: ["AWS.EKS.HelmChart"],
})

/**
 * Hash the chart identity: every render input, plus the chart directory's
 * content hash when `chart` is a local path (so editing a local chart is
 * visible to `diff` even though no prop changed).
 */
const computeChartHash = effect (news: HelmChartProps, releaseName: string) => {
  const fs = try Effect.service(FileSystem.FileSystem)
  const isLocalDir = !news.chart.startsWith("oci://") && (try fs.exists(news.chart))
  return try sha256Object({
    chart: news.chart,
    repo: news.repo,
    version: news.version,
    releaseName,
    namespace: news.namespace ?? "default",
    values: news.values,
    includeCrds: news.includeCrds ?? true,
    createNamespace: news.createNamespace ?? false,
    localChart: isLocalDir ? try hashDirectory({ cwd: news.chart }) : undefined,
  })
}

const resolveReleaseName = effect (
  id: string,
  news: HelmChartProps,
  output: HelmChart["Attributes"] | undefined,
) =>
  try Effect.suspend(effect () => {
    if (news.releaseName) return news.releaseName
    if (output?.releaseName) return output.releaseName
    // Helm rejects release names longer than 53 characters.
    return try createPhysicalName({ id, maxLength: 53, lowercase: true })
  })

/**
 * Charts commonly omit `metadata.namespace` and rely on the install
 * namespace. Server-side apply addresses objects by explicit path, so
 * inject the target namespace into namespaced objects that omit it
 * (resolving each kind's scope; cluster-scoped objects pass through).
 */
const injectNamespace = effect (
  transport: ClusterTransport,
  objects: ReadonlyArray<KubernetesObjectDefinition>,
  namespace: string,
) =>
  try Effect.forEach(objects, effect (object) => {
    if (object.metadata.namespace !== undefined) return object
    const spec = try resolveKindSpec({ transport, input: object })
    if (spec.scope === "Cluster") return object
    return {
      ...object,
      metadata: { ...object.metadata, namespace },
    } satisfies KubernetesObjectDefinition
  })

const chartObjects = effect (
  transport: ClusterTransport,
  props: HelmChartProps,
  releaseName: string,
) => {
  const namespace = props.namespace ?? "default"
  const redactions = props.values === undefined ? [] : collectRedactedSecrets(props.values)
  const rendered = try renderHelmChart({
    chart: props.chart,
    repo: props.repo,
    version: props.version,
    releaseName,
    namespace,
    values: props.values,
    includeCrds: props.includeCrds,
  })
  const placed = try injectNamespace(transport, rendered, namespace)
  const objects = props.createNamespace && namespace !== "default"
    ? [
      {
        apiVersion: "v1",
        kind: "Namespace",
        metadata: { name: namespace },
      } satisfies KubernetesObjectDefinition,
      ...placed,
    ]
    : placed
  return { objects, redactions }
}

export const HelmChartProvider = (): infer _ =>
  Provider.effect(
    HelmChart,
    effect {
      return {
        stables: ["connection", "releaseName", "namespace"],
        // In-cluster objects have no cloud-side enumeration that attributes
        // them to alchemy; refresh happens per-instance through `read`.
        list: effect () => [] as HelmChart["Attributes"][],
        diff: effect ({ id, olds, news, output }) => {
          if (!isResolved(news)) return
          const releaseName = try resolveReleaseName(id, news, output)
          const oldCluster = connectionIdentity(tryConnectionOf(olds?.cluster))
          const newCluster = connectionIdentity(tryConnectionOf(news.cluster))
          // Object identity is the (cluster, release, namespace) triple —
          // moving any of it means a different set of objects.
          if (
            output
            && ((oldCluster !== undefined && newCluster !== undefined && oldCluster !== newCluster)
              || output.releaseName !== releaseName
              || output.namespace !== (news.namespace ?? "default"))
          ) {
            return { action: "replace" } as const
          }
          if (output) {
            const hash = try computeChartHash(news, releaseName)
            if (hash !== output.code.hash) {
              return { action: "update" } as const
            }
          }
        },
        reconcile: effect ({ id, news, olds, output, session }) => {
          const releaseName = try resolveReleaseName(id, news, output)
          const namespace = news.namespace ?? "default"
          const connection = toConnection(news.cluster)
          const transport = try connectCluster(connection)
          const hash = try computeChartHash(news, releaseName)

          try session.note(
            `Rendering Helm chart ${news.chart}${news.version ? `@${news.version}` : ""}...`,
          )
          const { objects: desiredObjects, redactions } = try chartObjects(
            transport,
            news,
            releaseName,
          )

          try session.note(
            `Applying ${String(desiredObjects.length)} objects from ${news.chart}...`,
          )
          // Turning createNamespace off releases the Namespace. It stays in the cluster.
          const previousObjects = (output?.objects ?? []).filter(
            (object) =>
              !(
                olds?.createNamespace === true
                && news.createNamespace !== true
                && object.kind === "Namespace"
                && object.name === namespace
              ),
          )
          const objects = try reconcileObjects({
            transport,
            previousObjects,
            desiredObjects,
            redactions,
          })

          return {
            connection,
            releaseName,
            namespace,
            chart: news.chart,
            version: news.version,
            objects: [...objects],
            code: { hash },
          }
        },
        read: effect ({ output }) => {
          if (!output) return undefined
          const connection = connectionOfOutput(output)
          if (!connection) return undefined
          // ClusterNotFound fails the drift row. undefined means an object is gone.
          // GETs only: a dry-run PATCH needs `patch`, and re-rendering a chart
          // rerolls randAlphaNum into a false drift.
          const transport = try connectCluster(connection)
          const notes = try Effect.forEach(
            output.objects,
            effect (object) => {
              const key = kubernetesObjectKey(object)
              const observed = readObject({ transport, object }) catch effect (e) => match (e) {
                when { _tag: "KubernetesNotFound" }: try Effect.undefined;
                default: throw e;
              }
              if (!observed) return `missing:${key}`
              // Older rows stored no selection. Re-rendering the chart is
              // not a read, so only a missing object is drift until apply
              // writes a mask.
              if (object.driftMask === undefined || object.baselineHash === undefined) {
                return undefined
              }
              const liveHash = try hashDriftSelection(object.driftMask, observed)
              return liveHash === object.baselineHash ? undefined : liveHash
            },
            { concurrency: 8 },
          )
          const drifted = notes.filter((note): note is string => note !== undefined)
          if (drifted.length === 0) return output
          return {
            ...output,
            observedHash: try sha256Object({ notes: drifted }),
          }
        },
        delete: effect ({ output }) => {
          const connection = connectionOfOutput(output)
          if (!connection) return
          const transport = try ifClusterExists(connectCluster(connection))
          if (!transport) return
          try deleteObjects({ transport, objects: output.objects })
        },
      }
    },
  )
