import { Unowned } from "alchemy/AdoptPolicy"
import { deepEqual, isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"
import { applyObject, connectCluster } from "./Client.ts"
import type { Connection, ContainerRegistry } from "./Connection.ts"
import { kindClusterConfig, kindConfigOf } from "./internal/kind.ts"
import type { Providers } from "./Providers.vibe"

export interface LocalClusterProps extends KindClusterConfig {
  /**
   * Name of the kind cluster. Its kubeconfig context is `kind-<name>`.
   * Changing it replaces the cluster.
   * @default a name generated from the stack, stage, and logical ID
   */
  mutable name?: string
  /**
   * Host port of the cluster's image registry, reachable from the deploying
   * machine as `localhost:<registryPort>`. Give each local cluster its own
   * port.
   * @default 5001
   */
  mutable registryPort?: number
  /**
   * The kind node image, which selects the Kubernetes version (e.g.
   * `kindest/node:v1.33.1`). A node's own `image` overrides it. Changing it
   * replaces the cluster.
   * @default kind's default node image
   */
  mutable nodeImage?: string
  /**
   * The kubeconfig file kind writes the cluster's context into. Changing it
   * replaces the cluster.
   * @default `$KUBECONFIG` or `~/.kube/config`
   */
  mutable kubeconfig?: string
}

/**
 * The fields of a [kind `Cluster` config](https://kind.sigs.k8s.io/docs/user/configuration/)
 * (`kind.x-k8s.io/v1alpha4`), accepted directly on `LocalCluster`. kind
 * can't reconfigure a running cluster, so changing any of them replaces the
 * cluster.
 */
export interface KindClusterConfig {
  /**
   * The cluster's nodes.
   * @default a single control-plane node
   */
  mutable nodes?: KindNode[]
  /** Cluster networking. */
  mutable networking?: KindNetworking
  /** Kubernetes feature gates, e.g. `{ InPlacePodVerticalScaling: true }`. */
  mutable featureGates?: Record<string, boolean>
  /** API server `--runtime-config` entries, e.g. `{ "api/alpha": "false" }`. */
  mutable runtimeConfig?: Record<string, string>
  /** kubeadm config patches (YAML strategic-merge) applied to every node. */
  mutable kubeadmConfigPatches?: string[]
  /** kubeadm config patches (RFC 6902 JSON patches) applied to every node. */
  mutable kubeadmConfigPatchesJSON6902?: KindJsonPatch[]
  /**
   * containerd config patches (TOML). Alchemy appends its own for the image
   * registry.
   */
  mutable containerdConfigPatches?: string[]
  /** containerd config patches (RFC 6902 JSON patches). */
  mutable containerdConfigPatchesJSON6902?: string[]
}

/** A node in a kind cluster. */
export interface KindNode {
  /** Whether the node runs the control plane or only workloads. */
  mutable role: "control-plane" | "worker"
  /** Node image for this node, overriding `nodeImage`. */
  mutable image?: string
  /** Kubernetes labels for the node. */
  mutable labels?: Record<string, string>
  /** Host ports forwarded to the node container. */
  mutable extraPortMappings?: KindPortMapping[]
  /** Host paths mounted into the node container. */
  mutable extraMounts?: KindMount[]
  /** kubeadm config patches (YAML strategic-merge) for this node. */
  mutable kubeadmConfigPatches?: string[]
  /** kubeadm config patches (RFC 6902 JSON patches) for this node. */
  mutable kubeadmConfigPatchesJSON6902?: KindJsonPatch[]
}

/** A host port forwarded to a kind node container. */
export interface KindPortMapping {
  /** Port on the node container, e.g. a NodePort or hostPort. */
  mutable containerPort: number
  /** Port on the host. */
  mutable hostPort: number
  /**
   * Host address to listen on.
   * @default "0.0.0.0"
   */
  mutable listenAddress?: string
  /** @default "TCP" */
  mutable protocol?: "TCP" | "UDP" | "SCTP"
}

/** A host path mounted into a kind node container. */
export interface KindMount {
  /** Path on the host. */
  mutable hostPath: string
  /** Path in the node container. */
  mutable containerPath: string
  mutable readOnly?: boolean
  /** Relabel the mount for SELinux hosts. */
  mutable selinuxRelabel?: boolean
  mutable propagation?: "None" | "HostToContainer" | "Bidirectional"
}

/** Cluster networking settings for kind. */
export interface KindNetworking {
  mutable ipFamily?: "ipv4" | "ipv6" | "dual"
  /**
   * Host port of the API server.
   * @default a random port
   */
  mutable apiServerPort?: number
  /**
   * Host address the API server listens on.
   * @default "127.0.0.1"
   */
  mutable apiServerAddress?: string
  /** Pod network CIDR. */
  mutable podSubnet?: string
  /** Service network CIDR. */
  mutable serviceSubnet?: string
  /** Skip kind's default CNI so you can install your own. */
  mutable disableDefaultCNI?: boolean
  mutable kubeProxyMode?: "iptables" | "ipvs" | "nftables" | "none"
  /** DNS search domains for nodes. */
  mutable dnsSearch?: string[]
}

/** An RFC 6902 JSON patch targeting a kubeadm config object. */
export interface KindJsonPatch {
  mutable group: string
  mutable version: string
  mutable kind: string
  /** The JSON patch document, as YAML or JSON. */
  mutable patch: string
}

export interface LocalCluster extends
  Resource<
    "Kubernetes.LocalCluster",
    LocalClusterProps,
    {
      /** The kind cluster name. */
      mutable name: string
      /** The kubeconfig context of the cluster (`kind-<name>`). */
      mutable context: string
      /** The kubeconfig file holding the context, if not the default. */
      mutable kubeconfig: string | undefined
      /** The cluster's image registry (`localhost:<registryPort>`). */
      mutable registry: ContainerRegistry
      /** Name of the registry's Docker container. */
      mutable registryContainer: string
      /** CPU architecture of the cluster's nodes (the Docker host's). */
      mutable architecture: "amd64" | "arm64"
      /**
       * Connection for `Kubernetes.*` resources, including the registry and
       * node architecture. Pass the whole resource as their `cluster`.
       */
      mutable connection: Connection
    },
    {},
    Providers
  >
{}

/**
 * A Kubernetes cluster on your machine, for trying Alchemy's Kubernetes
 * resources and developing against them without a hosted cluster.
 *
 * `LocalCluster` runs a [kind](https://kind.sigs.k8s.io) cluster in Docker
 * together with a local image registry wired into the cluster's nodes, so
 * workloads built from a `main` Effect program or a `context` Dockerfile
 * work the same way they do on a hosted cluster with a registry. Pass the
 * resource as the `cluster` of any `Kubernetes.*` resource.
 *
 * Requires Docker and the `kind` CLI on the deploying machine (set
 * `KIND_BIN` to use a specific binary). The cluster's kubeconfig context,
 * `kind-<name>`, works with `kubectl`.
 *
 * ### Creating a Local Cluster
 * **Example:** Cluster and a Deployment
 * ```typescript
 * const cluster = yield* Kubernetes.LocalCluster("Cluster", {
 *   name: "alchemy",
 * });
 *
 * const web = yield* Kubernetes.Deployment("Web", {
 *   cluster,
 *   image: "ghcr.io/stefanprodan/podinfo:6.15.0",
 *   port: 9898,
 *   serviceType: "ClusterIP",
 * });
 * ```
 *
 * ### Effect Programs
 * **Example:** Run an Effect program as a Job
 * ```typescript
 * const cluster = yield* Kubernetes.LocalCluster("Cluster", {
 *   name: "alchemy",
 * });
 *
 * const hello = yield* Kubernetes.Job(
 *   "Hello",
 *   { cluster, main: import.meta.url },
 *   Effect.gen(function* () {
 *     return {
 *       run: Effect.log("hello from a Job"),
 *     };
 *   }),
 * );
 * ```
 *
 * ### Kind Configuration
 * **Example:** Forward a host port to a NodePort
 * ```typescript
 * const cluster = yield* Kubernetes.LocalCluster("Cluster", {
 *   name: "alchemy",
 *   nodes: [
 *     {
 *       role: "control-plane",
 *       extraPortMappings: [{ containerPort: 30080, hostPort: 8080 }],
 *     },
 *   ],
 * });
 * ```
 *
 * ### Registry Port
 * **Example:** Two local clusters
 * ```typescript
 * const blue = yield* Kubernetes.LocalCluster("Blue", { name: "blue" });
 * const green = yield* Kubernetes.LocalCluster("Green", {
 *   name: "green",
 *   registryPort: 5002,
 * });
 * ```
 *
 * @resource
 * @product LocalCluster
 */
export const LocalCluster = Resource<LocalCluster>("Kubernetes.LocalCluster")

// @vibelang-diagnostics-next-line EK4830:off
export class LocalClusterError extends Data.TaggedError("Kubernetes.LocalClusterError")<{
  mutable message: string
}> {}

const KindBin = effect {
  return Config.String("KIND_BIN") catch () => "kind"
}
const DockerBin = effect {
  return Config.String("DOCKER_BIN") catch () => "docker"
}

const REGISTRY_IMAGE = "registry:3"
const DEFAULT_REGISTRY_PORT = 5001

interface CommandResult {
  mutable exitCode: number
  mutable stdout: string
  mutable stderr: string
}

const toArchitecture = (arch: string): "amd64" | "arm64" => /^(arm64|aarch64)$/i.test(arch.trim()) ? "arm64" : "amd64"

const sanitizeName = (name: string): infer _ =>
  name
    .toLowerCase()
    .replaceAll(/[^a-z0-9-]/g, "-")
    .replaceAll(/^-+|-+$/g, "")

interface RegistryInspect {
  mutable State?: { mutable Running?: boolean }
  mutable Config?: { mutable Labels?: Record<string, string> | null }
  mutable HostConfig?: {
    mutable PortBindings?: Record<string, Array<{ mutable HostPort?: string }> | null> | null
  }
  mutable NetworkSettings?: { mutable Networks?: Record<string, unknown> | null }
}

export const LocalClusterProvider = (): infer _ =>
  Provider.effect(
    LocalCluster,
    effect {
      const fs = try Effect.service(FileSystem.FileSystem)
      const path = try Effect.service(Path.Path)
      const spawner = try Effect.service(ChildProcessSpawner.ChildProcessSpawner)

      /** Run a CLI, returning its exit code and output. */
      const run = effect (bin: string, args: string[], stdin?: string) =>
        try (effect {
          return try effect {
            const result = try effect {
              const child = try (ChildProcess.make(bin, args, {
                stdin: stdin === undefined ? "ignore" : Stream.succeed(new TextEncoder().encode(stdin)),
                stdout: "pipe",
                stderr: "pipe",
                detached: false,
                extendEnv: true,
              })
                |> (effect (command) => try spawner.spawn(command))(%))
              return try Effect.all(
                {
                  exitCode: child.exitCode,
                  stdout: child.stdout.pipe(Stream.decodeText, Stream.mkString),
                  stderr: child.stderr.pipe(Stream.decodeText, Stream.mkString),
                },
                { concurrency: "unbounded" },
              )
            }
            return ({
              exitCode: Number(result.exitCode),
              stdout: result.stdout.trim(),
              stderr: result.stderr.trim(),
            })
          }
        }
          |> Effect.scoped(%)
          |> Effect.catchCause(%, effect (cause) =>
            try Effect.die(
              new Error(
                `Failed to run '${bin}': ${String(cause)}. `
                  + "Kubernetes.LocalCluster needs Docker and the kind CLI "
                  + "(https://kind.sigs.k8s.io/docs/user/quick-start/#installation). "
                  + "Set KIND_BIN or DOCKER_BIN to use specific binaries.",
              ),
            )))

      /** Run a CLI and fail with its stderr on a non-zero exit. */
      const exec = effect (bin: string, args: string[], stdin?: string | undefined) => {
        const result = try run(bin, args, stdin)
        if (result.exitCode !== 0) {
          throw new LocalClusterError({
            message: `${bin} ${args.join(" ")} exited with code ${result.exitCode}: ${result.stderr}`,
          })
        }
        return result
      }

      const kind = effect (args: string[]) => try exec(try KindBin, args)
      const docker = effect (args: string[], stdin?: string | undefined) => try exec(try DockerBin, args, stdin)

      const kubeconfigArgs = (kubeconfig: string | undefined): infer _ =>
        kubeconfig !== undefined ? ["--kubeconfig", kubeconfig] : []

      const clusterName = effect (
        id: string,
        props: LocalClusterProps | undefined,
        output: LocalCluster["Attributes"] | undefined,
      ) => (output?.name !== undefined
        ? output.name
        : (props?.name !== undefined
          ? sanitizeName(props.name)
          : sanitizeName(try createPhysicalName({ id, maxLength: 40, lowercase: true }))))

      const clusterExists = effect (name: string) => {
        const { stdout } = try kind(["get", "clusters"])
        return stdout.split(/\r?\n/).some((line) => line.trim() === name)
      }

      const inspectRegistry = effect (container: string) => {
        const result = try run(try DockerBin, ["container", "inspect", container])
        if (result.exitCode !== 0) return undefined
        const [info] = JSON.parse(result.stdout) as RegistryInspect[]
        return info
      }

      const registryHostPort = (info: RegistryInspect | undefined): infer _ => {
        const binding = info?.HostConfig?.PortBindings?.["5000/tcp"]?.[0]
        return binding?.HostPort !== undefined ? Number(binding.HostPort) : undefined
      }

      const hostArchitecture = effect {
        const { stdout } = try docker(["version", "--format", "{{.Server.Arch}}"])
        return toArchitecture(stdout)
      }

      const toAttributes = (options: {
        mutable name: string
        mutable kubeconfig: string | undefined
        mutable registryPort: number
        mutable architecture: "amd64" | "arm64"
      }): LocalCluster["Attributes"] => {
        const context = `kind-${options.name}`
        const registry = { server: `localhost:${options.registryPort}` }
        return {
          name: options.name,
          context,
          kubeconfig: options.kubeconfig,
          registry,
          registryContainer: `${options.name}-registry`,
          architecture: options.architecture,
          connection: {
            auth: {
              kind: "kubeconfig",
              path: options.kubeconfig,
              context,
            },
            registry,
            architecture: options.architecture,
          },
        }
      }

      /** Ensure the kind cluster exists and its context is in the kubeconfig. */
      const ensureCluster = effect (options: {
        mutable name: string
        mutable nodeImage: string | undefined
        mutable kubeconfig: string | undefined
        mutable config: KindClusterConfig
        mutable session: { mutable note: (message: string) => void!! }
      }) => {
        if (!(try clusterExists(options.name))) {
          try options.session.note(
            `Creating kind cluster ${options.name} (about 30 seconds)...`,
          )
          const dir = try fs.makeTempDirectory({
            prefix: "alchemy-kind-",
          })
          const configFile = path.join(dir, "kind.yaml")
          try fs.writeFileString(
            configFile,
            JSON.stringify(kindClusterConfig(options.config), null, 2),
          )
          kind([
            "create",
            "cluster",
            "--name",
            options.name,
            "--config",
            configFile,
            "--wait",
            "120s",
            ...(options.nodeImage !== undefined ? ["--image", options.nodeImage] : []),
            ...kubeconfigArgs(options.kubeconfig),
          ]) catch effect (error) => match (error) {
            when { _tag: "Kubernetes.LocalClusterError" }:
              try (/already exist/i.test(error.message) ? Effect.void : throw error);
            default: throw error;
          }
          try fs.remove(dir, { recursive: true })
        }
        // Restore the context if it was removed from the kubeconfig.
        try kind([
          "export",
          "kubeconfig",
          "--name",
          options.name,
          ...kubeconfigArgs(options.kubeconfig),
        ])
      }

      /**
       * Ensure the registry container runs on the desired port, sits on the
       * `kind` network, and every node's containerd resolves
       * `localhost:<port>` to it.
       */
      const ensureRegistry = effect (options: {
        mutable id: string
        mutable name: string
        mutable registryPort: number
        mutable session: { mutable note: (message: string) => void!! }
      }) => {
        const container = `${options.name}-registry`
        let info = try inspectRegistry(container)
        if (info !== undefined && registryHostPort(info) !== options.registryPort) {
          try docker(["container", "rm", "--force", container])
          info = undefined
        }
        if (info === undefined) {
          try options.session.note(
            `Starting image registry on localhost:${options.registryPort}...`,
          )
          const labels = try createInternalTags(options.id)
          try docker([
            "container",
            "run",
            "--detach",
            "--restart=always",
            "--publish",
            `127.0.0.1:${options.registryPort}:5000`,
            "--network",
            "bridge",
            "--name",
            container,
            ...Object.entries(labels).flatMap(([key, value]) => ["--label", `${key}=${value}`]),
            REGISTRY_IMAGE,
          ])
          info = try inspectRegistry(container)
        } else if (info.State?.Running !== true) {
          try docker(["container", "start", container])
        }
        if (info?.NetworkSettings?.Networks?.kind === undefined) {
          docker(["network", "connect", "kind", container]) catch effect (error) => match (error) {
            when { _tag: "Kubernetes.LocalClusterError" }:
              try (/already exists/i.test(error.message) ? Effect.void : throw error);
            default: throw error;
          }
        }

        // containerd on each node: pull `localhost:<port>/…` from the
        // registry container over the kind network.
        const registryDir = `/etc/containerd/certs.d/localhost:${options.registryPort}`
        const { stdout } = try kind(["get", "nodes", "--name", options.name])
        const nodes = stdout
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter((line) => line.length > 0)
        try Effect.forEach(
          nodes,
          effect (node) => {
            try docker(["exec", node, "mkdir", "-p", registryDir])
            try docker(
              ["exec", "-i", node, "cp", "/dev/stdin", `${registryDir}/hosts.toml`],
              `[host."http://${container}:5000"]\n`,
            )
          },
          { concurrency: "unbounded" },
        )
      }

      return {
        stables: ["name", "context", "kubeconfig", "registryContainer"],
        list: effect () => [] as LocalCluster["Attributes"][],
        diff: effect ({ id, olds, news, output }) => {
          if (!isResolved(news)) return
          const oldName = try clusterName(id, olds, output)
          const newName = try clusterName(id, news, undefined)
          if (
            (news.name !== undefined && oldName !== newName)
            || olds?.nodeImage !== news.nodeImage
            || olds?.kubeconfig !== news.kubeconfig
            || !deepEqual(kindConfigOf(olds ?? {}), kindConfigOf(news), {
              stripNullish: true,
            })
          ) {
            return { action: "replace", deleteFirst: true } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const name = try clusterName(id, olds, output)
          if (!(try clusterExists(name))) return undefined
          const registryInfo = try inspectRegistry(`${name}-registry`)
          const attrs = toAttributes({
            name,
            kubeconfig: output?.kubeconfig ?? olds?.kubeconfig,
            registryPort: registryHostPort(registryInfo) ?? olds?.registryPort ?? DEFAULT_REGISTRY_PORT,
            architecture: try hostArchitecture,
          })
          if (output) return attrs
          // kind clusters carry no ownership marker; the registry container
          // we start next to them does. Anything else is foreign.
          const owned = try hasAlchemyTags(id, registryInfo?.Config?.Labels ?? undefined)
          return owned ? attrs : Unowned(attrs)
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = try clusterName(id, news, output)
          const registryPort = news.registryPort ?? DEFAULT_REGISTRY_PORT
          try ensureCluster({
            name,
            nodeImage: news.nodeImage,
            kubeconfig: news.kubeconfig,
            config: kindConfigOf(news),
            session,
          })
          try ensureRegistry({ id, name, registryPort, session })
          const attrs = toAttributes({
            name,
            kubeconfig: news.kubeconfig,
            registryPort,
            architecture: try hostArchitecture,
          })

          // Advertise the registry to in-cluster tooling (KEP-1755).
          const transport = try connectCluster(attrs.connection)
          try applyObject({
            transport,
            object: {
              apiVersion: "v1",
              kind: "ConfigMap",
              metadata: {
                name: "local-registry-hosting",
                namespace: "kube-public",
              },
              data: {
                "localRegistryHosting.v1":
                  `host: "${attrs.registry.server}"\nhelp: "https://kind.sigs.k8s.io/docs/user/local-registry/"\n`,
              },
            },
          })
          try session.note(
            `kind cluster ${name} ready (context ${attrs.context}, registry ${attrs.registry.server})`,
          )
          return attrs
        },
        delete: effect ({ output }) => {
          // Both commands are idempotent: kind ignores a missing cluster.
          try kind([
            "delete",
            "cluster",
            "--name",
            output.name,
            ...kubeconfigArgs(output.kubeconfig),
          ])
          try run(try DockerBin, ["container", "rm", "--force", output.registryContainer])
        },
      }
    },
  )
