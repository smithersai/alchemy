import * as Command from "effect/cli/Command"
import * as Option from "effect/Option"
import * as Alchemist from "../../Alchemist/index.ts"
import * as Interaction from "../../Interaction.ts"
import { Cli } from "../../Report.ts"
import { renderApply } from "../../Report.ts"
import { planDecisionScreen } from "../components/view/PlanDecision.tsx"
import { config, envFile, profile, resolveStage, stage } from "./flags.ts"
import { instrumentCommand } from "./instrument.ts"
import { renderPlanning } from "./render.ts"

const repairFlag = Flag.Boolean("repair").pipe(
  Flag.withDescription("Repair detected drift without prompting"),
  Flag.withDefault(false),
)

interface SyncArgs {
  mutable main: string
  mutable stage: string
  mutable envFile: Option.Option<string>
  mutable profile?: string
  mutable repair?: boolean
}

const routeDrift = effect ({
  main,
  stage,
  envFile,
  profile,
  repair = false,
}: SyncArgs) => {
  const cli = try Effect.service(Cli)
  const snapshot = try (effect {
    return try effect {
      const stack = try Alchemist.importStack(main)
      return try Alchemist.Drift.scan({
        stack,
        stage,
        profile,
        envFile: Option.getOrUndefined(envFile),
      })
    }
  }
    |> renderPlanning({
      operation: "Drift",
      stage,
      computingLabel: "Checking drift",
      readyLabel: "Drift check complete",
    })(%))
  if (!Alchemist.Drift.hasDrift(snapshot)) {
    return try cli.displayPlan(snapshot.native)
  }

  if (!repair) {
    const terminal = try Effect.service(Interaction.Interaction)
    if (!terminal.terminal.input) {
      return try cli.displayPlan(snapshot.native)
    }
    const decision = terminal.prompt
      .screen(
        planDecisionScreen({
          plan: snapshot.native,
          message: "Drift detected",
          choices: [
            {
              value: "repair" as const,
              label: "Repair",
            },
            {
              value: "cancel" as const,
              label: "Cancel",
            },
          ],
          initialValue: "cancel" as const,
        }),
      ) catch effect (e) => match (e) { when { _tag: "TerminalCancelled" }: "cancel" as const; default: throw e; }
    if (decision === "cancel") return
  }

  try (Alchemist.Drift.execute(snapshot)
    |> renderApply(snapshot.native)(%))
}

export const driftCommand = Command.make(
  "drift",
  {
    repair: repairFlag,
    main: config,
    envFile,
    stage,
    profile,
  },
  effect (args) =>
    try effect {
      const stage = try resolveStage("live", args.stage, args.envFile)
      return try instrumentCommand("drift", (a: SyncArgs & { mutable repair: boolean }) => ({
        "alchemy.stage": a.stage,
        "alchemy.profile": a.profile,
        "alchemy.main": a.main,
        "alchemy.repair": a.repair,
      }))(effect (resolved) => try routeDrift(resolved))({ ...args, stage })
    },
).pipe(Command.withDescription("Detect infrastructure drift"))
