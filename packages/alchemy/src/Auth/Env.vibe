import * as Effect from "effect/Effect"
import * as Interaction from "../Interaction.ts"
import { AuthError } from "./AuthProvider.ts"

export const getEnv = effect (key: string) =>
  (Option.getOrUndefined(try Config.option(Config.String(key)))) catch effect (cause) => {
    throw AuthError.make({
      message: `Could not read optional env: ${key}`,
      cause,
    })
  }

export const getEnvRequired = effect (key: string) =>
  Config.String(key) catch effect (cause) => {
    throw AuthError.make({ message: `Missing required env: ${key}`, cause })
  }

export const getEnvRedacted = effect (key: string) =>
  (Option.getOrUndefined(try Config.option(Config.Redacted(key)))) catch effect (cause) => {
    throw AuthError.make({
      message: `Could not read optional env: ${key}`,
      cause,
    })
  }

export const getEnvRedactedRequired = effect (key: string) =>
  Config.Redacted(key) catch effect (cause) => {
    throw AuthError.make({ message: `Missing required env: ${key}`, cause })
  }

/** Turn a cancelled or unavailable prompt into an `AuthError`; other errors pass through. */
export const mapPromptCancellation = effect <A, E, R>(self: A!E!R) =>
  try (self
    |> Effect.catchIf(%, (cause): cause is Extract<E, Interaction.InteractionError> =>
      cause instanceof Interaction.TerminalCancelled
      || cause instanceof Interaction.NonInteractiveTerminal, effect (cause) => {
      throw AuthError.make({
        message: cause._tag === "TerminalCancelled" ? "User cancelled prompt" : cause.message,
        cause,
      })
    }))
