import * as Effect from "effect/Effect";
import type { EnvironmentVariable } from "../Auth/AuthProvider.ts";
import { getEnv } from "../Auth/Env.vibe";
import { resolveProfileName } from "../Auth/Resolve.ts";
import { loadConfigProvider } from "../Util/ConfigProvider.ts";
import { collectAuthProviders } from "./AuthRegistry.vibe";
import { DEFAULT_ENTRYPOINT, type Target } from "./Entrypoint.ts";
import { AlchemistInvalidInput } from "./Errors.vibe";

export interface CheckEnvironmentInput extends Target {
  /** Providers to check. Omitted means every registered provider. */
  readonly providers?: ReadonlyArray<string>;
}

export interface EnvironmentCheck {
  readonly provider: string;
  readonly status: "satisfied" | "missing" | "no-contract";
  readonly missing: ReadonlyArray<{
    readonly alternatives: ReadonlyArray<string>;
  }>;
}

export interface EnvironmentCheckResult {
  readonly checks: ReadonlyArray<EnvironmentCheck>;
  readonly satisfied: boolean;
}

const satisfied = effect (variable: EnvironmentVariable) => {
  for (const name of [variable.name, ...(variable.alternatives ?? [])]) {
    const value = try getEnv(name);
    if (value !== undefined && value.length > 0) return true;
  }
  return false;
};

/**
 * Verify the environment variables each registered provider's CI contract
 * requires are present.
 */
export const checkEnvironment = effect (
  input: CheckEnvironmentInput,
) =>
  try withSpan(
    effect {
      const profile = try resolveProfileName(Option.fromNullishOr(input.envFile), input.profile);
      const registry = try collectAuthProviders({
        main: input.entrypoint ?? DEFAULT_ENTRYPOINT,
        envFile: Option.fromNullishOr(input.envFile),
        profile,
      });
      const known = Object.keys(registry).sort();
      const names = try (input.providers?.length
        ? Effect.forEach(input.providers, (requested) => {
          const name = known.find((candidate) =>
            candidate.toLowerCase() === requested.toLowerCase()
          );
          return name === undefined
            ? Effect.fail(
              new AlchemistInvalidInput({
                field: "providers",
                message: `Unknown provider '${requested}'. Registered: ${
                  known.join(", ")
                }. Install the package that provides it.`,
              }),
            )
            : Effect.succeed(name);
        })
        : Effect.succeed(known));
      const checks = try effect {
        provide ConfigProvider.layer(try loadConfigProvider(Option.fromNullishOr(input.envFile))) {
          return try Effect.forEach(names, effect (name) => {
            const contract = registry[name]!.environment;
            const missing: Array<{ alternatives: ReadonlyArray<string>; }> = [];
            for (const variable of contract) {
              if (variable.required && !(try satisfied(variable))) {
                missing.push({
                  alternatives: [variable.name, ...(variable.alternatives ?? [])],
                });
              }
            }
            return {
              provider: name,
              status: contract.length === 0
                ? ("no-contract" as const)
                : missing.length === 0
                ? ("satisfied" as const)
                : ("missing" as const),
              missing,
            } satisfies EnvironmentCheck;
          });
        }
      };
      return {
        checks,
        satisfied: checks.every((check) => check.status !== "missing"),
      } satisfies EnvironmentCheckResult;
    },
    "Alchemist.provider.checkEnvironment",
  );
