import * as Effect from "effect/Effect"
import * as Redacted from "effect/Redacted"
import { AuthError } from "../Auth/AuthProvider.vibe"
import { CredentialsStore } from "../Auth/Credentials.vibe"
import { inspectProvider, type ProviderConnection } from "../Auth/Inspect.vibe"
import { withProfileCredentialsLock } from "../Auth/Lock.vibe"
import { ProfileStore, reloadProviderConfig } from "../Auth/Profile.vibe"
import { emit } from "../Events.vibe"
import type { Interaction } from "../Interaction.ts"
import { collectAuthProviders } from "./AuthRegistry.vibe"
import { DEFAULT_ENTRYPOINT, type Target } from "./Entrypoint.vibe"
import { AlchemistInvalidInput, AlchemistNotFound } from "./Errors.vibe"

/** Which project/profile pair a provider-scoped operation resolves against. */
export interface ProviderContext extends Target {
  readonly profile: string
}

export interface ProfileSummary {
  readonly name: string
  readonly active: boolean
  readonly providers: ReadonlyArray<{
    readonly name: string
    readonly method: string
  }>
}

export type { ProviderConnection } from "../Auth/Inspect.vibe"

export interface ProfileSnapshot {
  readonly name: string
  readonly active: boolean
  readonly providers: ReadonlyArray<ProviderConnection>
}

export interface ConfigureField {
  readonly name: string
  readonly label: string
  readonly secret: boolean
  readonly required: boolean
  readonly description?: string
  readonly placeholder?: string
}

export interface ConfigureMethod {
  readonly method: string
  readonly label: string
  readonly fields: ReadonlyArray<ConfigureField>
}

export interface AuthProviderDescriptor {
  readonly name: string
  readonly connected: boolean
  readonly configureMethods: ReadonlyArray<ConfigureMethod>
  readonly supportsRefresh: boolean
  readonly supportsLogout: boolean
}

export interface ConfigureInput extends ProviderContext {
  readonly provider: string
  readonly action: "add" | "reconfigure"
  readonly method?: string
  readonly values?: Readonly<Record<string, Redacted.Redacted<string>>>
}

/**
 * Every auth provider reachable from the given project: the built-ins plus
 * whatever the user's stack module registers.
 */
const registry = (input: ProviderContext) =>
  collectAuthProviders({
    main: input.entrypoint ?? DEFAULT_ENTRYPOINT,
    envFile: Option.fromNullishOr(input.envFile),
    profile: input.profile,
  })

/** The effective profile and how it was selected. */
export const current = effect () =>
  try withSpan(
    effect {
      return try (try ProfileStore).current
    },
    "Alchemist.profile.current",
  )

/** Every profile with its connected providers, active profile first. */
export const list = effect () =>
  try withSpan(
    effect {
      const profiles = try ProfileStore
      const [manifest, selected] = try Effect.all([profiles.readManifest, profiles.current])
      return Object.entries(manifest.profiles)
        .sort(([a], [b]) => (a === "default" ? -1 : b === "default" ? 1 : a.localeCompare(b)))
        .map(([name, profile]): ProfileSummary => ({
          name,
          active: name === selected.name,
          providers: Object.entries(profile.providers)
            .sort(([a], [b]) => a.localeCompare(b))
            .map(([name, config]) => ({
              name,
              method: config.method ?? "unknown",
            })),
        }))
    },
    "Alchemist.profile.list",
  )

/** One profile with the live status of each connected provider. */
export const get = effect (
  input: {
    readonly name: string
    readonly includeProviderStatus?: boolean
    readonly entrypoint?: string
    readonly envFile?: string
  },
) =>
  try withSpan(
    effect {
      const includeProviderStatus = input.includeProviderStatus ?? true
      const profiles = try ProfileStore
      const [profile, selected] = try Effect.all([
        profiles.getProfile(input.name),
        profiles.current,
      ])
      if (profile === undefined) {
        throw new AlchemistNotFound({ kind: "profile", id: input.name })
      }
      // Skipping the status probe is what makes `profile list` fast: it
      // reaches no provider APIs, so every connection reads as connected.
      const registered = includeProviderStatus
        ? try registry({
          profile: input.name,
          entrypoint: input.entrypoint,
          envFile: input.envFile,
        })
        : {}
      const entries = Object.entries(profile.providers).sort(([a], [b]) => a.localeCompare(b))
      return {
        name: input.name,
        active: selected.name === input.name,
        providers: try Effect.forEach(
          entries,
          ([provider, config]): ProviderConnection!never!Interaction =>
            includeProviderStatus
              ? (inspectProvider(input.name, provider, config, registered, (updated) =>
                profiles.setProviderConfig(input.name, provider, updated)
                |> Effect.mapError(%, (cause) =>
                  AuthError.make({
                    message: `Could not persist repaired ${provider} credentials for profile '${input.name}'.`,
                    cause,
                  }))) |> Effect.provideService(%, ProfileStore, profiles))
              : Effect.succeed({
                name: provider,
                method: config.method ?? "unknown",
                status: "connected",
                details: [],
              }),
        ),
      } satisfies ProfileSnapshot
    },
    "Alchemist.profile.get",
  )

export const create = effect (input: { readonly name: string }) =>
  try withSpan(
    effect {
      try (try ProfileStore).createProfile(input.name)
      return try get({ name: input.name })
    },
    "Alchemist.profile.create",
  )

export const rename = effect (input: { readonly name: string; readonly newName: string }) =>
  try withSpan(
    effect {
      try (try ProfileStore).renameProfile(input.name, input.newName)
      return try get({ name: input.newName })
    },
    "Alchemist.profile.rename",
  )

/** Delete a profile and every credential stored for it. */
export const deleteProfile = effect (input: { readonly name: string }) =>
  try withSpan(
    effect {
      const profiles = try ProfileStore
      const credentials = try CredentialsStore
      return try withProfileCredentialsLock(
        input.name,
        effect {
          const deleted = try profiles.deleteProfile(input.name)
          if (!deleted) {
            throw new AlchemistNotFound({ kind: "profile", id: input.name })
          }
          try credentials.deleteProfile(input.name)
          return { name: input.name, credentialsDeleted: true } as const
        },
      )
    },
    "Alchemist.profile.delete",
  )

/** Every registered auth provider and how it can be configured. */
export const providers = effect (
  input: { readonly profile?: string; readonly entrypoint?: string; readonly envFile?: string },
) =>
  try withSpan(
    effect {
      const profiles = try ProfileStore
      const profile = input.profile ?? (try profiles.current).name
      const stored = try profiles.ensureProfile(profile)
      const registered = try registry({ ...input, profile })
      return Object.values(registered)
        .sort((a, b) => a.name.localeCompare(b.name))
        .map((provider): AuthProviderDescriptor => ({
          name: provider.name,
          connected: provider.name in stored.providers,
          configureMethods: (provider.configureMethods ?? []).map((method) => ({
            method: method.method,
            label: method.method,
            fields: method.fields.map((field) => ({
              name: field.name,
              label: field.label,
              secret: field.secret ?? false,
              required: !(field.optional ?? false),
              description: field.description,
              placeholder: field.placeholder,
            })),
          })),
          supportsRefresh: true,
          supportsLogout: true,
        }))
    },
    "Alchemist.profile.providers",
  )

/** The configure methods (and fields) one provider accepts. */
export const configureForm = effect (
  input: { readonly profile: string; readonly provider: string; readonly method?: string },
) =>
  try withSpan(
    effect {
      const registered = try providers({ profile: input.profile })
      const provider = registered.find(({ name }) => name === input.provider)
      if (provider === undefined) {
        throw new AlchemistNotFound({ kind: "provider", id: input.provider })
      }
      return input.method === undefined
        ? provider.configureMethods
        : provider.configureMethods.filter(({ method }) => method === input.method)
    },
    "Alchemist.profile.configureForm",
  )

/**
 * Connect or reconfigure a provider in a profile. Reported through
 * the `provider.configure.started` event; interactive providers drive
 * their own prompts.
 */
export const configure = effect (
  input: ConfigureInput,
) =>
  try withSpan(
    effect {
      try emit({
        type: "provider.configure.started",
        provider: input.provider,
      })
      const profiles = try ProfileStore
      const stored = try profiles.ensureProfile(input.profile)
      const provider = (try registry(input))[input.provider]
      if (provider === undefined) {
        throw new AlchemistInvalidInput({
          field: "provider",
          message: `Auth provider '${input.provider}' is not registered. Install the package that provides it.`,
        })
      }
      const connected = input.provider in stored.providers
      if ((input.action === "add" && connected) || (input.action === "reconfigure" && !connected)) {
        throw new AlchemistInvalidInput({
          field: "provider",
          message: `Provider '${input.provider}' is ${connected ? "already" : "not"} connected.`,
        })
      }
      const config = input.method !== undefined && input.values !== undefined
          && provider.configureWith !== undefined
        ? try provider.configureWith(input.profile, {
          method: input.method,
          values: Object.fromEntries(
            Object.entries(input.values).map(([key, value]) => [key, Redacted.value(value)]),
          ),
        })
        : try provider.configure(
          input.profile,
          connected
            ? (provider
              .decodeConfig(input.profile, stored.providers[input.provider]!) catch () => undefined)
            : undefined,
        )
      try profiles.setProviderConfig(input.profile, input.provider, config)
      try emit({
        type: "provider.configure.completed",
        provider: input.provider,
      })
      return try get({
        name: input.profile,
        entrypoint: input.entrypoint,
        envFile: input.envFile,
      })
    },
    "Alchemist.profile.configure",
  )

/** Log a provider out and disconnect it from the profile. */
export const removeProvider = effect (
  input: ProviderContext & { readonly provider: string; readonly logout?: boolean },
) =>
  try withSpan(
    effect {
      const profiles = try ProfileStore
      const stored = try profiles.ensureProfile(input.profile)
      const config = stored.providers[input.provider]
      if (config === undefined) {
        throw new AlchemistNotFound({ kind: "provider", id: input.provider })
      }
      const provider = (try registry(input))[input.provider]
      let logout: "completed" | "skipped-invalid-config" | "unavailable" = "unavailable"
      if (provider !== undefined) {
        const decoded = try (provider.decodeConfig(input.profile, config) |> Effect.option(%))
        if (Option.isSome(decoded)) {
          if (input.logout ?? true) try provider.logout(input.profile, decoded.value)
          logout = "completed"
        } else logout = "skipped-invalid-config"
      }
      try profiles.deleteProviderConfig(input.profile, input.provider)
      return { profile: input.profile, provider: input.provider, logout }
    },
    "Alchemist.profile.removeProvider",
  )

/**
 * Re-run login for connected providers without reconfiguring them. Each
 * provider is reported as the `provider.refresh.started` event.
 */
export const refresh = effect (
  input: ProviderContext & { readonly providers?: ReadonlyArray<string> },
) =>
  try withSpan(
    effect {
      const profiles = try ProfileStore
      const stored = try profiles.ensureProfile(input.profile)
      const registered = try registry(input)
      const connected = Object.keys(stored.providers).sort()
      const requested: Array<string> = []
      for (const requestedName of input.providers ?? []) {
        // `--provider aws` resolves to the connected `AWS`.
        const name = connected.find((name) => name.toLowerCase() === requestedName.toLowerCase())
        if (name === undefined || registered[name] === undefined) {
          const available = connected.filter((name) => registered[name] !== undefined)
          throw new AlchemistInvalidInput({
            field: "providers",
            message: `Provider '${requestedName}' is not connected to profile '${input.profile}'. `
              + (available.length === 0
                ? "No providers are connected."
                : `Connected providers: ${available.join(", ")}.`),
          })
        }
        if (!requested.includes(name)) requested.push(name)
      }
      if (requested.length === 0) requested.push(...connected)
      for (const name of requested) {
        const config = stored.providers[name]
        const provider = registered[name]
        if (config === undefined || provider === undefined) {
          throw new AlchemistInvalidInput({
            field: "providers",
            message: `Provider '${name}' is not connected or registered.`,
          })
        }
        try emit({ type: "provider.refresh.started", provider: name })
        const refreshed = try provider.login(
          input.profile,
          try provider.decodeConfig(input.profile, config),
          (updated) =>
            profiles.setProviderConfig(input.profile, name, updated)
            |> Effect.mapError(%, (cause) =>
              AuthError.make({
                message: `Could not persist refreshed ${name} credentials for profile '${input.profile}'.`,
                cause,
              })),
          reloadProviderConfig(profiles, provider, input.profile),
        )
        if (refreshed !== undefined) {
          try profiles.setProviderConfig(input.profile, name, refreshed)
        }
        try emit({ type: "provider.refresh.completed", provider: name })
      }
      return try get({
        name: input.profile,
        entrypoint: input.entrypoint,
        envFile: input.envFile,
      })
    },
    "Alchemist.profile.refresh",
  )
