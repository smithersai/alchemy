import * as Effect from "effect/Effect"
import * as RpcServer from "./RpcServer.vibe"
import { serve, stop } from "./RpcServerBun.platform.ts"

export const RpcServerBun = RpcServer.layerServer(
  effect ({ parentConnected, parentDisconnected, createRpcSession }) => {
    const server = try serve({ parentConnected, parentDisconnected, createRpcSession })
    // Fire and forget: awaiting `stop(true)` can outlive the process's own shutdown.
    try Effect.addFinalizer(() => stop(server))
    return {
      url: `ws://${server.hostname}:${server.port}`,
    }
  },
)
