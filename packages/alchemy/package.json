{
  "name": "alchemy",
  "version": "2.0.0-beta.84",
  "description": "Infrastructure as Effects for TypeScript.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/alchemy"
  },
  "bin": {
    "alchemy": "./bin/cli.js"
  },
  "files": [
    "bin",
    "!bin/register-dev-mode.js",
    "lib",
    "src",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Auth/OidcToken": "./src/Auth/OidcToken.vibe",
    "./Command/Exec": "./src/Command/Exec.vibe",
    "./Command/Redaction": "./src/Command/Redaction.vibe",
    "./Dependencies": "./src/Dependencies.vibe",
    "./Runtime/ExecutionMemo": "./src/Runtime/ExecutionMemo.vibe",
    "./Runtime/Function": "./src/Runtime/Function.vibe",
    "./Tags": "./src/Tags.vibe",
    "./Util/Stream": "./src/Util/Stream.vibe",
    "./Util/layer-scoped": "./src/Util/layer-scoped.vibe",
    "./Website/AstroOutput": "./src/Website/AstroOutput.vibe",
    "./Alchemist/Errors": "./src/Alchemist/Errors.vibe",
    "./Input": "./src/Input.vibe",
    "./Cli/DevOptions": "./src/Cli/DevOptions.vibe",
    "./WebhookHost": "./src/WebhookHost.vibe",
    "./ResourceContext": "./src/ResourceContext.vibe",
    "./StackContext": "./src/StackContext.vibe",
    "./Self": "./src/Self.vibe",
    "./Auth/BrowserOAuth": "./src/Auth/BrowserOAuth.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./Auth": "./src/Auth/index.ts",
    "./Alchemist": "./src/Alchemist/index.ts",
    "./Command": "./src/Command/index.ts",
    "./Bundle": "./src/Bundle/index.ts",
    "./Cli": "./src/Cli/index.ts",
    "./DNS": "./src/DNS/index.ts",
    "./Runtime/Bootstrap": "./src/Runtime/Bootstrap.ts",
    "./Runtime/ManagedHttpShutdown": "./src/Runtime/ManagedHttpShutdown.ts",
    "./Secrets": "./src/Secrets/index.ts",
    "./State": "./src/State/index.ts",
    "./Util": "./src/Util/index.ts",
    "./bin/alchemy.js": "./bin/alchemy.js",
    "./bin/exec.js": "./bin/exec.js",
    "./ActionRuntimeContext": "./src/ActionRuntimeContext.vibe",
    "./Auth/ProfileMigrationV0": "./src/Auth/ProfileMigrationV0.vibe",
    "./Callback": "./src/Callback.vibe",
    "./Cli/SigilRenderer": "./src/Cli/SigilRenderer.vibe",
    "./Cli/commands/drift": "./src/Cli/commands/drift.vibe",
    "./Cli/commands/instrument": "./src/Cli/commands/instrument.vibe",
    "./Secrets/DotEnv": "./src/Secrets/DotEnv.vibe",
    "./Secrets/Log": "./src/Secrets/Log.vibe",
    "./Secrets/Provider": "./src/Secrets/Provider.vibe",
    "./Telemetry/Layer": "./src/Telemetry/Layer.vibe",
    "./TelemetryRelay": "./src/TelemetryRelay.vibe",
    "./Util/Duration": "./src/Util/Duration.vibe",
    "./Cli/selectCli": "./src/Cli/selectCli.vibe",
    "./Runtime": "./src/Runtime.vibe",
    "./Util/Duration.vibe.$call$ts": null,
    "./Util/Duration.vibe.-24-call-24-ts": null,
    "./Alchemist/AuthRegistry": "./src/Alchemist/AuthRegistry.vibe",
    "./Alchemist/Nuke": "./src/Alchemist/Nuke.vibe",
    "./Alchemist/Profile": "./src/Alchemist/Profile.vibe",
    "./Alchemist/Provider": "./src/Alchemist/Provider.vibe",
    "./AlchemyContext": "./src/AlchemyContext.vibe",
    "./Auth/Env": "./src/Auth/Env.vibe",
    "./Auth/Registry": "./src/Auth/Registry.vibe",
    "./Bundle/Vite": "./src/Bundle/Vite.vibe",
    "./Cli/commands/compat": "./src/Cli/commands/compat.vibe",
    "./Cli/commands/confirm": "./src/Cli/commands/confirm.vibe",
    "./Cli/commands/logs": "./src/Cli/commands/logs.vibe",
    "./Cli/commands/state": "./src/Cli/commands/state.ts",
    "./Command/Providers": "./src/Command/Providers.vibe",
    "./Destroy": "./src/Destroy.vibe",
    "./EvalStack": "./src/EvalStack.vibe",
    "./Local/ProviderLayer": "./src/Local/ProviderLayer.vibe",
    "./Local/RpcProvider": "./src/Local/RpcProvider.vibe",
    "./State/Export": "./src/State/Export.vibe",
    "./State/HttpStateApi": "./src/State/HttpStateApi.vibe",
    "./State/InMemoryState": "./src/State/InMemoryState.vibe",
    "./State/Provisioning": "./src/State/Provisioning.vibe",
    "./State/Sync": "./src/State/Sync.vibe",
    "./State/Tree": "./src/State/Tree.vibe",
    "./Util/exec": "./src/Util/exec.vibe",
    "./Website/packExtraFiles": "./src/Website/packExtraFiles.vibe"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./Auth": {
        "types": "./lib/Auth/index.d.ts",
        "default": "./lib/Auth/index.js"
      },
      "./Alchemist": {
        "types": "./lib/Alchemist/index.d.ts",
        "default": "./lib/Alchemist/index.js"
      },
      "./Command": {
        "types": "./lib/Command/index.d.ts",
        "default": "./lib/Command/index.js"
      },
      "./Bundle": {
        "types": "./lib/Bundle/index.d.ts",
        "default": "./lib/Bundle/index.js"
      },
      "./Cli": {
        "types": "./lib/Cli/index.d.ts",
        "default": "./lib/Cli/index.js"
      },
      "./DNS": {
        "types": "./lib/DNS/index.d.ts",
        "default": "./lib/DNS/index.js"
      },
      "./Runtime/Bootstrap": {
        "types": "./src/Runtime/Bootstrap.ts",
        "bun": "./src/Runtime/Bootstrap.ts",
        "default": "./src/Runtime/Bootstrap.ts"
      },
      "./Runtime/ManagedHttpShutdown": {
        "types": "./src/Runtime/ManagedHttpShutdown.ts",
        "bun": "./src/Runtime/ManagedHttpShutdown.ts",
        "default": "./src/Runtime/ManagedHttpShutdown.ts"
      },
      "./Secrets": {
        "types": "./lib/Secrets/index.d.ts",
        "default": "./lib/Secrets/index.js"
      },
      "./State": {
        "types": "./lib/State/index.d.ts",
        "default": "./lib/State/index.js"
      },
      "./Util": {
        "types": "./lib/Util/index.d.ts",
        "default": "./lib/Util/index.js"
      },
      "./bin/alchemy.js": "./bin/alchemy.js",
      "./bin/exec.js": "./bin/exec.js",
      "./Util/Duration.vibe.$call$ts": null,
      "./Util/Duration.vibe.-24-call-24-ts": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "clear:state": "cd ../../ && bun clear:state",
    "pretest": "pnpm -w ensure:built",
    "test": "alchemy-test",
    "nuke": "cd ../../ && bun nuke"
  },
  "dependencies": {
    "@alchemy.run/node-utils": "workspace:*",
    "@alchemy.run/sigil": "catalog:",
    "capnweb": "catalog:",
    "fflate": "catalog:",
    "pathe": "catalog:",
    "picomatch": "catalog:",
    "rolldown": "catalog:",
    "tinyglobby": "catalog:",
    "vibelang-runtime": "0.0.13",
    "vibelang-unplugin": "0.0.13",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@oxc-project/types": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/react": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "astro": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "next": "catalog:",
    "nuxt": "catalog:",
    "react": "catalog:",
    "react-devtools-core": "catalog:",
    "solid-js": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vibelang": "0.0.13",
    "wrangler": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/frontend-frameworks": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:frontend-peer",
    "ws": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/frontend-frameworks": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
