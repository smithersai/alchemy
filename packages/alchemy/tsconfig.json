{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vibe", "src/**/*.vibex"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "vibelang": {
    "trustedPackages": [
      "@alchemy.run/frontend-frameworks",
      "@alchemy.run/node-utils",
      "@alchemy.run/sigil",
      "alchemy"
    ]
  }
}
