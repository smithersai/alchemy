#!/usr/bin/env bun

// @ts-nocheck

import * as Credentials from "@distilled.cloud/aws/Credentials"
import * as ec2 from "@distilled.cloud/aws/ec2"
import { Region } from "@distilled.cloud/aws/Region"
import { NodeServices } from "@effect/platform-node"

module platform {
  // @ts-nocheck

  import { parseArgs } from "node:util"

  export const { values } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      region: { type: "string", short: "r" },
      profile: { type: "string", short: "p" },
      execute: { type: "boolean" },
      "include-default-vpcs": { type: "boolean" },
      passes: { type: "string" },
      help: { type: "boolean", short: "h" },
    },
    strict: true,
  })
}

import { values } from platform

export class CleanAwsNotReady extends Data.TaggedError("CleanAwsNotReady")<{
  readonly message: string
  readonly cause?: unknown
}> {}
const usage = `
Best-effort EC2 regional cleanup using @distilled.cloud/aws.

Usage:
  bun alchemy/scripts/clean-aws.ts --region us-east-1 [--profile dev]
  bun alchemy/scripts/clean-aws.ts --region us-east-1 --execute

Options:
  --region, -r              AWS region to clean
  --profile, -p             Optional AWS profile
  --execute                 Perform deletions (default is dry-run)
  --include-default-vpcs    Also attempt to delete default VPC resources
  --passes                  Cleanup passes to run (default: 1 dry-run, 4 execute)
  --help, -h                Show this help
`
if (values.help) {
  console.log(usage.trim())
  process.exit(0)
}
const region = values.region ?? process.env.AWS_REGION ?? process.env.AWS_DEFAULT_REGION
if (!region) {
  console.error("Missing --region. Set it explicitly or via AWS_REGION.")
  console.error(usage.trim())
  process.exit(1)
}
if (values.profile) {
  process.env.AWS_PROFILE = values.profile
}
const execute = values.execute ?? false
const includeDefaultVpcs = values["include-default-vpcs"] ?? false
const maxPasses = Number(values.passes ?? (execute ? "4" : "1"))
if (!Number.isFinite(maxPasses) || maxPasses < 1) {
  console.error("--passes must be a positive integer.")
  process.exit(1)
}
const credentialsLayer = values.profile
  ? Layer.provideMerge(
    Credentials.fromSSO(values.profile),
    Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer),
  )
  : Credentials.fromChain()
const runtime = Layer.mergeAll(
  NodeServices.layer,
  FetchHttpClient.layer,
  credentialsLayer,
  Layer.succeed(Region, region),
)
const formatError = (error: unknown): infer _ => {
  if (typeof error === "object" && error && "_tag" in error) {
    const tagged = error as { _tag: string; message?: string }
    return tagged.message ? `${tagged._tag}: ${tagged.message}` : tagged._tag
  }
  if (error instanceof Error) {
    return error.message
  }
  try {
    return JSON.stringify(error)
  } catch {
    return String(error)
  }
}
const log = effect (message: string) => try Effect.sync(() => console.log(message))
const warn = effect (message: string) => try Effect.sync(() => console.warn(message))
const isNotFoundError = (error: unknown): infer _ =>
  typeof error === "object"
  && error !== null
  && "_tag" in error
  && String((error as { _tag: string })._tag).includes("NotFound")
const uniq = <T>(items: ReadonlyArray<T | null | undefined>): infer _ => [
  ...new Set(items.filter((item): item is T => item !== null && item !== undefined)),
]
const chunk = <T>(items: ReadonlyArray<T>, size: number): infer _ => {
  const groups: T[][] = []
  for (let index = 0; index < items.length; index += size) {
    groups.push(items.slice(index, index + size))
  }
  return groups
}
const preview = effect (label: string, ids: ReadonlyArray<string>) =>
  ids.length === 0 ? Effect.void : try log(`Found ${ids.length} ${label}: ${ids.join(", ")}`)
const ignoreFailure = effect <A, E, R>(
  label: string,
  effect: Effect.Effect<A, E, R>,
): Effect.Effect<void, E, R> =>
  effect
  |> Effect.asVoid(%)
  |> try Effect.catch(%, effect (error) =>
    isNotFoundError(error)
      ? try warn(`Already gone ${label}: ${formatError(error)}`)
      : try Effect.fail(error as E))
const deleteEach = effect <R>(
  label: string,
  ids: ReadonlyArray<string>,
  remove: (id: string) => Effect.Effect<any, any, R>,
) =>
  try Effect.gen(function*() {
    if (ids.length === 0) {
      return
    }

    yield* try preview(label, ids)
    if (!execute) {
      return
    }

    yield* try Effect.forEach(ids, effect (id) => try ignoreFailure(`${label} ${id}`, try remove(id)), {
      concurrency: 1,
      discard: true,
    })
  })
const repeatUntil = effect <A, E, R>(
  label: string,
  effect: Effect.Effect<A, E, R>,
  done: (value: A) => boolean,
  attempts: number,
  delayMs: number,
): Effect.Effect<void, E, R> =>
  try Effect.gen(function*() {
    const value = yield* effect
    if (done(value)) {
      return
    }
    if (attempts <= 1) {
      yield* try warn(`Timed out waiting for ${label}.`)
      return
    }
    yield* try log(`Waiting for ${label}...`)
    yield* try Effect.sleep(delayMs)
    yield* try repeatUntil(label, effect, done, attempts - 1, delayMs)
  })
const terminateInstances = effect {
  const response = try ec2.describeInstances({} as any)
  const ids = uniq(
    try Effect.orDie(
      Effect.try({
        try: () =>
          (response.Reservations ?? []).flatMap(effect (reservation: any) =>
            (reservation.Instances ?? [])
              .filter(effect (instance: any) => {
                const state = instance.State?.Name
                return state !== "shutting-down" && state !== "terminated"
              })
              .map(effect (instance: any) => instance.InstanceId)
          ),
        catch: (e) => e,
      }),
    ),
  )

  if (ids.length === 0) {
    return
  }

  void try try preview("instance(s)", ids)
  if (!execute) {
    return
  }

  for (const group of chunk(ids, 100)) {
    try try ignoreFailure(
      `instances ${group.join(", ")}`,
      ec2.terminateInstances({ InstanceIds: group } as any),
    )
  }

  try try repeatUntil(
    "instances to terminate",
    ec2
      .describeInstances({} as any)
      |> Effect.map(%, (result) =>
        uniq(
          (result.Reservations ?? []).flatMap(effect (reservation: any) =>
            (reservation.Instances ?? [])
              .filter(effect (instance: any) => ids.includes(instance.InstanceId))
              .map(effect (instance: any) => instance.State?.Name)
          ),
        )),
    (states) => states.every((state) => state === "terminated"),
    40,
    5_000,
  )
}
const deleteVpcEndpoints = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeVpcEndpoints({} as any)).VpcEndpoints?.map(
      effect (endpoint: any) => endpoint.VpcEndpointId,
    ),
  )

  if (ids.length === 0) {
    return
  }

  yield* try preview("VPC endpoint(s)", ids)
  if (!execute) {
    return
  }

  for (const group of chunk(ids, 25)) {
    yield* try ignoreFailure(
      `VPC endpoints ${group.join(", ")}`,
      ec2.deleteVpcEndpoints({ VpcEndpointIds: group } as any),
    )
  }

  yield* try repeatUntil(
    "VPC endpoints to delete",
    ec2.describeVpcEndpoints({ VpcEndpointIds: ids } as any)
      |> Effect.map(
        %,
        (result) => uniq((result.VpcEndpoints ?? []).map(effect (endpoint: any) => endpoint.VpcEndpointId)),
      )
      |> Effect.catch(
        %,
        effect (error) => isNotFoundError(error) ? try Effect.succeed([] as string[]) : try Effect.fail(error),
      ),
    (remainingIds) => remainingIds.length === 0,
    30,
    5_000,
  )
})
const deleteNatGateways = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeNatGateways({} as any)).NatGateways?.filter(
      effect (natGateway: any) => natGateway.State !== "deleted",
    ).map(effect (natGateway: any) => natGateway.NatGatewayId),
  )

  if (ids.length === 0) {
    return
  }

  yield* try preview("NAT gateway(s)", ids)
  if (!execute) {
    return
  }

  yield* try Effect.forEach(
    ids,
    effect (id) => try ignoreFailure(`NAT gateway ${String(id)}`, ec2.deleteNatGateway({ NatGatewayId: id } as any)),
    { concurrency: 1, discard: true },
  )

  yield* try repeatUntil(
    "NAT gateways to delete",
    ec2
      .describeNatGateways({} as any)
      |> Effect.map(%, (result) =>
        uniq(
          (result.NatGateways ?? [])
            .filter(effect (natGateway: any) => ids.includes(natGateway.NatGatewayId))
            .map(effect (natGateway: any) => natGateway.State),
        )),
    (states) => states.every((state) => state === "deleted"),
    30,
    10_000,
  )
})
const deleteNetworkInterfaces = effect {
  const interfaces = (try ec2.describeNetworkInterfaces({} as any)).NetworkInterfaces ?? []

  const blocked = try Effect.orDie(Effect.try({
    try: () =>
      interfaces.filter(
        effect (networkInterface: any) =>
          networkInterface.Attachment
          || networkInterface.RequesterManaged
          || networkInterface.Status !== "available",
      ),
    catch: (e) => e,
  }))

  if (blocked.length > 0) {
    throw new CleanAwsNotReady({
      message: `Network interfaces still in use: ${try Effect.orDie(Effect.try({
        try: () =>
          blocked
            .map(
              effect (networkInterface: any) =>
                `${networkInterface.NetworkInterfaceId}(status=${
                  networkInterface.Status ?? "unknown"
                }, requesterManaged=${networkInterface.RequesterManaged ?? false}, attachment=${
                  networkInterface.Attachment?.AttachmentId ?? "none"
                })`,
            )
            .join(", "),
        catch: (e) => e,
      }))}`,
    })
  }

  const ids = uniq(
    try Effect.orDie(Effect.try({
      try: () => interfaces.map(effect (networkInterface: any) => networkInterface.NetworkInterfaceId),
      catch: (e) => e,
    })),
  )

  try try deleteEach(
    "network interface(s)",
    ids,
    effect (id) => ec2.deleteNetworkInterface({ NetworkInterfaceId: id } as any),
  )
}
const releaseElasticIps = Effect.gen(function*() {
  const addresses = (yield* ec2.describeAddresses({} as any)).Addresses ?? []
  const ids = uniq(addresses.map(effect (address: any) => address.AllocationId ?? address.PublicIp))

  if (ids.length === 0) {
    return
  }

  yield* try preview("elastic IP(s)", ids)
  if (!execute) {
    return
  }

  yield* try Effect.forEach(
    addresses,
    effect (address: any) =>
      try Effect.gen(function*() {
        if (address.AssociationId) {
          yield* try ignoreFailure(
            `elastic IP association ${address.AssociationId}`,
            ec2.disassociateAddress({
              AssociationId: address.AssociationId,
            } as any),
          )
        }
        yield* try ignoreFailure(
          `elastic IP ${address.AllocationId ?? address.PublicIp}`,
          ec2.releaseAddress(
            address.AllocationId
              ? ({ AllocationId: address.AllocationId } as any)
              : ({ PublicIp: address.PublicIp } as any),
          ),
        )
      }),
    { concurrency: 1, discard: true },
  )
})
const deleteVpcPeeringConnections = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeVpcPeeringConnections({} as any)).VpcPeeringConnections?.filter(
      effect (connection: any) => connection.Status?.Code !== "deleted",
    ).map(effect (connection: any) => connection.VpcPeeringConnectionId),
  )

  yield* try deleteEach(
    "VPC peering connection(s)",
    ids,
    effect (id) => ec2.deleteVpcPeeringConnection({ VpcPeeringConnectionId: id } as any),
  )
})
const deleteVpnConnections = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeVpnConnections({} as any)).VpnConnections?.filter(
      effect (connection: any) => connection.State !== "deleted",
    ).map(effect (connection: any) => connection.VpnConnectionId),
  )

  yield* try deleteEach(
    "VPN connection(s)",
    ids,
    effect (id) => ec2.deleteVpnConnection({ VpnConnectionId: id } as any),
  )
})
const deleteVpnGateways = Effect.gen(function*() {
  const gateways = (yield* ec2.describeVpnGateways({} as any)).VpnGateways ?? []
  const ids = uniq(
    gateways
      .filter(effect (gateway: any) => gateway.State !== "deleted")
      .map(effect (gateway: any) => gateway.VpnGatewayId),
  )

  if (ids.length === 0) {
    return
  }

  yield* try preview("VPN gateway(s)", ids)
  if (!execute) {
    return
  }

  yield* try Effect.forEach(
    gateways,
    effect (gateway: any) =>
      try Effect.gen(function*() {
        for (const attachment of gateway.VpcAttachments ?? []) {
          if (attachment.VpcId && attachment.State !== "detached") {
            yield* try ignoreFailure(
              `VPN gateway attachment ${gateway.VpnGatewayId}`,
              ec2.detachVpnGateway({
                VpcId: attachment.VpcId,
                VpnGatewayId: gateway.VpnGatewayId,
              } as any),
            )
          }
        }

        yield* try ignoreFailure(
          `VPN gateway ${gateway.VpnGatewayId}`,
          ec2.deleteVpnGateway({ VpnGatewayId: gateway.VpnGatewayId } as any),
        )
      }),
    { concurrency: 1, discard: true },
  )
})
const deleteCustomerGateways = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeCustomerGateways({} as any)).CustomerGateways?.map(
      effect (gateway: any) => gateway.CustomerGatewayId,
    ),
  )

  yield* try deleteEach(
    "customer gateway(s)",
    ids,
    effect (id) => ec2.deleteCustomerGateway({ CustomerGatewayId: id } as any),
  )
})
const deleteInternetGateways = Effect.gen(function*() {
  const gateways = (yield* ec2.describeInternetGateways({} as any)).InternetGateways ?? []
  const ids = uniq(gateways.map(effect (gateway: any) => gateway.InternetGatewayId))

  if (ids.length === 0) {
    return
  }

  yield* try preview("internet gateway(s)", ids)
  if (!execute) {
    return
  }

  yield* try Effect.forEach(
    gateways,
    effect (gateway: any) =>
      try Effect.gen(function*() {
        for (const attachment of gateway.Attachments ?? []) {
          if (attachment.VpcId) {
            yield* try ignoreFailure(
              `internet gateway attachment ${gateway.InternetGatewayId}`,
              ec2.detachInternetGateway({
                InternetGatewayId: gateway.InternetGatewayId,
                VpcId: attachment.VpcId,
              } as any),
            )
          }
        }

        yield* try ignoreFailure(
          `internet gateway ${gateway.InternetGatewayId}`,
          ec2.deleteInternetGateway({
            InternetGatewayId: gateway.InternetGatewayId,
          } as any),
        )
      }),
    { concurrency: 1, discard: true },
  )
})
const deleteEgressOnlyInternetGateways = effect {
  const gateways = (try ec2.describeEgressOnlyInternetGateways({} as any)).EgressOnlyInternetGateways ?? []
  const ids = uniq(
    try Effect.orDie(Effect.try({
      try: () => gateways.map(effect (gateway: any) => gateway.EgressOnlyInternetGatewayId),
      catch: (e) => e,
    })),
  )

  try try deleteEach("egress-only internet gateway(s)", ids, effect (id) =>
    ec2.deleteEgressOnlyInternetGateway({
      EgressOnlyInternetGatewayId: id,
    } as any))
}
const deleteRouteTables = Effect.gen(function*() {
  const routeTables = (yield* ec2.describeRouteTables({} as any)).RouteTables?.filter(
    effect (routeTable: any) => !(routeTable.Associations ?? []).some(effect (association: any) => association.Main),
  ) ?? []

  const ids = uniq(routeTables.map(effect (routeTable: any) => routeTable.RouteTableId))

  if (ids.length === 0) {
    return
  }

  yield* try preview("non-main route table(s)", ids)
  if (!execute) {
    return
  }

  yield* try Effect.forEach(
    routeTables,
    effect (routeTable: any) =>
      try Effect.gen(function*() {
        for (const association of routeTable.Associations ?? []) {
          if (!association.Main && association.RouteTableAssociationId) {
            yield* try ignoreFailure(
              `route table association ${association.RouteTableAssociationId}`,
              ec2.disassociateRouteTable({
                AssociationId: association.RouteTableAssociationId,
              } as any),
            )
          }
        }

        yield* try ignoreFailure(
          `route table ${routeTable.RouteTableId}`,
          ec2.deleteRouteTable({
            RouteTableId: routeTable.RouteTableId,
          } as any),
        )
      }),
    { concurrency: 1, discard: true },
  )
})
const deleteSubnets = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeSubnets({} as any)).Subnets?.filter(effect (subnet: any) =>
      includeDefaultVpcs ? true : !subnet.DefaultForAz
    ).map(effect (subnet: any) => subnet.SubnetId),
  )

  yield* try deleteEach("subnet(s)", ids, effect (id) => ec2.deleteSubnet({ SubnetId: id } as any))
})
const deleteSecurityGroups = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeSecurityGroups({} as any)).SecurityGroups?.filter(
      effect (group: any) => group.GroupName !== "default",
    ).map(effect (group: any) => group.GroupId),
  )

  yield* try deleteEach("security group(s)", ids, effect (id) => ec2.deleteSecurityGroup({ GroupId: id } as any))
})
const deleteNetworkAcls = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeNetworkAcls({} as any)).NetworkAcls?.filter(
      effect (acl: any) => !acl.IsDefault,
    ).map(effect (acl: any) => acl.NetworkAclId),
  )

  yield* try deleteEach("network ACL(s)", ids, effect (id) => ec2.deleteNetworkAcl({ NetworkAclId: id } as any))
})
const deleteAvailableVolumes = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeVolumes({} as any)).Volumes?.filter(
      effect (volume: any) => volume.State === "available",
    ).map(effect (volume: any) => volume.VolumeId),
  )

  yield* try deleteEach("available volume(s)", ids, effect (id) => ec2.deleteVolume({ VolumeId: id } as any))
})
const deregisterImages = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeImages({ Owners: ["self"] } as any)).Images?.map(
      effect (image: any) => image.ImageId,
    ),
  )

  yield* try deleteEach("AMI(s)", ids, effect (id) => ec2.deregisterImage({ ImageId: id } as any))
})
const deleteSnapshots = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeSnapshots({
      OwnerIds: ["self"],
    } as any)).Snapshots?.map(effect (snapshot: any) => snapshot.SnapshotId),
  )

  yield* try deleteEach("snapshot(s)", ids, effect (id) => ec2.deleteSnapshot({ SnapshotId: id } as any))
})
const deleteLaunchTemplates = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeLaunchTemplates({} as any)).LaunchTemplates?.map(
      effect (template: any) => template.LaunchTemplateId,
    ),
  )

  yield* try deleteEach(
    "launch template(s)",
    ids,
    effect (id) => ec2.deleteLaunchTemplate({ LaunchTemplateId: id } as any),
  )
})
const deletePlacementGroups = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describePlacementGroups({} as any)).PlacementGroups?.map(
      effect (group: any) => group.GroupName,
    ),
  )

  yield* try deleteEach("placement group(s)", ids, effect (id) => ec2.deletePlacementGroup({ GroupName: id } as any))
})
const deleteKeyPairs = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeKeyPairs({} as any)).KeyPairs?.map(effect (keyPair: any) => keyPair.KeyPairId),
  )

  yield* try deleteEach("key pair(s)", ids, effect (id) => ec2.deleteKeyPair({ KeyPairId: id } as any))
})
const deleteVpcs = Effect.gen(function*() {
  const ids = uniq(
    (yield* ec2.describeVpcs({} as any)).Vpcs?.filter(effect (vpc: any) => includeDefaultVpcs ? true : !vpc.IsDefault)
      .map(effect (
        vpc: any,
      ) => vpc.VpcId),
  )

  yield* try deleteEach("VPC(s)", ids, effect (id) => ec2.deleteVpc({ VpcId: id } as any))
})
const deleteDhcpOptions = Effect.gen(function*() {
  const associatedDhcpOptionsIds = new Set(
    uniq((yield* ec2.describeVpcs({} as any)).Vpcs?.map(effect (vpc: any) => vpc.DhcpOptionsId)),
  )

  const ids = uniq(
    (yield* ec2.describeDhcpOptions({} as any)).DhcpOptions?.map(
      effect (dhcpOptions: any) => dhcpOptions.DhcpOptionsId,
    ).filter(effect (id: string) => id !== "default" && !associatedDhcpOptionsIds.has(id)),
  )

  yield* try deleteEach("DHCP options set(s)", ids, effect (id) => ec2.deleteDhcpOptions({ DhcpOptionsId: id } as any))
})
const main = effect {
  try try log(
    [
      `Mode=${execute ? "execute" : "dry-run"}`,
      `Region=${region}`,
      values.profile ? `Profile=${values.profile}` : undefined,
      includeDefaultVpcs ? "Including default VPCs" : "Skipping default VPCs",
    ]
      .filter((value): value is string => !!value)
      .join(" | "),
  )

  for (let pass = 1; pass <= maxPasses; pass++) {
    try try log(`\n=== Cleanup pass ${pass}/${maxPasses} ===`)

    try terminateInstances
    try deleteVpcEndpoints
    try deleteNatGateways
    try deleteNetworkInterfaces
    try releaseElasticIps
    try deleteVpnConnections
    try deleteVpnGateways
    try deleteCustomerGateways
    try deleteVpcPeeringConnections
    try deleteInternetGateways
    try deleteEgressOnlyInternetGateways
    try deleteRouteTables
    try deleteSubnets
    try deleteSecurityGroups
    try deleteNetworkAcls
    try deleteAvailableVolumes
    try deregisterImages
    try deleteSnapshots
    try deleteLaunchTemplates
    try deletePlacementGroups
    try deleteKeyPairs
    try deleteVpcs
    try deleteDhcpOptions

    if (!execute) {
      try try log("\nDry-run complete. Re-run with --execute to perform deletions.")
      return
    }
  }

  try try log("\nCleanup passes complete.")
}
Effect.runPromise(main |> Effect.provide(%, runtime)).catch((error) => {
  console.error(formatError(error))
  process.exit(1)
})
