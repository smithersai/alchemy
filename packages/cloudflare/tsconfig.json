{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "references": [
    {
      "path": "../alchemy/tsconfig.json"
    },
    { "path": "../sql/tsconfig.json" },
    { "path": "../docker/tsconfig.json" },
    { "path": "../domain/tsconfig.json" },
    {
      "path": "../../submodules/distilled/packages/aws/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/cloudflare/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/iceberg/tsconfig.json"
    },
    {
      "path": "../cloudflare-runtime/tsconfig.json"
    },
    {
      "path": "../acme/tsconfig.json"
    }
  ],
  "vibelang": { "declarationSidecars": true, "trustedPackages": ["@alchemy.run/acme", "@alchemy.run/cloudflare", "@alchemy.run/cloudflare-runtime", "@alchemy.run/docker", "@alchemy.run/domain", "@alchemy.run/frontend-frameworks", "@alchemy.run/sql", "@distilled.cloud/aws", "@distilled.cloud/aws4signer", "@distilled.cloud/cloudflare", "@distilled.cloud/core", "@distilled.cloud/iceberg", "alchemy"] }
}
