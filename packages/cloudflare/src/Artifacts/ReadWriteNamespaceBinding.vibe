import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { Worker, WorkerEnvironment } from "../Workers/Worker.ts"
import { type Namespace as ArtifactsLike } from "./Namespace.ts"
import {
  ArtifactsError,
  ReadNamespace,
  ReadWriteNamespace,
  type ReadWriteNamespaceClient,
  type RepoClient,
  WriteNamespace,
} from "./ReadWriteNamespace.vibe"

const toArtifactsError = (error: any) =>
  new ArtifactsError({
    message: error?.message ?? "Unknown error",
    cause: error,
  })

const wrapRepo = (raw: ArtifactsRepo): RepoClient => ({
  raw,
  createToken: (scope, ttl) => Effect.tryPromise({ try: () => raw.createToken(scope, ttl), catch: toArtifactsError }),
  listTokens: () => Effect.tryPromise({ try: () => raw.listTokens(), catch: toArtifactsError }),
  revokeToken: (tokenOrId) => Effect.tryPromise({ try: () => raw.revokeToken(tokenOrId), catch: toArtifactsError }),
  fork: (name, opts) => Effect.tryPromise({ try: () => raw.fork(name, opts), catch: toArtifactsError }),
})

/**
 * Builds the full Artifacts client over the native worker binding. Each access
 * level (Read / Write / ReadWrite) returns this same object typed to its subset
 * — least-privilege by construction at the call site.
 */
const makeArtifactsClient = (
  env: Record<string, Artifacts>,
  namespace: ArtifactsLike,
): ReadWriteNamespaceClient => {
  const raw = Effect.sync(() => env[namespace.name]!)
  const use = <T>(
    call: (raw: Artifacts) => Effect.Effect<T, ArtifactsError>,
  ): Effect.Effect<T, ArtifactsError> => raw.pipe(Effect.flatMap(call))
  return {
    raw,
    create: (name, opts) =>
      use((raw) => Effect.tryPromise({ try: () => raw.create(name, opts), catch: toArtifactsError })),
    get: (name) =>
      use((raw) => Effect.tryPromise({ try: () => raw.get(name), catch: toArtifactsError })).pipe(
        Effect.flatMap((repo) =>
          repo == null
            ? Effect.fail(
              new ArtifactsError({
                message: `Artifacts repo '${name}' not found`,
                cause: new Error("not_found"),
              }),
            )
            : Effect.succeed(wrapRepo(repo as ArtifactsRepo))
        ),
      ),
    list: (opts) => use((raw) => Effect.tryPromise({ try: () => raw.list(opts), catch: toArtifactsError })),
    delete: (name) => use((raw) => Effect.tryPromise({ try: () => raw.delete(name), catch: toArtifactsError })),
    import: (opts) => use((raw) => Effect.tryPromise({ try: () => raw.import(opts), catch: toArtifactsError })),
  }
}

const makeBinding = <Self>(tag: Self) =>
  Layer.effect(
    tag as any,
    effect {
      const env = try WorkerEnvironment
      const host = try Worker
      return effect (namespace: ArtifactsLike) => {
        if (!globalThis.__ALCHEMY_RUNTIME__) {
          try host.bind(namespace.name, {
            bindings: [
              {
                type: "artifacts",
                name: namespace.name,
                namespace: namespace.namespace,
              } as any,
            ],
          })
        }
        return makeArtifactsClient(env as Record<string, Artifacts>, namespace)
      }
    },
  ) as Layer.Layer<Self, never, Worker | WorkerEnvironment>

/** Read-only Artifacts binding (`get`/`list`/`raw`). */
export const ReadNamespaceBinding = makeBinding(ReadNamespace)
/** Write Artifacts binding (`create`/`delete`/`import`). */
export const WriteNamespaceBinding = makeBinding(WriteNamespace)
/** Full read + write Artifacts binding. */
export const ReadWriteNamespaceBinding = makeBinding(ReadWriteNamespace)
