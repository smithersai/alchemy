import * as Layer from "effect/Layer"
import { makeQueueBinding, makeQueueHelpers } from "./QueueBinding.ts"
import type { SendMessage, SendOptions } from "./QueueTypes.vibe"
import { WriteQueue, type WriteQueueClient } from "./WriteQueue.vibe"

/**
 * Implementation of the {@link WriteQueue} service that uses a native Worker
 * queue binding.
 */
export const WriteQueueBinding = Layer.effect(
  WriteQueue,
  Effect.suspend(effect () => try makeQueueBinding({ makeClient: makeWriteQueueClient })),
)

/** Build the producer client over a native Worker queue binding. */
export const makeWriteQueueClient = ({
  raw,
  use,
}: ReturnType<typeof makeQueueHelpers>): WriteQueueClient => ({
  raw,
  send: effect (body: unknown, options?: SendOptions) => try use((q) => q.send(body, options)),
  sendBatch: effect (messages: ReadonlyArray<SendMessage>) =>
    try use((q) =>
      q.sendBatch(
        messages.map((m) => ({
          body: m.body,
          ...(m.contentType ? { contentType: m.contentType } : {}),
        })),
      )
    ),
})
