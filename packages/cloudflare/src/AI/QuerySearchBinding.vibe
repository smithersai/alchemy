import type * as runtime from "@cloudflare/workers-types"
import * as Layer from "effect/Layer"
import { Worker, WorkerEnvironment } from "../Workers/Worker.ts"
import { makeClient, QuerySearch } from "./QuerySearch.vibe"
import type { SearchInstance } from "./SearchInstance.ts"

/**
 * Runtime layer for {@link QuerySearch}.
 */
export const QuerySearchBinding = Layer.effect(
  QuerySearch,
  effect {
    const env = try Effect.service(WorkerEnvironment)
    const host = try Worker

    return effect (instance: SearchInstance) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try host.bind`${instance}`({
          bindings: [
            {
              type: "ai_search",
              name: instance.LogicalId,
              instanceName: instance.instanceId,
              namespace: instance.namespace,
            },
          ],
        })
      }

      const rawEff = effect {
        return (env as Record<string, runtime.AiSearchInstance>)[instance.LogicalId]!
      }
      return makeClient(rawEff)
    }
  },
)
