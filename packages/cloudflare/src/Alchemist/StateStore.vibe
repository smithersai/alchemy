import * as workers from "@distilled.cloud/cloudflare/workers";
import { currentProfileName } from "alchemy/Auth/Profile";
import type {
  StateStoreImpl,
  StateStoreLifecycle,
  StateStoreLogEntry,
} from "alchemy/Contributions";
import * as Provisioning from "alchemy/State/Provisioning";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as Stream from "effect/Stream";
import * as CloudflareAccess from "../Access.ts";
import * as CloudflareEnvironment from "../CloudflareEnvironment.ts";
import * as CloudflareCredentials from "../Credentials.ts";
import { CloudflareLogs } from "../Logs.vibe";
import {
  bootstrap as bootstrapStateStore,
  state,
  stateStoreScriptName,
  teardownStateStore,
} from "../StateStore/State.ts";

/**
 * The profile, Cloudflare account and clients a store's lifecycle operation
 * runs with, under the profile config and auth registry core provides.
 */
export const stateStoreScope = effect (name: string | undefined) => {
  if (name !== undefined) try Provisioning.storeName(name);
  const layer = Layer.mergeAll(
    CloudflareCredentials.fromAuthProvider(),
    CloudflareEnvironment.fromProfile(),
    CloudflareAccess.AccessLive,
  );
  const { accountId } = try Effect.flatten(CloudflareEnvironment.CloudflareEnvironment).pipe(
    Effect.provide(layer),
  );
  return {
    layer,
    profile: try currentProfileName,
    accountId,
    workerName: try Effect.orDie(Effect.try({
      try: () => stateStoreScriptName(name),
      catch: (cause) => cause,
    })),
  };
};

const logEntry = (line: {
  readonly timestamp: Date;
  readonly message: string;
}): StateStoreLogEntry => ({ timestamp: line.timestamp, message: line.message });

/** The state-store Worker's lifecycle, for `Alchemist.State` and `alchemy state`. */
export const lifecycle: StateStoreLifecycle = {
  bootstrap: ({ name, force }) =>
    effect {
      const { layer, accountId, workerName, profile } = try stateStoreScope(name);
      return try (effect {
        const existed = try workers.getScriptSetting({ accountId, scriptName: workerName }).pipe(
          Effect.as(true),
          Effect.catchTag(["WorkerNotFound", "InvalidRoute", "WorkerHasNoVersions"], () =>
            Effect.succeed(false),
          ),
        );
        const store = try bootstrapStateStore({ workerName, force, profile });
        return {
          status: !existed
            ? ("created" as const)
            : force
              ? ("redeployed" as const)
              : ("adopted" as const),
          store: workerName,
          location: { account: accountId, version: String(try store.getVersion()) },
        };
      }).pipe(Effect.provide(layer));
    },
  teardown: ({ name }) =>
    effect {
      const { layer, workerName, profile } = try stateStoreScope(name);
      try Effect.provide(teardownStateStore({ workerName, profile }), layer);
      return { deleted: [workerName] };
    },
  logs: ({ name, limit, since }) =>
    effect {
      const { layer, accountId, workerName } = try stateStoreScope(name);
      const lines = try (effect {
        const telemetry = try CloudflareLogs;
        return try telemetry.queryLogs({
          accountId,
          filters: [
            { key: "$workers.scriptName", operation: "eq", type: "string", value: workerName },
          ],
          options: { limit: limit ?? 100, since },
        });
      }).pipe(Effect.provide(layer));
      return lines.map(logEntry).sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
    },
  tailLogs: ({ name }) =>
    Stream.unwrap(
      effect {
        const { layer, accountId, workerName } = try stateStoreScope(name);
        const telemetry = try Effect.provide(CloudflareLogs, layer);
        return telemetry
          .tailScript({ accountId, scriptName: workerName })
          .pipe(Stream.provide(layer), Stream.map(logEntry));
      },
    ),
};

/** The state store Cloudflare contributes. */
export const stateStore: StateStoreImpl = { layer: state, lifecycle };
