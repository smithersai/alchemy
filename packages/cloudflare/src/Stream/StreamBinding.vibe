import type * as cf from "@cloudflare/workers-types"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import type * as Binding from "../Workers/Binding.ts"
import { makeBindingLayer } from "../Workers/BindingLayer.vibe"
import { Stream, StreamError, type StreamClient, type StreamVideoClient } from "./Stream.vibe"

/** The binding value produced by calling {@link Stream} (declared on `env` or `yield*`-ed). */
export type StreamBinding = Binding.Binding<Stream["key"], StreamClient, Stream>

/**
 * The layer that provides the Effect-native interface for the Cloudflare
 * Stream binding.
 *
 * Provide it on the Worker effect (`Effect.provide(Cloudflare.Stream.StreamBinding)`)
 * so that yielding a {@link Stream} binding attaches the native `stream`
 * binding to the surrounding Worker at deploy time and, at runtime, resolves to
 * the Effect-native {@link StreamClient} (wrapping the raw `cf.StreamBinding`
 * handle so every operation returns an `Effect`).
 */
export const StreamBinding = makeBindingLayer<Stream, cf.StreamBinding, StreamClient>(
  Stream,
  (raw): StreamClient => {
    const call = effect <T>(
      fn: (binding: cf.StreamBinding) => Promise<T>,
    ): T!StreamError!RuntimeContext =>
      try effect {
        const binding = try raw
        return try tryPromise(() => fn(binding))
      }

    const video = (id: string): StreamVideoClient => ({
      id,
      details: effect () => try call((binding) => binding.video(id).details()),
      update: effect (params) => try call((binding) => binding.video(id).update(params)),
      delete: effect () => try call((binding) => binding.video(id).delete()),
      generateToken: effect () => try call((binding) => binding.video(id).generateToken()),
      downloads: {
        generate: effect (downloadType) => try call((binding) => binding.video(id).downloads.generate(downloadType)),
        get: effect () => try call((binding) => binding.video(id).downloads.get()),
        delete: effect (downloadType) => try call((binding) => binding.video(id).downloads.delete(downloadType)),
      },
      captions: {
        upload: effect (language, input) =>
          try call((binding) => binding.video(id).captions.upload(language, input as unknown as cf.ReadableStream)),
        generate: effect (language) => try call((binding) => binding.video(id).captions.generate(language)),
        list: effect (language) => try call((binding) => binding.video(id).captions.list(language)),
        delete: effect (language) => try call((binding) => binding.video(id).captions.delete(language)),
      },
    })

    return {
      raw,
      upload: effect (url, params) => try call((binding) => binding.upload(url, params)),
      createDirectUpload: effect (params) => try call((binding) => binding.createDirectUpload(params)),
      video,
      videos: {
        list: effect (params) => try call((binding) => binding.videos.list(params)),
      },
      watermarks: {
        generate: effect (input, params) =>
          try call((binding) =>
            // The runtime accepts a stream or a URL string for the first
            // argument; the published types declare the two as overloads.
            binding.watermarks.generate(input as unknown as cf.ReadableStream, params)
          ),
        list: effect () => try call((binding) => binding.watermarks.list()),
        get: effect (watermarkId) => try call((binding) => binding.watermarks.get(watermarkId)),
        delete: effect (watermarkId) => try call((binding) => binding.watermarks.delete(watermarkId)),
      },
    } satisfies StreamClient
  },
)

const tryPromise = effect <T>(fn: () => Promise<T>): T!StreamError =>
  try Effect.tryPromise({
    try: fn,
    catch: (error: any) =>
      new StreamError({
        message: error?.message ?? "Unknown Cloudflare Stream error",
        code: typeof error?.code === "number" ? error.code : undefined,
        statusCode: typeof error?.statusCode === "number" ? error.statusCode : undefined,
        cause: error,
      }),
  })
