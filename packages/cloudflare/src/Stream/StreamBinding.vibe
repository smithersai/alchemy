import type * as cf from "@cloudflare/workers-types"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import type * as Binding from "../Workers/Binding.ts"
import { makeBindingLayer } from "../Workers/BindingLayer.vibe"
import { Stream, StreamError, type StreamClient, type StreamVideoClient } from "./Stream.ts"

/** The binding value produced by calling {@link Stream} (declared on `env` or `yield*`-ed). */
export type StreamBinding = Binding.Binding<Stream["key"], StreamClient, Stream>

/**
 * The layer that provides the Effect-native interface for the Cloudflare
 * Stream binding.
 *
 * Provide it on the Worker effect (`Effect.provide(Cloudflare.Stream.StreamBinding)`)
 * so that yielding a {@link Stream} binding attaches the native `stream`
 * binding to the surrounding Worker at deploy time and, at runtime, resolves to
 * the Effect-native {@link StreamClient} (wrapping the raw `cf.StreamBinding`
 * handle so every operation returns an `Effect`).
 */
export const StreamBinding = makeBindingLayer<Stream, cf.StreamBinding, StreamClient>(
  Stream,
  (raw): StreamClient => {
    const call = effect <T>(
      fn: (binding: cf.StreamBinding) => Promise<T>,
    ): T!StreamError!RuntimeContext =>
      try effect {
        const binding = try raw
        return try tryPromise(() => fn(binding))
      }

    const video = (id: string): StreamVideoClient => ({
      id,
      details: effect () => try call((binding) => $invoke(binding.video(id))),
      update: effect (params) => try call((binding) => $invoke2(binding.video(id), () => params)),
      delete: effect () => try call((binding) => $invoke3(binding.video(id))),
      generateToken: effect () => try call((binding) => $invoke4(binding.video(id))),
      downloads: {
        generate: effect (downloadType) =>
          try call((binding) => $invoke5(binding.video(id).downloads, () => downloadType)),
        get: effect () => try call((binding) => $invoke6(binding.video(id).downloads)),
        delete: effect (downloadType) =>
          try call((binding) => $invoke7(binding.video(id).downloads, () => downloadType)),
      },
      captions: {
        upload: effect (language, input) =>
          try call((binding) =>
            $invoke8(binding.video(id).captions, () => language, () => (input as unknown as cf.ReadableStream))
          ),
        generate: effect (language) => try call((binding) => $invoke5(binding.video(id).captions, () => language)),
        list: effect (language) => try call((binding) => $invoke9(binding.video(id).captions, () => language)),
        delete: effect (language) => try call((binding) => $invoke7(binding.video(id).captions, () => language)),
      },
    })

    return {
      raw,
      upload: effect (url, params) => try call((binding) => $invoke8(binding, () => url, () => params)),
      createDirectUpload: effect (params) => try call((binding) => $invoke10(binding, () => params)),
      video,
      videos: {
        list: effect (params) => try call((binding) => $invoke9(binding.videos, () => params)),
      },
      watermarks: {
        generate: effect (input, params) =>
          try call(async (binding) =>
            // The runtime accepts a stream or a URL string for the first
            // argument; the published types declare the two as overloads.
            binding.watermarks.generate(input as unknown as cf.ReadableStream, params)
          ),
        list: effect () => try call((binding) => $invoke11(binding.watermarks)),
        get: effect (watermarkId) => try call((binding) => $invoke12(binding.watermarks, () => watermarkId)),
        delete: effect (watermarkId) => try call((binding) => $invoke7(binding.watermarks, () => watermarkId)),
      },
    } satisfies StreamClient
  },
)

const tryPromise = effect <T>(fn: () => Promise<T>): T!StreamError =>
  try Effect.tryPromise({
    try: fn,
    catch: (error: any) =>
      new StreamError({
        message: error?.message ?? "Unknown Cloudflare Stream error",
        code: typeof error?.code === "number" ? error.code : undefined,
        statusCode: typeof error?.statusCode === "number" ? error.statusCode : undefined,
        cause: error,
      }),
  })

module $call$ts {
  export function invoke<T extends { "details": Function }>(
    target: T,
  ): ReturnType<Extract<T["details"], (...args: any[]) => any>> {
    return target["details"]()
  }
}
import { invoke as $invoke } from $call$ts

module $call$ts2 {
  export function invoke<T extends { "update": Function }>(
    target: T,
    arg0: () => Parameters<Extract<T["update"], (...args: any[]) => any>>[0],
  ): ReturnType<Extract<T["update"], (...args: any[]) => any>> {
    return target["update"](arg0())
  }
}
