import * as Binding from "alchemy/Binding"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import type { Bucket } from "./Bucket.ts"
import type { Conditional, R2Error, MultipartOptions, MultipartUpload, R2Object, PutOptions } from "./BucketTypes.vibe"

/**
 * @binding
 * @product R2
 * @category Storage & Databases
 */
export interface WriteBucket extends
  Binding.Service<
    WriteBucket,
    "Cloudflare.R2.WriteBucket",
    (bucket: Bucket) => WriteBucketClient!!
  >
{}

export const WriteBucket = Binding.Service<WriteBucket>("Cloudflare.R2.WriteBucket")

export interface WriteBucketClient {
  put<Err = never>(
    key: string,
    value:
      | ReadableStream
      | ArrayBuffer
      | ArrayBufferView
      | string
      | null
      | Blob
      | Stream.Stream<Uint8Array, Err>,
    options?: PutOptions & {
      onlyIf: Conditional | Headers
      contentLength?: number
    },
  ): (R2Object | null)!(R2Error | Err)!RuntimeContext
  put<Err = never>(
    key: string,
    value: ReadableStream | ArrayBuffer | ArrayBufferView | string | null | Blob,
    options?: PutOptions,
  ): R2Object!(R2Error | Err)!RuntimeContext
  put<Err = never>(
    key: string,
    value:
      | ReadableStream
      | ArrayBuffer
      | ArrayBufferView
      | string
      | null
      | Blob
      | Stream.Stream<Uint8Array, Err>,
    options: PutOptions & {
      contentLength: number
    },
  ): R2Object!(R2Error | Err)!RuntimeContext
  delete(keys: string | string[]): void!R2Error!RuntimeContext
  createMultipartUpload(
    key: string,
    options?: MultipartOptions,
  ): MultipartUpload!R2Error!RuntimeContext
  resumeMultipartUpload(
    key: string,
    uploadId: string,
  ): MultipartUpload!R2Error!RuntimeContext
}
