import * as Layer from "effect/Layer"
import { makeBucketBinding, makeHelpers } from "./BucketBinding.vibe"
import { makeRead } from "./ReadBucketBinding.vibe"
import { ReadWriteBucket, type ReadWriteBucketClient } from "./ReadWriteBucket.vibe"
import { makeWrite } from "./WriteBucketBinding.vibe"

/**
 * Implementation of the {@link ReadWriteBucket} binding that uses a Worker binding.
 */
export const ReadWriteBucketBinding = Layer.effect(
  ReadWriteBucket,
  effect {
    return try makeBucketBinding({ makeClient: makeReadWrite })
  },
)

/** Build the read-write binding client from its read and write halves. */
export const makeReadWrite = (helpers: ReturnType<typeof makeHelpers>): ReadWriteBucketClient =>
  ({
    ...makeRead(helpers),
    ...makeWrite(helpers),
  }) satisfies ReadWriteBucketClient
