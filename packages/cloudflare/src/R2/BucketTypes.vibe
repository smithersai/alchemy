import type * as runtime from "@cloudflare/workers-types"
import type * as SigV4 from "@distilled.cloud/aws4signer"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"

export interface R2Object extends Omit<runtime.R2Object, "writeHttpMetadata"> {
  writeHttpMetadata(headers: Headers): void!!
}

export interface ObjectBody extends R2Object {
  get body(): Stream.Stream<Uint8Array, R2Error>
  /**
   * The platform's own body stream, untouched — for hot paths that hand
   * bytes straight to a `Response` without an Effect stream in between
   * (a `pipeTo` between native streams is zero JS per chunk). Consume
   * EITHER this or `body`, never both. Absent on implementations that
   * have no native stream to offer.
   */
  readonly readable?: ReadableStream<Uint8Array> | undefined
  get bodyUsed(): boolean
  arrayBuffer(): ArrayBuffer!R2Error
  bytes(): Uint8Array!R2Error
  text(): string!R2Error
  json<T>(): T!R2Error
  blob(): runtime.Blob!R2Error
}

export type GetOptions = runtime.R2GetOptions
export type PutOptions = runtime.R2PutOptions & {
  mutable contentLength?: number
}

export type ListOptions = runtime.R2ListOptions
export type Objects =
  & {
    mutable objects: R2Object[]
    mutable delimitedPrefixes: string[]
  }
  & (
    | {
      mutable truncated: true
      mutable cursor: string
    }
    | {
      mutable truncated: false
    }
  )
export type Conditional = runtime.R2Conditional

export error R2Error {
  mutable message: string
  mutable cause: Error
}

export interface MultipartUpload {
  mutable raw: runtime.R2MultipartUpload
  readonly key: string
  readonly uploadId: string
  uploadPart(
    partNumber: number,
    value: ReadableStream | (ArrayBuffer | ArrayBufferView) | string | Blob,
    options?: UploadPartOptions,
  ): UploadedPart!R2Error
  abort(): void!R2Error
  complete(uploadedParts: UploadedPart[]): R2Object!R2Error
}
export type MultipartOptions = runtime.R2MultipartOptions
export type UploadedPart = runtime.R2UploadedPart
export interface UploadPartOptions extends runtime.R2UploadPartOptions {}

/**
 * Failure while minting a presigned URL (`PresignGetObject` /
 * `PresignPutObject`): a malformed URL or header, or a WebCrypto error.
 */
export type PresignError = SigV4.SigningError
