import { Credentials, fromApiToken } from "@distilled.cloud/cloudflare/Credentials"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import type { HttpClient } from "effect/http/HttpClient"
import * as Redacted from "effect/Redacted"

/**
 * Resolve credentials from a bound token's value and provide them (plus the
 * fetch-based HTTP client) to a raw SDK operation.
 */
export const authorizeWith =
  (token: { mutable value: Redacted.Redacted<string>!! }): infer _ =>
  effect <A, E>(eff: A!E!Credentials | HttpClient): A!E!RuntimeContext => try effect { return try effect { provide fromApiToken({ apiToken: (try token.value) }).pipe(Layer.provideMerge(FetchHttpClient.layer)) { return try eff } } };
