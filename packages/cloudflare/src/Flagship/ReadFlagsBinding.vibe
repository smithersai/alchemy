import type * as cf from "@cloudflare/workers-types"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { Worker, WorkerEnvironment } from "../Workers/Worker.ts"
import type { App } from "./App.vibe"
import { FlagshipError, ReadFlags, type ReadFlagsClient } from "./ReadFlags.vibe"

export const ReadFlagsBinding = Layer.effect(
  ReadFlags,
  effect {
    const env = try Effect.service(WorkerEnvironment)
    const host = try Worker

    return effect (app: App) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try host.bind(app.LogicalId, {
          bindings: [
            {
              type: "flagship",
              name: app.LogicalId,
              appId: app.appId,
            },
          ],
        })
      }
      const raw: cf.Flagship!never!RuntimeContext = effect {
        return (env as Record<string, cf.Flagship>)[app.LogicalId]!
      }
      return makeFlagshipClient(raw)
    }
  },
)

/** An Effect produced by a {@link ReadFlagsClient} operation. */
type FlagshipEffect<A> = A!FlagshipError!RuntimeContext

const tryPromise = effect <T>(fn: () => Promise<T>): T!FlagshipError =>
  try Effect.tryPromise({
    try: fn,
    catch: (error) =>
      new FlagshipError({
        message: error instanceof Error ? error.message : "Unknown Flagship error",
        cause: error,
      }),
  })

/** @internal */
export const makeFlagshipClient = (
  raw: cf.Flagship!never!RuntimeContext,
): ReadFlagsClient => {
  const call = effect <T>(fn: (binding: cf.Flagship) => Promise<T>): FlagshipEffect<T> =>
    try effect {
      const binding = try raw
      return try tryPromise(() => fn(binding))
    }

  return {
    raw,
    get: effect (flagKey, defaultValue, context) => try call((b) => b.get(flagKey, defaultValue, context)),
    getBooleanValue: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getBooleanValue(flagKey, defaultValue, context)),
    getStringValue: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getStringValue(flagKey, defaultValue, context)),
    getNumberValue: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getNumberValue(flagKey, defaultValue, context)),
    getObjectValue: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getObjectValue(flagKey, defaultValue, context)),
    getBooleanDetails: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getBooleanDetails(flagKey, defaultValue, context)),
    getStringDetails: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getStringDetails(flagKey, defaultValue, context)),
    getNumberDetails: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getNumberDetails(flagKey, defaultValue, context)),
    getObjectDetails: effect (flagKey, defaultValue, context) =>
      try call((b) => b.getObjectDetails(flagKey, defaultValue, context)),
  } satisfies ReadFlagsClient
}
