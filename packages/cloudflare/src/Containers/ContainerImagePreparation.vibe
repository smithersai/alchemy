import type * as Containers from "@distilled.cloud/cloudflare/containers"
import type { ScopedPlanStatusSession } from "alchemy/Report"
import * as Duration from "effect/Duration"
import * as Effect from "effect/Effect"
import { ContainerImagePreparationError, imagePreparationTimeoutMillis } from "./ContainerConfiguration.ts"

/** Wait for Cloudflare preparation, with an interruptible deadline including API calls. */
export const waitForContainerImage = effect <E, R>(options: {
  mutable image: string
  mutable name: string
  mutable timeout?: Duration.Input
  mutable prepare: Containers.PrepareContainerImageResponse!E!R
  mutable session: Pick<ScopedPlanStatusSession, "note">
}) => {
  const timeout = try imagePreparationTimeoutMillis(options.timeout)
  const started = try Clock.currentTimeMillis
  const elapsed = (now: number): infer _ => {
    const seconds = Math.floor((now - started) / 1000)
    return `${Math.floor(seconds / 60)}m ${seconds % 60}s`
  }
  try options.session.note(`Preparing ${options.name} image… 0m 0s`, { kind: "status" })
  try (effect {
    const result = try options.prepare
    const time = elapsed(try Clock.currentTimeMillis)
    if (result.status === "ready") {
      try options.session.note(`Prepared ${options.name} image (${time}).`, {
        kind: "status",
      })
      return true
    }
    if (result.status === "error") {
      throw new ContainerImagePreparationError({
        image: options.image,
        status: "error",
        message: result.reason ?? `Cloudflare could not prepare image '${options.name}'.`,
      })
    }
    try options.session.note(`Preparing ${options.name} image… ${time}`, { kind: "status" })
    return false
  }
    |> Effect.repeat(%, { schedule: Schedule.spaced("5 seconds"), until: (ready) => ready })
    |> Effect.timeoutOrElse(%, {
      duration: timeout,
      orElse: effect () => {
        throw new ContainerImagePreparationError({
          image: options.image,
          status: "pending",
          message: `Image '${options.name}' (${options.image}) was not ready within ${
            timeout / 60000
          } minutes. Deploy again to resume from the published image, or increase imagePreparationTimeout.`,
        })
      },
    }))
}
