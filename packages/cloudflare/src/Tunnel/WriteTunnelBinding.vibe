import * as Layer from "effect/Layer"
import { makeTunnelClient } from "./TunnelBinding.vibe"
import { WriteTunnel, writeClient } from "./WriteTunnel.vibe"

/** Runtime layer for {@link WriteTunnel}. */
export const WriteTunnelBinding = Layer.effect(
  WriteTunnel,
  makeTunnelClient("Cloudflare.Tunnel.WriteTunnel", ["Cloudflare Tunnel Write"], writeClient),
);
