import type * as runtime from "@cloudflare/workers-types"
import * as Binding from "alchemy/Binding"
import type { Input } from "alchemy/Input"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import type { InstantNamespace } from "./InstantNamespace.ts"
import type { ReadInstantNamespaceClient } from "./InstantNamespaceTypes.vibe"
import type { Namespace } from "./Namespace.ts"
import type { NamespaceError } from "./NamespaceTypes.ts"

/**
 * Bind a {@link Namespace} to a Worker with read access and obtain the
 * Effect-native KV client (`get`, `getWithMetadata`, `list`).
 *
 * `ReadNamespace` is a single identifier that is simultaneously the binding's
 * Context tag, its type, and the callable —
 * `yield* Cloudflare.KV.ReadNamespace(ns)`.
 *
 * Also accepts InstantNamespace, returning a client without metadata or
 * paginated listing options.
 *
 * @binding
 * @product KV
 * @category Storage & Databases
 */
export interface ReadNamespace extends
  Binding.Service<
    ReadNamespace,
    "Cloudflare.KV.ReadNamespace",
    {
      (namespace: InstantNamespace): ReadInstantNamespaceClient!!
      (namespace: Namespace): ReadNamespaceClient!!
      (namespace: Namespace | InstantNamespace): ReadInstantNamespaceClient!!
    }
  >
{
  <Req = never>(
    namespace: Input<Namespace> | (Namespace!never!Req),
  ): ReadNamespaceClient!never!ReadNamespace | Req
  <Req = never>(
    namespace:
      | Input<Namespace | InstantNamespace>
      | (Namespace | InstantNamespace!never!Req),
  ): ReadInstantNamespaceClient!never!ReadNamespace | Req
}

export const ReadNamespace = Binding.Service<ReadNamespace>("Cloudflare.KV.ReadNamespace")

export interface ReadNamespaceClient<Key extends string = string> {
  raw: runtime.KVNamespace!never!RuntimeContext
  get(
    key: Key,
    options?: Partial<KVNamespaceGetOptions<undefined>>,
  ): string | null!NamespaceError!RuntimeContext
  get(key: Key, type: "text"): string | null!NamespaceError!RuntimeContext
  get<ExpectedValue = unknown>(
    key: Key,
    type: "json",
  ): ExpectedValue | null!NamespaceError!RuntimeContext
  get(
    key: Key,
    type: "arrayBuffer",
  ): ArrayBuffer | null!NamespaceError!RuntimeContext
  get(
    key: Key,
    type: "stream",
  ): ReadableStream | null!NamespaceError!RuntimeContext
  get(
    key: Key,
    options?: KVNamespaceGetOptions<"text">,
  ): string | null!NamespaceError!RuntimeContext
  get<ExpectedValue = unknown>(
    key: Key,
    options?: KVNamespaceGetOptions<"json">,
  ): ExpectedValue | null!NamespaceError!RuntimeContext
  get(
    key: Key,
    options?: KVNamespaceGetOptions<"arrayBuffer">,
  ): ArrayBuffer | null!NamespaceError!RuntimeContext
  get(
    key: Key,
    options?: KVNamespaceGetOptions<"stream">,
  ): ReadableStream | null!NamespaceError!RuntimeContext
  get(
    key: Array<Key>,
    type: "text",
  ): Map<string, string | null>!NamespaceError!RuntimeContext
  get<ExpectedValue = unknown>(
    key: Array<Key>,
    type: "json",
  ): Map<string, ExpectedValue | null>!NamespaceError!RuntimeContext
  get(
    key: Array<Key>,
    options?: Partial<KVNamespaceGetOptions<undefined>>,
  ): Map<string, string | null>!NamespaceError!RuntimeContext
  get(
    key: Array<Key>,
    options?: KVNamespaceGetOptions<"text">,
  ): Map<string, string | null>!NamespaceError!RuntimeContext
  get<ExpectedValue = unknown>(
    key: Array<Key>,
    options?: KVNamespaceGetOptions<"json">,
  ): Map<string, ExpectedValue | null>!NamespaceError!RuntimeContext
  list<Metadata = unknown>(
    options?: KVNamespaceListOptions,
  ): KVNamespaceListResult<Metadata, Key>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    options?: Partial<KVNamespaceGetOptions<undefined>>,
  ): KVNamespaceGetWithMetadataResult<string, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    type: "text",
  ): KVNamespaceGetWithMetadataResult<string, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<ExpectedValue = unknown, Metadata = unknown>(
    key: Key,
    type: "json",
  ): KVNamespaceGetWithMetadataResult<ExpectedValue, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    type: "arrayBuffer",
  ): KVNamespaceGetWithMetadataResult<ArrayBuffer, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    type: "stream",
  ): KVNamespaceGetWithMetadataResult<ReadableStream, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    options: KVNamespaceGetOptions<"text">,
  ): KVNamespaceGetWithMetadataResult<string, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<ExpectedValue = unknown, Metadata = unknown>(
    key: Key,
    options: KVNamespaceGetOptions<"json">,
  ): KVNamespaceGetWithMetadataResult<ExpectedValue, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    options: KVNamespaceGetOptions<"arrayBuffer">,
  ): KVNamespaceGetWithMetadataResult<ArrayBuffer, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Key,
    options: KVNamespaceGetOptions<"stream">,
  ): KVNamespaceGetWithMetadataResult<ReadableStream, Metadata>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Array<Key>,
    type: "text",
  ): Map<string, KVNamespaceGetWithMetadataResult<string, Metadata>>!NamespaceError!RuntimeContext
  getWithMetadata<ExpectedValue = unknown, Metadata = unknown>(
    key: Array<Key>,
    type: "json",
  ): Map<string, KVNamespaceGetWithMetadataResult<ExpectedValue, Metadata>>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Array<Key>,
    options?: Partial<KVNamespaceGetOptions<undefined>>,
  ): Map<string, KVNamespaceGetWithMetadataResult<string, Metadata>>!NamespaceError!RuntimeContext
  getWithMetadata<Metadata = unknown>(
    key: Array<Key>,
    options?: KVNamespaceGetOptions<"text">,
  ): Map<string, KVNamespaceGetWithMetadataResult<string, Metadata>>!NamespaceError!RuntimeContext
  getWithMetadata<ExpectedValue = unknown, Metadata = unknown>(
    key: Array<Key>,
    options?: KVNamespaceGetOptions<"json">,
  ): Map<string, KVNamespaceGetWithMetadataResult<ExpectedValue, Metadata>>!NamespaceError!RuntimeContext
}
