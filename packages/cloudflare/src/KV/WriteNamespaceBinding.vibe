import type * as runtime from "@cloudflare/workers-types"
import * as Layer from "effect/Layer"
import { makeKVNamespaceBinding, makeKVNamespaceHelpers } from "./NamespaceBinding.ts"
import { WriteNamespace, type WriteNamespaceClient } from "./WriteNamespace.vibe"

/**
 * Implementation of the {@link WriteNamespace} binding that uses a Worker
 * binding.
 */
export const WriteNamespaceBinding = Layer.effect(
  WriteNamespace,
  effect {
    return try makeKVNamespaceBinding({ makeClient: makeWriteKVClient })
  },
)

/** Build the write half of the binding client. */
export const makeWriteKVClient = ({
  use,
}: ReturnType<typeof makeKVNamespaceHelpers>): WriteNamespaceClient => ({
  put: (effect (...args: Parameters<runtime.KVNamespace["put"]>) => try use((raw) => raw.put(...args))) as any,
  delete: (effect (...args: Parameters<runtime.KVNamespace["delete"]>) => try use((raw) => raw.delete(...args))) as any,
})
