import * as zeroTrust from "@distilled.cloud/cloudflare/zero-trust"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { CloudflareEnvironment } from "../CloudflareEnvironment.ts"
import type { Providers } from "../Providers.ts"

export type TagProps = {
  /**
   * The name of the tag. The name IS the tag's identity on the Cloudflare
   * API (it is the path parameter for get/update/delete), so changing it
   * replaces the resource. If omitted, a unique name is generated from the
   * stack/stage/logical id.
   *
   * @default ${app}-${stage}-${id}
   */
  name?: string
}

export type Tag = Resource<
  "Cloudflare.Access.Tag",
  TagProps,
  {
    /** The name of the tag — also its identity on the Cloudflare API. */
    name: string
    /** Cloudflare account that owns the tag. */
    accountId: string
  },
  never,
  Providers
>

/**
 * A Cloudflare Zero Trust Access tag. Tags are plain labels that can be
 * attached to Access applications to group and filter them.
 *
 * The tag's name is its identity — there is nothing to update in place, so
 * renaming replaces the tag.
 * ### Creating a Tag
 * **Example:** Tag with a generated name
 * ```typescript
 * const tag = yield* Cloudflare.Access.Tag("Team", {});
 * ```
 *
 * **Example:** Tag with an explicit name
 * ```typescript
 * const tag = yield* Cloudflare.Access.Tag("Team", {
 *   name: "platform-team",
 * });
 * ```
 *
 * ### Tagging an Application
 * **Example:** Reference from an Access application
 * ```typescript
 * const tag = yield* Cloudflare.Access.Tag("Team", { name: "platform-team" });
 *
 * const app = yield* Cloudflare.Access.Application("Dashboard", {
 *   type: "self_hosted",
 *   domain: "dash.example.com",
 *   tags: [tag.name],
 * });
 * ```
 *
 * @resource
 * @product Access
 * @category Cloudflare One (Zero Trust)
 */
export const Tag = Resource<Tag>("Cloudflare.Access.Tag")

export const isTag = (value: unknown): value is Tag =>
  Predicate.hasProperty(value, "Type") && value.Type === "Cloudflare.Access.Tag"

export const TagProvider = (): infer _ =>
  Provider.succeed(Tag, {
    stables: ["name", "accountId"],
    list: effect () => {
      const { accountId } = try try Effect.service(CloudflareEnvironment)
      return Array.from(
        try (zeroTrust.listAccessTags.pages({ accountId })
          |> Stream.runCollect(%)),
      ).flatMap((page) =>
        (page.result ?? []).map((tag) => ({
          name: tag.name,
          accountId,
        }))
      )
    },
    diff: effect ({ news, output }) => {
      const { accountId } = try try Effect.service(CloudflareEnvironment)
      const resolved_ = try Effect.orDie(Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }))
      if (resolved_ === undefined) return undefined
      if ((output?.accountId ?? accountId) !== accountId) {
        return { action: "replace" } as const
      }
      // The name is the identity — an explicit rename is a replacement.
      if (output && resolved_.name !== undefined && resolved_.name !== output.name) {
        return { action: "replace" } as const
      }
    },
    read: effect ({ id, output, olds }) => {
      const { accountId } = try try Effect.service(CloudflareEnvironment)
      const acct = output?.accountId ?? accountId
      const name = try createTagName(id, output?.name ?? olds?.name)
      const existing = zeroTrust
        .getAccessTag({ accountId: acct, tagName: name }) catch effect (e) => match (e) {
          when zeroTrust.AccessTagNotFound: undefined;
          default: throw e;
        }
      if (!existing) return undefined
      return { name: existing.name, accountId: acct }
    },
    reconcile: effect ({ id, news, output }) => {
      const { accountId } = try try Effect.service(CloudflareEnvironment)
      const acct = output?.accountId ?? accountId
      const name = try createTagName(id, news.name)

      // Observe — the name is the identity, so existence is the only state.
      const observed = zeroTrust
        .getAccessTag({ accountId: acct, tagName: name }) catch effect (e) => match (e) {
          when zeroTrust.AccessTagNotFound: undefined;
          default: throw e;
        }

      // Ensure — create when missing; a create race resolves to the same tag.
      if (!observed) {
        const created = zeroTrust
          .createAccessTag({ accountId: acct, name }) catch effect (err) =>
            zeroTrust
              .getAccessTag({ accountId: acct, tagName: name }) catch effect (e) => match (e) {
                when zeroTrust.AccessTagNotFound: throw err;
                default: throw e;
              }
        return { name: created.name, accountId: acct }
      }

      return { name: observed.name, accountId: acct }
    },
    delete: effect ({ output }) => {
      zeroTrust
        .deleteAccessTag({ accountId: output.accountId, tagName: output.name }) catch effect (e) => match (e) {
          when zeroTrust.AccessTagNotFound: (undefined as void);
          default: throw e;
        }
    },
  })

const createTagName = effect (id: string, name: string | undefined) => {
  if (name) return name
  // Tag names are capped at 35 characters by the Cloudflare API.
  return try createPhysicalName({ id, maxLength: 35, suffixLength: 12 })
}
