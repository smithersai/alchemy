import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import { Worker, WorkerEnvironment } from "../Workers/Worker.ts";
import type { Dataset as AnalyticsEngineDatasetLike } from "./Dataset.ts";
import {
  DatasetError,
  type DatasetClient,
  type RuntimeAnalyticsEngineDataset,
  WriteDataset,
} from "./WriteDataset.ts";

export const WriteDatasetBinding = Layer.effect(
  WriteDataset,
  effect {
    const env = try WorkerEnvironment;
    const host = try Worker;

    return effect (dataset: AnalyticsEngineDatasetLike) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try host.bind(dataset.name, {
          bindings: [
            {
              type: "analytics_engine",
              name: dataset.name,
              dataset: dataset.dataset,
            },
          ],
        });
      }

      const raw = Effect.sync(
        () => (env as Record<string, RuntimeAnalyticsEngineDataset>)[dataset.name]!,
      );

      return {
        raw,
        writeDataPoint: (dataPoint) =>
          raw.pipe(
            Effect.flatMap((raw) =>
              Effect.try({
                try: () => raw.writeDataPoint(dataPoint),
                catch: (error: any) =>
                  new DatasetError({
                    message: error?.message ?? "Unknown error",
                    cause: error,
                  }),
              }),
            ),
          ),
      } satisfies DatasetClient;
    };
  },
);
