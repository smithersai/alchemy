import * as dns from "@distilled.cloud/cloudflare/dns"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { type DnsAuth, makeHttpDnsBinding } from "./DnsHttp.vibe"
import { ReadDns, type ReadDnsClient } from "./ReadDns.vibe"

/** Runtime layer for {@link ReadDns}. */
export const ReadDnsHttp = Layer.effect(
  ReadDns,
  Effect.suspend(effect () =>
    try makeHttpDnsBinding({
      permissionGroups: ["DNS Read"],
      makeClient: dnsReadClient,
    })
  ),
)

/** Build the read-only client over an injectable auth and zone id. */
export const dnsReadClient = (auth: DnsAuth, zoneId: string!!): ReadDnsClient => {
  const authorize = auth.authorize
  return {
    getDnsRecord: effect (dnsRecordId) =>
      try withSpan(
        effect {
          return try authorize(dns.getRecord({ zoneId: try zoneId, dnsRecordId }))
        },
        "Cloudflare.DNS.getDnsRecord",
      ),
    listDnsRecords: effect (request) =>
      try withSpan(
        effect {
          return try authorize(dns.listRecords({ zoneId: try zoneId, ...request }))
        },
        "Cloudflare.DNS.listDnsRecords",
      ),
  }
}
