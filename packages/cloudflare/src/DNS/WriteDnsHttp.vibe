import * as dns from "@distilled.cloud/cloudflare/dns"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { type DnsAuth, makeHttpDnsBinding } from "./DnsHttp.ts"
import { WriteDns, type WriteDnsClient } from "./WriteDns.ts"

/** Runtime layer for {@link WriteDns}. */
export const WriteDnsHttp = Layer.effect(
  WriteDns,
  Effect.suspend(effect () =>
    try makeHttpDnsBinding({
      permissionGroups: ["DNS Write"],
      makeClient: dnsWriteClient,
    }),
  ),
);

/** Build the write client over an injectable auth and zone id. */
export const dnsWriteClient = (auth: DnsAuth, zoneId: string!!): WriteDnsClient => {
  const authorize = auth.authorize;
  return {
    createDnsRecord: effect (request) => try withSpan(effect {
      return try authorize(dns.createRecord({ zoneId: try zoneId, ...request }));
    }, "Cloudflare.DNS.createDnsRecord"),
    updateDnsRecord: effect (dnsRecordId, request) => try withSpan(effect {
      return try authorize(dns.updateRecord({ zoneId: try zoneId, dnsRecordId, ...request }));
    }, "Cloudflare.DNS.updateDnsRecord"),
    patchDnsRecord: effect (dnsRecordId, request) => try withSpan(effect {
      return try authorize(dns.patchRecord({ zoneId: try zoneId, dnsRecordId, ...request }));
    }, "Cloudflare.DNS.patchDnsRecord"),
    deleteDnsRecord: effect (dnsRecordId) => try withSpan(effect {
      return try authorize(dns.deleteRecord({ zoneId: try zoneId, dnsRecordId }));
    }, "Cloudflare.DNS.deleteDnsRecord"),
    batchDnsRecords: effect (request) => try withSpan(effect {
      return try authorize(dns.batchRecord({ zoneId: try zoneId, ...request }));
    }, "Cloudflare.DNS.batchDnsRecords"),
  };
};
