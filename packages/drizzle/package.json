{
  "name": "@alchemy.run/drizzle",
  "version": "2.0.0-beta.84",
  "description": "Drizzle ORM integration for Alchemy: schemas, migrations and Effect SQL clients.",
  "keywords": [
    "alchemy",
    "drizzle",
    "effect",
    "infrastructure-as-code",
    "sql"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/drizzle"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Cloudflare": "./src/Cloudflare.vibe",
    "./D1": "./src/D1.vibe",
    "./LibSQL": "./src/LibSQL.vibe",
    "./MySQL": "./src/MySQL.vibe",
    "./Postgres": "./src/Postgres.vibe",
    "./Providers": "./src/Providers.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/sql": "workspace:*",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-do": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-2fe05486ecc6.tgz"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-316a192f4c8a.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-7159373887c8.tgz"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "alchemy": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "@effect/sql-libsql": {
      "optional": true
    },
    "@effect/sql-mysql2": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  }
}
