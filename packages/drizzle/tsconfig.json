{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../alchemy/tsconfig.json"
    },
    { "path": "../sql/tsconfig.json" }
  ],
  "vibelang": {
    "trustedPackages": [
      "@alchemy.run/cloudflare",
      "@alchemy.run/drizzle",
      "@alchemy.run/sql",
      "alchemy"
    ]
  }
}
