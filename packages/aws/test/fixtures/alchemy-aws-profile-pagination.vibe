import type * as Effect from "effect/Effect"

type Page = { Items?: string[] }
type ReadError = { _tag: "ResourceNotFoundException" } | { _tag: "AccessDeniedException" }

export effect function listProfiles(
  app: { Id?: string },
  pages: (applicationId: string) => Effect.Effect<Page[], ReadError>,
) {
  if (app.Id === undefined) return []
  const applicationId = app.Id
  return (effect {
    return (try pages(applicationId)).flatMap((page) => page.Items ?? [])
  }) catch effect (error) => match (error) {
    when { _tag: "ResourceNotFoundException" }: [] as string[];
    default: throw error;
  }
}
