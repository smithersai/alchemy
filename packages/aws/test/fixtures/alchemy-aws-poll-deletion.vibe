import * as Effect from "effect/Effect"

error Pending
type ReadError = { _tag: "Missing" } | { _tag: "Denied" }

export effect function waitForDeletion(describe: () => Effect.Effect<void, ReadError>) {
  ;(effect {
    return (effect {
      try describe()
      throw new Pending()
    }) catch effect (error) => match (error) {
      when { _tag: "Missing" }: undefined as void;
      default: throw error;
    }
  } |> Effect.retry(%, {
    while: (error) => error._tag === "Pending",
    times: 3,
  })) catch effect (error) => match (error) {
    when { _tag: "Pending" }: undefined as void;
    default: throw error;
  }
}
