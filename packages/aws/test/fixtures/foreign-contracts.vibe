import { make } from "../../src/StepFunctions/Asl/Program.ts"
import { deadlineArnOf } from "../../src/Deadline/internal.ts"
import { makeBunBootstrap } from "../../src/ECR/ImageSource.ts"
import { clientToken } from "../../src/AppRegistry/internal.ts"
import { sanitizeAppSyncName } from "../../src/AppSync/common.ts"
import { toResourceTags } from "../../src/CostExplorer/common.ts"
import { normalizeHostedZoneId, normalizeName } from "../../src/Route53/Record.ts"

export effect function render() {
  return {
    token: clientToken("app-123"),
    name: sanitizeAppSyncName("my-app"),
    tags: try Effect.orDie(Effect.try({ try: () => toResourceTags({ project: "website" }), catch: (e) => e })),
    zone: normalizeHostedZoneId("/hostedzone/ABC"),
    record: normalizeName("example.com"),
  }
}

export effect function renderReturnedHelpers() {
  const arnOf = try deadlineArnOf
  const bootstrap = makeBunBootstrap("handler")
  return {
    arn: arnOf("monitor/example"),
    bootstrap: bootstrap("./entry.ts"),
  }
}

export function makeProgram() {
  return make({ kind: "succeed", value: "ready" })
}
