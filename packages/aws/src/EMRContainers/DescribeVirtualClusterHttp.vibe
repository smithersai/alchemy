import * as emrc from "@distilled.cloud/aws/emr-containers"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { DescribeVirtualCluster } from "./DescribeVirtualCluster.vibe"
import type { VirtualCluster } from "./VirtualCluster.vibe"

/**
 * Bespoke (not scaffold-built): `describeVirtualCluster` addresses the
 * virtual cluster itself via `id` rather than carrying a `virtualClusterId`
 * field, and the grant is on the cluster ARN alone (no sub-resource
 * pattern).
 */
export const DescribeVirtualClusterHttp = Layer.effect(
  DescribeVirtualCluster,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(emrc.describeVirtualCluster)

    return effect (virtualCluster: VirtualCluster) => {
      // Outputs yield a DEFERRED effect — resolve again per invocation below.
      const VirtualClusterId = try virtualCluster.virtualClusterId.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.EMRContainers.DescribeVirtualCluster(${virtualCluster})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["emr-containers:DescribeVirtualCluster"],
              Resource: [virtualCluster.virtualClusterArn],
            },
          ],
        })
      }
      return effect () =>
        try withSpan(
          effect {
            return try op({ id: try VirtualClusterId })
          },
          `AWS.EMRContainers.DescribeVirtualCluster(${virtualCluster.LogicalId})`,
        )
    }
  },
)
