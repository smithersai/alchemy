import * as emrc from "@distilled.cloud/aws/emr-containers"
import { toWireSeconds } from "alchemy/Util/Duration"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { virtualClusterPolicyStatement } from "./BindingHttp.vibe"
import {
  GetManagedEndpointSessionCredentials,
  type GetManagedEndpointSessionCredentialsRequest,
} from "./GetManagedEndpointSessionCredentials.vibe"
import type { VirtualCluster } from "./VirtualCluster.vibe"

export const GetManagedEndpointSessionCredentialsHttp = Layer.effect(
  GetManagedEndpointSessionCredentials,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(emrc.getManagedEndpointSessionCredentials)

    // Bespoke (not the shared builder): the request addresses the cluster as
    // `virtualClusterIdentifier` (not `virtualClusterId`) and carries a
    // `duration` that converts to the wire's `durationInSeconds`.
    return effect (virtualCluster: VirtualCluster) => {
      const VirtualClusterId = try virtualCluster.virtualClusterId.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.EMRContainers.GetManagedEndpointSessionCredentials(${virtualCluster})`({
          policyStatements: [
            try Effect.orDie(Effect.try({
              try: () =>
                virtualClusterPolicyStatement(virtualCluster, [
                  "emr-containers:GetManagedEndpointSessionCredentials",
                  "emr-containers:DescribeManagedEndpoint",
                ]),
              catch: (e) => e,
            })),
          ],
        })
      }
      return effect (request: GetManagedEndpointSessionCredentialsRequest) =>
        try withSpan(
          effect {
            const { duration, ...rest } = request
            return try op({
              ...rest,
              durationInSeconds: try Effect.orDie(Effect.try({ try: () => toWireSeconds(duration), catch: (e) => e })),
              virtualClusterIdentifier: try VirtualClusterId,
            })
          },
          `AWS.EMRContainers.GetManagedEndpointSessionCredentials(${virtualCluster.LogicalId})`,
        )
    }
  },
)
