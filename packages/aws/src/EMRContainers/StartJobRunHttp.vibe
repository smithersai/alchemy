import * as emrc from "@distilled.cloud/aws/emr-containers"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { virtualClusterPolicyStatement } from "./BindingHttp.vibe"
import { StartJobRun } from "./StartJobRun.vibe"
import type { VirtualCluster } from "./VirtualCluster.vibe"

export const StartJobRunHttp = Layer.effect(
  StartJobRun,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(emrc.startJobRun)

    // Bespoke (not the shared builder): `clientToken` is required on the wire
    // schema but auto-generated by the SDK's idempotency-token filling when
    // omitted, so the binding's request keeps it optional.
    return effect (virtualCluster: VirtualCluster) => {
      const VirtualClusterId = try virtualCluster.virtualClusterId.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.EMRContainers.StartJobRun(${virtualCluster})`({
          policyStatements: [
            try Effect.orDie(
              Effect.try({
                try: () => virtualClusterPolicyStatement(virtualCluster, ["emr-containers:StartJobRun"]),
                catch: (e) => e,
              }),
            ),
          ],
        })
      }
      return effect (
        request: Omit<emrc.StartJobRunRequest, "virtualClusterId" | "clientToken"> & {
          clientToken?: string
        },
      ) =>
        try withSpan(
          effect {
            return try op({
              ...request,
              virtualClusterId: try VirtualClusterId,
            } as emrc.StartJobRunRequest)
          },
          `AWS.EMRContainers.StartJobRun(${virtualCluster.LogicalId})`,
        )
    }
  },
)
