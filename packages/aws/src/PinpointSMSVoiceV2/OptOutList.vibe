import { TaggedError as $MutableErrorBase } from "vibelang-runtime";
import { $schemaErrorMatcher as $MutableErrorMatcher } from "vibelang-runtime";
import * as smsvoice from "@distilled.cloud/aws/pinpoint-sms-voice-v2"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { readSmsVoiceTags, retrySmsVoiceThrottled, syncSmsVoiceTags, toTagList } from "./internal.vibe"

export interface OptOutListProps {
  /**
   * Name of the opt-out list (`[A-Za-z0-9_-]+`, 1-64 characters).
   * Changing the name replaces the opt-out list.
   * @default ${app}-${stage}-${id}
   */
  optOutListName?: string
  /**
   * Tags to apply to the opt-out list. Merged with internal Alchemy tags.
   */
  tags?: Record<string, string>
}

export interface OptOutList extends
  Resource<
    "AWS.PinpointSMSVoiceV2.OptOutList",
    OptOutListProps,
    {
      /**
       * Name of the opt-out list.
       */
      optOutListName: string
      /**
       * ARN of the opt-out list.
       */
      optOutListArn: string
    },
    never,
    Providers
  >
{}

/**
 * An AWS End User Messaging SMS (Pinpoint SMS Voice v2) opt-out list — a
 * list of destination phone numbers that opted out of receiving your SMS
 * or voice messages.
 *
 * When an end user replies with a supported opt-out keyword (STOP,
 * CANCEL, OPTOUT, ...), their number is added to the list automatically
 * and further messages to it are suppressed.
 * ### Creating Opt-Out Lists
 * **Example:** Basic Opt-Out List
 * ```typescript
 * import * as PinpointSMSVoiceV2 from "@alchemy.run/aws/PinpointSMSVoiceV2";
 *
 * const optOuts = yield* PinpointSMSVoiceV2.OptOutList("OptOuts");
 * ```
 *
 * **Example:** Named Opt-Out List with Tags
 * ```typescript
 * const optOuts = yield* PinpointSMSVoiceV2.OptOutList("OptOuts", {
 *   optOutListName: "marketing-opt-outs",
 *   tags: { team: "growth" },
 * });
 * ```
 *
 * @resource
 */
export const OptOutList = Resource<OptOutList>("AWS.PinpointSMSVoiceV2.OptOutList")

/**
 * Raised when an opt-out list cannot be observed immediately after it
 * was created — the create call succeeded (or raced a peer) but the
 * follow-up describe found nothing.
 */
export class SmsVoiceOptOutListMissing extends $MutableErrorBase("SmsVoiceOptOutListMissing")<{

   message: string;
}> {static {
    $MutableErrorMatcher(this, "SmsVoiceOptOutListMissing", true);
}


}

export const OptOutListProvider = (): infer _ =>
  Provider.effect(
    OptOutList,
    effect {
      const toName = effect (
        id: string,
        props: OptOutListProps,
      ) => (props.optOutListName ? props.optOutListName : try createPhysicalName({ id, maxLength: 64 }))

      /**
       * Observe an opt-out list by name. `DescribeOptOutLists` raises a
       * typed `ResourceNotFoundException` for an unknown name.
       */
      const getByName = effect (name: string) => {
        const result = (effect { return (try (smsvoice.describeOptOutLists({ OptOutListNames: [name] })
          |> retrySmsVoiceThrottled(%))) }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: undefined;
            default: throw e;
          }
        return result?.OptOutLists?.find((l) => l.OptOutListName === name)
      }

      return {
        stables: ["optOutListName", "optOutListArn"],

        read: effect ({ id, olds, output }) => {
          const name = output?.optOutListName ?? (try toName(id, olds ?? {}))
          const observed = try getByName(name)
          if (observed === undefined) return undefined
          const attrs = {
            optOutListName: observed.OptOutListName,
            optOutListArn: observed.OptOutListArn,
          }
          const tags = try readSmsVoiceTags(observed.OptOutListArn)
          return (try hasAlchemyTags(id, tags)) ? attrs : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
        },

        diff: effect ({ id, news, olds }) => {
          const resolved = try Effect.orDie(Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }))
          if (resolved === undefined) return undefined
          const oldName = try toName(id, olds ?? {})
          const newName = try toName(id, resolved)
          if (oldName !== newName) return { action: "replace" } as const
        },

        reconcile: effect ({ id, news, output, session }) => {
          const name = output?.optOutListName ?? (try toName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. Observe — cloud state is authoritative.
          let observed = try getByName(name)

          // 2. Ensure — create if missing; a ConflictException is a race
          // with a peer reconciler, so fall through to re-observe.
          if (observed === undefined) {
            try (effect {
              return (effect { return (try (smsvoice
                .createOptOutList({
                  OptOutListName: name,
                  Tags: toTagList(desiredTags),
                })
                |> retrySmsVoiceThrottled(%))) }) catch effect (e) => match (e) {
                  when { _tag: "ConflictException" }: (undefined as void);
                  default: throw e;
                }
            }
              |> Effect.asVoid(%))
            observed = try getByName(name)
          }
          if (observed === undefined) {
            throw new SmsVoiceOptOutListMissing({
              message: `opt-out list '${name}' not observable after create`,
            })
          }

          // 3. Sync tags — diff against OBSERVED cloud tags.
          try syncSmsVoiceTags(observed.OptOutListArn, desiredTags)

          try session.note(observed.OptOutListArn)
          return {
            optOutListName: observed.OptOutListName,
            optOutListArn: observed.OptOutListArn,
          }
        },

        delete: effect ({ output }) => {
          try (effect {
            return (effect { return (try (smsvoice.deleteOptOutList({ OptOutListName: output.optOutListName })
              |> retrySmsVoiceThrottled(%))) }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: (undefined as void);
                default: throw e;
              }
          }
            |> Effect.asVoid(%))
        },

        list: effect () =>
          Array.from(
            try (smsvoice.describeOptOutLists.items({})
              |> Stream.runCollect(%)),
          )
            // The `Default` opt-out list is service-managed: End User
            // Messaging recreates it automatically and then rejects
            // DeleteOptOutList with ConflictException
            // RESOURCE_MODIFICATION_NOT_ALLOWED (verified live) — keep
            // it out of enumeration for account-wide teardown (nuke).
            .filter((l) => l.OptOutListName !== "Default")
            .map((l) => ({
              optOutListName: l.OptOutListName,
              optOutListArn: l.OptOutListArn,
            })),
      }
    },
  )
