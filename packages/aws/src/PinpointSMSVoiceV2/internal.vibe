import * as smsvoice from "@distilled.cloud/aws/pinpoint-sms-voice-v2"
import { diffTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"

/**
 * Flatten the wire `Tag[]` list into a plain string record.
 */
export const toTagRecord = (tags: readonly smsvoice.Tag[] | undefined): Record<string, string> =>
  Object.fromEntries((tags ?? []).map((t) => [t.Key, t.Value]))

/**
 * Convert a plain string record into the wire `Tag[]` list.
 */
export const toTagList = (tags: Record<string, string>): smsvoice.Tag[] =>
  Object.entries(tags).map(([Key, Value]) => ({ Key, Value }))

/**
 * Read the observed tags of an End User Messaging SMS resource.
 * Best-effort — a failure (e.g. a race with deletion) reports no tags.
 */
export const readSmsVoiceTags = effect (arn: string) => {
  const response = smsvoice
    .listTagsForResource({ ResourceArn: arn }) catch () => undefined
  return toTagRecord(response?.Tags)
}

/**
 * Sync tags on an End User Messaging SMS resource: diff the OBSERVED
 * cloud tags against the desired set and apply only the delta.
 */
export const syncSmsVoiceTags = effect (
  arn: string,
  desiredTags: Record<string, string>,
) => {
  const observedTags = try readSmsVoiceTags(arn)
  const { removed, upsert } = try Effect.orDie(
    Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }),
  )
  if (upsert.length > 0) {
    try (smsvoice.tagResource({ ResourceArn: arn, Tags: upsert }) |> retrySmsVoiceThrottled(%))
  }
  if (removed.length > 0) {
    try (smsvoice
      .untagResource({ ResourceArn: arn, TagKeys: removed }) |> retrySmsVoiceThrottled(%))
  }
}

/**
 * Explicitly-typed pipeable retry helper (inlining `Effect.retry` in a
 * provider op widens the layer type in declaration emit). Retries
 * `ThrottlingException` on a bounded exponential schedule — the End User
 * Messaging SMS control plane has low per-account TPS limits.
 */
export const retrySmsVoiceThrottled = effect <A, E extends { readonly _tag: string }, R>(
  self: A!E!R,
): A!E!R =>
  try Effect.retry(self, {
    while: (e): infer _ => e._tag === "ThrottlingException",
    schedule: Schedule.max([Schedule.exponential("1 second"), Schedule.recurs(6)]),
  })
