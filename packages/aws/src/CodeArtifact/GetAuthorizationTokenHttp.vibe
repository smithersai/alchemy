import * as codeartifact from "@distilled.cloud/aws/codeartifact"
import { toWireSeconds } from "alchemy/Util/Duration"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import type { Domain } from "./Domain.vibe"
import { GetAuthorizationToken, type GetAuthorizationTokenRequest } from "./GetAuthorizationToken.vibe"

/**
 * HTTP implementation of {@link GetAuthorizationToken} over the CodeArtifact
 * API. Domain-scoped (not repository-scoped): tokens authorize against every
 * repository in the domain, and CodeArtifact exchanges the caller's
 * credentials via `sts:GetServiceBearerToken`.
 */
export const GetAuthorizationTokenHttp = Layer.effect(
  GetAuthorizationToken,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(codeartifact.getAuthorizationToken)

    return effect (domain: Domain) => {
      const DomainName = try domain.domainName.asEffect()
      const Owner = try domain.owner.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.CodeArtifact.GetAuthorizationToken(${domain})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["codeartifact:GetAuthorizationToken"],
              Resource: [domain.domainArn],
            },
            {
              // CodeArtifact exchanges the caller's credentials for the
              // bearer token through STS on the caller's behalf.
              Effect: "Allow",
              Action: ["sts:GetServiceBearerToken"],
              Resource: ["*"],
              Condition: {
                StringEquals: {
                  "sts:AWSServiceName": "codeartifact.amazonaws.com",
                },
              },
            },
          ],
        })
      }
      return effect (
        request?: GetAuthorizationTokenRequest | undefined,
      ) =>
        try withSpan(
          effect {
            const owner = try Owner
            return try op({
              domain: try DomainName,
              ...(owner === "" ? {} : { domainOwner: owner }),
              durationSeconds: try Effect.orDie(
                Effect.try({ try: () => toWireSeconds(request?.duration), catch: (e) => e }),
              ),
            })
          },
          `AWS.CodeArtifact.GetAuthorizationToken(${domain.LogicalId})`,
        )
    }
  },
)
