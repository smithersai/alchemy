import * as Kinesis from "@distilled.cloud/aws/kinesis"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { ListTagsForResource, type ListTagsForResourceRequest, type TaggableResource } from "./ListTagsForResource.vibe"

export const ListTagsForResourceHttp = Layer.effect(
  ListTagsForResource,
  effect {
    const bind = try AWSBindings.Bind
    const listTagsForResource = try AWSBindings.withCredentials(Kinesis.listTagsForResource)

    return effect (resource: TaggableResource) => {
      const ResourceARN = try getResourceArn(resource).asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.Kinesis.ListTagsForResource(${resource})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["kinesis:ListTagsForResource"],
              Resource: [getResourceArn(resource)],
            },
          ],
        })
      }
      return effect (
        request?: ListTagsForResourceRequest,
      ) =>
        try withSpan(
          effect {
            return try listTagsForResource({
              ...request,
              ResourceARN: try ResourceARN,
            })
          },
          `AWS.Kinesis.ListTagsForResource(${resource.LogicalId})`,
        )
    }
  },
)

const getResourceArn = (resource: TaggableResource) =>
  "consumerArn" in resource ? resource.consumerArn : resource.streamArn
