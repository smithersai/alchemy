import * as Effect from "effect/Effect"
import * as sesv2 from "@distilled.cloud/aws/sesv2"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, createTagsList, diffTags, hasAlchemyTags } from "alchemy/Tags"
import { AWSEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"

export interface EmailTemplateProps {
  /**
   * The name of the template. If omitted, a deterministic physical name is
   * generated from the app, stage, and logical ID. Changing the name
   * replaces the template.
   */
  templateName?: string
  /**
   * The subject line, with optional `{{variable}}` personalization tags.
   */
  subject?: string
  /**
   * The plain-text body, with optional `{{variable}}` personalization tags.
   */
  text?: string
  /**
   * The HTML body, with optional `{{variable}}` personalization tags.
   */
  html?: string
  /**
   * Tags to apply to the template. Merged with internal Alchemy tags.
   */
  tags?: Record<string, string>
}

export interface EmailTemplate extends
  Resource<
    "AWS.SES.EmailTemplate",
    EmailTemplateProps,
    {
      templateName: string
      templateArn: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon SES v2 email template — reusable subject/text/HTML content with
 * `{{variable}}` personalization tags, rendered server-side when you send
 * templated email.
 * ### Creating Templates
 * **Example:** Welcome Email Template
 * ```typescript
 * import * as SES from "@alchemy.run/aws/SES";
 *
 * const template = yield* SES.EmailTemplate("Welcome", {
 *   subject: "Welcome, {{name}}!",
 *   text: "Hi {{name}}, thanks for signing up.",
 *   html: "<h1>Hi {{name}}</h1><p>Thanks for signing up.</p>",
 * });
 * ```
 *
 * ### Sending Templated Email
 * **Example:** Send with Template Data
 * ```typescript
 * const sendEmail = yield* SES.SendEmail(identity);
 *
 * const result = yield* sendEmail({
 *   Destination: { ToAddresses: ["customer@example.com"] },
 *   Content: {
 *     Template: {
 *       TemplateName: "my-welcome-template",
 *       TemplateData: JSON.stringify({ name: "Ada" }),
 *     },
 *   },
 * });
 * ```
 *
 * @resource
 */
export const EmailTemplate = Resource<EmailTemplate>("AWS.SES.EmailTemplate")

const toTagRecord = (
  tags: ReadonlyArray<{ Key: string; Value: string }> | undefined,
): Record<string, string> => Object.fromEntries((tags ?? []).map((tag) => [tag.Key, tag.Value]))

const templateArnOf = (region: string, accountId: string, name: string): infer _ =>
  `arn:aws:ses:${region}:${accountId}:template/${name}`

const toContent = (props: EmailTemplateProps): sesv2.EmailTemplateContent => ({
  Subject: props.subject,
  Text: props.text,
  Html: props.html,
})

export const EmailTemplateProvider = (): infer _ =>
  Provider.effect(
    EmailTemplate,
    effect {
      const createName = effect (
        id: string,
        props: Pick<EmailTemplateProps, "templateName">,
      ) => props.templateName ?? (try createPhysicalName({ id, maxLength: 64 }))

      const getTemplate = effect (name: string) =>
        sesv2
          .getEmailTemplate({ TemplateName: name }) catch effect (e) => match (e) {
            when { _tag: "NotFoundException" }: undefined;
            default: throw e;
          }

      return EmailTemplate.Provider.of({
        stables: ["templateName", "templateArn"],

        list: effect () => {
          const { accountId, region } = try AWSEnvironment.current
          const pages = try sesv2.listEmailTemplates.pages({}).pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.TemplatesMetadata ?? [])
            .filter(
              (meta): meta is typeof meta & { TemplateName: string } => meta.TemplateName != null,
            )
            .map((meta) => ({
              templateName: meta.TemplateName,
              templateArn: templateArnOf(region, accountId, meta.TemplateName),
            }))
        },

        read: effect ({ id, olds, output }) => {
          const { accountId, region } = try AWSEnvironment.current
          const name = output?.templateName ?? (try createName(id, olds ?? {}))
          const found = try getTemplate(name)
          if (!found) return undefined
          const attrs = {
            templateName: name,
            templateArn: templateArnOf(region, accountId, name),
          }
          const tags = toTagRecord(found.Tags)
          return (try hasAlchemyTags(id, tags))
            ? attrs
            : (try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (error) => error })))
        },

        diff: effect ({ id, news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          const oldName = try createName(id, olds ?? {})
          const newName = try createName(id, news ?? {})
          if (oldName !== newName) {
            return { action: "replace" } as const
          }
        },

        reconcile: effect ({ id, news, output, session }) => {
          const { accountId, region } = try AWSEnvironment.current
          const name = output?.templateName ?? (try createName(id, news))
          const templateArn = templateArnOf(region, accountId, name)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }
          const desiredContent = toContent(news)

          // 1. OBSERVE
          let observed = try getTemplate(name)

          if (observed === undefined) {
            // 2. ENSURE — AlreadyExists is a race → converge via update.
            sesv2
              .createEmailTemplate({
                TemplateName: name,
                TemplateContent: desiredContent,
                Tags: createTagsList(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "AlreadyExistsException" }: try sesv2.updateEmailTemplate({
                  TemplateName: name,
                  TemplateContent: desiredContent,
                });
                default: throw e;
              }
            observed = try sesv2.getEmailTemplate({ TemplateName: name })
          } else if (
            observed.TemplateContent.Subject !== desiredContent.Subject
            || observed.TemplateContent.Text !== desiredContent.Text
            || observed.TemplateContent.Html !== desiredContent.Html
          ) {
            // 3. SYNC content — only when the observed content drifted.
            try sesv2.updateEmailTemplate({
              TemplateName: name,
              TemplateContent: desiredContent,
            })
          }

          // 3b. SYNC TAGS — diff against OBSERVED cloud tags.
          const observedTags = toTagRecord(observed.Tags)
          const { upsert, removed } = diffTags(observedTags, desiredTags)
          if (upsert.length > 0) {
            try sesv2.tagResource({
              ResourceArn: templateArn,
              Tags: upsert,
            })
          }
          if (removed.length > 0) {
            try sesv2.untagResource({
              ResourceArn: templateArn,
              TagKeys: removed,
            })
          }

          try session.note(templateArn)
          return { templateName: name, templateArn }
        },

        delete: effect ({ output }) => {
          sesv2
            .deleteEmailTemplate({ TemplateName: output.templateName }) catch effect (e) => match (e) {
              when { _tag: "NotFoundException" }: undefined as void;
              default: throw e;
            }
        },
      })
    },
  )
