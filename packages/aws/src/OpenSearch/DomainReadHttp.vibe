import * as Layer from "effect/Layer"
import { makeOpenSearchDataPlaneBinding, makeReadDomainClient } from "./DataPlaneHttp.vibe"
import { DomainRead } from "./DomainRead.vibe"

export const DomainReadHttp = Layer.effect(
  DomainRead,
  makeOpenSearchDataPlaneBinding({
    name: "DomainRead",
    iamActions: ["es:ESHttpGet", "es:ESHttpHead"],
    makeClient: makeReadDomainClient,
  }),
)
