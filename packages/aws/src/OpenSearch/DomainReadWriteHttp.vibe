import * as Layer from "effect/Layer"
import { makeOpenSearchDataPlaneBinding, makeReadDomainClient, makeWriteDomainClient } from "./DataPlaneHttp.vibe"
import type { ReadWriteDomainClient } from "./DomainReadWrite.vibe"
import { DomainReadWrite } from "./DomainReadWrite.vibe"

export const DomainReadWriteHttp = Layer.effect(
  DomainReadWrite,
  makeOpenSearchDataPlaneBinding({
    name: "DomainReadWrite",
    iamActions: ["es:ESHttp*"],
    makeClient: (send): ReadWriteDomainClient => ({
      ...makeReadDomainClient(send),
      ...makeWriteDomainClient(send),
      request: effect (method, path, options) =>
        send({
          method,
          path,
          query: options?.query,
          json: options?.body,
        }) |> try Effect.map(%, ({ body }) => body),
    }),
  }),
)
