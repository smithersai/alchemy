import * as sdb from "@distilled.cloud/aws/simpledb"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { RegisterSimpleDbBinding } from "./Binding.vibe"
import type { Domain } from "./Domain.ts"
import { Select, type SelectRequest } from "./Select.vibe"

export const SelectHttp = Layer.effect(
  Select,
  effect {
    const registerSimpleDbBinding = try RegisterSimpleDbBinding
    const select = try AWSBindings.withCredentials(sdb.select)

    return effect (domain: Domain) => {
      const domainName = try domain.domainName.asEffect()
      try registerSimpleDbBinding("Select", domain)
      return effect (
        request: SelectRequest,
      ) =>
        try withSpan(
          effect {
            const { SelectExpression, ...rest } = request
            const name = try domainName
            return try select({
              ...rest,
              SelectExpression: typeof SelectExpression === "function" ? SelectExpression(name) : SelectExpression,
            })
          },
          `AWS.SimpleDB.Select(${domain.LogicalId})`,
        )
    }
  },
)
