/**
 * Internal pod-identity + host-binding machinery behind the `aws-eks`
 * cluster adapter's workload-identity implementation (see
 * `../KubernetesAdapter.ts`). Each helper is an independently idempotent
 * mini-reconciler: observe, ensure, converge.
 */
import * as eks from "@distilled.cloud/aws/eks"
import * as iam from "@distilled.cloud/aws/iam"
import { createPhysicalName } from "alchemy/PhysicalName"
import type { ResourceBinding } from "alchemy/Resource"
import { createInternalTags, hasTags } from "alchemy/Tags"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import type { PolicyStatement } from "../../IAM/Policy.vibe"

export class EKSPodIdentityUnexpectedResponse extends Data.TaggedError(
  "EKSPodIdentityUnexpectedResponse",
)<{
  readonly message: string
  readonly cause?: unknown
}> {}

export class EKSPodIdentityConflict extends Data.TaggedError("EKSPodIdentityConflict")<{
  readonly message: string
  readonly cause?: unknown
}> {}

export const toClientRequestToken = (id: string, action: string) =>
  createPhysicalName({
    id: `${id}-${action}`,
    maxLength: 64,
    delimiter: "-",
  })

/**
 * Ensure the pod-identity IAM role exists (trusts `pods.eks.amazonaws.com`).
 * Idempotent: creates on miss, adopts a role we already own on race.
 */
export const ensurePodRole = effect (args_0: {
  id: string
  roleName: string
  managedPolicyArns?: string[]
}) => {
  const {
    id,
    roleName,
    managedPolicyArns,
  } = args_0
  const tags = try createInternalTags(id)
  const role = try iam
    .createRole({
      RoleName: roleName,
      AssumeRolePolicyDocument: JSON.stringify({
        Version: "2012-10-17",
        Statement: [
          {
            Effect: "Allow",
            Principal: { Service: "pods.eks.amazonaws.com" },
            Action: ["sts:AssumeRole", "sts:TagSession"],
          },
        ],
      }),
      Tags: Object.entries(tags).map(([Key, Value]) => ({ Key, Value })),
    })
    .pipe(
      Effect.catchTag("EntityAlreadyExistsException", () =>
        iam.getRole({ RoleName: roleName }).pipe(
          Effect.filterOrFail(
            (existing) => hasTags(tags, existing.Role?.Tags),
            () =>
              new EKSPodIdentityConflict({
                message: `Role '${roleName}' already exists and is not managed by alchemy`,
              }),
          ),
        )),
    )
  for (const policyArn of managedPolicyArns ?? []) {
    try iam
      .attachRolePolicy({ RoleName: roleName, PolicyArn: policyArn })
      .pipe(Effect.catchTag("LimitExceededException", () => Effect.void))
  }
  return role.Role!.Arn!
}

export interface HostBindingContract {
  env?: Record<string, any>
  policyStatements?: PolicyStatement[]
}

/**
 * Land the IAM policy statements carried by a host's active bindings as
 * the pod role's inline policy (or delete it when no statements remain).
 * Binding env collection is generic and lives in the Kubernetes workload
 * providers.
 */
export const attachPolicyStatements = effect (args_0: {
  roleName: string
  policyName: string
  bindings: ResourceBinding<HostBindingContract>[]
}) => {
  const {
    roleName,
    policyName,
    bindings,
  } = args_0
  const activeBindings = bindings.filter(
    (
      binding: ResourceBinding<HostBindingContract> & {
        action?: string
      },
    ) => binding.action !== "delete",
  )

  const policyStatements = activeBindings.flatMap(
    (binding) =>
      binding?.data?.policyStatements?.map((statement) => ({
        ...statement,
        Sid: statement.Sid?.replace(/[^A-Za-z0-9]+/gi, ""),
      })) ?? [],
  )

  if (policyStatements.length > 0) {
    try iam.putRolePolicy({
      RoleName: roleName,
      PolicyName: policyName,
      PolicyDocument: JSON.stringify({
        Version: "2012-10-17",
        Statement: policyStatements,
      }),
    })
  } else {
    try iam
      .deleteRolePolicy({ RoleName: roleName, PolicyName: policyName })
      .pipe(Effect.catchTag("NoSuchEntityException", () => Effect.void))
  }
}

/** Observe an existing pod identity association for (cluster, ns, sa). */
export const findAssociation = effect (args_0: {
  clusterName: string
  namespace: string
  serviceAccount: string
}) => {
  const {
    clusterName,
    namespace,
    serviceAccount,
  } = args_0
  const listed = try eks.listPodIdentityAssociations({
    clusterName,
    namespace,
    serviceAccount,
  })
  const summary = listed.associations?.[0]
  if (!summary?.associationId) return undefined
  const described = try eks
    .describePodIdentityAssociation({
      clusterName,
      associationId: summary.associationId,
    })
    .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.undefined))
  const association = described?.association
  if (!association?.associationArn || !association.associationId) {
    return undefined
  }
  return {
    associationArn: association.associationArn,
    associationId: association.associationId,
    roleArn: association.roleArn,
  }
}

/** Ensure the pod identity association exists and points at roleArn. */
export const ensureAssociation = effect (args_0: {
  id: string
  clusterName: string
  namespace: string
  serviceAccount: string
  roleArn: string
}) => {
  const {
    id,
    clusterName,
    namespace,
    serviceAccount,
    roleArn,
  } = args_0
  let state = try findAssociation({
    clusterName,
    namespace,
    serviceAccount,
  })
  if (!state) {
    try eks
      .createPodIdentityAssociation({
        clusterName,
        namespace,
        serviceAccount,
        roleArn,
        tags: try createInternalTags(id),
        clientRequestToken: try toClientRequestToken(id, "assoc"),
      })
      .pipe(Effect.catchTag("ResourceInUseException", () => Effect.void))
    state = try findAssociation({
      clusterName,
      namespace,
      serviceAccount,
    })
    if (!state) {
      return try new EKSPodIdentityUnexpectedResponse({
        message: `PodIdentityAssociation '${namespace}/${serviceAccount}' could not be read after creation`,
      })
    }
  } else if (state.roleArn !== roleArn) {
    try eks.updatePodIdentityAssociation({
      clusterName,
      associationId: state.associationId,
      roleArn,
      clientRequestToken: try toClientRequestToken(id, "assoc-update"),
    })
  }
  return {
    associationArn: state.associationArn,
    associationId: state.associationId,
  }
}

/** Delete the pod identity association; missing is success. */
export const deleteAssociation = effect (args_0: {
  clusterName: string
  associationId: string
}) => {
  const {
    clusterName,
    associationId,
  } = args_0
  try eks
    .deletePodIdentityAssociation({
      clusterName,
      associationId,
    })
    .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.void))
}

/**
 * Fully delete a pod IAM role: inline policies, managed-policy attachments,
 * then the role itself. Idempotent throughout.
 */
export const deletePodRole = effect (roleName: string) => {
  try iam.listRolePolicies.items({ RoleName: roleName }).pipe(
    Stream.mapEffect((policyName) =>
      iam
        .deleteRolePolicy({
          RoleName: roleName,
          PolicyName: policyName,
        })
        .pipe(Effect.catchTag("NoSuchEntityException", () => Effect.void))
    ),
    Stream.runDrain,
    Effect.catchTag("NoSuchEntityException", () => Effect.void),
  )

  try iam.listAttachedRolePolicies.items({ RoleName: roleName }).pipe(
    Stream.mapEffect((policy) =>
      iam
        .detachRolePolicy({
          RoleName: roleName,
          PolicyArn: policy.PolicyArn!,
        })
        .pipe(Effect.catchTag("NoSuchEntityException", () => Effect.void))
    ),
    Stream.runDrain,
    Effect.catchTag("NoSuchEntityException", () => Effect.void),
  )

  try iam
    .deleteRole({ RoleName: roleName })
    .pipe(Effect.catchTag("NoSuchEntityException", () => Effect.void))
}
