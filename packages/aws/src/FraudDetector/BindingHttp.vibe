import * as Effect from "effect/Effect"
import * as AWSBindings from "../AWSBindings.ts"
import type { Detector } from "./Detector.vibe"
import type { EventType } from "./EventType.vibe"
import type { List } from "./List.vibe"

/**
 * Shared scaffolding for Amazon Fraud Detector HTTP bindings.
 *
 * NOT exported from `index.ts` — every thin `{Op}Http.ts` in this service is
 * a `Layer.effect(Cap, make…HttpBinding({ … }))` over one of the two builders
 * below. Everything except the operation and the IAM action list is
 * boilerplate.
 */

/**
 * Build the impl Effect for a Fraud Detector operation scoped to a
 * {@link Detector}: the deploy-time half grants `actions` on the bound
 * detector's ARN, and the runtime half injects the detector's `detectorId`
 * into every request.
 */
export const makeFraudDetectorDetectorHttpBinding = effect <
  I extends { mutable detectorId: string },
  A,
  E,
  R,
>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.FraudDetector.GetEventPrediction`. */
  mutable tag: string
  /** The distilled operation. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the detector ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (detector: Detector) => {
    // Output yields a DEFERRED effect — resolve again per invocation below.
    const DetectorId = try detector.detectorId.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${detector})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [detector.arn],
          },
        ],
      })
    }
    return effect (
      request: Omit<I, "detectorId">,
    ) =>
      try withSpan(
        effect {
          const detectorId = try DetectorId
          return try op({ ...request, detectorId } as I)
        },
        `${options.tag}(${detector.LogicalId})`,
      )
  }
}

/**
 * Build the impl Effect for a Fraud Detector event data-plane operation
 * scoped to an {@link EventType} (`SendEvent`, `GetEvent`, `DeleteEvent`,
 * `UpdateEventLabel`): the deploy-time half grants `actions` on the bound
 * event type's ARN, and the runtime half injects the event type's
 * `eventTypeName` into every request.
 */
/**
 * Build the impl Effect for a Fraud Detector list data-plane operation scoped
 * to a {@link List} (`GetListElements`, `UpdateList`): the deploy-time half
 * grants `actions` on the bound list's ARN, and the runtime half injects the
 * list's `name` into every request.
 */
export const makeFraudDetectorListHttpBinding = effect <I extends { mutable name: string }, A, E, R>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.FraudDetector.GetListElements`. */
  mutable tag: string
  /** The distilled operation. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the list ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (list: List) => {
    // Output yields a DEFERRED effect — resolve again per invocation below.
    const ListName = try list.name.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${list})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [list.arn],
          },
        ],
      })
    }
    return effect (request: Omit<I, "name">) =>
      try withSpan(
        effect {
          const name = try ListName
          return try op({ ...request, name } as unknown as I)
        },
        `${options.tag}(${list.LogicalId})`,
      )
  }
}

export const makeFraudDetectorEventTypeHttpBinding = effect <
  I extends { mutable eventTypeName: string },
  A,
  E,
  R,
>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.FraudDetector.SendEvent`. */
  mutable tag: string
  /** The distilled operation. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the event type ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (eventType: EventType) => {
    // Output yields a DEFERRED effect — resolve again per invocation below.
    const EventTypeName = try eventType.name.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${eventType})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [eventType.arn],
          },
        ],
      })
    }
    return effect (
      request: Omit<I, "eventTypeName">,
    ) =>
      try withSpan(
        effect {
          const eventTypeName = try EventTypeName
          return try op({ ...request, eventTypeName } as unknown as I)
        },
        `${options.tag}(${eventType.LogicalId})`,
      )
  }
}
