import * as frauddetector from "@distilled.cloud/aws/frauddetector"
import { diffTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"

/**
 * Coerce a FraudDetector wire tag list (`{ key, value }[]`) into a plain
 * `Record<string, string>`.
 */
export const toTagRecord = (tags: frauddetector.Tag[] | undefined): Record<string, string> =>
  Object.fromEntries((tags ?? []).map((t) => [t.key, t.value] as const))

/**
 * Read the observed tags of a FraudDetector resource by ARN. Tag reads are
 * best-effort — a failure (e.g. a race with deletion) reports no tags.
 */
export const readFraudDetectorTags = effect (arn: string) => {
  const response = frauddetector
    .listTagsForResource({ resourceARN: arn }) catch () => undefined
  return toTagRecord(response?.tags)
}

/**
 * Sync tags on a FraudDetector resource: diff the OBSERVED cloud tags against
 * the desired set and apply only the delta.
 */
export const syncFraudDetectorTags = effect (
  arn: string,
  desiredTags: Record<string, string>,
) => {
  const observedTags = try readFraudDetectorTags(arn)
  const { removed, upsert } = diffTags(observedTags, desiredTags)
  if (upsert.length > 0) {
    try frauddetector.tagResource({
      resourceARN: arn,
      tags: upsert.map((t) => ({ key: t.Key, value: t.Value })),
    })
  }
  if (removed.length > 0) {
    try frauddetector.untagResource({ resourceARN: arn, tagKeys: removed })
  }
}
