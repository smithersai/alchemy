import * as frauddetector from "@distilled.cloud/aws/frauddetector"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { readFraudDetectorTags, syncFraudDetectorTags } from "./internal.vibe"

export interface EventTypeProps {
  /**
   * Name of the event type. If omitted, a unique lowercase name is generated
   * from the app, stage, and logical ID. Changing the name replaces the event
   * type.
   */
  name?: string
  /**
   * Human-readable description. This is an in-place update.
   */
  description?: string
  /**
   * Names of the variables that belong to this event type. Must reference
   * existing Fraud Detector variables. This is an in-place update.
   */
  eventVariables: string[]
  /**
   * Names of the labels used to classify events (e.g. `fraud`, `legit`). This
   * is an in-place update.
   */
  labels?: string[]
  /**
   * Names of the entity types associated with this event type. Must reference
   * existing Fraud Detector entity types. This is an in-place update.
   */
  entityTypes: string[]
  /**
   * Whether to enable stored-event ingestion (`ENABLED` or `DISABLED`). This is
   * an in-place update.
   */
  eventIngestion?: string
  /**
   * Whether to forward events to EventBridge. This is an in-place update.
   */
  eventBridgeEnabled?: boolean
  /**
   * User-defined tags for the event type.
   */
  tags?: Record<string, string>
}

export interface EventType extends
  Resource<
    "AWS.FraudDetector.EventType",
    EventTypeProps,
    {
      /** The name of the event type. */
      name: string
      /** The ARN of the event type. */
      arn: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Fraud Detector event type — the schema of an event (its variables,
 * labels, and entity types) that detectors evaluate. Event types are cheap
 * metadata objects.
 *
 * ### Creating an Event Type
 * **Example:** Basic Event Type
 * ```typescript
 * const purchase = yield* FraudDetector.EventType("purchase", {
 *   eventVariables: ["email", "ip"],
 *   entityTypes: ["customer"],
 *   labels: ["fraud", "legit"],
 * });
 * ```
 *
 * @resource
 */
export const EventType = Resource<EventType>("AWS.FraudDetector.EventType")

export const EventTypeProvider = (): infer _ =>
  Provider.effect(
    EventType,
    effect {
      const createName = effect (id: string, props: Partial<EventTypeProps>) =>
        props.name ?? (try createPhysicalName({ id, maxLength: 64, lowercase: true }))

      const get = effect (name: string) => {
        const response = frauddetector
          .getEventTypes({ name }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: undefined;
            default: throw e;
          }
        return response?.eventTypes?.[0]
      }

      const toAttrs = (eventType: frauddetector.EventType): infer _ => ({
        name: eventType.name!,
        arn: eventType.arn!,
      })

      return {
        stables: ["name", "arn"],

        diff: effect ({ id, olds = {}, news }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return undefined
          const oldName = try createName(id, olds)
          const newName = try createName(id, resolved)
          if (oldName !== newName) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ id, olds, output }) => {
          const name = output?.name ?? (try createName(id, olds ?? {}))
          const eventType = try get(name)
          if (eventType === undefined) return undefined
          const attrs = toAttrs(eventType)
          const tags = try readFraudDetectorTags(eventType.arn!)
          return (try hasAlchemyTags(id, tags))
            ? attrs
            : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
        },

        reconcile: effect ({ id, news, session }) => {
          const name = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // putEventType is an idempotent upsert — call it to converge the
          // core configuration whether creating or updating.
          try frauddetector.putEventType({
            name,
            description: news.description,
            eventVariables: news.eventVariables,
            labels: news.labels,
            entityTypes: news.entityTypes,
            eventIngestion: news.eventIngestion,
            eventOrchestration: news.eventBridgeEnabled !== undefined
              ? { eventBridgeEnabled: news.eventBridgeEnabled }
              : undefined,
          })

          const eventType = try get(name)
          // Sync tags — diff against OBSERVED cloud tags.
          try syncFraudDetectorTags(eventType!.arn!, desiredTags)

          try session.note(name)
          return toAttrs(eventType!)
        },

        delete: effect ({ output }) => {
          frauddetector
            .deleteEventType({ name: output.name }) catch effect (e) => match (e) {
              when { _tag: "ValidationException" }: undefined as void;
              default: throw e;
            }
        },

        list: effect () =>
          Array.from(
            try (frauddetector.getEventTypes.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) => (page.eventTypes ?? []).map(toAttrs)),
      }
    },
  )
