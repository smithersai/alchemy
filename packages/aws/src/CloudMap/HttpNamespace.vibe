import * as Effect from "effect/Effect"
import * as sd from "@distilled.cloud/aws/servicediscovery"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import {
  awaitOperation,
  ensureNamespace,
  fetchObservedTags,
  observeNamespace,
  retryWhileResourceInUse,
  syncTags,
} from "./internal.vibe"

export interface HttpNamespaceProps {
  /**
   * Name of the namespace. Changing the name replaces the namespace.
   * @default a generated DNS-compatible physical name
   */
  name?: string
  /**
   * A description for the namespace.
   */
  description?: string
  /**
   * Tags to apply to the namespace. Merged with internal Alchemy tags.
   */
  tags?: Record<string, string>
}

export interface HttpNamespace extends
  Resource<
    "AWS.CloudMap.HttpNamespace",
    HttpNamespaceProps,
    {
      /**
       * The unique identifier of the namespace.
       */
      namespaceId: string
      /**
       * The ARN of the namespace.
       */
      namespaceArn: string
      /**
       * Name of the namespace.
       */
      namespaceName: string
      /**
       * The name clients use to discover instances via the HTTP discovery API.
       */
      httpName: string | undefined
    },
    {},
    Providers
  >
{}

/**
 * An AWS Cloud Map HTTP namespace — an API-only service registry. Instances
 * registered in an HTTP namespace are discoverable via the
 * `DiscoverInstances` API but not via DNS, so no VPC or hosted zone is
 * required.
 *
 * Namespace creation and deletion are asynchronous — the provider polls the
 * Cloud Map operations API (bounded) until they complete.
 * ### Creating Namespaces
 * **Example:** HTTP Namespace
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 *
 * const namespace = yield* AWS.CloudMap.HttpNamespace("AppNamespace", {
 *   description: "API-only service discovery",
 * });
 * ```
 *
 * ### Registering Services
 * **Example:** API-only Service
 * ```typescript
 * const service = yield* AWS.CloudMap.Service("Backend", {
 *   namespaceId: namespace.namespaceId,
 * });
 * ```
 *
 * @resource
 */
export const HttpNamespace = Resource<HttpNamespace>("AWS.CloudMap.HttpNamespace")

export const HttpNamespaceProvider = (): infer _ =>
  Provider.effect(
    HttpNamespace,
    effect {
      const createName = effect (id: string, props: { name?: string | undefined }) =>
        props.name ?? (try createPhysicalName({ id, maxLength: 253, lowercase: true }))

      const toAttributes = (namespace: sd.Namespace): infer _ => ({
        namespaceId: namespace.Id!,
        namespaceArn: namespace.Arn!,
        namespaceName: namespace.Name!,
        httpName: namespace.Properties?.HttpProperties?.HttpName,
      })

      return HttpNamespace.Provider.of({
        stables: ["namespaceId", "namespaceArn", "namespaceName", "httpName"],

        list: effect () => {
          const pages = try sd.listNamespaces
            .pages({
              Filters: [{ Name: "TYPE", Values: ["HTTP"], Condition: "EQ" }],
            })
            .pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.Namespaces ?? [])
            .filter((n) => n.Id !== undefined && n.Arn !== undefined && n.Name !== undefined)
            .map((n) => ({
              namespaceId: n.Id!,
              namespaceArn: n.Arn!,
              namespaceName: n.Name!,
              httpName: n.Properties?.HttpProperties?.HttpName,
            }))
        },

        read: effect ({ id, olds, output }) => {
          const name = output?.namespaceName ?? (try createName(id, olds ?? {}))
          const namespace = try observeNamespace("HTTP", name, output?.namespaceId)
          if (namespace?.Id === undefined) {
            return undefined
          }
          const attrs = toAttributes(namespace)
          const tags = try fetchObservedTags(attrs.namespaceArn)
          return (try hasAlchemyTags(id, tags))
            ? attrs
            : (try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (error) => error })))
        },

        diff: effect ({ id, news: _newsInput = {}, olds = {} }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (oldName !== newName) {
            return { action: "replace" } as const
          }
          // description/tags fall through to the default update path
        },

        reconcile: effect ({ id, news = {}, output, session }) => {
          const name = output?.namespaceName ?? (try createName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. OBSERVE
          let namespace = try observeNamespace("HTTP", name, output?.namespaceId)

          // 2. ENSURE — create if missing (async operation); the created
          // namespace is observed by the operation's target id, riding out
          // a same-name predecessor still deleting (see ensureNamespace)
          if (namespace === undefined) {
            try session.note(`creating HTTP namespace ${name} (async)...`)
            namespace = try ensureNamespace(
              "HTTP",
              name,
              sd.createHttpNamespace({
                Name: name,
                Description: news.description,
                Tags: Object.entries(desiredTags).map(([Key, Value]) => ({
                  Key,
                  Value,
                })),
              }),
            )
          }
          if (namespace?.Id === undefined) {
            throw try Effect.orDie(Effect.try({
              try: () =>
                sd.NamespaceNotFound.make({
                  message: `namespace ${name} not visible after create`,
                }),
              catch: (e) => e,
            }))
          }

          // 3. SYNC — description (updateHttpNamespace requires Description)
          if (news.description !== undefined && news.description !== namespace.Description) {
            const update = try sd.updateHttpNamespace({
              Id: namespace.Id,
              Namespace: { Description: news.description },
            })
            if (update.OperationId !== undefined) {
              try awaitOperation(update.OperationId)
            }
          }

          // 3b. SYNC TAGS — diff against OBSERVED cloud tags
          const observedTags = try fetchObservedTags(namespace.Arn!)
          try syncTags(namespace.Arn!, observedTags, desiredTags)

          try session.note(namespace.Id)
          return toAttributes(namespace)
        },

        delete: effect ({ output }) => {
          const deleted = retryWhileResourceInUse(
            sd.deleteNamespace({ Id: output.namespaceId }),
          ) catch effect (failure) => match (failure) {
            when { _tag: "NamespaceNotFound" }: { OperationId: undefined };
            when { _tag: "DuplicateRequest" }: { OperationId: failure.DuplicateOperationId };
            default: throw failure;
          }
          if (deleted.OperationId !== undefined) {
            try awaitOperation(deleted.OperationId)
          }
        },
      })
    },
  )
