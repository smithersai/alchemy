import * as bda from "@distilled.cloud/aws/bedrock-data-automation"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.ts"
import { readBdaTags, syncBdaTags, toBdaTagList, unredact } from "./internal.ts"

// Explicitly-typed pipeable repeat helper. Inlining `Effect.repeat` in a
// provider lifecycle op leaks its conditional return type into declaration
// emit and widens the provider layer for every consumer of `AWS.providers()`.
const repeatUntilLibraryGone = effect <E, R>(
  self: bda.DataAutomationLibrary | undefined!E!R,
): bda.DataAutomationLibrary | undefined!E!R =>
  try Effect.repeat(self, {
    schedule: Schedule.fixed("3 seconds"),
    until: (library) => library === undefined,
    times: 10,
  })

export interface DataAutomationLibraryProps {
  /**
   * Name of the library. Changing the name replaces the library (the API has
   * no rename operation).
   * @default ${app}-${stage}-${id}
   */
  mutable libraryName?: string
  /**
   * Human-readable description of the library. Mutable in place.
   */
  mutable libraryDescription?: string
  /**
   * Customer-managed KMS encryption for the library. Create-only — changing
   * the key replaces the library. When omitted, the service uses an
   * AWS-owned key.
   */
  mutable encryptionConfiguration?: bda.EncryptionConfiguration
  /**
   * Tags to apply to the library. Merged with internal Alchemy tags.
   */
  mutable tags?: Record<string, string>
}

export interface DataAutomationLibrary extends
  Resource<
    "AWS.BedrockDataAutomation.DataAutomationLibrary",
    DataAutomationLibraryProps,
    {
      /**
       * The ARN of the library.
       */
      mutable libraryArn: string
      /**
       * Name of the library.
       */
      mutable libraryName: string
      /**
       * Current status of the library (`ACTIVE` or `DELETING`).
       */
      mutable status: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Bedrock Data Automation Library — a store of reusable entities
 * (currently `VOCABULARY` entities: domain phrases with display forms) that
 * data automation projects reference via their
 * `dataAutomationLibraryConfiguration` to improve extraction accuracy.
 *
 * Entities are loaded into the library with ingestion jobs — see the
 * `InvokeDataAutomationLibraryIngestionJob` binding.
 *
 * ### Creating Libraries
 * **Example:** Library with a description
 * ```typescript
 * import * as BDA from "@alchemy.run/aws/BedrockDataAutomation";
 *
 * const library = yield* BDA.DataAutomationLibrary("Vocab", {
 *   libraryDescription: "domain vocabulary for invoice extraction",
 * });
 * ```
 *
 * **Example:** Reference the library from a project
 * ```typescript
 * const project = yield* BDA.DataAutomationProject("Docs", {
 *   standardOutputConfiguration: {},
 *   dataAutomationLibraryConfiguration: {
 *     libraries: [{ libraryArn: library.libraryArn }],
 *   },
 * });
 * ```
 *
 * @resource
 */
export const DataAutomationLibrary = Resource<DataAutomationLibrary>(
  "AWS.BedrockDataAutomation.DataAutomationLibrary",
)

/**
 * Raised when a Data Automation library cannot be observed immediately after
 * a successful create — a race with a concurrent delete.
 */
export error DataAutomationLibraryNotObservable { mutable libraryName: string; mutable message: string }

export const DataAutomationLibraryProvider = (): infer _ =>
  Provider.effect(
    DataAutomationLibrary,
    effect {
      const createName = effect (
        id: string,
        props: Pick<DataAutomationLibraryProps, "libraryName">,
      ) => props.libraryName ?? (try createPhysicalName({ id, maxLength: 128 }))

      const toAttributes = (library: bda.DataAutomationLibrary): infer _ => ({
        libraryArn: library.libraryArn,
        libraryName: unredact(library.libraryName),
        status: library.status as string,
      })

      const observeLibrary = effect (libraryArn: string) =>
        (try bda.getDataAutomationLibrary({ libraryArn })).library catch effect (e) => match (e) {
          when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
          default: throw e;
        }

      const findLibraryArn = effect (name: string) => {
        const summaries = try bda.listDataAutomationLibraries.items({}).pipe(Stream.runCollect)
        return Array.from(summaries).find(
          (s) => s.libraryName !== undefined && unredact(s.libraryName) === name,
        )?.libraryArn
      }

      return DataAutomationLibrary.Provider.of({
        stables: ["libraryArn", "libraryName"],

        list: effect () => {
          const summaries = try bda.listDataAutomationLibraries
            .items({})
            .pipe(Stream.runCollect)
          const attrs = try Effect.forEach(
            Array.from(summaries),
            effect (s) =>
              try effect {
                const library = try observeLibrary(s.libraryArn)
                return (library === undefined ? [] : [toAttributes(library)])
              },
            { concurrency: 5 },
          )
          return attrs.flat()
        },

        read: effect ({ id, olds, output }) => {
          const libraryArn = output?.libraryArn ?? (try findLibraryArn(try createName(id, olds ?? {})))
          if (libraryArn === undefined) return undefined
          const found = try observeLibrary(libraryArn)
          if (found === undefined) return undefined
          const attrs = toAttributes(found)
          const tags = try readBdaTags(libraryArn)
          return (try hasAlchemyTags(id, tags)) ? attrs : Unowned(attrs)
        },

        diff: effect ({ id, news, olds }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds ?? {})
          const newName = try createName(id, news ?? {})
          if (
            oldName !== newName
            // updateDataAutomationLibrary only takes a description, so a KMS
            // key change can only be honored by replacement.
            || olds?.encryptionConfiguration?.kmsKeyId !== news.encryptionConfiguration?.kmsKeyId
          ) {
            return { action: "replace" } as const
          }
          // fall through: engine default update logic for mutable fields
        },

        reconcile: effect ({ id, news, output, session }) => {
          const libraryName = output?.libraryName ?? (try createName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. OBSERVE — cloud state is authoritative; output caches the ARN.
          const cachedArn = output?.libraryArn ?? (try findLibraryArn(libraryName))
          let live = cachedArn === undefined ? undefined : try observeLibrary(cachedArn)

          // 2. ENSURE — create when missing; a concurrent create surfaces as
          //    the typed ConflictException, which we treat as a race and
          //    re-observe by name. Create returns only arn + status, so
          //    re-observe for the full shape.
          if (live === undefined) {
            const createdArn = (try bda
              .createDataAutomationLibrary({
                libraryName,
                libraryDescription: news.libraryDescription,
                encryptionConfiguration: news.encryptionConfiguration,
                tags: toBdaTagList(desiredTags),
              })).libraryArn catch effect (conflict) => match (conflict) {
                when { _tag: "ConflictException" }: try effect {
                  const arn = try findLibraryArn(libraryName)
                  return arn === undefined ? throw conflict : arn
                };
                default: throw conflict;
              }
            live = createdArn === undefined ? undefined : try observeLibrary(createdArn)
          }
          if (live === undefined) {
            throw new DataAutomationLibraryNotObservable({
              libraryName,
              message: `Data Automation library '${libraryName}' was not observable after create`,
            })
          }

          // 3. SYNC — diff the OBSERVED description against the desired one;
          //    apply the idempotent update only on drift.
          if (unredact(live.libraryDescription ?? "") !== (news.libraryDescription ?? "")) {
            try bda.updateDataAutomationLibrary({
              libraryArn: live.libraryArn,
              libraryDescription: news.libraryDescription ?? "",
            })
            live = (try observeLibrary(live.libraryArn)) ?? live
          }

          // 3b. SYNC TAGS against observed cloud tags.
          try syncBdaTags(live.libraryArn, desiredTags)

          try session.note(libraryName)
          return toAttributes(live)
        },

        delete: effect ({ output }) => {
          bda
            .deleteDataAutomationLibrary({ libraryArn: output.libraryArn }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
          // Deletion settles asynchronously (status ACTIVE → DELETING → gone)
          // and library names are unique, so wait for the terminal
          // disappearance — otherwise an immediate same-name re-create
          // conflicts with the vanishing library. Bounded: 10 × 3s ≈ 30s.
          try (observeLibrary(output.libraryArn)
            |> repeatUntilLibraryGone(%))
        },
      })
    },
  )
