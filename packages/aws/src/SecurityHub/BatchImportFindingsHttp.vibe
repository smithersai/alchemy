import * as securityhub from "@distilled.cloud/aws/securityhub"
import * as Layer from "effect/Layer"
import { BatchImportFindings } from "./BatchImportFindings.vibe"
import { makeSecurityHubHttpBinding } from "./BindingHttp.vibe"

export const BatchImportFindingsHttp = Layer.effect(
  BatchImportFindings,
  makeSecurityHubHttpBinding({
    tag: "AWS.SecurityHub.BatchImportFindings",
    operation: securityhub.batchImportFindings,
    actions: ["securityhub:BatchImportFindings"],
  }),
)
