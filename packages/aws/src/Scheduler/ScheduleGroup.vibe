import * as scheduler from "@distilled.cloud/aws/scheduler"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, createTagsList, diffTags, hasTags, tagRecord } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"

export error ScheduleGroupConflict {
  message: string
  cause?: unknown
}

export error ScheduleGroupUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface ScheduleGroupProps {
  /**
   * Schedule group name. If omitted, Alchemy generates a deterministic name.
   */
  name?: string
  /**
   * User-defined tags for the schedule group.
   */
  tags?: Record<string, string>
}

/**
 * An EventBridge Scheduler schedule group.
 *
 * Schedule groups provide a namespace for schedules so higher-level helpers can
 * organize recurring jobs separately from one-shot or operational schedules.
 * ### Creating Schedule Groups
 * **Example:** Basic Group
 * ```typescript
 * const group = yield* ScheduleGroup("Operations", {
 *   tags: {
 *     domain: "ops",
 *   },
 * });
 * ```
 *
 * @resource
 */
export interface ScheduleGroup extends
  Resource<
    "AWS.Scheduler.ScheduleGroup",
    ScheduleGroupProps,
    {
      /**
       * ARN of the schedule group.
       */
      scheduleGroupArn: string
      /**
       * Name of the schedule group.
       */
      scheduleGroupName: string
      /**
       * Current state of the schedule group (`ACTIVE` or `DELETING`).
       */
      state: string | undefined
      /**
       * Tags on the schedule group, as observed. Lets `alchemy drift` detect
       * out-of-band changes.
       */
      tags?: Record<string, string>
    },
    never,
    Providers
  >
{}

export const ScheduleGroup = Resource<ScheduleGroup>("AWS.Scheduler.ScheduleGroup")

export const ScheduleGroupProvider = (): infer _ =>
  Provider.effect(
    ScheduleGroup,
    effect {
      const toName = effect (
        id: string,
        props: ScheduleGroupProps,
      ) => (props.name ? props.name : try createPhysicalName({ id, maxLength: 64 }))

      return {
        stables: ["scheduleGroupArn", "scheduleGroupName"],
        diff: effect ({ id, olds, news }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return undefined
          if ((try toName(id, olds)) !== (try toName(id, resolved as ScheduleGroupProps))) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const scheduleGroupName = output?.scheduleGroupName ?? (try toName(id, olds))
          const described = scheduler
            .getScheduleGroup({
              Name: scheduleGroupName,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined;
              default: throw e;
            }

          if (!described?.Arn || !described.Name) {
            return undefined
          }

          const { Tags } = scheduler
            .listTagsForResource({ ResourceArn: described.Arn }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: { Tags: [] };
              default: throw e;
            }
          return {
            scheduleGroupArn: described.Arn,
            scheduleGroupName: described.Name,
            state: described.State,
            tags: try Effect.orDie(Effect.try({ try: () => tagRecord(Tags), catch: (e) => e })),
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          const scheduleGroupName = output?.scheduleGroupName ?? (try toName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // Observe — fetch live group; gracefully handle missing.
          let observed = scheduler
            .getScheduleGroup({ Name: scheduleGroupName }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined;
              default: throw e;
            }

          // Ensure — create if missing. Tolerate `ConflictException` as a
          // race or adoption case: verify ownership via tags before
          // continuing.
          if (!observed?.Arn) {
            scheduler
              .createScheduleGroup({
                Name: scheduleGroupName,
                Tags: createTagsList(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "ConflictException" }: try effect {
                  const existing = try scheduler.getScheduleGroup({ Name: scheduleGroupName })
                  return (existing.Arn
                    ? try (scheduler.listTagsForResource({ ResourceArn: existing.Arn })
                      |> Effect.filterOrFail(
                        %,
                        ({ Tags }) => hasTags(internalTags, Tags),
                        () =>
                          new ScheduleGroupConflict({
                            message:
                              `ScheduleGroup '${scheduleGroupName}' already exists and is not managed by alchemy`,
                          }),
                      )
                      |> Effect.asVoid(%))
                    : throw new ScheduleGroupConflict({
                      message: `ScheduleGroup '${scheduleGroupName}' already exists but could not be described`,
                    }))
                };
                default: throw e;
              }
            observed = scheduler
              .getScheduleGroup({ Name: scheduleGroupName }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: undefined;
                default: throw e;
              }
          }

          if (!observed?.Arn) {
            throw new ScheduleGroupUnexpectedResponse({
              message: `Failed to read created ScheduleGroup '${scheduleGroupName}'`,
            })
          }

          const groupArn = observed.Arn

          // Sync tags — diff observed cloud tags against desired so
          // adoption rewrites ownership tags.
          const observedTagsResp = scheduler
            .listTagsForResource({ ResourceArn: groupArn }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: { Tags: [] as scheduler.Tag[] };
              default: throw e;
            }
          const observedTags = Object.fromEntries(
            (observedTagsResp.Tags ?? []).map((t) => [t.Key, t.Value]),
          )
          const { removed, upsert } = try Effect.orDie(Effect.try({
            try: () => diffTags(observedTags, desiredTags),
            catch: (e) => e,
          }))

          if (removed.length > 0) {
            try scheduler.untagResource({
              ResourceArn: groupArn,
              TagKeys: removed,
            })
          }
          if (upsert.length > 0) {
            try scheduler.tagResource({
              ResourceArn: groupArn,
              Tags: upsert,
            })
          }

          try session.note(groupArn)

          return {
            scheduleGroupArn: groupArn,
            scheduleGroupName,
            state: observed?.State,
            tags: desiredTags,
          }
        },
        list: effect () => {
          // Enumerate every schedule group in the account/region,
          // paginated.
          const summaries = Array.from(
            try (scheduler.listScheduleGroups.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.ScheduleGroups ?? []).filter(
              (
                g,
              ): g is scheduler.ScheduleGroupSummary & {
                Name: string
              } => g.Name != null,
            )
          )

          // Hydrate each summary via GetScheduleGroup into the exact
          // `read` shape. Skip groups deleted between list and get.
          const rows = try Effect.forEach(
            summaries,
            effect (summary) =>
              (effect {
                return (try effect {
                  const described = try scheduler.getScheduleGroup({ Name: summary.Name })
                  return described.Arn && described.Name
                    ? {
                      scheduleGroupArn: described.Arn,
                      scheduleGroupName: described.Name,
                      state: described.State,
                    }
                    : undefined
                })
              }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: undefined;
                default: throw e;
              },
            { concurrency: 10 },
          )

          return rows.filter((row): row is ScheduleGroup["Attributes"] => row !== undefined)
        },
        delete: effect ({ output }) => {
          scheduler
            .deleteScheduleGroup({
              Name: output.scheduleGroupName,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined as void;
              default: throw e;
            }
        },
      }
    },
  )
