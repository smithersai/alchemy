import * as personalize from "@distilled.cloud/aws/personalize"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.ts"
import { readPersonalizeTags, syncPersonalizeTags } from "./internal.vibe"

export error EventTrackerNotReady {
  message: string
  cause?: unknown
}

export interface EventTrackerProps {
  /**
   * Name of the event tracker. If omitted, a unique name is generated from
   * the app, stage, and logical ID. Changing the name replaces the tracker.
   */
  name?: string
  /**
   * ARN of the dataset group the event tracker records events for. The
   * dataset group should contain an Interactions dataset (events are recorded
   * into it). Only one event tracker can exist per dataset group. Immutable —
   * changing it replaces the tracker.
   */
  datasetGroupArn: string
  /**
   * User-defined tags for the event tracker.
   */
  tags?: Record<string, string>
}

export interface EventTracker extends
  Resource<
    "AWS.Personalize.EventTracker",
    EventTrackerProps,
    {
      /**
       * ARN of the event tracker.
       */
      eventTrackerArn: string
      /**
       * The tracking ID passed as `trackingId` to the PutEvents /
       * PutActionInteractions data-plane operations.
       */
      trackingId: string
      /**
       * Name of the event tracker.
       */
      name: string
      /**
       * Event tracker status (e.g. `ACTIVE`, `CREATE PENDING`).
       */
      status: string
      /**
       * ARN of the dataset group the tracker records events for.
       */
      datasetGroupArn: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Personalize event tracker — the ingestion endpoint for streaming
 * interaction events into a dataset group's Interactions dataset. Creating a
 * tracker yields a `trackingId` that the {@link PutEvents} data-plane binding
 * uses to record events in real time.
 *
 * ### Creating an Event Tracker
 * **Example:** Track Events for a Dataset Group
 * ```typescript
 * const tracker = yield* Personalize.EventTracker("Tracker", {
 *   datasetGroupArn: group.datasetGroupArn,
 * });
 * ```
 *
 * ### Streaming Events
 * **Example:** Record Click Events from a Lambda
 * ```typescript
 * // init
 * const putEvents = yield* Personalize.PutEvents(tracker);
 *
 * // runtime
 * yield* putEvents({
 *   sessionId: "session-1",
 *   userId: "user-1",
 *   eventList: [{ eventType: "click", itemId: "item-42", sentAt: new Date() }],
 * });
 * ```
 *
 * @resource
 */
export const EventTracker = Resource<EventTracker>("AWS.Personalize.EventTracker")

export const EventTrackerProvider = (): infer _ =>
  Provider.effect(
    EventTracker,
    effect {
      const createName = effect (id: string, props: EventTrackerProps) =>
        props.name ?? (try createPhysicalName({ id, maxLength: 63 }))

      const describe = effect (eventTrackerArn: string) => {
        const response = personalize
          .describeEventTracker({ eventTrackerArn }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
            default: throw e;
          }
        return response?.eventTracker
      }

      /** Poll until the tracker reaches ACTIVE; fail fast on CREATE FAILED. */
      const waitActive = effect (eventTrackerArn: string) => {
        const tracker = try (describe(eventTrackerArn)
          |> Effect.repeat(%, {
            schedule: Schedule.max([Schedule.fixed("2 seconds"), Schedule.recurs(40)]),
            until: (t) => t?.status === "ACTIVE" || (t?.status ?? "").includes("FAILED"),
          }))
        if (tracker?.status !== "ACTIVE") {
          throw new EventTrackerNotReady({
            message: `Personalize event tracker ${eventTrackerArn} did not become ACTIVE (status: ${tracker?.status})`,
          })
        }
        return tracker
      }

      /** Find an existing tracker's ARN by name within its dataset group. */
      const findArnByName = effect (name: string, datasetGroupArn: string) => {
        const pages = try personalize.listEventTrackers
          .pages({ datasetGroupArn })
          .pipe(Stream.runCollect)
        return Array.from(pages)
          .flatMap((page) => page.eventTrackers ?? [])
          .find((summary) => summary.name === name)?.eventTrackerArn
      }

      const toAttrs = (tracker: personalize.EventTracker): infer _ => ({
        eventTrackerArn: tracker.eventTrackerArn!,
        trackingId: tracker.trackingId!,
        name: tracker.name!,
        status: tracker.status!,
        datasetGroupArn: tracker.datasetGroupArn!,
      })

      return {
        stables: ["eventTrackerArn", "trackingId", "name"],

        diff: effect ({ id, olds, news }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (
            oldName !== newName
            || (olds.datasetGroupArn ?? undefined) !== (news.datasetGroupArn ?? undefined)
          ) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ id, output }) => {
          if (!output?.eventTrackerArn) return undefined
          const tracker = try describe(output.eventTrackerArn)
          if (tracker === undefined) return undefined
          const attrs = toAttrs(tracker)
          const tags = try readPersonalizeTags(tracker.eventTrackerArn!)
          return (try hasAlchemyTags(id, tags)) ? attrs : Unowned(attrs)
        },

        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // 1. Observe — cloud state is authoritative; output is an ARN cache.
          let tracker = output?.eventTrackerArn !== undefined
            ? try describe(output.eventTrackerArn)
            : undefined

          // 2. Ensure — create if missing, then wait for ACTIVE. A crashed
          //    prior run may have left a same-named tracker behind with no
          //    persisted state — adopt it by name and converge.
          if (tracker === undefined) {
            const arn = ((try personalize
              .createEventTracker({
                name,
                datasetGroupArn: news.datasetGroupArn,
                tags: Object.entries(desiredTags).map(([tagKey, tagValue]) => ({
                  tagKey,
                  tagValue,
                })),
              })).eventTrackerArn!) catch effect (error) => match (error) {
                when { _tag: "ResourceAlreadyExistsException" }: try effect {
                  const existing = try findArnByName(name, news.datasetGroupArn)
                  return (existing === undefined ? throw error : existing)
                };
                default: throw error;
              }
            tracker = try waitActive(arn)
          }

          // 3. Sync tags — diff against OBSERVED cloud tags (no-op after a
          //    fresh create; converges an adopted leftover).
          try syncPersonalizeTags(tracker.eventTrackerArn!, desiredTags)

          try session.note(tracker.eventTrackerArn!)
          return toAttrs(tracker)
        },

        delete: effect ({ output }) => {
          try (effect {
            return personalize.deleteEventTracker({ eventTrackerArn: output.eventTrackerArn }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
          }
            |> Effect.retry(%, {
              while: (e) => e._tag === "ResourceInUseException",
              schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(20)]),
            }))
          // Deletion is asynchronous — wait until the tracker is actually gone
          // so its dataset group can delete without ResourceInUse churn.
          const remaining = try (describe(output.eventTrackerArn)
            |> Effect.repeat(%, {
              schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(40)]),
              until: (tracker): boolean => tracker === undefined,
            }))
          if (remaining !== undefined) {
            throw new EventTrackerNotReady({
              message:
                `Personalize event tracker ${output.eventTrackerArn} was not deleted (status: ${remaining.status})`,
            })
          }
        },

        list: effect () =>
          (try (effect {
            return Array.from(
              try (personalize.listEventTrackers.pages({})
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.eventTrackers ?? [])
          }
            |> Effect.flatMap(
              %,
              Effect.forEach(
                effect (summary) =>
                  try effect {
                    const t = try describe(summary.eventTrackerArn!)
                    return (t ? toAttrs(t) : undefined)
                  },
                { concurrency: 4 },
              ),
            ))).filter((item) => item !== undefined),
      }
    },
  )
