import * as personalize from "@distilled.cloud/aws/personalize"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { readPersonalizeTags, syncPersonalizeTags } from "./internal.vibe"

export error PersonalizeDatasetGroupNotReady {
  message: string
  cause?: unknown
}

export interface DatasetGroupProps {
  /**
   * Name of the dataset group. If omitted, a unique name is generated from the
   * app, stage, and logical ID. Changing the name replaces the group.
   */
  mutable name?: string
  /**
   * ARN of an IAM role Personalize assumes to access a customer-managed KMS
   * key. Immutable — changing it replaces the group.
   */
  mutable roleArn?: string
  /**
   * ARN of a customer-managed KMS key used to encrypt the datasets. Immutable
   * — changing it replaces the group.
   */
  mutable kmsKeyArn?: string
  /**
   * The domain of a domain dataset group (`ECOMMERCE` or `VIDEO_ON_DEMAND`).
   * Omit for a custom dataset group. Immutable — changing it replaces the
   * group.
   */
  mutable domain?: string
  /**
   * User-defined tags for the dataset group.
   */
  mutable tags?: Record<string, string>
}

export interface DatasetGroup extends
  Resource<
    "AWS.Personalize.DatasetGroup",
    DatasetGroupProps,
    {
      /**
       * ARN of the dataset group.
       */
      mutable datasetGroupArn: string
      /**
       * Name of the dataset group.
       */
      mutable name: string
      /**
       * Dataset group status (e.g. `ACTIVE`, `CREATE PENDING`).
       */
      mutable status: string
      /**
       * Domain of the dataset group (`ECOMMERCE` or `VIDEO_ON_DEMAND`) when
       * it is a domain dataset group.
       */
      mutable domain: string | undefined
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Personalize dataset group — the top-level container that holds the
 * datasets, solutions, and campaigns for a single use case. Creating a dataset
 * group is cheap and fast; the expensive training work lives in solutions and
 * campaigns provisioned separately.
 *
 * ### Creating a Dataset Group
 * **Example:** Custom Dataset Group
 * ```typescript
 * const group = yield* Personalize.DatasetGroup("Recommendations", {});
 * ```
 *
 * **Example:** Domain Dataset Group with Encryption
 * ```typescript
 * const group = yield* Personalize.DatasetGroup("Storefront", {
 *   domain: "ECOMMERCE",
 *   roleArn: role.roleArn,
 *   kmsKeyArn: key.keyArn,
 *   tags: { team: "growth" },
 * });
 * ```
 *
 * @resource
 */
export const DatasetGroup = Resource<DatasetGroup>("AWS.Personalize.DatasetGroup")

export const DatasetGroupProvider = (): infer _ =>
  Provider.effect(
    DatasetGroup,
    effect {
      const createName = effect (id: string, props: DatasetGroupProps) =>
        props.name ?? (try createPhysicalName({ id, maxLength: 63 }))

      const describe = effect (datasetGroupArn: string) => {
        const response = personalize
          .describeDatasetGroup({ datasetGroupArn }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
            default: throw e;
          }
        return response?.datasetGroup
      }

      /** Poll until the group reaches ACTIVE; fail fast on CREATE FAILED. */
      const waitActive = effect (datasetGroupArn: string) => {
        const group = try (describe(datasetGroupArn)
          |> Effect.repeat(%, {
            schedule: Schedule.max([Schedule.fixed("2 seconds"), Schedule.recurs(40)]),
            until: (g) => g?.status === "ACTIVE" || (g?.status ?? "").includes("FAILED"),
          }))
        if (group?.status !== "ACTIVE") {
          throw new PersonalizeDatasetGroupNotReady({
            message:
              `Personalize dataset group ${datasetGroupArn} did not become ACTIVE (status: ${group?.status}, reason: ${group?.failureReason})`,
          })
        }
        return group
      }

      /** Find an existing dataset group's ARN by its (deterministic) name. */
      const findArnByName = effect (name: string) => {
        const pages = try personalize.listDatasetGroups.pages({}).pipe(Stream.runCollect)
        return Array.from(pages)
          .flatMap((page) => page.datasetGroups ?? [])
          .find((summary) => summary.name === name)?.datasetGroupArn
      }

      const toAttrs = (group: personalize.DatasetGroup): infer _ => ({
        datasetGroupArn: group.datasetGroupArn!,
        name: group.name!,
        status: group.status!,
        domain: group.domain,
      })

      /** Bounded retry schedule for ResourceInUse while async deletes drain. */
      const inUseRetry = {
        while: (e: { mutable _tag: string }): infer _ => e._tag === "ResourceInUseException",
        schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(20)]),
      }

      const listChildren = effect (datasetGroupArn: string) => {
        const [trackers, filters, solutions, datasets] = try Effect.all(
          [
            personalize.listEventTrackers.pages({ datasetGroupArn })
            |> Stream.runCollect(%)
            |> Effect.map(%, (chunk) => Array.from(chunk).flatMap((page) => page.eventTrackers ?? [])),
            personalize.listFilters.pages({ datasetGroupArn })
            |> Stream.runCollect(%)
            |> Effect.map(%, (chunk) => Array.from(chunk).flatMap((page) => page.Filters ?? [])),
            personalize.listSolutions.pages({ datasetGroupArn })
            |> Stream.runCollect(%)
            |> Effect.map(%, (chunk) => Array.from(chunk).flatMap((page) => page.solutions ?? [])),
            personalize.listDatasets.pages({ datasetGroupArn })
            |> Stream.runCollect(%)
            |> Effect.map(%, (chunk) => Array.from(chunk).flatMap((page) => page.datasets ?? [])),
          ],
          { concurrency: 4 },
        )
        return { trackers, filters, solutions, datasets }
      }

      /**
       * DeleteDatasetGroup requires all children (event trackers, filters,
       * campaigns, solutions, datasets) to be deleted first. Children created
       * out-of-band (e.g. via CreateSolution/CreateCampaign runtime bindings)
       * are not tracked in state, so the group drains any that remain. Each
       * child delete is idempotent (NotFound tolerated) and asynchronous, so
       * after issuing the deletes we poll (bounded) until the group is empty.
       */
      const drainChildren = effect (datasetGroupArn: string) => {
        const { trackers, filters, solutions, datasets } = try listChildren(datasetGroupArn)

        try Effect.forEach(
          trackers,
          effect (t) =>
            try (effect {
              return personalize.deleteEventTracker({ eventTrackerArn: t.eventTrackerArn! }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: try Effect.void;
                default: throw e;
              }
            }
              |> Effect.retry(%, inUseRetry)),
          { concurrency: 4 },
        )

        try Effect.forEach(
          filters,
          effect (f) =>
            try (effect {
              return personalize.deleteFilter({ filterArn: f.filterArn! }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: try Effect.void;
                default: throw e;
              }
            }
              |> Effect.retry(%, inUseRetry)),
          { concurrency: 4 },
        )

        // Campaigns block their solution's deletion, so drain them per
        // solution before deleting the solution.
        try Effect.forEach(
          solutions,
          effect (s) => {
            const campaigns = Array.from(
              try (personalize.listCampaigns
                .pages({ solutionArn: s.solutionArn })
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.campaigns ?? [])
            try Effect.forEach(
              campaigns,
              effect (c) =>
                try (effect {
                  return personalize.deleteCampaign({ campaignArn: c.campaignArn! }) catch effect (e) => match (e) {
                    when { _tag: "ResourceNotFoundException" }: try Effect.void;
                    default: throw e;
                  }
                }
                  |> Effect.retry(%, inUseRetry)),
              { concurrency: 4 },
            )
            try (effect {
              return personalize.deleteSolution({ solutionArn: s.solutionArn! }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: try Effect.void;
                default: throw e;
              }
            }
              |> Effect.retry(%, inUseRetry))
          },
          { concurrency: 2 },
        )

        try Effect.forEach(
          datasets,
          effect (d) =>
            try (effect {
              return personalize.deleteDataset({ datasetArn: d.datasetArn! }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: try Effect.void;
                default: throw e;
              }
            }
              |> Effect.retry(%, inUseRetry)),
          { concurrency: 4 },
        )

        // All child deletes are asynchronous — wait (bounded) until the group
        // reports no remaining children so DeleteDatasetGroup succeeds.
        const remaining = try (listChildren(datasetGroupArn)
          |> Effect.repeat(%, {
            schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(40)]),
            until: (children): boolean =>
              children.trackers.length === 0
              && children.filters.length === 0
              && children.solutions.length === 0
              && children.datasets.length === 0,
          }))
        if (
          remaining.trackers.length
              + remaining.filters.length
              + remaining.solutions.length
              + remaining.datasets.length
            > 0
        ) {
          throw new PersonalizeDatasetGroupNotReady({
            message:
              `Personalize dataset group ${datasetGroupArn} still has children after drain (trackers: ${remaining.trackers.length}, filters: ${remaining.filters.length}, solutions: ${remaining.solutions.length}, datasets: ${remaining.datasets.length})`,
          })
        }
      }

      return {
        stables: ["datasetGroupArn", "name"],

        diff: effect ({ id, olds = {}, news }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (
            oldName !== newName
            || (olds.roleArn ?? undefined) !== (news.roleArn ?? undefined)
            || (olds.kmsKeyArn ?? undefined) !== (news.kmsKeyArn ?? undefined)
            || (olds.domain ?? undefined) !== (news.domain ?? undefined)
          ) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ id, output }) => {
          if (!output?.datasetGroupArn) return undefined
          const group = try describe(output.datasetGroupArn)
          if (group === undefined) return undefined
          const attrs = toAttrs(group)
          const tags = try readPersonalizeTags(group.datasetGroupArn!)
          return (try hasAlchemyTags(id, tags)) ? attrs : Unowned(attrs)
        },

        reconcile: effect ({ id, news = {}, output, session }) => {
          const name = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // 1. Observe — cloud state is authoritative; output is an ARN cache.
          let group = output?.datasetGroupArn !== undefined
            ? try describe(output.datasetGroupArn)
            : undefined

          // 2. Ensure — create if missing, then wait for ACTIVE. A crashed
          //    prior run may have left a same-named group behind with no
          //    persisted state — adopt it by name and converge.
          if (group === undefined) {
            const arn = ((try personalize
              .createDatasetGroup({
                name,
                roleArn: news.roleArn,
                kmsKeyArn: news.kmsKeyArn,
                domain: news.domain,
                tags: Object.entries(desiredTags).map(([tagKey, tagValue]) => ({
                  tagKey,
                  tagValue,
                })),
              })).datasetGroupArn!) catch effect (error) => match (error) {
                when { _tag: "ResourceAlreadyExistsException" }: try effect {
                  const existing = try findArnByName(name)
                  return (existing === undefined ? throw error : existing)
                };
                default: throw error;
              }
            group = try waitActive(arn)
          }

          // 3. Sync tags — diff against OBSERVED cloud tags (no-op after a
          //    fresh create; converges an adopted leftover).
          try syncPersonalizeTags(group.datasetGroupArn!, desiredTags)

          try session.note(group.datasetGroupArn!)
          return toAttrs(group)
        },

        delete: effect ({ output }) => {
          // DeleteDatasetGroup requires every child — event trackers, filters,
          // campaigns, solutions, and datasets — to be deleted first, and each
          // child delete is itself asynchronous. Deletion ordering can't
          // guarantee children-before-parent (bindings/tests create children
          // out-of-band that are not tracked in state), so drain the group's
          // remaining children before deleting the group itself. Every step is
          // idempotent and NotFound-tolerant.
          const group = try describe(output.datasetGroupArn)
          if (group !== undefined) {
            try drainChildren(output.datasetGroupArn)
          }
          try (effect {
            return personalize.deleteDatasetGroup({ datasetGroupArn: output.datasetGroupArn }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
          }
            |> Effect.retry(%, {
              while: (e) => e._tag === "ResourceInUseException",
              schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(20)]),
            }))
          // Deletion is asynchronous (DELETE IN_PROGRESS) — wait until the
          // group is actually gone so the run leaves no lingering resources
          // (the group's auto-created event schema is removed with it).
          const remaining = try (describe(output.datasetGroupArn)
            |> Effect.repeat(%, {
              schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(40)]),
              until: (group): boolean => group === undefined,
            }))
          if (remaining !== undefined) {
            throw new PersonalizeDatasetGroupNotReady({
              message:
                `Personalize dataset group ${output.datasetGroupArn} was not deleted (status: ${remaining.status})`,
            })
          }
        },

        list: effect () =>
          (try (effect {
            return Array.from(
              try (personalize.listDatasetGroups.pages({})
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.datasetGroups ?? [])
          }
            |> Effect.flatMap(
              %,
              Effect.forEach(
                effect (summary) =>
                  try effect {
                    const g = try describe(summary.datasetGroupArn!)
                    return (g ? toAttrs(g) : undefined)
                  },
                { concurrency: 4 },
              ),
            ))).filter((item) => item !== undefined),
      }
    },
  )
