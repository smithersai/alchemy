import * as personalize from "@distilled.cloud/aws/personalize"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.vibe"

export interface SchemaProps {
  /**
   * Name of the schema. If omitted, a unique name is generated from the app,
   * stage, and logical ID. Changing the name replaces the schema.
   */
  mutable name?: string
  /**
   * The Avro schema definition, as a JSON string, describing the fields of the
   * dataset this schema applies to. Immutable — changing it replaces the
   * schema.
   *
   * @example
   * ```json
   * {
   *   "type": "record",
   *   "name": "Interactions",
   *   "namespace": "com.amazonaws.personalize.schema",
   *   "fields": [
   *     { "name": "USER_ID", "type": "string" },
   *     { "name": "ITEM_ID", "type": "string" },
   *     { "name": "TIMESTAMP", "type": "long" }
   *   ],
   *   "version": "1.0"
   * }
   * ```
   */
  mutable schema: string
  /**
   * The domain of a domain-specific dataset group this schema belongs to
   * (`ECOMMERCE` or `VIDEO_ON_DEMAND`). Omit for a custom (non-domain) schema.
   * Immutable — changing it replaces the schema.
   */
  mutable domain?: string
}

export interface Schema extends
  Resource<
    "AWS.Personalize.Schema",
    SchemaProps,
    {
      /**
       * ARN of the schema.
       */
      mutable schemaArn: string
      /**
       * Name of the schema.
       */
      mutable name: string
      /**
       * Avro schema definition as a JSON string.
       */
      mutable schema: string
      /**
       * Domain of the schema (`ECOMMERCE` or `VIDEO_ON_DEMAND`) when it is a
       * domain schema.
       */
      mutable domain: string | undefined
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Personalize schema — an Avro definition that describes the fields
 * of a dataset (Interactions, Items, Users, …). Schemas are immutable once
 * created; changing any property replaces the schema.
 *
 * ### Creating a Schema
 * **Example:** Interactions Schema
 * ```typescript
 * const schema = yield* Personalize.Schema("Interactions", {
 *   schema: JSON.stringify({
 *     type: "record",
 *     name: "Interactions",
 *     namespace: "com.amazonaws.personalize.schema",
 *     fields: [
 *       { name: "USER_ID", type: "string" },
 *       { name: "ITEM_ID", type: "string" },
 *       { name: "TIMESTAMP", type: "long" },
 *     ],
 *     version: "1.0",
 *   }),
 * });
 * ```
 *
 * @resource
 */
export const Schema = Resource<Schema>("AWS.Personalize.Schema")

export const SchemaProvider = (): infer _ =>
  Provider.effect(
    Schema,
    effect {
      const createName = effect (id: string, props: SchemaProps) =>
        props.name ?? (try createPhysicalName({ id, maxLength: 63 }))

      /** Describe a schema by ARN; typed not-found → undefined. */
      const describe = effect (schemaArn: string) => {
        const response = personalize
          .describeSchema({ schemaArn }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
            default: throw e;
          }
        return response?.schema
      }

      /** Find an existing schema's ARN by its (deterministic) name. */
      const findArnByName = effect (name: string) => {
        const pages = try personalize.listSchemas.pages({}).pipe(Stream.runCollect)
        return Array.from(pages)
          .flatMap((page) => page.schemas ?? [])
          .find((summary) => summary.name === name)?.schemaArn
      }

      return {
        stables: ["schemaArn", "name"],

        diff: effect ({ id, olds, news }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          // Schemas are entirely immutable — any change replaces.
          if (
            oldName !== newName
            || (olds.schema ?? undefined) !== (news.schema ?? undefined)
            || (olds.domain ?? undefined) !== (news.domain ?? undefined)
          ) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ output }) => {
          if (!output?.schemaArn) return undefined
          const schema = try describe(output.schemaArn)
          if (schema === undefined) return undefined
          return {
            schemaArn: schema.schemaArn!,
            name: schema.name!,
            schema: schema.schema!,
            domain: schema.domain,
          }
        },

        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)

          // 1. Observe — cloud state is authoritative; output is an ARN cache.
          let schema = output?.schemaArn !== undefined ? try describe(output.schemaArn) : undefined

          // 2. Ensure — schemas are immutable, so only create when missing.
          //    A crashed prior run may have left a same-named schema behind
          //    with no persisted state — adopt it by name.
          if (schema === undefined) {
            const arn = ((try personalize
              .createSchema({
                name,
                schema: news.schema,
                domain: news.domain,
              })).schemaArn!) catch effect (error) => match (error) {
                when { _tag: "ResourceAlreadyExistsException" }: try effect {
                  const existing = try findArnByName(name)
                  return (existing === undefined ? throw error : existing)
                };
                default: throw error;
              }
            schema = try describe(arn)
          }

          try session.note(schema!.schemaArn!)
          return {
            schemaArn: schema!.schemaArn!,
            name: schema!.name!,
            schema: schema!.schema!,
            domain: schema!.domain,
          }
        },

        delete: effect ({ output }) => {
          try (effect {
            return personalize.deleteSchema({ schemaArn: output.schemaArn }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
          }
            |> Effect.retry(%, {
              while: (e) => e._tag === "ResourceInUseException",
              schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(40)]),
            }))
        },

        list: effect () =>
          (try (effect {
            return Array.from(
              try (personalize.listSchemas.pages({})
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.schemas ?? [])
          }
            |> Effect.flatMap(
              %,
              Effect.forEach(
                effect (summary) =>
                  try effect {
                    const s = try describe(summary.schemaArn!)
                    return s
                      ? {
                        schemaArn: s.schemaArn!,
                        name: s.name!,
                        schema: s.schema!,
                        domain: s.domain,
                      }
                      : undefined
                  },
                { concurrency: 4 },
              ),
            ))).filter((item) => item !== undefined),
      }
    },
  )
