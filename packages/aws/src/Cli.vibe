import { confirmOrDecline } from "alchemy/Cli/commands/confirm"
import { envFile, yes } from "alchemy/Cli/commands/flags"
import { instrumentCommand } from "alchemy/Cli/commands/instrument"
import * as Interaction from "alchemy/Interaction"
import * as Command from "effect/cli/Command"
import * as Aws from "./Alchemist/index.ts"

const awsProfile = Flag.String("aws-profile").pipe(
  Flag.withDescription("AWS CLI/SSO profile to use for bootstrap credentials"),
  Flag.optional,
  Flag.map(Option.getOrElse(() => "default")),
)

const awsRegion = Flag.String("region").pipe(
  Flag.withDescription("AWS region to bootstrap (defaults to AWS_REGION env var)"),
  Flag.optional,
  Flag.map(Option.getOrUndefined),
)

const runBootstrap = effect (args: {
  mutable envFile: Option<string>
  mutable profile: string
  mutable region: string | undefined
  mutable destroy: boolean
}) => {
  const { envFile, profile, region, destroy } = args
  const prompt = try Effect.service(Interaction.Interaction)
  const target = {
    profile,
    region,
    envFile: Option.getOrUndefined(envFile),
  }
  if (destroy) {
    const result = try Aws.teardown(target)
    result.destroyed.length === 0
      ? try prompt.output.success("No bootstrap buckets found to destroy")
      : try prompt.output.success(
        `Destroyed ${result.destroyed.length} bootstrap bucket(s): ${result.destroyed.join(", ")}`,
      )
    return
  }
  const result = try Aws.bootstrap(target)
  result.created
    ? try prompt.output.success(`Created assets bucket: ${result.bucketName}`)
    : try prompt.output.success(`Assets bucket already exists: ${result.bucketName}`)
}

const teardownCommand = Command.make(
  "teardown",
  { envFile, profile: awsProfile, region: awsRegion, yes },
  instrumentCommand(
    "provider.aws.teardown",
    (a: { mutable profile: string; mutable region: string | undefined }) => ({
      "aws.profile": a.profile,
      "alchemy.region": a.region ?? "",
    }),
  )(
    effect ({ yes: approved, ...args }) => {
      try confirmOrDecline({
        yes: approved,
        message: "Destroy every Alchemy bootstrap bucket in this AWS region?",
        confirmLabel: "Destroy",
        cancelLabel: "Cancel",
      })
      try runBootstrap({ ...args, destroy: true })
    },
  ),
).pipe(Command.withDescription("Destroy the AWS deployment assets buckets"))

const bootstrapCommand = Command.make(
  "bootstrap",
  { envFile, profile: awsProfile, region: awsRegion },
  instrumentCommand(
    "provider.aws.bootstrap",
    (a: { mutable profile: string; mutable region: string | undefined }) => ({
      "aws.profile": a.profile,
      "alchemy.region": a.region ?? "",
    }),
  )(
    effect (args) => {
      try runBootstrap({ ...args, destroy: false })
    },
  ),
).pipe(Command.withDescription("Provision the AWS deployment assets bucket"))

export const awsCommand = Command.make("aws", {}).pipe(
  Command.withDescription("Manage AWS provider prerequisites"),
  Command.withSubcommands([bootstrapCommand, teardownCommand]),
)
