import * as rum from "@distilled.cloud/aws/rum"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import type { AppMonitor } from "./AppMonitor.vibe"
import { BindRumAppMonitorPolicy } from "./BindingHttp.vibe"
import { PutRumEvents, type PutRumEventsRequest } from "./PutRumEvents.vibe"

/**
 * Bespoke (not `makeRumAppMonitorHttpBinding`): `PutRumEvents` addresses the
 * data-plane endpoint by monitor *id* (not name) and defaults the
 * `AppMonitorDetails` envelope from the bound monitor.
 */
export const PutRumEventsHttp = Layer.effect(
  PutRumEvents,
  effect {
    const bindRumAppMonitorPolicy = try BindRumAppMonitorPolicy
    const op = try AWSBindings.withCredentials(rum.putRumEvents)

    return effect (monitor: AppMonitor) => {
      const monitorId = try monitor.appMonitorId.asEffect()
      const monitorName = try monitor.appMonitorName.asEffect()
      try bindRumAppMonitorPolicy({
        tag: "AWS.RUM.PutRumEvents",
        monitor,
        actions: ["rum:PutRumEvents"],
      })
      return effect (
        request: PutRumEventsRequest,
      ) =>
        try withSpan(
          effect {
            const Id = try monitorId
            return try op({
              ...request,
              Id,
              AppMonitorDetails: request.AppMonitorDetails ?? {
                name: try monitorName,
                id: Id,
              },
            })
          },
          `AWS.RUM.PutRumEvents(${monitor.LogicalId})`,
        )
    }
  },
)
