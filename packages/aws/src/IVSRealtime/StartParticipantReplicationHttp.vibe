import * as ivsrealtime from "@distilled.cloud/aws/ivs-realtime"
import { toWireSeconds } from "alchemy/Util/Duration"
import * as Layer from "effect/Layer"
import { makeIvsRealtimeReplicationHttpBinding } from "./BindingHttp.vibe"
import type { Stage } from "./Stage.vibe"
import {
  StartParticipantReplication,
  type StartParticipantReplicationRequest,
} from "./StartParticipantReplication.vibe"

export const StartParticipantReplicationHttp = Layer.effect(
  StartParticipantReplication,
  effect {
    const make = try makeIvsRealtimeReplicationHttpBinding({
      tag: "AWS.IVSRealtime.StartParticipantReplication",
      operation: ivsrealtime.startParticipantReplication,
      actions: ["ivs:StartParticipantReplication"],
    })
    return effect (sourceStage: Stage, destinationStage: Stage) => {
      const startReplication = try make(sourceStage, destinationStage)
      return effect ({ reconnectWindow, ...request }: StartParticipantReplicationRequest) =>
        try startReplication({
          ...request,
          reconnectWindowSeconds: try Effect.orDie(
            Effect.try({ try: () => toWireSeconds(reconnectWindow), catch: (e) => e }),
          ),
        })
    }
  },
)
