import * as redshift from "@distilled.cloud/aws/redshift"
import * as Layer from "effect/Layer"
import { clusterSnapshotArnPattern, makeRedshiftClusterHttpBinding } from "./BindingHttp.vibe"
import { CreateClusterSnapshot } from "./CreateClusterSnapshot.vibe"

export const CreateClusterSnapshotHttp = Layer.effect(
  CreateClusterSnapshot,
  makeRedshiftClusterHttpBinding({
    tag: "AWS.Redshift.CreateClusterSnapshot",
    operation: redshift.createClusterSnapshot,
    actions: ["redshift:CreateClusterSnapshot"],
    extraResources: (clusterArn): infer _ => [clusterSnapshotArnPattern(clusterArn)],
  }),
)
