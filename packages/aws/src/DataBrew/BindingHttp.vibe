export const makeDataBrewProjectHttpBinding = effect <I extends { Name?: string }, A, E, R>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.DataBrew.StartProjectSession`. */
  tag: string
  /** The distilled operation; `Name` is injected from the project. */
  operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the project ARN. */
  actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect <P extends Project>(project: P) => {
    const ProjectName = try project.projectName.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${project})`({
        policyStatements: [
          {
            Effect: "Allow",
