import * as Effect from "effect/Effect"
import * as agw2 from "@distilled.cloud/aws/apigatewayv2"
import { deepEqual, isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags } from "alchemy/Tags"
import { AWSEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import { collectAllPages, retryOnTooManyRequests, syncTags, tagRecord, vpcLinkArn } from "./common.vibe"

export interface VpcLinkProps {
  /**
   * Name of the VPC link. If omitted, Alchemy generates a deterministic
   * physical name.
   */
  name?: string
  /**
   * Subnet IDs the VPC link attaches to. Immutable — changing them
   * triggers a replacement.
   */
  subnetIds: string[]
  /**
   * Security group IDs for the VPC link. Immutable — changing them
   * triggers a replacement.
   */
  securityGroupIds?: string[]
  /**
   * User-defined tags (Alchemy internal tags are merged automatically).
   */
  tags?: Record<string, string>
}

export interface VpcLink extends
  Resource<
    "AWS.ApiGatewayV2.VpcLink",
    VpcLinkProps,
    {
      /** The VPC link identifier. */
      vpcLinkId: string
      /** The VPC link name. */
      name: string
      /** The subnet IDs. */
      subnetIds: string[]
      /** The security group IDs. */
      securityGroupIds: string[]
      /**
       * The provisioning status (`PENDING`, `AVAILABLE`, `DELETING`,
       * `FAILED`). Provisioning typically takes 1–2 minutes; integrations
       * that reference the link only work once it is `AVAILABLE`.
       */
      status: string | undefined
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An API Gateway v2 VPC link — lets an HTTP API reach private resources
 * (ALB/NLB listeners, Cloud Map services) inside a VPC.
 *
 * Unlike the v1 VPC link (NLB-only, ~10 min provisioning), the v2 link is
 * subnet/security-group based and provisions in ~1–2 minutes.
 * ### Private integrations
 * **Example:** VPC link + private integration
 * ```typescript
 * const link = yield* ApiGatewayV2.VpcLink("Link", {
 *   subnetIds: [subnetA.subnetId, subnetB.subnetId],
 *   securityGroupIds: [securityGroup.securityGroupId],
 * });
 *
 * yield* ApiGatewayV2.Integration("Private", {
 *   api,
 *   integrationType: "HTTP_PROXY",
 *   integrationUri: listener.listenerArn,
 *   integrationMethod: "ANY",
 *   connectionType: "VPC_LINK",
 *   connectionId: link.vpcLinkId,
 *   payloadFormatVersion: "1.0",
 * });
 * ```
 *
 * @resource
 */
export const VpcLink = Resource<VpcLink>("AWS.ApiGatewayV2.VpcLink")

const snapshotFromVpcLink = (link: agw2.GetVpcLinkResponse): VpcLink["Attributes"] => ({
  vpcLinkId: link.VpcLinkId!,
  name: link.Name ?? "",
  subnetIds: [...(link.SubnetIds ?? [])],
  securityGroupIds: [...(link.SecurityGroupIds ?? [])],
  status: link.VpcLinkStatus,
  tags: tagRecord(link.Tags),
})

export const VpcLinkProvider = (): infer _ =>
  Provider.effect(
    VpcLink,
    effect {
      const createName = effect (id: string, props: Pick<VpcLinkProps, "name">) =>
        props.name ?? (try createPhysicalName({ id, maxLength: 128 }))

      const getVpcLinkSafe = effect (vpcLinkId: string) =>
        agw2
          .getVpcLink({ VpcLinkId: vpcLinkId }) catch effect (e) => match (e) {
            when { _tag: "NotFoundException" }: undefined;
            default: throw e;
          }

      return VpcLink.Provider.of({
        stables: ["vpcLinkId"],

        list: effect () => {
          const items = try collectAllPages(effect (NextToken) => try agw2.getVpcLinks({ NextToken }))
          return items
            .filter((link) => link.VpcLinkId != null)
            .map((link) => snapshotFromVpcLink(link))
        },

        read: effect ({ output }) => {
          if (!output?.vpcLinkId) return undefined
          const link = try getVpcLinkSafe(output.vpcLinkId)
          if (!link?.VpcLinkId) return undefined
          return snapshotFromVpcLink(link)
        },

        diff: effect ({ news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          // Subnets and security groups are immutable on a v2 VPC link.
          if (
            !(try Effect.orDie(Effect.try({
              try: () => deepEqual([...news.subnetIds].sort(), [...olds.subnetIds].sort()),
              catch: (error) => error,
            })))
            || !(try Effect.orDie(Effect.try({
              try: () =>
                deepEqual([...(news.securityGroupIds ?? [])].sort(), [...(olds.securityGroupIds ?? [])].sort()),
              catch: (error) => error,
            })))
          ) {
            return { action: "replace" } as const
          }
        },

        reconcile: effect ({ id, news, output, session }) => {
          const { region } = try AWSEnvironment.current
          const name = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. OBSERVE
          let observed = output?.vpcLinkId ? try getVpcLinkSafe(output.vpcLinkId) : undefined

          // 2. ENSURE
          if (!observed?.VpcLinkId) {
            observed = try retryOnTooManyRequests(
              agw2.createVpcLink({
                Name: name,
                SubnetIds: news.subnetIds,
                SecurityGroupIds: news.securityGroupIds,
                Tags: desiredTags,
              }),
            )
            try session.note(`Created VPC link ${observed.VpcLinkId}`)
          }
          const snapshot = snapshotFromVpcLink(observed)

          // 3. SYNC — only the name is mutable.
          if (snapshot.name !== name) {
            try retryOnTooManyRequests(
              agw2.updateVpcLink({
                VpcLinkId: snapshot.vpcLinkId,
                Name: name,
              }),
            )
          }

          // 3b. SYNC TAGS — diff against OBSERVED cloud tags.
          if (
            !(try Effect.orDie(Effect.try({
              try: () => deepEqual(snapshot.tags, desiredTags),
              catch: (error) => error,
            })))
          ) {
            try syncTags({
              resourceArn: try Effect.orDie(Effect.try({
                try: () => vpcLinkArn(region, snapshot.vpcLinkId),
                catch: (e) => e,
              })),
              oldTags: snapshot.tags,
              newTags: desiredTags,
            })
          }

          // 4. RETURN fresh state. Provisioning is asynchronous (~1–2 min);
          //    the `status` attribute surfaces it rather than blocking the
          //    deploy on AVAILABLE.
          const final = try agw2.getVpcLink({
            VpcLinkId: snapshot.vpcLinkId,
          })
          try session.note(`Reconciled VPC link ${snapshot.vpcLinkId}`)
          return snapshotFromVpcLink(final)
        },

        delete: effect ({ output, session }) => {
          try retryOnTooManyRequests(
            effect {
              return agw2
                .deleteVpcLink({ VpcLinkId: output.vpcLinkId }) catch effect (e) => match (e) {
                  when { _tag: "NotFoundException" }: (undefined as void);
                  default: throw e;
                }
            },
          )
          try session.note(`Deleted VPC link ${output.vpcLinkId}`)
        },
      })
    },
  )
