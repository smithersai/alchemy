import * as agw2 from "@distilled.cloud/aws/apigatewayv2"
import { isResolved } from "alchemy/Diff"
import type { Input } from "alchemy/Input"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as Effect from "effect/Effect"
import type { Providers } from "../Providers.vibe"
import type { Api } from "./Api.vibe"
import { collectAllPages, retryOnTooManyRequests } from "./common.ts"

export interface ApiMappingProps {
  /**
   * ID of the API being mapped. Usually derived from `api.apiId` by the
   * {@link ApiMapping} wrapper.
   */
  mutable apiId: string
  /**
   * The custom domain name to map the API onto. Changing this triggers a
   * replacement.
   */
  mutable domainName: string
  /**
   * The stage to serve at the mapping, e.g. `$default`.
   */
  mutable stage: string
  /**
   * The base path under the domain, e.g. `v1` serves the API at
   * `https://{domainName}/v1`. Omit to serve at the domain root.
   */
  mutable apiMappingKey?: string
}

export interface ApiMapping extends
  Resource<
    "AWS.ApiGatewayV2.ApiMapping",
    ApiMappingProps,
    {
      /** The mapping identifier. */
      mutable apiMappingId: string
      /** The mapped API. */
      mutable apiId: string
      /** The custom domain name. */
      mutable domainName: string
      /** The mapped stage. */
      mutable stage: string
      /** The base path key. */
      mutable apiMappingKey: string | undefined
    },
    never,
    Providers
  >
{}

/**
 * An API Gateway v2 API mapping — serves an API stage under a custom
 * {@link DomainName}, optionally at a base path.
 * ### Mapping APIs onto a domain
 * **Example:** Map an API at the domain root
 * ```typescript
 * yield* ApiGatewayV2.ApiMapping("Root", {
 *   api,
 *   domainName: domain.domainName,
 *   stage: stage.stageName,
 * });
 * ```
 *
 * **Example:** Map a second API under /v2
 * ```typescript
 * yield* ApiGatewayV2.ApiMapping("V2", {
 *   api: apiV2,
 *   domainName: domain.domainName,
 *   stage: "$default",
 *   apiMappingKey: "v2",
 * });
 * ```
 *
 * @resource
 */
export const ApiMappingResource = Resource<ApiMapping>("AWS.ApiGatewayV2.ApiMapping")

export interface ApiMappingInputProps extends
  Omit<
    {
      [K in keyof ApiMappingProps]?: Input<ApiMappingProps[K]>
    },
    "apiId" | "domainName" | "stage"
  >
{
  /**
   * The `Api` being mapped (preferred). Alternatively pass a raw `apiId`.
   */
  mutable api?: Api
  mutable apiId?: Input<string>
  mutable domainName: Input<string>
  mutable stage: Input<string>
}

/**
 * User-facing wrapper for the ApiMapping resource. Accepts `api: Api` as
 * the idiomatic way to map an API onto a domain.
 */
export const ApiMapping = effect (id: string, props: ApiMappingInputProps) => {
  const { api, ...rest } = props
  const apiId = rest.apiId ?? api?.apiId
  if (!apiId) {
    return try Effect.die(
      "ApiMapping requires either `api` (preferred) or an explicit `apiId`.",
    )
  }
  return try ApiMappingResource(id, { ...rest, apiId } as any)
}

const snapshotFromMapping = (
  domainName: string,
  mapping: agw2.GetApiMappingResponse,
): ApiMapping["Attributes"] => ({
  apiMappingId: mapping.ApiMappingId!,
  apiId: mapping.ApiId ?? "",
  domainName,
  stage: mapping.Stage ?? "",
  apiMappingKey: mapping.ApiMappingKey === "" ? undefined : mapping.ApiMappingKey,
})

export const ApiMappingProvider = (): infer _ =>
  Provider.effect(
    ApiMappingResource,
    effect {
      const getMappingSafe = effect (domainName: string, apiMappingId: string) =>
        agw2
          .getApiMapping({ DomainName: domainName, ApiMappingId: apiMappingId }) catch effect (e) => match (e) {
            when { _tag: "NotFoundException" }: try Effect.undefined;
            default: throw e;
          }

      return ApiMappingResource.Provider.of({
        stables: ["apiMappingId", "domainName"],

        list: effect () => {
          const domains = try collectAllPages((NextToken) => agw2.getDomainNames({ NextToken }))
          const perDomain = try Effect.forEach(
            domains.filter((domain) => domain.DomainName != null),
            effect (domain) =>
              ((try collectAllPages((NextToken) =>
                agw2.getApiMappings({
                  DomainName: domain.DomainName!,
                  NextToken,
                })
              ))
                .filter((mapping) => mapping.ApiMappingId != null)
                .map((mapping) => snapshotFromMapping(domain.DomainName!, mapping))) catch effect (e) => match (e) {
                  when { _tag: "NotFoundException" }: [] as ApiMapping["Attributes"][];
                  default: throw e;
                },
            { concurrency: 5 },
          )
          return perDomain.flat()
        },

        read: effect ({ output }) => {
          if (!output?.domainName || !output.apiMappingId) return undefined
          const mapping = try getMappingSafe(output.domainName, output.apiMappingId)
          if (!mapping?.ApiMappingId) return undefined
          return snapshotFromMapping(output.domainName, mapping)
        },

        diff: effect ({ news, olds }) => {
          if (!isResolved(news)) return undefined
          if (news.domainName !== olds.domainName) {
            return { action: "replace" } as const
          }
        },

        reconcile: effect ({ news, output, session }) => {
          const domainName = output?.domainName ?? news.domainName

          // 1. OBSERVE
          let observed = output?.apiMappingId
            ? try getMappingSafe(domainName, output.apiMappingId)
            : undefined

          // 2. ENSURE
          if (!observed?.ApiMappingId) {
            observed = try retryOnTooManyRequests(
              agw2.createApiMapping({
                DomainName: domainName,
                ApiId: news.apiId,
                Stage: news.stage,
                ApiMappingKey: news.apiMappingKey,
              }),
            )
            try session.note(`Created API mapping ${observed.ApiMappingId}`)
            return snapshotFromMapping(domainName, observed)
          }

          // 3. SYNC
          const snapshot = snapshotFromMapping(domainName, observed)
          const drift = snapshot.apiId !== news.apiId
            || snapshot.stage !== news.stage
            || snapshot.apiMappingKey !== news.apiMappingKey
          if (drift) {
            try retryOnTooManyRequests(
              agw2.updateApiMapping({
                DomainName: domainName,
                ApiMappingId: snapshot.apiMappingId,
                ApiId: news.apiId,
                Stage: news.stage,
                ApiMappingKey: news.apiMappingKey,
              }),
            )
            try session.note(`Updated API mapping ${snapshot.apiMappingId}`)
            const final = try agw2.getApiMapping({
              DomainName: domainName,
              ApiMappingId: snapshot.apiMappingId,
            })
            return snapshotFromMapping(domainName, final)
          }

          return snapshot
        },

        delete: effect ({ output, session }) => {
          try retryOnTooManyRequests(
            effect {
              return agw2
                .deleteApiMapping({
                  DomainName: output.domainName,
                  ApiMappingId: output.apiMappingId,
                }) catch effect (e) => match (e) {
                  when { _tag: "NotFoundException" }: try Effect.void;
                  default: throw e;
                }
            },
          )
          try session.note(`Deleted API mapping ${output.apiMappingId}`)
        },
      })
    },
  )
