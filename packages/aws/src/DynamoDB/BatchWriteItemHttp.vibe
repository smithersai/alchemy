import * as DynamoDB from "@distilled.cloud/aws/dynamodb"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import {
  BatchWriteItem,
  type BatchWriteItemRequest,
  type BatchWriteItemTables,
  sortBatchWriteItemTables,
} from "./BatchWriteItem.vibe"
import { GrantTables, tablesRegion } from "./BindingHttp.ts"

export const BatchWriteItemHttp = Layer.effect(
  BatchWriteItem,
  effect {
    const grantTables = try GrantTables
    return effect (...tables: BatchWriteItemTables) => {
      const sortedTables = sortBatchWriteItemTables(tables)
      const tableNames = new Map(
        try Effect.forEach(sortedTables, effect (table) => [table.LogicalId, try table.tableName.asEffect()] as const),
      )

      const getTableName = effect (tableId: string) => {
        const TableName = tableNames.get(tableId)
        if (!TableName) {
          return try Effect.die(
            new Error(`BatchWriteItem request references unbound table '${tableId}'`),
          )
        }
        return try TableName
      }

      try grantTables(
        `AWS.DynamoDB.BatchWriteItem(${sortedTables.map((table) => table.LogicalId).join(", ")})`,
        () => [
          {
            Effect: "Allow",
            Action: ["dynamodb:BatchWriteItem"],
            Resource: sortedTables.map((table) => table.tableArn),
          },
        ],
      )
      const batchWriteItem = try AWSBindings.withCredentials(
        DynamoDB.batchWriteItem,
        tablesRegion(sortedTables),
      )

      return effect (request: BatchWriteItemRequest) =>
        try withSpan(
          effect {
            const requestItems = try Effect.forEach(
              Object.entries(request.RequestItems),
              effect ([tableId, writes]) => [try getTableName(tableId), writes] as const,
            )

            return try batchWriteItem({
              ...request,
              RequestItems: Object.fromEntries(requestItems),
            })
          },
          `AWS.DynamoDB.BatchWriteItem(${sortedTables.map((table) => table.LogicalId).join(", ")})`,
        )
    }
  },
)
