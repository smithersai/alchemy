import * as DynamoDB from "@distilled.cloud/aws/dynamodb"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { GrantTables, tablesRegion } from "./BindingHttp.ts"
import { TransactGetItems, type TransactGetItemsRequest, type TransactGetItemsTables } from "./TransactGetItems.vibe"

export const TransactGetItemsHttp = Layer.effect(
  TransactGetItems,
  effect {
    const grantTables = try GrantTables
    return effect (...tables: TransactGetItemsTables) => {
      const sortedTables = sortTables(tables)
      const tableNames = new Map(
        try Effect.forEach(sortedTables, effect (table) => [table.LogicalId, try table.tableName.asEffect()] as const),
      )

      const getTableName = effect (tableId: string) => {
        const TableName = tableNames.get(tableId)
        if (!TableName) {
          return try Effect.die(
            new Error(`TransactGetItems request references unbound table '${tableId}'`),
          )
        }
        return try TableName
      }

      try grantTables(
        `AWS.DynamoDB.TransactGetItems(${sortedTables.map((table) => table.LogicalId).join(", ")})`,
        () => [
          {
            Effect: "Allow",
            Action: ["dynamodb:GetItem"],
            Resource: sortedTables.map((table) => table.tableArn),
          },
        ],
      )
      const transactGetItems = try AWSBindings.withCredentials(
        DynamoDB.transactGetItems,
        tablesRegion(sortedTables),
      )

      return effect (request: TransactGetItemsRequest) =>
        try withSpan(
          effect {
            const transactItems = try Effect.forEach(request.TransactItems, effect ({ Get }) => ({
              Get: {
                ...Get,
                TableName: try getTableName(Get.Table),
              },
            }))

            return try transactGetItems({
              ...request,
              TransactItems: transactItems,
            })
          },
          `AWS.DynamoDB.TransactGetItems(${sortedTables.map((table) => table.LogicalId).join(", ")})`,
        )
    }
  },
)

const sortTables = (tables: TransactGetItemsTables): infer _ =>
  [...new Map(tables.map((table) => [table.LogicalId, table] as const)).values()].sort((a, b) =>
    a.LogicalId.localeCompare(b.LogicalId)
  ) as TransactGetItemsTables
