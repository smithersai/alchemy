import * as Namespace from "alchemy/Namespace"
import type lambda from "aws-lambda"
import * as Layer from "effect/Layer"
import type { Bucket } from "../S3/Bucket.vibe"
import { BucketEventSource as S3BucketEventSource, type BucketEventSourceService } from "../S3/BucketEventSource.vibe"
import type { BucketNotification, NotificationsProps } from "../S3/BucketNotifications.vibe"
import { normalizeBucketNotification } from "../S3/normalizeBucketNotification.vibe"
import type { S3EventType } from "../S3/S3Event.ts"
import * as Lambda from "./Function.vibe"
import { Permission as LambdaPermission } from "./Permission.vibe"

/**
 * Connects an S3 bucket notification stream to the current Lambda function.
 *
 * This layer listens for bucket notifications routed through the Lambda runtime
 * and exposes them as an `Effect.Stream`, while the companion policy configures
 * the invoke permission and bucket notification binding during deployment.
 * ### Wiring Events
 * **Example:** Listen for Object Created Events
 * ```typescript
 * yield* AWS.Lambda.BucketEventSource(
 *   bucket,
 *   { events: ["s3:ObjectCreated:*"] },
 *   (events) => Stream.runForEach(events, (event) => Effect.log(event.key)),
 * );
 * ```
 *
 * @binding
 */
export const BucketEventSource = Layer.effect(
  S3BucketEventSource,
  effect {
    // this layer can only be used in a Lambda Function
    const func = try Lambda.eventSourceHost("AWS.Lambda.BucketEventSource")
    const Permission = try LambdaPermission

    return (effect <Events extends S3EventType[], StreamReq = never, Req = never>(
      bucket: Bucket,
      props: NotificationsProps<Events>,
      process: (
        stream: Stream.Stream<BucketNotification, never, StreamReq>,
      ) => void!never!Req,
    ) => {
      // this adds it to the Lambda Function's environment variables
      const BucketName = try bucket.bucketName.asEffect()

      // Deploy-time: grant the invoke permission and attach the bucket
      // notification config. Skipped once running inside the deployed Function
      // (the global guard), where the only work is registering the runtime
      // handler below. Namespaced under the host so the sub-resources' logical
      // identity matches the previous Binding.Policy.
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try Namespace.push(
          func.LogicalId,
          effect {
            const { events: Events = ["s3:ObjectCreated:*"], prefix, suffix } = props ?? {}
            const filterRules = [
              ...(prefix !== undefined ? [{ Name: "prefix" as const, Value: prefix }] : []),
              ...(suffix !== undefined ? [{ Name: "suffix" as const, Value: suffix }] : []),
            ]
            try Permission(`AWS.Lambda.InvokeFunction(${bucket.LogicalId})`, {
              action: "lambda:InvokeFunction",
              functionName: try Effect.orDie(Effect.try({ try: () => Lambda.qualifiedNameOf(func), catch: (e) => e })),
              principal: "s3.amazonaws.com",
              sourceArn: bucket.bucketArn,
            })
            try bucket.bind(`AWS.S3.Notifications(${bucket.LogicalId})`, {
              notificationConfiguration: {
                LambdaFunctionConfigurations: [
                  {
                    LambdaFunctionArn: try Effect.orDie(
                      Effect.try({ try: () => Lambda.qualifiedArnOf(func), catch: (e) => e }),
                    ),
                    Events,
                    ...(filterRules.length > 0
                      ? { Filter: { Key: { FilterRules: filterRules } } }
                      : {}),
                  },
                ],
              },
            })
          },
        )
      }

      try func.listen(
        effect {
          // this accesses it
          const bucketName = try BucketName
          return effect (event: any) => {
            if (isS3Event(event)) {
              const events = event.Records.filter((record) => record.s3.bucket.name === bucketName)
              if (events.length > 0) {
                return try (process(
                  Stream.fromArray(events).pipe(Stream.mapEffect(normalizeBucketNotification)),
                  // TODO(sam): don't die?
                )
                  |> Effect.orDie(%))
              }
            }
          }
        },
      )
    }) as BucketEventSourceService
  },
)

const isS3Event = (event: any): event is lambda.S3Event =>
  Array.isArray(event.Records) && event.Records.some(effect (record: any) => record.s3)
