import type { ValidationException } from "@distilled.cloud/aws/Errors"
import * as microvms from "@distilled.cloud/aws/lambda-microvms"
import * as Artifacts from "alchemy/Artifacts"
import { isResolved } from "alchemy/Diff"
import type { Input, InputProps } from "alchemy/Input"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import type { ScopedPlanStatusSession } from "alchemy/Report"
import { createInternalTags, diffTags } from "alchemy/Tags"
import { sha256 } from "alchemy/Util/sha256"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import { Assets } from "../Assets.ts"
import {
  buildMicrovmDockerfile,
  bundleMicrovmProgram,
  DEFAULT_MICROVM_PORT,
  readContextDirectory,
  zipFiles,
} from "./MicrovmBundle.ts"
import { MicrovmImage, type MicrovmImageProps } from "./MicrovmImage.vibe"

// Fold the `env` map (user-provided + capability-binding contributions) into the
// MicroVM API's `environmentVariables` (a `Record<string, string>`). Redacted
// values are unwrapped; non-string values are JSON-encoded.
const foldEnv = (env: Record<string, any> | undefined): Record<string, string> | undefined => {
  if (!env) return undefined
  const out: Record<string, string> = {}
  for (const [key, value] of Object.entries(env)) {
    if (value === undefined) continue
    const v = Redacted.isRedacted(value) ? Redacted.value(value) : value
    out[key] = typeof v === "string" ? v : JSON.stringify(v)
  }
  return Object.keys(out).length > 0 ? out : undefined
}

const READY_STATES = new Set<string>(["CREATED", "UPDATED"])
const FAILED_STATES = new Set<string>(["CREATE_FAILED", "UPDATE_FAILED", "DELETE_FAILED"])

const toIso = (value: Date | string | undefined): string | undefined =>
  value instanceof Date ? value.toISOString() : value

// Resolve `buildRole` / `baseImage` (each a string ARN or a materialized
// resource reference) to a plain ARN string. The engine materializes a
// whole-resource prop into its stable attributes (see Plan.ts `resolveInput`),
// so the instance's `.roleArn` / `.imageArn` is a plain string at reconcile.
const resolveBuildRoleArn = (news: MicrovmImageProps): string | undefined =>
  news.buildRole === undefined
    ? undefined
    : typeof news.buildRole === "string"
    ? news.buildRole
    : (news.buildRole.roleArn as unknown as string)

const resolveBaseImageArn = (news: MicrovmImageProps): string | undefined =>
  news.baseImage === undefined
    ? undefined
    : typeof news.baseImage === "string"
    ? news.baseImage
    : (news.baseImage.imageArn as unknown as string)

// Properties (besides the artifact content) that affect the built image.
const buildPropsIdentity = (news: MicrovmImageProps): infer _ =>
  JSON.stringify({
    baseImageArn: resolveBaseImageArn(news) ?? null,
    baseImageVersion: news.baseImageVersion ?? null,
    description: news.description ?? null,
    logging: news.logging ?? null,
    egressNetworkConnectors: [...(news.egressNetworkConnectors ?? [])].sort(),
    cpuConfigurations: news.cpuConfigurations ?? [],
    resources: news.resources ?? [],
    additionalOsCapabilities: [...(news.additionalOsCapabilities ?? [])].sort(),
    hooks: news.hooks ?? null,
    env: news.env ?? {},
  })

interface ResolvedArtifact {
  mutable uri: string
  mutable hash: string
  mutable contentHash: string
}

/**
 * The content half of an image's artifact identity, before any upload: the
 * bundled program (or packaged context) plus the hash that names THAT —
 * independent of the props, which fold into the full `hash` later.
 */
type ArtifactContent = {
  /** Stored on the attrs; compared by `diff`. */
  readonly contentHash: string
  /**
   * The raw content identity the full `hash` is derived from — kept
   * separate so that formula stays byte-identical to what deployed images
   * already carry (`sha256(identity + ":" + propsId)`).
   */
  readonly identity: string
} & ({ readonly archive: Uint8Array } | { readonly uri: string })

/** The props that decide what the artifact's CONTENT is. */
type ContentInputs = Pick<
  MicrovmImageProps,
  | "main"
  | "context"
  | "codeArtifact"
  | "runtime"
  | "port"
  | "dockerfile"
  | "isExternal"
  | "external"
  | "build"
>

/**
 * Pick the content inputs off the plan-time props, or `undefined` when they
 * cannot be read yet. At plan time the props may be unresolved — the build
 * role, env, … are Outputs, and the whole object may itself be an
 * Output/Effect/Config — so only a plain object whose content inputs have
 * all resolved qualifies.
 */
const resolvedContentInputs = (news: Input<MicrovmImageProps>): ContentInputs | undefined => {
  if (typeof news !== "object" || news === null) return undefined
  const n = news as InputProps<MicrovmImageProps>
  const picked: Input<ContentInputs> = {
    main: n.main,
    context: n.context,
    codeArtifact: n.codeArtifact,
    runtime: n.runtime,
    port: n.port,
    dockerfile: n.dockerfile,
    isExternal: n.isExternal,
    external: n.external,
    build: n.build,
  }
  if (!isResolved(picked)) return undefined
  // `isResolved` has verified every field; the cast only re-states that
  // for a type the guard cannot express on a mapped `Input<…>` object.
  const resolved = picked as ContentInputs
  // An Effect/Config-shaped props object has none of these set.
  if (!resolved.main && !resolved.context && !resolved.codeArtifact?.uri) {
    return undefined
  }
  return resolved
}

const resolveName = effect (
  id: string,
  name?: string,
) => (name ? name : try createPhysicalName({ id, maxLength: 64, delimiter: "-" }))

// `getMicrovmImage` requires an ARN or ID — it rejects a plain name with a
// `ValidationException` ("Invalid ARN format"). Only call it with an
// ARN/ID.
const getImage = effect (identifier: string) =>
  microvms
    .getMicrovmImage({ imageIdentifier: identifier }) catch effect (e) => match (e) {
      when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
      default: throw e;
    }

// Look an image up by its (name-only) identifier via the name filter, since
// `getMicrovmImage` won't accept a name. Returns the full image or undefined.
const findImageByName = effect (name: string) => {
  const summaries = Array.from(
    try (microvms.listMicrovmImages.items({ nameFilter: name })
      |> Stream.runCollect(%)),
  )
  const match = summaries.find((summary) => summary.name === name)
  return match ? try getImage(match.imageArn) : undefined
}

const defaultBaseImageArn = effect () => {
  const items = Array.from(
    try (microvms.listManagedMicrovmImages.items({})
      |> Stream.runCollect(%)),
  )
  const base = items.find((i) => i.imageArn.includes("al2023")) ?? items[0]
  if (!base) {
    return try Effect.die("No managed MicroVM base images available; set `baseImage`.")
  }
  return base.imageArn
}

/**
 * Bundle (or package) the image's code and hash the result. Nothing is
 * uploaded here and no prop outside {@link contentInputs} is read: `diff`
 * calls this before the props have resolved (the build role is an Output
 * at plan time) to see a content-only edit of the in-VM program, and
 * `reconcile` calls it again for the archive to upload. Memoized per
 * resource for the run so a diff→reconcile cycle bundles once.
 */
const artifactContent = (
  id: string,
  news: ContentInputs,
  note: (message: string) => void!!,
) =>
  effect {
    if (news.main) {
      const runtime = news.runtime ?? "node"
      const port = news.port ?? DEFAULT_MICROVM_PORT
      try note("Bundling MicroVM program...")
      const { files, hash: bundleHash } = try bundleMicrovmProgram({
        main: news.main,
        runtime,
        isExternal: news.isExternal ?? false,
        external: news.external,
        port,
        build: news.build,
      })
      const dockerfile = buildMicrovmDockerfile(news.dockerfile, runtime, port, {
        sourceMaps: files.some((f) => f.path.endsWith(".map")),
      })
      const identity = `${bundleHash}:${dockerfile}`
      const contentHash = try sha256(identity)
      const archive = try zipFiles([{ path: "Dockerfile", content: dockerfile }, ...files])
      return { contentHash, identity, archive } satisfies ArtifactContent
    }

    if (news.context) {
      const path = try Effect.service(Path.Path)
      const fs = try Effect.service(FileSystem.FileSystem)
      try note("Packaging MicroVM build context...")
      const files = try readContextDirectory(news.context)
      // Ensure a Dockerfile is present (resolve from `dockerfile` path or default).
      const dockerfileName = news.dockerfile ?? "Dockerfile"
      const hasDockerfile = files.some((f) => f.path === dockerfileName)
      if (!hasDockerfile) {
        const dockerfilePath = path.join(news.context, dockerfileName)
        const content = fs
          .readFile(dockerfilePath) catch () => undefined
        if (content) files.push({ path: "Dockerfile", content })
      }
      // Hash the BYTES, not `path:byteLength` — a same-length edit (a
      // flipped version string, a swapped constant) must count as a change.
      const contentId = (try Effect.forEach(
        [...files].sort((a, b) => (a.path < b.path ? -1 : 1)),
        effect (f) => try Effect.map(sha256(f.content), (hash) => `${f.path}:${hash}`),
      )).join("|")
      const archive = try zipFiles(files)
      return {
        contentHash: try sha256(contentId),
        identity: contentId,
        archive,
      } satisfies ArtifactContent
    }

    if (news.codeArtifact?.uri) {
      const uri: string = news.codeArtifact.uri
      return { contentHash: try sha256(uri), identity: uri, uri } satisfies ArtifactContent
    }

    return try Effect.die(
      "MicrovmImage requires one of `main`, `context`, or `codeArtifact.uri`.",
    )
  }.pipe(
    // Re-widen: inference normalizes the object-literal union (adding
    // `uri?: undefined`), which defeats `"uri" in content` narrowing.
    Effect.map((content): ArtifactContent => content),
    Artifacts.cached(`microvm-image-content:${id}`),
  )

// Materialize + upload the code artifact and compute its build identity hash
// (content + props). The `hash` formulas are unchanged from before
// `contentHash` existed, so images deployed earlier are not rebuilt once.
const resolveArtifact = effect (
  id: string,
  news: MicrovmImageProps,
  session: ScopedPlanStatusSession,
) => {
  const propsId = buildPropsIdentity(news)
  const content = try artifactContent(id, news, session.note)
  const hash = try sha256(`${content.identity}:${propsId}`)
  if ("uri" in content) {
    return { uri: content.uri, hash, contentHash: content.contentHash } satisfies ResolvedArtifact
  }
  const assets = try Effect.service(Assets)
  const key = try assets.uploadAsset(hash, content.archive)
  const bucket = try assets.bucketName
  return {
    uri: `s3://${bucket}/${key}`,
    hash,
    contentHash: content.contentHash,
  } satisfies ResolvedArtifact
}

const toAttrs = (
  image: microvms.GetMicrovmImageOutput,
  artifact?: ResolvedArtifact,
): MicrovmImage["Attributes"] => ({
  imageArn: image.imageArn,
  name: image.name,
  state: image.state,
  imageVersion: image.latestActiveImageVersion ?? image.latestFailedImageVersion,
  latestActiveImageVersion: image.latestActiveImageVersion,
  latestFailedImageVersion: image.latestFailedImageVersion,
  createdAt: toIso(image.createdAt),
  updatedAt: toIso(image.updatedAt),
  codeArtifact: artifact
    ? { uri: artifact.uri, hash: artifact.hash, contentHash: artifact.contentHash }
    : undefined,
})

const requireBuildRole = effect (news: MicrovmImageProps) => {
  const arn = resolveBuildRoleArn(news)
  return (arn ? arn : try Effect.die("MicrovmImage requires `buildRole` to build the image."))
}

const createImage = effect (
  name: string,
  news: MicrovmImageProps,
  artifact: ResolvedArtifact,
  baseImageArn: string,
  desiredTags: Record<string, string>,
  session: ScopedPlanStatusSession,
) => {
  const buildRoleArn = try requireBuildRole(news)
  try session.note(`Creating MicroVM image ${name}...`)
  const created = microvms
    .createMicrovmImage({
      name,
      baseImageArn,
      baseImageVersion: news.baseImageVersion,
      buildRoleArn,
      codeArtifact: { uri: artifact.uri },
      description: news.description,
      logging: news.logging,
      egressNetworkConnectors: news.egressNetworkConnectors,
      cpuConfigurations: news.cpuConfigurations,
      resources: news.resources,
      additionalOsCapabilities: news.additionalOsCapabilities,
      hooks: news.hooks,
      environmentVariables: foldEnv(news.env),
      tags: desiredTags,
    }) catch effect (e) => match (e) {
      when { _tag: "ConflictException" }: try effect {
        const existing = try getImage(name)
        return (existing
          ? { imageArn: existing.imageArn }
          : try Effect.die(`MicroVM image ${name} conflicted but was not found.`))
      };
      default: throw e;
    }
  return try waitForReady(created.imageArn, session)
}

const updateImage = effect (
  imageArn: string,
  news: MicrovmImageProps,
  artifact: ResolvedArtifact,
  baseImageArn: string,
  session: ScopedPlanStatusSession,
) => {
  const buildRoleArn = try requireBuildRole(news)
  try session.note(`Updating MicroVM image ${news.name ?? imageArn}...`)
  const updated = try microvms.updateMicrovmImage({
    imageIdentifier: imageArn,
    baseImageArn,
    baseImageVersion: news.baseImageVersion,
    buildRoleArn,
    codeArtifact: { uri: artifact.uri },
    description: news.description,
    logging: news.logging,
    egressNetworkConnectors: news.egressNetworkConnectors,
    cpuConfigurations: news.cpuConfigurations,
    resources: news.resources,
    additionalOsCapabilities: news.additionalOsCapabilities,
    hooks: news.hooks,
    environmentVariables: foldEnv(news.env),
  })
  return try waitForReady(updated.imageArn, session)
}

const syncTags = effect (
  imageArn: string,
  observedTags: Record<string, string>,
  desiredTags: Record<string, string>,
) => {
  const { removed, upsert } = diffTags(observedTags, desiredTags)
  if (removed.length > 0) {
    try microvms.untagResource({ Resource: imageArn, TagKeys: removed })
  }
  if (upsert.length > 0) {
    try microvms.tagResource({
      Resource: imageArn,
      Tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
    })
  }
}

export const MicrovmImageProvider = (): infer _ =>
  Provider.succeed(MicrovmImage, {
    stables: ["imageArn", "name"],

    diff: effect ({ id, olds, news, output }) => {
      // A content-only edit of the in-VM program changes none of the props,
      // so the engine's structural diff would call it a noop and the image
      // would never rebuild. Bundle (memoized for the run) and compare the
      // CONTENT hash, exactly as the Lambda Function diff does. This runs
      // before the props resolve — the build role is an Output at plan
      // time — which is fine because only the plain content inputs are
      // read. Rows persisted before `contentHash` existed skip the check
      // until their next reconcile stamps it.
      const previousContentHash = output?.codeArtifact?.contentHash
      const content = resolvedContentInputs(news)
      if (previousContentHash !== undefined && content !== undefined) {
        const { contentHash } = try artifactContent(id, content, effect () => try Effect.void)
        if (contentHash !== previousContentHash) {
          return { action: "update" } as const
        }
      }
      if (!isResolved(news)) return
      const oldName = try resolveName(id, olds.name)
      const newName = try resolveName(id, news.name)
      if (oldName !== newName) {
        return { action: "replace" } as const
      }
    },

    read: effect ({ id, olds, output }) => {
      // Prefer the cached ARN; otherwise look up by name (getMicrovmImage
      // rejects names).
      const image = output?.imageArn
        ? try getImage(output.imageArn)
        : try findImageByName(output?.name ?? (try resolveName(id, olds?.name)))
      return image
        ? toAttrs(image, output?.codeArtifact as ResolvedArtifact | undefined)
        : undefined
    },

    list: effect () => {
      const summaries = Array.from(
        try (microvms.listMicrovmImages.items({})
          |> Stream.runCollect(%)),
      )
      const images = try Effect.forEach(summaries, (summary) => getImage(summary.imageArn), {
        concurrency: 10,
      })
      return images.flatMap((image) => (image ? [toAttrs(image)] : []))
    },

    reconcile: effect ({ id, news, output, session }) => {
      const name = try resolveName(id, news.name)
      const internalTags = try createInternalTags(id)
      const desiredTags = { ...internalTags, ...news.tags }
      const baseImageArn = resolveBaseImageArn(news) ?? (try defaultBaseImageArn())

      // Resolve + upload the artifact and compute its build identity.
      const artifact = try resolveArtifact(id, news, session)

      // Observe — prefer the cached ARN; otherwise look up by name (a name
      // is not a valid `getMicrovmImage` identifier).
      const observed = output?.imageArn
        ? try getImage(output.imageArn)
        : try findImageByName(name)

      // Ensure + sync: rebuild only when the build identity changed.
      const image = !observed
        ? try createImage(name, news, artifact, baseImageArn, desiredTags, session)
        : output?.codeArtifact?.hash === artifact.hash
        ? observed
        : try updateImage(observed.imageArn, news, artifact, baseImageArn, session)

      try syncTags(image.imageArn, (image.tags ?? {}) as Record<string, string>, desiredTags)

      try session.note(`MicroVM image ${name} is ${image.state}`)
      return toAttrs(image, artifact)
    },

    delete: effect ({ output, session }) => {
      // An image can't be deleted while it still has MicroVMs running — tear
      // them down first and wait for them to disappear.
      try terminateRunningMicrovms(output.imageArn, session)
      try session.note(`Deleting MicroVM image ${output.name}...`)

      try (effect {
        return microvms.deleteMicrovmImage({ imageIdentifier: output.imageArn }) catch effect (e) => match (e) {
          when { _tag: "ResourceNotFoundException" }: try Effect.void;
          default: throw e;
        }
      }
        |> Effect.retry(%, {
          while: (e): e is ValidationException =>
            e._tag === "ValidationException" && e.message.includes("running MicroVMs"),
          schedule: Schedule.max([Schedule.fixed(5_000), Schedule.recurs(12)]),
        }))
      try waitForDeleted(output.imageArn, session)
    },
  })

error ImageBuilding {
  mutable imageArn: string
  mutable state: string
}

error ImageFailed {
  mutable imageArn: string
  mutable state: string
  mutable reason?: string
}

error MicrovmsActive { mutable count: number }

// MicroVM states that still hold a slot on the image and block its deletion.
const ACTIVE_MICROVM_STATES = new Set<string>(["PENDING", "RUNNING", "SUSPENDING", "SUSPENDED"])

const listActiveMicrovms = effect (imageArn: string) =>
  (Array.from(
    try (microvms.listMicrovms.items({ imageIdentifier: imageArn })
      |> Stream.runCollect(%)),
  ).filter((m) => ACTIVE_MICROVM_STATES.has(m.state))) catch effect (e) => match (e) {
    when { _tag: "ResourceNotFoundException" }: [] as microvms.MicrovmItem[];
    default: throw e;
  }

// Terminate every running MicroVM launched from this image and wait until none
// remain active — a prerequisite for deleting the image.
const terminateRunningMicrovms = effect (
  imageArn: string,
  session: ScopedPlanStatusSession,
) => {
  const active = try listActiveMicrovms(imageArn)
  if (active.length === 0) return
  try session.note(`Terminating ${active.length} running MicroVM(s)...`)
  try Effect.forEach(
    active,
    effect (m) =>
      microvms.terminateMicrovm({ microvmIdentifier: m.microvmId }) catch effect (e) => match (e) {
        when { _tag: "ResourceNotFoundException" } or { _tag: "ConflictException" } or { _tag: "ValidationException" }:
          try Effect.void;
        default: throw e;
      },
    { concurrency: 5, discard: true },
  )
  try (effect {
    return try effect {
      const remaining = try listActiveMicrovms(imageArn)
      return (remaining.length === 0 ? try Effect.void : throw new MicrovmsActive({ count: remaining.length }))
    }
  }
    |> Effect.retry(%, {
      while: (e) => e._tag === "MicrovmsActive",
      schedule: Schedule.max([Schedule.fixed(5_000), Schedule.recurs(24)]).pipe(
        Schedule.tap(() => session.note("Waiting for MicroVMs to terminate...")),
      ),
    }))
}

// Drill into the failed version's `stateReason` (and per-architecture build
// state reasons) so a build failure surfaces an actionable message instead of
// just `CREATE_FAILED`.
const buildFailureReason = effect (
  imageArn: string,
  imageVersion: string | undefined,
) => {
  if (!imageVersion) return undefined
  const version = microvms
    .getMicrovmImageVersion({ imageIdentifier: imageArn, imageVersion }) catch () => undefined
  // A version fans out to one build per architecture/chipset; report the reason
  // from each build that actually FAILED (keyed by architecture so multi-platform
  // failures are distinguishable). `buildState` is the reliable signal — don't
  // guess via timestamps.
  const builds = (Array.from(
    try (microvms.listMicrovmImageBuilds
      .items({ imageIdentifier: imageArn, imageVersion })
      |> Stream.runCollect(%)),
  )) catch () => [] as microvms.MicrovmImageBuildSummary[]
  const failedBuildReasons = builds
    .filter((b) => b.buildState === "FAILED" && b.stateReason)
    .map((b) => `${b.architecture}: ${b.stateReason}`)
  // Prefer the per-build failure reasons; fall back to the version-level reason.
  const reasons = failedBuildReasons.length > 0
    ? [...new Set(failedBuildReasons)]
    : [version?.stateReason].filter((r): r is string => !!r)
  return reasons.join("; ")
}

const waitForReady = effect (imageArn: string, session: ScopedPlanStatusSession) =>
  try (effect {
    const image = try microvms.getMicrovmImage({ imageIdentifier: imageArn })
    if (READY_STATES.has(image.state)) return image
    if (FAILED_STATES.has(image.state)) {
      const reason = try buildFailureReason(imageArn, image.latestFailedImageVersion)
      try session.note(
        `MicroVM image build ${image.state}: ${reason ?? "(no reason reported)"}`,
      )
      try Effect.logError(
        `MicroVM image ${imageArn} build ${image.state}: ${reason ?? "(no reason reported)"}`,
      )
      throw new ImageFailed({ imageArn, state: image.state, reason })
    }
    throw new ImageBuilding({ imageArn, state: image.state })
  }
    |> Effect.retry(%, {
      while: (e) => e._tag === "ImageBuilding",
      schedule: Schedule.max([Schedule.fixed(10_000), Schedule.recurs(72)]).pipe(
        Schedule.tap(({ attempt }) => session.note(`Waiting for MicroVM image build... (${attempt * 10}s)`)),
      ),
    }))

const waitForDeleted = effect (imageArn: string, session: ScopedPlanStatusSession) =>
  try (effect {
    const image = microvms
      .getMicrovmImage({ imageIdentifier: imageArn }) catch effect (e) => match (e) {
        when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
        default: throw e;
      }
    if (!image || image.state === "DELETED") return
    if (image.state === "DELETE_FAILED") {
      throw new ImageFailed({ imageArn, state: image.state })
    }
    throw new ImageBuilding({ imageArn, state: image.state })
  }
    |> Effect.retry(%, {
      while: (e) => e._tag === "ImageBuilding",
      schedule: Schedule.max([Schedule.fixed(10_000), Schedule.recurs(72)]).pipe(
        Schedule.tap(({ attempt }) => session.note(`Waiting for MicroVM image deletion... (${attempt * 10}s)`)),
      ),
    }))
