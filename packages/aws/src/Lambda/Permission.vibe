import type * as lambda from "@distilled.cloud/aws/lambda"
import * as Lambda from "@distilled.cloud/aws/lambda"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { plainJson } from "../internal/Observe.ts"
import type { Providers } from "../Providers.ts"

export type { FunctionUrlAuthType } from "@distilled.cloud/aws/lambda"

export interface PermissionProps {
  /**
   * The action that the principal can use on the function.
   * For example, `lambda:InvokeFunction` or `lambda:GetFunction`.
   */
  mutable action: string

  /**
   * The name or ARN of the Lambda function, version, or alias.
   */
  mutable functionName: string

  /**
   * The AWS service, AWS account, IAM user, or IAM role that invokes the function.
   * If you specify a service, use `sourceArn` or `sourceAccount` to limit who can
   * invoke the function through that service.
   */
  mutable principal: string

  /**
   * For Alexa Smart Home functions, a token that the invoker must supply.
   */
  mutable eventSourceToken?: string

  /**
   * The type of authentication that your function URL uses.
   * Set to `AWS_IAM` to restrict access to authenticated users only.
   * Set to `NONE` to bypass IAM authentication to create a public endpoint.
   */
  mutable functionUrlAuthType?: lambda.FunctionUrlAuthType

  /**
   * Indicates whether the permission applies when the function is invoked
   * through a function URL.
   */
  mutable invokedViaFunctionUrl?: boolean

  /**
   * The identifier for your organization in AWS Organizations.
   * Use this to grant permissions to all the AWS accounts under this organization.
   */
  mutable principalOrgID?: string

  /**
   * For AWS services, the ID of the AWS account that owns the resource.
   * Use this together with `sourceArn` to ensure that the specified account owns the resource.
   */
  mutable sourceAccount?: string

  /**
   * For AWS services, the ARN of the AWS resource that invokes the function.
   * For example, an Amazon S3 bucket or Amazon SNS topic.
   */
  mutable sourceArn?: string
}

export interface Permission extends
  Resource<
    "AWS.Lambda.Permission",
    PermissionProps,
    {
      /** The statement ID of the permission. */
      mutable statementId: string
      /** The function name or ARN the permission is attached to. */
      mutable functionName: string
      /**
       * The permission's resource-policy statement (principal, action and
       * conditions), as observed. Lets `alchemy drift` detect out-of-band
       * changes and removal.
       */
      mutable statement?: unknown
    },
    never,
    Providers
  >
{}

/**
 * A Lambda permission that grants an AWS service or another account permission to
 * invoke a function.
 * ### Granting Permissions
 * **Example:** S3 Notification Permission
 * ```typescript
 * const perm = yield* Permission("S3Invoke", {
 *   action: "lambda:InvokeFunction",
 *   functionName: yield* fn.functionArn(),
 *   principal: "s3.amazonaws.com",
 *   sourceArn: yield* bucket.bucketArn,
 *   sourceAccount: (yield* AWSEnvironment.current).accountId,
 * });
 * ```
 *
 * **Example:** Cross Account Invoke
 * ```typescript
 * const perm = yield* Permission("CrossAccount", {
 *   action: "lambda:InvokeFunction",
 *   functionName: yield* fn.functionArn(),
 *   principal: "123456789012",
 * });
 * ```
 *
 * **Example:** Public Function URL
 * ```typescript
 * const perm = yield* Permission("PublicUrl", {
 *   action: "lambda:InvokeFunctionUrl",
 *   functionName: yield* fn.functionArn(),
 *   principal: "*",
 *   functionUrlAuthType: "NONE",
 * });
 * ```
 *
 * @resource
 */
export const Permission = Resource<Permission>("AWS.Lambda.Permission")

/** A Lambda function's resource policy is not valid JSON. */
export error InvalidLambdaResourcePolicy {
  mutable message: string
  mutable cause?: unknown
}

export const PermissionProvider = (): infer _ =>
  Provider.effect(
    Permission,
    effect {
      const createStatementId = (id: string) =>
        createPhysicalName({
          id,
          maxLength: 100,
          delimiter: "-",
        })

      type PermissionAttrs = { mutable statementId: string; mutable functionName: string }

      // Lambda serializes resource-policy mutations per function. Parallel
      // Permission resources (for example several API Gateway routes) can
      // therefore receive a transient ResourceConflictException even when
      // their statement ids are distinct. Keep the retry bounded well below
      // the provider/test timeout.
      type PolicyMutationError = Lambda.AddPermissionError | Lambda.RemovePermissionError
      const retryPolicyMutation = {
        while: (error: PolicyMutationError): infer _ => error._tag === "ResourceConflictException",
        schedule: Schedule.spaced("500 millis"),
        times: 8,
      } as const

      const addPermission = effect (request: Lambda.AddPermissionRequest) =>
        try (Lambda.addPermission(request)
          |> Effect.retry(%, retryPolicyMutation))

      const removePermission = effect (request: Lambda.RemovePermissionRequest) =>
        try (Lambda.removePermission(request)
          |> Effect.retry(%, retryPolicyMutation))

      const findStatement = effect (functionName: string, statementId: string) => {
        const { Policy } = Lambda.getPolicy({
          FunctionName: functionName,
        }) catch effect (e) => match (e) {
          when { _tag: "ResourceNotFoundException" }: { Policy: undefined };
          default: throw e;
        }
        if (!Policy) return undefined
        return try Effect.try({
          try: () => {
            const policy = JSON.parse(Policy) as {
              mutable Statement?: { mutable Sid?: string } | { mutable Sid?: string }[]
            }
            const statements = Array.isArray(policy.Statement)
              ? policy.Statement
              : policy.Statement
              ? [policy.Statement]
              : []
            return statements.find((statement) => statement.Sid === statementId)
          },
          catch: (cause) => new InvalidLambdaResourcePolicy({ message: "invalid Lambda resource policy", cause }),
        })
      }

      return {
        stables: ["statementId", "functionName"],
        list: effect () => {
          // Lambda has no list-permissions API. A Permission is a single
          // statement (Sid) inside a function's resource policy, so we fan
          // out: enumerate every function in the ambient account/region
          // (paginated listFunctions), getPolicy per function, parse the
          // policy JSON, and emit one Attributes per statement Sid.
          const functionNames = Array.from(
            try (Lambda.listFunctions.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.Functions ?? [])
              .map((fn) => fn.FunctionName)
              .filter((name): name is string => name != null)
          )

          const perFunction = try Effect.forEach(
            functionNames,
            effect (functionName) =>
              (try effect {
                const { Policy } = try Lambda.getPolicy({
                  FunctionName: functionName,
                })
                if (!Policy) return [] as PermissionAttrs[]
                const policy = Effect.try({
                  try: () =>
                    JSON.parse(Policy) as {
                      mutable Statement?: { mutable Sid?: string } | { mutable Sid?: string }[]
                    },
                  catch: (cause) => new InvalidLambdaResourcePolicy({ message: "invalid policy", cause }),
                }) catch () => ({
                  Statement: [] as { mutable Sid?: string }[],
                })
                const statements = Array.isArray(policy.Statement)
                  ? policy.Statement
                  : policy.Statement
                  ? [policy.Statement]
                  : []
                return statements
                  .filter((s): s is { mutable Sid: string } => typeof s.Sid === "string")
                  .map((s): PermissionAttrs => ({
                    statementId: s.Sid,
                    functionName,
                  }))
              }) catch effect (e) => match (e) {
                when { _tag: "ResourceNotFoundException" }: [] as PermissionAttrs[];
                default: throw e;
              },
            { concurrency: 10 },
          )
          return perFunction.flat()
        },
        read: effect ({ id, olds, output }) => {
          const functionName = output?.functionName ?? olds?.functionName
          if (functionName === undefined) return undefined
          const statementId = output?.statementId ?? (try createStatementId(id))
          const statement = try findStatement(functionName, statementId)
          if (statement === undefined) return undefined
          return { statementId, functionName, statement: plainJson(statement) }
        },
        diff: effect ({ news, olds }) => {
          if (!isResolved(news)) return
          if (news.functionName !== olds.functionName) {
            return { action: "replace" } as const
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          // Observe — derive identity. The statementId is deterministic from
          // the logical id, so we always use it whether this is a first
          // reconciliation, an adoption, or a re-run after a partial create.
          const statementId = output?.statementId ?? (try createStatementId(id))

          // Observe the deterministic Sid before mutating. An existing Sid is
          // a true create/update collision and must be replaced; a
          // ResourceConflictException from an absent Sid is instead Lambda's
          // transient per-function policy mutation lock and is retried.
          if ((try findStatement(news.functionName, statementId)) !== undefined) {
            removePermission({
              FunctionName: news.functionName,
              StatementId: statementId,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
          }

          try addPermission({
            FunctionName: news.functionName,
            StatementId: statementId,
            Action: news.action,
            Principal: news.principal,
            SourceArn: news.sourceArn,
            SourceAccount: news.sourceAccount,
            EventSourceToken: news.eventSourceToken,
            FunctionUrlAuthType: news.functionUrlAuthType,
            InvokedViaFunctionUrl: news.invokedViaFunctionUrl,
            PrincipalOrgID: news.principalOrgID,
          })

          try session.note(`Permission ${statementId} on ${news.functionName}`)

          const statement = try findStatement(news.functionName, statementId)
          return {
            statementId,
            functionName: news.functionName,
            statement: statement && plainJson(statement),
          }
        },
        delete: effect ({ output }) => {
          removePermission({
            FunctionName: output.functionName,
            StatementId: output.statementId,
          }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.void;
            default: throw e;
          }
        },
      }
    },
  )
