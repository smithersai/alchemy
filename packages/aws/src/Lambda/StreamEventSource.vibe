import * as Namespace from "alchemy/Namespace"
import type lambda from "aws-lambda"
import * as Layer from "effect/Layer"
import { processBatch } from "../internal/EventSourceBatch.vibe"
import type { Stream as KinesisStream } from "../Kinesis/Stream.vibe"
import {
  StreamEventSource as KinesisStreamEventSource,
  type StreamEventSourceProps,
  type StreamEventSourceService,
  type StreamRecordsHandler,
} from "../Kinesis/StreamEventSource.vibe"
import { EventSourceMapping } from "./EventSourceMapping.vibe"
import * as Lambda from "./Function.ts"

export const isKinesisStreamEvent = (event: any): event is lambda.KinesisStreamEvent =>
  Array.isArray(event?.Records)
  && event.Records.length > 0
  && event.Records[0].eventSource === "aws:kinesis"

/** @binding */
export const StreamEventSource = Layer.effect(
  KinesisStreamEventSource,
  effect {
    const host = try Lambda.eventSourceHost("AWS.Lambda.StreamEventSource")
    const Mapping = try EventSourceMapping

    return (effect <E = never, Req = never>(
      stream: KinesisStream,
      props: StreamEventSourceProps,
      process: StreamRecordsHandler<E, Req>,
    ) => {
      const StreamArn = try stream.streamArn.asEffect()

      // Deploy-time: grant IAM and create the event-source mapping. Skipped once
      // running inside the deployed Function (the global guard), where the only
      // work is registering the runtime handler below. Namespaced under the host
      // so the mapping's logical identity matches the previous Binding.Policy.
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try Namespace.push(
          host.LogicalId,
          effect {
            try host.bind`Allow(${host}, AWS.Lambda.StreamEventSource(${stream}))`({
              policyStatements: [
                {
                  Effect: "Allow",
                  Action: [
                    "kinesis:DescribeStream",
                    "kinesis:GetRecords",
                    "kinesis:GetShardIterator",
                    "kinesis:ListShards",
                  ],
                  Resource: [stream.streamArn],
                },
              ],
            })

            try Mapping(
              `AWS.Lambda.EventSourceMapping(${host.LogicalId}, ${stream.LogicalId})`,
              {
                functionName: try Effect.orDie(
                  Effect.try({ try: () => Lambda.qualifiedNameOf(host), catch: (e) => e }),
                ),
                eventSourceArn: stream.streamArn,
                batchSize: props.batchSize,
                maximumBatchingWindow: props.maximumBatchingWindow,
                enabled: true,
                startingPosition: props.startingPosition ?? "LATEST",
                startingPositionTimestamp: props.startingPositionTimestamp,
                parallelizationFactor: props.parallelizationFactor,
                bisectBatchOnFunctionError: props.bisectBatchOnFunctionError,
                maximumRecordAge: props.maximumRecordAge,
                maximumRetryAttempts: props.maximumRetryAttempts,
                tumblingWindow: props.tumblingWindow,
                functionResponseTypes: props.functionResponseTypes,
                destinationConfig: props.destinationConfig,
                filterCriteria: props.filterCriteria,
                kmsKeyArn: props.kmsKeyArn,
                metricsConfig: props.metricsConfig,
              },
            )
          },
        )
      }

      try host.listen(
        effect {
          const streamArn = try StreamArn

          return effect (event: any) => {
            if (isKinesisStreamEvent(event)) {
              const records = event.Records.filter(
                (record) => record.eventSourceARN?.startsWith(streamArn) === true,
              )
              if (records.length > 0) {
                return try (effect {
                  return (try process({ Records: records })) ?? { batchItemFailures: [] }
                }
                  |> processBatch({
                    system: "aws_kinesis",
                    destination: streamArn.split("/")[1] ?? streamArn,
                    count: records.length,
                  })(%)
                  |> Effect.orDie(%))
              }
            }
          }
        },
      )
    }) as StreamEventSourceService
  },
)
