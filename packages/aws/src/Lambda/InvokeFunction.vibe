import * as Lambda from "@distilled.cloud/aws/lambda"
import * as Binding from "alchemy/Binding"
import * as Effect from "effect/Effect"
import type { Function } from "./Function.vibe"

export interface InvokeFunctionRequest extends Omit<Lambda.InvocationRequest, "FunctionName"> {}

/** @binding */
export interface InvokeFunction extends
  Binding.Service<
    InvokeFunction,
    "AWS.Lambda.InvokeFunction",
    (
      func: Function,
    ) => ((request: InvokeFunctionRequest) => Lambda.InvocationResponse!Lambda.InvokeError)!!
  >
{}
export const InvokeFunction = Binding.Service<InvokeFunction>("AWS.Lambda.InvokeFunction")
