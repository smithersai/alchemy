import * as memorydb from "@distilled.cloud/aws/memorydb"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { readMemoryDbTags, sameStringSet } from "./internal.vibe"

export error MemoryDBSubnetGroupUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface SubnetGroupProps {
  /**
   * Name of the subnet group. Must be 1-40 characters. If omitted, a
   * deterministic physical name is generated. Changing the name replaces the
   * subnet group.
   */
  subnetGroupName?: string
  /**
   * Human-readable description of the subnet group.
   */
  description?: string
  /**
   * VPC subnet IDs the subnet group spans. MemoryDB places cluster nodes into
   * these subnets, so they should cover at least two Availability Zones for a
   * multi-AZ cluster.
   */
  subnetIds: string[]
  /**
   * User-defined tags for the subnet group.
   */
  tags?: Record<string, string>
}

export interface SubnetGroup extends
  Resource<
    "AWS.MemoryDB.SubnetGroup",
    SubnetGroupProps,
    {
      /** Name of the subnet group. */
      subnetGroupName: string
      /** ARN of the subnet group. */
      subnetGroupArn: string
      /** Description of the subnet group. */
      description: string | undefined
      /** ID of the VPC the subnets belong to. */
      vpcId: string | undefined
      /** IDs of the subnets in the group. */
      subnetIds: string[]
      /** Tags on the subnet group (user + internal Alchemy tags). */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * A MemoryDB subnet group — the set of VPC subnets a MemoryDB cluster's nodes
 * are placed into.
 *
 * Subnet groups are free and provision instantly. A cluster references one by
 * name via `subnetGroupName`.
 * ### Creating a Subnet Group
 * **Example:** Subnet Group Spanning Two Subnets
 * ```typescript
 * const subnetGroup = yield* SubnetGroup("CacheSubnets", {
 *   description: "MemoryDB cluster subnets",
 *   subnetIds: [subnetA.subnetId, subnetB.subnetId],
 * });
 * ```
 *
 * @resource
 */
export const SubnetGroup = Resource<SubnetGroup>("AWS.MemoryDB.SubnetGroup")

export const SubnetGroupProvider = (): infer _ =>
  Provider.effect(
    SubnetGroup,
    effect {
      const toName = effect (id: string, props: SubnetGroupProps) => (props.subnetGroupName
        ? props.subnetGroupName
        : try createPhysicalName({ id, maxLength: 40, lowercase: true }))

      const readGroup = effect (name: string) => {
        const response = memorydb
          .describeSubnetGroups({ SubnetGroupName: name }) catch effect (e) => match (e) {
            when { _tag: "SubnetGroupNotFoundFault" }: undefined;
            default: throw e;
          }
        return response?.SubnetGroups?.[0]
      }

      const toAttrs = effect (group: memorydb.SubnetGroup) => {
        if (!group.Name || !group.ARN) {
          throw new MemoryDBSubnetGroupUnexpectedResponse({
            message: `Subnet group '${group.Name}' is missing its ARN`,
          })
        }
        return {
          subnetGroupName: group.Name,
          subnetGroupArn: group.ARN,
          description: group.Description,
          vpcId: group.VpcId,
          subnetIds: (group.Subnets ?? [])
            .map((s) => s.Identifier)
            .filter((id): id is string => id !== undefined),
          tags: try readMemoryDbTags(group.ARN),
        }
      }

      return {
        stables: ["subnetGroupName", "subnetGroupArn"],

        diff: effect ({ id, olds, news }) => {
          const resolved = try Effect.orDie(Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }))
          if (resolved === undefined) return undefined
          if (
            (try toName(id, olds ?? { subnetIds: [] }))
              !== (try toName(id, resolved ?? { subnetIds: [] }))
          ) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ id, olds, output }) => {
          const name = output?.subnetGroupName ?? (try toName(id, olds ?? { subnetIds: [] }))
          const group = try readGroup(name)
          if (!group?.ARN) return undefined
          const attrs = try toAttrs(group)
          return (try hasAlchemyTags(id, attrs.tags)) ? attrs : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
        },

        reconcile: effect ({ id, news, output, session }) => {
          const props = news ?? { subnetIds: [] }
          const name = output?.subnetGroupName ?? (try toName(id, props))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...props.tags }

          // 1. Observe — cloud state is authoritative.
          let observed = try readGroup(name)

          // 2. Ensure — create if missing; tolerate AlreadyExists as a race.
          if (observed === undefined) {
            memorydb
              .createSubnetGroup({
                SubnetGroupName: name,
                Description: props.description,
                SubnetIds: props.subnetIds,
                Tags: Object.entries(desiredTags).map(([Key, Value]) => ({
                  Key,
                  Value,
                })),
              }) catch effect (e) => match (e) {
                when { _tag: "SubnetGroupAlreadyExistsFault" }: (undefined as void);
                default: throw e;
              }
            observed = try readGroup(name)
          }
          if (observed === undefined) {
            throw new MemoryDBSubnetGroupUnexpectedResponse({
              message: `Subnet group '${name}' not found after create`,
            })
          }

          // 3. Sync — apply description / subnet delta from OBSERVED state.
          const update: memorydb.UpdateSubnetGroupRequest = {
            SubnetGroupName: name,
          }
          let mutated = false
          if (props.description !== undefined && props.description !== observed.Description) {
            update.Description = props.description
            mutated = true
          }
          const observedSubnets = (observed.Subnets ?? [])
            .map((s) => s.Identifier)
            .filter((s): s is string => s !== undefined)
          if (!sameStringSet(props.subnetIds, observedSubnets)) {
            update.SubnetIds = props.subnetIds
            mutated = true
          }
          if (mutated) {
            const response = try memorydb.updateSubnetGroup(update)
            observed = response.SubnetGroup ?? observed
          }

          // 3b. Sync tags — diff against OBSERVED cloud tags.
          const arn = observed.ARN
          if (arn) {
            const observedTags = try readMemoryDbTags(arn)
            const { removed, upsert } = try Effect.orDie(Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }))
            if (upsert.length > 0) {
              try memorydb.tagResource({ ResourceArn: arn, Tags: upsert })
            }
            if (removed.length > 0) {
              try memorydb.untagResource({
                ResourceArn: arn,
                TagKeys: removed,
              })
            }
          }

          try session.note(name)
          return try toAttrs(observed)
        },

        delete: effect ({ output }) => {
          // A subnet group still attached to a cluster rejects deletion with
          // SubnetGroupInUseFault — retry (bounded) while the cluster releases
          // it. NotFound is success (idempotent delete).
          try (effect {
            return memorydb.deleteSubnetGroup({ SubnetGroupName: output.subnetGroupName }) catch effect (e) => match (e) {
              when { _tag: "SubnetGroupNotFoundFault" }: (undefined as void);
              default: throw e;
            }
          }
            |> Effect.retry(%, {
              while: (e) => e._tag === "SubnetGroupInUseFault",
              schedule: Schedule.max([Schedule.fixed("5 seconds"), Schedule.recurs(12)]),
            }))
        },

        list: effect () =>
          try (effect {
            return Array.from(
              try (memorydb.describeSubnetGroups.pages({})
                |> Stream.runCollect(%)),
            ).flatMap((page) =>
              (page.SubnetGroups ?? []).filter(
                (group) => group.Name !== undefined && group.ARN !== undefined,
              )
            )
          }
            |> Effect.flatMap(%, Effect.forEach(effect (group) => try toAttrs(group), { concurrency: 4 }))),
      }
    },
  )
