import * as memorydb from "@distilled.cloud/aws/memorydb"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { readMemoryDbTags } from "./internal.vibe"

export error ACLNotReady {
  message: string
  cause?: unknown
}

export error ACLUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface ACLProps {
  /**
   * Name of the Access Control List. Must be 1-40 alphanumeric characters. If
   * omitted, a deterministic physical name is generated. Changing the name
   * replaces the ACL.
   */
  aclName?: string
  /**
   * Names of the {@link User}s in this ACL. The account's built-in `default`
   * user belongs to the reserved `open-access` ACL and cannot be added to a
   * custom ACL — reference your own {@link User}s here instead.
   * @default [] (an empty ACL)
   */
  userNames?: string[]
  /**
   * User-defined tags for the ACL.
   */
  tags?: Record<string, string>
}

export interface ACL extends
  Resource<
    "AWS.MemoryDB.ACL",
    ACLProps,
    {
      /** Name of the ACL. */
      aclName: string
      /** ARN of the ACL. */
      aclArn: string
      /** Current lifecycle status (e.g. `creating`, `active`). */
      status: string
      /** Names of the users in the ACL. */
      userNames: string[]
      /** Minimum engine version the ACL is compatible with. */
      minimumEngineVersion: string | undefined
      /** Tags on the ACL (user + internal Alchemy tags). */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * A MemoryDB Access Control List (ACL) — a named collection of {@link User}s
 * that a cluster authenticates against. Attach an ACL to a
 * {@link Cluster} via `aclName`.
 *
 * ACLs are free and provision quickly.
 * ### Creating an ACL
 * **Example:** ACL with a Custom User
 * ```typescript
 * const appUser = yield* User("AppUser", {
 *   authenticationMode: { type: "password", passwords: [appPassword] },
 *   accessString: "on ~* +@all",
 * });
 * const acl = yield* ACL("AppAcl", {
 *   userNames: [appUser.userName],
 * });
 * ```
 *
 * @resource
 */
export const ACL = Resource<ACL>("AWS.MemoryDB.ACL")

export const ACLProvider = (): infer _ =>
  Provider.effect(
    ACL,
    effect {
      const toName = effect (
        id: string,
        props: ACLProps,
      ) => (props.aclName ? props.aclName : try createPhysicalName({ id, maxLength: 40, lowercase: true }))

      const desiredUsers = (props: ACLProps): string[] => props.userNames ?? []

      const readAcl = effect (name: string) => {
        const response = memorydb
          .describeACLs({ ACLName: name }) catch effect (e) => match (e) {
            when { _tag: "ACLNotFoundFault" }: undefined;
            default: throw e;
          }
        return response?.ACLs?.[0]
      }

      // Wait for the ACL to leave a transitional state before mutating or
      // deleting it (avoids InvalidACLStateFault).
      const waitUntilActive = effect (name: string) =>
        try (effect {
          return try effect {
            const acl = try readAcl(name)

            if (acl !== undefined && acl.Status !== "active" && acl.Status !== undefined) {
              throw new ACLNotReady({ message: `ACL '${name}' not active (${acl.Status})` })
            }
            return acl
          }
        }
          |> Effect.retry(%, {
            schedule: Schedule.max([Schedule.fixed("5 seconds"), Schedule.recurs(24)]),
          }))

      const toAttrs = effect (acl: memorydb.ACL) => {
        if (!acl.Name || !acl.ARN) {
          throw new ACLUnexpectedResponse({
            message: `ACL '${acl.Name}' is missing its ARN`,
          })
        }
        return {
          aclName: acl.Name,
          aclArn: acl.ARN,
          status: acl.Status ?? "active",
          userNames: [...(acl.UserNames ?? [])],
          minimumEngineVersion: acl.MinimumEngineVersion,
          tags: try readMemoryDbTags(acl.ARN),
        }
      }

      return {
        stables: ["aclName", "aclArn"],

        diff: effect ({ id, olds, news }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return undefined
          if ((try toName(id, olds ?? {})) !== (try toName(id, resolved ?? {}))) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ id, olds, output }) => {
          const name = output?.aclName ?? (try toName(id, olds ?? {}))
          const acl = try readAcl(name)
          if (!acl?.ARN) return undefined
          const attrs = try toAttrs(acl)
          return (try hasAlchemyTags(id, attrs.tags))
            ? attrs
            : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
        },

        reconcile: effect ({ id, news, output, session }) => {
          const props = news ?? {}
          const name = output?.aclName ?? (try toName(id, props))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...props.tags }
          const desired = desiredUsers(props)

          // 1. Observe — cloud state is authoritative.
          let observed = try readAcl(name)

          // 2. Ensure — create if missing; tolerate AlreadyExists as a race.
          if (observed === undefined) {
            memorydb
              .createACL({
                ACLName: name,
                UserNames: desired,
                Tags: Object.entries(desiredTags).map(([Key, Value]) => ({
                  Key,
                  Value,
                })),
              }) catch effect (e) => match (e) {
                when { _tag: "ACLAlreadyExistsFault" }: undefined as void;
                default: throw e;
              }
            observed = try waitUntilActive(name)
          }
          if (observed === undefined) {
            throw new ACLUnexpectedResponse({
              message: `ACL '${name}' not found after create`,
            })
          }

          // 3. Sync — compute the user membership delta from OBSERVED state.
          const observedUsers = new Set(observed.UserNames ?? [])
          const desiredSet = new Set(desired)
          const toAdd = desired.filter((u) => !observedUsers.has(u))
          const toRemove = [...observedUsers].filter((u) => !desiredSet.has(u))
          if (toAdd.length > 0 || toRemove.length > 0) {
            try memorydb.updateACL({
              ACLName: name,
              ...(toAdd.length > 0 ? { UserNamesToAdd: toAdd } : {}),
              ...(toRemove.length > 0 ? { UserNamesToRemove: toRemove } : {}),
            })
            observed = (try waitUntilActive(name)) ?? observed
          }

          // 3b. Sync tags — diff against OBSERVED cloud tags.
          const arn = observed.ARN
          if (arn) {
            const observedTags = try readMemoryDbTags(arn)
            const { removed, upsert } = try Effect.orDie(
              Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }),
            )
            if (upsert.length > 0) {
              try memorydb.tagResource({ ResourceArn: arn, Tags: upsert })
            }
            if (removed.length > 0) {
              try memorydb.untagResource({
                ResourceArn: arn,
                TagKeys: removed,
              })
            }
          }

          try session.note(name)
          return try toAttrs(observed)
        },

        delete: effect ({ output }) => {
          const name = output.aclName
          // The ACL must be detached from any cluster first; while it is still
          // in use (or mid-modify) deletion rejects with InvalidACLStateFault.
          // Retry bounded; NotFound is success.
          waitUntilActive(name) catch effect (e) => (undefined as void)
          try (effect {
            return memorydb.deleteACL({ ACLName: name }) catch effect (e) => match (e) {
              when { _tag: "ACLNotFoundFault" }: undefined as void;
              default: throw e;
            }
          }
            |> Effect.retry(%, {
              while: (e) => e._tag === "InvalidACLStateFault",
              schedule: Schedule.max([Schedule.fixed("5 seconds"), Schedule.recurs(12)]),
            }))
        },

        list: effect () =>
          try (effect {
            return Array.from(
              try (memorydb.describeACLs.pages({})
                |> Stream.runCollect(%)),
            ).flatMap((page) =>
              (page.ACLs ?? []).filter(
                (acl) =>
                  acl.Name !== undefined
                  && acl.ARN !== undefined
                  // `open-access` is the AWS-managed default ACL that
                  // always exists and can never be deleted — keep it out
                  // of enumeration for account-wide teardown (nuke).
                  && acl.Name !== "open-access",
              )
            )
          }
            |> Effect.flatMap(%, Effect.forEach(effect (acl) => try toAttrs(acl), { concurrency: 4 }))),
      }
    },
  )
