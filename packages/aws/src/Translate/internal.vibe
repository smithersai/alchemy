import * as translate from "@distilled.cloud/aws/translate"
import { diffTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"

/**
 * Coerce a Translate wire tag list (`{ Key, Value }[]`) into a plain
 * `Record<string, string>`.
 */
export const toTagRecord = (tags: readonly translate.Tag[] | undefined): Record<string, string> =>
  Object.fromEntries((tags ?? []).map((t) => [t.Key, t.Value] as const))

/**
 * Read the observed tags of a Translate resource by ARN. Tag reads are
 * best-effort — a failure (e.g. a race with deletion) reports no tags.
 */
export const readTranslateTags = effect (arn: string) => {
  const response = translate
    .listTagsForResource({ ResourceArn: arn }) catch () => undefined
  return toTagRecord(response?.Tags)
}

/**
 * Sync tags on a Translate resource: diff the OBSERVED cloud tags against the
 * desired set and apply only the delta.
 */
export const syncTranslateTags = effect (
  arn: string,
  desiredTags: Record<string, string>,
) => {
  const observedTags = try readTranslateTags(arn)
  const { removed, upsert } = try Effect.orDie(Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }))
  if (upsert.length > 0) {
    try translate.tagResource({
      ResourceArn: arn,
      Tags: upsert.map((t) => ({ Key: t.Key, Value: t.Value })),
    })
  }
  if (removed.length > 0) {
    try translate.untagResource({ ResourceArn: arn, TagKeys: removed })
  }
}
