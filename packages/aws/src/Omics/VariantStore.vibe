import * as omics from "@distilled.cloud/aws/omics"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags, tagRecord } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import * as Schedule from "effect/Schedule"
import * as Stream from "effect/Stream"
import type { Providers } from "../Providers.vibe"
import { syncOmicsTags } from "./internal.ts"

// Variant store names must match `[a-z]([a-z0-9_]){0,254}` — the generated
// physical name (hyphens, mixed case) is coerced to fit.
const toStoreName = (raw: string): infer _ => {
  const sanitized = raw.toLowerCase().replace(/[^a-z0-9_]/g, "_")
  const prefixed = /^[a-z]/.test(sanitized) ? sanitized : `a${sanitized}`
  return prefixed.slice(0, 255)
}

export interface VariantStoreProps {
  /**
   * A name for the variant store. If omitted, a unique name is generated from
   * the app, stage, and logical ID. Must be lowercase, start with a letter,
   * and contain only `[a-z0-9_]`. Changing the name replaces the store.
   */
  mutable name?: string
  /**
   * A description for the variant store. Mutable.
   */
  mutable description?: string
  /**
   * The genome reference for the store, as a reference ARN. Required.
   * Immutable — changing it replaces the store.
   */
  mutable reference: {
    /** ARN of a reference in a HealthOmics reference store. */
    mutable referenceArn: string
  }
  /**
   * Server-side encryption (SSE) settings. Defaults to an AWS-owned key.
   * Immutable.
   */
  mutable sseConfig?: {
    /** Encryption type. `KMS` uses a customer-managed key. */
    mutable type: "KMS"
    /** ARN of the customer-managed KMS key. Required when `type` is `KMS`. */
    mutable keyArn?: string
  }
  /**
   * Tags to apply to the variant store. Merged with internal Alchemy tags.
   */
  mutable tags?: Record<string, string>
}

export interface VariantStore extends
  Resource<
    "AWS.Omics.VariantStore",
    VariantStoreProps,
    {
      /**
       * ID of the variant store.
       */
      mutable variantStoreId: string
      /**
       * ARN of the variant store.
       */
      mutable variantStoreArn: string
      /**
       * Name of the variant store.
       */
      mutable name: string
      /**
       * Store status (e.g. `ACTIVE`, `CREATING`, `UPDATING`, `FAILED`).
       */
      mutable status: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon HealthOmics variant store — a container for genomic variant data
 * (VCF) aligned to a reference genome.
 *
 * A variant store name is auto-generated from the app, stage, and logical ID
 * unless you provide one. The `reference` and `sseConfig` are immutable —
 * changing either replaces the store. `description` is updated in place.
 * ### Creating a Variant Store
 * **Example:** Basic Variant Store
 * ```typescript
 * import * as Omics from "@alchemy.run/aws/Omics";
 *
 * const store = yield* Omics.VariantStore("Variants", {
 *   reference: {
 *     referenceArn: "arn:aws:omics:us-east-1:123456789012:referenceStore/1234567890/reference/0987654321",
 *   },
 * });
 * ```
 *
 * @resource
 */
export const VariantStore = Resource<VariantStore>("AWS.Omics.VariantStore")

export const VariantStoreProvider = (): infer _ =>
  Provider.effect(
    VariantStore,
    effect {
      const createName = effect (id: string, props: { mutable name?: string | undefined }) =>
        props.name ?? toStoreName(try createPhysicalName({ id, maxLength: 96 }))

      const waitUntilActive = effect (name: string) => {
        const final = try (omics.getVariantStore({ name })
          |> Effect.repeat(%, {
            schedule: Schedule.max([Schedule.fixed("5 seconds"), Schedule.recurs(23)]),
            until: (s) => s.status === "ACTIVE" || s.status === "FAILED",
          }))
        if (final.status === "FAILED") {
          throw omics.ValidationException.make({
            message: `Variant store ${name} failed: ${final.statusMessage ?? "unknown"}`,
          })
        }
        return final
      }

      return VariantStore.Provider.of({
        stables: ["variantStoreId", "variantStoreArn", "name"],
        list: effect () =>
          Array.from(
            try (omics.listVariantStores.items({})
              |> Stream.map(%, (item) => ({
                variantStoreId: item.id!,
                variantStoreArn: item.storeArn!,
                name: item.name ?? "",
                status: item.status ?? "",
              }))
              |> Stream.runCollect(%)),
          ),
        read: effect ({ id, olds, output }) => {
          const name = output?.name ?? (try createName(id, olds ?? {}))
          const found = omics
            .getVariantStore({ name }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
              default: throw e;
            }
          if (found === undefined) return undefined
          const attrs = {
            variantStoreId: found.id,
            variantStoreArn: found.storeArn,
            name: found.name,
            status: found.status,
          }
          return (try hasAlchemyTags(id, tagRecord(found.tags))) ? attrs : Unowned(attrs)
        },
        diff: effect ({ id, news, olds }) => {
          if (!isResolved(news)) return undefined
          const prev = olds ?? {}
          const oldName = try createName(id, prev)
          const newName = try createName(id, news)
          if (oldName !== newName) return { action: "replace" } as const
          if (
            (prev.reference?.referenceArn ?? "") !== (news.reference?.referenceArn ?? "")
            || prev.sseConfig?.type !== news.sseConfig?.type
            || prev.sseConfig?.keyArn !== news.sseConfig?.keyArn
          ) {
            return { action: "replace" } as const
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = output?.name ?? (try createName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          let store = omics
            .getVariantStore({ name }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
              default: throw e;
            }

          if (store === undefined) {
            omics
              .createVariantStore({
                name,
                description: news.description,
                reference: news.reference,
                sseConfig: news.sseConfig,
                tags: desiredTags,
              }) catch effect (e) => match (e) { when { _tag: "ConflictException" }: try Effect.void; default: throw e; }
            store = try waitUntilActive(name)
          } else if (store.status === "CREATING") {
            store = try waitUntilActive(name)
          }

          if (news.description !== undefined && news.description !== store.description) {
            try omics.updateVariantStore({
              name,
              description: news.description,
            })
            store = try omics.getVariantStore({ name })
          }

          try syncOmicsTags(store.storeArn, desiredTags)

          try session.note(store.id)
          return {
            variantStoreId: store.id,
            variantStoreArn: store.storeArn,
            name: store.name,
            status: store.status,
          }
        },
        delete: effect ({ output }) => {
          omics
            .deleteVariantStore({ name: output.name, force: true }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
        },
      })
    },
  )
