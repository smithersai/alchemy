import * as Effect from "effect/Effect"
import * as lf from "@distilled.cloud/aws/lakeformation"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.vibe"
import { retryWhileInvalidPrincipal } from "./internal.vibe"
import { type LakeFormationResourceSpec, toWireResource } from "./ResourceSpec.ts"

export interface OptInProps {
  /**
   * The principal (IAM user/role ARN or `IAM_ALLOWED_PRINCIPALS`) whose
   * access to the resource is opted into Lake Formation enforcement.
   * Changing it replaces the opt-in.
   */
  principal: string
  /**
   * The Data Catalog resource (database, table, …) to enforce Lake
   * Formation permissions on for the principal. Changing it replaces the
   * opt-in.
   */
  resource: LakeFormationResourceSpec
}

export interface OptIn extends
  Resource<
    "AWS.LakeFormation.OptIn",
    OptInProps,
    {
      principal: string
      resource: lf.Resource
    },
    {},
    Providers
  >
{}

/**
 * A Lake Formation opt-in — enforces Lake Formation permissions for one
 * principal on one Data Catalog resource while the account is in hybrid
 * access mode (where IAM/S3 policies otherwise govern access).
 *
 * ### Opting Into Lake Formation Enforcement
 * **Example:** Enforce Lake Formation for a Role on a Database
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 *
 * const optIn = yield* AWS.LakeFormation.OptIn("AnalystOptIn", {
 *   principal: analystRole.roleArn,
 *   resource: { database: { name: database.databaseName } },
 * });
 * ```
 *
 * @resource
 */
export const OptIn = Resource<OptIn>("AWS.LakeFormation.OptIn")

export const OptInProvider = (): infer _ =>
  Provider.effect(
    OptIn,
    effect {
      const observe = effect (principal: string, resource: lf.Resource) => {
        const pages = (effect {
          return (try (lf.listLakeFormationOptIns
            .pages({
              Principal: { DataLakePrincipalIdentifier: principal },
              Resource: resource,
            })
            |> Stream.runCollect(%)))
        }) catch effect (e) => match (e) {
          when { _tag: "EntityNotFoundException" } or { _tag: "InvalidLakeFormationPrincipal" }: [];
          default: throw e;
        }
        return Array.from(pages)
          .flatMap((page) => page.LakeFormationOptInsInfoList ?? [])
          .find((info) => info.Principal?.DataLakePrincipalIdentifier === principal)
      }

      return OptIn.Provider.of({
        stables: ["principal", "resource"],

        list: effect () => {
          const pages = try lf.listLakeFormationOptIns.pages({}).pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.LakeFormationOptInsInfoList ?? [])
            .filter(
              (info) =>
                info.Principal?.DataLakePrincipalIdentifier !== undefined
                && info.Resource !== undefined,
            )
            .map((info) => ({
              principal: info.Principal!.DataLakePrincipalIdentifier!,
              resource: info.Resource!,
            }))
        },

        read: effect ({ olds, output }) => {
          const principal = output?.principal ?? olds?.principal
          const resource = output?.resource ?? (olds !== undefined
            ? try Effect.orDie(Effect.try({ try: () => toWireResource(olds.resource), catch: (e) => e }))
            : undefined)
          if (principal === undefined || resource === undefined) {
            return undefined
          }
          const found = try observe(principal, resource)
          if (found === undefined) return undefined
          // Opt-ins are not taggable — ownership cannot be verified.
          return { principal, resource }
        },

        diff: effect ({ news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          if (
            news.principal !== olds.principal
            || JSON.stringify(
              try Effect.orDie(Effect.try({
                try: () => toWireResource(news.resource),
                catch: (e) => e,
              })),
            )
              !== JSON.stringify(
                try Effect.orDie(Effect.try({ try: () => toWireResource(olds.resource), catch: (e) => e })),
              )
          ) {
            // an opt-in has no mutable body — any change replaces it
            return { action: "replace" } as const
          }
        },

        reconcile: effect ({ news, session }) => {
          const resource = try Effect.orDie(Effect.try({ try: () => toWireResource(news.resource), catch: (e) => e }))

          // 1. OBSERVE
          const found = try observe(news.principal, resource)

          // 2. ENSURE — existence-only resource, nothing to sync. A freshly
          //    created IAM principal takes ~10s to propagate before Lake
          //    Formation accepts it, so retry through the typed rejection.
          if (found === undefined) {
            try (lf
              .createLakeFormationOptIn({
                Principal: { DataLakePrincipalIdentifier: news.principal },
                Resource: resource,
              })
              |> retryWhileInvalidPrincipal(%))
          }

          try session.note(news.principal)
          return { principal: news.principal, resource }
        },

        delete: effect ({ output }) => {
          lf
            .deleteLakeFormationOptIn({
              Principal: {
                DataLakePrincipalIdentifier: output.principal,
              },
              Resource: output.resource,
            }) catch effect (e) => match (e) {
              when { _tag: "EntityNotFoundException" } or { _tag: "InvalidLakeFormationPrincipal" }: undefined as void;
              default: throw e;
            }
        },
      })
    },
  )
