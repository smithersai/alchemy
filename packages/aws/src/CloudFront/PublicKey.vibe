import * as cloudfront from "@distilled.cloud/aws/cloudfront"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as Effect from "effect/Effect"
import * as Option from "effect/Option"
import * as Redacted from "effect/Redacted"
import * as Schedule from "effect/Schedule"
import * as Stream from "effect/Stream"
import type { Providers } from "../Providers.ts"
import { extractValue } from "./common.ts"

export error PublicKeyConflict {
  message: string
  cause?: unknown
}

export error PublicKeyUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface PublicKeyProps {
  /**
   * Name of the public key. If omitted, a deterministic name is generated.
   *
   * Names must be unique per AWS account. Changing the name triggers
   * a replacement.
   */
  mutable name?: string
  /**
   * PEM-encoded public key body. Changing the key material triggers a
   * replacement (CloudFront does not allow rotating an existing public
   * key in place).
   */
  mutable encodedKey: Redacted.Redacted<string> | string
  /**
   * Optional comment describing the key.
   */
  mutable comment?: string
}

export interface PublicKey extends
  Resource<
    "AWS.CloudFront.PublicKey",
    PublicKeyProps,
    {
      /**
       * CloudFront-assigned public key identifier. Used by KeyGroups to
       * reference the key.
       */
      mutable publicKeyId: string
      /**
       * Name of the public key.
       */
      mutable name: string
      /**
       * PEM-encoded public key body.
       */
      mutable encodedKey: string
      /**
       * Caller reference used at create time. Stable across updates.
       */
      mutable callerReference: string
      /**
       * Most recent entity tag for update/delete operations.
       */
      mutable etag: string | undefined
      /**
       * Current comment on the key.
       */
      mutable comment: string | undefined
    },
    never,
    Providers
  >
{}

/**
 * A CloudFront public key.
 *
 * Public keys are uploaded ahead of being grouped into a {@link KeyGroup} and
 * used by Distributions for signed URL or signed cookie verification.
 *
 * The key body is immutable after creation — changing `encodedKey` triggers
 * a replacement (CloudFront returns no API to rotate a key in place).
 * ### Creating Public Keys
 * **Example:** PEM-encoded RSA public key
 * ```typescript
 * const key = yield* PublicKey("SignedUrlKey", {
 *   encodedKey: Redacted.make(yield* fs.readFileString("./public_key.pem")),
 *   comment: "RSA-2048 signed URL key for /private",
 * });
 * ```
 *
 * @resource
 */
export const PublicKey = Resource<PublicKey>("AWS.CloudFront.PublicKey")

export const PublicKeyProvider = (): infer _ =>
  Provider.effect(
    PublicKey,
    effect {
      const getById = effect (id: string) => {
        const config = cloudfront
          .getPublicKeyConfig({ Id: id }) catch effect (e) => match (e) {
            when { _tag: "NoSuchPublicKey" }: try Effect.undefined;
            default: throw e;
          }
        if (!config?.PublicKeyConfig) return undefined
        return { config: config.PublicKeyConfig, etag: config.ETag }
      }

      const getByName = effect (name: string) => {
        const summary = Option.getOrUndefined(
          try (cloudfront.listPublicKeys.pages({})
            |> Stream.map(%, (page) => page.PublicKeyList?.Items ?? [])
            |> Stream.flattenIterable(%)
            |> Stream.filter(%, (item) => item.Name === name)
            |> Stream.runHead(%)),
        )
        if (!summary?.Id) return undefined
        return try effect {
          const found = try getById(summary.Id)
          return (found ? { id: summary.Id, ...found } : undefined)
        }
      }

      const buildConfig = (
        name: string,
        callerReference: string,
        props: PublicKeyProps,
      ): cloudfront.PublicKeyConfig => ({
        Name: name,
        CallerReference: callerReference,
        EncodedKey: extractValue(props.encodedKey),
        Comment: props.comment,
      })

      const toAttrs = (
        id: string,
        config: cloudfront.PublicKeyConfig,
        etag: string | undefined,
      ): infer _ => ({
        publicKeyId: id,
        name: config.Name,
        encodedKey: config.EncodedKey,
        callerReference: config.CallerReference,
        etag,
        comment: config.Comment,
      })

      return {
        stables: ["publicKeyId", "callerReference"],
        list: effect () => {
          // CloudFront is global (no region). `listPublicKeys` summaries lack
          // CallerReference/ETag, so fetch each key's full config via
          // `getById` to produce the same Attributes shape `read` returns.
          const ids = Array.from(
            try (cloudfront.listPublicKeys.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) => (page.PublicKeyList?.Items ?? []).map((item) => item.Id))
          const rows = try Effect.forEach(
            ids,
            effect (publicKeyId) =>
              try effect {
                const found = try getById(publicKeyId)
                return found ? toAttrs(publicKeyId, found.config, found.etag) : undefined
              },
            { concurrency: 10 },
          )
          return rows.filter((row) => row !== undefined)
        },
        diff: effect ({ id, news, olds }) => {
          if (!isResolved(news)) return undefined
          if ((try createName(id, olds ?? {})) !== (try createName(id, news))) {
            return { action: "replace" } as const
          }
          // Compare only when the old key is known — an Output-valued
          // `encodedKey` doesn't survive a `creating`-state round-trip (it
          // deserializes as `undefined`).
          if (
            olds.encodedKey !== undefined
            && isResolved(olds.encodedKey)
            && extractValue(olds.encodedKey) !== extractValue(news.encodedKey)
          ) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          if (output?.publicKeyId) {
            const found = try getById(output.publicKeyId)
            if (found) return toAttrs(output.publicKeyId, found.config, found.etag)
          }
          const name = try createName(id, olds ?? {})
          const found = try getByName(name)
          if (!found) return undefined
          return toAttrs(found.id, found.config, found.etag)
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)

          // Observe — locate the public key by id (cached on `output`)
          // or by name. Trust observed cloud state, not stale `olds`.
          let observed = output?.publicKeyId
            ? try effect {
              const found = try getById(output.publicKeyId)
              return (found ? { id: output.publicKeyId, ...found } : undefined)
            }
            : undefined
          if (!observed) {
            observed = try getByName(name)
          }

          // Ensure — create the public key if it's missing. Tolerate
          // `PublicKeyAlreadyExists` (race with a peer reconciler).
          if (!observed) {
            const callerReference = name
            const created = cloudfront
              .createPublicKey({
                PublicKeyConfig: buildConfig(name, callerReference, news),
              }) catch effect (e) => match (e) {
                when { _tag: "PublicKeyAlreadyExists" }: try effect {
                  const existing = try getByName(name)
                  return (existing
                    ? {
                      PublicKey: {
                        Id: existing.id,
                        CreatedTime: new Date(),
                        PublicKeyConfig: existing.config,
                      },
                      ETag: existing.etag,
                      Location: undefined,
                    }
                    : throw new PublicKeyConflict({
                      message: `Public key '${name}' already exists but could not be recovered`,
                    }))
                };
                default: throw e;
              }
            if (!created.PublicKey?.Id) {
              throw new PublicKeyUnexpectedResponse({
                message: "createPublicKey returned no identifier",
              })
            }
            try session.note(created.PublicKey.Id)
            return toAttrs(created.PublicKey.Id, created.PublicKey.PublicKeyConfig, created.ETag)
          }

          // Sync — patch the comment via `updatePublicKey`. The key body
          // is immutable (replacement is forced in `diff`), and the
          // CallerReference is observed from the live config rather than
          // re-derived. The freshly observed ETag handles optimistic
          // concurrency.
          const updated = try cloudfront.updatePublicKey({
            Id: observed.id,
            IfMatch: observed.etag,
            PublicKeyConfig: buildConfig(
              observed.config.Name,
              observed.config.CallerReference,
              news,
            ),
          })
          if (!updated.PublicKey?.Id) {
            throw new PublicKeyUnexpectedResponse({
              message: "updatePublicKey returned no identifier",
            })
          }
          try session.note(observed.id)
          return toAttrs(updated.PublicKey.Id, updated.PublicKey.PublicKeyConfig, updated.ETag)
        },
        delete: effect ({ output }) => {
          const current = try getById(output.publicKeyId)
          if (!current) return
          try (effect {
            return cloudfront
              .deletePublicKey({
                Id: output.publicKeyId,
                IfMatch: current.etag,
              }) catch effect (e) => match (e) { when { _tag: "NoSuchPublicKey" }: try Effect.void; default: throw e; }
          }
            |> Effect.retry(%, {
              while: (error) => error._tag === "PublicKeyInUse",
              schedule: Schedule.max([Schedule.fixed("2 seconds"), Schedule.recurs(15)]),
            }))
        },
      }
    },
  )

const createName = effect (
  id: string,
  props: PublicKeyProps,
) => (props.name ? props.name : try createPhysicalName({ id, maxLength: 128, lowercase: true }))
