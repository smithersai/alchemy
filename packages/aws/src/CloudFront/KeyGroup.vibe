import * as cloudfront from "@distilled.cloud/aws/cloudfront"
import { isResolved } from "alchemy/Diff"
import type { Input } from "alchemy/Input"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.vibe"

export error KeyGroupConflict {
  message: string
  cause?: unknown
}

export error KeyGroupUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface KeyGroupProps {
  /**
   * Name of the key group. If omitted, a deterministic name is generated.
   *
   * Names must be unique per AWS account. Changing the name triggers
   * a replacement.
   */
  name?: string
  /**
   * Public key IDs that belong to the group. Order is preserved.
   */
  items: Input<string>[]
  /**
   * Optional comment describing the group.
   */
  comment?: string
}

export interface KeyGroup extends
  Resource<
    "AWS.CloudFront.KeyGroup",
    KeyGroupProps,
    {
      /**
       * CloudFront-assigned key group identifier. Used by Distributions in
       * `TrustedKeyGroups` to authorize signed URLs/cookies.
       */
      keyGroupId: string
      /**
       * Name of the key group.
       */
      name: string
      /**
       * Public key IDs that belong to the group.
       */
      items: string[]
      /**
       * Most recent entity tag for update/delete operations.
       */
      etag: string | undefined
      /**
       * Current comment on the group.
       */
      comment: string | undefined
    },
    never,
    Providers
  >
{}

/**
 * A CloudFront key group.
 *
 * Key groups bundle one or more {@link PublicKey} resources for use as
 * `TrustedKeyGroups` on a Distribution's cache behavior. CloudFront uses
 * the keys in the group to verify the signatures on signed URLs and
 * signed cookies for that behavior.
 * ### Creating Key Groups
 * **Example:** Group two public keys for signed URL verification
 * ```typescript
 * const primary = yield* PublicKey("PrimarySigningKey", {
 *   encodedKey: yield* fs.readFileString("./primary.pem"),
 * });
 * const secondary = yield* PublicKey("SecondarySigningKey", {
 *   encodedKey: yield* fs.readFileString("./secondary.pem"),
 * });
 *
 * const keyGroup = yield* KeyGroup("SignedUrlKeys", {
 *   comment: "Trusted signers for /private",
 *   items: [primary.publicKeyId, secondary.publicKeyId],
 * });
 * ```
 *
 * @resource
 */
export const KeyGroup = Resource<KeyGroup>("AWS.CloudFront.KeyGroup")

export const KeyGroupProvider = (): infer _ =>
  Provider.effect(
    KeyGroup,
    effect {
      const getById = effect (id: string) => {
        const config = cloudfront
          .getKeyGroupConfig({ Id: id }) catch effect (e) => match (e) {
            when { _tag: "NoSuchResource" }: undefined;
            default: throw e;
          }
        if (!config?.KeyGroupConfig) return undefined
        return { config: config.KeyGroupConfig, etag: config.ETag }
      }

      const getByName = effect (name: string) => {
        const listed = try cloudfront.listKeyGroups({})
        const summary = listed.KeyGroupList?.Items?.find(
          (item) => item.KeyGroup?.KeyGroupConfig?.Name === name,
        )
        if (!summary?.KeyGroup?.Id) return undefined
        return try effect {
          const found = try getById(summary.KeyGroup.Id)
          return (found ? { id: summary.KeyGroup.Id, ...found } : undefined)
        }
      }

      const buildConfig = (
        name: string,
        items: string[],
        comment: string | undefined,
      ): cloudfront.KeyGroupConfig => ({
        Name: name,
        Items: items,
        Comment: comment,
      })

      const toAttrs = (
        id: string,
        config: cloudfront.KeyGroupConfig,
        etag: string | undefined,
      ): infer _ => ({
        keyGroupId: id,
        name: config.Name,
        items: config.Items,
        etag,
        comment: config.Comment,
      })

      return {
        stables: ["keyGroupId"],
        list: effect () => {
          const items: ReturnType<typeof toAttrs>[] = []
          let marker: string | undefined = undefined
          do {
            const listed: cloudfront.ListKeyGroupsResult = try cloudfront.listKeyGroups({
              Marker: marker,
            })
            for (const summary of listed.KeyGroupList?.Items ?? []) {
              const id = summary.KeyGroup?.Id
              const config = summary.KeyGroup?.KeyGroupConfig
              if (!id || !config) continue
              // The list summary omits the ETag; re-read each group to
              // produce the exact Attributes shape `read` returns.
              const found = try getById(id)
              items.push(toAttrs(id, found?.config ?? config, found?.etag))
            }
            marker = listed.KeyGroupList?.NextMarker
          } while (marker)
          return items
        },
        diff: effect ({ id, news, olds }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return undefined
          if ((try createName(id, olds ?? {})) !== (try createName(id, resolved))) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          if (output?.keyGroupId) {
            const found = try getById(output.keyGroupId)
            if (found) return toAttrs(output.keyGroupId, found.config, found.etag)
          }
          const name = try createName(id, olds ?? {})
          const found = try getByName(name)
          if (!found) return undefined
          return toAttrs(found.id, found.config, found.etag)
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)
          const items = news.items as string[]

          // Observe — locate the key group by id (cached on `output`) or
          // by name. Trust observed cloud state, not stale `olds`.
          let observed = output?.keyGroupId
            ? try effect {
              const found = try getById(output.keyGroupId)
              return (found ? { id: output.keyGroupId, ...found } : undefined)
            }
            : undefined
          if (!observed) {
            observed = try getByName(name)
          }

          // Ensure — create the key group if it's missing. Tolerate
          // `KeyGroupAlreadyExists` (race with a peer reconciler).
          if (!observed) {
            const created = cloudfront
              .createKeyGroup({
                KeyGroupConfig: buildConfig(name, items, news.comment),
              }) catch effect (e) => match (e) {
                when { _tag: "KeyGroupAlreadyExists" }: try effect {
                  const existing = try getByName(name)
                  return (existing
                    ? {
                      KeyGroup: {
                        Id: existing.id,
                        LastModifiedTime: new Date(),
                        KeyGroupConfig: existing.config,
                      },
                      ETag: existing.etag,
                      Location: undefined,
                    }
                    : throw new KeyGroupConflict({
                      message: `Key group '${name}' already exists but could not be recovered`,
                    }))
                };
                default: throw e;
              }
            if (!created.KeyGroup?.Id) {
              throw new KeyGroupUnexpectedResponse({
                message: "createKeyGroup returned no identifier",
              })
            }
            try session.note(created.KeyGroup.Id)
            return toAttrs(created.KeyGroup.Id, created.KeyGroup.KeyGroupConfig, created.ETag)
          }

          // Sync — patch the observed config to the desired state. The
          // freshly observed ETag handles optimistic concurrency.
          const updated = try cloudfront.updateKeyGroup({
            Id: observed.id,
            IfMatch: observed.etag,
            KeyGroupConfig: buildConfig(observed.config.Name, items, news.comment),
          })
          if (!updated.KeyGroup?.Id) {
            throw new KeyGroupUnexpectedResponse({
              message: "updateKeyGroup returned no identifier",
            })
          }
          try session.note(observed.id)
          return toAttrs(updated.KeyGroup.Id, updated.KeyGroup.KeyGroupConfig, updated.ETag)
        },
        delete: effect ({ output }) => {
          const current = try getById(output.keyGroupId)
          if (!current) return
          cloudfront
            .deleteKeyGroup({
              Id: output.keyGroupId,
              IfMatch: current.etag,
            }) catch effect (e) => match (e) { when { _tag: "NoSuchResource" }: undefined as void; default: throw e; }
        },
      }
    },
  )

const createName = effect (
  id: string,
  props: { name?: string },
) => (props.name ? props.name : try createPhysicalName({ id, maxLength: 128, lowercase: true }))
