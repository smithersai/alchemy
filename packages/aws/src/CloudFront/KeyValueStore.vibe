import * as cloudfront from "@distilled.cloud/aws/cloudfront"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as Effect from "effect/Effect"
import * as Option from "effect/Option"
import * as Schedule from "effect/Schedule"
import * as Stream from "effect/Stream"
import type { Providers } from "../Providers.ts"

export interface KeyValueStoreProps {
  /**
   * KeyValueStore name. If omitted, a deterministic name is generated.
   */
  name?: string
  /**
   * Optional store comment.
   */
  comment?: string
}

export interface KeyValueStore extends
  Resource<
    "AWS.CloudFront.KeyValueStore",
    KeyValueStoreProps,
    {
      /**
       * KeyValueStore ID.
       */
      keyValueStoreId: string
      /**
       * Store ARN.
       */
      keyValueStoreArn: string
      /**
       * Store name.
       */
      keyValueStoreName: string
      /**
       * Current comment.
       */
      comment: string
    },
    never,
    Providers
  >
{}

/**
 * A CloudFront KeyValueStore for edge metadata.
 *
 * KeyValueStores can be associated with CloudFront Functions and are useful for
 * routing metadata or other small edge-time lookup tables.
 * ### Creating KeyValueStores
 * **Example:** Basic Store
 * ```typescript
 * const store = yield* KeyValueStore("RouterStore", {
 *   comment: "Route metadata",
 * });
 * ```
 *
 * @resource
 */
export const KeyValueStore = Resource<KeyValueStore>("AWS.CloudFront.KeyValueStore")

export const KeyValueStoreProvider = (): infer _ =>
  Provider.effect(
    KeyValueStore,
    effect {
      const getByName = effect (name: string) => {
        const store = Option.getOrUndefined(
          try (cloudfront.listKeyValueStores.pages({})
            |> Stream.map(%, (page) => page.KeyValueStoreList?.Items ?? [])
            |> Stream.flattenIterable(%)
            |> Stream.filter(%, (item) => item.Name === name)
            |> Stream.runHead(%)),
        )
        if (!store?.Name) {
          return undefined
        }
        return cloudfront
          .describeKeyValueStore({ Name: store.Name }) catch effect (e) => match (e) {
            when { _tag: "EntityNotFound" }: try Effect.undefined;
            default: throw e;
          }
      }

      return {
        stables: ["keyValueStoreId", "keyValueStoreArn", "keyValueStoreName"],
        diff: effect ({ id, olds, news: _news }) => {
          if (!isResolved(_news)) return undefined
          const news = _news as typeof olds
          if ((try createName(id, olds ?? {})) !== (try createName(id, news))) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const name = output?.keyValueStoreName ?? (try createName(id, olds ?? {}))
          const current = cloudfront
            .describeKeyValueStore({ Name: name }) catch effect (e) => match (e) {
              when { _tag: "EntityNotFound" }: try getByName(name);
              default: throw e;
            }
          if (!current?.KeyValueStore) {
            return undefined
          }
          return toAttrs(current.KeyValueStore, name)
        },
        // CloudFront is global; `listKeyValueStores` enumerates every store in
        // the account.
        list: effect () =>
          Array.from(
            try (cloudfront.listKeyValueStores.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) => (page.KeyValueStoreList?.Items ?? []).map((store) => toAttrs(store, store.Name))),
        reconcile: effect ({ id, news, output, session }) => {
          const name = output?.keyValueStoreName ?? (try createName(id, news))

          // Observe — describe the store, falling back to a list lookup
          // by name. Trust live state, not stale `olds`.
          const observed = cloudfront
            .describeKeyValueStore({ Name: name }) catch effect (e) => match (e) {
              when { _tag: "EntityNotFound" }: try getByName(name);
              default: throw e;
            }

          // Ensure — create the store if it's missing. Tolerate
          // `EntityAlreadyExists` (race with a peer reconciler).
          if (!observed?.KeyValueStore) {
            const created = cloudfront
              .createKeyValueStore({ Name: name, Comment: news.comment }) catch effect (e) => match (e) {
                when { _tag: "EntityAlreadyExists" }: try effect {
                  const existing = try getByName(name)
                  return (existing ? existing : try Effect.die(
                    `CloudFront KeyValueStore '${name}' already exists but could not be recovered`,
                  ))
                };
                default: throw e;
              }
            if (!created.KeyValueStore) {
              return try Effect.die("createKeyValueStore returned no key value store")
            }
            try session.note(created.KeyValueStore.Id)
            return toAttrs(created.KeyValueStore, name)
          }

          // Sync — patch the observed comment via `updateKeyValueStore`
          // using the freshly observed ETag.
          const updated = try cloudfront.updateKeyValueStore({
            Name: observed.KeyValueStore.Name,
            Comment: news.comment ?? "",
            IfMatch: observed.ETag!,
          })
          if (!updated.KeyValueStore) {
            return try Effect.die("updateKeyValueStore returned no key value store")
          }
          try session.note(updated.KeyValueStore.Id)
          return toAttrs(updated.KeyValueStore, observed.KeyValueStore.Name)
        },
        delete: effect ({ output }) =>
          try (effect {
            const current = cloudfront
              .describeKeyValueStore({ Name: output.keyValueStoreName }) catch effect (e) => match (e) {
                when { _tag: "EntityNotFound" }: try Effect.undefined;
                default: throw e;
              }

            const etag = current?.ETag
            if (!etag) {
              try Effect.logInfo(
                `CloudFront KeyValueStore delete: ${output.keyValueStoreName} already absent`,
              )
              return
            }

            try Effect.logInfo(
              `CloudFront KeyValueStore delete: deleting ${output.keyValueStoreName} with etag=${etag}`,
            )
            cloudfront
              .deleteKeyValueStore({ Name: output.keyValueStoreName, IfMatch: etag }) catch effect (e) => match (e) {
                when { _tag: "EntityNotFound" }: try Effect.void;
                default: throw e;
              }
          }
            |> Effect.retry(%, {
              // KV writes can invalidate the control-plane ETag before Describe
              // catches up. Retry the entire read/delete pair with a fresh ETag.
              while: (error) => error._tag === "PreconditionFailed",
              schedule: Schedule.spaced("500 millis"),
              times: 8,
            })),
      }
    },
  )

const createName = effect (
  id: string,
  props: KeyValueStoreProps,
) => (props.name ? props.name : try createPhysicalName({ id, maxLength: 64, lowercase: true }))

// Status, last-modified time and ETag change on their own (provisioning
// finishes, every key write bumps them), so they are not attributes: drift
// would never read a store as unchanged.
const toAttrs = (
  store: cloudfront.KeyValueStore,
  fallbackName: string,
): KeyValueStore["Attributes"] => ({
  keyValueStoreId: store.Id,
  keyValueStoreArn: store.ARN,
  keyValueStoreName: store.Name || fallbackName,
  comment: store.Comment ?? "",
})
