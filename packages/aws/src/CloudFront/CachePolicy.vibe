import * as cloudfront from "@distilled.cloud/aws/cloudfront"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { toWireSeconds } from "alchemy/Util/Duration"
import type * as Duration from "effect/Duration"
import type { Providers } from "../Providers.vibe"

export error CachePolicyConflict {
  message: string
  cause?: unknown
}

export error CachePolicyUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface CachePolicyProps {
  /**
   * Name of the cache policy. If omitted, a deterministic name is generated.
   *
   * Names must be unique per AWS account. Changing the name triggers
   * a replacement.
   */
  mutable name?: string
  /**
   * Optional comment describing the policy.
   */
  mutable comment?: string
  /**
   * Minimum amount of time that objects stay in the cache (e.g.
   * `"1 minute"` or `Duration.minutes(1)`; a bare number is milliseconds).
   */
  mutable minTTL: Duration.Input
  /**
   * Default amount of time that objects stay in the cache when the origin
   * does not send `Cache-Control` or `Expires` headers (e.g. `"1 hour"`).
   */
  mutable defaultTTL?: Duration.Input
  /**
   * Maximum amount of time that objects stay in the cache (e.g. `"1 day"`).
   */
  mutable maxTTL?: Duration.Input
  /**
   * Controls which request values become part of the cache key and which
   * additional headers/cookies/query strings CloudFront forwards to the origin.
   */
  mutable parametersInCacheKeyAndForwardedToOrigin?: cloudfront.ParametersInCacheKeyAndForwardedToOrigin
}

export interface CachePolicy extends
  Resource<
    "AWS.CloudFront.CachePolicy",
    CachePolicyProps,
    {
      /**
       * CloudFront-assigned cache policy identifier.
       */
      mutable cachePolicyId: string
      /**
       * Name of the cache policy.
       */
      mutable name: string
      /**
       * Most recent entity tag for update/delete operations.
       */
      mutable etag: string | undefined
      /**
       * Current comment on the policy.
       */
      mutable comment: string | undefined
      /**
       * Current minimum TTL.
       */
      mutable minTTL: number
      /**
       * Current default TTL.
       */
      mutable defaultTTL: number | undefined
      /**
       * Current maximum TTL.
       */
      mutable maxTTL: number | undefined
      /**
       * Current cache-key/forwarded-value configuration.
       */
      mutable parametersInCacheKeyAndForwardedToOrigin:
        | cloudfront.ParametersInCacheKeyAndForwardedToOrigin
        | undefined
    },
    never,
    Providers
  >
{}

/**
 * A CloudFront cache policy.
 *
 * Cache policies determine the values CloudFront includes in the cache key,
 * the headers, cookies and query strings it forwards to the origin, and the
 * TTL bounds for cached responses. Policies are referenced by ID on a
 * Distribution's default behavior or per-path cache behaviors.
 *
 * For AWS-managed policies (CachingOptimized, CachingDisabled,
 * AllViewerExceptHostHeader) reference them by ID via the constants in
 * {@link ManagedPolicies} instead of creating a custom policy.
 * ### Creating Cache Policies
 * **Example:** Cache by query string and Authorization header
 * ```typescript
 * const cachePolicy = yield* CachePolicy("ApiCachePolicy", {
 *   comment: "Cache GETs by query string + Authorization",
 *   minTTL: 0,
 *   defaultTTL: "1 minute",
 *   maxTTL: "1 hour",
 *   parametersInCacheKeyAndForwardedToOrigin: {
 *     EnableAcceptEncodingGzip: true,
 *     EnableAcceptEncodingBrotli: true,
 *     HeadersConfig: {
 *       HeaderBehavior: "whitelist",
 *       Headers: { Quantity: 1, Items: ["Authorization"] },
 *     },
 *     CookiesConfig: { CookieBehavior: "none" },
 *     QueryStringsConfig: { QueryStringBehavior: "all" },
 *   },
 * });
 * ```
 *
 * @resource
 */
export const CachePolicy = Resource<CachePolicy>("AWS.CloudFront.CachePolicy")

export const CachePolicyProvider = (): infer _ =>
  Provider.effect(
    CachePolicy,
    effect {
      const getById = effect (id: string) => {
        const config = cloudfront
          .getCachePolicyConfig({ Id: id }) catch effect (e) => match (e) {
            when { _tag: "NoSuchCachePolicy" }: try Effect.undefined;
            default: throw e;
          }
        if (!config?.CachePolicyConfig) return undefined
        return { config: config.CachePolicyConfig, etag: config.ETag }
      }

      const getByName = effect (name: string) => {
        const listed = try cloudfront.listCachePolicies({ Type: "custom" })
        const summary = listed.CachePolicyList?.Items?.find(
          (item) => item.CachePolicy?.CachePolicyConfig?.Name === name,
        )
        if (!summary?.CachePolicy?.Id) return undefined
        return try effect {
          const found = try getById(summary.CachePolicy.Id)
          return (found ? { id: summary.CachePolicy.Id, ...found } : undefined)
        }
      }

      const buildConfig = (
        name: string,
        props: CachePolicyProps,
      ): cloudfront.CachePolicyConfig => ({
        Name: name,
        Comment: props.comment,
        MinTTL: toWireSeconds(props.minTTL)!,
        DefaultTTL: toWireSeconds(props.defaultTTL),
        MaxTTL: toWireSeconds(props.maxTTL),
        ParametersInCacheKeyAndForwardedToOrigin: props.parametersInCacheKeyAndForwardedToOrigin,
      })

      const toAttrs = (
        id: string,
        config: cloudfront.CachePolicyConfig,
        etag: string | undefined,
      ): infer _ => ({
        cachePolicyId: id,
        name: config.Name,
        etag,
        comment: config.Comment,
        minTTL: config.MinTTL,
        defaultTTL: config.DefaultTTL,
        maxTTL: config.MaxTTL,
        parametersInCacheKeyAndForwardedToOrigin: config.ParametersInCacheKeyAndForwardedToOrigin,
      })

      return {
        stables: ["cachePolicyId"],
        diff: effect ({ id, news, olds }) => {
          if (!isResolved(news)) return undefined
          if ((try createName(id, olds ?? {})) !== (try createName(id, news))) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          if (output?.cachePolicyId) {
            const found = try getById(output.cachePolicyId)
            if (found) return toAttrs(output.cachePolicyId, found.config, found.etag)
          }
          const name = try createName(id, olds ?? {})
          const found = try getByName(name)
          if (!found) return undefined
          return toAttrs(found.id, found.config, found.etag)
        },
        // CloudFront is global (no region). `listCachePolicies` returns both
        // AWS-managed and custom policies; we filter to `Type: "custom"` since
        // those are the only ones we create/delete. The op is marker-paginated
        // (no `.pages`), so we loop until `NextMarker` is exhausted and hydrate
        // each summary's ETag via `getById` so every row matches read().
        list: effect () => {
          const items: ReturnType<typeof toAttrs>[] = []
          let marker: string | undefined = undefined
          do {
            const listed: cloudfront.ListCachePoliciesResult = try cloudfront.listCachePolicies({
              Type: "custom",
              Marker: marker,
            })
            for (const summary of listed.CachePolicyList?.Items ?? []) {
              if (summary.Type !== "custom") continue
              const id = summary.CachePolicy?.Id
              const config = summary.CachePolicy?.CachePolicyConfig
              if (!id || !config) continue
              const found = try getById(id)
              items.push(toAttrs(id, found?.config ?? config, found?.etag))
            }
            marker = listed.CachePolicyList?.NextMarker
          } while (marker)
          return items
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)

          // Observe — locate the policy by id (cached on `output`) or by
          // name. Trust observed cloud state, not stale `olds`.
          let observed = output?.cachePolicyId
            ? try effect {
              const found = try getById(output.cachePolicyId)
              return (found ? { id: output.cachePolicyId, ...found } : undefined)
            }
            : undefined
          if (!observed) {
            observed = try getByName(name)
          }

          // Ensure — create the policy if it's missing. Tolerate
          // `CachePolicyAlreadyExists` as a race with a peer reconciler:
          // re-read by name and continue with the sync path.
          if (!observed) {
            const created = cloudfront
              .createCachePolicy({
                CachePolicyConfig: buildConfig(name, news),
              }) catch effect (e) => match (e) {
                when { _tag: "CachePolicyAlreadyExists" }: try effect {
                  const existing = try getByName(name)
                  return (existing
                    ? {
                      CachePolicy: {
                        Id: existing.id,
                        LastModifiedTime: new Date(),
                        CachePolicyConfig: existing.config,
                      },
                      ETag: existing.etag,
                      Location: undefined,
                    }
                    : throw new CachePolicyConflict({
                      message: `Cache policy '${name}' already exists but could not be recovered`,
                    }))
                };
                default: throw e;
              }
            if (!created.CachePolicy?.Id) {
              throw new CachePolicyUnexpectedResponse({
                message: "createCachePolicy returned no identifier",
              })
            }
            try session.note(created.CachePolicy.Id)
            return toAttrs(
              created.CachePolicy.Id,
              created.CachePolicy.CachePolicyConfig,
              created.ETag,
            )
          }

          // Sync — diff observed config against desired and patch via
          // `updateCachePolicy` with the freshly observed ETag.
          const desired = buildConfig(observed.config.Name, news)
          const updated = try cloudfront.updateCachePolicy({
            Id: observed.id,
            IfMatch: observed.etag,
            CachePolicyConfig: desired,
          })
          if (!updated.CachePolicy?.Id) {
            throw new CachePolicyUnexpectedResponse({
              message: "updateCachePolicy returned no identifier",
            })
          }
          try session.note(observed.id)
          return toAttrs(
            updated.CachePolicy.Id,
            updated.CachePolicy.CachePolicyConfig,
            updated.ETag,
          )
        },
        delete: effect ({ output }) => {
          const current = try getById(output.cachePolicyId)
          if (!current) return
          cloudfront
            .deleteCachePolicy({
              Id: output.cachePolicyId,
              IfMatch: current.etag,
            }) catch effect (e) => match (e) { when { _tag: "NoSuchCachePolicy" }: try Effect.void; default: throw e; }
        },
      }
    },
  )

const createName = effect (
  id: string,
  props: CachePolicyProps,
) => (props.name ? props.name : try createPhysicalName({ id, maxLength: 128, lowercase: true }))
