import * as quicksight from "@distilled.cloud/aws/quicksight"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import { AWSEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import { readQuickSightTags, syncQuickSightTags, toWireTags, waitForSettled } from "./internal.ts"

export error QuickSightDashboardUnexpectedResponse {
  message: string
  cause?: unknown
}

/**
 * Properties for an Amazon QuickSight dashboard — a published, read-only view
 * built from a template, an analysis, or an inline definition.
 */
export interface DashboardProps {
  /**
   * Unique id of the dashboard within the account. Stable — changing it
   * replaces the dashboard. If omitted, a unique id is generated.
   */
  mutable dashboardId?: string

  /**
   * Display name of the dashboard.
   */
  mutable name: string

  /**
   * Source of the dashboard content — a template or an existing analysis to
   * clone. Provide either `sourceEntity` or `definition`.
   */
  mutable sourceEntity?: quicksight.DashboardSourceEntity

  /**
   * Inline definition of the dashboard content. Provide either `definition`
   * or `sourceEntity`.
   */
  mutable definition?: quicksight.DashboardVersionDefinition

  /**
   * Parameters passed to the dashboard's datasets.
   */
  mutable parameters?: quicksight.Parameters

  /**
   * Resource-level permissions on the dashboard.
   */
  mutable permissions?: quicksight.ResourcePermission[]

  /**
   * Publish options (e.g. ad-hoc filtering, export to CSV).
   */
  mutable dashboardPublishOptions?: quicksight.DashboardPublishOptions

  /**
   * ARN of the theme applied to the dashboard.
   */
  mutable themeArn?: string

  /**
   * Description of the created/updated version.
   */
  mutable versionDescription?: string

  /**
   * Tags to apply to the dashboard.
   */
  mutable tags?: Record<string, string>
}

export interface Dashboard extends
  Resource<
    "AWS.QuickSight.Dashboard",
    DashboardProps,
    {
      /** Unique id of the dashboard within the account. */
      mutable dashboardId: string
      /** ARN of the dashboard. */
      mutable arn: string
      /** Display name of the dashboard. */
      mutable name: string
      /** Current version status (e.g. `CREATION_SUCCESSFUL`). */
      mutable status: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon QuickSight dashboard — a published, read-only view built from a
 * template, an analysis, or an inline definition.
 *
 * QuickSight requires an active account subscription in the region. Without
 * one, create operations fail with the typed `QuickSightSubscriptionRequired`
 * error.
 *
 * ### Creating a Dashboard
 * **Example:** Dashboard from a Template
 * ```typescript
 * const dashboard = yield* Dashboard("sales-overview", {
 *   name: "Sales Overview",
 *   sourceEntity: {
 *     SourceTemplate: {
 *       Arn: templateArn,
 *       DataSetReferences: [
 *         {
 *           DataSetPlaceholder: "sales",
 *           DataSetArn: dataset.arn,
 *         },
 *       ],
 *     },
 *   },
 * });
 * ```
 *
 * @resource
 */
export const Dashboard = Resource<Dashboard>("AWS.QuickSight.Dashboard")

export const DashboardProvider = (): infer _ =>
  Provider.effect(
    Dashboard,
    effect {
      const toId = effect (
        id: string,
        props: Partial<DashboardProps>,
      ) => (props.dashboardId ? props.dashboardId : try createPhysicalName({ id, maxLength: 64 }))

      const readDashboard = effect (accountId: string, dashboardId: string) => {
        const response = quicksight
          .describeDashboard({
            AwsAccountId: accountId,
            DashboardId: dashboardId,
          }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
            default: throw e;
          }
        return response?.Dashboard
      }

      const settle = (accountId: string, dashboardId: string) =>
        waitForSettled(
          dashboardId,
          effect {
            return try effect {
              const d = try readDashboard(accountId, dashboardId)
              return (d === undefined ? undefined : { ...d, status: d.Version?.Status })
            }
          },
        )

      const toAttrs = (dashboard: quicksight.Dashboard): infer _ => ({
        dashboardId: dashboard.DashboardId!,
        arn: dashboard.Arn!,
        name: dashboard.Name ?? "",
        status: dashboard.Version?.Status ?? "",
      })

      return Dashboard.Provider.of({
        stables: ["dashboardId", "arn"],

        diff: effect ({ id, olds = {}, news }) => {
          if (!isResolved(news)) return undefined
          if ((try toId(id, olds)) !== (try toId(id, news))) {
            return { action: "replace" } as const
          }
        },

        read: effect ({ id, olds = {}, output }) => {
          const { accountId } = try AWSEnvironment.current
          const dashboardId = output?.dashboardId ?? (try toId(id, olds))
          const dashboard = try readDashboard(accountId, dashboardId)
          if (dashboard === undefined) return undefined
          const attrs = toAttrs(dashboard)
          const tags = try readQuickSightTags(attrs.arn)
          return (try hasAlchemyTags(id, tags)) ? attrs : Unowned(attrs)
        },

        reconcile: effect ({ id, news, output, session }) => {
          const { accountId } = try AWSEnvironment.current
          const dashboardId = output?.dashboardId ?? (try toId(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // 1. Observe.
          let observed = try readDashboard(accountId, dashboardId)

          // 2. Ensure — create if missing.
          if (observed === undefined) {
            quicksight
              .createDashboard({
                AwsAccountId: accountId,
                DashboardId: dashboardId,
                Name: news.name,
                SourceEntity: news.sourceEntity,
                Definition: news.definition,
                Parameters: news.parameters,
                Permissions: news.permissions,
                DashboardPublishOptions: news.dashboardPublishOptions,
                ThemeArn: news.themeArn,
                VersionDescription: news.versionDescription,
                Tags: toWireTags(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "ResourceExistsException" }: try Effect.void;
                default: throw e;
              }
          } else {
            // 3. Sync — publish a new version.
            try quicksight.updateDashboard({
              AwsAccountId: accountId,
              DashboardId: dashboardId,
              Name: news.name,
              SourceEntity: news.sourceEntity,
              Definition: news.definition,
              Parameters: news.parameters,
              DashboardPublishOptions: news.dashboardPublishOptions,
              ThemeArn: news.themeArn,
              VersionDescription: news.versionDescription,
            })
          }

          observed = try settle(accountId, dashboardId)
          if (observed === undefined) {
            throw new QuickSightDashboardUnexpectedResponse({
              message: `QuickSight dashboard '${dashboardId}' not found after reconcile`,
            })
          }

          // 3b. Sync tags.
          try syncQuickSightTags(observed.Arn!, desiredTags)

          try session.note(dashboardId)
          return toAttrs(observed)
        },

        delete: effect ({ output }) => {
          const { accountId } = try AWSEnvironment.current
          quicksight
            .deleteDashboard({
              AwsAccountId: accountId,
              DashboardId: output.dashboardId,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
        },

        list: effect () => {
          const { accountId } = try AWSEnvironment.current
          return Array.from(
            try (quicksight.listDashboards.pages({ AwsAccountId: accountId })
              |> Stream.runCollect(%)),
          )
            .flatMap((page) => page.DashboardSummaryList ?? [])
            .flatMap((s) =>
              s.DashboardId !== undefined && s.Arn !== undefined
                ? [
                  {
                    dashboardId: s.DashboardId,
                    arn: s.Arn,
                    name: s.Name ?? "",
                    status: "",
                  },
                ]
                : []
            )
        },
      })
    },
  )
