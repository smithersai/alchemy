import * as iam from "@distilled.cloud/aws/iam"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, createTagsList, diffTags, hasTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import type { Providers } from "../Providers.ts"
import { parsePolicyDocument, stringifyPolicyDocument, toTagRecord } from "./common.vibe"
import type { PolicyDocument } from "./Policy.vibe"

export error UserConflict {
  message: string
  cause?: unknown
}

export interface UserProps {
  /**
   * User name. If omitted, a deterministic name is generated.
   */
  userName?: string
  /**
   * Optional IAM path prefix.
   * @default "/"
   */
  path?: string
  /**
   * Optional permissions boundary policy ARN.
   */
  permissionsBoundary?: string
  /**
   * Managed policy ARNs attached to the user.
   */
  managedPolicyArns?: string[]
  /**
   * Inline policies embedded in the user.
   */
  inlinePolicies?: Record<string, PolicyDocument>
  /**
   * User-defined tags to apply to the user.
   */
  tags?: Record<string, string>
}

export interface User extends
  Resource<
    "AWS.IAM.User",
    UserProps,
    {
      /** The ARN of the user. */
      userArn: string
      /** The name of the user. */
      userName: string
      /** The stable unique ID of the user. */
      userId: string | undefined
      /** The IAM path of the user. */
      path: string | undefined
      /** The managed policy ARN used as the permissions boundary, if any. */
      permissionsBoundary: string | undefined
      /** Managed policy ARNs attached to the user. */
      managedPolicyArns: string[]
      /** Inline policies embedded in the user, keyed by policy name. */
      inlinePolicies: Record<string, PolicyDocument>
      /** The tags applied to the user. */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An IAM user with optional inline policies, managed policies, and tags.
 *
 * `User` manages a long-lived IAM identity together with its attached managed
 * policies, inline policies, permissions boundary, and tags.
 * ### Creating IAM Users
 * **Example:** User with Managed Policies
 * ```typescript
 * const user = yield* User("AppUser", {
 *   userName: "app-user",
 *   managedPolicyArns: [
 *     "arn:aws:iam::aws:policy/ReadOnlyAccess",
 *   ],
 * });
 * ```
 *
 * @resource
 */
export const User = Resource<User>("AWS.IAM.User")

export const UserProvider = (): infer _ =>
  Provider.effect(
    User,
    effect {
      const toName = effect (
        id: string,
        props: UserProps,
      ) => (props.userName ? props.userName : try createPhysicalName({ id, maxLength: 64 }))

      const readManagedPolicies = effect (userName: string) => {
        const attached = Array.from(
          try (iam.listAttachedUserPolicies.items({ UserName: userName })
            |> Stream.runCollect(%)),
        )
        return attached
          .map((policy) => policy.PolicyArn)
          .filter((policyArn): policyArn is string => typeof policyArn === "string")
      }

      const readInlinePolicies = effect (userName: string) => {
        const policyNames = Array.from(
          try (iam.listUserPolicies.items({ UserName: userName })
            |> Stream.runCollect(%)),
        )
        const entries = try Effect.forEach(policyNames, effect (policyName) =>
          ([
            policyName,
            parsePolicyDocument(
              (try iam
                .getUserPolicy({
                  UserName: userName,
                  PolicyName: policyName,
                })).PolicyDocument,
            ),
          ] as const) catch effect (e) => match (e) {
            when { _tag: "NoSuchEntityException" }: [policyName, undefined] as const;
            default: throw e;
          })
        return Object.fromEntries(
          entries.filter((entry): entry is [string, PolicyDocument] => entry[1] !== undefined),
        )
      }

      const readTags = effect (userName: string) => {
        const listed = try iam.listUserTags({
          UserName: userName,
        })
        return toTagRecord(listed.Tags)
      }

      const syncManagedPolicies = effect ({
        userName,
        olds,
        news,
      }: {
        userName: string
        olds: string[]
        news: string[]
      }) => {
        const oldSet = new Set(olds)
        const newSet = new Set(news)
        for (const policyArn of news) {
          if (!oldSet.has(policyArn)) {
            try iam.attachUserPolicy({
              UserName: userName,
              PolicyArn: policyArn,
            })
          }
        }
        for (const policyArn of olds) {
          if (!newSet.has(policyArn)) {
            iam
              .detachUserPolicy({
                UserName: userName,
                PolicyArn: policyArn,
              }) catch effect (e) => match (e) {
                when { _tag: "NoSuchEntityException" }: try Effect.void;
                default: throw e;
              }
          }
        }
      }

      const syncInlinePolicies = effect ({
        userName,
        olds,
        news,
      }: {
        userName: string
        olds: Record<string, PolicyDocument>
        news: Record<string, PolicyDocument>
      }) => {
        for (const [policyName, document] of Object.entries(news)) {
          if (JSON.stringify(olds[policyName] ?? null) !== JSON.stringify(document)) {
            try iam.putUserPolicy({
              UserName: userName,
              PolicyName: policyName,
              PolicyDocument: stringifyPolicyDocument(document),
            })
          }
        }
        for (const policyName of Object.keys(olds)) {
          if (!(policyName in news)) {
            iam
              .deleteUserPolicy({
                UserName: userName,
                PolicyName: policyName,
              }) catch effect (e) => match (e) {
                when { _tag: "NoSuchEntityException" }: try Effect.void;
                default: throw e;
              }
          }
        }
      }

      return {
        stables: ["userArn", "userName", "userId"],
        list: effect () => {
          // IAM is global; `listUsers` enumerates every user in the
          // account. Paginate exhaustively, then hydrate each user's
          // managed/inline policies and tags (the list summary omits
          // them) to produce the same Attributes shape `read` returns.
          const users = Array.from(
            try (iam.listUsers.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) => page.Users ?? [])

          const hydrated = try Effect.forEach(
            users,
            effect (user) =>
              (try effect {
                const [managedPolicyArns, inlinePolicies, tags] = try Effect.all([
                  readManagedPolicies(user.UserName),
                  readInlinePolicies(user.UserName),
                  readTags(user.UserName),
                ])
                return {
                  userArn: user.Arn,
                  userName: user.UserName,
                  userId: user.UserId,
                  path: user.Path,
                  permissionsBoundary: user.PermissionsBoundary?.PermissionsBoundaryArn,
                  managedPolicyArns,
                  inlinePolicies,
                  tags,
                }
              }) catch effect (e) => match (e) {
                when { _tag: "NoSuchEntityException" }: try Effect.undefined;
                default: throw e;
              },
            { concurrency: 10 },
          )

          return hydrated.filter(
            (attrs): attrs is NonNullable<typeof attrs> => attrs !== undefined,
          )
        },
        diff: effect ({ id, olds, news }) => {
          if (!isResolved(news)) return
          if ((try toName(id, olds ?? ({} as UserProps))) !== (try toName(id, news))) {
            return { action: "replace" } as const
          }
          if ((olds?.path ?? "/") !== (news.path ?? "/")) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const userName = output?.userName ?? (try toName(id, olds ?? ({} as UserProps)))
          const response = iam
            .getUser({
              UserName: userName,
            }) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: try Effect.undefined;
              default: throw e;
            }
          if (!response?.User?.Arn) {
            return undefined
          }
          const [managedPolicyArns, inlinePolicies, tags] = try Effect.all([
            readManagedPolicies(userName),
            readInlinePolicies(userName),
            readTags(userName),
          ])
          return {
            userArn: response.User.Arn,
            userName: response.User.UserName,
            userId: response.User.UserId,
            path: response.User.Path,
            permissionsBoundary: response.User.PermissionsBoundary?.PermissionsBoundaryArn,
            managedPolicyArns,
            inlinePolicies,
            tags,
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          const userName = output?.userName ?? (try toName(id, news))
          const desiredTags = {
            ...(try createInternalTags(id)),
            ...news.tags,
          }

          // Observe — read the live user (or absence).
          const observedResponse = iam
            .getUser({ UserName: userName }) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: try Effect.undefined;
              default: throw e;
            }
          let observedUser = observedResponse?.User

          // Ensure — create the user when missing. On race, verify
          // ownership tags before adopting.
          if (!observedUser?.Arn) {
            const created = iam
              .createUser({
                UserName: userName,
                Path: news.path,
                PermissionsBoundary: news.permissionsBoundary,
                Tags: createTagsList(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "EntityAlreadyExistsException" }: try (iam.getUser({ UserName: userName })
                  |> Effect.filterOrFail(%, (existing) =>
                    hasTags(desiredTags, existing.User?.Tags), () =>
                    new UserConflict({
                      message: `User '${userName}' already exists and is not managed by alchemy`,
                    })));
                default: throw e;
              }
            observedUser = created.User
          }

          // Sync permissions boundary against observed.
          const observedBoundary = observedUser?.PermissionsBoundary?.PermissionsBoundaryArn
          if (news.permissionsBoundary !== observedBoundary) {
            if (news.permissionsBoundary) {
              try iam.putUserPermissionsBoundary({
                UserName: userName,
                PermissionsBoundary: news.permissionsBoundary,
              })
            } else if (observedBoundary) {
              iam
                .deleteUserPermissionsBoundary({
                  UserName: userName,
                }) catch effect (e) => match (e) {
                  when { _tag: "NoSuchEntityException" }: try Effect.void;
                  default: throw e;
                }
            }
          }

          // Sync managed and inline policies — observe live state and
          // apply only the delta.
          const [observedManagedPolicies, observedInlinePolicies] = try Effect.all([
            readManagedPolicies(userName),
            readInlinePolicies(userName),
          ])
          try syncManagedPolicies({
            userName,
            olds: observedManagedPolicies,
            news: news.managedPolicyArns ?? [],
          })
          try syncInlinePolicies({
            userName,
            olds: observedInlinePolicies,
            news: news.inlinePolicies ?? {},
          })

          // Sync tags against the cloud's actual tags.
          const observedTags = try readTags(userName)
          const { removed, upsert } = diffTags(observedTags, desiredTags)
          if (upsert.length > 0) {
            try iam.tagUser({
              UserName: userName,
              Tags: upsert,
            })
          }
          if (removed.length > 0) {
            try iam.untagUser({
              UserName: userName,
              TagKeys: removed,
            })
          }

          // Re-read for fresh attributes after all mutations.
          const user = try iam.getUser({ UserName: userName })
          const userArn = user.User?.Arn ?? observedUser?.Arn ?? userName

          try session.note(userArn)
          return {
            userArn,
            userName: user.User?.UserName ?? userName,
            userId: user.User?.UserId ?? observedUser?.UserId,
            path: user.User?.Path ?? observedUser?.Path ?? news.path ?? "/",
            permissionsBoundary: user.User?.PermissionsBoundary?.PermissionsBoundaryArn ?? news.permissionsBoundary,
            managedPolicyArns: news.managedPolicyArns ?? [],
            inlinePolicies: news.inlinePolicies ?? {},
            tags: desiredTags,
          }
        },
        delete: effect ({ output }) => {
          iam
            .deleteUserPermissionsBoundary({
              UserName: output.userName,
            }) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: try Effect.void;
              default: throw e;
            }
          ;(try (iam.listUserPolicies.items({ UserName: output.userName })
            |> Stream.mapEffect(%, effect (policyName) =>
              iam
                .deleteUserPolicy({
                  UserName: output.userName,
                  PolicyName: policyName,
                }) catch effect (e) => match (e) {
                  when { _tag: "NoSuchEntityException" }: try Effect.void;
                  default: throw e;
                })
            |> Stream.runDrain(%))) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: try Effect.void;
              default: throw e;
            }
          ;(try (iam.listAttachedUserPolicies.items({ UserName: output.userName })
            |> Stream.mapEffect(%, effect (policy) => (policy.PolicyArn
              ? iam
                .detachUserPolicy({
                  UserName: output.userName,
                  PolicyArn: policy.PolicyArn,
                }) catch effect (e) => match (e) {
                  when { _tag: "NoSuchEntityException" }: try Effect.void;
                  default: throw e;
                }
              : try Effect.void))
            |> Stream.runDrain(%))) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: try Effect.void;
              default: throw e;
            }

          iam
            .deleteUser({
              UserName: output.userName,
            }) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: try Effect.void;
              default: throw e;
            }
        },
      }
    },
  )
