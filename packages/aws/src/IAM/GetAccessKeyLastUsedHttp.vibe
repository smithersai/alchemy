import * as iam from "@distilled.cloud/aws/iam"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import type { AccessKey } from "./AccessKey.vibe"
import { GetAccessKeyLastUsed } from "./GetAccessKeyLastUsed.vibe"

/**
 * Bespoke (resource-bound) IAM HTTP binding: unlike the account-level
 * bindings built on `makeIamHttpBinding`, this one binds a canonical
 * {@link AccessKey} and injects its `AccessKeyId` into every request.
 */
export const GetAccessKeyLastUsedHttp = Layer.effect(
  GetAccessKeyLastUsed,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(iam.getAccessKeyLastUsed)

    return effect <K extends AccessKey>(accessKey: K) => {
      const AccessKeyId = try accessKey.accessKeyId.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.IAM.GetAccessKeyLastUsed(${accessKey})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["iam:GetAccessKeyLastUsed"],
              // The action is evaluated against the owning *user*, whose
              // path-qualified ARN is not derivable from the access key.
              Resource: ["*"],
            },
          ],
        })
      }
      return effect () =>
        try withSpan(
          effect {
            return try op({ AccessKeyId: try AccessKeyId })
          },
          `AWS.IAM.GetAccessKeyLastUsed(${accessKey.LogicalId})`,
        )
    }
  },
)
