import * as iam from "@distilled.cloud/aws/iam"
import { isResolved } from "alchemy/Diff"
import type { Input } from "alchemy/Input"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, createTagsList, diffTags, hasTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { toTagRecord } from "./common.vibe"

export error InstanceProfileConflict {
  message: string
  cause?: unknown
}

export error InstanceProfileUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface InstanceProfileProps {
  /**
   * Name of the instance profile. If omitted, a deterministic name is generated.
   */
  instanceProfileName?: string
  /**
   * Optional IAM path prefix.
   * @default "/"
   */
  path?: string
  /**
   * Optional role attached to the instance profile.
   */
  roleName?: Input<string>
  /**
   * User-defined tags to apply to the instance profile.
   */
  tags?: Record<string, string>
}

export interface InstanceProfile extends
  Resource<
    "AWS.IAM.InstanceProfile",
    InstanceProfileProps,
    {
      /** The ARN of the instance profile. */
      instanceProfileArn: string
      /** The name of the instance profile. */
      instanceProfileName: string
      /** The stable unique ID of the instance profile. */
      instanceProfileId: string | undefined
      /** The IAM path of the instance profile. */
      path: string | undefined
      /** The role attached to the instance profile, if any. */
      roleName: string | undefined
      /** The tags applied to the instance profile. */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An IAM instance profile that can present a role to EC2 instances.
 *
 * `InstanceProfile` bridges IAM roles into EC2 so compute instances can assume
 * the attached role through the instance metadata service.
 * ### Attaching Roles to EC2
 * **Example:** Create an Instance Profile
 * ```typescript
 * const role = yield* Role("InstanceRole", {
 *   assumeRolePolicyDocument: {
 *     Version: "2012-10-17",
 *     Statement: [{
 *       Effect: "Allow",
 *       Principal: { Service: "ec2.amazonaws.com" },
 *       Action: ["sts:AssumeRole"],
 *     }],
 *   },
 * });
 *
 * const profile = yield* InstanceProfile("WebProfile", {
 *   roleName: role.roleName,
 * });
 * ```
 *
 * @resource
 */
export const InstanceProfile = Resource<InstanceProfile>("AWS.IAM.InstanceProfile")

export const InstanceProfileProvider = (): infer _ =>
  Provider.effect(
    InstanceProfile,
    effect {
      const toName = effect (
        id: string,
        props: InstanceProfileProps,
      ) => (props.instanceProfileName ? props.instanceProfileName : try createPhysicalName({ id, maxLength: 128 }))

      const readInstanceProfile = effect (name: string) => {
        const response = iam
          .getInstanceProfile({
            InstanceProfileName: name,
          }) catch effect (e) => match (e) {
            when { _tag: "NoSuchEntityException" }: undefined;
            default: throw e;
          }
        return response?.InstanceProfile
      }

      const syncRole = effect ({
        profileName,
        currentRoleName,
        nextRoleName,
      }: {
        profileName: string
        currentRoleName: string | undefined
        nextRoleName: string | undefined
      }) => {
        if (currentRoleName && currentRoleName !== nextRoleName) {
          iam
            .removeRoleFromInstanceProfile({
              InstanceProfileName: profileName,
              RoleName: currentRoleName,
            }) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: (undefined as void);
              default: throw e;
            }
        }
        if (nextRoleName && currentRoleName !== nextRoleName) {
          try iam.addRoleToInstanceProfile({
            InstanceProfileName: profileName,
            RoleName: nextRoleName,
          })
        }
      }

      return {
        stables: ["instanceProfileArn", "instanceProfileName", "instanceProfileId"],
        diff: effect ({ id, olds, news }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return
          if (
            (try toName(id, olds ?? ({} as InstanceProfileProps))) !== (try toName(id, resolved))
          ) {
            return { action: "replace" } as const
          }
          if ((olds?.path ?? "/") !== (resolved.path ?? "/")) {
            return { action: "replace" } as const
          }
        },
        // IAM is global; `listInstanceProfiles` enumerates every instance
        // profile in the account. Paginate exhaustively and map each item to
        // the same Attributes shape `read` produces.
        list: effect () =>
          Array.from(
            try (iam.listInstanceProfiles.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.InstanceProfiles ?? []).map((profile) => ({
              instanceProfileArn: profile.Arn,
              instanceProfileName: profile.InstanceProfileName,
              instanceProfileId: profile.InstanceProfileId as string | undefined,
              path: profile.Path as string | undefined,
              roleName: profile.Roles?.[0]?.RoleName,
              tags: toTagRecord(profile.Tags),
            }))
          ),
        read: effect ({ id, olds, output }) => {
          const name = output?.instanceProfileName
            ?? (try toName(id, olds ?? ({} as InstanceProfileProps)))
          const profile = try readInstanceProfile(name)
          if (!profile?.Arn || !profile.InstanceProfileName) {
            return undefined
          }
          return {
            instanceProfileArn: profile.Arn,
            instanceProfileName: profile.InstanceProfileName,
            instanceProfileId: profile.InstanceProfileId,
            path: profile.Path,
            roleName: profile.Roles?.[0]?.RoleName,
            tags: toTagRecord(profile.Tags),
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = output?.instanceProfileName ?? (try toName(id, news))
          const desiredTags = {
            ...(try createInternalTags(id)),
            ...news.tags,
          }

          // Observe — fetch the live instance profile (or absence).
          let profile = try readInstanceProfile(name)

          // Ensure — create the profile when it is missing. Tolerate races
          // and surface a clear error when an unrelated foreign profile
          // already owns the name.
          if (!profile?.Arn) {
            iam
              .createInstanceProfile({
                InstanceProfileName: name,
                Path: news.path,
                Tags: createTagsList(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "EntityAlreadyExistsException" }: try effect {
                  const existing = try readInstanceProfile(name)
                  if (!existing?.Arn) {
                    throw new InstanceProfileConflict({
                      message: `Instance profile '${name}' already exists but could not be described`,
                    })
                  }
                  if (
                    !(try Effect.orDie(
                      Effect.try({ try: () => hasTags(desiredTags, existing.Tags), catch: (e) => e }),
                    ))
                  ) {
                    throw new InstanceProfileConflict({
                      message: `Instance profile '${name}' already exists and is not managed by alchemy`,
                    })
                  }
                };
                default: throw e;
              }
            profile = try readInstanceProfile(name)
            if (!profile?.Arn || !profile.InstanceProfileName) {
              throw new InstanceProfileUnexpectedResponse({
                message: `Instance profile '${name}' was not readable after create`,
              })
            }
          }

          // Sync role attachment — diff the observed role on the profile
          // against the desired role and only swap when they differ.
          const observedRoleName = profile.Roles?.[0]?.RoleName
          const desiredRoleName = news.roleName as string | undefined
          try syncRole({
            profileName: name,
            currentRoleName: observedRoleName,
            nextRoleName: desiredRoleName,
          })

          // Sync tags — use the cloud's actual tags as the baseline so
          // adoption / out-of-band tag changes converge correctly.
          const observedTags = toTagRecord(profile.Tags)
          const { removed, upsert } = try Effect.orDie(
            Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }),
          )
          if (upsert.length > 0) {
            try iam.tagInstanceProfile({
              InstanceProfileName: name,
              Tags: upsert,
            })
          }
          if (removed.length > 0) {
            try iam.untagInstanceProfile({
              InstanceProfileName: name,
              TagKeys: removed,
            })
          }

          // Re-read for fresh attributes (the profile's `Roles` array
          // changes after `syncRole`).
          const fresh = try readInstanceProfile(name)
          if (!fresh?.Arn || !fresh.InstanceProfileName) {
            throw new InstanceProfileUnexpectedResponse({
              message: `Instance profile '${name}' was not readable after sync`,
            })
          }

          try session.note(fresh.Arn)
          return {
            instanceProfileArn: fresh.Arn,
            instanceProfileName: fresh.InstanceProfileName,
            instanceProfileId: fresh.InstanceProfileId,
            path: fresh.Path,
            roleName: fresh.Roles?.[0]?.RoleName,
            tags: desiredTags,
          }
        },
        delete: effect ({ output }) => {
          const profile = try readInstanceProfile(output.instanceProfileName)
          for (const role of profile?.Roles ?? []) {
            if (role.RoleName) {
              iam
                .removeRoleFromInstanceProfile({
                  InstanceProfileName: output.instanceProfileName,
                  RoleName: role.RoleName,
                }) catch effect (e) => match (e) {
                  when { _tag: "NoSuchEntityException" }: (undefined as void);
                  default: throw e;
                }
            }
          }
          iam
            .deleteInstanceProfile({
              InstanceProfileName: output.instanceProfileName,
            }) catch effect (e) => match (e) {
              when { _tag: "NoSuchEntityException" }: (undefined as void);
              default: throw e;
            }
        },
      }
    },
  )
