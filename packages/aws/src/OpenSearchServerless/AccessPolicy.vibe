import * as Effect from "effect/Effect"
import * as aoss from "@distilled.cloud/aws/opensearchserverless"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.vibe"
import { canonicalizePolicy, retryWhileConflict, stringifyPolicy } from "./internal.vibe"
import type { SecurityPolicyDocument } from "./SecurityPolicy.vibe"

export interface AccessPolicyProps {
  /**
   * Name of the data access policy (3-32 characters, lowercase). Changing the
   * name replaces the policy.
   * @default a generated physical name
   */
  policyName?: string
  /**
   * The data access policy document — a JSON array of rules granting principals
   * (IAM roles/users) collection- and index-level permissions such as
   * `aoss:CreateIndex`, `aoss:ReadDocument`, `aoss:WriteDocument`. Supply an
   * array/object or a pre-serialized string.
   */
  policy: SecurityPolicyDocument
  /**
   * A human-readable description of the policy.
   */
  description?: string
}

export interface AccessPolicy extends
  Resource<
    "AWS.OpenSearchServerless.AccessPolicy",
    AccessPolicyProps,
    {
      /**
       * Name of the access policy.
       */
      policyName: string
      /**
       * Policy type (`data`).
       */
      type: string
      /**
       * Version of the policy, used for optimistic-concurrency updates.
       */
      policyVersion: string
      /**
       * Description of the access policy.
       */
      description?: string
    },
    {},
    Providers
  >
{}

/**
 * An Amazon OpenSearch Serverless data access policy. Data access policies
 * grant IAM principals fine-grained permissions on collections and their
 * indexes (create/read/write/delete documents, create indexes, etc.) — they
 * are the data-plane authorization layer that complements the network and
 * encryption {@link SecurityPolicy | security policies}.
 *
 * A Bedrock Knowledge Base backed by an OpenSearch Serverless collection
 * requires a data access policy granting the Knowledge Base's service role
 * `aoss:APIAccessAll` on the collection and its indexes.
 *
 * ### Creating Access Policies
 * **Example:** Grant a Role Full Data Access
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 *
 * const access = yield* AWS.OpenSearchServerless.AccessPolicy("Access", {
 *   policyName: "my-collection-access",
 *   policy: [
 *     {
 *       Rules: [
 *         {
 *           ResourceType: "collection",
 *           Resource: ["collection/my-collection"],
 *           Permission: ["aoss:*"],
 *         },
 *         {
 *           ResourceType: "index",
 *           Resource: ["index/my-collection/*"],
 *           Permission: ["aoss:*"],
 *         },
 *       ],
 *       Principal: ["arn:aws:iam::123456789012:role/my-role"],
 *     },
 *   ],
 * });
 * ```
 *
 * @resource
 */
export const AccessPolicy = Resource<AccessPolicy>("AWS.OpenSearchServerless.AccessPolicy")

// OpenSearch Serverless only defines the "data" access-policy type.
const ACCESS_POLICY_TYPE = "data"

export const AccessPolicyProvider = (): infer _ =>
  Provider.effect(
    AccessPolicy,
    effect {
      const createName = effect (
        id: string,
        props: { policyName?: string | undefined },
      ) => (
        props.policyName ?? (try createPhysicalName({ id, maxLength: 32, lowercase: true }))
      )

      const toAttributes = (detail: aoss.AccessPolicyDetail): infer _ => ({
        policyName: detail.name!,
        type: detail.type!,
        policyVersion: detail.policyVersion!,
        description: detail.description,
      })

      return AccessPolicy.Provider.of({
        stables: ["policyName", "type"],

        list: effect () => {
          const pages = try aoss.listAccessPolicies
            .pages({ type: ACCESS_POLICY_TYPE })
            .pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.accessPolicySummaries ?? [])
            .filter(
              (s) => s.name !== undefined && s.type !== undefined && s.policyVersion !== undefined,
            )
            .map((s) => ({
              policyName: s.name!,
              type: s.type!,
              policyVersion: s.policyVersion!,
              description: s.description,
            }))
        },

        read: effect ({ id, olds, output }) => {
          const name = output?.policyName ?? (try createName(id, olds ?? {}))
          const found = aoss
            .getAccessPolicy({ type: ACCESS_POLICY_TYPE, name }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined;
              default: throw e;
            }
          if (found?.accessPolicyDetail === undefined) {
            return undefined
          }
          // Access policies carry no tags, so an existing same-name policy is
          // adopted.
          return toAttributes(found.accessPolicyDetail)
        },

        diff: effect ({ id, news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (oldName !== newName) {
            return { action: "replace" } as const
          }
          // description/policy fall through to the default update path
        },

        reconcile: effect ({ id, news, output, session }) => {
          const name = output?.policyName ?? (try createName(id, news))
          const policy = stringifyPolicy(news.policy)

          // 1. OBSERVE
          let detail = (effect {
            return (try aoss.getAccessPolicy({ type: ACCESS_POLICY_TYPE, name })).accessPolicyDetail
          }) catch effect (
            e,
          ) => match (e) { when { _tag: "ResourceNotFoundException" }: undefined; default: throw e; }

          // 2. ENSURE
          if (detail === undefined) {
            detail = (effect {
              return (try aoss
                .createAccessPolicy({
                  type: ACCESS_POLICY_TYPE,
                  name,
                  policy,
                  description: news.description,
                })).accessPolicyDetail
            }) catch effect (e) => match (e) {
              when { _tag: "ConflictException" }: (try aoss
                .getAccessPolicy({ type: ACCESS_POLICY_TYPE, name })).accessPolicyDetail;
              default: throw e;
            }
          } else {
            // 3. SYNC
            const policyDrift = canonicalizePolicy(detail.policy) !== canonicalizePolicy(policy)
            const descriptionDrift = news.description !== undefined && news.description !== detail.description
            if (policyDrift || descriptionDrift) {
              detail = (try aoss
                .updateAccessPolicy({
                  type: ACCESS_POLICY_TYPE,
                  name,
                  policyVersion: detail.policyVersion!,
                  policy: policyDrift ? policy : undefined,
                  description: descriptionDrift ? news.description : undefined,
                })).accessPolicyDetail
            }
          }

          if (detail?.name === undefined) {
            throw try Effect.orDie(Effect.try({
              try: () =>
                aoss.ResourceNotFoundException.make({
                  message: `access policy ${name} not visible after reconcile`,
                }),
              catch: (e) => e,
            }))
          }
          try session.note(name)
          return toAttributes(detail)
        },

        delete: effect ({ output }) => {
          retryWhileConflict(
            aoss.deleteAccessPolicy({
              type: ACCESS_POLICY_TYPE,
              name: output.policyName,
            }),
          ) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: undefined as void;
            default: throw e;
          }
        },
      })
    },
  )
