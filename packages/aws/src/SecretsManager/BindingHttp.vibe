import * as Effect from "effect/Effect"
import * as AWSBindings from "../AWSBindings.ts"
import type { Secret } from "./Secret.vibe"

/**
 * Shared scaffolding for the AWS Secrets Manager HTTP bindings.
 *
 * NOT exported from `index.ts` — every thin `{Op}Http.ts` in this service is
 * a `Layer.effect(Cap, make…HttpBinding({ … }))` over one of the two builders
 * below. Everything except the operation and the IAM action list is
 * boilerplate.
 */

/**
 * Build the impl Effect for a Secrets Manager operation scoped to a bound
 * {@link Secret}: the deploy-time half grants `actions` on the secret's ARN,
 * and the runtime half injects the secret ARN as `SecretId` into every
 * request.
 */
export const makeSecretHttpBinding = effect <I extends { SecretId?: string }, A, E, R>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.SecretsManager.GetSecretValue`. */
  tag: string
  /** The distilled operation. */
  operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the bound secret. */
  actions: readonly `secretsmanager:${string}`[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (secret: Secret) => {
    const SecretId = try secret.secretArn.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${secret})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [secret.secretArn],
          },
        ],
      })
    }
    return effect (
      request?: Omit<I, "SecretId"> | undefined,
    ) =>
      try withSpan(
        effect {
          const secretId = try SecretId
          return try op({ ...request, SecretId: secretId } as I)
        },
        `${options.tag}(${secret.LogicalId})`,
      )
  }
}

/**
 * Build the impl Effect for an account-level Secrets Manager operation that
 * is not scoped to a secret (e.g. `secretsmanager:GetRandomPassword`,
 * `secretsmanager:ListSecrets`). The deploy-time half grants `actions` on
 * `*`.
 */
export const makeSecretsManagerAccountHttpBinding = effect <I, A, E, R>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.SecretsManager.ListSecrets`. */
  tag: string
  /** The distilled operation, invoked with the caller's request as-is. */
  operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on `*`. */
  actions: readonly `secretsmanager:${string}`[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect () => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}()`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: ["*"],
          },
        ],
      })
    }
    return effect (request?: I | undefined) =>
      try withSpan(
        effect {
          return try op((request ?? {}) as I)
        },
        options.tag,
      )
  }
}
