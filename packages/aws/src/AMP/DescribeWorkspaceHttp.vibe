import * as amp from "@distilled.cloud/aws/amp"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { DescribeWorkspace } from "./DescribeWorkspace.ts"
import type { Workspace } from "./Workspace.ts"

export const DescribeWorkspaceHttp = Layer.effect(
  DescribeWorkspace,
  effect {
    const bind = try AWSBindings.Bind
    const describeWorkspace = try AWSBindings.withCredentials(amp.describeWorkspace)

    return effect (workspace: Workspace) => {
      const WorkspaceId = try workspace.workspaceId.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.AMP.DescribeWorkspace(${workspace})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["aps:DescribeWorkspace"],
              Resource: [workspace.workspaceArn],
            },
          ],
        })
      }
      return effect () =>
        try withSpan(
          effect {
            return try describeWorkspace({
              workspaceId: try WorkspaceId,
            })
          },
          `AWS.AMP.DescribeWorkspace(${workspace.LogicalId})`,
        )
    }
  },
)
