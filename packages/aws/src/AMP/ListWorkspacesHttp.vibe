import * as amp from "@distilled.cloud/aws/amp"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { ListWorkspaces, type ListWorkspacesRequest } from "./ListWorkspaces.ts"

export const ListWorkspacesHttp = Layer.effect(
  ListWorkspaces,
  effect {
    const bind = try AWSBindings.Bind
    const listWorkspaces = try AWSBindings.withCredentials(amp.listWorkspaces)

    return effect () => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.AMP.ListWorkspaces()`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["aps:ListWorkspaces"],
              Resource: ["*"],
            },
          ],
        })
      }
      return effect (request?: ListWorkspacesRequest | undefined) =>
        try withSpan(
          effect {
            return try listWorkspaces(request ?? {})
          },
          "AWS.AMP.ListWorkspaces",
        )
    }
  },
)
