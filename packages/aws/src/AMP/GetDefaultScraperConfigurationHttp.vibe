import * as amp from "@distilled.cloud/aws/amp"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { GetDefaultScraperConfiguration } from "./GetDefaultScraperConfiguration.ts"
import { decodeDefinition } from "./internal.vibe"

export const GetDefaultScraperConfigurationHttp = Layer.effect(
  GetDefaultScraperConfiguration,
  effect {
    const bind = try AWSBindings.Bind
    const getDefaultScraperConfiguration = try AWSBindings.withCredentials(
      amp.getDefaultScraperConfiguration,
    )

    return effect () => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.AMP.GetDefaultScraperConfiguration()`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["aps:GetDefaultScraperConfiguration"],
              Resource: ["*"],
            },
          ],
        })
      }
      return effect () =>
        try withSpan(
          effect {
            const response = try getDefaultScraperConfiguration({})
            return try decodeDefinition(response.configuration)
          },
          "AWS.AMP.GetDefaultScraperConfiguration",
        )
    }
  },
)
