import * as deadline from "@distilled.cloud/aws/deadline"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags, type Tags } from "alchemy/Tags"
import * as EffectStream from "effect/Stream"
import type { Providers } from "../Providers.vibe"
import {
  asPlain,
  deadlineArnOf,
  fetchDeadlineTags,
  reapDeadlineLogGroups,
  retryWhileConflict,
  retryWhileFarmSettling,
  syncDeadlineTags,
} from "./internal.ts"

export error QueueInvalidProps {
  message: string
  cause?: unknown
}

export error QueueUnexpectedResponse {
  message: string
  cause?: unknown
}

export type QueueStatus = deadline.QueueStatus
export type DefaultQueueBudgetAction = deadline.DefaultQueueBudgetAction

export interface QueueProps {
  /**
   * The identifier of the farm the queue belongs to. Changing it replaces
   * the queue.
   */
  mutable farmId: string
  /**
   * Display name of the queue.
   * @default ${app}-${stage}-${id}
   */
  mutable displayName?: string
  /**
   * A description of the queue.
   */
  mutable description?: string
  /**
   * Action taken on jobs in the queue when its associated budget is
   * exhausted (`NONE`, `STOP_SCHEDULING_AND_COMPLETE_TASKS`,
   * `STOP_SCHEDULING_AND_CANCEL_TASKS`).
   * @default "NONE"
   */
  mutable defaultBudgetAction?: DefaultQueueBudgetAction
  /**
   * S3 bucket and root prefix used for job attachments.
   */
  mutable jobAttachmentSettings?: deadline.JobAttachmentSettings
  /**
   * ARN of the IAM role workers assume while running this queue's jobs.
   */
  mutable roleArn?: string
  /**
   * The OS user/group jobs run as on workers.
   */
  mutable jobRunAsUser?: deadline.JobRunAsUser
  /**
   * Names of file system locations (from storage profiles) that must be
   * present on a worker for it to pick up this queue's jobs.
   */
  mutable requiredFileSystemLocationNames?: string[]
  /**
   * Storage profile IDs allowed to be used with the queue.
   */
  mutable allowedStorageProfileIds?: string[]
  /**
   * How the queue orders and schedules its jobs.
   */
  mutable schedulingConfiguration?: deadline.SchedulingConfiguration
  /**
   * Tags to associate with the queue.
   */
  mutable tags?: Record<string, string>
}

export interface Queue extends
  Resource<
    "AWS.Deadline.Queue",
    QueueProps,
    {
      /**
       * The identifier of the farm the queue belongs to.
       */
      mutable farmId: string
      /**
       * Service-assigned unique identifier of the queue (`queue-...`).
       */
      mutable queueId: string
      /**
       * ARN of the queue.
       */
      mutable queueArn: string
      /**
       * The queue's display name.
       */
      mutable displayName: string
      /**
       * Current scheduling status of the queue.
       */
      mutable status: QueueStatus
      /**
       * The configured default budget action.
       */
      mutable defaultBudgetAction: DefaultQueueBudgetAction
      /**
       * ARN of the queue's job role, when configured.
       */
      mutable roleArn: string | undefined
      /**
       * Current tags reported for the queue.
       */
      mutable tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An AWS Deadline Cloud queue — accepts render jobs within a farm and
 * schedules them onto associated fleets.
 *
 * ### Creating Queues
 * **Example:** Basic Queue
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 *
 * const farm = yield* AWS.Deadline.Farm("RenderFarm", {});
 * const queue = yield* AWS.Deadline.Queue("RenderQueue", {
 *   farmId: farm.farmId,
 * });
 * ```
 *
 * **Example:** Queue with Job Attachments and Role
 * ```typescript
 * const queue = yield* AWS.Deadline.Queue("RenderQueue", {
 *   farmId: farm.farmId,
 *   roleArn: queueRole.roleArn,
 *   defaultBudgetAction: "STOP_SCHEDULING_AND_COMPLETE_TASKS",
 *   jobAttachmentSettings: {
 *     s3BucketName: bucket.bucketName,
 *     rootPrefix: "attachments/",
 *   },
 * });
 * ```
 *
 * @resource
 */
export const Queue = Resource<Queue>("AWS.Deadline.Queue")

const createQueueName = effect (
  id: string,
  props: { mutable displayName?: string | undefined },
) => (props.displayName ? props.displayName : try createPhysicalName({ id, maxLength: 100 }))

interface QueueState {
  mutable attrs: Queue["Attributes"]
  mutable described: deadline.GetQueueResponse
}

const readQueueById = effect (
  farmId: string,
  queueId: string,
  arnOf: (path: string) => string,
) => {
  const described = deadline
    .getQueue({ farmId, queueId }) catch effect (e) => match (e) {
      when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
      default: throw e;
    }
  if (!described) return undefined
  const queueArn = arnOf(`farm/${described.farmId}/queue/${described.queueId}`)
  const state: QueueState = {
    described,
    attrs: {
      farmId: described.farmId,
      queueId: described.queueId,
      queueArn,
      displayName: described.displayName,
      status: described.status,
      defaultBudgetAction: described.defaultBudgetAction,
      roleArn: described.roleArn,
      tags: try fetchDeadlineTags(queueArn),
    },
  }
  return state
}

const findQueueByDisplayName = effect (
  farmId: string,
  displayName: string,
  arnOf: (path: string) => string,
) => {
  const summaries = (Array.from(
    try (deadline.listQueues.items({ farmId })
      |> EffectStream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "ResourceNotFoundException" }: [] as deadline.QueueSummary[];
    default: throw e;
  }
  const match = summaries.find((summary) => summary.displayName === displayName)
  if (!match) return undefined
  return try readQueueById(farmId, match.queueId, arnOf)
}

/**
 * A queue still present after delete was initiated — retried by the bounded
 * wait-until-gone schedule.
 */
error QueueStillExists {
  queueId: string
}

const retryWhileStillExists = effect <A, E extends { readonly _tag: string }, R>(
  self: A!E!R,
): A!E!R =>
  try Effect.retry(self, {
    while: (e) => e._tag === "QueueStillExists",
    schedule: Schedule.max([Schedule.spaced("6 seconds"), Schedule.recurs(9)]),
  })

const stringSetDelta = (observed: readonly string[], desired: readonly string[]): infer _ => ({
  toAdd: desired.filter((value) => !observed.includes(value)),
  toRemove: observed.filter((value) => !desired.includes(value)),
})

export const QueueProvider = (): infer _ =>
  Provider.effect(
    Queue,
    effect {
      return {
        stables: ["farmId", "queueId", "queueArn"],
        // Keyed by a parent farm; cannot be enumerated account-wide without
        // iterating every farm — treated as a sub-resource per the factory
        // list() convention.
        list: effect () => [],
        read: effect ({ id, olds, output }) => {
          const arnOf = try deadlineArnOf
          const farmId = output?.farmId ?? olds?.farmId
          if (farmId === undefined) return undefined
          const state = output?.queueId
            ? try readQueueById(farmId, output.queueId, arnOf)
            : try findQueueByDisplayName(farmId, try createQueueName(id, olds ?? {}), arnOf)
          if (!state) return undefined
          return (try hasAlchemyTags(id, state.attrs.tags as Tags))
            ? state.attrs
            : Unowned(state.attrs)
        },
        diff: effect ({ news, olds }) => {
          if (!isResolved(news)) return
          if (olds === undefined) return
          // The parent farm is fixed at creation.
          if (olds.farmId !== news.farmId) {
            return { action: "replace" } as const
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          if (news === undefined) {
            throw new QueueInvalidProps({ message: "AWS.Deadline.Queue requires props" })
          }
          const arnOf = try deadlineArnOf
          const farmId = news.farmId
          const displayName = try createQueueName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // Observe.
          let state = output?.queueId
            ? try readQueueById(farmId, output.queueId, arnOf)
            : try findQueueByDisplayName(farmId, displayName, arnOf)

          // Ensure.
          if (state === undefined) {
            const created = try retryWhileFarmSettling(
              deadline.createQueue({
                farmId,
                displayName,
                description: news.description,
                defaultBudgetAction: news.defaultBudgetAction,
                jobAttachmentSettings: news.jobAttachmentSettings,
                roleArn: news.roleArn,
                jobRunAsUser: news.jobRunAsUser,
                requiredFileSystemLocationNames: news.requiredFileSystemLocationNames,
                allowedStorageProfileIds: news.allowedStorageProfileIds,
                schedulingConfiguration: news.schedulingConfiguration,
                tags: desiredTags,
              }),
            )
            try session.note(`Created queue ${displayName} (${created.queueId})`)
            state = try readQueueById(farmId, created.queueId, arnOf)
            if (state === undefined) {
              throw new QueueUnexpectedResponse({
                message: `failed to read created queue ${displayName}`,
              })
            }
          }

          // Sync mutable settings — compute the delta from OBSERVED state.
          const described = state.described
          const fslDelta = stringSetDelta(
            described.requiredFileSystemLocationNames ?? [],
            news.requiredFileSystemLocationNames ?? [],
          )
          const spDelta = stringSetDelta(
            described.allowedStorageProfileIds ?? [],
            news.allowedStorageProfileIds ?? [],
          )
          const needsUpdate = displayName !== described.displayName
            || (news.description !== undefined
              && news.description !== (asPlain(described.description) ?? ""))
            || (news.defaultBudgetAction !== undefined
              && news.defaultBudgetAction !== described.defaultBudgetAction)
            || (news.roleArn !== undefined && news.roleArn !== described.roleArn)
            || news.jobAttachmentSettings !== undefined
            || news.jobRunAsUser !== undefined
            || news.schedulingConfiguration !== undefined
            || fslDelta.toAdd.length > 0
            || fslDelta.toRemove.length > 0
            || spDelta.toAdd.length > 0
            || spDelta.toRemove.length > 0
          if (needsUpdate) {
            try retryWhileFarmSettling(
              deadline.updateQueue({
                farmId,
                queueId: state.attrs.queueId,
                displayName,
                description: news.description,
                defaultBudgetAction: news.defaultBudgetAction,
                jobAttachmentSettings: news.jobAttachmentSettings,
                roleArn: news.roleArn,
                jobRunAsUser: news.jobRunAsUser,
                requiredFileSystemLocationNamesToAdd: fslDelta.toAdd.length > 0 ? fslDelta.toAdd : undefined,
                requiredFileSystemLocationNamesToRemove: fslDelta.toRemove.length > 0 ? fslDelta.toRemove : undefined,
                allowedStorageProfileIdsToAdd: spDelta.toAdd.length > 0 ? spDelta.toAdd : undefined,
                allowedStorageProfileIdsToRemove: spDelta.toRemove.length > 0 ? spDelta.toRemove : undefined,
                schedulingConfiguration: news.schedulingConfiguration,
              }),
            )
            try session.note(`Updated queue ${displayName}`)
          }

          // Sync tags — diff against observed cloud tags.
          try syncDeadlineTags(state.attrs.queueArn, desiredTags)

          try session.note(state.attrs.queueArn)
          const final = try readQueueById(farmId, state.attrs.queueId, arnOf)
          if (!final) {
            throw new QueueUnexpectedResponse({
              message: `failed to read reconciled queue ${displayName}`,
            })
          }
          return final.attrs
        },
        delete: effect ({ output }) => {
          retryWhileConflict(
            deadline.deleteQueue({
              farmId: output.farmId,
              queueId: output.queueId,
            }),
          ) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.void;
            default: throw e;
          }
          // Queue deletion is asynchronous; wait until it is gone so the
          // parent farm's deletion does not hit a dependency conflict.
          retryWhileStillExists(
            effect {
              const described = deadline
                .getQueue({ farmId: output.farmId, queueId: output.queueId }) catch effect (e) => match (e) {
                  when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
                  default: throw e;
                }
              if (described !== undefined) {
                throw new QueueStillExists({ queueId: output.queueId })
              }
            },
          ) catch effect (e) => match (e) { when { _tag: "QueueStillExists" }: try Effect.void; default: throw e; }
          // Deadline auto-creates /aws/deadline/{farmId}/{queueId} for the
          // queue's job/session logs and deleteQueue does NOT remove it —
          // reap it so a deleted queue leaves no orphaned log group.
          try reapDeadlineLogGroups(`/aws/deadline/${output.farmId}/${output.queueId}`)
        },
      }
    },
  )
