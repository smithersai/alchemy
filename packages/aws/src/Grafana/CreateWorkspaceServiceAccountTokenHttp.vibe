import * as grafana from "@distilled.cloud/aws/grafana"
import * as Output from "alchemy/Output"
import { toWireSeconds } from "alchemy/Util/Duration"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import {
  CreateWorkspaceServiceAccountToken,
  type CreateWorkspaceServiceAccountTokenRequest,
} from "./CreateWorkspaceServiceAccountToken.vibe"
import type { Workspace } from "./Workspace.vibe"

/**
 * Bespoke (not scaffold-built): the runtime request carries a
 * `timeToLive: Duration.Input` that is converted to the wire's
 * `secondsToLive` via the central Duration util.
 */
export const CreateWorkspaceServiceAccountTokenHttp = Layer.effect(
  CreateWorkspaceServiceAccountToken,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(grafana.createWorkspaceServiceAccountToken)

    return effect (workspace: Workspace) => {
      const workspaceId = try workspace.workspaceId.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.Grafana.CreateWorkspaceServiceAccountToken(${workspace})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["grafana:CreateWorkspaceServiceAccountToken"],
              Resource: [Output.interpolate`${workspace.workspaceArn}`],
            },
          ],
        })
      }
      return effect (request: CreateWorkspaceServiceAccountTokenRequest) =>
        try withSpan(
          effect {
            return try op({
              name: request.name,
              serviceAccountId: request.serviceAccountId,
              secondsToLive: toWireSeconds(request.timeToLive)!,
              workspaceId: try workspaceId,
            })
          },
          `AWS.Grafana.CreateWorkspaceServiceAccountToken(${workspace.LogicalId})`,
        )
    }
  },
)
