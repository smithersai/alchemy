import * as ecr from "@distilled.cloud/aws/ecr"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { GetAuthorizationToken } from "./GetAuthorizationToken.vibe"

/**
 * HTTP implementation of {@link GetAuthorizationToken} over the ECR API.
 * Registry-level (not repository-scoped): the token authorizes Docker
 * `login` against the whole private registry, and `ecr:GetAuthorizationToken`
 * supports no resource-level permissions, so the grant is on `"*"`.
 */
export const GetAuthorizationTokenHttp = Layer.effect(
  GetAuthorizationToken,
  effect {
    const bind = try AWSBindings.Bind
    const op = try AWSBindings.withCredentials(ecr.getAuthorizationToken)

    return effect () => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.ECR.GetAuthorizationToken()`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["ecr:GetAuthorizationToken"],
              Resource: ["*"],
            },
          ],
        })
      }
      return effect () =>
        try withSpan(
          effect {
            return try op({})
          },
          "AWS.ECR.GetAuthorizationToken",
        )
    }
  },
)
