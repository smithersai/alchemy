import * as Effect from "effect/Effect"
import * as mm from "@distilled.cloud/aws/mailmanager"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, createTagsList, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.ts"
import { readMailManagerTags, retryWhileMailManagerConflict, syncMailManagerTags } from "./internal.vibe"

export error AddressListUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface AddressListProps {
  /**
   * Name of the address list. If omitted, a deterministic physical name is
   * generated from the app, stage, and logical ID. Mail Manager has no
   * update operation for address lists, so a rename replaces the list (its
   * members are NOT carried over).
   */
  addressListName?: string
  /**
   * Tags applied to the address list. Alchemy ownership tags are merged in
   * automatically.
   */
  tags?: Record<string, string>
}

export interface AddressList extends
  Resource<
    "AWS.MailManager.AddressList",
    AddressListProps,
    {
      /** Server-assigned ID of the address list. */
      addressListId: string
      /** ARN of the address list. */
      addressListArn: string
      /** Name of the address list. */
      addressListName: string
    },
    never,
    Providers
  >
{}

/**
 * An SES Mail Manager address list — a named set of email addresses that
 * traffic policies and rule conditions can match against (allow lists,
 * block lists, routing groups).
 *
 * The list itself is create-only config (name + tags); its members are
 * data managed at runtime via the member capabilities
 * ({@link RegisterMemberToAddressList}, {@link ListMembersOfAddressList},
 * ...) or bulk import jobs.
 * ### Creating Address Lists
 * **Example:** Block List
 * ```typescript
 * import * as MailManager from "@alchemy.run/aws/MailManager";
 *
 * const blockList = yield* MailManager.AddressList("BlockList", {
 *   tags: { purpose: "smtp-block-list" },
 * });
 * ```
 *
 * ### Managing Members at Runtime
 * **Example:** Register and List Members from a Lambda
 * ```typescript
 * // init — bind the member capabilities to the list
 * const registerMember = yield* MailManager.RegisterMemberToAddressList(blockList);
 * const listMembers = yield* MailManager.ListMembersOfAddressList(blockList);
 *
 * // runtime
 * yield* registerMember({ Address: "spammer@example.com" });
 * const { Addresses } = yield* listMembers({});
 * ```
 *
 * @resource
 */
export const AddressList = Resource<AddressList>("AWS.MailManager.AddressList")

export const AddressListProvider = (): infer _ =>
  Provider.effect(
    AddressList,
    effect {
      const createName = effect (id: string, props: { addressListName?: string }) =>
        props.addressListName ?? (try createPhysicalName({ id, maxLength: 255 }))

      const getById = effect (addressListId: string) =>
        mm
          .getAddressList({ AddressListId: addressListId }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: undefined;
            default: throw e;
          }

      // Address lists have no name-keyed Get — enumerate and match. The
      // physical name is deterministic, so this recovers identity after a
      // lost state write.
      const findByName = effect (name: string) =>
        Array.from(
          try (mm.listAddressLists.pages({})
            |> Stream.runCollect(%)),
        )
          .flatMap((page) => page.AddressLists ?? [])
          .find((l) => l.AddressListName === name)

      const observe = effect (
        output: AddressList["Attributes"] | undefined,
        name: string,
      ) => {
        if (output?.addressListId !== undefined) {
          const found = try getById(output.addressListId)
          if (found !== undefined) return found
        }
        const summary = try findByName(name)
        if (summary?.AddressListId === undefined) return undefined
        return try getById(summary.AddressListId)
      }

      const toAttrs = (list: mm.GetAddressListResponse): infer _ => ({
        addressListId: list.AddressListId,
        addressListArn: list.AddressListArn,
        addressListName: list.AddressListName,
      })

      return AddressList.Provider.of({
        stables: ["addressListId", "addressListArn"],

        list: effect () =>
          Array.from(
            try (mm.listAddressLists.pages({})
              |> Stream.runCollect(%)),
          )
            .flatMap((page) => page.AddressLists ?? [])
            .map((l) => ({
              addressListId: l.AddressListId,
              addressListArn: l.AddressListArn,
              addressListName: l.AddressListName,
            })),

        read: effect ({ id, olds, output }) => {
          const name = output?.addressListName ?? (try createName(id, olds ?? {}))
          const list = try observe(output, name)
          if (list === undefined) return undefined
          const attrs = toAttrs(list)
          const tags = try readMailManagerTags(attrs.addressListArn)
          return (try hasAlchemyTags(id, tags))
            ? attrs
            : (try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (error) => error })))
        },

        // Mail Manager exposes no UpdateAddressList — a name change can only
        // be realized by replacement.
        diff: effect ({ news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          if (olds === undefined) return undefined
          if (news.addressListName !== undefined && olds.addressListName !== news.addressListName) {
            return { action: "replace" } as const
          }
        },

        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. OBSERVE — cloud state is authoritative; output is an id cache.
          let list = try observe(output, name)

          // 2. ENSURE — create if missing; a Conflict race re-observes by
          //    name instead of failing.
          if (list === undefined) {
            try session.note(`creating address list ${name}`)
            const created = mm
              .createAddressList({
                AddressListName: name,
                Tags: createTagsList(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "ConflictException" }: undefined;
                default: throw e;
              }
            list = created !== undefined
              ? try getById(created.AddressListId)
              : try observe(undefined, name)
          }
          if (list === undefined) {
            throw new AddressListUnexpectedResponse({
              message: `Mail Manager address list '${name}' not found after create`,
            })
          }

          // 3. SYNC TAGS — the only mutable aspect; diffed against observed
          //    cloud tags so adoption converges.
          try syncMailManagerTags(list.AddressListArn, desiredTags)

          try session.note(list.AddressListId)
          return toAttrs(list)
        },

        delete: effect ({ output }) => {
          // DeleteAddressList's error union carries no not-found tag —
          // deletion is natively idempotent. A list referenced by an
          // in-flight import job reports Conflict — retry through it.
          try (retryWhileMailManagerConflict(
            mm.deleteAddressList({ AddressListId: output.addressListId }),
          )
            |> Effect.asVoid(%))
        },
      })
    },
  )
