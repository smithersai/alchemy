import * as mm from "@distilled.cloud/aws/mailmanager"
import { Unowned } from "alchemy/AdoptPolicy"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, createTagsList, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.ts"
import { readMailManagerTags, retryWhileMailManagerConflict, sameShape, syncMailManagerTags } from "./internal.ts"

export error RuleSetUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface RuleSetProps {
  /**
   * Name of the rule set. If omitted, a deterministic physical name is
   * generated from the app, stage, and logical ID. Renames apply in place.
   */
  mutable ruleSetName?: string
  /**
   * The ordered list of rules evaluated against emails arriving through an
   * ingress point associated with this rule set. Each rule pairs optional
   * conditions with one or more actions (Drop, Relay, Archive, WriteToS3,
   * Send, AddHeader, ReplaceRecipient, DeliverToMailbox, DeliverToQBusiness,
   * PublishToSns, Bounce, InvokeLambda). Updates apply in place.
   * @default []
   */
  mutable rules?: mm.Rule[]
  /**
   * Tags applied to the rule set. Alchemy ownership tags are merged in
   * automatically.
   */
  mutable tags?: Record<string, string>
}

export interface RuleSet extends
  Resource<
    "AWS.MailManager.RuleSet",
    RuleSetProps,
    {
      /** Server-assigned ID of the rule set. */
      mutable ruleSetId: string
      /** ARN of the rule set. */
      mutable ruleSetArn: string
      /** Name of the rule set. */
      mutable ruleSetName: string
    },
    never,
    Providers
  >
{}

/**
 * An SES Mail Manager rule set — the ordered rules an ingress point applies
 * to incoming email (drop, archive, write to S3, deliver, bounce, invoke
 * Lambda, ...).
 *
 * All aspects (name, rules, tags) update in place.
 * ### Creating Rule Sets
 * **Example:** Drop Everything
 * ```typescript
 * import * as MailManager from "@alchemy.run/aws/MailManager";
 *
 * const ruleSet = yield* MailManager.RuleSet("Inbound", {
 *   rules: [{ Name: "DropAll", Actions: [{ Drop: {} }] }],
 * });
 * ```
 *
 * **Example:** Conditional Archive
 * ```typescript
 * const ruleSet = yield* MailManager.RuleSet("Inbound", {
 *   rules: [
 *     {
 *       Name: "ArchiveLarge",
 *       Conditions: [
 *         {
 *           NumberExpression: {
 *             Evaluate: { Attribute: "MESSAGE_SIZE" },
 *             Operator: "GREATER_THAN",
 *             Value: 1024,
 *           },
 *         },
 *       ],
 *       Actions: [{ Archive: { TargetArchive: archive.archiveId } }],
 *     },
 *   ],
 * });
 * ```
 *
 * ### Wiring to an Ingress Point
 * **Example:** Rule Set + Traffic Policy + Ingress Point
 * ```typescript
 * const ingress = yield* MailManager.IngressPoint("Smtp", {
 *   type: "OPEN",
 *   ruleSetId: ruleSet.ruleSetId,
 *   trafficPolicyId: trafficPolicy.trafficPolicyId,
 * });
 * ```
 *
 * ### Delivering Email Events to Compute
 * **Example:** Invoke a Lambda for Matching Mail
 * ```typescript
 * // Mail Manager has no EventBridge events or event-source mapping — email
 * // events reach compute through rule actions: InvokeLambda (direct),
 * // PublishToSns (SNS event source), or WriteToS3 (S3 event source). The
 * // role must be assumable by ses.amazonaws.com with lambda:InvokeFunction.
 * const ruleSet = yield* MailManager.RuleSet("Inbound", {
 *   rules: [
 *     {
 *       Name: "NotifyOnMail",
 *       Actions: [
 *         {
 *           InvokeLambda: {
 *             FunctionArn: fn.functionArn,
 *             InvocationType: "EVENT",
 *             RoleArn: invokeRole.roleArn,
 *           },
 *         },
 *       ],
 *     },
 *   ],
 * });
 * ```
 *
 * @resource
 */
export const RuleSet = Resource<RuleSet>("AWS.MailManager.RuleSet")

export const RuleSetProvider = (): infer _ =>
  Provider.effect(
    RuleSet,
    effect {
      const createName = effect (id: string, props: { mutable ruleSetName?: string }) =>
        props.ruleSetName ?? (try createPhysicalName({ id, maxLength: 100 }))

      const getById = effect (ruleSetId: string) =>
        mm
          .getRuleSet({ RuleSetId: ruleSetId }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
            default: throw e;
          }

      // Rule sets have no name-keyed Get — enumerate and match. The physical
      // name is deterministic, so this recovers identity after a lost state
      // write.
      const findByName = effect (name: string) =>
        Array.from(
          try (mm.listRuleSets.pages({})
            |> Stream.runCollect(%)),
        )
          .flatMap((page) => page.RuleSets ?? [])
          .find((r) => r.RuleSetName === name)

      const observe = effect (
        output: RuleSet["Attributes"] | undefined,
        name: string,
      ) => {
        if (output?.ruleSetId !== undefined) {
          const found = try getById(output.ruleSetId)
          if (found !== undefined) return found
        }
        const summary = try findByName(name)
        if (summary?.RuleSetId === undefined) return undefined
        return try getById(summary.RuleSetId)
      }

      const toAttrs = (ruleSet: mm.GetRuleSetResponse): infer _ => ({
        ruleSetId: ruleSet.RuleSetId,
        ruleSetArn: ruleSet.RuleSetArn,
        ruleSetName: ruleSet.RuleSetName,
      })

      return RuleSet.Provider.of({
        stables: ["ruleSetId", "ruleSetArn"],

        list: effect () =>
          (try Effect.forEach(
            Array.from(
              try (mm.listRuleSets.pages({})
                |> Stream.runCollect(%)),
            )
              .flatMap((page) => page.RuleSets ?? [])
              .flatMap((r) => (r.RuleSetId !== undefined ? [r.RuleSetId] : [])),
            (ruleSetId) => getById(ruleSetId),
          )).flatMap((r) => (r === undefined ? [] : [toAttrs(r)])),

        read: effect ({ id, olds, output }) => {
          const name = output?.ruleSetName ?? (try createName(id, olds ?? {}))
          const ruleSet = try observe(output, name)
          if (ruleSet === undefined) return undefined
          const attrs = toAttrs(ruleSet)
          const tags = try readMailManagerTags(attrs.ruleSetArn)
          return (try hasAlchemyTags(id, tags)) ? attrs : Unowned(attrs)
        },

        // Name and rules both update in place — no replacement triggers, so
        // the engine's default update path applies (no diff needed).

        reconcile: effect ({ id, news, output, session }) => {
          const name = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }
          const desiredRules = news.rules ?? []

          // 1. OBSERVE — cloud state is authoritative; output is an id cache.
          let ruleSet = try observe(output, name)

          // 2. ENSURE — create if missing; a Conflict race re-observes by
          //    name instead of failing.
          if (ruleSet === undefined) {
            try session.note(`creating rule set ${name}`)
            const created = mm
              .createRuleSet({
                RuleSetName: name,
                Rules: desiredRules,
                Tags: createTagsList(desiredTags),
              }) catch effect (e) => match (e) {
                when { _tag: "ConflictException" }: try Effect.undefined;
                default: throw e;
              }
            ruleSet = created !== undefined
              ? try getById(created.RuleSetId)
              : try observe(undefined, name)
          }
          if (ruleSet === undefined) {
            throw new RuleSetUnexpectedResponse({
              message: `Mail Manager rule set '${name}' not found after create`,
            })
          }

          // 3. SYNC — diff OBSERVED name/rules against desired; apply only
          //    the delta.
          if (ruleSet.RuleSetName !== name || !sameShape(ruleSet.Rules, desiredRules)) {
            try mm.updateRuleSet({
              RuleSetId: ruleSet.RuleSetId,
              RuleSetName: name,
              Rules: desiredRules,
            })
          }

          // 3b. SYNC TAGS — against observed cloud tags.
          try syncMailManagerTags(ruleSet.RuleSetArn, desiredTags)

          try session.note(ruleSet.RuleSetId)
          return {
            ruleSetId: ruleSet.RuleSetId,
            ruleSetArn: ruleSet.RuleSetArn,
            ruleSetName: name,
          }
        },

        delete: effect ({ output }) => {
          // DeleteRuleSet is natively idempotent — deleting a nonexistent
          // rule set succeeds (verified live by the delete probe test). A
          // rule set stays "in use" while a deleted ingress point finishes
          // deprovisioning — retry through the Conflict window.
          try (retryWhileMailManagerConflict(
            mm.deleteRuleSet({ RuleSetId: output.ruleSetId }),
          )
            |> Effect.asVoid(%))
        },
      })
    },
  )
