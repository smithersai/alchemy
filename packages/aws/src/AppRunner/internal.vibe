import * as apprunner from "@distilled.cloud/aws/apprunner"
import { diffTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"

/**
 * App Runner documents configuration statuses as `ACTIVE`/`INACTIVE` but
 * the wire returns lowercase `active`/`inactive` (observed live for auto
 * scaling configurations and VPC connectors) — compare case-insensitively.
 */
export const isActiveStatus = (status: string | undefined): boolean => status?.toUpperCase() === "ACTIVE"

/**
 * Convert an App Runner wire tag list into a plain record, dropping
 * malformed entries.
 */
export const toTagRecord = (
  tags: ReadonlyArray<{ Key?: string; Value?: string }> | undefined,
): Record<string, string> =>
  Object.fromEntries(
    (tags ?? [])
      .filter(
        (tag): tag is { Key: string; Value: string } => typeof tag.Key === "string" && typeof tag.Value === "string",
      )
      .map((tag) => [tag.Key, tag.Value]),
  )

/**
 * Read the observed tags of an App Runner resource. Tag reads are
 * best-effort — a failure (e.g. a race with deletion) reports no tags.
 */
export const readAppRunnerTags = effect (arn: string) => {
  const response = apprunner
    .listTagsForResource({ ResourceArn: arn }) catch () => undefined
  return toTagRecord(response?.Tags)
}

/**
 * Sync tags on an App Runner resource: diff the OBSERVED cloud tags
 * against the desired set and apply only the delta.
 */
export const syncAppRunnerTags = effect (
  arn: string,
  desiredTags: Record<string, string>,
) => {
  const observedTags = try readAppRunnerTags(arn)
  const { removed, upsert } = try Effect.orDie(Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }))
  if (upsert.length > 0) {
    try apprunner.tagResource({ ResourceArn: arn, Tags: upsert })
  }
  if (removed.length > 0) {
    try apprunner.untagResource({ ResourceArn: arn, TagKeys: removed })
  }
}

/**
 * Convert a desired tag record into the wire tag list for create calls.
 */
export const toWireTags = (tags: Record<string, string>): apprunner.Tag[] =>
  Object.entries(tags).map(([Key, Value]) => ({ Key, Value }))
