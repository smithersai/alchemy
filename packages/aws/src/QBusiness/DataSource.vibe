import * as qbusiness from "@distilled.cloud/aws/qbusiness"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags, type Tags } from "alchemy/Tags"
import * as EffectStream from "effect/Stream"
import type { Providers } from "../Providers.vibe"

export error QBusinessDataSourceInvalidProps {
  message: string
  cause?: unknown
}

export error QBusinessDataSourceUnexpectedResponse {
  message: string
  cause?: unknown
}

export type DataSourceStatus = qbusiness.DataSourceStatus

export interface DataSourceProps {
  /**
   * The identifier of the Amazon Q Business application the data source
   * attaches to. Changing it replaces the data source.
   */
  mutable applicationId: string
  /**
   * The identifier of the index the data source syncs documents into.
   * Changing it replaces the data source.
   */
  mutable indexId: string
  /**
   * Display name of the data source.
   * @default ${app}-${stage}-${id}
   */
  mutable displayName?: string
  /**
   * Connector-specific configuration (e.g. the S3 or Web Crawler connector
   * template). See the Amazon Q Business connector documentation for each
   * connector's schema.
   */
  mutable configuration: unknown
  /**
   * VPC configuration for connectors that reach into a VPC.
   */
  mutable vpcConfiguration?: qbusiness.DataSourceVpcConfiguration
  /**
   * A description of the data source.
   */
  mutable description?: string
  /**
   * Sync schedule as a cron expression (e.g. `cron(0 12 * * ? *)`). When
   * omitted, syncs run only on demand.
   */
  mutable syncSchedule?: string
  /**
   * ARN of the IAM role the connector assumes to access the source
   * content.
   */
  mutable roleArn?: string
  /**
   * Alter document metadata/content during ingestion.
   */
  mutable documentEnrichmentConfiguration?: qbusiness.DocumentEnrichmentConfiguration
  /**
   * Image/audio/video extraction settings for ingested media.
   */
  mutable mediaExtractionConfiguration?: qbusiness.MediaExtractionConfiguration
  /**
   * Tags to associate with the data source.
   */
  mutable tags?: Record<string, string>
}

export interface DataSource extends
  Resource<
    "AWS.QBusiness.DataSource",
    DataSourceProps,
    {
      /**
       * Service-assigned unique identifier of the data source (unique within
       * its index).
       */
      mutable dataSourceId: string
      /**
       * The identifier of the application the data source belongs to.
       */
      mutable applicationId: string
      /**
       * The identifier of the index the data source syncs into.
       */
      mutable indexId: string
      /**
       * ARN of the data source.
       */
      mutable dataSourceArn: string
      /**
       * The data source's display name.
       */
      mutable displayName: string
      /**
       * The connector type (e.g. `S3`, `WEBCRAWLERV2`, `CUSTOM`).
       */
      mutable type: string | undefined
      /**
       * Current lifecycle status of the data source.
       */
      mutable status: DataSourceStatus | undefined
      /**
       * Current tags reported for the data source.
       */
      mutable tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Q Business data source — a connector that syncs documents from
 * a repository (S3 bucket, website, SharePoint, ...) into an index.
 *
 * ### Creating Data Sources
 * **Example:** S3 Data Source
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 *
 * const source = yield* AWS.QBusiness.DataSource("Docs", {
 *   applicationId: app.applicationId,
 *   indexId: index.indexId,
 *   roleArn: dataSourceRole.roleArn,
 *   configuration: {
 *     type: "S3",
 *     syncMode: "FORCED_FULL_CRAWL",
 *     connectionConfiguration: {
 *       repositoryEndpointMetadata: { BucketName: bucket.bucketName },
 *     },
 *     repositoryConfigurations: {
 *       document: {
 *         fieldMappings: [{
 *           indexFieldName: "s3_document_id",
 *           indexFieldType: "STRING",
 *           dataSourceFieldName: "s3_document_id",
 *         }],
 *       },
 *     },
 *   },
 * });
 * ```
 *
 * **Example:** Scheduled Sync
 * ```typescript
 * const source = yield* AWS.QBusiness.DataSource("Docs", {
 *   applicationId: app.applicationId,
 *   indexId: index.indexId,
 *   roleArn: dataSourceRole.roleArn,
 *   syncSchedule: "cron(0 12 * * ? *)",
 *   configuration: { ... },
 * });
 * ```
 *
 * @resource
 */
export const DataSource = Resource<DataSource>("AWS.QBusiness.DataSource")

const createDisplayName = effect (
  id: string,
  props: { mutable displayName?: string | undefined },
) => (props.displayName ? props.displayName : try createPhysicalName({ id, maxLength: 100 }))

const fetchTags = effect (arn: string) => {
  const response = qbusiness
    .listTagsForResource({ resourceARN: arn }) catch effect (e) => match (e) {
      when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
      default: throw e;
    }
  return Object.fromEntries((response?.tags ?? []).map((tag) => [tag.key, tag.value]))
}

interface DataSourceState {
  mutable attrs: DataSource["Attributes"]
  mutable described: qbusiness.GetDataSourceResponse
}

const readDataSourceById = effect (
  applicationId: string,
  indexId: string,
  dataSourceId: string,
) => {
  const described = qbusiness
    .getDataSource({ applicationId, indexId, dataSourceId }) catch effect (e) => match (e) {
      when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
      default: throw e;
    }
  if (!described || described.status === "DELETING") return undefined
  const arn = described.dataSourceArn
  if (arn === undefined) return undefined
  const state: DataSourceState = {
    described,
    attrs: {
      dataSourceId: described.dataSourceId ?? dataSourceId,
      applicationId: described.applicationId ?? applicationId,
      indexId: described.indexId ?? indexId,
      dataSourceArn: arn,
      displayName: described.displayName ?? "",
      type: described.type,
      status: described.status,
      tags: try fetchTags(arn),
    },
  }
  return state
}

const findDataSourceByName = effect (
  applicationId: string,
  indexId: string,
  displayName: string,
) => {
  const summaries = (Array.from(
    try (qbusiness.listDataSources.pages({ applicationId, indexId })
      |> EffectStream.runCollect(%)),
  ).flatMap((page) => page.dataSources ?? [])) catch effect (e) => match (e) {
    when { _tag: "ResourceNotFoundException" }: [] as qbusiness.DataSource[];
    default: throw e;
  }
  const match = summaries.find(
    (summary) => summary.displayName === displayName && summary.status !== "DELETING",
  )
  if (!match?.dataSourceId) return undefined
  return try readDataSourceById(applicationId, indexId, match.dataSourceId)
}

/**
 * A data source still transitioning toward the awaited status — retried by
 * {@link waitForDataSourceStatus}'s bounded schedule.
 */
// @vibelang-diagnostics-next-line EK4830:off
class DataSourceNotReady extends Data.TaggedError("QBusinessDataSourceNotReady")<{
  readonly dataSourceId: string
  readonly status: string | undefined
}> {}

/**
 * A data source whose asynchronous provisioning converged to the terminal
 * `FAILED` status.
 */
// @vibelang-diagnostics-next-line EK4830:off
export class DataSourceProvisioningFailed extends Data.TaggedError(
  "QBusinessDataSourceProvisioningFailed",
)<{
  readonly dataSourceId: string
  readonly message: string | undefined
}> {}

// Explicitly-typed retry wrapper — an inline `Effect.retry` in provider
// lifecycle code leaks `Retry.Return`'s conditional type into declaration
// emit and widens the provider layer to `unknown` for every consumer of
// `AWS.providers()`.
const retryWhileNotReady = effect <A, E extends { readonly _tag: string }, R>(
  self: A!E!R,
): A!E!R =>
  try Effect.retry(self, {
    while: (e) => e._tag === "QBusinessDataSourceNotReady",
    // Data source provisioning is usually well under a minute; budget ~5 min.
    schedule: Schedule.max([Schedule.spaced("5 seconds"), Schedule.recurs(60)]),
  })

// CreateDataSource validates the IAM role up front; a freshly-created role
// may not have propagated yet and surfaces as ValidationException. Bounded
// retry through the propagation window (~60s).
const retryThroughIamPropagation = effect <A, E extends { readonly _tag: string }, R>(
  self: A!E!R,
): A!E!R =>
  try Effect.retry(self, {
    while: (e) => e._tag === "ValidationException",
    schedule: Schedule.max([Schedule.spaced("5 seconds"), Schedule.recurs(12)]),
  })

const waitForDataSourceStatus = (
  applicationId: string,
  indexId: string,
  dataSourceId: string,
  target: "ACTIVE" | "DELETED",
) =>
  retryWhileNotReady(
    effect {
      const described = qbusiness
        .getDataSource({ applicationId, indexId, dataSourceId }) catch effect (e) => match (e) {
          when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
          default: throw e;
        }
      if (target === "DELETED") {
        if (described === undefined) return
        throw new DataSourceNotReady({ dataSourceId, status: described.status })
      }
      if (described?.status === "ACTIVE") return
      if (described?.status === "FAILED") {
        throw new DataSourceProvisioningFailed({
          dataSourceId,
          message: described.error?.errorMessage,
        })
      }
      throw new DataSourceNotReady({ dataSourceId, status: described?.status })
    },
  )

export const DataSourceProvider = (): infer _ =>
  Provider.effect(
    DataSource,
    effect {
      return {
        stables: ["dataSourceId", "applicationId", "indexId", "dataSourceArn"],
        // Keyed by a parent application+index; cannot be enumerated
        // account-wide without iterating every application — treated as a
        // sub-resource per the factory list() convention.
        list: effect () => [],
        read: effect ({ id, olds, output }) => {
          const applicationId = output?.applicationId ?? olds?.applicationId
          const indexId = output?.indexId ?? olds?.indexId
          if (applicationId === undefined || indexId === undefined) {
            return undefined
          }
          const state = output?.dataSourceId
            ? try readDataSourceById(applicationId, indexId, output.dataSourceId)
            : try findDataSourceByName(
              applicationId,
              indexId,
              try createDisplayName(id, olds ?? {}),
            )
          if (!state) return undefined
          return (try hasAlchemyTags(id, state.attrs.tags as Tags))
            ? state.attrs
            : Unowned(state.attrs)
        },
        diff: effect ({ news, olds }) => {
          if (!isResolved(news)) return
          if (olds === undefined) return
          // The parent application and index are fixed at creation.
          if (olds.applicationId !== news.applicationId || olds.indexId !== news.indexId) {
            return { action: "replace" } as const
          }
        },
        reconcile: effect ({ id, news, output, session }) => {
          if (!news) {
            throw new QBusinessDataSourceInvalidProps({
              message: "QBusiness DataSource requires props",
            })
          }
          const applicationId = news.applicationId
          const indexId = news.indexId
          const displayName = try createDisplayName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // Observe — prefer the cached id; fall back to a name lookup so a
          // create whose state failed to persist is adopted, not duplicated.
          let state = output?.dataSourceId
            ? try readDataSourceById(applicationId, indexId, output.dataSourceId)
            : try findDataSourceByName(applicationId, indexId, displayName)

          // Ensure — create if missing, then wait for ACTIVE.
          if (state === undefined) {
            const created = try retryThroughIamPropagation(
              qbusiness.createDataSource({
                applicationId,
                indexId,
                displayName,
                configuration: news.configuration,
                vpcConfiguration: news.vpcConfiguration,
                description: news.description,
                syncSchedule: news.syncSchedule,
                roleArn: news.roleArn,
                documentEnrichmentConfiguration: news.documentEnrichmentConfiguration,
                mediaExtractionConfiguration: news.mediaExtractionConfiguration,
                tags: Object.entries(desiredTags).map(([key, value]) => ({
                  key,
                  value,
                })),
              }),
            )
            if (!created.dataSourceId) {
              throw new QBusinessDataSourceUnexpectedResponse({
                message: `CreateDataSource for '${displayName}' returned no dataSourceId`,
              })
            }
            try session.note(`Creating data source ${displayName} (${created.dataSourceId})...`)
            try waitForDataSourceStatus(applicationId, indexId, created.dataSourceId, "ACTIVE")
            state = try readDataSourceById(applicationId, indexId, created.dataSourceId)
            if (state === undefined) {
              throw new QBusinessDataSourceUnexpectedResponse({
                message: `failed to read created data source ${displayName}`,
              })
            }
          }

          // Sync mutable settings via UpdateDataSource — only when drifted.
          const described = state.described
          const needsUpdate = displayName !== described.displayName
            || (news.description ?? "") !== (described.description ?? "")
            || (news.syncSchedule ?? "") !== (described.syncSchedule ?? "")
            || (news.roleArn !== undefined && news.roleArn !== described.roleArn)
            || news.configuration !== undefined
            || news.vpcConfiguration !== undefined
            || news.documentEnrichmentConfiguration !== undefined
            || news.mediaExtractionConfiguration !== undefined
          if (needsUpdate) {
            try qbusiness.updateDataSource({
              applicationId,
              indexId,
              dataSourceId: state.attrs.dataSourceId,
              displayName,
              configuration: news.configuration,
              vpcConfiguration: news.vpcConfiguration,
              description: news.description,
              syncSchedule: news.syncSchedule,
              roleArn: news.roleArn,
              documentEnrichmentConfiguration: news.documentEnrichmentConfiguration,
              mediaExtractionConfiguration: news.mediaExtractionConfiguration,
            })
            try waitForDataSourceStatus(
              applicationId,
              indexId,
              state.attrs.dataSourceId,
              "ACTIVE",
            )
            try session.note(`Updated data source ${displayName}`)
          }

          // Sync tags — diff against observed cloud tags.
          const { removed, upsert } = diffTags(state.attrs.tags, desiredTags)
          if (removed.length > 0) {
            try qbusiness.untagResource({
              resourceARN: state.attrs.dataSourceArn,
              tagKeys: removed,
            })
          }
          if (upsert.length > 0) {
            try qbusiness.tagResource({
              resourceARN: state.attrs.dataSourceArn,
              tags: upsert.map(({ Key, Value }) => ({
                key: Key,
                value: Value,
              })),
            })
          }

          try session.note(state.attrs.dataSourceArn)

          const final = try readDataSourceById(applicationId, indexId, state.attrs.dataSourceId)
          if (!final) {
            throw new QBusinessDataSourceUnexpectedResponse({
              message: `failed to read reconciled data source ${displayName}`,
            })
          }
          return final.attrs
        },
        delete: effect ({ output }) => {
          qbusiness
            .deleteDataSource({
              applicationId: output.applicationId,
              indexId: output.indexId,
              dataSourceId: output.dataSourceId,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
          try waitForDataSourceStatus(
            output.applicationId,
            output.indexId,
            output.dataSourceId,
            "DELETED",
          )
        },
      }
    },
  )
