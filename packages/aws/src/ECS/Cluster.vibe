import * as ecs from "@distilled.cloud/aws/ecs"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags } from "alchemy/Tags"
import { AWSEnvironment, type AccountID } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import type { RegionID } from "../Region.vibe"

export type ClusterName = string
export type ClusterArn = `arn:aws:ecs:${RegionID}:${AccountID}:cluster/${ClusterName}`

export interface ClusterProps {
  /**
   * Cluster name. If omitted, a unique name is generated.
   */
  clusterName?: string
  /**
   * ECS cluster settings such as container insights.
   */
  settings?: ecs.ClusterSetting[]
  /**
   * Cluster configuration such as execute command logging.
   */
  configuration?: ecs.ClusterConfiguration
  /**
   * Optional capacity providers associated with the cluster.
   */
  capacityProviders?: string[]
  /**
   * Default capacity provider strategy for the cluster.
   */
  defaultCapacityProviderStrategy?: ecs.CapacityProviderStrategyItem[]
  /**
   * Optional Service Connect defaults for the cluster.
   */
  serviceConnectDefaults?: ecs.ClusterServiceConnectDefaultsRequest
  /**
   * User-defined tags to apply to the cluster.
   */
  tags?: Record<string, string>
}

export interface Cluster extends
  Resource<
    "AWS.ECS.Cluster",
    ClusterProps,
    {
      /** The ARN of the cluster. */
      clusterArn: ClusterArn
      /** The name of the cluster. */
      clusterName: ClusterName
      /** The current status of the cluster, e.g. `ACTIVE`. */
      status: string
      /** The cluster settings, e.g. Container Insights. */
      settings: ecs.ClusterSetting[]
      /** The execute-command configuration of the cluster. */
      configuration?: ecs.ClusterConfiguration
      /** The capacity providers associated with the cluster. */
      capacityProviders: string[]
      /** The default capacity provider strategy for the cluster. */
      defaultCapacityProviderStrategy: ecs.CapacityProviderStrategyItem[]
      /** The default Service Connect namespace. */
      serviceConnectDefaults?: ecs.ClusterServiceConnectDefaultsRequest
      /** The tags attached to the cluster. */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An Amazon ECS cluster for running tasks and services.
 * ### Creating Clusters
 * **Example:** Default Cluster
 * ```typescript
 * const cluster = yield* Cluster("AppCluster", {});
 * ```
 *
 * @resource
 */
export const Cluster = Resource<Cluster>("AWS.ECS.Cluster")

error ClusterStillActive {
  cluster: string
  status: string | undefined
}

error ClusterNotActive {
  cluster: string
  status: string | undefined
}

export const ClusterProvider = (): infer _ =>
  Provider.effect(
    Cluster,
    effect {
      const toEcsTags = (tags: Record<string, string>): ecs.Tag[] =>
        Object.entries(tags).map(([key, value]) => ({
          key,
          value,
        }))

      // The one projection of a described cluster onto Attributes, shared by
      // read, list and reconcile so drift compares like with like.
      const toAttrs = (cluster: ecs.Cluster, tags: Record<string, string>): infer _ => ({
        clusterArn: cluster.clusterArn as ClusterArn,
        clusterName: cluster.clusterName!,
        status: cluster.status ?? "ACTIVE",
        settings: cluster.settings ?? [],
        configuration: cluster.configuration,
        capacityProviders: cluster.capacityProviders ?? [],
        defaultCapacityProviderStrategy: cluster.defaultCapacityProviderStrategy ?? [],
        serviceConnectDefaults: cluster.serviceConnectDefaults?.namespace
          ? { namespace: cluster.serviceConnectDefaults.namespace }
          : undefined,
        tags,
      })

      const toClusterName = effect (
        id: string,
        props: { clusterName?: string } = {},
      ) => (props.clusterName ? props.clusterName : try createPhysicalName({ id, maxLength: 255, lowercase: true }))

      const applyCapacityProviders = effect ({
        cluster,
        capacityProviders,
        defaultCapacityProviderStrategy,
      }: {
        cluster: string
        capacityProviders?: string[]
        defaultCapacityProviderStrategy?: ecs.CapacityProviderStrategyItem[]
      }) => {
        if (capacityProviders !== undefined || defaultCapacityProviderStrategy !== undefined) {
          try (ecs
            .putClusterCapacityProviders({
              cluster,
              capacityProviders: capacityProviders ?? [],
              defaultCapacityProviderStrategy: defaultCapacityProviderStrategy ?? [],
            })
            |> Effect.retry(%, {
              while: (e) =>
                e._tag === "ServiceLinkedRoleNotAssumable"
                || e._tag === "ClusterNotFoundException",
              schedule: Schedule.spaced("3 seconds"),
              times: 15,
            }))
        }
      }

      return {
        stables: ["clusterArn", "clusterName"],
        diff: effect ({ id, olds, news }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return
          if ((try toClusterName(id, olds ?? {})) !== (try toClusterName(id, resolved ?? {}))) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const clusterName = output?.clusterName ?? (try toClusterName(id, olds ?? {}))
          const described = try ecs.describeClusters({
            clusters: [output?.clusterArn ?? clusterName],
            include: ["SETTINGS", "TAGS", "CONFIGURATIONS"],
          })
          const cluster = described.clusters?.[0]
          // ECS deletion is a transition to INACTIVE. AWS may continue to
          // return an inactive cluster from DescribeClusters for a while, but
          // it is no longer a usable resource and must not be resurrected in
          // state during refresh.
          if (!cluster?.clusterArn || cluster.status === "INACTIVE") {
            return undefined
          }
          return toAttrs(
            cluster,
            Object.fromEntries(
              (cluster.tags ?? []).flatMap((t) =>
                typeof t.key === "string" && typeof t.value === "string" ? [[t.key, t.value]] : []
              ),
            ),
          )
        },
        list: effect () => {
          // Enumerate every cluster ARN in the account/region, paginating
          // listClusters exhaustively.
          const arns = Array.from(
            try (ecs.listClusters.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) => page.clusterArns ?? [])
          if (arns.length === 0) {
            return []
          }
          // describeClusters accepts at most 100 clusters per call; batch.
          const batches: string[][] = []
          for (let i = 0; i < arns.length; i += 100) {
            batches.push(arns.slice(i, i + 100))
          }
          const described = try Effect.forEach(
            batches,
            effect (clusters) =>
              (try ecs
                .describeClusters({
                  clusters,
                  include: ["SETTINGS", "TAGS", "CONFIGURATIONS"],
                })).clusters ?? [],
            { concurrency: 5 },
          )
          return described.flat().flatMap((cluster) => {
            // DeleteCluster does not immediately erase a cluster. Inactive
            // clusters can remain discoverable according to the ECS API,
            // so exclude that terminal state from nuke/provider inventory.
            if (!cluster.clusterArn || cluster.status === "INACTIVE") {
              return []
            }
            const tags = Object.fromEntries(
              (cluster.tags ?? [])
                .filter(
                  (t): t is { key: string; value: string } => typeof t.key === "string" && typeof t.value === "string",
                )
                .map((t) => [t.key, t.value]),
            )
            return [toAttrs(cluster, tags)]
          })
        },
        reconcile: effect ({ id, news: rawNews, session }) => {
          // Every ClusterProps field is optional, so `Cluster("Id")` (no
          // props object at all) is a legal instantiation — normalize.
          const news = rawNews ?? {}
          const { accountId, region } = try AWSEnvironment.current
          const clusterName = try toClusterName(id, news)
          const clusterArn = `arn:aws:ecs:${region}:${accountId}:cluster/${clusterName}` as ClusterArn
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // Observe — fetch live cloud state.
          let described = try ecs.describeClusters({
            clusters: [clusterArn],
            include: ["SETTINGS", "TAGS", "CONFIGURATIONS"],
          })
          let cluster = described.clusters?.find(
            (c) =>
              c.clusterName === clusterName
              && (c.status === "ACTIVE" || c.status === "PROVISIONING"),
          )

          // Ensure — create if missing. ECS createCluster is idempotent for
          // identical params and returns the existing cluster on conflict;
          // we always sync below regardless.
          if (!cluster?.clusterArn) {
            const created = try ecs.createCluster({
              clusterName,
              settings: news.settings,
              configuration: news.configuration,
              serviceConnectDefaults: news.serviceConnectDefaults,
              tags: toEcsTags(desiredTags),
            })
            cluster = created.cluster
          }

          // CreateCluster may return before the cluster is ready for updates.
          // Re-read its status before configuration, capacity-provider or tag writes.
          cluster = try (effect {
            return try effect {
              const response = try ecs
                .describeClusters({
                  clusters: [clusterArn],
                  include: ["SETTINGS", "TAGS", "CONFIGURATIONS"],
                })

              const observed = response.clusters?.find(
                (candidate) => candidate.clusterArn === clusterArn,
              )
              return (observed?.status === "ACTIVE" ? observed : throw new ClusterNotActive({
                cluster: clusterArn,
                status: observed?.status,
              }))
            }
          }
            |> Effect.retry(%, {
              while: (error) => error._tag === "ClusterNotActive",
              schedule: Schedule.spaced("2 seconds"),
              times: 10,
            }))

          // Sync cluster config — call updateCluster to converge settings,
          // configuration, and serviceConnectDefaults to desired state.
          try ecs.updateCluster({
            cluster: clusterArn,
            settings: news.settings,
            configuration: news.configuration,
            serviceConnectDefaults: news.serviceConnectDefaults,
          })

          // Sync capacity providers — observed ↔ desired.
          try applyCapacityProviders({
            cluster: clusterArn,
            capacityProviders: news.capacityProviders,
            defaultCapacityProviderStrategy: news.defaultCapacityProviderStrategy,
          })

          // Sync tags — diff observed cloud tags against desired.
          const observedTags = Object.fromEntries(
            (cluster?.tags ?? [])
              .filter(
                (t): t is { key: string; value: string } => typeof t.key === "string" && typeof t.value === "string",
              )
              .map((t) => [t.key, t.value]),
          )
          const { removed, upsert } = try Effect.orDie(
            Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }),
          )
          if (upsert.length > 0) {
            try ecs.tagResource({
              resourceArn: clusterArn,
              tags: upsert.map((tag) => ({ key: tag.Key, value: tag.Value })),
            })
          }
          if (removed.length > 0) {
            try ecs.untagResource({
              resourceArn: clusterArn,
              tagKeys: removed,
            })
          }

          try session.note(clusterArn)
          // Return what ECS reports, not the props: it fills in account
          // defaults (e.g. `containerInsights`) that `read` observes, so
          // echoing the props would report drift on an untouched cluster.
          const final = (try ecs.describeClusters({
            clusters: [clusterArn],
            include: ["SETTINGS", "TAGS", "CONFIGURATIONS"],
          })).clusters?.find((candidate) => candidate.clusterArn === clusterArn)
          return toAttrs(final ?? cluster, desiredTags)
        },
        delete: effect ({ output }) => {
          const cluster = output.clusterArn

          // Observe mutable associations instead of trusting persisted output:
          // capacity providers can be attached out of band or output can be
          // stale after a prior interrupted reconcile.
          const observedCluster = (try ecs.describeClusters({
            clusters: [cluster],
          })).clusters?.find((candidate) => candidate.clusterArn === cluster)

          // A cluster cannot be deleted while it still contains services,
          // running tasks, or registered container instances — empty it
          // first so deletion actually converges instead of silently
          // leaving the cluster behind.

          // 1. Delete services (force skips the scale-to-zero dance).
          const serviceArns = (effect {
            return (Array.from(
              try (ecs.listServices.pages({ cluster })
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.serviceArns ?? []))
          }) catch effect (e) => match (e) {
            when { _tag: "ClusterNotFoundException" }: [] as string[];
            default: throw e;
          }
          try Effect.forEach(
            serviceArns,
            effect (service) =>
              try (effect {
                return ecs.deleteService({ cluster, service, force: true }) catch effect (e) => match (e) {
                  when { _tag: "ServiceNotFoundException" } or { _tag: "ClusterNotFoundException" }: undefined;
                  default: throw e;
                }
              }
                |> Effect.asVoid(%)),
            { discard: true },
          )

          // 2. Stop any remaining standalone tasks.
          const taskArns = (effect {
            return (Array.from(
              try (ecs.listTasks.pages({ cluster })
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.taskArns ?? []))
          }) catch effect (e) => match (e) {
            when { _tag: "ClusterNotFoundException" }: [] as string[];
            default: throw e;
          }
          try Effect.forEach(
            taskArns,
            effect (task) =>
              try (effect {
                return ecs.stopTask({ cluster, task, reason: "alchemy delete" }) catch effect (e) => match (e) {
                  when { _tag: "ClusterNotFoundException" }: undefined;
                  default: throw e;
                }
              }
                |> Effect.asVoid(%)),
            { discard: true },
          )

          // 3. Deregister container instances (EC2 launch type).
          const instanceArns = (effect {
            return (Array.from(
              try (ecs.listContainerInstances.pages({ cluster })
                |> Stream.runCollect(%)),
            ).flatMap((page) => page.containerInstanceArns ?? []))
          }) catch effect (e) => match (e) {
            when { _tag: "ClusterNotFoundException" }: [] as string[];
            default: throw e;
          }
          try Effect.forEach(
            instanceArns,
            effect (containerInstance) =>
              try (effect {
                return ecs
                  .deregisterContainerInstance({
                    cluster,
                    containerInstance,
                    force: true,
                  }) catch effect (e) => match (e) {
                    when { _tag: "ClusterNotFoundException" }: undefined;
                    default: throw e;
                  }
              }
                |> Effect.asVoid(%)),
            { discard: true },
          )

          // 4. Remove custom capacity-provider associations. A cluster with
          //    an associated provider cannot be deleted even after its
          //    services, tasks, and container instances have drained.
          if ((observedCluster?.capacityProviders ?? output.capacityProviders).length > 0) {
            ;(effect {
              return (try (ecs
                .putClusterCapacityProviders({
                  cluster,
                  capacityProviders: [],
                  defaultCapacityProviderStrategy: [],
                })
                |> Effect.retry(%, {
                  while: (e) => e._tag === "UpdateInProgressException" || e._tag === "ResourceInUseException",
                  schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(10)]),
                })))
            }) catch effect (e) => match (e) {
              when { _tag: "ClusterNotFoundException" }: (undefined as void);
              default: throw e;
            }
          } // 5. Delete the (now empty) cluster. Draining services/tasks is
          //    asynchronous, so retry the contains-* rejections briefly.

          ;(effect {
            return (try (ecs
              .deleteCluster({
                cluster,
              })
              |> Effect.retry(%, {
                while: (e): boolean =>
                  e._tag === "ClusterContainsServicesException"
                  || e._tag === "ClusterContainsTasksException"
                  || e._tag === "ClusterContainsContainerInstancesException"
                  || e._tag === "ClusterContainsCapacityProviderException"
                  || e._tag === "UpdateInProgressException",
                schedule: Schedule.max([Schedule.fixed("3 seconds"), Schedule.recurs(15)]),
              })))
          }) catch effect (e) => match (e) {
            when { _tag: "ClusterNotFoundException" }: (undefined as void);
            default: throw e;
          }

          // DeleteCluster's successful response only means that ECS accepted
          // the transition. Observe the terminal INACTIVE state (or absence)
          // before reporting deletion so dependent teardown and a following
          // nuke pass do not race the cluster lifecycle.
          try (effect {
            return try effect {
              const response = try ecs.describeClusters({ clusters: [cluster] })

              const observed = response.clusters?.find(
                (candidate) => candidate.clusterArn === cluster,
              )
              return (!observed || observed.status === "INACTIVE" ? (undefined as void) : throw new ClusterStillActive({
                cluster,
                status: observed.status,
              }))
            }
          }
            |> Effect.retry(%, {
              while: (error) => error._tag === "ClusterStillActive",
              schedule: Schedule.max([Schedule.fixed("2 seconds"), Schedule.recurs(15)]),
            }))
        },
      }
    },
  )
