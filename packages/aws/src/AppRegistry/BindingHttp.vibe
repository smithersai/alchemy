import * as Output from "alchemy/Output"
import * as Effect from "effect/Effect"
import * as AWSBindings from "../AWSBindings.ts"
import type { Application } from "./Application.vibe"
import type { AttributeGroup } from "./AttributeGroup.vibe"

/**
 * Shared scaffolding for AppRegistry HTTP bindings.
 *
 * NOT exported from `index.ts` — every `{Op}Http.ts` in this service is a
 * thin `Layer.effect(Cap, make…HttpBinding({ … }))` over one of the three
 * builders below. Everything except the operation, the IAM action list, and
 * the injected identifier is boilerplate.
 *
 * AppRegistry IAM actions live under the `servicecatalog:` service prefix.
 */

/**
 * Build the impl Effect for an application-scoped operation: the runtime
 * callable injects the bound {@link Application}'s ID as `application` and
 * the deploy-time half grants `actions` on the application ARN.
 */
export const makeApplicationScopedHttpBinding = effect <
  I extends { mutable application: string },
  A,
  E,
  R,
>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.AppRegistry.GetApplication`. */
  mutable tag: string
  /** The distilled operation; `application` is injected from the resource. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the application ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (application: Application) => {
    const ApplicationId = try application.applicationId.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${application})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [Output.interpolate`${application.applicationArn}`],
          },
        ],
      })
    }
    return effect (
      request?: Omit<I, "application"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try op({
            ...request,
            application: try ApplicationId,
          } as I)
        },
        `${options.tag}(${application.LogicalId})`,
      )
  }
}

/**
 * Build the impl Effect for an attribute-group-scoped operation: the runtime
 * callable injects the bound {@link AttributeGroup}'s ID as `attributeGroup`
 * and the deploy-time half grants `actions` on the attribute group ARN.
 */
export const makeAttributeGroupScopedHttpBinding = effect <
  I extends { mutable attributeGroup: string },
  A,
  E,
  R,
>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.AppRegistry.GetAttributeGroup`. */
  mutable tag: string
  /** The distilled operation; `attributeGroup` is injected from the resource. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the attribute group ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (attributeGroup: AttributeGroup) => {
    const AttributeGroupId = try attributeGroup.attributeGroupId.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${attributeGroup})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [Output.interpolate`${attributeGroup.attributeGroupArn}`],
          },
        ],
      })
    }
    return effect (
      request?: Omit<I, "attributeGroup"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try op({
            ...request,
            attributeGroup: try AttributeGroupId,
          } as I)
        },
        `${options.tag}(${attributeGroup.LogicalId})`,
      )
  }
}

/**
 * Build the impl Effect for an account-level operation (no target resource).
 * The deploy-time half grants `actions` on `*`.
 */
export const makeAppRegistryAccountHttpBinding = effect <I, A, E, R>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.AppRegistry.SyncResource`. */
  mutable tag: string
  /** The distilled operation, invoked with the caller's request as-is. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on `*`. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect () => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}()`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: ["*"],
          },
        ],
      })
    }
    return effect (request?: I | undefined) =>
      try withSpan(
        effect {
          return try op((request ?? {}) as I)
        },
        options.tag,
      )
  }
}
