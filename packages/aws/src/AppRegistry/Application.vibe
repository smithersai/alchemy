import * as appregistry from "@distilled.cloud/aws/service-catalog-appregistry"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags, tagRecord } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { clientToken, stripAwsSystemTags } from "./internal.ts"

export interface ApplicationProps {
  /**
   * Name of the application. Must be unique in the account and region and
   * may only contain letters, numbers, dots, dashes, and underscores.
   * If omitted, a unique name is generated. Changing it replaces the
   * application.
   */
  mutable applicationName?: string
  /**
   * Description of the application. Updatable in place.
   */
  mutable description?: string
  /**
   * Tags to apply to the application. Merged with internal Alchemy tags.
   */
  mutable tags?: Record<string, string>
}

export interface Application extends
  Resource<
    "AWS.AppRegistry.Application",
    ApplicationProps,
    {
      /** The auto-generated application ID. */
      mutable applicationId: string
      /** The ARN of the application. */
      mutable applicationArn: string
      /** The name of the application. */
      mutable applicationName: string
    },
    never,
    Providers
  >
{}

/**
 * An AWS Service Catalog AppRegistry application — the top-level node that
 * groups related cloud resources and metadata under a single logical
 * application (surfaced in myApplications and the `awsApplication` tag).
 *
 * ### Creating an Application
 * **Example:** Basic Application
 * ```typescript
 * import * as AppRegistry from "@alchemy.run/aws/AppRegistry";
 *
 * const app = yield* AppRegistry.Application("Storefront", {});
 * ```
 *
 * **Example:** Application with Description and Tags
 * ```typescript
 * const app = yield* AppRegistry.Application("Storefront", {
 *   applicationName: "storefront",
 *   description: "Customer-facing storefront services",
 *   tags: { team: "commerce" },
 * });
 * ```
 *
 * @resource
 */
export const Application = Resource<Application>("AWS.AppRegistry.Application")

export const ApplicationProvider = (): infer _ =>
  Provider.effect(
    Application,
    effect {
      const createName = effect (
        id: string,
        props: Pick<ApplicationProps, "applicationName">,
      ) => props.applicationName ?? (try createPhysicalName({ id, maxLength: 256 }))

      // getApplication accepts a name, ID, or ARN specifier.
      const observe = effect (specifier: string) =>
        appregistry
          .getApplication({ application: specifier }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: try Effect.undefined;
            default: throw e;
          }

      return Application.Provider.of({
        stables: ["applicationId", "applicationArn", "applicationName"],
        list: effect () =>
          Array.from(
            try (appregistry.listApplications.pages({})
              |> Stream.runCollect(%)),
          )
            .flatMap((page) => page.applications ?? [])
            .filter((a) => a.id != null && a.arn != null && a.name != null)
            .map((a) => ({
              applicationId: a.id!,
              applicationArn: a.arn!,
              applicationName: a.name!,
            })),
        read: effect ({ id, olds, output }) => {
          const specifier = output?.applicationId ?? (try createName(id, olds ?? {}))
          const found = try observe(specifier)
          if (!found?.id) return undefined
          const attrs = {
            applicationId: found.id,
            applicationArn: found.arn!,
            applicationName: found.name!,
          }
          return (try hasAlchemyTags(id, tagRecord(found.tags))) ? attrs : Unowned(attrs)
        },
        // The application name is its user-facing identity — changing it
        // replaces the application.
        diff: effect ({ id, olds, news }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (oldName !== newName) return { action: "replace" } as const
        },
        reconcile: effect ({ id, news, output, session, instanceId }) => {
          const applicationName = try createName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags: Record<string, string> = {
            ...news.tags,
            ...internalTags,
          }

          // 1. OBSERVE — cloud is authoritative; output caches the ID only.
          let found = output?.applicationId ? try observe(output.applicationId) : undefined
          if (!found?.id) {
            found = try observe(applicationName)
          }

          // 2. ENSURE — create when missing; tolerate a concurrent-create
          // race (ConflictException) by re-reading.
          if (!found?.id) {
            appregistry
              .createApplication({
                name: applicationName,
                description: news.description,
                tags: desiredTags,
                clientToken: clientToken(instanceId),
              }) catch effect (e) => match (e) { when { _tag: "ConflictException" }: try Effect.void; default: throw e; }
            found = try observe(applicationName)
          }

          const applicationId = found!.id!
          const applicationArn = found!.arn!

          // 3a. SYNC description — apply only when it actually changed.
          if (news.description !== undefined && found!.description !== news.description) {
            try appregistry.updateApplication({
              application: applicationId,
              description: news.description,
            })
          }

          // 3b. SYNC tags — diff against OBSERVED cloud tags so adoption
          // converges.
          const observedTags = stripAwsSystemTags(tagRecord(found!.tags))
          const { upsert, removed } = diffTags(observedTags, desiredTags)
          if (upsert.length > 0) {
            try appregistry.tagResource({
              resourceArn: applicationArn,
              tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
            })
          }
          if (removed.length > 0) {
            try appregistry.untagResource({
              resourceArn: applicationArn,
              tagKeys: removed,
            })
          }

          try session.note(applicationId)
          return {
            applicationId,
            applicationArn,
            applicationName,
          }
        },
        delete: effect ({ output }) => {
          appregistry
            .deleteApplication({ application: output.applicationId }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
        },
      })
    },
  )
