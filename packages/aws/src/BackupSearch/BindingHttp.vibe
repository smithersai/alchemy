import * as Output from "alchemy/Output"
import * as Effect from "effect/Effect"
import * as AWSBindings from "../AWSBindings.ts"
import type { SearchJob } from "./SearchJob.vibe"

/**
 * Shared scaffolding for BackupSearch HTTP bindings.
 *
 * NOT exported from `index.ts` — every `{Op}Http.ts` in this service is a
 * thin `Layer.effect(Cap, makeSearchJobScopedHttpBinding({ … }))` over the
 * builder below. Everything except the operation and the IAM action list is
 * boilerplate.
 *
 * BackupSearch IAM actions live under the `backup-search:` service prefix.
 */

/**
 * Build the impl Effect for a search-job-scoped operation: the runtime
 * callable injects the bound {@link SearchJob}'s identifier as
 * `SearchJobIdentifier` and the deploy-time half grants `actions` on the
 * search job ARN.
 */
export const makeSearchJobScopedHttpBinding = effect <
  I extends { mutable SearchJobIdentifier: string },
  A,
  E,
  R,
>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.BackupSearch.ListSearchJobResults`. */
  mutable tag: string
  /** The distilled operation; `SearchJobIdentifier` is injected from the resource. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the search job ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try AWSBindings.withCredentials(options.operation)

  return effect (searchJob: SearchJob) => {
    const SearchJobIdentifier = try searchJob.searchJobIdentifier.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${searchJob})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [Output.interpolate`${searchJob.searchJobArn}`],
          },
        ],
      })
    }
    return effect (
      request?: Omit<I, "SearchJobIdentifier"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try op({
            ...request,
            SearchJobIdentifier: try SearchJobIdentifier,
          } as I)
        },
        `${options.tag}(${searchJob.LogicalId})`,
      )
  }
}
