import * as Layer from "effect/Layer"
import { Converse } from "./Converse.vibe"
import { ConverseHttp } from "./ConverseHttp.vibe"
import { ConverseStream } from "./ConverseStream.vibe"
import { ConverseStreamHttp } from "./ConverseStreamHttp.vibe"
import { LanguageModel, type LanguageModelOptions, makeLanguageModelLayer } from "./LanguageModel.vibe"

/**
 * HTTP implementation of {@link LanguageModel}. Composes the {@link Converse}
 * and {@link ConverseStream} bindings, so binding a model registers both
 * `bedrock:InvokeModel` and `bedrock:InvokeModelWithResponseStream` scoped to
 * exactly that model.
 */
export const LanguageModelHttp = Layer.effect(
  LanguageModel,
  effect {
    const converse = try Effect.service(Converse)
    const converseStream = try Effect.service(ConverseStream)
    return effect (
      model: string | readonly [string, ...string[]],
      options?: LanguageModelOptions | undefined,
    ) => {
      const [first, ...rest] = typeof model === "string" ? [model] : model
      return makeLanguageModelLayer({
        converse: try converse(first, ...rest),
        converseStream: try converseStream(first, ...rest),
        parameters: options?.parameters,
      })
    }
  },
).pipe(Layer.provide(Layer.mergeAll(ConverseHttp, ConverseStreamHttp)))
