import * as Effect from "effect/Effect"
import * as iot from "@distilled.cloud/aws/iot"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.vibe"

export interface ThingProps {
  /**
   * Name of the thing. Must be unique in your account and region and may only
   * contain letters, numbers, colons, underscores, and hyphens.
   * If omitted, a unique name is generated. Changing it replaces the thing.
   */
  thingName?: string

  /**
   * Name of the {@link ThingType} to associate with this thing.
   */
  thingTypeName?: string

  /**
   * A set of string attributes (key/value pairs) to store on the thing.
   */
  attributes?: Record<string, string>
}

export interface Thing extends
  Resource<
    "AWS.IoT.Thing",
    ThingProps,
    {
      /** The name of the thing. */
      thingName: string
      /** The ARN of the thing. */
      thingArn: string
    },
    never,
    Providers
  >
{}

/**
 * An AWS IoT Thing — the cloud representation of a physical device.
 *
 * ### Creating a Thing
 * **Example:** Basic Thing
 * ```typescript
 * const thing = yield* Thing("sensor", {});
 * ```
 *
 * **Example:** Thing with Attributes
 * ```typescript
 * const thing = yield* Thing("sensor", {
 *   thingName: "temperature-sensor-01",
 *   attributes: { location: "warehouse-a", model: "acme-t1000" },
 * });
 * ```
 *
 * @resource
 */
export const Thing = Resource<Thing>("AWS.IoT.Thing")

export const ThingProvider = (): infer _ =>
  Provider.effect(
    Thing,
    effect {
      const createName = effect (id: string, props: ThingProps) => props.thingName ?? (try createPhysicalName({ id }))

      return Thing.Provider.of({
        stables: ["thingName", "thingArn"],
        list: effect () =>
          Array.from(
            try (iot.listThings.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.things ?? [])
              .filter((t) => t.thingName != null && t.thingArn != null)
              .map((t) => ({
                thingName: t.thingName!,
                thingArn: t.thingArn!,
              }))
          ),
        read: effect ({ id, olds, output }) => {
          const thingName = output?.thingName ?? (try createName(id, olds ?? {}))
          const found = iot
            .describeThing({ thingName }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined;
              default: throw e;
            }
          if (!found) return undefined
          return {
            thingName,
            thingArn: found.thingArn!,
          }
        },
        diff: effect ({ id, news: _newsInput = {}, olds = {} }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (oldName !== newName) return { action: "replace" } as const
          return undefined
        },
        reconcile: effect ({ id, news = {}, output, session }) => {
          const thingName = output?.thingName ?? (try createName(id, news))

          // 1. OBSERVE — cloud is authoritative; output is only an id cache.
          let live = iot
            .describeThing({ thingName }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined;
              default: throw e;
            }

          // 2. ENSURE — create if missing; tolerate an AlreadyExists race.
          if (live === undefined) {
            iot
              .createThing({
                thingName,
                thingTypeName: news.thingTypeName,
                attributePayload: news.attributes ? { attributes: news.attributes } : undefined,
              }) catch effect (e) => match (e) {
                when { _tag: "ResourceAlreadyExistsException" }: (undefined as void);
                default: throw e;
              }
            live = try iot.describeThing({ thingName })
          } else {
            // 3. SYNC — converge attributes + thing type to desired.
            const desiredAttrs = news.attributes ?? {}
            const observedAttrs = live.attributes ?? {}
            const attrsChanged = JSON.stringify(desiredAttrs) !== JSON.stringify(observedAttrs)
            const typeChanged = (news.thingTypeName ?? undefined) !== (live.thingTypeName ?? undefined)
            if (attrsChanged || typeChanged) {
              try iot.updateThing({
                thingName,
                thingTypeName: news.thingTypeName,
                removeThingType: news.thingTypeName === undefined && live.thingTypeName !== undefined
                  ? true
                  : undefined,
                attributePayload: attrsChanged
                  ? { attributes: desiredAttrs, merge: false }
                  : undefined,
              })
              live = try iot.describeThing({ thingName })
            }
          }

          try session.note(thingName)
          return {
            thingName,
            thingArn: live.thingArn!,
          }
        },
        delete: effect ({ output }) => {
          iot
            .deleteThing({ thingName: output.thingName }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: (undefined as void);
              default: throw e;
            }
        },
      })
    },
  )
