import * as Effect from "effect/Effect"
import * as glue from "@distilled.cloud/aws/glue"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import * as Redacted from "effect/Redacted"
import { AWSEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import { connectionArn, fetchObservedTags, syncTags } from "./internal.vibe"

export type GlueConnectionType =
  | "JDBC"
  | "SFTP"
  | "MONGODB"
  | "KAFKA"
  | "NETWORK"
  | "MARKETPLACE"
  | "CUSTOM"
  | (string & {})

export interface ConnectionProps {
  /**
   * Name of the connection. If omitted, a unique name is generated. Changing
   * the name replaces the connection.
   * @default a generated physical name
   */
  connectionName?: string
  /**
   * The type of connection. `JDBC` is the common relational case.
   */
  connectionType: GlueConnectionType
  /**
   * A description of the connection.
   */
  description?: string
  /**
   * Connection-type-specific properties, e.g. for `JDBC`:
   * `{ JDBC_CONNECTION_URL, USERNAME, PASSWORD }`. Secret values (e.g.
   * `PASSWORD`) should be wrapped with `Redacted.make(...)` so they are
   * kept out of logs and state output.
   */
  connectionProperties: Record<string, string | Redacted.Redacted<string>>
  /**
   * Criteria used to match connections (for MATCH_CRITERIA lookups).
   */
  matchCriteria?: string[]
  /**
   * VPC networking requirements — required for connections that reach into a
   * VPC (e.g. JDBC to an RDS instance).
   */
  physicalConnectionRequirements?: {
    /** The subnet the connection uses. */
    subnetId?: string
    /** Security group IDs applied to the connection's ENI. */
    securityGroupIdList?: string[]
    /** The availability zone (must match the subnet). */
    availabilityZone?: string
  }
  /**
   * The AWS account ID of the Data Catalog. Changing it replaces the
   * connection.
   * @default the caller's account (the default Data Catalog)
   */
  catalogId?: string
  /**
   * Tags to apply to the connection. Merged with internal Alchemy tags.
   */
  tags?: Record<string, string>
}

export interface Connection extends
  Resource<
    "AWS.Glue.Connection",
    ConnectionProps,
    {
      /** The name of the connection. */
      connectionName: string
      /** The ARN of the connection. */
      connectionArn: string
      /** The connection type, e.g. `JDBC`. */
      connectionType: string
      /** The AWS account ID of the Data Catalog the connection lives in. */
      catalogId: string
    },
    {},
    Providers
  >
{}

/**
 * An AWS Glue connection — stores the connection details (JDBC URL, VPC
 * networking, credentials) that crawlers and jobs use to reach a data store.
 * ### Creating Connections
 * **Example:** JDBC Connection
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 * import * as Redacted from "effect/Redacted";
 *
 * const connection = yield* AWS.Glue.Connection("Warehouse", {
 *   connectionType: "JDBC",
 *   connectionProperties: {
 *     JDBC_CONNECTION_URL: "jdbc:postgresql://db.example.com:5432/warehouse",
 *     USERNAME: "glue",
 *     PASSWORD: Redacted.make("secret"),
 *   },
 *   physicalConnectionRequirements: {
 *     subnetId: subnet.subnetId,
 *     securityGroupIdList: [securityGroup.groupId],
 *     availabilityZone: "us-west-2a",
 *   },
 * });
 * ```
 *
 * @resource
 */
export const Connection = Resource<Connection>("AWS.Glue.Connection")

export const ConnectionProvider = (): infer _ =>
  Provider.effect(
    Connection,
    effect {
      const createName = effect (
        id: string,
        props: { connectionName?: string | undefined },
      ) => props.connectionName ?? (try createPhysicalName({ id, maxLength: 255 }))

      const observe = effect (name: string, catalogId: string | undefined) =>
        (effect {
          return (try glue
            .getConnection({
              Name: name,
              CatalogId: catalogId,
              HidePassword: true,
            })).Connection
        }) catch effect (e) => match (e) {
          when { _tag: "EntityNotFoundException" }: undefined;
          default: throw e;
        }

      const buildInput = (name: string, props: ConnectionProps): infer _ => ({
        Name: name,
        ConnectionType: props.connectionType,
        Description: props.description,
        ConnectionProperties: Object.fromEntries(
          Object.entries(props.connectionProperties).map(([key, value]) => [
            key,
            Redacted.isRedacted(value) ? Redacted.value(value) : value,
          ]),
        ),
        MatchCriteria: props.matchCriteria,
        PhysicalConnectionRequirements: props.physicalConnectionRequirements
          ? {
            SubnetId: props.physicalConnectionRequirements.subnetId,
            SecurityGroupIdList: props.physicalConnectionRequirements.securityGroupIdList,
            AvailabilityZone: props.physicalConnectionRequirements.availabilityZone,
          }
          : undefined,
      })

      return Connection.Provider.of({
        stables: ["connectionName", "connectionArn", "catalogId"],

        list: effect () => {
          const { accountId, region } = try AWSEnvironment.current
          const pages = try glue.getConnections.pages({}).pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.ConnectionList ?? [])
            .filter((c) => c.Name !== undefined)
            .map((c) => ({
              connectionName: c.Name!,
              connectionArn: connectionArn(region, accountId, c.Name!),
              connectionType: c.ConnectionType ?? "",
              catalogId: accountId,
            }))
        },

        read: effect ({ id, olds, output }) => {
          const { accountId, region } = try AWSEnvironment.current
          const catalogId = output?.catalogId ?? olds?.catalogId ?? accountId
          const name = output?.connectionName ?? (try createName(id, olds ?? {}))
          const connection = try observe(name, catalogId)
          if (connection?.Name === undefined) return undefined
          const connectionName2 = connection.Name
          const arn = try Effect.orDie(
            Effect.try({ try: () => connectionArn(region, accountId, connectionName2), catch: (e) => e }),
          )
          const attrs = {
            connectionName: connection.Name,
            connectionArn: arn,
            connectionType: connection.ConnectionType ?? "",
            catalogId,
          }
          const tags = try fetchObservedTags(arn)
          return (try hasAlchemyTags(id, tags))
            ? attrs
            : (try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (error) => error })))
        },

        diff: effect ({ id, news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (oldName !== newName) return { action: "replace" } as const
          if ((olds.catalogId ?? undefined) !== (news.catalogId ?? undefined)) {
            return { action: "replace" } as const
          }
          // type / properties / networking / description → update
        },

        reconcile: effect ({ id, news, output, session }) => {
          const { accountId, region } = try AWSEnvironment.current
          const catalogId = news.catalogId ?? output?.catalogId ?? accountId
          const name = output?.connectionName ?? (try createName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }
          const arn = try Effect.orDie(
            Effect.try({ try: () => connectionArn(region, accountId, name), catch: (e) => e }),
          )
          const input = buildInput(name, news)

          // 1. OBSERVE
          const existing = try observe(name, catalogId)

          // 2. ENSURE / 3. SYNC
          if (existing === undefined) {
            glue
              .createConnection({
                CatalogId: catalogId,
                ConnectionInput: input,
                Tags: desiredTags,
              }) catch effect (e) => match (e) {
                when { _tag: "AlreadyExistsException" }: undefined as void;
                default: throw e;
              }
          } else {
            try glue.updateConnection({
              CatalogId: catalogId,
              Name: name,
              ConnectionInput: input,
            })
          }

          // 3b. SYNC TAGS
          const observedTags = try fetchObservedTags(arn)
          try syncTags(arn, observedTags, desiredTags)

          try session.note(name)
          return {
            connectionName: name,
            connectionArn: arn,
            connectionType: news.connectionType,
            catalogId,
          }
        },

        delete: effect ({ output }) => {
          glue
            .deleteConnection({
              ConnectionName: output.connectionName,
              CatalogId: output.catalogId,
            }) catch effect (e) => match (e) {
              when { _tag: "EntityNotFoundException" }: undefined as void;
              default: throw e;
            }
        },
      })
    },
  )
