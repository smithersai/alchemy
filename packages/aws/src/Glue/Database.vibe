import * as glue from "@distilled.cloud/aws/glue"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import { AWSEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import { cleanMap, databaseArn, deleteGlueDatabase, retryWhileConcurrentModification } from "./internal.ts"

export interface DatabaseProps {
  /**
   * Name of the database. Glue lowercases database names, so provide a
   * lowercase name. If omitted, a unique lowercase name is generated.
   * Changing the name replaces the database.
   * @default a generated lowercase physical name
   */
  databaseName?: string
  /**
   * A description of the database.
   */
  description?: string
  /**
   * The location of the database (for example, an S3 path) used as the
   * default for tables that do not specify their own location.
   */
  locationUri?: string
  /**
   * Free-form key/value properties stored on the database. Alchemy adds its
   * own `alchemy::*` ownership markers to this map (Glue databases are not
   * ARN-taggable) — user keys are preserved alongside them.
   */
  parameters?: Record<string, string>
  /**
   * The AWS account ID of the Data Catalog the database lives in. Changing it
   * replaces the database.
   * @default the caller's account (the default Data Catalog)
   */
  catalogId?: string
}

export interface Database extends
  Resource<
    "AWS.Glue.Database",
    DatabaseProps,
    {
      /** The (lowercase) name of the database. */
      databaseName: string
      /** The ARN of the database. */
      databaseArn: string
      /** The AWS account ID of the Data Catalog the database lives in. */
      catalogId: string
      /**
       * Description, location and parameters (including the ownership
       * markers), as observed. Lets `alchemy drift` detect out-of-band
       * changes.
       */
      configuration?: {
        description?: string
        locationUri?: string
        parameters: Record<string, string>
      }
    },
    {},
    Providers
  >
{}

/**
 * An AWS Glue Data Catalog database — the top-level container for Glue tables
 * that Athena, EMR, Redshift Spectrum, and Glue jobs query. Databases are free
 * and instant to create.
 * ### Creating Databases
 * **Example:** Basic Database
 * ```typescript
 * import * as AWS from "@alchemy.run/aws";
 *
 * const database = yield* AWS.Glue.Database("Analytics", {
 *   databaseName: "analytics",
 * });
 * ```
 *
 * **Example:** Database with a Default S3 Location
 * ```typescript
 * const database = yield* AWS.Glue.Database("Analytics", {
 *   databaseName: "analytics",
 *   description: "Curated analytics tables",
 *   locationUri: "s3://my-data-lake/analytics/",
 *   parameters: { classification: "parquet" },
 * });
 * ```
 *
 * @resource
 */
export const Database = Resource<Database>("AWS.Glue.Database")

/**
 * The settings `read` and `reconcile` both report, so a converged database
 * reads unchanged.
 */
const observeDatabaseConfiguration = (db: glue.Database): infer _ => ({
  description: db.Description || undefined,
  locationUri: db.LocationUri || undefined,
  parameters: cleanMap(db.Parameters),
})

export const DatabaseProvider = (): infer _ =>
  Provider.effect(
    Database,
    effect {
      const createName = effect (
        id: string,
        props: { databaseName?: string | undefined },
      ) => (
        props.databaseName ?? (try createPhysicalName({ id, maxLength: 255, lowercase: true }))
      )

      const observe = effect (name: string, catalogId: string | undefined) =>
        (try glue.getDatabase({ Name: name, CatalogId: catalogId })).Database catch effect (e) => match (e) {
          when { _tag: "EntityNotFoundException" }: try Effect.undefined;
          default: throw e;
        }

      return Database.Provider.of({
        stables: ["databaseName", "databaseArn", "catalogId"],

        list: effect () => {
          const { accountId, region } = try AWSEnvironment.current
          const pages = try glue.getDatabases.pages({}).pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.DatabaseList ?? [])
            .map((db) => ({
              databaseName: db.Name,
              databaseArn: databaseArn(region, db.CatalogId ?? accountId, db.Name),
              catalogId: db.CatalogId ?? accountId,
            }))
        },

        read: effect ({ id, olds, output }) => {
          const { accountId, region } = try AWSEnvironment.current
          const catalogId = output?.catalogId ?? olds?.catalogId ?? accountId
          const name = output?.databaseName ?? (try createName(id, olds ?? {}))
          const db = try observe(name, catalogId)
          if (db === undefined) return undefined
          const attrs = {
            databaseName: db.Name,
            databaseArn: databaseArn(region, db.CatalogId ?? catalogId, db.Name),
            catalogId: db.CatalogId ?? catalogId,
            configuration: observeDatabaseConfiguration(db),
          }
          // Glue databases are not ARN-taggable — ownership markers live in
          // the database Parameters map.
          return (try hasAlchemyTags(id, cleanMap(db.Parameters))) ? attrs : Unowned(attrs)
        },

        diff: effect ({ id, news, olds }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds)
          const newName = try createName(id, news)
          if (oldName !== newName) return { action: "replace" } as const
          if ((olds.catalogId ?? undefined) !== (news.catalogId ?? undefined)) {
            return { action: "replace" } as const
          }
          // description / locationUri / parameters → update
        },

        reconcile: effect ({ id, news, output, session }) => {
          const { accountId, region } = try AWSEnvironment.current
          const catalogId = news.catalogId ?? output?.catalogId ?? accountId
          const name = output?.databaseName ?? (try createName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredParameters = { ...news.parameters, ...internalTags }

          const databaseInput = {
            Name: name,
            Description: news.description,
            LocationUri: news.locationUri,
            Parameters: desiredParameters,
          }

          // 1. OBSERVE
          let db = try observe(name, catalogId)

          // 2. ENSURE
          if (db === undefined) {
            try (effect {
              return glue
                .createDatabase({
                  CatalogId: catalogId,
                  DatabaseInput: databaseInput,
                }) catch effect (e) => match (e) {
                  when { _tag: "AlreadyExistsException" }: try Effect.void;
                  default: throw e;
                }
            }
              |> retryWhileConcurrentModification(%))
            db = try observe(name, catalogId)
          } else {
            // 3. SYNC — UpdateDatabase replaces the full DatabaseInput.
            try (glue
              .updateDatabase({
                CatalogId: catalogId,
                Name: name,
                DatabaseInput: databaseInput,
              })
              |> retryWhileConcurrentModification(%))
            db = try observe(name, catalogId)
          }

          try session.note(name)
          return {
            databaseName: name,
            databaseArn: databaseArn(region, db?.CatalogId ?? catalogId, name),
            catalogId: db?.CatalogId ?? catalogId,
            configuration: db && observeDatabaseConfiguration(db),
          }
        },

        delete: effect ({ output }) => {
          try deleteGlueDatabase(output.databaseName, output.catalogId)
        },
      })
    },
  )
