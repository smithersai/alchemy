import * as Effect from "effect/Effect"
import type * as TSW from "@distilled.cloud/aws/timestream-write"
import * as Output from "alchemy/Output"
import { makeBatchedSink } from "alchemy/Util/BatchedSink"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { RecordsSink, type RecordsSinkProps, type RecordsSinkRecord } from "./RecordsSink.vibe"
import type { Table } from "./Table.vibe"
import { WriteRecords } from "./WriteRecords.vibe"

/**
 * Normalized `WriteRecords` outcome: which positions of the submitted batch
 * Timestream permanently rejected. A fully-ingested call has no rejections.
 */
interface WriteOutcome {
  readonly rejectedIndices: ReadonlySet<number>
}

const noRejections: WriteOutcome = { rejectedIndices: new Set() }

type WriteSendError = Exclude<
  TSW.WriteRecordsError | TSW.DescribeEndpointsError,
  TSW.RejectedRecordsException
>

export const RecordsSinkHttp = Layer.effect(
  RecordsSink,
  effect {
    const bind = try AWSBindings.Bind
    const writeRecords = try WriteRecords

    return effect (table: Table, props?: RecordsSinkProps | undefined) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.Timestream.RecordsSink(${table})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["timestream:WriteRecords"],
              Resource: [Output.interpolate`${table.tableArn}`],
            },
            // Timestream requires endpoint discovery; the ingest endpoint
            // is resolved at runtime via DescribeEndpoints, which is not
            // scoped to a resource.
            {
              Effect: "Allow",
              Action: ["timestream:DescribeEndpoints"],
              Resource: ["*"],
            },
          ],
        })
      }
      const write = try writeRecords(table)
      const commonAttributes = props?.commonAttributes
      return (try effect {
        const sinkOptions: Parameters<typeof makeBatchedSink<RecordsSinkRecord, WriteOutcome, WriteSendError>>[0] = {
          maxRecords: 100,
          send: effect (batch) =>
            write({
              Records: [...batch],
              ...(commonAttributes === undefined ? {} : { CommonAttributes: commonAttributes }),
            })
            |> Effect.map(%, () => noRejections)
            // Timestream ingests the valid subset and reports invalid records
            // positionally via RejectedRecordsException. Rejections are
            // permanent (schema conflicts, out-of-retention timestamps,
            // version conflicts) — drop them, never retry.
            |> try Effect.catchTag(
              %,
              "RejectedRecordsException",
              effect (error) =>
                try Effect.succeed<WriteOutcome>({
                  rejectedIndices: new Set(
                    try Effect.orDie(Effect.try({
                      try: () =>
                        (error.RejectedRecords ?? []).flatMap(effect (rejected: TSW.RejectedRecord) =>
                          rejected.RecordIndex === undefined ? [] : [rejected.RecordIndex]
                        ),
                      catch: (e) => e,
                    })),
                  ),
                }),
            ),
          rejected: (out, batch): infer _ =>
            out.rejectedIndices.size === 0
              ? []
              : batch.filter((_, index) => out.rejectedIndices.has(index)),
        }
        return try Effect.orDie(
          Effect.try({
            try: () => makeBatchedSink<RecordsSinkRecord, WriteOutcome, WriteSendError>(sinkOptions),
            catch: (error) => error,
          }),
        )
      })
    }
  },
)
