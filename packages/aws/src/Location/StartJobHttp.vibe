import * as location from "@distilled.cloud/aws/location"
import * as Output from "alchemy/Output"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import type { Role } from "../IAM/Role.vibe"
import { StartJob, type StartJobRequest } from "./StartJob.vibe"

/**
 * Bespoke (not via `BindingHttp.ts`): StartJob is the one Location binding
 * that injects an identifier from a *foreign* resource (the IAM execution
 * role) and needs a second `iam:PassRole` grant alongside the `geo:` action.
 */
export const StartJobHttp = Layer.effect(
  StartJob,
  effect {
    const bind = try AWSBindings.Bind
    const startJob = try AWSBindings.withCredentials(location.startJob)

    return effect (executionRole: Role) => {
      const RoleArn = try executionRole.roleArn.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.Location.StartJob(${executionRole})`({
          policyStatements: [
            // Jobs are named at runtime, so their ARNs are unknowable at
            // deploy time.
            {
              Effect: "Allow",
              Action: ["geo:StartJob"],
              Resource: ["*"],
            },
            // CRITICAL: without iam:PassRole on the execution role,
            // StartJob fails only at runtime with an AccessDenied.
            {
              Effect: "Allow",
              Action: ["iam:PassRole"],
              Resource: [Output.interpolate`${executionRole.roleArn}`],
              Condition: {
                StringEquals: {
                  "iam:PassedToService": "location.amazonaws.com",
                },
              },
            },
          ],
        })
      }
      return effect (
        request: StartJobRequest,
      ) =>
        try withSpan(
          effect {
            return try startJob({
              ...request,
              ExecutionRoleArn: try RoleArn,
            })
          },
          `AWS.Location.StartJob(${executionRole.LogicalId})`,
        )
    }
  },
)
