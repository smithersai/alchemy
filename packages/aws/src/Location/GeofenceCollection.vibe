import * as location from "@distilled.cloud/aws/location"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags, type Tags } from "alchemy/Tags"
import * as EffectStream from "effect/Stream"
import type { Providers } from "../Providers.vibe"
import { toTagRecord } from "./internal.ts"

export error GeofenceCollectionUnexpectedResponse {
  message: string
  cause?: unknown
}

export interface GeofenceCollectionProps {
  /**
   * Name of the geofence collection. Immutable — changing it replaces the
   * collection.
   * @default ${app}-${stage}-${id}
   */
  collectionName?: string
  /**
   * KMS key ID used to encrypt the collection's geofence data. Immutable —
   * changing it replaces the collection.
   */
  kmsKeyId?: string
  /**
   * Optional description of the geofence collection.
   */
  description?: string
  /**
   * Tags to associate with the geofence collection.
   */
  tags?: Record<string, string>
}

export interface GeofenceCollection extends
  Resource<
    "AWS.Location.GeofenceCollection",
    GeofenceCollectionProps,
    {
      /** Physical name of the geofence collection. */
      collectionName: string
      /** ARN of the geofence collection. */
      collectionArn: string
      /** KMS key ID backing the collection, if configured. */
      kmsKeyId: string | undefined
      /** Description of the collection. */
      description: string | undefined
      /** Tags currently associated with the collection. */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An Amazon Location Service geofence collection. A geofence collection stores
 * geofences and evaluates device positions against them. The KMS key is
 * immutable; the description can be updated in place.
 *
 * ### Creating Geofence Collections
 * **Example:** Basic Geofence Collection
 * ```typescript
 * import * as Location from "@alchemy.run/aws/Location";
 *
 * const collection = yield* Location.GeofenceCollection("Fences", {});
 * ```
 *
 * **Example:** Encrypted Geofence Collection
 * ```typescript
 * const collection = yield* Location.GeofenceCollection("SecureFences", {
 *   kmsKeyId: "alias/my-key",
 *   description: "Encrypted geofence collection",
 * });
 * ```
 *
 * @resource
 */
export const GeofenceCollection = Resource<GeofenceCollection>("AWS.Location.GeofenceCollection")

const createCollectionName = effect (id: string, props: { collectionName?: string | undefined }) => {
  if (props.collectionName) return props.collectionName
  return try createPhysicalName({ id, maxLength: 100 })
}

const readCollection = effect (collectionName: string) => {
  const found = location
    .describeGeofenceCollection({ CollectionName: collectionName }) catch effect (e) => match (e) {
      when { _tag: "ResourceNotFoundException" }: undefined;
      default: throw e;
    }
  if (!found) return undefined
  return {
    collectionName: found.CollectionName,
    collectionArn: found.CollectionArn,
    kmsKeyId: found.KmsKeyId,
    description: found.Description ? found.Description : undefined,
    tags: try Effect.orDie(Effect.try({ try: () => toTagRecord(found.Tags), catch: (e) => e })),
  } satisfies GeofenceCollection["Attributes"]
}

export const GeofenceCollectionProvider = (): infer _ =>
  Provider.effect(
    GeofenceCollection,
    effect {
      return {
        stables: ["collectionName", "collectionArn"],
        list: effect () => {
          const names = Array.from(
            try (location.listGeofenceCollections.pages({})
              |> EffectStream.runCollect(%)),
          ).flatMap((page) => (page.Entries ?? []).map((entry) => entry.CollectionName))
          const hydrated = try Effect.forEach(names, effect (name) => try readCollection(name), {
            concurrency: 10,
          })
          return hydrated.filter(
            (attrs): attrs is GeofenceCollection["Attributes"] => attrs !== undefined,
          )
        },
        read: effect ({ id, olds, output }) => {
          const collectionName = output?.collectionName ?? (try createCollectionName(id, olds ?? {}))
          const state = try readCollection(collectionName)
          if (!state) return undefined
          return (try hasAlchemyTags(id, state.tags as Tags))
            ? state
            : try Effect.orDie(Effect.try({ try: () => Unowned(state), catch: (e) => e }))
        },
        diff: effect ({ id, news = {}, olds = {} }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return
          const oldName = try createCollectionName(id, olds)
          const newName = try createCollectionName(id, resolved)
          if (oldName !== newName || olds.kmsKeyId !== resolved.kmsKeyId) {
            return { action: "replace" } as const
          }
        },
        reconcile: effect ({ id, news = {}, output, session }) => {
          const collectionName = output?.collectionName ?? (try createCollectionName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          let state = try readCollection(collectionName)

          if (state === undefined) {
            location
              .createGeofenceCollection({
                CollectionName: collectionName,
                KmsKeyId: news.kmsKeyId,
                Description: news.description,
                Tags: desiredTags,
              }) catch effect (e) => match (e) {
                when { _tag: "ConflictException" }: undefined as void;
                default: throw e;
              }
            state = try readCollection(collectionName)
            if (state === undefined) {
              throw new GeofenceCollectionUnexpectedResponse({
                message: `failed to read created geofence collection ${collectionName}`,
              })
            }
          }

          if (state.description !== (news.description ?? undefined)) {
            try location.updateGeofenceCollection({
              CollectionName: collectionName,
              Description: news.description,
            })
          }

          const { removed, upsert } = try Effect.orDie(
            Effect.try({ try: () => diffTags(state.tags, desiredTags), catch: (e) => e }),
          )
          if (removed.length > 0) {
            try location.untagResource({
              ResourceArn: state.collectionArn,
              TagKeys: removed,
            })
          }
          if (upsert.length > 0) {
            try location.tagResource({
              ResourceArn: state.collectionArn,
              Tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
            })
          }

          try session.note(state.collectionArn)

          const final = try readCollection(collectionName)
          if (!final) {
            throw new GeofenceCollectionUnexpectedResponse({
              message: `failed to read reconciled geofence collection ${collectionName}`,
            })
          }
          return final
        },
        delete: effect ({ output }) => {
          location
            .deleteGeofenceCollection({
              CollectionName: output.collectionName,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: undefined as void;
              default: throw e;
            }
        },
      }
    },
  )
