import * as location from "@distilled.cloud/aws/location"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as EffectStream from "effect/Stream"
import type { Providers } from "../Providers.ts"

export interface TrackerConsumerProps {
  /**
   * Name of the tracker whose device position updates are consumed.
   * Changing it replaces the association.
   */
  trackerName: string
  /**
   * ARN of the geofence collection that consumes the tracker's position
   * updates (evaluating them against its geofences). Changing it replaces
   * the association.
   */
  consumerArn: string
}

export interface TrackerConsumer extends
  Resource<
    "AWS.Location.TrackerConsumer",
    TrackerConsumerProps,
    {
      /** Name of the tracker. */
      trackerName: string
      /** ARN of the consuming geofence collection. */
      consumerArn: string
    },
    never,
    Providers
  >
{}

/**
 * Links an Amazon Location {@link Tracker} to a {@link GeofenceCollection}
 * so every device position uploaded to the tracker is automatically
 * evaluated against the collection's geofences, emitting ENTER/EXIT events
 * (delivered to EventBridge — see `consumeTrackerEvents`).
 *
 * The association is existence-only: both properties are immutable and any
 * change replaces it.
 *
 * ### Linking Trackers to Geofence Collections
 * **Example:** Evaluate Tracker Positions Against a Collection
 * ```typescript
 * import * as Location from "@alchemy.run/aws/Location";
 *
 * const tracker = yield* Location.Tracker("Fleet", {
 *   eventBridgeEnabled: true,
 * });
 * const fences = yield* Location.GeofenceCollection("Zones", {});
 *
 * const link = yield* Location.TrackerConsumer("FleetZones", {
 *   trackerName: tracker.trackerName,
 *   consumerArn: fences.collectionArn,
 * });
 * ```
 *
 * @resource
 */
export const TrackerConsumer = Resource<TrackerConsumer>("AWS.Location.TrackerConsumer")

export const TrackerConsumerProvider = (): infer _ =>
  Provider.effect(
    TrackerConsumer,
    effect {
      /** Whether `consumerArn` is currently linked to `trackerName`. */
      const observeAssociation = effect (trackerName: string, consumerArn: string) => {
        const consumerArns = (Array.from(
          try (location.listTrackerConsumers
            .pages({ TrackerName: trackerName })
            |> EffectStream.runCollect(%)),
        ).flatMap((page) => page.ConsumerArns)) catch effect (e) => match (e) {
          when { _tag: "ResourceNotFoundException" }: [] as string[];
          default: throw e;
        }
        return consumerArns.includes(consumerArn)
      }

      return {
        stables: ["trackerName", "consumerArn"],
        list: effect () => {
          const trackerNames = Array.from(
            try (location.listTrackers.pages({})
              |> EffectStream.runCollect(%)),
          ).flatMap((page) => (page.Entries ?? []).map((entry) => entry.TrackerName))
          const associations = try Effect.forEach(
            trackerNames,
            effect (trackerName) =>
              (Array.from(
                try (location.listTrackerConsumers.pages({ TrackerName: trackerName })
                  |> EffectStream.runCollect(%)),
              ).flatMap((page) =>
                page.ConsumerArns.map((consumerArn) => ({
                  trackerName,
                  consumerArn,
                }))
              )) catch effect (e) => match (e) { when { _tag: "ResourceNotFoundException" }: []; default: throw e; },
            { concurrency: 5 },
          )
          return associations.flat()
        },
        read: effect ({ olds, output }) => {
          const trackerName = output?.trackerName ?? olds?.trackerName
          const consumerArn = output?.consumerArn ?? olds?.consumerArn
          if (!trackerName || !consumerArn) return undefined
          const exists = try observeAssociation(trackerName, consumerArn)
          return exists ? { trackerName, consumerArn } : undefined
        },
        diff: effect ({ news, olds }) => {
          if (!isResolved(news)) return
          if (olds.trackerName !== news.trackerName || olds.consumerArn !== news.consumerArn) {
            return { action: "replace" } as const
          }
        },
        reconcile: effect ({ news, session }) => {
          const exists = try observeAssociation(news.trackerName, news.consumerArn)
          if (!exists) {
            location
              .associateTrackerConsumer({
                TrackerName: news.trackerName,
                ConsumerArn: news.consumerArn,
              }) catch effect (e) => match (e) { when { _tag: "ConflictException" }: try Effect.void; default: throw e; }
          }
          try session.note(`${news.trackerName} -> ${news.consumerArn}`)
          return {
            trackerName: news.trackerName,
            consumerArn: news.consumerArn,
          }
        },
        delete: effect ({ output }) => {
          location
            .disassociateTrackerConsumer({
              TrackerName: output.trackerName,
              ConsumerArn: output.consumerArn,
            }) catch effect (e) => match (e) {
              when { _tag: "ResourceNotFoundException" }: try Effect.void;
              default: throw e;
            }
        },
      }
    },
  )
