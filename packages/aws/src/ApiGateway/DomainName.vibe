import * as ag from "@distilled.cloud/aws/api-gateway"
import { deepEqual, isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, tagRecord } from "alchemy/Tags"
import * as Redacted from "effect/Redacted"
import { plainJson } from "../internal/Observe.ts"
import type { Providers } from "../Providers.vibe"
import { syncTags } from "./common.vibe"

export interface DomainNameProps {
  /** The custom domain name (e.g. `api.example.com`). */
  domainName: string
  /** Display name of a self-managed edge certificate. */
  certificateName?: string
  /** PEM body of a self-managed edge certificate. */
  certificateBody?: string
  /**
   * The private key of the server certificate (self-managed certificates).
   * Secret key material — wrap with `Redacted.make` so state encoding
   * preserves redaction.
   */
  certificatePrivateKey?: Redacted.Redacted<string>
  /** PEM chain of a self-managed edge certificate. */
  certificateChain?: string
  /** ARN of an ACM certificate for EDGE endpoints (must live in us-east-1). */
  certificateArn?: string
  /** Display name of the regional certificate. */
  regionalCertificateName?: string
  /** ARN of an ACM certificate for REGIONAL endpoints (same region as the API). */
  regionalCertificateArn?: string
  /** Endpoint type for the domain (EDGE, REGIONAL, or PRIVATE). */
  endpointConfiguration?: ag.EndpointConfiguration
  /**
   * Minimum TLS version served (e.g. `TLS_1_2`).
   * @default "TLS_1_2"
   */
  securityPolicy?: ag.SecurityPolicy
  /** Access mode of the domain name endpoint. */
  endpointAccessMode?: ag.EndpointAccessMode
  /** Mutual TLS (client certificate) authentication configuration. */
  mutualTlsAuthentication?: ag.MutualTlsAuthenticationInput
  /** ARN of the certificate proving domain ownership when mutual TLS is enabled. */
  ownershipVerificationCertificateArn?: string
  /** Resource policy (JSON) for private custom domain names. */
  policy?: string
  /** Routing mode of the domain name (base-path vs routing-rule based). */
  routingMode?: ag.RoutingMode
  /** User-defined tags for the domain name. */
  tags?: Record<string, string>
}

/** @resource */
export interface DomainName extends
  Resource<
    "AWS.ApiGateway.DomainName",
    DomainNameProps,
    {
      domainName: string
      regionalDomainName: string | undefined
      regionalHostedZoneId: string | undefined
      distributionDomainName: string | undefined
      distributionHostedZoneId: string | undefined
      domainNameArn: string | undefined
      tags: Record<string, string>
      /**
       * Certificates, TLS policy, endpoint configuration and mutual TLS
       * settings, as observed. Lets `alchemy drift` detect out-of-band
       * changes.
       */
      configuration?: {
        certificateArn?: string
        regionalCertificateArn?: string
        securityPolicy?: string
        endpointTypes?: string[]
        ipAddressType?: string
        mutualTlsAuthentication?: { truststoreUri?: string; truststoreVersion?: string }
      }
    },
    never,
    Providers
  >
{}

/**
 * Custom domain name for an Amazon API Gateway REST API.
 *
 * ### Custom domain
 * **Example:** Regional custom domain
 * ```typescript
 * const domain = yield* ApiGateway.DomainName("ApiDomain", {
 *   domainName: "api.example.com",
 *   regionalCertificateArn: cert.certificateArn,
 *   endpointConfiguration: { types: ["REGIONAL"] },
 *   securityPolicy: "TLS_1_2",
 * });
 * ```
 */
const DomainNameResource = Resource<DomainName>("AWS.ApiGateway.DomainName")

export { DomainNameResource as DomainName }

/** Unwrap an optional redacted secret for the wire / diff comparison. */
const redactedValue = (value: Redacted.Redacted<string> | undefined): infer _ =>
  value === undefined ? undefined : Redacted.value(value)

const retryDomainNameMutation = Effect.retry({
  while: (e: any) => e._tag === "ConflictException" || e._tag === "TooManyRequestsException",
  schedule: Schedule.spaced("1 second"),
  times: 8,
})

/**
 * The settings `read` and `reconcile` both report, so a converged domain
 * name reads unchanged.
 */
const observeDomainNameConfiguration = (d: ag.DomainName): infer _ =>
  plainJson({
    certificateArn: d.certificateArn,
    regionalCertificateArn: d.regionalCertificateArn,
    securityPolicy: d.securityPolicy,
    endpointTypes: d.endpointConfiguration?.types,
    ipAddressType: d.endpointConfiguration?.ipAddressType,
    mutualTlsAuthentication: d.mutualTlsAuthentication?.truststoreUri
      ? {
        truststoreUri: d.mutualTlsAuthentication.truststoreUri,
        truststoreVersion: d.mutualTlsAuthentication.truststoreVersion,
      }
      : undefined,
  })

export const DomainNameProvider = (): infer _ =>
  Provider.effect(
    DomainNameResource,
    effect {
      return {
        stables: ["domainName"] as const,
        diff: effect ({ news: newsIn, olds }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(newsIn) ? newsIn : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return
          const news = resolved as DomainNameProps
          if (news.domainName !== olds.domainName) {
            return { action: "replace" } as const
          }
          if (
            !(try Effect.orDie(
              Effect.try({
                try: () => deepEqual(news.endpointConfiguration, olds.endpointConfiguration),
                catch: (e) => e,
              }),
            ))
          ) {
            return { action: "replace" } as const
          }
          if (news.endpointAccessMode !== olds.endpointAccessMode) {
            return { action: "replace" } as const
          }
          if (news.certificateBody !== olds.certificateBody) {
            return { action: "replace" } as const
          }
          if (
            redactedValue(news.certificatePrivateKey) !== redactedValue(olds.certificatePrivateKey)
          ) {
            return { action: "replace" } as const
          }
          if (news.certificateChain !== olds.certificateChain) {
            return { action: "replace" } as const
          }
          if (news.certificateName !== olds.certificateName) {
            return { action: "replace" } as const
          }
          if (news.regionalCertificateName !== olds.regionalCertificateName) {
            return { action: "replace" } as const
          }
          if (
            !(try Effect.orDie(Effect.try({
              try: () => deepEqual(news.mutualTlsAuthentication, olds.mutualTlsAuthentication),
              catch: (e) => e,
            })))
          ) {
            return { action: "replace" } as const
          }
          if (news.policy !== olds.policy) {
            return { action: "replace" } as const
          }
          if (news.routingMode !== olds.routingMode) {
            return { action: "replace" } as const
          }
          if (
            news.ownershipVerificationCertificateArn !== olds.ownershipVerificationCertificateArn
          ) {
            return { action: "replace" } as const
          }
        },
        list: effect () =>
          Array.from(
            try (ag.getDomainNames.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.items ?? [])
              .filter((d): d is ag.DomainName & { domainName: string } => d.domainName != null)
              .map((d) => ({
                domainName: d.domainName,
                regionalDomainName: d.regionalDomainName,
                regionalHostedZoneId: d.regionalHostedZoneId,
                distributionDomainName: d.distributionDomainName,
                distributionHostedZoneId: d.distributionHostedZoneId,
                domainNameArn: d.domainNameArn,
                tags: tagRecord(d.tags),
              }))
          ),
        read: effect ({ output }) => {
          if (!output?.domainName) return undefined
          const d = ag
            .getDomainName({ domainName: output.domainName }) catch effect (e) => match (e) {
              when { _tag: "NotFoundException" }: undefined;
              default: throw e;
            }
          if (!d?.domainName) return undefined
          return {
            domainName: d.domainName,
            regionalDomainName: d.regionalDomainName,
            regionalHostedZoneId: d.regionalHostedZoneId,
            distributionDomainName: d.distributionDomainName,
            distributionHostedZoneId: d.distributionHostedZoneId,
            domainNameArn: d.domainNameArn,
            tags: try Effect.orDie(Effect.try({ try: () => tagRecord(d.tags), catch: (e) => e })),
            configuration: observeDomainNameConfiguration(d),
          }
        },
        reconcile: effect ({ id, news: newsIn, output, session }) => {
          const resolved_ = try Effect.orDie(
            Effect.try({ try: () => isResolved(newsIn) ? newsIn : undefined, catch: (e) => e }),
          )
          if (resolved_ === undefined) {
            return try Effect.die("DomainName props were not resolved")
          }
          const news = resolved_ as DomainNameProps
          const domainName = output?.domainName ?? news.domainName
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // Observe — fetch the live domain name. Domain names are
          // user-supplied physical names so the lookup key is stable; we
          // never trust `output.tags`/`output.securityPolicy` etc. for
          // diffing, only re-read the cloud state.
          let observed = ag
            .getDomainName({ domainName }) catch effect (e) => match (e) {
              when { _tag: "NotFoundException" }: undefined;
              default: throw e;
            }

          // Ensure — create the domain name if it's missing.
          if (!observed?.domainName) {
            try ag.createDomainName({
              domainName: news.domainName,
              certificateName: news.certificateName,
              certificateBody: news.certificateBody,
              certificatePrivateKey: redactedValue(news.certificatePrivateKey),
              certificateChain: news.certificateChain,
              certificateArn: news.certificateArn,
              regionalCertificateName: news.regionalCertificateName,
              regionalCertificateArn: news.regionalCertificateArn,
              endpointConfiguration: news.endpointConfiguration,
              tags: desiredTags,
              securityPolicy: news.securityPolicy,
              endpointAccessMode: news.endpointAccessMode,
              mutualTlsAuthentication: news.mutualTlsAuthentication,
              ownershipVerificationCertificateArn: news.ownershipVerificationCertificateArn,
              policy: news.policy,
              routingMode: news.routingMode,
            })
            try session.note(`Created domain name ${news.domainName}`)
            observed = try ag.getDomainName({ domainName })
          }

          // Sync mutable scalar fields — observed ↔ desired patch list.
          const patches: ag.PatchOperation[] = []
          if (news.securityPolicy !== observed.securityPolicy) {
            patches.push({
              op: news.securityPolicy === undefined ? "remove" : "replace",
              path: "/securityPolicy",
              value: news.securityPolicy,
            })
          }
          if (news.regionalCertificateArn !== observed.regionalCertificateArn) {
            patches.push({
              op: news.regionalCertificateArn === undefined ? "remove" : "replace",
              path: "/regionalCertificateArn",
              value: news.regionalCertificateArn,
            })
          }
          if (news.certificateArn !== observed.certificateArn) {
            patches.push({
              op: news.certificateArn === undefined ? "remove" : "replace",
              path: "/certificateArn",
              value: news.certificateArn,
            })
          }
          // The endpoint type and mutual TLS trust store are replacement
          // props, so they only differ here after an out-of-band change.
          const desiredType = news.endpointConfiguration?.types?.[0]
          const observedType = observed.endpointConfiguration?.types?.[0]
          if (
            desiredType !== undefined
            && observedType !== undefined
            && desiredType !== observedType
          ) {
            patches.push({
              op: "replace",
              path: `/endpointConfiguration/types/${observedType}`,
              value: desiredType,
            })
          }
          const desiredTrustStore = news.mutualTlsAuthentication
          if (desiredTrustStore?.truststoreUri !== undefined) {
            if (
              desiredTrustStore.truststoreUri !== observed.mutualTlsAuthentication?.truststoreUri
            ) {
              patches.push({
                op: "replace",
                path: "/mutualTlsAuthentication/truststoreUri",
                value: desiredTrustStore.truststoreUri,
              })
            }
            if (
              desiredTrustStore.truststoreVersion !== undefined
              && desiredTrustStore.truststoreVersion
                !== observed.mutualTlsAuthentication?.truststoreVersion
            ) {
              patches.push({
                op: "replace",
                path: "/mutualTlsAuthentication/truststoreVersion",
                value: desiredTrustStore.truststoreVersion,
              })
            }
          }
          if (patches.length > 0) {
            // Domain name mutations can briefly conflict while API Gateway
            // propagates certificate, policy, or routing changes.
            try (ag
              .updateDomainName({
                domainName,
                patchOperations: patches,
              })
              |> retryDomainNameMutation(%))
          }

          // Sync tags — diff observed cloud tags against desired so adoption
          // converges without fighting whatever was already there.
          const observedTags = try Effect.orDie(Effect.try({ try: () => tagRecord(observed.tags), catch: (e) => e }))
          if (
            !(try Effect.orDie(Effect.try({ try: () => deepEqual(observedTags, desiredTags), catch: (e) => e })))
            && observed.domainNameArn
          ) {
            try syncTags({
              resourceArn: observed.domainNameArn,
              oldTags: observedTags,
              newTags: desiredTags,
            })
          }

          try session.note(`Reconciled domain name ${domainName}`)
          const final = try ag.getDomainName({ domainName })
          return {
            domainName: final.domainName!,
            regionalDomainName: final.regionalDomainName,
            regionalHostedZoneId: final.regionalHostedZoneId,
            distributionDomainName: final.distributionDomainName,
            distributionHostedZoneId: final.distributionHostedZoneId,
            domainNameArn: final.domainNameArn,
            tags: try Effect.orDie(Effect.try({ try: () => tagRecord(final.tags), catch: (e) => e })),
            configuration: observeDomainNameConfiguration(final),
          }
        },
        delete: effect ({ output, session }) => {
          try (effect {
            return ag.deleteDomainName({ domainName: output.domainName }) catch effect (e) => match (e) {
              when { _tag: "NotFoundException" }: (undefined as void);
              default: throw e;
            }
          }
            |> retryDomainNameMutation(%))
          try session.note(`Deleted domain name ${output.domainName}`)
        },
      }
    },
  )
