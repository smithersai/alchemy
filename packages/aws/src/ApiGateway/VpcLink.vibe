import * as ag from "@distilled.cloud/aws/api-gateway"
import { deepEqual, isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, tagRecord } from "alchemy/Tags"
import { AWSEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import { syncTags, vpcLinkArn } from "./common.ts"

export interface VpcLinkProps {
  /**
   * Name of the VPC link.
   *
   * If omitted, Alchemy generates a deterministic physical name.
   */
  name?: string
  /**
   * Target ARNs for the integration (e.g. load balancer ARNs).
   */
  targetArns: string[]
  /** Description of the VPC link. */
  description?: string
  /** User-defined tags for the VPC link. */
  tags?: Record<string, string>
}

/** @resource */
export interface VpcLink extends
  Resource<
    "AWS.ApiGateway.VpcLink",
    VpcLinkProps,
    {
      vpcLinkId: string
      name: string | undefined
      description: string | undefined
      targetArns: string[] | undefined
      status: ag.VpcLinkStatus | undefined
      statusMessage: string | undefined
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * VPC link for private integrations (`connectionType: "VPC_LINK"` on a method integration).
 *
 * ### Private integrations
 * **Example:** Create a VPC link
 * ```typescript
 * const link = yield* ApiGateway.VpcLink("NlbLink", {
 *   description: "Link to internal NLB",
 *   targetArns: [nlb.loadBalancerArn],
 * });
 *
 * yield* ApiGateway.Method("PrivateGet", {
 *   restApiId: api.restApiId,
 *   resourceId: resource.resourceId,
 *   httpMethod: "GET",
 *   integration: {
 *     type: "HTTP_PROXY",
 *     integrationHttpMethod: "GET",
 *     uri: "https://api.internal.example.com/hello",
 *     connectionType: "VPC_LINK",
 *     connectionId: link.vpcLinkId,
 *   },
 * });
 * ```
 */
const VpcLinkResource = Resource<VpcLink>("AWS.ApiGateway.VpcLink")

export { VpcLinkResource as VpcLink }

const generatedName = effect (id: string, props: VpcLinkProps) => (props.name ? props.name : try createPhysicalName({
  id,
  maxLength: 128,
}))

const snapshotFromVpcLink = (
  v: ag.VpcLink,
  tags: Record<string, string>,
): VpcLink["Attributes"] => ({
  vpcLinkId: v.id!,
  name: v.name,
  description: v.description,
  targetArns: v.targetArns,
  status: v.status,
  statusMessage: v.statusMessage,
  tags,
})

export const VpcLinkProvider = (): infer _ =>
  Provider.effect(
    VpcLinkResource,
    effect {
      return {
        stables: ["vpcLinkId"] as const,
        diff: effect ({ news: newsIn, olds }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(newsIn) ? newsIn : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return
          const news = resolved as VpcLinkProps
          if (
            !(try Effect.orDie(
              Effect.try({ try: () => deepEqual(news.targetArns, olds.targetArns), catch: (e) => e }),
            ))
          ) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ output }) => {
          if (!output?.vpcLinkId) return undefined
          const v = ag
            .getVpcLink({ vpcLinkId: output.vpcLinkId }) catch effect (e) => match (e) {
              when { _tag: "NotFoundException" }: undefined;
              default: throw e;
            }
          if (!v?.id) return undefined
          return snapshotFromVpcLink(
            v,
            try Effect.orDie(Effect.try({ try: () => tagRecord(v.tags), catch: (e) => e })),
          )
        },
        list: effect () =>
          Array.from(
            try (ag.getVpcLinks.pages({ limit: 500 })
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.items ?? [])
              .filter((v): v is ag.VpcLink & { id: string } => !!v.id)
              .map((v) => snapshotFromVpcLink(v, tagRecord(v.tags)))
          ),
        reconcile: effect ({ id, news: newsIn, output, session }) => {
          const resolved_ = try Effect.orDie(
            Effect.try({ try: () => isResolved(newsIn) ? newsIn : undefined, catch: (e) => e }),
          )
          if (resolved_ === undefined) {
            return try Effect.die("VpcLink props were not resolved")
          }
          const news = resolved_ as VpcLinkProps
          const name = try generatedName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }
          const { region } = try AWSEnvironment.current
          // Observe — fetch the live VPC link if we have a cached id.
          // We never trust `output.description`/etc. for diffing; the
          // observed cloud state drives every sync below.
          let observed = output?.vpcLinkId
            ? ag
              .getVpcLink({ vpcLinkId: output.vpcLinkId }) catch effect (e) => match (e) {
                when { _tag: "NotFoundException" }: undefined;
                default: throw e;
              }
            : undefined

          // Ensure — create the VPC link if missing.
          if (!observed?.id) {
            const created = try ag.createVpcLink({
              name,
              description: news.description,
              targetArns: news.targetArns,
              tags: desiredTags,
            })
            if (!created.id) {
              return try Effect.die("createVpcLink missing id")
            }
            try session.note(`Created VPC link ${created.id}`)
            observed = try ag.getVpcLink({ vpcLinkId: created.id })
          }

          const vpcLinkId = observed.id!

          // Sync mutable scalar fields — observed ↔ desired patch list.
          const patches: ag.PatchOperation[] = []
          if (news.description !== observed.description) {
            patches.push({
              op: "replace",
              path: "/description",
              value: news.description ?? "",
            })
          }
          if (news.name !== undefined && news.name !== observed.name) {
            patches.push({
              op: "replace",
              path: "/name",
              value: news.name,
            })
          }
          if (patches.length > 0) {
            try ag.updateVpcLink({
              vpcLinkId,
              patchOperations: patches,
            })
          }

          // Sync tags — observed ↔ desired so adoption converges without
          // fighting the existing tag set.
          const observedTags = try Effect.orDie(Effect.try({ try: () => tagRecord(observed.tags), catch: (e) => e }))
          if (!(try Effect.orDie(Effect.try({ try: () => deepEqual(observedTags, desiredTags), catch: (e) => e })))) {
            try syncTags({
              resourceArn: try Effect.orDie(Effect.try({ try: () => vpcLinkArn(region, vpcLinkId), catch: (e) => e })),
              oldTags: observedTags,
              newTags: desiredTags,
            })
          }

          try session.note(`Reconciled VPC link ${vpcLinkId}`)
          const final = try ag.getVpcLink({ vpcLinkId })
          return snapshotFromVpcLink(
            final,
            try Effect.orDie(Effect.try({ try: () => tagRecord(final.tags), catch: (e) => e })),
          )
        },
        delete: effect ({ output, session }) => {
          ;(effect {
            return (try (ag.deleteVpcLink({ vpcLinkId: output.vpcLinkId })
              |> Effect.retry(%, {
                while: (e) => e._tag === "ConflictException",
                schedule: Schedule.spaced("1 second"),
                times: 8,
              })))
          }) catch effect (e) => match (e) { when { _tag: "NotFoundException" }: (undefined as void); default: throw e; }
          try session.note(`Deleted VPC link ${output.vpcLinkId}`)
        },
      }
    },
  )
