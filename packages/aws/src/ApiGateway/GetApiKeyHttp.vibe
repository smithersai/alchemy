import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { GetApiKey, type GetApiKeyRequest } from "./GetApiKey.vibe"

/**
 * HTTP implementation of the {@link GetApiKey} binding. Grants
 * `apigateway:GET` on `/apikeys/*` and calls the API with the host
 * Function's credentials.
 */
export const GetApiKeyHttp = Layer.effect(
  GetApiKey,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const getApiKey = try AWSBindings.withCredentials(ag.getApiKey)
    return effect () => {
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.GetApiKey",
        target: "",
        verb: "GET",
        paths: (region) => [`arn:aws:apigateway:${region}::/apikeys/*`],
      })
      return effect (request: GetApiKeyRequest) =>
        try withSpan(
          effect {
            return try getApiKey(request)
          },
          "AWS.ApiGateway.GetApiKey",
        )
    }
  },
)
