import * as ag from "@distilled.cloud/aws/api-gateway"
import { isResolved } from "alchemy/Diff"
import type { Input } from "alchemy/Input"
import * as Provider from "alchemy/Provider"
import { Resource as ResourceFactory, type Resource as ResourceType } from "alchemy/Resource"
import * as Effect from "effect/Effect"
import type { Providers } from "../Providers.ts"
import type { RestApi } from "./RestApi.vibe"

export interface ApiGatewayResourceProps {
  /**
   * The `RestApi` this path segment belongs to. Binding via `restApi`
   * registers this resource on the API so that any `Deployment` of the
   * same API waits for it — and for the methods attached to it — before
   * snapshotting.
   */
  restApi?: RestApi
  /**
   * Identifier of the parent REST API. Usually derived from `restApi.restApiId`.
   */
  restApiId?: Input<string>
  /**
   * Parent resource id (use `api.rootResourceId` for top-level paths, or
   * the `resourceId` of another `ApiGateway.Resource` to nest deeper).
   */
  parentId: Input<string>
  /**
   * Path segment (e.g. `items` or `{proxy+}`).
   */
  pathPart: string
}

export interface ApiGatewayResource extends
  ResourceType<
    "AWS.ApiGateway.Resource",
    ApiGatewayResourceProps,
    {
      resourceId: string
      restApiId: string
      parentId: string
      pathPart: string
    },
    never,
    Providers
  >
{}

/**
 * A path segment under a REST API resource tree.
 *
 * Resources form the URL hierarchy of a REST API: every path segment
 * (`/items`, `/items/{id}`, `/{proxy+}`) is a `Resource` whose `parentId`
 * points either at `api.rootResourceId` (for top-level paths) or at
 * another `Resource`'s `resourceId` (for nested paths). Attach methods
 * to a resource by passing its `resourceId` to `ApiGateway.Method`.
 * ### Path resources
 * **Example:** Top-level path
 * ```typescript
 * const items = yield* ApiGateway.Resource("Items", {
 *   restApi: api,
 *   parentId: api.rootResourceId,
 *   pathPart: "items",
 * });
 * ```
 *
 * **Example:** Nested path with a greedy proxy
 * ```typescript
 * const items = yield* ApiGateway.Resource("Items", {
 *   restApi: api,
 *   parentId: api.rootResourceId,
 *   pathPart: "items",
 * });
 *
 * const anyItem = yield* ApiGateway.Resource("AnyItem", {
 *   restApi: api,
 *   parentId: items.resourceId,
 *   pathPart: "{proxy+}",
 * });
 * ```
 *
 * @resource
 */
export const GatewayResource = ResourceFactory<ApiGatewayResource>("AWS.ApiGateway.Resource")

interface ApiGatewayResourceInputProps {
  restApi?: RestApi
  restApiId?: Input<string>
  parentId: Input<string>
  pathPart: Input<string>
}

/**
 * User-facing wrapper. Accepts `restApi: RestApi` to register this resource
 * as a binding on the API (so deployments wait for it transitively).
 */
const ResourceImpl = effect (id: string, props: ApiGatewayResourceInputProps) => {
  const { restApi, ...rest } = props
  const restApiId = rest.restApiId ?? restApi?.restApiId
  if (!restApiId) {
    return try Effect.die(
      "ApiGateway.Resource requires either `restApi` (preferred) or " + "explicit `restApiId`.",
    )
  }
  const resource = try GatewayResource(id, {
    ...rest,
    restApiId,
  } as any)
  if (restApi) {
    try restApi.bind`${resource}`({
      kind: "resource",
      resourceId: resource.resourceId,
      parentId: resource.parentId,
      pathPart: resource.pathPart,
    })
  }
  return resource
}

export const Resource = ResourceImpl

export const ResourceProvider = (): infer _ =>
  Provider.effect(
    GatewayResource,
    effect {
      return {
        stables: ["resourceId", "restApiId", "parentId"] as const,
        diff: effect ({ news: newsIn, olds }) => {
          if (!isResolved(newsIn)) return
          const news = newsIn as Input.ResolveProps<ApiGatewayResourceProps>
          if (
            news.restApiId !== olds.restApiId
            || news.pathPart !== olds.pathPart
            || news.parentId !== olds.parentId
          ) {
            return { action: "replace" } as const
          }
        },
        list: effect () => {
          // Enumerate parent RestApis, then list the resources under each.
          const apiIds = Array.from(
            try (ag.getRestApis.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) => (page.items ?? []).filter((api) => api.id != null).map((api) => api.id!))
          const rows = try Effect.forEach(
            apiIds,
            effect (restApiId) =>
              (Array.from(
                try (ag.getResources.pages({ restApiId })
                  |> Stream.runCollect(%)),
              ).flatMap((page) =>
                (page.items ?? [])
                  // The API root resource ("/") has no parentId/pathPart;
                  // it isn't a managed `Resource`, so skip it.
                  .filter((r) => r.id != null && r.parentId != null && r.pathPart != null)
                  .map((r) => ({
                    resourceId: r.id!,
                    restApiId,
                    parentId: r.parentId!,
                    pathPart: r.pathPart!,
                  }))
              )) catch effect (e) => match (e) { when { _tag: "NotFoundException" }: []; default: throw e; },
            { concurrency: 10 },
          )
          return rows.flat()
        },
        read: effect ({ output }) => {
          if (!output?.resourceId) return undefined
          const r = ag
            .getResource({
              restApiId: output.restApiId,
              resourceId: output.resourceId,
            }) catch effect (e) => match (e) {
              when { _tag: "NotFoundException" }: try Effect.undefined;
              default: throw e;
            }
          if (!r?.id) return undefined
          return {
            resourceId: r.id,
            restApiId: output.restApiId,
            parentId: r.parentId!,
            pathPart: r.pathPart!,
          }
        },
        reconcile: effect ({ news: newsIn, output, session }) => {
          if (!isResolved(newsIn)) {
            return try Effect.die("Resource props were not resolved")
          }
          const news = newsIn as Input.ResolveProps<ApiGatewayResourceProps>
          const restApiId = (output?.restApiId ?? news.restApiId) as string

          // Observe — fetch the live resource if we have a cached id. We
          // never trust `output.pathPart` for diffing; we re-read the
          // pathPart from cloud state every reconcile.
          let observed = output?.resourceId
            ? ag
              .getResource({
                restApiId,
                resourceId: output.resourceId,
              }) catch effect (e) => match (e) {
                when { _tag: "NotFoundException" }: try Effect.undefined;
                default: throw e;
              }
            : undefined

          // Ensure — create the resource if missing.
          if (!observed?.id) {
            const created = try ag.createResource({
              restApiId: news.restApiId as string,
              parentId: news.parentId as string,
              pathPart: news.pathPart,
            })
            if (!created.id) {
              return try Effect.die("createResource missing id")
            }
            try session.note(`Created API Gateway resource ${created.id} (${news.pathPart})`)
            observed = try ag.getResource({
              restApiId: news.restApiId as string,
              resourceId: created.id,
            })
          }

          const resourceId = observed.id!

          // Sync pathPart — observed ↔ desired. parentId moves are modeled
          // as `replace` in `diff`, so we don't try to patch them here.
          if (news.pathPart !== observed.pathPart) {
            try ag.updateResource({
              restApiId,
              resourceId,
              patchOperations: [{ op: "replace", path: "/pathPart", value: news.pathPart }],
            })
            try session.note(`Updated resource ${resourceId}`)
          }

          return {
            resourceId,
            restApiId,
            parentId: observed.parentId!,
            pathPart: news.pathPart,
          }
        },
        delete: effect ({ output, session }) => {
          ag
            .deleteResource({
              restApiId: output.restApiId,
              resourceId: output.resourceId,
            }) catch effect (e) => match (e) { when { _tag: "NotFoundException" }: try Effect.void; default: throw e; }
          try session.note(`Deleted resource ${output.resourceId}`)
        },
      }
    },
  )
