import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Output from "alchemy/Output"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { GetUsagePlanKey, type GetUsagePlanKeyRequest } from "./GetUsagePlanKey.vibe"
import type { UsagePlan } from "./UsagePlan.vibe"

/**
 * HTTP implementation of the {@link GetUsagePlanKey} binding. Grants
 * `apigateway:GET` on the plan's per-key paths and calls the API with the
 * host Function's credentials.
 */
export const GetUsagePlanKeyHttp = Layer.effect(
  GetUsagePlanKey,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const getUsagePlanKey = try AWSBindings.withCredentials(ag.getUsagePlanKey)
    return effect <P extends UsagePlan>(usagePlan: P) => {
      const UsagePlanId = try usagePlan.id.asEffect()
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.GetUsagePlanKey",
        target: usagePlan,
        verb: "GET",
        paths: (region) => [
          Output.interpolate`arn:aws:apigateway:${region}::/usageplans/${usagePlan.id}/keys/*`,
        ],
      })
      return effect (
        request: GetUsagePlanKeyRequest,
      ) =>
        try withSpan(
          effect {
            return try getUsagePlanKey({
              ...request,
              usagePlanId: try UsagePlanId,
            })
          },
          `AWS.ApiGateway.GetUsagePlanKey(${usagePlan.LogicalId})`,
        )
    }
  },
)
