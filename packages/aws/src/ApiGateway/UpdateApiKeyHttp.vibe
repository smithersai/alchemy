import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { UpdateApiKey, type UpdateApiKeyRequest } from "./UpdateApiKey.vibe"

/**
 * HTTP implementation of the {@link UpdateApiKey} binding. Grants
 * `apigateway:PATCH` on `/apikeys/*` and calls the API with the host
 * Function's credentials.
 */
export const UpdateApiKeyHttp = Layer.effect(
  UpdateApiKey,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const updateApiKey = try AWSBindings.withCredentials(ag.updateApiKey)
    return effect () => {
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.UpdateApiKey",
        target: "",
        verb: "PATCH",
        paths: (region) => [`arn:aws:apigateway:${region}::/apikeys/*`],
      })
      return effect (request: UpdateApiKeyRequest) =>
        try withSpan(
          effect {
            return try updateApiKey(request)
          },
          "AWS.ApiGateway.UpdateApiKey",
        )
    }
  },
)
