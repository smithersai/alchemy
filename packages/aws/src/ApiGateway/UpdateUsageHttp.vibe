import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Output from "alchemy/Output"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { UpdateUsage, type UpdateUsageRequest } from "./UpdateUsage.vibe"
import type { UsagePlan } from "./UsagePlan.vibe"

/**
 * HTTP implementation of the {@link UpdateUsage} binding. Grants
 * `apigateway:PATCH` on the plan's per-key `/usage` paths and calls the
 * API with the host Function's credentials.
 */
export const UpdateUsageHttp = Layer.effect(
  UpdateUsage,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const updateUsage = try AWSBindings.withCredentials(ag.updateUsage)
    return effect <P extends UsagePlan>(usagePlan: P) => {
      const UsagePlanId = try usagePlan.id.asEffect()
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.UpdateUsage",
        target: usagePlan,
        verb: "PATCH",
        paths: (region) => [
          Output.interpolate`arn:aws:apigateway:${region}::/usageplans/${usagePlan.id}/keys/*/usage`,
        ],
      })
      return effect (
        request: UpdateUsageRequest,
      ) =>
        try withSpan(
          effect {
            return try updateUsage({
              ...request,
              usagePlanId: try UsagePlanId,
            })
          },
          `AWS.ApiGateway.UpdateUsage(${usagePlan.LogicalId})`,
        )
    }
  },
)
