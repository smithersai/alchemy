import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { CreateApiKey, type CreateApiKeyRequest } from "./CreateApiKey.vibe"

/**
 * HTTP implementation of the {@link CreateApiKey} binding. Grants
 * `apigateway:POST` on `/apikeys` and calls the API with the host
 * Function's credentials.
 */
export const CreateApiKeyHttp = Layer.effect(
  CreateApiKey,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const createApiKey = try AWSBindings.withCredentials(ag.createApiKey)
    return effect () => {
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.CreateApiKey",
        target: "",
        verb: "POST",
        paths: (region) => [`arn:aws:apigateway:${region}::/apikeys`],
      })
      return effect (request?: CreateApiKeyRequest | undefined) =>
        try withSpan(
          effect {
            return try createApiKey(request ?? {})
          },
          "AWS.ApiGateway.CreateApiKey",
        )
    }
  },
)
