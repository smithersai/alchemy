import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Output from "alchemy/Output"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { DeleteUsagePlanKey, type DeleteUsagePlanKeyRequest } from "./DeleteUsagePlanKey.vibe"
import type { UsagePlan } from "./UsagePlan.vibe"

/**
 * HTTP implementation of the {@link DeleteUsagePlanKey} binding. Grants
 * `apigateway:DELETE` on the plan's per-key paths and calls the API with
 * the host Function's credentials.
 */
export const DeleteUsagePlanKeyHttp = Layer.effect(
  DeleteUsagePlanKey,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const deleteUsagePlanKey = try AWSBindings.withCredentials(ag.deleteUsagePlanKey)
    return effect <P extends UsagePlan>(usagePlan: P) => {
      const UsagePlanId = try usagePlan.id.asEffect()
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.DeleteUsagePlanKey",
        target: usagePlan,
        verb: "DELETE",
        paths: (region) => [
          Output.interpolate`arn:aws:apigateway:${region}::/usageplans/${usagePlan.id}/keys/*`,
        ],
      })
      return effect (
        request: DeleteUsagePlanKeyRequest,
      ) =>
        try withSpan(
          effect {
            return try deleteUsagePlanKey({
              ...request,
              usagePlanId: try UsagePlanId,
            })
          },
          `AWS.ApiGateway.DeleteUsagePlanKey(${usagePlan.LogicalId})`,
        )
    }
  },
)
