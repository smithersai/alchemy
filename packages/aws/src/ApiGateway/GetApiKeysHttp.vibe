import * as ag from "@distilled.cloud/aws/api-gateway"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.vibe"
import { RegisterApiGatewayBinding } from "./BindingHttp.vibe"
import { GetApiKeys, type GetApiKeysRequest } from "./GetApiKeys.vibe"

/**
 * HTTP implementation of the {@link GetApiKeys} binding. Grants
 * `apigateway:GET` on `/apikeys` and calls the API with the host
 * Function's credentials.
 */
export const GetApiKeysHttp = Layer.effect(
  GetApiKeys,
  effect {
    const registerApiGatewayBinding = try RegisterApiGatewayBinding
    const getApiKeys = try AWSBindings.withCredentials(ag.getApiKeys)
    return effect () => {
      try registerApiGatewayBinding({
        cap: "AWS.ApiGateway.GetApiKeys",
        target: "",
        verb: "GET",
        paths: (region) => [`arn:aws:apigateway:${region}::/apikeys`],
      })
      return effect (request?: GetApiKeysRequest | undefined) =>
        try withSpan(
          effect {
            return try getApiKeys(request ?? {})
          },
          "AWS.ApiGateway.GetApiKeys",
        )
    }
  },
)
