import * as s3vectors from "@distilled.cloud/aws/s3vectors"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags } from "alchemy/Tags"
import type { PolicyStatement } from "../IAM/Policy.vibe"
import type { Providers } from "../Providers.vibe"

/**
 * Server-side encryption configuration for a vector bucket. Immutable —
 * changing it replaces the bucket.
 */
export interface VectorBucketEncryption {
  /**
   * The SSE algorithm. `AES256` uses S3-managed keys; `aws:kms` uses a KMS
   * key (supply `kmsKeyArn`).
   * @default "AES256"
   */
  mutable sseType?: "AES256" | "aws:kms"
  /**
   * ARN of the KMS key to use when `sseType` is `aws:kms`.
   */
  mutable kmsKeyArn?: string
}

export interface VectorBucketProps {
  /**
   * Name of the vector bucket (3-63 chars, lowercase). If omitted, a unique
   * name is generated from the app, stage, and logical id.
   *
   * Changing the name replaces the bucket.
   * @default ${app}-${stage}-${id}
   */
  mutable vectorBucketName?: string
  /**
   * Server-side encryption configuration. Immutable — changing it replaces
   * the bucket.
   */
  mutable encryption?: VectorBucketEncryption
  /**
   * Resource policy statements for the vector bucket, granting or denying
   * cross-account/principal access to it and the indexes inside it
   * (`arn:…:bucket/<name>/index/*`). Rendered as a standard
   * `2012-10-17` policy document via `PutVectorBucketPolicy`; omitting the
   * prop removes any existing policy.
   */
  mutable policy?: PolicyStatement[]
  /**
   * Tags to apply to the bucket. Merged with internal Alchemy tags.
   */
  mutable tags?: Record<string, string>
}

export interface VectorBucket extends
  Resource<
    "AWS.S3Vectors.VectorBucket",
    VectorBucketProps,
    {
      /**
       * Name of the vector bucket.
       */
      mutable vectorBucketName: string
      /**
       * ARN of the vector bucket.
       */
      mutable vectorBucketArn: string
    },
    never,
    Providers
  >
{}

/**
 * An Amazon S3 Vectors bucket — durable storage for vector embeddings,
 * queryable by similarity. Create one or more {@link Index}es inside it to
 * store and query vectors.
 *
 * S3 Vectors is in preview; availability varies by region.
 *
 * ### Creating a Vector Bucket
 * **Example:** Basic Vector Bucket
 * ```typescript
 * import * as S3Vectors from "@alchemy.run/aws/S3Vectors";
 *
 * const bucket = yield* S3Vectors.VectorBucket("Embeddings", {});
 * ```
 *
 * **Example:** Vector Bucket with KMS Encryption
 * ```typescript
 * const bucket = yield* S3Vectors.VectorBucket("Embeddings", {
 *   encryption: { sseType: "aws:kms", kmsKeyArn: key.keyArn },
 * });
 * ```
 *
 * ### Bucket Policy
 * **Example:** Grant Another Account Read Access
 * ```typescript
 * const bucket = yield* S3Vectors.VectorBucket("Embeddings", {
 *   vectorBucketName: "shared-embeddings",
 *   policy: [
 *     {
 *       Effect: "Allow",
 *       Principal: { AWS: "arn:aws:iam::123456789012:root" },
 *       Action: ["s3vectors:GetVectors", "s3vectors:QueryVectors"],
 *       Resource:
 *         "arn:aws:s3vectors:us-east-1:999999999999:bucket/shared-embeddings/index/*",
 *     },
 *   ],
 * });
 * ```
 *
 * @resource
 */
export const VectorBucket = Resource<VectorBucket>("AWS.S3Vectors.VectorBucket")

const encryptionKey = (e: VectorBucketEncryption | undefined): infer _ =>
  JSON.stringify({ sseType: e?.sseType, kmsKeyArn: e?.kmsKeyArn })

export const VectorBucketProvider = (): infer _ =>
  Provider.effect(
    VectorBucket,
    effect {
      const createName = effect (
        id: string,
        props: Pick<VectorBucketProps, "vectorBucketName">,
      ) => (
        props.vectorBucketName
          ?? (try createPhysicalName({
            id,
            maxLength: 63,
            forbiddenPrefixes: ["aws"],
          })).toLowerCase()
      )

      const observe = effect (vectorBucketName: string) =>
        (try s3vectors.getVectorBucket({ vectorBucketName })).vectorBucket catch effect (e) => match (e) {
          when { _tag: "NotFoundException" }: try Effect.undefined;
          default: throw e;
        }

      const observedTags = effect (resourceArn: string) =>
        (Object.fromEntries(
          Object.entries((try s3vectors.listTagsForResource({ resourceArn })).tags ?? {}).filter(([, v]) =>
            v !== undefined
          ),
        ) as Record<string, string>) catch effect (e) => match (e) {
          when { _tag: "NotFoundException" }: {} as Record<string, string>;
          default: throw e;
        }

      const observedPolicy = effect (vectorBucketName: string) =>
        (try s3vectors.getVectorBucketPolicy({ vectorBucketName })).policy catch effect (e) => match (e) {
          when { _tag: "NotFoundException" }: undefined as string | undefined;
          default: throw e;
        }

      const desiredEncryption = (props: VectorBucketProps): infer _ =>
        props.encryption
          ? {
            sseType: props.encryption.sseType,
            kmsKeyArn: props.encryption.kmsKeyArn,
          }
          : undefined

      return VectorBucket.Provider.of({
        stables: ["vectorBucketName", "vectorBucketArn"],
        list: effect () => {
          const buckets = try s3vectors.listVectorBuckets.items({}).pipe(Stream.runCollect)
          return Array.from(buckets).map((b) => ({
            vectorBucketName: b.vectorBucketName,
            vectorBucketArn: b.vectorBucketArn,
          }))
        },
        read: effect ({ id, olds, output }) => {
          const name = output?.vectorBucketName ?? (try createName(id, olds ?? {}))
          const found = try observe(name)
          if (!found) return undefined
          const attrs = {
            vectorBucketName: found.vectorBucketName,
            vectorBucketArn: found.vectorBucketArn,
          }
          const tags = try observedTags(found.vectorBucketArn)
          return (try hasAlchemyTags(id, tags)) ? attrs : Unowned(attrs)
        },
        diff: effect ({ id, news, olds }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createName(id, olds ?? {})
          const newName = try createName(id, news ?? {})
          if (oldName !== newName) return { action: "replace" } as const
          // Encryption is fixed at create time — any change replaces.
          if (encryptionKey(olds?.encryption) !== encryptionKey(news?.encryption)) {
            return { action: "replace" } as const
          }
          // fall through: engine default update (tags only)
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = output?.vectorBucketName ?? (try createName(id, news))
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. OBSERVE — cloud state is authoritative.
          let live = try observe(name)

          // 2. ENSURE — create when missing; a concurrent create surfaces as
          //    ConflictException, which we treat as a race and re-observe.
          if (live === undefined) {
            s3vectors
              .createVectorBucket({
                vectorBucketName: name,
                encryptionConfiguration: desiredEncryption(news),
                tags: desiredTags,
              }) catch effect (e) => match (e) { when { _tag: "ConflictException" }: try Effect.void; default: throw e; }
            live = try observe(name)
          }

          const vectorBucketArn = live?.vectorBucketArn ?? output?.vectorBucketArn

          // 3. SYNC TAGS — diff against OBSERVED cloud tags so adoption and
          //    drift converge (create-time tags only apply on first create).
          if (vectorBucketArn !== undefined) {
            const currentTags = try observedTags(vectorBucketArn)
            const { upsert, removed } = diffTags(currentTags, desiredTags)
            if (upsert.length > 0) {
              try s3vectors.tagResource({
                resourceArn: vectorBucketArn,
                tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
              })
            }
            if (removed.length > 0) {
              try s3vectors.untagResource({
                resourceArn: vectorBucketArn,
                tagKeys: removed,
              })
            }
          }

          // 4. SYNC POLICY — diff desired against the OBSERVED bucket policy
          //    so adoption and drift converge (delete when the prop is gone).
          const desiredPolicy = news.policy !== undefined && news.policy.length > 0
            ? JSON.stringify({
              Version: "2012-10-17",
              Statement: news.policy,
            })
            : undefined
          const existingPolicy = try observedPolicy(name)
          if (desiredPolicy !== undefined) {
            if (existingPolicy !== desiredPolicy) {
              try s3vectors.putVectorBucketPolicy({
                vectorBucketName: name,
                policy: desiredPolicy,
              })
              try session.note(`Updated bucket policy: ${name}`)
            }
          } else if (existingPolicy !== undefined) {
            s3vectors
              .deleteVectorBucketPolicy({ vectorBucketName: name }) catch effect (e) => match (e) {
                when { _tag: "NotFoundException" }: try Effect.void;
                default: throw e;
              }
            try session.note(`Removed bucket policy: ${name}`)
          }

          try session.note(name)
          return { vectorBucketName: name, vectorBucketArn: vectorBucketArn! }
        },
        delete: effect ({ output, force }) => {
          const vectorBucketName = output.vectorBucketName
          if (force !== true) {
            s3vectors
              .deleteVectorBucket({ vectorBucketName }) catch effect (e) => match (e) {
                when { _tag: "NotFoundException" }: try Effect.void;
                default: throw e;
              }
            return
          }

          const purgeAndDelete = effect {
            // Indexes are scoped to their bucket and invisible to a global
            // nuke scan. Only the explicit force path may purge them.
            const indexes = (Array.from(
              try (s3vectors.listIndexes.items({ vectorBucketName })
                |> Stream.runCollect(%)),
            )) catch effect (e) => match (e) { when { _tag: "NotFoundException" }: []; default: throw e; }
            try Effect.forEach(
              indexes,
              effect (index) =>
                s3vectors
                  .deleteIndex({
                    vectorBucketName,
                    indexName: index.indexName,
                  }) catch effect (e) => match (e) {
                    when { _tag: "NotFoundException" }: try Effect.void;
                    default: throw e;
                  },
              { concurrency: 4, discard: true },
            )
            try s3vectors.deleteVectorBucket({ vectorBucketName })
          }
          ;(try (purgeAndDelete
            |> Effect.retry(%, {
              while: (e) => e._tag === "ConflictException" || e._tag === "ServiceUnavailableException",
              schedule: Schedule.max([Schedule.exponential(500), Schedule.recurs(8)]),
            }))) catch effect (e) => match (e) { when { _tag: "NotFoundException" }: try Effect.void; default: throw e; }
        },
      })
    },
  )
