import * as s3vectors from "@distilled.cloud/aws/s3vectors"
import * as Effect from "effect/Effect"
/**
 * Shared scaffolding for the S3 Vectors data-plane HTTP bindings.
 *
 * NOT exported from `index.ts` — the per-level `Vectors{Read,Write,}Http.ts`
 * layers are thin compositions over this builder. Everything except the
 * distilled operations and the IAM action set is boilerplate:
 *
 * - the deploy-time half registers `Allow(host, AWS.S3Vectors.{name}(index))`
 *   with the requested actions on exactly the bound index's ARN;
 * - the runtime client methods inject the resolved `indexArn` into each
 *   distilled request.
 */
import * as AWSBindings from "../AWSBindings.ts"
import type { Index } from "./VectorIndex.vibe"
import type { GetVectorsRequest, ListVectorsRequest, QueryVectorsRequest, ReadVectorsClient } from "./VectorsRead.vibe"
import type { DeleteVectorsRequest, PutVectorsRequest, WriteVectorsClient } from "./VectorsWrite.vibe"

/** IAM actions granted by the read-level binding. */
export const readVectorsActions = [
  "s3vectors:QueryVectors",
  "s3vectors:GetVectors",
  "s3vectors:ListVectors",
] as const

/** IAM actions granted by the write-level binding. */
export const writeVectorsActions = ["s3vectors:PutVectors", "s3vectors:DeleteVectors"] as const

/**
 * Build the shared body of an S3 Vectors data-plane `*Http` binding layer:
 * resolve the distilled operations once at layer construction (via
 * `makeClient`), register the least-privilege IAM statement on the host
 * Function at deploy time, and hand the per-index `indexArn` resolver to the
 * capability-specific client builder.
 */
export const makeVectorsHttpBinding = effect <Client, R>(options: {
  /** Capability name in the binding SID + trace spans, e.g. `"VectorsRead"`. */
  mutable name: string
  /** IAM actions granted on the bound index's ARN. */
  mutable actions: readonly string[]
  /** Layer-scoped builder of the per-index typed runtime client. */
  mutable makeClient: ((indexArn: string!!, label: string) => Client)!never!R
}) => {
  const bind = try AWSBindings.Bind
  const makeClient = try options.makeClient

  return effect <I extends Index>(index: I) => {
    const IndexArn = try index.indexArn.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`AWS.S3Vectors.${options.name}(${index})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [index.indexArn],
          },
        ],
      })
    }
    return makeClient(IndexArn, `AWS.S3Vectors.${options.name}(${index.LogicalId})`)
  }
}

/** Layer-scoped builder of the read-level {@link ReadVectorsClient}. */
export const makeReadVectorsClient = effect {
  const queryVectors = try AWSBindings.withCredentials(s3vectors.queryVectors)
  const getVectors = try AWSBindings.withCredentials(s3vectors.getVectors)
  const listVectors = try AWSBindings.withCredentials(s3vectors.listVectors)

  return (IndexArn: string!!, label: string): ReadVectorsClient => ({
    query: effect (request: QueryVectorsRequest) =>
      try withSpan(
        effect {
          const indexArn = try IndexArn
          return try queryVectors({ ...request, indexArn })
        },
        `${label}.query`,
      ),
    get: effect (request: GetVectorsRequest) =>
      try withSpan(
        effect {
          const indexArn = try IndexArn
          return try getVectors({ ...request, indexArn })
        },
        `${label}.get`,
      ),
    list: effect (request: ListVectorsRequest) =>
      try withSpan(
        effect {
          const indexArn = try IndexArn
          return try listVectors({ ...request, indexArn })
        },
        `${label}.list`,
      ),
  })
}

/** Layer-scoped builder of the write-level {@link WriteVectorsClient}. */
export const makeWriteVectorsClient = effect {
  const putVectors = try AWSBindings.withCredentials(s3vectors.putVectors)
  const deleteVectors = try AWSBindings.withCredentials(s3vectors.deleteVectors)

  return (IndexArn: string!!, label: string): WriteVectorsClient => ({
    put: effect (request: PutVectorsRequest) =>
      try withSpan(
        effect {
          const indexArn = try IndexArn
          return try putVectors({ ...request, indexArn })
        },
        `${label}.put`,
      ),
    delete: effect (request: DeleteVectorsRequest) =>
      try withSpan(
        effect {
          const indexArn = try IndexArn
          return try deleteVectors({ ...request, indexArn })
        },
        `${label}.delete`,
      ),
  })
}
