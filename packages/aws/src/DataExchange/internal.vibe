import * as dataexchange from "@distilled.cloud/aws/dataexchange"
import { diffTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"

/**
 * Coerce a DataExchange wire tag map (values decode as `string | undefined`)
 * into a plain `Record<string, string>`.
 */
export const toTagRecord = (
  tags: { mutable [key: string]: string | undefined } | undefined,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(tags ?? {}).filter(
      (entry): entry is [string, string] => typeof entry[1] === "string",
    ),
  )

/**
 * Read the observed tags of a DataExchange resource by ARN. Tag reads are
 * best-effort — a failure (e.g. a race with deletion) reports no tags.
 */
export const readDataExchangeTags = effect (arn: string) => {
  const response = dataexchange
    .listTagsForResource({ ResourceArn: arn }) catch () => undefined
  return toTagRecord(response?.Tags)
}

/**
 * Sync tags on a DataExchange resource: diff the OBSERVED cloud tags against
 * the desired set and apply only the delta.
 */
export const syncDataExchangeTags = effect (
  arn: string,
  desiredTags: Record<string, string>,
) => {
  const observedTags = try readDataExchangeTags(arn)
  const { removed, upsert } = diffTags(observedTags, desiredTags)
  if (upsert.length > 0) {
    try dataexchange.tagResource({
      ResourceArn: arn,
      Tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
    })
  }
  if (removed.length > 0) {
    try dataexchange.untagResource({ ResourceArn: arn, TagKeys: removed })
  }
}
