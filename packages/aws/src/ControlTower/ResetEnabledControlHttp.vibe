import * as controltower from "@distilled.cloud/aws/controltower"
import * as Layer from "effect/Layer"
import { makeControlTowerHttpBinding } from "./BindingHttp.vibe"
import type { EnabledControl } from "./EnabledControl.vibe"
import { ResetEnabledControl } from "./ResetEnabledControl.vibe"

export const ResetEnabledControlHttp = Layer.effect(
  ResetEnabledControl,
  makeControlTowerHttpBinding({
    capability: "ResetEnabledControl",
    iamActions: ["controltower:ResetEnabledControl"],
    requestKey: "enabledControlIdentifier",
    identifier: (enabledControl: EnabledControl) => enabledControl.enabledControlArn,
    operation: controltower.resetEnabledControl,
  }),
)
