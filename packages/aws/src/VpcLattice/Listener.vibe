import * as vpclattice from "@distilled.cloud/aws/vpc-lattice"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags, tagRecord } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { retryOnConflict, waitUntilAbsent } from "./internal.vibe"

export error VpcLatticeListenerUnexpectedResponse {
  message: string
  cause?: unknown
}

/**
 * The action a listener (or rule) applies to matched traffic: forward to
 * weighted target groups or answer with a fixed HTTP status.
 */
export type ListenerAction = vpclattice.RuleAction

export interface ListenerProps {
  /**
   * ID or ARN of the lattice service the listener belongs to. Immutable —
   * changing it replaces the listener.
   */
  serviceIdentifier: string
  /**
   * Name of the listener. If omitted, a unique name is generated. Immutable —
   * changing it replaces the listener.
   */
  name?: string
  /**
   * Listener protocol (`HTTP`, `HTTPS`, or `TLS_PASSTHROUGH`). Immutable —
   * changing it replaces the listener.
   */
  protocol: "HTTP" | "HTTPS" | "TLS_PASSTHROUGH"
  /**
   * Listener port. Defaults to the protocol's default port (80 for HTTP,
   * 443 for HTTPS). Immutable — changing it replaces the listener.
   */
  port?: number
  /**
   * Action applied to requests that match no rule: forward to weighted
   * target groups or return a fixed response status.
   */
  defaultAction: ListenerAction
  /**
   * User-defined tags to apply to the listener.
   */
  tags?: Record<string, string>
}

export interface Listener extends
  Resource<
    "AWS.VpcLattice.Listener",
    ListenerProps,
    {
      /**
       * Service-assigned unique ID of the listener.
       */
      listenerId: string
      /**
       * ARN of the listener.
       */
      listenerArn: string
      /**
       * Physical name of the listener.
       */
      name: string
      /**
       * Listener protocol.
       */
      protocol: string
      /**
       * Listener port.
       */
      port?: number
      /**
       * ID of the owning lattice service.
       */
      serviceId: string
      /**
       * ARN of the owning lattice service.
       */
      serviceArn?: string
      /**
       * Current tags reported for the listener.
       */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An Amazon VPC Lattice listener — the process on a lattice service that
 * checks for connection requests on a protocol/port and routes them via its
 * default action and rules.
 *
 * ### Creating Listeners
 * **Example:** HTTP Listener with a Fixed Default Response
 * ```typescript
 * const listener = yield* Listener("HttpListener", {
 *   serviceIdentifier: service.serviceId,
 *   protocol: "HTTP",
 *   port: 80,
 *   defaultAction: { fixedResponse: { statusCode: 404 } },
 * });
 * ```
 *
 * **Example:** Listener Forwarding to a Target Group
 * ```typescript
 * const listener = yield* Listener("ApiListener", {
 *   serviceIdentifier: service.serviceId,
 *   protocol: "HTTP",
 *   defaultAction: {
 *     forward: {
 *       targetGroups: [
 *         { targetGroupIdentifier: targets.targetGroupId, weight: 100 },
 *       ],
 *     },
 *   },
 * });
 * ```
 *
 * @resource
 */
export const Listener = Resource<Listener>("AWS.VpcLattice.Listener")

export const ListenerProvider = (): infer _ =>
  Provider.effect(
    Listener,
    effect {
      const toName = effect (
        id: string,
        props: { name?: string } = {},
      ) => (props.name ? props.name : try createPhysicalName({ id, maxLength: 63, lowercase: true }))

      const observe = effect (serviceIdentifier: string, listenerIdentifier: string) =>
        vpclattice
          .getListener({ serviceIdentifier, listenerIdentifier }) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: undefined;
            default: throw e;
          }

      const findByName = effect (serviceIdentifier: string, name: string) =>
        (effect {
          return (try effect {
            const summary = Array.from(
              try (vpclattice.listListeners.pages({ serviceIdentifier })
                |> Stream.runCollect(%)),
            )
              .flatMap((page) => page.items ?? [])
              .find((l) => l.name === name)
            return (summary?.id ? try observe(serviceIdentifier, summary.id) : undefined)
          })
        }) catch effect (e) => match (e) {
          when { _tag: "ResourceNotFoundException" }: undefined;
          default: throw e;
        }

      const syncTags = effect (arn: string, desiredTags: Record<string, string>) => {
        const listed = try vpclattice.listTagsForResource({
          resourceArn: arn,
        })
        const { removed, upsert } = try Effect.orDie(
          Effect.try({ try: () => diffTags(tagRecord(listed.tags), desiredTags), catch: (e) => e }),
        )
        if (upsert.length > 0) {
          try vpclattice.tagResource({
            resourceArn: arn,
            tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
          })
        }
        if (removed.length > 0) {
          try vpclattice.untagResource({
            resourceArn: arn,
            tagKeys: removed,
          })
        }
      }

      return {
        stables: ["listenerId", "listenerArn", "name", "serviceId", "serviceArn"],
        diff: effect ({ id, olds, news }) => {
          const resolved = try Effect.orDie(
            Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
          )
          if (resolved === undefined) return
          if ((try toName(id, olds ?? {})) !== (try toName(id, resolved ?? {}))) {
            return { action: "replace" } as const
          }
          if (
            olds?.serviceIdentifier !== resolved.serviceIdentifier
            || olds?.protocol !== resolved.protocol
            || (olds?.port ?? undefined) !== resolved.port
          ) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const serviceIdentifier = output?.serviceId ?? olds?.serviceIdentifier
          if (!serviceIdentifier) return undefined
          const listener = output?.listenerId
            ? try observe(serviceIdentifier, output.listenerId)
            : try findByName(serviceIdentifier, try toName(id, olds ?? {}))
          if (!listener?.arn || !listener.id || !listener.serviceId) {
            return undefined
          }
          const listed = try vpclattice.listTagsForResource({
            resourceArn: listener.arn,
          })
          const attrs = {
            listenerId: listener.id,
            listenerArn: listener.arn,
            name: listener.name!,
            protocol: listener.protocol ?? "HTTP",
            port: listener.port,
            serviceId: listener.serviceId,
            serviceArn: listener.serviceArn,
            tags: try Effect.orDie(Effect.try({ try: () => tagRecord(listed.tags), catch: (e) => e })),
          }
          return (try hasAlchemyTags(id, listed.tags))
            ? attrs
            : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = try toName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }

          // Observe — prefer the stable id cache, fall back to name lookup.
          let listener = output?.listenerId
            ? try observe(news.serviceIdentifier, output.listenerId)
            : try findByName(news.serviceIdentifier, name)

          // Ensure — create if missing.
          if (!listener?.arn || !listener.id) {
            listener = retryOnConflict(
              vpclattice.createListener({
                serviceIdentifier: news.serviceIdentifier,
                name,
                protocol: news.protocol,
                port: news.port,
                defaultAction: news.defaultAction,
              }),
            ) catch effect (e) => match (e) {
              when { _tag: "ConflictException" }: try findByName(news.serviceIdentifier, name);
              default: throw e;
            }
            if (!listener?.arn || !listener.id) {
              throw new VpcLatticeListenerUnexpectedResponse({
                message: `Failed to create listener ${name}`,
              })
            }
          } else if (
            JSON.stringify(listener.defaultAction) !== JSON.stringify(news.defaultAction)
          ) {
            // Sync default action — the only mutable setting.
            try retryOnConflict(
              vpclattice.updateListener({
                serviceIdentifier: news.serviceIdentifier,
                listenerIdentifier: listener.id,
                defaultAction: news.defaultAction,
              }),
            )
          }

          try syncTags(listener.arn, desiredTags)

          try session.note(listener.arn)
          return {
            listenerId: listener.id,
            listenerArn: listener.arn,
            name,
            protocol: listener.protocol ?? news.protocol,
            port: listener.port,
            serviceId: listener.serviceId ?? news.serviceIdentifier,
            serviceArn: listener.serviceArn,
            tags: desiredTags,
          }
        },
        // Sub-resource: listeners are keyed by their owning lattice service
        // and are removed with it, so nuke has nothing to enumerate.
        list: effect () => [] as Listener["Attributes"][],
        delete: effect ({ output }) => {
          retryOnConflict(
            vpclattice.deleteListener({
              serviceIdentifier: output.serviceId,
              listenerIdentifier: output.listenerId,
            }),
          ) catch effect (e) => match (e) {
            when { _tag: "ResourceNotFoundException" }: (undefined as void);
            default: throw e;
          }
          try waitUntilAbsent(observe(output.serviceId, output.listenerId))
        },
      }
    },
  )
