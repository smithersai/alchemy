import * as vpclattice from "@distilled.cloud/aws/vpc-lattice"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, diffTags, hasAlchemyTags, tagRecord } from "alchemy/Tags"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import type { Providers } from "../Providers.vibe"
import { retryOnConflict, waitUntilAbsent } from "./internal.vibe"

export class ServiceNetworkUnexpectedResponse extends Data.TaggedError(
  "ServiceNetworkUnexpectedResponse",
)<{
  readonly message: string
  readonly cause?: unknown
}> {}

/**
 * Authorization mode for a service network. `NONE` allows all traffic;
 * `AWS_IAM` requires an auth policy.
 */
export type ServiceNetworkAuthType = "NONE" | "AWS_IAM"

export interface ServiceNetworkProps {
  /**
   * Name of the service network. If omitted, a unique name is generated.
   * Immutable — changing it replaces the resource.
   */
  name?: string
  /**
   * Authorization type for the network.
   * @default "NONE"
   */
  authType?: ServiceNetworkAuthType
  /**
   * User-defined tags to apply to the service network.
   */
  tags?: Record<string, string>
}

export interface ServiceNetwork extends
  Resource<
    "AWS.VpcLattice.ServiceNetwork",
    ServiceNetworkProps,
    {
      /**
       * Service-assigned unique ID of the service network.
       */
      serviceNetworkId: string
      /**
       * ARN of the service network.
       */
      serviceNetworkArn: string
      /**
       * Physical name of the service network.
       */
      name: string
      /**
       * Effective authorization type.
       */
      authType: ServiceNetworkAuthType
      /**
       * Current tags reported for the service network.
       */
      tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An Amazon VPC Lattice service network — the logical boundary that connects
 * services and VPCs into one application network. Cheap control-plane resource
 * with no per-hour charge until VPCs or services are associated.
 *
 * ### Creating Service Networks
 * **Example:** Basic Service Network
 * ```typescript
 * const network = yield* ServiceNetwork("AppNetwork", {});
 * ```
 *
 * **Example:** IAM-Authorized Network
 * ```typescript
 * const network = yield* ServiceNetwork("SecureNetwork", {
 *   authType: "AWS_IAM",
 *   tags: { Environment: "prod" },
 * });
 * ```
 *
 * @resource
 */
export const ServiceNetwork = Resource<ServiceNetwork>("AWS.VpcLattice.ServiceNetwork")

export const ServiceNetworkProvider = () =>
  Provider.effect(
    ServiceNetwork,
    effect {
      const toName = (id: string, props: { name?: string } = {}) =>
        props.name
          ? Effect.succeed(props.name)
          : createPhysicalName({ id, maxLength: 63, lowercase: true })

      // getServiceNetwork only accepts an id or ARN — never a name. Look up by
      // id when we have one, and fall back to enumerating for name-based
      // discovery (adoption / lost-state recovery / create-conflict recovery).
      const observe = (serviceNetworkIdentifier: string) =>
        vpclattice
          .getServiceNetwork({ serviceNetworkIdentifier })
          .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.undefined))

      const findByName = (name: string) =>
        vpclattice.listServiceNetworks.pages({}).pipe(
          Stream.runCollect,
          Effect.map((chunk) =>
            Array.from(chunk)
              .flatMap((page) => page.items ?? [])
              .find((s) => s.name === name)
          ),
          Effect.flatMap((summary) => (summary?.id ? observe(summary.id) : Effect.undefined)),
        )

      const syncTags = effect (arn: string, desiredTags: Record<string, string>) => {
        const listed = try vpclattice.listTagsForResource({
          resourceArn: arn,
        })
        const { removed, upsert } = diffTags(tagRecord(listed.tags), desiredTags)
        if (upsert.length > 0) {
          try vpclattice.tagResource({
            resourceArn: arn,
            tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
          })
        }
        if (removed.length > 0) {
          try vpclattice.untagResource({
            resourceArn: arn,
            tagKeys: removed,
          })
        }
      }

      const isOwnedAssociation = effect (
        arn: string,
        ownerTags: Record<string, string>,
      ) => {
        const listed = try vpclattice
          .listTagsForResource({ resourceArn: arn })
          .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.undefined))
        if (!listed) return false
        const tags = tagRecord(listed.tags)
        return (
          tags["alchemy::id"] !== undefined
          && tags["alchemy::stack"] === ownerTags["alchemy::stack"]
          && tags["alchemy::stage"] === ownerTags["alchemy::stage"]
        )
      }

      const deleteVpcAssociations = effect (
        serviceNetworkId: string,
        ownerTags: Record<string, string>,
        force: boolean,
      ) => {
        const pages = try vpclattice.listServiceNetworkVpcAssociations
          .pages({ serviceNetworkIdentifier: serviceNetworkId })
          .pipe(Stream.runCollect)
        const associations = Array.from(pages).flatMap((page) => page.items ?? [])
        try Effect.forEach(
          associations,
          (association) =>
            effect {
              if (
                !association.id
                || !association.arn
                || (!force && !(try isOwnedAssociation(association.arn, ownerTags)))
              ) {
                return
              }
              try retryOnConflict(
                vpclattice.deleteServiceNetworkVpcAssociation({
                  serviceNetworkVpcAssociationIdentifier: association.id,
                }),
              ).pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.void))
              try waitUntilAbsent(
                vpclattice
                  .getServiceNetworkVpcAssociation({
                    serviceNetworkVpcAssociationIdentifier: association.id,
                  })
                  .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.undefined)),
              )
            },
          { concurrency: 10 },
        )
      }

      const deleteServiceAssociations = effect (
        serviceNetworkId: string,
        ownerTags: Record<string, string>,
        force: boolean,
      ) => {
        const pages = try vpclattice.listServiceNetworkServiceAssociations
          .pages({ serviceNetworkIdentifier: serviceNetworkId })
          .pipe(Stream.runCollect)
        const associations = Array.from(pages).flatMap((page) => page.items ?? [])
        try Effect.forEach(
          associations,
          (association) =>
            effect {
              if (
                !association.id
                || !association.arn
                || (!force && !(try isOwnedAssociation(association.arn, ownerTags)))
              ) {
                return
              }
              try retryOnConflict(
                vpclattice.deleteServiceNetworkServiceAssociation({
                  serviceNetworkServiceAssociationIdentifier: association.id,
                }),
              ).pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.void))
              try waitUntilAbsent(
                vpclattice
                  .getServiceNetworkServiceAssociation({
                    serviceNetworkServiceAssociationIdentifier: association.id,
                  })
                  .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.undefined)),
              )
            },
          { concurrency: 10 },
        )
      }

      const deleteResourceAssociations = effect (
        serviceNetworkId: string,
        ownerTags: Record<string, string>,
        force: boolean,
      ) => {
        const pages = try vpclattice.listServiceNetworkResourceAssociations
          .pages({ serviceNetworkIdentifier: serviceNetworkId })
          .pipe(Stream.runCollect)
        const associations = Array.from(pages).flatMap((page) => page.items ?? [])
        try Effect.forEach(
          associations,
          (association) =>
            effect {
              if (
                !association.id
                || !association.arn
                || (!force && !(try isOwnedAssociation(association.arn, ownerTags)))
              ) {
                return
              }
              try retryOnConflict(
                vpclattice.deleteServiceNetworkResourceAssociation({
                  serviceNetworkResourceAssociationIdentifier: association.id,
                }),
              ).pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.void))
              try waitUntilAbsent(
                vpclattice
                  .getServiceNetworkResourceAssociation({
                    serviceNetworkResourceAssociationIdentifier: association.id,
                  })
                  .pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.undefined)),
              )
            },
          { concurrency: 10 },
        )
      }

      return {
        stables: ["serviceNetworkId", "serviceNetworkArn", "name"],
        diff: effect ({ id, olds, news }) => {
          const props = try Effect.orDie(
            Effect.try({ try: () => (isResolved(news) ? news : undefined), catch: (e) => e }),
          )
          if (props === undefined) return
          if ((try toName(id, olds ?? {})) !== (try toName(id, props ?? {}))) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const network = output?.serviceNetworkId
            ? try observe(output.serviceNetworkId)
            : try findByName(try toName(id, olds ?? {}))
          if (!network?.arn || !network.id) return undefined
          const listed = try vpclattice.listTagsForResource({
            resourceArn: network.arn,
          })
          const attrs = {
            serviceNetworkId: network.id,
            serviceNetworkArn: network.arn,
            name: network.name!,
            authType: (network.authType as ServiceNetworkAuthType) ?? "NONE",
            tags: tagRecord(listed.tags),
          }
          return (try hasAlchemyTags(id, listed.tags))
            ? attrs
            : (try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e })))
        },
        reconcile: effect ({ id, news, output, session }) => {
          const name = try toName(id, news)
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...internalTags, ...news.tags }
          const desiredAuthType = news.authType ?? "NONE"

          // Observe — prefer the stable id cache, fall back to name lookup.
          let network = output?.serviceNetworkId
            ? try observe(output.serviceNetworkId)
            : try findByName(name)

          // Ensure — create if missing.
          if (!network?.arn || !network.id) {
            network = try vpclattice
              .createServiceNetwork({ name, authType: desiredAuthType })
              .pipe(Effect.catchTag("ConflictException", () => findByName(name)))
            if (!network?.arn || !network.id) {
              return try new ServiceNetworkUnexpectedResponse({
                message: `Failed to create service network ${name}`,
              })
            }
          } else if ((network.authType ?? "NONE") !== desiredAuthType) {
            // Sync auth type — the only mutable setting.
            try vpclattice.updateServiceNetwork({
              serviceNetworkIdentifier: network.id,
              authType: desiredAuthType,
            })
          }

          try syncTags(network.arn, desiredTags)

          try session.note(network.arn)
          return {
            serviceNetworkId: network.id,
            serviceNetworkArn: network.arn,
            name,
            authType: desiredAuthType,
            tags: desiredTags,
          }
        },
        list: () =>
          effect {
            const summaries = try vpclattice.listServiceNetworks.pages({}).pipe(
              Stream.runCollect,
              Effect.map((chunk) => Array.from(chunk).flatMap((page) => page.items ?? [])),
            )
            return try Effect.forEach(
              summaries.filter(
                (s): s is typeof s & { id: string; arn: string } => s.id != null && s.arn != null,
              ),
              (summary) =>
                effect {
                  const network = try observe(summary.id)
                  const listed = try vpclattice.listTagsForResource({
                    resourceArn: summary.arn,
                  })
                  return {
                    serviceNetworkId: summary.id,
                    serviceNetworkArn: summary.arn,
                    name: summary.name!,
                    authType: (network?.authType as ServiceNetworkAuthType) ?? "NONE",
                    tags: tagRecord(listed.tags),
                  }
                },
              { concurrency: 10 },
            )
          },
        delete: effect ({ output, force }) => {
          if (!(try observe(output.serviceNetworkId))) {
            return
          }
          // Nuke discovers resources independently and therefore cannot rely on
          // the stack dependency graph to order association deletion before the
          // service network. An operator-confirmed nuke may remove every
          // attached association blocking deletion. Ordinary stack deletion is
          // deliberately conservative and removes only associations owned by
          // the same Alchemy stack/stage.
          try Effect.all(
            [
              deleteVpcAssociations(output.serviceNetworkId, output.tags, force === true),
              deleteServiceAssociations(output.serviceNetworkId, output.tags, force === true),
              deleteResourceAssociations(output.serviceNetworkId, output.tags, force === true),
            ],
            { concurrency: 3 },
          )
          try retryOnConflict(
            vpclattice.deleteServiceNetwork({
              serviceNetworkIdentifier: output.serviceNetworkId,
            }),
          ).pipe(Effect.catchTag("ResourceNotFoundException", () => Effect.void))
          try waitUntilAbsent(observe(output.serviceNetworkId))
        },
      }
    },
  )
