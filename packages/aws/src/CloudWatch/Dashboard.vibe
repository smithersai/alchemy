import * as cloudwatch from "@distilled.cloud/aws/cloudwatch"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { AWSEnvironment, type AccountID } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import { createName, retryConcurrent } from "./common.ts"

export error DashboardUnexpectedResponse {
  message: string
  cause?: unknown
}

export type DashboardName = string
export type DashboardArn = `arn:aws:cloudwatch::${AccountID}:dashboard/${string}`

export type DashboardPeriodOverride = "inherit" | "auto"
export type DashboardMetricRow = (string | number | boolean | null)[]

export interface DashboardMetricWidgetProperties {
  mutable title?: string
  mutable region?: string
  mutable stat?: string
  mutable period?: number
  mutable view?: "timeSeries" | "singleValue" | "gauge" | "bar" | "pie"
  mutable stacked?: boolean
  mutable metrics: DashboardMetricRow[]
  mutable annotations?: Record<string, unknown>
  mutable yAxis?: Record<string, unknown>
  mutable legend?: Record<string, unknown>
  mutable [key: string]: unknown
}

export interface DashboardTextWidgetProperties {
  mutable markdown: string
  mutable [key: string]: unknown
}

export interface DashboardAlarmStatusWidgetProperties {
  mutable alarms: string[]
  mutable title?: string
  mutable sortBy?: string
  mutable states?: string[]
  mutable [key: string]: unknown
}

export interface DashboardLogWidgetProperties {
  mutable query: string
  mutable region?: string
  mutable title?: string
  mutable view?: "table" | "timeSeries" | "bar" | "pie"
  mutable [key: string]: unknown
}

export interface DashboardMetricWidget {
  mutable type: "metric"
  mutable x?: number
  mutable y?: number
  mutable width?: number
  mutable height?: number
  mutable properties: DashboardMetricWidgetProperties
}

export interface DashboardTextWidget {
  mutable type: "text"
  mutable x?: number
  mutable y?: number
  mutable width?: number
  mutable height?: number
  mutable properties: DashboardTextWidgetProperties
}

export interface DashboardAlarmStatusWidget {
  mutable type: "alarm"
  mutable x?: number
  mutable y?: number
  mutable width?: number
  mutable height?: number
  mutable properties: DashboardAlarmStatusWidgetProperties
}

export interface DashboardLogWidget {
  mutable type: "log"
  mutable x?: number
  mutable y?: number
  mutable width?: number
  mutable height?: number
  mutable properties: DashboardLogWidgetProperties
}

export type DashboardWidget =
  | DashboardMetricWidget
  | DashboardTextWidget
  | DashboardAlarmStatusWidget
  | DashboardLogWidget

export interface DashboardBody {
  mutable start?: string
  mutable end?: string
  mutable periodOverride?: DashboardPeriodOverride
  mutable widgets: DashboardWidget[]
  mutable variables?: Record<string, unknown>[]
}

export interface DashboardProps extends
  Omit<
    cloudwatch.PutDashboardInput,
    "DashboardName" | "DashboardBody"
  >
{
  /**
   * Name of the dashboard. If omitted, a unique name is generated.
   */
  mutable name?: DashboardName
  /**
   * Structured dashboard document. The provider serializes it to the JSON
   * string expected by the CloudWatch API.
   */
  mutable DashboardBody: DashboardBody
  /**
   * Optional tags to apply to the dashboard.
   *
   * CloudWatch dashboards do not currently support the generic CloudWatch
   * tagging APIs, so these values are accepted for API consistency but are not
   * persisted remotely.
   */
  mutable tags?: Record<string, string>
}

export interface Dashboard extends
  Resource<
    "AWS.CloudWatch.Dashboard",
    DashboardProps,
    {
      /** Physical name of the dashboard. */
      mutable dashboardName: DashboardName
      /** ARN of the dashboard. */
      mutable dashboardArn: DashboardArn
      /** The parsed dashboard document as last read from CloudWatch. */
      mutable dashboardBody: DashboardBody | undefined
      /** Tags accepted for API consistency (not persisted remotely). */
      mutable tags: Record<string, string>
    },
    never,
    Providers
  >
{}

/**
 * An Amazon CloudWatch dashboard. The `DashboardBody` is a structured,
 * typed document (metric, text, alarm-status, and log widgets) that the
 * provider serializes to the JSON string CloudWatch expects.
 * ### Creating Dashboards
 * **Example:** Basic Dashboard
 * ```typescript
 * const dashboard = yield* Dashboard("OpsDashboard", {
 *   DashboardBody: {
 *     widgets: [],
 *   },
 * });
 * ```
 *
 * **Example:** Dashboard with Metric and Text Widgets
 * ```typescript
 * const dashboard = yield* Dashboard("PaymentsDashboard", {
 *   DashboardBody: {
 *     widgets: [
 *       {
 *         type: "text",
 *         x: 0, y: 0, width: 6, height: 3,
 *         properties: { markdown: "# Payments service" },
 *       },
 *       {
 *         type: "metric",
 *         x: 0, y: 3, width: 12, height: 6,
 *         properties: {
 *           title: "Payments processed",
 *           metrics: [["MyApp/Payments", "PaymentProcessed"]],
 *           stat: "Sum",
 *           period: 60,
 *           view: "timeSeries",
 *         },
 *       },
 *     ],
 *   },
 * });
 * ```
 *
 * ### Reading Dashboards at Runtime
 * **Example:** Read the Dashboard Body from a Function
 * ```typescript
 * // init — bind the dashboard to the function (see GetDashboard)
 * const getDashboard = yield* AWS.CloudWatch.GetDashboard(dashboard);
 *
 * // runtime
 * const result = yield* getDashboard();
 * const body = JSON.parse(result.DashboardBody ?? "{}");
 * ```
 *
 * @resource
 */
export const Dashboard = Resource<Dashboard>("AWS.CloudWatch.Dashboard")

const serializeDashboardBody = (body: DashboardBody): infer _ => JSON.stringify(body)

const parseDashboardBody = (body: string | undefined): infer _ => {
  if (!body) {
    return undefined
  }
  return JSON.parse(body) as DashboardBody
}

export const DashboardProvider = (): infer _ =>
  Provider.effect(
    Dashboard,
    effect {
      const createDashboardName = (id: string, props: { mutable name?: string } = {}) => createName(id, props.name, 255)

      const dashboardArn = effect (dashboardName: string) =>
        `arn:aws:cloudwatch::${(try AWSEnvironment.current).accountId}:dashboard/${dashboardName}` as DashboardArn

      const readDashboard = effect (dashboardName: string) => {
        const output = cloudwatch
          .getDashboard({
            DashboardName: dashboardName,
          }) catch effect (e) => match (e) {
            when { _tag: "DashboardNotFoundError" }: try Effect.undefined;
            default: throw e;
          }

        if (!output?.DashboardName) {
          return undefined
        }

        return {
          dashboardName: output.DashboardName,
          dashboardArn: try dashboardArn(output.DashboardName),
          dashboardBody: parseDashboardBody(output.DashboardBody),
          tags: {},
        }
      }

      return {
        stables: ["dashboardName", "dashboardArn"],
        diff: effect ({ id, olds = {}, news = {} as DashboardProps }) => {
          if (!isResolved(news)) return undefined
          const oldName = try createDashboardName(id, olds)
          const newName = try createDashboardName(id, news)

          if (oldName !== newName) {
            return { action: "replace" } as const
          }
        },
        read: effect ({ id, olds, output }) => {
          const name = output?.dashboardName ?? (try createDashboardName(id, olds ?? {}))
          return try readDashboard(name)
        },
        reconcile: effect ({ id, news, output, session }) => {
          // Observe — pin the physical name from `output` if present so we
          // never rename an existing dashboard; otherwise derive from
          // desired props.
          const name = output?.dashboardName ?? (try createDashboardName(id, news))

          // Ensure — `putDashboard` is a pure upsert. The CloudWatch
          // dashboard API has no separate update path, so we always send
          // the full body and let the API converge.
          try retryConcurrent(
            cloudwatch.putDashboard({
              DashboardName: name,
              DashboardBody: serializeDashboardBody(news.DashboardBody),
            }),
          )

          try session.note(try dashboardArn(name))

          const state = try readDashboard(name)
          if (!state) {
            throw new DashboardUnexpectedResponse({
              message: `failed to read reconciled dashboard '${name}'`,
            })
          }

          // Dashboards do not support the generic CloudWatch tagging APIs,
          // so `tags` is always returned as an empty record.
          return {
            ...state,
            tags: {},
          }
        },
        delete: effect ({ output }) => {
          // `DeleteDashboards` is idempotent: AWS returns success (not
          // `DashboardNotFoundError`) for names that don't exist, so a
          // re-delete after a state-persistence failure is a safe no-op.
          try retryConcurrent(
            cloudwatch.deleteDashboards({
              DashboardNames: [output.dashboardName],
            }),
          )
        },
        list: effect () => {
          // `listDashboards` only returns entry metadata (name/arn/size),
          // not the body, so we re-read each dashboard to produce the full
          // Attributes shape `read` returns.
          const names = Array.from(
            try (cloudwatch.listDashboards.pages({})
              |> Stream.runCollect(%)),
          ).flatMap((page) =>
            (page.DashboardEntries ?? [])
              .map((entry) => entry.DashboardName)
              .filter((name): name is string => name != null)
          )

          const states = try Effect.forEach(names, (name) => readDashboard(name), {
            concurrency: 10,
          })

          return states.filter(
            (state): state is NonNullable<typeof state> => state !== undefined,
          )
        },
      }
    },
  )
