import * as Effect from "effect/Effect"
import type * as cloudwatch from "@distilled.cloud/aws/cloudwatch"
import { makeBatchedSink } from "alchemy/Util/BatchedSink"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import { MetricSink, type MetricSinkDatum, type MetricSinkProps } from "./MetricSink.vibe"
import { PutMetricData } from "./PutMetricData.vibe"

const encoder = new TextEncoder()

/**
 * PutMetricData accepts up to 1 MB per POST; approximate each datum's wire
 * size by its JSON encoding and leave headroom for the request envelope
 * (`Action`, `Namespace`, form-encoding overhead).
 */
const MAX_BYTES = 1_000_000

export const MetricSinkHttp = Layer.effect(
  MetricSink,
  effect {
    const bind = try AWSBindings.Bind
    const putMetricData = try PutMetricData

    return effect (props: MetricSinkProps) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.CloudWatch.MetricSink(${props.Namespace})`({
          policyStatements: [
            {
              Effect: "Allow",
              // PutMetricData does not support resource-level permissions.
              Action: ["cloudwatch:PutMetricData"],
              Resource: ["*"],
            },
          ],
        })
      }
      const put = try putMetricData()
      return (try effect {
        const sinkOptions: Parameters<
          typeof makeBatchedSink<
            MetricSinkDatum,
            cloudwatch.PutMetricDataResponse,
            cloudwatch.PutMetricDataError
          >
        >[0] = {
          maxRecords: 1000,
          maxBytes: MAX_BYTES,
          sizeOf: (datum): infer _ => encoder.encode(JSON.stringify(datum)).length,
          send: effect (batch) =>
            try put({
              Namespace: props.Namespace,
              MetricData: [...batch],
            }),
          // PutMetricData is all-or-nothing — no per-datum partial failures to
          // extract, so there is no `unprocessed`/`rejected` handling here.
        }
        return try Effect.orDie(Effect.try({
          try: () =>
            makeBatchedSink<
              MetricSinkDatum,
              cloudwatch.PutMetricDataResponse,
              cloudwatch.PutMetricDataError
            >(sinkOptions),
          catch: (error) => error,
        }))
      })
    }
  },
)
