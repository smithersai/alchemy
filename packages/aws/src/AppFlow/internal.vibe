import * as appflow from "@distilled.cloud/aws/appflow"
import { diffTags } from "alchemy/Tags"
import * as Effect from "effect/Effect"

/**
 * Coerce an AppFlow wire tag map (`Record<string, string | undefined>`) into
 * a plain `Record<string, string>`, dropping undefined values.
 */
export const toTagRecord = (
  tags: { [key: string]: string | undefined } | undefined,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(tags ?? {}).filter(
      (entry): entry is [string, string] => typeof entry[1] === "string",
    ),
  )

/**
 * Read the observed tags of an AppFlow resource. Tag reads are best-effort.
 */
export const readAppFlowTags = effect (arn: string) => {
  const response = appflow
    .listTagsForResource({ resourceArn: arn }) catch () => undefined
  return toTagRecord(response?.tags)
}

/**
 * Sync tags on an AppFlow resource: diff the OBSERVED cloud tags against the
 * desired set and apply only the delta.
 */
export const syncAppFlowTags = effect (
  arn: string,
  desiredTags: Record<string, string>,
) => {
  const observedTags = try readAppFlowTags(arn)
  const { removed, upsert } = try Effect.orDie(
    Effect.try({ try: () => diffTags(observedTags, desiredTags), catch: (e) => e }),
  )
  if (upsert.length > 0) {
    try appflow.tagResource({
      resourceArn: arn,
      tags: Object.fromEntries(upsert.map((t) => [t.Key, t.Value])),
    })
  }
  if (removed.length > 0) {
    try appflow.untagResource({ resourceArn: arn, tagKeys: removed })
  }
}
