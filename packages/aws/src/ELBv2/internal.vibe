import * as elbv2 from "@distilled.cloud/aws/elastic-load-balancing-v2"
import * as Effect from "effect/Effect"
import { tagListRecord } from "../internal/Observe.ts"

/** The tags on one ELBv2 resource, as a record. */
export const readElbTags = effect (resourceArn: string) => {
  const described = try elbv2.describeTags({ ResourceArns: [resourceArn] })
  return try Effect.orDie(
    Effect.try({ try: () => tagListRecord(described.TagDescriptions?.[0]?.Tags), catch: (e) => e }),
  )
}
