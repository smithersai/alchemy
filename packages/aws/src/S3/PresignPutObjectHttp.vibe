import type * as Credentials from "@distilled.cloud/aws/Credentials"
import * as Presign from "@distilled.cloud/aws/Presign"
import type * as Region from "@distilled.cloud/aws/Region"
import * as Output from "alchemy/Output"
import * as Layer from "effect/Layer"
import * as AWSBindings from "../AWSBindings.ts"
import type { Bucket } from "./Bucket.vibe"
import { PresignPutObject, type PresignPutObjectRequest } from "./PresignPutObject.vibe"

export const PresignPutObjectHttp = Layer.effect(
  PresignPutObject,
  effect {
    const bind = try AWSBindings.Bind
    const services = try AWSBindings.withCredentials(
      Effect.context<Credentials.Credentials | Region.Region>(),
    )

    return effect (bucket: Bucket) => {
      const BucketName = try bucket.bucketName.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`AWS.S3.PresignPutObject(${bucket})`({
          policyStatements: [
            {
              Effect: "Allow",
              Action: ["s3:PutObject"],
              Resource: [Output.interpolate`${bucket.bucketArn}/*`],
            },
          ],
        })
      }
      return effect (
        request: PresignPutObjectRequest,
      ) =>
        try withSpan(
          effect {
            const bucketName = try BucketName
            return try (Presign.presignS3Url({
              method: "PUT",
              bucket: bucketName,
              key: request.key,
              expiresIn: request.expiresIn,
              contentType: request.contentType,
            })
              |> Effect.provideContext(%, services))
          },
          `AWS.S3.PresignPutObject(${bucket.LogicalId})`,
        )
    }
  },
)
