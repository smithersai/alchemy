import * as Effect from "effect/Effect"
import * as AWSBindings from "../AWSBindings.ts"
import { Region } from "../Region.ts"
import type { EmailContact } from "./EmailContact.vibe"

/**
 * Shared scaffolding for the AWS User Notifications Contacts HTTP bindings.
 *
 * NOT exported from `index.ts` — every thin `{Op}Http.ts` in this service is
 * a `Layer.effect(Cap, makeEmailContactHttpBinding({ … }))` over the builder
 * below. Everything except the operation and the IAM action list is
 * boilerplate.
 *
 * User Notifications Contacts is a global service managed from a single
 * control-plane region (`us-east-1`) — like its sibling `notifications`
 * service — so every operation is resolved with the Region pinned.
 */
const US_EAST_1 = "us-east-1"
const pinContactsRegion = effect <A, E, R>(effect: A!E!R) =>
  try effect {
    provide Region = Effect.succeed(US_EAST_1) {
      return try effect
    }
  }

/**
 * Build the impl Effect for a User Notifications Contacts operation scoped
 * to one {@link EmailContact}: the deploy-time half grants `actions` on the
 * bound contact's ARN, and the runtime half injects the contact's ARN as
 * the `arn` of every request.
 */
export const makeEmailContactHttpBinding = effect <
  I extends { mutable arn: string },
  A,
  E,
  R,
  Req = Omit<I, "arn">,
>(options: {
  /** Fully-qualified binding tag, e.g. `AWS.NotificationsContacts.SendActivationCode`. */
  mutable tag: string
  /** The distilled operation. */
  mutable operation: ((input: I) => A!E)!never!R
  /** IAM actions granted on the email contact ARN. */
  mutable actions: readonly string[]
}) => {
  const bind = try AWSBindings.Bind
  const op = try (options.operation
    |> pinContactsRegion(%)
    |> AWSBindings.withCredentials(%))

  return effect (contact: EmailContact) => {
    // Output yields a DEFERRED effect — resolve again per invocation below.
    const ContactArn = try contact.emailContactArn.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${contact})`({
        policyStatements: [
          {
            Effect: "Allow",
            Action: [...options.actions],
            Resource: [contact.emailContactArn],
          },
        ],
      })
    }
    return effect (request?: Req | undefined) =>
      try withSpan(
        effect {
          const arn = try ContactArn
          // The region must also be pinned at the call site: the yield-time
          // snapshot is only a fallback — the calling fiber's ambient Region
          // (the host Function's own region) wins over it.
          return try pinContactsRegion(op({ ...(request as object), arn } as I))
        },
        `${options.tag}(${contact.LogicalId})`,
      )
  }
}
