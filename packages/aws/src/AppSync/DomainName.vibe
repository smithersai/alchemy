import * as Effect from "effect/Effect"
import * as appsync from "@distilled.cloud/aws/appsync"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { createInternalTags, hasAlchemyTags } from "alchemy/Tags"
import type { Providers } from "../Providers.vibe"
import { retryConcurrentModification, syncAppSyncTags, tagRecord } from "./common.ts"

export interface DomainNameProps {
  /**
   * The custom domain name, e.g. `api.example.com`. Changing it triggers
   * a replacement.
   */
  domainName: string
  /**
   * ARN of an ACM certificate covering the domain. AppSync custom domains
   * are CloudFront-backed, so the certificate **must live in us-east-1**.
   * Changing it triggers a replacement.
   */
  certificateArn: string
  /** Description of the domain. */
  description?: string
  /** Tags to apply. Merged with internal Alchemy tags. */
  tags?: Record<string, string>
}

export interface AppSyncDomainName extends
  Resource<
    "AWS.AppSync.DomainName",
    DomainNameProps,
    {
      /** The custom domain name. */
      domainName: string
      /** The domain name ARN. */
      domainNameArn: string | undefined
      /** The certificate ARN. */
      certificateArn: string
      /**
       * The CloudFront target (`dxxxx.cloudfront.net`) to point a CNAME /
       * Route53 alias at.
       */
      appsyncDomainName: string | undefined
      /** The Route53 hosted zone ID for alias records. */
      hostedZoneId: string | undefined
    },
    never,
    Providers
  >
{}

/**
 * A custom domain name for AppSync GraphQL APIs.
 *
 * Requires an ACM certificate **in us-east-1** (the domain is
 * CloudFront-backed). Attach an API with {@link ApiAssociation} and point
 * DNS at the `appsyncDomainName` attribute.
 * ### Creating Custom Domains
 * **Example:** Custom domain + API association
 * ```typescript
 * const domain = yield* AppSync.DomainName("Domain", {
 *   domainName: "api.example.com",
 *   certificateArn: usEast1Cert.certificateArn,
 * });
 * yield* AppSync.ApiAssociation("Assoc", { domain, api });
 * // CNAME api.example.com → domain.appsyncDomainName
 * ```
 *
 * @resource
 */
export const DomainName = Resource<AppSyncDomainName>("AWS.AppSync.DomainName")

export const DomainNameProvider = (): infer _ =>
  Provider.effect(
    DomainName,
    effect {
      const getDomainSafe = effect (domainName: string) =>
        (effect {
          return (try appsync.getDomainName({ domainName })).domainNameConfig
        }) catch effect (e) => match (e) {
          when { _tag: "NotFoundException" }: undefined;
          default: throw e;
        }

      const toAttributes = (config: appsync.DomainNameConfig): AppSyncDomainName["Attributes"] => ({
        domainName: config.domainName!,
        domainNameArn: config.domainNameArn,
        certificateArn: config.certificateArn!,
        appsyncDomainName: config.appsyncDomainName,
        hostedZoneId: config.hostedZoneId,
      })

      return DomainName.Provider.of({
        stables: ["domainName", "domainNameArn", "appsyncDomainName", "hostedZoneId"],

        list: effect () => {
          const pages = try appsync.listDomainNames.pages({}).pipe(Stream.runCollect)
          return Array.from(pages)
            .flatMap((page) => page.domainNameConfigs ?? [])
            .filter((config) => config.domainName != null)
            .map(toAttributes)
        },

        read: effect ({ id, olds, output }) => {
          const domainName = output?.domainName ?? olds?.domainName
          if (domainName === undefined) return undefined
          const config = try getDomainSafe(domainName)
          if (config?.domainName == null) return undefined
          const attrs = toAttributes(config)
          return (try hasAlchemyTags(
              id,
              try Effect.orDie(Effect.try({ try: () => tagRecord(config.tags), catch: (error) => error })),
            ))
            ? attrs
            : (try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (error) => error })))
        },

        diff: effect ({ news: _newsInput, olds }) => {
          if (!(try Effect.orDie(Effect.try({ try: () => isResolved(_newsInput), catch: (e) => e })))) return undefined
          const news = _newsInput as typeof olds
          if (news.domainName !== olds.domainName || news.certificateArn !== olds.certificateArn) {
            return { action: "replace" } as const
          }
          // description/tags converge via update
        },

        reconcile: effect ({ id, news, session }) => {
          const internalTags = try createInternalTags(id)
          const desiredTags = { ...news.tags, ...internalTags }

          // 1. OBSERVE
          let observed = try getDomainSafe(news.domainName)

          if (observed?.domainName == null) {
            // 2. ENSURE
            const created = try retryConcurrentModification(
              appsync.createDomainName({
                domainName: news.domainName,
                certificateArn: news.certificateArn,
                description: news.description,
                tags: desiredTags,
              }),
            )
            observed = created.domainNameConfig!
            try session.note(`Created domain ${news.domainName}`)
          } else if (news.description !== undefined && observed.description !== news.description) {
            // 3. SYNC
            const updated = try retryConcurrentModification(
              appsync.updateDomainName({
                domainName: news.domainName,
                description: news.description,
              }),
            )
            observed = updated.domainNameConfig ?? observed
            try session.note(`Updated domain ${news.domainName}`)
          }

          // 3b. SYNC TAGS — against OBSERVED cloud tags.
          if (observed.domainNameArn !== undefined) {
            try syncAppSyncTags({
              resourceArn: observed.domainNameArn,
              oldTags: try Effect.orDie(Effect.try({
                try: () => tagRecord(observed.tags),
                catch: (error) => error,
              })),
              newTags: desiredTags,
            })
          }

          try session.note(news.domainName)
          return toAttributes(observed)
        },

        delete: effect ({ output }) => {
          // A domain with a live association cannot be deleted; the
          // association resource is destroyed first (dependency order),
          // but the detach itself is eventually consistent — the
          // ConcurrentModification retry rides that out.
          try retryConcurrentModification(
            effect {
              return appsync
                .deleteDomainName({ domainName: output.domainName }) catch effect (e) => match (e) {
                  when { _tag: "NotFoundException" }: undefined as void;
                  default: throw e;
                }
            },
          )
        },
      })
    },
  )
