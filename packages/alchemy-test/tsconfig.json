{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.vibe"],
  "exclude": ["node_modules", "dist", "vendor", "src/cli.ts"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext"]
  },
  "references": [
    {
      "path": "../alchemy/tsconfig.json"
    }
  ],
  "vibelang": { "trustedPackages": ["@alchemy.run/test", "alchemy"] }
}
