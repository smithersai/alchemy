import { currentWorkingDirectory, resolvePackageFrom } from "./Artifact.platform.js"
import { dotAlchemyDirectory } from "alchemy/AlchemyContext"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { isPathWithin } from "alchemy/Util/isPathWithin"
import { initialCwd } from "alchemy/Util/Node"
import { loadFrontendCore } from "alchemy/Website/FrontendCore"
import { packSiteExtraFiles } from "alchemy/Website/packExtraFiles"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import type { PlatformError } from "effect/PlatformError"
import { createComputeArchive } from "../ComputeArchive.vibe"

export error ArtifactOperationFailed {
  message: string
  cause?: unknown
}

/** Resolved framework output to stage after Website.Server has built it. */
export interface WebsiteArtifactProps {
  /** Application root, relative to the initial working directory. */
  root: string
  /** Build output directory, relative to the initial working directory. */
  distDir: string
  /** Node serve entry, relative to the initial working directory. */
  serverEntry?: string
  /** Generate the shared static-file server instead of tracing a framework entry. */
  static?: {
    /** Unmatched-path behavior. @default "none" */
    notFoundHandling?: "none" | "spa" | "404-page"
    /** Extensionless HTML handling. @default "none" */
    htmlHandling?: "none" | "drop-trailing-slash"
    /** HTML file served for misses, relative to the static output. @default "404.html" */
    errorPage?: string
  }
  /** Next.js keeps its output and configuration beside the serve entry. */
  layout?: "output" | "next"
  /** Build output fingerprint; keeps the build dependency explicit. */
  buildHash?: string
}

/** Internal, filesystem-only artifact lifecycle; never creates cloud resources. */
export interface WebsiteArtifact extends
  Resource<
    "Prisma.WebsiteArtifact",
    WebsiteArtifactProps,
    {
      /** Private directory owned by this artifact resource. */
      directory: string
      /** Verified Compute tarball path. */
      artifactPath: string
      /** SHA-256 of the tarball uploaded by Compute. */
      hash: string
    }
  >
{}

export const WebsiteArtifact = Resource<WebsiteArtifact>("Prisma.WebsiteArtifact")

const MAX_ENTRIES = 50_000
const MAX_BYTES = 768 * 1024 * 1024
const MAX_FILE_BYTES = 128 * 1024 * 1024
const excluded = (relative: string) =>
  relative
    .split(/[\\/]/)
    .some((part) =>
      /^(?:\.git|\.alchemy|\.env(?:\..*)?|\.envrc|\.npmrc|\.yarnrc.*|\.netrc|\.pypirc|\.aws|\.ssh)$/.test(
        part,
      )
    )
const javascript = (file: string) => /\.[cm]?[jt]sx?$/.test(file)
const nextExcluded = (relative: string) =>
  /^\.next\/(?:cache|standalone|types|diagnostics|dev)(?:\/|$)/.test(relative)
  || /^\.next\/trace(?:-|$)/.test(relative)

export error WebsiteTraceError {
  message: string
  cause?: unknown
}

const fail = (message: string) => Effect.fail(new ArtifactOperationFailed({ message }))

/**
 * Stage real build files and NFT's reachable runtime graph without relocating
 * individual modules. Keeping their relative layout preserves import.meta.url,
 * package scopes, pnpm links, and dynamically loaded framework chunks.
 * The caller owns the surrounding Scope and must archive before it closes.
 */
export const stageWebsiteArtifact = effect (props: WebsiteArtifactProps) => {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const root = try fs.realPath(path.resolve(initialCwd, props.root))
  const runtimeBase = try Effect.orDie(Effect.try({ try: () => currentWorkingDirectory(), catch: (e) => e }))
  const dotAlchemy = try dotAlchemyDirectory
  const dist = try fs.realPath(path.resolve(initialCwd, props.distDir))
  const entry = props.serverEntry === undefined
    ? undefined
    : try fs.realPath(path.resolve(initialCwd, props.serverEntry))
  if (entry === undefined && props.static === undefined) {
    return try fail(
      "A website artifact requires a Node server entry or static serving options.",
    )
  }
  if (entry !== undefined && (try fs.stat(entry)).type !== "File") {
    return try fail(`Website server entry is not a file: ${entry}`)
  }
  if (props.layout !== "next" && dist === root) {
    return try fail(
      "Website output must be a dedicated build directory, not the application root.",
    )
  }
  const files = new Set<string>(entry === undefined ? [] : [entry])
  const seeds = new Set<string>(entry === undefined ? [] : [entry])
  const manifests: string[] = []
  let visited = 0
  const collect: (
    source: string,
    ancestors?: ReadonlySet<string>,
    runtimePackage?: boolean,
    boundary?: string,
  ) => void!(Error | PlatformError) = effect (
    source,
    ancestors = new Set(),
    runtimePackage = false,
    boundary,
  ) => {
    if (++visited > MAX_ENTRIES) {
      return try fail("Website artifact exceeds the 50,000-entry safety limit.")
    }
    const relative = path.relative(root, source).replaceAll("\\", "/")
    if (
      excluded(relative)
      || (try Effect.orDie(Effect.try({ try: () => isPathWithin(dotAlchemy, source, runtimeBase), catch: (e) => e })))
      || (runtimePackage && /(?:\.map|\.d\.ts)$/.test(source))
      || (props.layout === "next" && nextExcluded(relative))
    ) {
      return
    }
    const real = try fs.realPath(source)
    const relativeToBoundary = path.relative(boundary ?? real, real)
    if (
      relativeToBoundary === ".."
      || relativeToBoundary.startsWith(`..${path.sep}`)
      || path.isAbsolute(relativeToBoundary)
    ) {
      return try fail(`Website output symlink escapes its selected directory: ${source}`)
    }
    const stat = try fs.stat(real)
    if (stat.type === "Directory") {
      if (ancestors.has(real)) return try fail(`Cyclic website output symlink: ${source}`)
      const next = new Set([...ancestors, real])
      for (const name of try fs.readDirectory(source)) {
        // Runtime dependencies are traced, never copied wholesale.
        if (name === "node_modules") continue
        try collect(path.join(source, name), next, runtimePackage, boundary ?? real)
      }
    } else if (stat.type === "File") {
      files.add(source)
      if (!runtimePackage && props.static === undefined && javascript(source)) seeds.add(source)
      if (props.layout === "next" && source.endsWith(".nft.json")) manifests.push(source)
    } else {
      return try fail(`Unsupported website output file: ${source}`)
    }
  }

  const extras = try packSiteExtraFiles(
    props.layout === "next" ? root : dist,
    props.layout === "next" ? "next" : "client",
  )
  if (props.layout === "next" && !(try fs.exists(path.join(root, ".next", "BUILD_ID")))) {
    return try fail(
      "Next.js output is missing .next/BUILD_ID; run the production build before packaging.",
    )
  }
  for (const extra of extras ?? []) try collect(extra.source)
  // Also include config extensions not currently listed by packSiteExtraFiles.
  if (props.layout === "next") {
    for (const name of ["next.config.mts", "next.config.cts"]) {
      const config = path.join(root, name)
      if (try fs.exists(config)) try collect(config)
    }
  }

  if (props.layout === "next") {
    const nextPackage = try Effect.try(() => resolvePackageFrom(path.join(root, "package.json"), "next/package.json"))
    const nextRoot = path.dirname(nextPackage)
    // Next's custom server resolves internal modules through runtime alias
    // tables that NFT cannot evaluate. Keep that package, not node_modules.
    try collect(nextRoot, undefined, true)
    try collect(path.join(nextRoot, "dist", "compiled", "webpack"))
  }

  for (const manifest of manifests) {
    const text = try fs.readFileString(manifest)
    const parsed = try Effect.try(() => JSON.parse(text) as { files?: unknown })
    if (
      !Array.isArray(parsed.files)
      || !parsed.files.every((file): file is string => typeof file === "string")
    ) {
      return try fail(`Invalid Next.js trace manifest: ${manifest}`)
    }
    for (const file of parsed.files) {
      const source = path.resolve(path.dirname(manifest), file)
      if (
        excluded(path.relative(root, source)) || (try Effect.orDie(Effect.try({
          try: () => isPathWithin(dotAlchemy, source, runtimeBase),
          catch: (e) => e,
        })))
      ) {
        return try fail(`A Next.js runtime dependency is a sensitive file: ${source}`)
      }
      files.add(source)
      if (javascript(source)) seeds.add(source)
    }
  }

  const traceBase = path.parse(root).root
  const trace = seeds.size === 0
    ? undefined
    : try (Effect.tryPromise({
      try: () =>
        import("@vercel/nft").then(({ nodeFileTrace }) =>
          nodeFileTrace([...seeds], {
            base: traceBase,
            processCwd: root,
            conditions: ["node", "production"],
            analysis: {
              emitGlobs: true,
              computeFileReferences: true,
              evaluatePureExpressions: true,
            },
          })
        ),
      catch: (cause) =>
        new WebsiteTraceError({
          message: "Failed to trace website runtime dependencies. Install @vercel/nft in the deployment workspace.",
          cause,
        }),
    }) |> Effect.timeout(%, "90 seconds"))
  if (trace !== undefined) {
    for (const file of trace.fileList) {
      const source = path.resolve(traceBase, file)
      // NFT records symlinks encountered while resolving optional imports,
      // even when their targets are absent. They are lookup evidence, not
      // runtime files. Explicit build/manifest files remain required.
      if (
        !files.has(source)
        && trace.reasons.get(file)?.type.every((type) => type === "resolve")
        && !(try fs.exists(source))
      ) {
        continue
      }
      files.add(source)
    }
  }
  if (files.size > MAX_ENTRIES) {
    return try fail("Website dependency trace exceeds the 50,000-entry safety limit.")
  }

  const links = new Map<string, string>()
  const selected = new Set<string>()
  for (const file of files) {
    if (
      excluded(path.relative(root, file))
      || (try Effect.orDie(Effect.try({ try: () => isPathWithin(dotAlchemy, file, runtimeBase), catch: (e) => e })))
    ) {
      return try fail(`A website runtime dependency is a sensitive file: ${file}`)
    }
    const link = fs.readLink(file) catch () => undefined
    if (link !== undefined) {
      const target = try fs.realPath(file)
      links.set(file, target)
      if ((try fs.stat(target)).type === "File") selected.add(try fs.realPath(target))
    } else {
      const stat = try fs.stat(file)
      if (stat.type !== "File") {
        return try fail(`A traced runtime dependency is not a file: ${file}`)
      }
      selected.add(file)
    }
  }
  let base = root
  const within = (directory: string, file: string) => {
    const relative = path.relative(directory, file)
    return relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative)
  }
  for (const file of [...selected, ...links.keys(), ...links.values()]) {
    while (!within(base, file)) base = path.dirname(base)
  }
  const directory = try fs.makeTempDirectoryScoped({
    prefix: "alchemy-prisma-website-",
  })
  const staged = (file: string) => path.join(directory, "files", path.relative(base, file))
  let bytes = 0
  for (const file of [...selected].sort()) {
    const stat = try fs.stat(file)
    const size = Number(stat.size)
    bytes += size
    if (size > MAX_FILE_BYTES || bytes > MAX_BYTES) {
      return try fail(
        "Website artifact exceeds Prisma Compute's file or total byte safety limit.",
      )
    }
    const dest = staged(file)
    try fs.makeDirectory(path.dirname(dest), { recursive: true })
    try fs.copyFile(file, dest)
    try fs.chmod(dest, stat.mode & 0o777)
  }
  for (const [file, target] of links) {
    // NFT also reports resolution-only links with no retained runtime files.
    if (!(try fs.exists(staged(target)))) continue
    const dest = staged(file)
    if (try fs.exists(dest)) continue
    try fs.makeDirectory(path.dirname(dest), { recursive: true })
    try fs.symlink(path.relative(path.dirname(dest), staged(target)), dest)
  }
  if (props.static !== undefined) {
    const { makeNodeServeEntrySource } = try loadFrontendCore
    const client = path.relative(directory, staged(dist)).replaceAll("\\", "/")
    try fs.writeFileString(
      path.join(directory, "server.mjs"),
      try Effect.orDie(Effect.try({
        try: () =>
          makeNodeServeEntrySource({
            ...props.static,
            clientDirExpression: `fileURLToPath(new URL(${JSON.stringify(`./${client}/`)}, import.meta.url))`,
          }),
        catch: (e) => e,
      })),
    )
    return { directory, entrypoint: "server.mjs", requiredFiles: [] }
  }
  if (entry === undefined) return try fail("Missing website server entry.")
  const entryRelative = path.relative(directory, staged(entry)).replaceAll("\\", "/")
  const cwdRelative = path.relative(directory, staged(root)).replaceAll("\\", "/")
  try fs.makeDirectory(staged(root), { recursive: true })
  try fs.writeFileString(
    path.join(directory, "server.mjs"),
    [
      "import { fileURLToPath } from \"node:url\";",
      `process.chdir(fileURLToPath(new URL(${JSON.stringify(`./${cwdRelative}/`)}, import.meta.url)));`,
      `await import(new URL(${JSON.stringify(`./${entryRelative}`)}, import.meta.url).href);`,
      "",
    ].join("\n"),
  )
  return {
    directory,
    entrypoint: "server.mjs",
    requiredFiles: [entryRelative],
  }
}

export const WebsiteArtifactProvider = () =>
  Provider.effect(
    WebsiteArtifact,
    Effect.gen(function*() {
      const fs = yield* FileSystem.FileSystem
      const path = yield* Path.Path
      const dotAlchemy = yield* dotAlchemyDirectory
      return {
        list: () => Effect.succeed([]),
        // Traced dependencies can change independently of the framework's hash.
        diff: () => Effect.succeed({ action: "update" as const }),
        reconcile: Effect.fn(function*({ id, news }) {
          const name = yield* createPhysicalName({ id, maxLength: 80 })
          const directory = path.join(dotAlchemy, "prisma-websites", name)
          return yield* (Effect.scoped(
            effect {
              const staged = try stageWebsiteArtifact(news)
              const archive = try createComputeArchive({
                ...staged,
                output: "file",
              })
              return try (effect {
                try fs.makeDirectory(directory, { recursive: true })
                const artifactPath = path.join(directory, `${archive.sha256}.tar.gz`)
                try fs.copyFile(archive.path, artifactPath)
                for (const old of try fs.readDirectory(directory)) {
                  if (old !== path.basename(artifactPath) && /^[a-f0-9]{64}\.tar\.gz$/.test(old)) {
                    try fs.remove(path.join(directory, old), {
                      force: true,
                    })
                  }
                }
                return { directory, artifactPath, hash: archive.sha256 }
              } |> Effect.ensuring(%, archive.cleanup))
            },
          ))
        }),
        delete: Effect.fn(function*({ output }) {
          yield* fs.remove(output.directory, { recursive: true, force: true })
        }),
      }
    }),
  )
