import { exec } from "alchemy/Util/exec";
import { executablePath, resolveModule } from "./Cli.platform.js";
import * as Command from "effect/cli/Command";
import * as FileSystem from "effect/FileSystem";
import * as Path from "effect/Path";
import { generate, loadGeneratorConfig } from "./ORM/Generate.vibe";
import { CliError } from "./ORM/internal.ts";

const generateCommand = Command.make(
  "generate",
  {
    config: Flag.String("config").pipe(Flag.withDefault("./prisma.config.ts")),
    watch: Flag.Boolean("watch").pipe(Flag.withDefault(false)),
  },
  effect (args_0: { readonly config: string; readonly watch: boolean; }) => { let { config, watch } = args_0;
    if (!watch) {
      const result = try generate(config);
      try Effect.logInfo(`Generated ${result.files.length} files in ${result.directory}`);
      return;
    }
    const fs = try FileSystem.FileSystem;
    const path = try Path.Path;
    const loaded = try loadGeneratorConfig(config);
    // alchemy's own CLI, found through module resolution so it works from the
    // workspace and from an installed project alike.
    const manifest = try Effect.orDie(Effect.try({ try: () => resolveModule("alchemy/package.json"), catch: (e) => e }));
    const bin = path.join(
      path.dirname(try path.fromFileUrl(new URL(manifest))),
      "bin",
      "cli.js",
    );
    const run = do { const catchProgram = (effect {
      const result = try exec(
        ChildProcess.make(executablePath(), [
          bin,
          "provider",
          "prisma",
          "generate",
          "--config",
          loaded.absolute,
          "--no-input",
        ]),
      );
      if (result.exitCode !== 0)
        throw new CliError({ message: `${result.stdout}\n${result.stderr}` });
      try Effect.logInfo(result.stdout);
    }
      |> Effect.scoped(%)); effect { return catchProgram catch effect (error) => try Effect.logError(error) } };
    try run;
    try Effect.logInfo(`Watching ${loaded.directory}; each generation uses a fresh process.`);
    try (fs.watch(loaded.directory, { recursive: true }).pipe(
      Stream.filter((event) => {
        const file = path.resolve(loaded.directory, event.path);
        const relative = path.relative(loaded.directory, file);
        const output = path.dirname(loaded.output);
        return (
          !relative
            .split(path.sep)
            .some((part) => part === "node_modules" || part === ".git" || part === ".alchemy") &&
          !(file === output || file.startsWith(output + path.sep)) &&
          /\.(?:ts|mts|cts|js|mjs|cjs|prisma|psl)$/.test(file)
        );
      }),
      Stream.filterEffect((event) =>
        effect {
          const file = path.resolve(loaded.directory, event.path);
          if (!(try fs.exists(file))) return true;
          const contents = try fs.readFileString(file);
          return (
            !contents.startsWith("// Generated by alchemy prisma generate.") &&
            !contents.includes("This file is automatically generated by 'prisma contract emit'")
          );
        } |> Effect.orElseSucceed(%, () => false),
      ),
      Stream.debounce("200 millis"),
      Stream.runForEach(() => run),
    ));
  },
).pipe(
  Command.withDescription("Generate Effect bindings and standalone schemas from a Prisma contract"),
);

export const prismaCommand = Command.make("prisma").pipe(
  Command.withDescription("Prisma contract tooling"),
  Command.withSubcommands([generateCommand]),
);
