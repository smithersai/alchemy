import { resolveProviderConfig } from "alchemy/Auth/Resolve"
import * as Context from "effect/Context"
import * as Layer from "effect/Layer"
import { PRISMA_AUTH_PROVIDER_NAME, type PrismaAuthConfig, type PrismaResolvedCredentials } from "./AuthProvider.vibe"
import { resolveBaseUrl } from "./internal/BaseUrl.vibe"

export interface PrismaEnvironmentShape extends PrismaResolvedCredentials {
  baseUrl: string
}

export service PrismaEnvironment: PrismaEnvironmentShape {
  static readonly key = "Prisma::PrismaEnvironment"
}

export const fromProfile = () =>
  Layer.effect(
    PrismaEnvironment,
    effect {
      const baseUrl = try resolveBaseUrl
      const { resolve } = try resolveProviderConfig<PrismaAuthConfig, PrismaResolvedCredentials>(
        PRISMA_AUTH_PROVIDER_NAME,
      )
      const credentials = try resolve
      return { ...credentials, baseUrl }
    },
  )
