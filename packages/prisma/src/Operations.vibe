import * as Effect from "effect/Effect"
import { PrismaClient, type PrismaManagementClient } from "./Client.ts"
import * as LogsClient from "./internal/LogsClient.vibe"
import type {
  AppCreateInput,
  AppDeploymentTarget,
  AppUpdateInput,
  BranchCreateInput,
  BranchUpdateInput,
  BucketCreateInput,
  BucketKeyCreateInput,
  BuildLogsQuery,
  DatabaseConnectionCreateInput,
  DeploymentCreateInput,
  DeploymentLogsQuery,
  ConnectionCreateInput,
  CustomDomainCreateInput,
  DatabaseCreateInput,
  DatabaseUpdateInput,
  EnvironmentVariableCreateInput,
  EnvironmentVariableUpdateInput,
  PrismaBranchIdFilter,
  ProjectCreateInput,
  ProjectDatabaseCreateInput,
  ProjectTransferInput,
  ProjectUpdateInput,
  RestoreDatabaseInput,
  ScmInstallIntentCreateInput,
  SourceRepositoryCreateInput,
} from "./Types.ts"

const withClient = effect <A, E, R>(f: (client: PrismaManagementClient) => A!E!R) => try Effect.flatMap(PrismaClient, f)

export const listWorkspaces = effect (query?: { mutable cursor?: string | null; mutable limit?: number }) =>
  try withClient(effect (client) => try client.listWorkspaces(query))
export const getWorkspace = effect (id: string) => try withClient(effect (client) => try client.getWorkspace(id))
export const getCurrentPrincipal = effect () => try withClient(effect (client) => try client.getCurrentPrincipal())

export const listRegions = effect (query?: { mutable product?: "postgres" | "accelerate" }) =>
  try withClient(effect (client) => try client.listRegions(query))
export const listPostgresRegions = effect () => try withClient(effect (client) => try client.listPostgresRegions())
export const listAccelerateRegions = effect () => try withClient(effect (client) => try client.listAccelerateRegions())

export const listProjects = effect (query?: { mutable cursor?: string | null; mutable limit?: number }) =>
  try withClient(effect (client) => try client.listProjects(query))
export const getProject = effect (id: string) => try withClient(effect (client) => try client.getProject(id))
export const createProject = effect (input: ProjectCreateInput) =>
  try withClient(effect (client) => try client.createProject(input))
export const updateProject = effect (id: string, input: ProjectUpdateInput) =>
  try withClient(effect (client) => try client.updateProject(id, input))
export const deleteProject = effect (id: string) => try withClient(effect (client) => try client.deleteProject(id))
export const transferProject = effect (id: string, input: ProjectTransferInput) =>
  try withClient(effect (client) => try client.transferProject(id, input))

export const listDatabases = effect (query?: {
  mutable cursor?: string | null
  mutable limit?: number
  mutable projectId?: string
  mutable branchId?: PrismaBranchIdFilter
  mutable branchGitName?: string
}) => try withClient(effect (client) => try client.listDatabases(query))
export const listProjectDatabases = effect (
  projectId: string,
  query?: { mutable cursor?: string | null; mutable limit?: number },
) => try withClient(effect (client) => try client.listProjectDatabases(projectId, query))
export const getDatabase = effect (id: string) => try withClient(effect (client) => try client.getDatabase(id))
export const createDatabase = effect (input: DatabaseCreateInput) =>
  try withClient(effect (client) => try client.createDatabase(input))
export const createProjectDatabase = effect (projectId: string, input: ProjectDatabaseCreateInput) =>
  try withClient(effect (client) => try client.createProjectDatabase(projectId, input))
export const updateDatabase = effect (id: string, input: DatabaseUpdateInput) =>
  try withClient(effect (client) => try client.updateDatabase(id, input))
export const deleteDatabase = effect (id: string) => try withClient(effect (client) => try client.deleteDatabase(id))
export const listBackups = effect (databaseId: string, query?: { mutable limit?: number }) =>
  try withClient(effect (client) => try client.listBackups(databaseId, query))
export const restoreDatabase = effect (targetDatabaseId: string, input: RestoreDatabaseInput) =>
  try withClient(effect (client) => try client.restoreDatabase(targetDatabaseId, input))
export const getDatabaseUsage = effect (
  databaseId: string,
  query?: { mutable startDate?: string; mutable endDate?: string },
) => try withClient(effect (client) => try client.getDatabaseUsage(databaseId, query))

export const listConnections = effect (query?: {
  mutable cursor?: string | null
  mutable limit?: number
  mutable databaseId?: string
}) => try withClient(effect (client) => try client.listConnections(query))
export const listDatabaseConnections = effect (
  databaseId: string,
  query?: { mutable cursor?: string | null; mutable limit?: number },
) => try withClient(effect (client) => try client.listDatabaseConnections(databaseId, query))
export const getConnection = effect (id: string) => try withClient(effect (client) => try client.getConnection(id))
export const createConnection = effect (input: ConnectionCreateInput) =>
  try withClient(effect (client) => try client.createConnection(input))
export const createDatabaseConnection = effect (
  databaseId: string,
  input: DatabaseConnectionCreateInput,
) => try withClient(effect (client) => try client.createDatabaseConnection(databaseId, input))
export const deleteConnection = effect (id: string) =>
  try withClient(effect (client) => try client.deleteConnection(id))
export const rotateConnection = effect (id: string) =>
  try withClient(effect (client) => try client.rotateConnection(id))

export const listBranches = effect (
  projectId: string,
  query?: {
    mutable cursor?: string | null
    mutable limit?: number
    mutable gitName?: string
    mutable gitNameContains?: string
  },
) => try withClient(effect (client) => try client.listBranches(projectId, query))
export const getBranch = effect (id: string) => try withClient(effect (client) => try client.getBranch(id))
export const createBranch = effect (projectId: string, input: BranchCreateInput) =>
  try withClient(effect (client) => try client.createBranch(projectId, input))
export const updateBranch = effect (id: string, input: BranchUpdateInput) =>
  try withClient(effect (client) => try client.updateBranch(id, input))
export const deleteBranch = effect (id: string) => try withClient(effect (client) => try client.deleteBranch(id))

