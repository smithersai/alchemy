import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import { artifactFileStream, type ArtifactFile } from "./ArtifactFile.ts"
import { PrismaUploadClient } from "./HttpClient.ts"

export error ArtifactUploadOperationFailed {
  message: string
  cause?: unknown
}

const ARTIFACT_UPLOAD_TIMEOUT = Duration.minutes(15)
const UPLOAD_ERROR_BODY_BYTES = 64 * 1024

export const executeArtifactUpload = effect (
  uploadUrl: string,
  artifact: Uint8Array | ArtifactFile,
  contentType: string,
) => {
  // Prefer the Prisma-scoped upload client (node transport, provided by
  // live wiring — presigned upload URLs need explicit Content-Length on
  // file-backed bodies); fall back to the ambient client so tests can
  // stub uploads through `HttpClient.HttpClient`.
  const uploadClient = try Effect.serviceOption(PrismaUploadClient)
  const http = Option.isSome(uploadClient) ? uploadClient.value : try Effect.service(HttpClient.HttpClient)
  const request = HttpClientRequest.put(uploadUrl).pipe(
    artifact instanceof Uint8Array
      ? HttpClientRequest.bodyUint8Array(artifact, contentType)
      : HttpClientRequest.bodyStream(artifactFileStream(artifact), {
        contentType,
        contentLength: artifact.size,
      }),
  )
  const responseOption = try (effect {
    return http.execute(request) catch effect (e) => {
      throw new ArtifactUploadOperationFailed({
        message: "Prisma artifact upload transport failed before a response was received.",
      })
    }
  }
    |> Effect.timeoutOption(%, ARTIFACT_UPLOAD_TIMEOUT))
  if (Option.isNone(responseOption)) {
    throw new ArtifactUploadOperationFailed({
      message: "Prisma artifact upload timed out after 15 minutes.",
    })
  }
  const response = responseOption.value
  if (response.status < 200 || response.status >= 300) {
    const bodyBytesOption = (try (readResponsePrefixByteCount(
      response,
      UPLOAD_ERROR_BODY_BYTES,
    )
      |> Effect.timeoutOption(%, Duration.seconds(2)))) catch () => Option.none<number>()
    const diagnostic = Option.match(bodyBytesOption, {
      onNone: () => "diagnostic body unavailable",
      onSome: (bytes) => `diagnostic body prefix: ${bytes} bytes`,
    })
    throw new ArtifactUploadOperationFailed({
      message: `Prisma artifact upload failed (HTTP ${response.status}; ${diagnostic}).`,
    })
  }
}

const readResponsePrefixByteCount = effect (
  response: HttpClientResponse.HttpClientResponse,
  limit: number,
) => {
  let bytes = 0
  try Stream.runForEachWhile(response.stream, effect (chunk) =>
    try Effect.sync(() => {
      const remaining = limit - bytes
      if (remaining <= 0) return false
      bytes += Math.min(chunk.byteLength, remaining)
      return bytes < limit
    }))
  return bytes
}
