{
  "name": "@alchemy.run/prisma",
  "version": "2.0.0-beta.84",
  "description": "Prisma Postgres, Compute and ORM for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "orm",
    "postgres",
    "prisma"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/prisma"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./ORM": "./src/ORM/index.ts",
    "./Website": "./src/Website/index.ts",
    "./App": "./src/App.vibe",
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./Branch": "./src/Branch.vibe",
    "./Bucket": "./src/Bucket.vibe",
    "./BucketAccessKey": "./src/BucketAccessKey.vibe",
    "./BucketTypes": "./src/BucketTypes.vibe",
    "./Cli": "./src/Cli.vibe",
    "./ComputeArchive": "./src/ComputeArchive.vibe",
    "./Connection": "./src/Connection.vibe",
    "./CustomDomain": "./src/CustomDomain.vibe",
    "./Database": "./src/Database.vibe",
    "./Deployment": "./src/Deployment.vibe",
    "./EnvironmentVariable": "./src/EnvironmentVariable.vibe",
    "./internal/AppIdentity": "./src/internal/AppIdentity.vibe",
    "./internal/AppPromotion": "./src/internal/AppPromotion.vibe",
    "./internal/BaseUrl": "./src/internal/BaseUrl.vibe",
    "./internal/Branches": "./src/internal/Branches.vibe",
    "./internal/DeploymentIdentity": "./src/internal/DeploymentIdentity.vibe",
    "./internal/DeploymentObserve": "./src/internal/DeploymentObserve.vibe",
    "./Operations": "./src/Operations.vibe",
    "./ORM/Errors": "./src/ORM/Errors.vibe",
    "./ORM/Generate": "./src/ORM/Generate.vibe",
    "./ORM/Migrate": "./src/ORM/Migrate.vibe",
    "./ORM/Postgres": "./src/ORM/Postgres.vibe",
    "./PrismaEnvironment": "./src/PrismaEnvironment.vibe",
    "./Project": "./src/Project.vibe",
    "./Providers": "./src/Providers.vibe",
    "./SourceRepository": "./src/SourceRepository.vibe",
    "./Website/Artifact": "./src/Website/Artifact.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./CustomDomain.platform": null,
    "./EnvironmentVariable.platform": null,
    "./Deployment.platform": null,
    "./Cli.platform": null,
    "./ComputeArchive.platform": null,
    "./Website/Artifact.platform": null,
    "./ORM/Migrate.platform": null,
    "./CustomDomain.helpers": null,
    "./Deployment.helpers": null,
    "./ComputeArchive.helpers": null,
    "./internal/BaseUrl.helpers": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./ORM": {
        "types": "./lib/ORM/index.d.ts",
        "default": "./lib/ORM/index.js"
      },
      "./Website": {
        "types": "./lib/Website/index.d.ts",
        "default": "./lib/Website/index.js"
      },
      "./*.vibe.raw": null,
      "./internal/*": null,
      "./*/internal": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./CustomDomain.platform": null,
      "./EnvironmentVariable.platform": null,
      "./Deployment.platform": null,
      "./Cli.platform": null,
      "./ComputeArchive.platform": null,
      "./Website/Artifact.platform": null,
      "./ORM/Migrate.platform": null,
      "./CustomDomain.helpers": null,
      "./Deployment.helpers": null,
      "./ComputeArchive.helpers": null,
      "./internal/BaseUrl.helpers": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/aws": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/prisma": "workspace:*",
    "@prisma/dev": "catalog:",
    "rolldown": "catalog:",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "@types/bun": "catalog:",
    "@types/ws": "catalog:",
    "@vercel/nft": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "@vercel/nft": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "prisma": "catalog:",
    "ws": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "@prisma/orm-postgres": {
      "optional": true
    },
    "@vercel/nft": {
      "optional": true
    },
    "prisma": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/prisma/Contributions"
    ]
  }
}
