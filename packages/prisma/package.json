{
  "name": "@alchemy.run/prisma",
  "version": "2.0.0-beta.84",
  "description": "Prisma Postgres, Compute and ORM for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "orm",
    "postgres",
    "prisma"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/prisma"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./ORM": "./src/ORM/index.ts",
    "./Website": "./src/Website/index.ts",
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./BucketTypes": "./src/BucketTypes.vibe",
    "./Operations": "./src/Operations.vibe",
    "./ORM/Errors": "./src/ORM/Errors.vibe",
    "./ORM/Generate": "./src/ORM/Generate.vibe",
    "./ORM/Prepared": "./src/ORM/Prepared.vibe",
    "./ReadWriteBucket": "./src/ReadWriteBucket.vibe",
    "./WriteBucket": "./src/WriteBucket.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./ORM": {
        "types": "./lib/ORM/index.d.ts",
        "bun": "./src/ORM/index.ts",
        "worker": "./src/ORM/index.ts",
        "default": "./lib/ORM/index.js"
      },
      "./Website": {
        "types": "./lib/Website/index.d.ts",
        "bun": "./src/Website/index.ts",
        "worker": "./src/Website/index.ts",
        "default": "./lib/Website/index.js"
      },
      "./AuthProvider": {
        "types": "./lib/AuthProvider.d.ts",
        "default": "./lib/AuthProvider.js"
      },
      "./BucketTypes": {
        "types": "./lib/BucketTypes.d.ts",
        "default": "./lib/BucketTypes.js"
      },
      "./Operations": {
        "types": "./lib/Operations.d.ts",
        "default": "./lib/Operations.js"
      },
      "./ORM/Errors": {
        "types": "./lib/ORM/Errors.d.ts",
        "default": "./lib/ORM/Errors.js"
      },
      "./ORM/Generate": {
        "types": "./lib/ORM/Generate.d.ts",
        "default": "./lib/ORM/Generate.js"
      },
      "./ORM/Prepared": {
        "types": "./lib/ORM/Prepared.d.ts",
        "default": "./lib/ORM/Prepared.js"
      },
      "./ReadWriteBucket": {
        "types": "./lib/ReadWriteBucket.d.ts",
        "default": "./lib/ReadWriteBucket.js"
      },
      "./WriteBucket": {
        "types": "./lib/WriteBucket.d.ts",
        "default": "./lib/WriteBucket.js"
      },
      "./internal/*": null,
      "./*/internal": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/aws": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/prisma": "workspace:*",
    "@prisma/dev": "catalog:",
    "rolldown": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-60bd29302ace.tgz"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "@types/bun": "catalog:",
    "@types/ws": "catalog:",
    "@vercel/nft": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-973c733d426e.tgz",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "@vercel/nft": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "prisma": "catalog:",
    "ws": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "@prisma/orm-postgres": {
      "optional": true
    },
    "@vercel/nft": {
      "optional": true
    },
    "prisma": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/prisma/Contributions"
    ]
  }
}
