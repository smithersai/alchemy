{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../submodules/distilled/packages/axiom/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/core/tsconfig.json"
    },
    {
      "path": "../alchemy/tsconfig.json"
    }
  ],
  "vibelang": {
    "declarationSidecars": true,
    "trustedPackages": [
      "@alchemy.run/axiom",
      "@distilled.cloud/axiom",
      "@distilled.cloud/core",
      "alchemy"
    ]
  }
}
