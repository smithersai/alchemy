{
  "name": "@alchemy.run/axiom",
  "version": "2.0.0-beta.84",
  "description": "Axiom datasets, dashboards, monitors and telemetry export for Alchemy.",
  "keywords": [
    "alchemy",
    "axiom",
    "effect",
    "infrastructure-as-code",
    "observability",
    "opentelemetry"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/axiom"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Annotation": "./src/Annotation.vibe",
    "./ApiToken": "./src/ApiToken.vibe",
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./Credentials": "./src/Credentials.vibe",
    "./Dashboard": "./src/Dashboard.vibe",
    "./Dataset": "./src/Dataset.vibe",
    "./Monitor": "./src/Monitor.vibe",
    "./Notifier": "./src/Notifier.vibe",
    "./Providers": "./src/Providers.vibe",
    "./Telemetry": "./src/Telemetry.vibe",
    "./View": "./src/View.vibe",
    "./VirtualField": "./src/VirtualField.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/axiom": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-2fe05486ecc6.tgz"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-316a192f4c8a.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-7159373887c8.tgz"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/axiom/Contributions"
    ]
  }
}
