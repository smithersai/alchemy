{
  "name": "@alchemy.run/docker",
  "version": "2.0.0-beta.84",
  "description": "Docker images, containers, networks, volumes and registries for Alchemy, and the image builds container platforms share.",
  "keywords": [
    "alchemy",
    "containers",
    "docker",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/docker"
  },
  "files": [
    "lib",
    "src",
    "!lib/BuildHash.platform.d.ts",
    "!lib/BuildHash.platform.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.vibe",
    "./BuildHash": "./src/BuildHash.vibe",
    "./Container": "./src/Container.vibe",
    "./Context": "./src/Context.vibe",
    "./Docker": "./src/Docker.vibe",
    "./Image": "./src/Image.vibe",
    "./ImageSource": "./src/ImageSource.vibe",
    "./Network": "./src/Network.vibe",
    "./Providers": "./src/Providers.vibe",
    "./Registry": "./src/Registry.vibe",
    "./RegistryError": "./src/RegistryError.vibe",
    "./RemoteImage": "./src/RemoteImage.vibe",
    "./Service": "./src/Service.vibe",
    "./ServiceImage": "./src/ServiceImage.vibe",
    "./Swarm": "./src/Swarm.vibe",
    "./Volume": "./src/Volume.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./Image.platform": null,
    "./BuildHash.platform": null,
    "./Bootstrap.vibe.host": null,
    "./Service.vibe.guards": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./Image.platform": null,
      "./BuildHash.platform": null,
      "./Bootstrap.vibe.host": null,
      "./Service.vibe.guards": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "rolldown": "catalog:",
    "vibelang-runtime": "0.0.14-pre.d955d06c6696"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.d955d06c6696"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    }
  }
}
