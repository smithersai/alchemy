{
  "name": "@alchemy.run/docker",
  "version": "2.0.0-beta.84",
  "description": "Docker images, containers, networks, volumes and registries for Alchemy, and the image builds container platforms share.",
  "keywords": [
    "alchemy",
    "containers",
    "docker",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/docker"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./Container": "./src/Container.vibe",
    "./Context": "./src/Context.vibe",
    "./Network": "./src/Network.vibe",
    "./Providers": "./src/Providers.vibe",
    "./Registry": "./src/Registry.vibe",
    "./RemoteImage": "./src/RemoteImage.vibe",
    "./ServiceImage": "./src/ServiceImage.vibe",
    "./Swarm": "./src/Swarm.vibe",
    "./Volume": "./src/Volume.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./Container": {
        "types": "./lib/Container.d.ts",
        "default": "./lib/Container.js"
      },
      "./Context": {
        "types": "./lib/Context.d.ts",
        "default": "./lib/Context.js"
      },
      "./Network": {
        "types": "./lib/Network.d.ts",
        "default": "./lib/Network.js"
      },
      "./Providers": {
        "types": "./lib/Providers.d.ts",
        "default": "./lib/Providers.js"
      },
      "./Registry": {
        "types": "./lib/Registry.d.ts",
        "default": "./lib/Registry.js"
      },
      "./RemoteImage": {
        "types": "./lib/RemoteImage.d.ts",
        "default": "./lib/RemoteImage.js"
      },
      "./ServiceImage": {
        "types": "./lib/ServiceImage.d.ts",
        "default": "./lib/ServiceImage.js"
      },
      "./Swarm": {
        "types": "./lib/Swarm.d.ts",
        "default": "./lib/Swarm.js"
      },
      "./Volume": {
        "types": "./lib/Volume.d.ts",
        "default": "./lib/Volume.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "rolldown": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-587937650a6b.tgz"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-a2f113b9682c.tgz"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    }
  }
}
