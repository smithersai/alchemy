{
  "name": "@alchemy.run/github",
  "version": "2.0.0-beta.84",
  "description": "GitHub repositories, secrets and webhooks for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "github",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/github"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./BindingLocal": "./src/BindingLocal.vibe",
    "./CreateIssue": "./src/CreateIssue.vibe",
    "./CreateIssueComment": "./src/CreateIssueComment.vibe",
    "./CreateIssueCommentHttp": "./src/CreateIssueCommentHttp.vibe",
    "./CreateIssueCommentLocal": "./src/CreateIssueCommentLocal.vibe",
    "./CreateIssueHttp": "./src/CreateIssueHttp.vibe",
    "./CreateIssueLocal": "./src/CreateIssueLocal.vibe",
    "./CreatePullRequest": "./src/CreatePullRequest.vibe",
    "./CreatePullRequestHttp": "./src/CreatePullRequestHttp.vibe",
    "./CreatePullRequestLocal": "./src/CreatePullRequestLocal.vibe",
    "./CreatePullRequestReview": "./src/CreatePullRequestReview.vibe",
    "./CreatePullRequestReviewHttp": "./src/CreatePullRequestReviewHttp.vibe",
    "./CreatePullRequestReviewLocal": "./src/CreatePullRequestReviewLocal.vibe",
    "./Credentials": "./src/Credentials.vibe",
    "./Env": "./src/Env.vibe",
    "./Errors": "./src/Errors.vibe",
    "./GetIssue": "./src/GetIssue.vibe",
    "./GetIssueLocal": "./src/GetIssueLocal.vibe",
    "./GetPullRequest": "./src/GetPullRequest.vibe",
    "./GetPullRequestHttp": "./src/GetPullRequestHttp.vibe",
    "./ListIssueComments": "./src/ListIssueComments.vibe",
    "./ListIssueCommentsHttp": "./src/ListIssueCommentsHttp.vibe",
    "./ListIssueCommentsLocal": "./src/ListIssueCommentsLocal.vibe",
    "./ListIssues": "./src/ListIssues.vibe",
    "./ListIssuesHttp": "./src/ListIssuesHttp.vibe",
    "./ListIssuesLocal": "./src/ListIssuesLocal.vibe",
    "./ListPullRequestFiles": "./src/ListPullRequestFiles.vibe",
    "./ListPullRequestFilesHttp": "./src/ListPullRequestFilesHttp.vibe",
    "./ListPullRequestFilesLocal": "./src/ListPullRequestFilesLocal.vibe",
    "./ListPullRequestReviewComments": "./src/ListPullRequestReviewComments.vibe",
    "./ListPullRequestReviewCommentsHttp": "./src/ListPullRequestReviewCommentsHttp.vibe",
    "./ListPullRequestReviewCommentsLocal": "./src/ListPullRequestReviewCommentsLocal.vibe",
    "./ListPullRequestReviews": "./src/ListPullRequestReviews.vibe",
    "./ListPullRequestReviewsHttp": "./src/ListPullRequestReviewsHttp.vibe",
    "./ListPullRequestReviewsLocal": "./src/ListPullRequestReviewsLocal.vibe",
    "./ListPullRequests": "./src/ListPullRequests.vibe",
    "./ListPullRequestsHttp": "./src/ListPullRequestsHttp.vibe",
    "./ListPullRequestsLocal": "./src/ListPullRequestsLocal.vibe",
    "./MergePullRequest": "./src/MergePullRequest.vibe",
    "./MergePullRequestHttp": "./src/MergePullRequestHttp.vibe",
    "./MergePullRequestLocal": "./src/MergePullRequestLocal.vibe",
    "./Providers": "./src/Providers.vibe",
    "./RepositoryEventSource": "./src/RepositoryEventSource.vibe",
    "./SearchIssues": "./src/SearchIssues.vibe",
    "./SearchIssuesHttp": "./src/SearchIssuesHttp.vibe",
    "./SearchIssuesLocal": "./src/SearchIssuesLocal.vibe",
    "./UpdateIssue": "./src/UpdateIssue.vibe",
    "./UpdateIssueLocal": "./src/UpdateIssueLocal.vibe",
    "./Variables": "./src/Variables.vibe",
    "./*.vibe.raw": null,
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./BranchProtection": "./src/BranchProtection.vibe",
    "./Collaborator": "./src/Collaborator.vibe",
    "./Comment": "./src/Comment.vibe",
    "./GetPullRequestLocal": "./src/GetPullRequestLocal.vibe",
    "./Issue": "./src/Issue.vibe",
    "./Label": "./src/Label.vibe",
    "./Milestone": "./src/Milestone.vibe",
    "./PersonalAccessToken": "./src/PersonalAccessToken.vibe",
    "./PullRequest": "./src/PullRequest.vibe",
    "./Release": "./src/Release.vibe",
    "./Repository": "./src/Repository.vibe",
    "./RepositoryEventSourceLive": "./src/RepositoryEventSourceLive.vibe",
    "./Ruleset": "./src/Ruleset.vibe",
    "./Secret": "./src/Secret.vibe",
    "./Secrets": "./src/Secrets.vibe",
    "./TeamAccess": "./src/TeamAccess.vibe",
    "./Variable": "./src/Variable.vibe",
    "./Webhook": "./src/Webhook.vibe",
    "./WikiPage": "./src/WikiPage.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./RepositoryEventSourceLive.platform": null,
    "./WikiPage.platform": null,
    "./BaseUrl.helpers": null,
    "./AuthProvider.helpers": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./Comment": {
        "types": "./lib/Comment.d.ts",
        "bun": "./src/Comment.ts",
        "worker": "./src/Comment.ts",
        "default": "./lib/Comment.js"
      },
      "./RepositoryEventSourceLive.platform": null,
      "./WikiPage.platform": null,
      "./BaseUrl.helpers": null,
      "./AuthProvider.helpers": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/github": "workspace:*",
    "libsodium-wrappers": "catalog:",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/github/Contributions"
    ]
  }
}
