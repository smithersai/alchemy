{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "references": [
    {
      "path": "../../submodules/distilled/packages/github/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/core/tsconfig.json"
    },
    {
      "path": "../alchemy/tsconfig.json"
    }
  ],
  "vibelang": {
    "declarationSidecars": true,
    "trustedPackages": [
      "@alchemy.run/github",
      "@distilled.cloud/core",
      "@distilled.cloud/github",
      "alchemy"
    ]
  }
}
