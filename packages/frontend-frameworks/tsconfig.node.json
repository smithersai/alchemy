{
  "extends": "../../tsconfig.cloudflare.json",
  "include": ["src/**/*.ts", "src/**/*.vibe"],
  "exclude": [
    "src/**/test/**",
    "src/astro/runtime",
    // `.ts` starters and frozen-test readers of `.vibe` modules: the `.vibe`
    // module emits the declarations, so the `.ts` twin must not.
    "src/core/BuildChildRunner.ts",
    "src/core/DevChildRunner.ts",
    "src/core/Loader.ts",
    "src/astro/node.ts",
    "src/foldkit/Foldkit.ts",
    "src/vite/Vite.ts",
    "src/octane/Octane.ts",
    "src/octane/CloudflareBuild.ts",
    "src/octane/source.ts",
    "src/react-router/ReactRouter.ts",
    "src/react-router/aws.ts",
    "src/tanstack-start/TanStackStart.ts",
    "src/tanstack-start/aws.ts",
    "src/solidstart/SolidStart.ts",
    "src/vinext/aws.ts",
    "src/vinext/cli.ts",
    "src/vinext/source.ts",
    "src/nextjs/node.ts",
    "src/vocs/neon.ts",
    "src/waku/node.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsconfig.node.tsbuildinfo",
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "references": [{ "path": "./tsconfig.runtime.json" }]
}
