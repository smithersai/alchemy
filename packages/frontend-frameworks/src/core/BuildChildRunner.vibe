/**
 * Shared child-process ENTRY for framework production builds.
 *
 * Executed only as a spawned process by `runBuildChild` (`BuildChild.ts`) —
 * never imported. `argv[2]` carries the JSON {@link BuildChildPayload}: the
 * framework source module to load (a file URL), the config for its exported
 * `buildInChild`, and the path to persist the resulting `BuildOutput` to.
 *
 * This is deliberately the ONLY module in the package with top-level
 * execution: every importable module (including the framework source
 * modules) stays pure — their `buildInChild` exports are plain functions
 * returning Effects, callable in-process by tests. Process concerns (argv
 * parsing, platform services, exit codes) live here, at the process
 * boundary where they belong.
 *
 * Started through `BuildChildRunner.ts`, which registers VibeLang's loader
 * when running from `src/`.
 */
import * as NodeServices from "@effect/platform-node/NodeServices"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import type { BuildChildModule, BuildChildPayload } from "./BuildChild.ts"
import { writeBuildOutput } from "./BuildOutput.ts"

module host {
  import type { BuildChildPayload } from "./BuildChild.ts"

  // A malformed payload throws here, at module evaluation, as before.
  export const payload = JSON.parse(process.argv[2] ?? "{}") as BuildChildPayload

  /** Exit 0 once `run` resolves; log the failure and exit 1 when it rejects. */
  export const exitWhenDone = (run: Promise<unknown>): void => {
    void run.then(
      // The macrotask hop lets buffered stdout/stderr drain before exiting.
      () => setTimeout(() => process.exit(0), 0),
      (error) => {
        console.error(error)
        setTimeout(() => process.exit(1), 0)
      },
    )
  }
}

import { exitWhenDone, payload } from host

const program = Effect.provide(
  effect {
    const module = (try Effect.promise(() => import(payload.module))) as Partial<BuildChildModule>
    if (typeof module.buildInChild !== "function") {
      return try Effect.die(
        new Error(`Build child module ${payload.module} does not export a buildInChild function`),
      )
    }
    const output = try module.buildInChild(payload.config as never).pipe(
      // Hand the failure message back to `runBuildChild` for its error.
      Effect.tapError((error) =>
        effect {
          const fs = try FileSystem.FileSystem
          try fs
            .writeFileString(
              payload.errorPath,
              error instanceof Error ? error.message : String(error),
            )
            .pipe(Effect.ignore)
        }
      ),
    )
    try writeBuildOutput(payload.outputPath, output)
  },
  NodeServices.layer,
)

exitWhenDone(Effect.runPromise(program))
