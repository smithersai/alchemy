import * as Effect from "effect/Effect"
import type { BuildOutput } from "../core/BuildOutput.vibe"
import { finishNeonOutput, makeNeonTarget } from "../core/NeonServe.vibe"
import { makeNodeTarget } from "./node.vibe"

const finish = (output: BuildOutput): infer _ =>
  finishNeonOutput({
    ...output,
    nodeServe: {
      ...output.nodeServe,
      // Kit emits extensionless prerendered routes as .html files.
      htmlHandling: "drop-trailing-slash",
    },
  })

/** SvelteKit production requests served by a Neon Fetch handler. */
export const target = (config?: Parameters<typeof makeNodeTarget>[0]): infer _ => {
  const node = makeNodeTarget(config)
  return {
    ...makeNeonTarget(node),
    build: effect (context: Parameters<NonNullable<typeof node.build>>[0]) => try finish(try node.build!(context)),
    finish: effect (...args: Parameters<NonNullable<typeof node.finish>>) => try finish(try node.finish!(...args)),
  }
}
export default target
