import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { bunIsUndefined, importPlatformPeer } from "./Platform.platform.ts"

const BunServices = {
  layer: Layer.unwrap(
    Effect.promise(() =>
      importPlatformPeer(
        "@effect/platform-bun",
        () => import("@effect/platform-bun/BunServices"),
      ).then((module) => module.layer)
    ),
  ),
}

const NodeServices = {
  layer: Layer.unwrap(
    Effect.promise(() =>
      importPlatformPeer(
        "@effect/platform-node",
        () => import("@effect/platform-node/NodeServices"),
      ).then((module) => module.layer)
    ),
  ),
}

export const PlatformServices = bunIsUndefined() ? NodeServices.layer : BunServices.layer
