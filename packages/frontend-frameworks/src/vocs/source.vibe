import * as Effect from "effect/Effect"
import * as FrameworkCore from "../core/index.ts"
import {
  makeWakuSourceProvider,
  SourceProviderError,
  type SourceProvider,
  type WakuBuildChildConfig,
  type WakuSourceOptions,
} from "../waku/source.vibe"
import vocsCloudflareTarget from "./cloudflare.ts"
import { make as vocsFrameworkLayer } from "./Vocs.vibe"

const PROVIDER = "@alchemy.run/frontend-frameworks/vocs/source"

export interface VocsSourceOptions {
  readonly rootDir?: string
  /** Vocs build output directory, used to exclude generated files from the input hash. */
  readonly outDir?: string
  readonly memo?: WakuSourceOptions["memo"]
}

export const buildInChild = effect (config: WakuBuildChildConfig) =>
  try effect {
    provide vocsFrameworkLayer({
            root: config.rootDir,
            target: vocsCloudflareTarget({
              worker: {
                compatibilityDate: config.compatibilityDate,
                compatibilityFlags: config.compatibilityFlags,
              },
            }),
          }) {
      return try effect {
        const framework = try FrameworkCore.Framework
        return try framework.build({ root: config.rootDir })
      }
    }
  }

export const makeVocsSourceProvider = (options: VocsSourceOptions): SourceProvider =>
  makeWakuSourceProvider(
    { ...options, distDir: options.outDir },
    {
      provider: PROVIDER,
      framework: "vocs",
      displayName: "Vocs",
      buildModule: import.meta.url,
      layer: ({ root, target }) =>
        vocsFrameworkLayer({
          root,
          target: vocsCloudflareTarget({ worker: target.config }),
        }),
    },
  )

const sourceModule = {
  make: effect (options: unknown): Effect.Effect<SourceProvider, SourceProviderError> => {
    if (options !== undefined && (typeof options !== "object" || options === null)) {
      throw new SourceProviderError({
        provider: PROVIDER,
        message: `Invalid options for ${PROVIDER}: expected an object, got ${typeof options}`,
      })
    }
    return makeVocsSourceProvider((options ?? {}) as VocsSourceOptions)
  },
}

export default sourceModule
