import { join } from "node:path"
import { pathToFileURL } from "node:url"
import * as Effect from "effect/Effect"
import { ModuleLoadError, resolveProjectPackageDirectory } from "../core/Loader.vibe"

/** Vinext exposes import-only entrypoints that require.resolve cannot resolve. */
export const loadVinextModule = effect <T>(root: string, file: string) =>
  try effect {
    const directory = try resolveProjectPackageDirectory(root, "vinext")
    return try Effect.tryPromise({
      try: (): infer _ =>
        import(
          /* @vite-ignore */ pathToFileURL(join(directory, "dist", file)).href
        ) as Promise<T>,
      catch: (cause): infer _ => new ModuleLoadError({ root, specifier: `vinext/${file}`, cause }),
    })
  }
