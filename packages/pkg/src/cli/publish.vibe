import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"
import { MANIFEST_FILE, ManifestJson, type Manifest } from "../Manifest.ts"
import { PkgApi, type TarballRef } from "../Protocol.ts"

export error PublishError {
  message: string
}

export interface PublishOptions {
  readonly cwd: string
  readonly dir: string
  readonly registry: string
}

/**
 * The GitHub Actions run this job belongs to, from the runner's environment.
 */
const currentRun = effect {
  return (try effect {
    const repo = try Config.String("GITHUB_REPOSITORY")
    const runId = try Config.Int("GITHUB_RUN_ID")
    const attempt = try Config.Int("GITHUB_RUN_ATTEMPT").pipe(Config.withDefault(1))
    return { repo, runId, attempt }
  }) catch effect (e) => {
    throw new PublishError({
      message: "pkg publish must run inside a GitHub Actions job",
    })
  }
}

/** Render a registry or transport failure as a `PublishError`. */
const failed = (what: string): infer _ => (e: { readonly _tag: string; readonly message?: string }): infer _ =>
  new PublishError({
    message: `${what}: ${e.message ? `${e._tag}: ${e.message}` : e._tag}`,
  })

/**
 * Publish a `pkg pack` directory from the current GitHub Actions job. The
 * workflow must first have uploaded the manifest as an artifact of the run
 * under the name `pkg pack` printed; the registry verifies that artifact
 * through GitHub, then either reports the tarballs it lacks, which are
 * uploaded before trying again, or writes the tags.
 */
export const publish = effect (options: PublishOptions) =>
  try withSpan(
    effect {
      const fs = try Effect.service(FileSystem.FileSystem)
      const path = try Effect.service(Path.Path)
      const registry = options.registry.replace(/\/+$/, "")
      const run = try currentRun
      const client = try HttpApiClient.make(PkgApi, { baseUrl: registry })

      const dir = path.resolve(options.cwd, options.dir)
      const manifestText = try fs.readFileString(path.join(dir, MANIFEST_FILE))
      const manifest = try Schema.decodeEffect(ManifestJson)(manifestText)
      if (manifest.registry !== registry) {
        throw new PublishError({
          message: `artifact was packed for ${manifest.registry}, not ${registry}`,
        })
      }

      if (manifest.packages.length === 0) {
        try Effect.logInfo("No affected packages to publish.")
        return { packages: [] }
      }

      const upload = effect (pkg: Manifest["packages"][number]) => {
        const bytes = try fs.readFile(path.join(dir, pkg.file))
        const result = try (client.Registry.uploadTarball({
          params: { name: pkg.name, sha256: pkg.sha256 },
          query: run,
          payload: bytes,
        })
          |> Effect.mapError(%, failed(`upload ${pkg.name}`)))
        try Effect.logInfo(
          `${result.uploaded ? "Uploaded" : "Reused"} ${pkg.name} (${pkg.sha256.slice(0, 12)}, ${pkg.size} bytes)`,
        )
      }

      const uploadMissing = effect (missing: ReadonlyArray<TarballRef>) => {
        const wanted = new Set(missing.map((ref) => `${ref.name}@${ref.sha256}`))
        return try (Effect.logInfo(
          `${missing.length} of ${manifest.packages.length} tarball(s) to upload`,
        )
          |> Effect.andThen(
            %,
            Effect.forEach(
              manifest.packages.filter((pkg) => wanted.has(`${pkg.name}@${pkg.sha256}`)),
              upload,
              { concurrency: 4, discard: true },
            ),
          ))
      }

      const attempt = effect {
        return try client.Registry.publish({
          payload: { run, manifest: manifestText },
        })
      }
      const published = (try attempt) catch effect (e) =>
        match (e) {
          when { _tag: "MissingTarballs" }: try Effect.andThen(uploadMissing(e.missing), attempt);
          default: throw e;
        } catch effect (e) =>
          match (e) {
            when { _tag: "MissingTarballs" }: throw new PublishError({
              message: `registry still reports missing tarballs after upload: ${
                e.missing.map((ref) => ref.name).join(", ")
              }`,
            });
            default: throw e;
          } catch effect (e) => {
            throw (e._tag === "PublishError" ? e : failed("publish")(e))
          }

      for (const pkg of published.packages) {
        try Effect.logInfo(`${pkg.name}: ${pkg.url}  [${pkg.tags.join(", ")}]`)
      }
      return published
    },
    "publish",
  )
