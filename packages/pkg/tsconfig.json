  "include": ["src/**/*.ts", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "./src"
  },
  "references": [
    {
      "path": "../alchemy/tsconfig.json"
    },
