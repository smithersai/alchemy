import * as Binding from "alchemy/Binding"
import type { Resource } from "alchemy/Resource"
import * as Layer from "effect/Layer"
import { ConnectPostgres, PostgresUrlMissing, type ConnectPostgresClient } from "./ConnectPostgres.vibe"
import type { ServiceBinding } from "./MountVolume.vibe"
import { type Postgres } from "./Postgres.vibe"

const isFlyHost = (value: unknown): value is Resource<string, any, any, ServiceBinding> =>
  typeof value === "object"
  && value !== null
  && ((value as { Type?: string }).Type === "Fly.Service"
    || (value as { Type?: string }).Type === "Fly.Machine")

const asRedactedUrl = effect (
  value: unknown,
  name: string,
): Redacted.Redacted<string>!PostgresUrlMissing => {
  const plain = typeof value === "string" ? value : Redacted.isRedacted(value) ? Redacted.value(value) : ""
  const url = typeof plain === "string" ? plain : ""
  return (url.length > 0 ? Redacted.make(url) : throw new PostgresUrlMissing({ resourceName: name }))
}

/**
 * Implementation of {@link ConnectPostgres}. Provide it on the
 * {@link Service} Effect.
 *
 * Registers the cluster attachment for Fly's private network. Alchemy
 * transports each cluster's connection URIs through resource Outputs,
 * so callers do not configure connection-string environment variables.
 *
 * ### Provide the layer
 * **Example:** On a Service
 * ```typescript
 * Effect.gen(function* () {
 *   const conn = yield* Fly.ConnectPostgres(Db);
 *   const db = yield* Drizzle.Postgres(conn.connectionString);
 * }).pipe(Effect.provide(Fly.ConnectPostgresHttp))
 * ```
 *
 * @layer
 * @product Postgres
 * @provides Fly.ConnectPostgres
 */
export const ConnectPostgresHttp = Layer.effect(
  ConnectPostgres,
  Effect.succeed(
    effect (postgres: Postgres) => {
      const name = postgres.LogicalId
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        const host = try Binding.Host
        if (isFlyHost(host)) {
          try host.bind`${postgres}`({
            postgres: { clusterId: postgres.clusterId },
          })
        }
      }

      const pooled = try postgres.pooledConnectionUri.asEffect()
      const direct = try postgres.connectionUri.asEffect()

      return {
        connectionString: effect {
          return try asRedactedUrl(try pooled, name)
        },
        directConnectionString: effect {
          return try asRedactedUrl(try direct, name)
        },
      } satisfies ConnectPostgresClient
    },
  ),
)
