import { Credentials, credentials, CredentialsFromEnv, MachineIdentity } from "@distilled.cloud/fly-io"
import * as NodeHttpClient from "@effect/platform-node/NodeHttpClient"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import type * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import * as Redacted from "effect/Redacted"
import type { App } from "./App.vibe"
import { bindFlyApiToken } from "./Credentials.ts"
import type { Secret } from "./Secret.ts"
import type { SecretKey } from "./SecretKey.ts"

/**
 * Shared scaffolding for the HTTP-backed Fly Secret bindings.
 *
 * Fly has no native Worker-style binding. This layer captures the ambient
 * org token during stack-eval (so Actions work in-process) and `yield*`s
 * it plus `appName` / secret `name` so RuntimeContext.set runs. Platform
 * copies those Outputs into host env; runtime `yield*` gets them back.
 * {@link CredentialsFromEnv} still reads `FLY_API_TOKEN` after that copy.
 *
 * NOT exported from `index.ts`.
 */
export type AppNamed = Secret | SecretKey

export const makeHttpSecretBinding = effect <Target extends AppNamed, Client>(options: {
  mutable makeClient: (
    auth: SecretAuth,
    appName: string!!,
    secretName: string!!,
  ) => Client
  /**
   * PetSem encrypt/sign/decrypt/verify only work from a Machine over
   * `/.fly/api` (implicit machine identity). Org tokens return Forbidden.
   */
  mutable kms?: boolean
}) => {
  const context = try Effect.context<Credentials | HttpClient.HttpClient>()
  const auth = options.kms === true ? makeKmsAuth(context) : makeSecretAuth(context)

  return effect (resource: Target) => {
    try (bindFlyApiToken()
      |> Effect.provideContext(%, context))
    const appName = try resource.appName.asEffect()
    const secretName = try resource.name.asEffect()
    return options.makeClient(auth, appName, secretName)
  }
}

/**
 * Same scaffolding as {@link makeHttpSecretBinding}, but the target is
 * an {@link App} (no secret name). Used by ListSecrets.
 */
export const makeHttpAppBinding = effect <Client>(options: {
  mutable makeClient: (auth: SecretAuth, appName: string!!) => Client
}) => {
  const context = try Effect.context<Credentials | HttpClient.HttpClient>()

  return effect (app: App) => {
    try (bindFlyApiToken()
      |> Effect.provideContext(%, context))
    const appName = try app.appName.asEffect()
    return options.makeClient(makeSecretAuth(context), appName)
  }
}

/**
 * Injectable auth for the Secret HTTP client builders. Supplies an
 * `authorize` that provides `Credentials` + `HttpClient` to a raw SDK op.
 */
export interface SecretAuth {
  mutable authorize: <A, E>(
    eff: A!E!Credentials | HttpClient.HttpClient,
  ) => A!E!RuntimeContext
}

/** Build auth that uses ambient stack creds, or env creds inside a host. */
export const makeSecretAuth = (
  ambient: Context.Context<Credentials | HttpClient.HttpClient>,
): SecretAuth => ({
  authorize: <A, E>(
    eff: A!E!Credentials | HttpClient.HttpClient,
  ): A!E!RuntimeContext => {
    if (globalThis.__ALCHEMY_RUNTIME__) {
      // oxlint-disable-next-line effecttsgo/unsafe-effect-type-assertion -- TimeoutError/env-credential errors surface untyped; widening SecretAuth would ripple through every Fly secret client
      // @vibelang-diagnostics-next-line EK4810:off
      return effect {
        return try (effect {
          return try effect {
            provide Layer.mergeAll(CredentialsFromEnv, FetchHttpClient.layer) {
              return try eff
            }
          }
        }
          |> Effect.timeout(%, "8 seconds"))
      } as A!E!RuntimeContext
    }
    return effect {
      return try (eff
        |> Effect.provideContext(%, ambient))
    } as A!E!RuntimeContext
  },
})

const FLY_MACHINE_API_SOCKET = "/.fly/api"

/** Distilled machines client over `/.fly/api`. URL host is unused. */
const flyMachineApiHttp: Layer<HttpClient.HttpClient> = NodeHttpClient.layerNodeHttpNoAgent.pipe(
  Layer.provide(
    NodeHttpClient.layerAgentOptions({
      socketPath: FLY_MACHINE_API_SOCKET,
      keepAlive: false,
    }),
  ),
)

/**
 * PetSem encrypt/sign/decrypt/verify from a Machine. Org API tokens are
 * Forbidden; the machine identity is the unix socket at `/.fly/api`.
 * {@link MachineIdentity} is the protocol signal (no Authorization,
 * Connection: close). GetSecret in the same process keeps Bearer.
 */
export const makeKmsAuth = (
  ambient: Context.Context<Credentials | HttpClient.HttpClient>,
): SecretAuth => ({
  authorize: <A, E>(
    eff: A!E!Credentials | HttpClient.HttpClient,
  ): A!E!RuntimeContext => {
    if (globalThis.__ALCHEMY_RUNTIME__) {
      // oxlint-disable-next-line effecttsgo/unsafe-effect-type-assertion -- TimeoutError surfaces untyped; widening SecretAuth would ripple through every Fly secret client
      // @vibelang-diagnostics-next-line EK4810:off
      return effect {
        return try (Effect.scoped(
          effect {
            return try effect {
              provide Layer.mergeAll(
                    Layer.succeed(MachineIdentity, true),
                    flyMachineApiHttp,
                    credentials({
                      apiKey: Redacted.make("unused"),
                      apiBaseUrl: "http://localhost/v1",
                    }),
                  ) {
                return try eff
              }
            }
          },
        )
          |> Effect.timeout(%, "8 seconds"))
      } as A!E!RuntimeContext
    }
    return effect {
      return try (eff
        |> Effect.provideContext(%, ambient))
    } as A!E!RuntimeContext
  },
})

export const unwrapSecretValue = (value: Redacted.Redacted<string> | string): string =>
  Redacted.isRedacted(value) ? Redacted.value(value) : value
