import type { ExecCommandError, ExecResult } from "@distilled.cloud/fly-io/sprites"
import * as Binding from "alchemy/Binding"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import type * as Effect from "effect/Effect"
import type { Sprite } from "./Sprite.vibe"

export interface ExecRequest {
  /** Command and args. */
  mutable cmd: string[]
  /** Explicit path to the executable. */
  mutable path?: string
  /** Read stdin from {@link body}. */
  mutable stdin?: boolean
  /** Environment variables as `KEY=VALUE`. */
  mutable env?: string[]
  /** Working directory. */
  mutable dir?: string
  /** Stdin bytes when {@link stdin} is true. */
  mutable body?: Uint8Array | string
}

/**
 * Run a command on a {@link Sprite} via `POST /sprites/{name}/exec`.
 *
 * ### Exec a command
 * Bind the client in init. Provide {@link ExecHttp}. The Sprite name
 * is fixed by `Exec(box)`. Alchemy transports that name and the
 * deployment's org token to the caller automatically.
 *
 * **Example:** List files
 * ```typescript
 * const exec = yield* Fly.Exec(Box);
 * const result = yield* exec({ cmd: ["ls", "-la"] });
 * ```
 *
 * @binding
 * @product Sprite
 */
export interface Exec extends
  Binding.Service<
    Exec,
    "Fly.Exec",
    (
      sprite: Sprite,
    ) => ((request: ExecRequest) => ExecResult!ExecCommandError!RuntimeContext)!!
  >
{}

export const Exec = Binding.Service<Exec>("Fly.Exec")
