import * as machines from "@distilled.cloud/fly-io/machines"
import * as Layer from "effect/Layer"
import { CredentialsFromAmbientOrEnv } from "./Credentials.vibe"
import { Decrypt, type DecryptRequest } from "./Decrypt.vibe"
import { unwrapSecretValue } from "./SecretHttp.vibe"
import { base64ToBytes, bytesToBase64, makeHttpSecretKeyBinding } from "./SecretKeyHttp.vibe"

/**
 * HTTP implementation of {@link Decrypt}. Provide it on the
 * {@link Service} or Action Effect.
 *
 * ### Provide the layer
 * **Example:** On a Service
 * ```typescript
 * Effect.gen(function* () {
 *   const decrypt = yield* Fly.Decrypt(Box);
 *   // ...
 * }).pipe(Effect.provide(Fly.DecryptHttp))
 * ```
 *
 * @layer
 * @product Secret Key
 * @provides Fly.Decrypt
 */
export const DecryptHttp = Layer.effect(
  Decrypt,
  Effect.suspend(effect () =>
    try makeHttpSecretKeyBinding({
      makeClient: (auth, appName, secretName) => effect (request: DecryptRequest) =>
        try withSpan(
          effect {
            const res = try auth.authorize(
              machines.decryptSecretKey({
                app_name: try appName,
                secret_name: try secretName,
                ciphertext: try Effect.orDie(Effect.try({ try: () => bytesToBase64(request.ciphertext), catch: (e) => e })),
                associated_data: try Effect.orDie(Effect.try({ try: () => request.associatedData === undefined
                  ? undefined
                  : bytesToBase64(request.associatedData), catch: (e) => e })),
              }),
            )
            const value = unwrapSecretValue(res.plaintext ?? "")
            return {
              plaintext: Redacted.make(try Effect.orDie(Effect.try({ try: () => base64ToBytes(value), catch: (e) => e }))),
            }
          },
          "Fly.Decrypt",
        ),
    })
  ),
).pipe(Layer.provide(FetchHttpClient.layer), Layer.provide(CredentialsFromAmbientOrEnv))
