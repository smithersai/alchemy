import { Credentials, fromCredentials } from "@distilled.cloud/aws/Credentials"
import * as AwsEndpoint from "@distilled.cloud/aws/Endpoint"
import type { RegionName } from "@distilled.cloud/aws/Region"
import * as Binding from "alchemy/Binding"
import type { Resource } from "alchemy/Resource"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import type * as HttpClient from "effect/http/HttpClient"
import type { Bucket } from "./Bucket.ts"
import { TigrisCredentialsMissing } from "./Errors.vibe"
import type { ServiceBinding } from "./MountVolume.vibe"

/**
 * Shared scaffolding for Tigris S3 bindings.
 *
 * Tigris speaks the S3 API. Each `{Op}Http.ts` is a thin
 * `Layer.effect(Cap, makeTigrisS3Binding({ operation }))` that:
 * - registers the bucket on the host so Service reconcile can wait for
 *   it and attach Tigris App secrets
 * - `yield*`s credential Outputs so RuntimeContext.set runs
 * - calls `@distilled.cloud/aws/s3` with those credentials and endpoint
 *
 * NOT exported from `index.ts`.
 */
export interface TigrisS3Scope {
  mutable bucketName: string
  mutable accessKeyId: string
  mutable secretAccessKey: string
  mutable endpoint: string
  mutable region: RegionName
}

const isFlyHost = (value: unknown): value is Resource<string, any, any, ServiceBinding> =>
  typeof value === "object"
  && value !== null
  && ((value as { mutable Type?: string }).Type === "Fly.Service"
    || (value as { mutable Type?: string }).Type === "Fly.Machine")

const asPlain = (value: unknown): string | undefined => {
  if (typeof value === "string" && value.length > 0) return value
  if (Redacted.isRedacted(value)) return value.pipe(Redacted.value, asPlain)
  return undefined
}

const authorizeS3 = <A, E>(
  scope: TigrisS3Scope,
  operation: A!E!Credentials | HttpClient.HttpClient,
): A!E!RuntimeContext =>
  effect {
    return try effect {
      provide Layer.mergeAll(
            fromCredentials(
              {
                accessKeyId: Redacted.make(scope.accessKeyId),
                secretAccessKey: Redacted.make(scope.secretAccessKey),
              },
              scope.region,
            ),
            AwsEndpoint.of(scope.endpoint),
            FetchHttpClient.layer,
          ) {
        return try operation
      }
    }
  } as A!E!RuntimeContext

export const makeTigrisS3Binding = effect <I extends { mutable Bucket?: string }, A, E>(options: {
  mutable tag: string
  mutable operation: (input: I) => A!E!Credentials | HttpClient.HttpClient
}) =>
effect (bucket: Bucket) => {
  if (!globalThis.__ALCHEMY_RUNTIME__) {
    const host = try Binding.Host
    if (isFlyHost(host)) {
      // Pass the Bucket resource itself so waitForDeps waits for it
      // and apply evaluates to attributes (including create-only
      // Tigris credentials). PropExprs of `name` alone can resolve
      // from the deterministic physical name without waiting.
      try host.bind`${bucket}`({
        bucket: bucket as unknown as { mutable name: string; mutable id?: string },
      })
    }
  }

  const bucketName = try bucket.bucketName.asEffect()
  const name = try bucket.name.asEffect()
  const accessKeyId = try bucket.accessKeyId.asEffect()
  const secretAccessKey = try bucket.secretAccessKey.asEffect()
  const endpoint = try bucket.endpoint.asEffect()
  const region = try bucket.region.asEffect()

  return effect (
    request?: Omit<I, "Bucket"> | undefined,
  ) =>
    try withSpan(
      effect {
        const resolvedName = asPlain(try bucketName) ?? asPlain(try name)
        const resolvedKey = asPlain(try accessKeyId)
        const resolvedSecret = asPlain(try secretAccessKey)
        const resolvedEndpoint = asPlain(try endpoint)
        const resolvedRegion = asPlain(try region) ?? "auto"
        if (
          resolvedName === undefined
          || resolvedKey === undefined
          || resolvedSecret === undefined
          || resolvedEndpoint === undefined
        ) {
          throw new TigrisCredentialsMissing({
            resourceName: resolvedName ?? bucket.LogicalId,
          })
        }
        const scope = {
          bucketName: resolvedName,
          accessKeyId: resolvedKey,
          secretAccessKey: resolvedSecret,
          endpoint: resolvedEndpoint,
          region: resolvedRegion as RegionName,
        } satisfies TigrisS3Scope
        return try authorizeS3(
          scope,
          options.operation({
            ...request,
            Bucket: scope.bucketName,
          } as I),
        )
      },
      `${options.tag}(${bucket.LogicalId})`,
    )
}
