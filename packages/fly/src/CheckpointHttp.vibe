import * as sprites from "@distilled.cloud/fly-io/sprites"
import * as Layer from "effect/Layer"
import { Checkpoint, type CheckpointClient } from "./Checkpoint.ts"
import { CredentialsFromAmbientOrEnv } from "./Credentials.ts"
import { makeHttpSpriteBinding } from "./SpriteHttp.vibe"

/**
 * HTTP implementation of {@link Checkpoint}. Provide it on the
 * {@link Sprite}, {@link Service}, or Action Effect.
 *
 * ### Provide the layer
 * **Example:** On a Sprite
 * ```typescript
 * Effect.gen(function* () {
 *   const checkpoint = yield* Fly.Checkpoint(Box);
 *   // ...
 * }).pipe(Effect.provide(Fly.CheckpointHttp))
 * ```
 *
 * @layer
 * @product Sprite
 * @provides Fly.Checkpoint
 */
export const CheckpointHttp = Layer.effect(
  Checkpoint,
  Effect.suspend(effect () =>
    try makeHttpSpriteBinding({
      makeClient: (auth, spriteName): CheckpointClient => ({
        create: effect (options) =>
          try withSpan(
            effect {
              return try auth.authorize(
                sprites.createCheckpoint({
                  name: try spriteName,
                  comment: options?.comment,
                }),
              )
            },
            "Fly.Checkpoint.create",
          ),
        list: effect () =>
          try withSpan(
            effect {
              return try auth.authorize(
                sprites.listCheckpoints({
                  name: try spriteName,
                }),
              )
            },
            "Fly.Checkpoint.list",
          ),
        get: effect (checkpointId) =>
          try withSpan(
            effect {
              return try auth.authorize(
                sprites.getCheckpoint({
                  name: try spriteName,
                  checkpoint_id: checkpointId,
                }),
              )
            },
            "Fly.Checkpoint.get",
          ),
        restore: effect (checkpointId) =>
          try withSpan(
            effect {
              return try auth.authorize(
                sprites.restoreCheckpoint({
                  name: try spriteName,
                  checkpoint_id: checkpointId,
                }),
              )
            },
            "Fly.Checkpoint.restore",
          ),
      }),
    })
  ),
).pipe(Layer.provide(FetchHttpClient.layer), Layer.provide(CredentialsFromAmbientOrEnv))
