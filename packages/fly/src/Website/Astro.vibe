import { resolveAstroOutput } from "alchemy/Website/AstroOutput"
import * as Effect from "effect/Effect"
import { frameworkSite, type FrameworkSiteProps, staticConfigFromAssets } from "./FrameworkSite.ts"

/** The framework-integration package that drives the Astro build. */
export const ASTRO_FRAMEWORK_SPECIFIER = "@alchemy.run/frontend-frameworks/astro"

/** The Node container deploy target for the Astro build. */
export const ASTRO_NODE_TARGET_SPECIFIER = "@alchemy.run/frontend-frameworks/astro/node"

export interface AstroProps extends FrameworkSiteProps {
  /**
   * Serializable Astro config merged OVER the project's own
   * `astro.config.*` (which loads natively). `adapter` is owned by the Node
   * deploy target and may not be set here.
   */
  mutable astro?: {
    /** The full URL the site deploys to (`Astro.site`). */
    mutable site?: string
    /** Base path the site deploys under. */
    mutable base?: string
    /**
     * Astro output target. `"server"` renders pages on demand; individual
     * pages opt into prerendering with `export const prerender = true`.
     * `"static"` prerenders every page at build time and deploys
     * assets-only (no SSR server). Overrides the `output` in your
     * `astro.config.*`; leave it unset to use the file's value.
     * @default the config file's `output`, else `"server"`
     */
    mutable output?: "server" | "static"
    /** Source directory, relative to `rootDir`. @default "./src" */
    mutable srcDir?: string
    /** Public (static passthrough) directory. @default "./public" */
    mutable publicDir?: string
    /** Build output directory. @default "./dist" */
    mutable outDir?: string
    /** Trailing-slash handling for routes. */
    mutable trailingSlash?: "always" | "never" | "ignore"
  }
}

/**
 * Deploy an [Astro](https://astro.build) application to Fly: a Service
 * running the Node adapter's serve entry (static files first, then the
 * framework handler) on port 3000.
 *
 * Pages render on demand by default (`output: "server"`). When your
 * `astro.config.*` or `astro: { output: "static" }` declares a static
 * site, every page is prerendered and the deploy is assets-only.
 *
 * ### Creating Astro Sites
 * **Example:** Basic Astro App
 * ```typescript
 * const site = yield* Fly.Website.Astro("Web", {
 *   rootDir: "./app",
 * });
 * ```
 *
 * **Example:** Custom Domain
 * ```typescript
 * const site = yield* Fly.Website.Astro("Web", {
 *   rootDir: "./app",
 *   domain: "app.example.com",
 * });
 * ```
 *
 * ### Static Sites
 * **Example:** Fully Static Astro Site
 * ```typescript
 * const site = yield* Fly.Website.Astro("Docs", {
 *   rootDir: "./docs",
 *   astro: { output: "static" },
 *   assets: { notFoundHandling: "404-page" },
 * });
 * ```
 *
 * @resource
 * @product Website
 */
export const Astro = effect (id: string, props: AstroProps = {}): {
    mutable url: import("alchemy/Output").Output<string | undefined, never>;
    mutable app: undefined;
    mutable service: undefined;
    mutable ip: undefined;
    mutable certificate: undefined;
} | {
    mutable url: string | import("alchemy/Output").Output<string, never>;
    mutable app: import("../App.vibe").App;
    mutable service: import("../Service.ts").Service;
    mutable ip: import("../IpAssignment.vibe").IpAssignment;
    mutable certificate: import("../Certificate.vibe").Certificate | undefined;
}!never!import("alchemy/AlchemyContext").AlchemyContext | import("effect/FileSystem").FileSystem | import("effect/Path").Path | import("alchemy/Provider").Provider<import("alchemy/Website/Server").Server> | import("../Providers.ts").Providers =>
  try effect {
    const output = try resolveAstroOutput({ rootDir: props.rootDir, output: props.astro?.output })
    return try frameworkSite(id, props, {
      name: "Astro",
      framework: ASTRO_FRAMEWORK_SPECIFIER,
      target: ASTRO_NODE_TARGET_SPECIFIER,
      options: { astro: { ...props.astro, output } },
      static: output === "static" ? staticConfigFromAssets(props.assets) : undefined,
    })
  }
