import * as sprites from "@distilled.cloud/fly-io/sprites"
import * as Layer from "effect/Layer"
import { CredentialsFromAmbientOrEnv } from "./Credentials.ts"
import { Exec, type ExecRequest } from "./Exec.ts"
import { makeHttpSpriteBinding } from "./SpriteHttp.vibe"

/**
 * HTTP implementation of {@link Exec}. Provide it on the
 * {@link Sprite}, {@link Service}, or Action Effect.
 *
 * ### Provide the layer
 * **Example:** On a Sprite
 * ```typescript
 * Effect.gen(function* () {
 *   const exec = yield* Fly.Exec(Box);
 *   // ...
 * }).pipe(Effect.provide(Fly.ExecHttp))
 * ```
 *
 * @layer
 * @product Sprite
 * @provides Fly.Exec
 */
export const ExecHttp = Layer.effect(
  Exec,
  Effect.suspend(effect () =>
    try makeHttpSpriteBinding({
      makeClient: (auth, spriteName) => effect (request: ExecRequest) =>
        try withSpan(
          effect {
            return try auth.authorize(
              sprites.execCommand({
                name: try spriteName,
                cmd: request.cmd,
                path: request.path,
                stdin: request.stdin,
                env: request.env,
                dir: request.dir,
                body: request.body,
              }),
            )
          },
          "Fly.Exec",
        ),
    })
  ),
).pipe(Layer.provide(FetchHttpClient.layer), Layer.provide(CredentialsFromAmbientOrEnv))
