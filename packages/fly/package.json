{
  "name": "@alchemy.run/fly",
  "version": "2.0.0-beta.84",
  "description": "Fly.io apps, machines and Postgres for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "fly",
    "fly.io",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/fly"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./Website": "./src/Website/index.ts",
    "./App": "./src/App.vibe",
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./BucketBinding": "./src/BucketBinding.vibe",
    "./Catalog": "./src/Catalog.vibe",
    "./Certificate": "./src/Certificate.vibe",
    "./Checkpoint": "./src/Checkpoint.vibe",
    "./CheckpointHttp": "./src/CheckpointHttp.vibe",
    "./ConnectPostgres": "./src/ConnectPostgres.vibe",
    "./ConnectPostgresHttp": "./src/ConnectPostgresHttp.vibe",
    "./Decrypt": "./src/Decrypt.vibe",
    "./DecryptHttp": "./src/DecryptHttp.vibe",
    "./DeleteObject": "./src/DeleteObject.vibe",
    "./DeleteObjectHttp": "./src/DeleteObjectHttp.vibe",
    "./DeploymentImages": "./src/DeploymentImages.vibe",
    "./Encrypt": "./src/Encrypt.vibe",
    "./EncryptHttp": "./src/EncryptHttp.vibe",
    "./Errors": "./src/Errors.vibe",
    "./Exec": "./src/Exec.vibe",
    "./ExecHttp": "./src/ExecHttp.vibe",
    "./GetObject": "./src/GetObject.vibe",
    "./GetObjectHttp": "./src/GetObjectHttp.vibe",
    "./GetSecret": "./src/GetSecret.vibe",
    "./GetSecretHttp": "./src/GetSecretHttp.vibe",
    "./HeadObject": "./src/HeadObject.vibe",
    "./HeadObjectHttp": "./src/HeadObjectHttp.vibe",
    "./internal/RemoteBuilder": "./src/internal/RemoteBuilder.vibe",
    "./IpAssignment": "./src/IpAssignment.vibe",
    "./ListObjectsV2": "./src/ListObjectsV2.vibe",
    "./ListObjectsV2Http": "./src/ListObjectsV2Http.vibe",
    "./ListSecrets": "./src/ListSecrets.vibe",
    "./ListSecretsHttp": "./src/ListSecretsHttp.vibe",
    "./Machine": "./src/Machine.vibe",
    "./MountVolume": "./src/MountVolume.vibe",
    "./ports": "./src/ports.vibe",
    "./PostgresMigrations": "./src/PostgresMigrations.vibe",
    "./Providers": "./src/Providers.vibe",
    "./PutObject": "./src/PutObject.vibe",
    "./PutObjectHttp": "./src/PutObjectHttp.vibe",
    "./ReadRedis": "./src/ReadRedis.vibe",
    "./ReadRedisHttp": "./src/ReadRedisHttp.vibe",
    "./ReadWriteRedis": "./src/ReadWriteRedis.vibe",
    "./ReadWriteRedisHttp": "./src/ReadWriteRedisHttp.vibe",
    "./Redis": "./src/Redis.vibe",
    "./RedisBinding": "./src/RedisBinding.vibe",
    "./SecretHttp": "./src/SecretHttp.vibe",
    "./SecretKeyHttp": "./src/SecretKeyHttp.vibe",
    "./Service": "./src/Service.vibe",
    "./Sign": "./src/Sign.vibe",
    "./SignHttp": "./src/SignHttp.vibe",
    "./Sprite": "./src/Sprite.vibe",
    "./SpriteHttp": "./src/SpriteHttp.vibe",
    "./Verify": "./src/Verify.vibe",
    "./VerifyHttp": "./src/VerifyHttp.vibe",
    "./VolumeSnapshot": "./src/VolumeSnapshot.vibe",
    "./Website/Astro": "./src/Website/Astro.vibe",
    "./Website/Vinext": "./src/Website/Vinext.vibe",
    "./WriteCertificates": "./src/WriteCertificates.vibe",
    "./WriteCertificatesHttp": "./src/WriteCertificatesHttp.vibe",
    "./WriteRedis": "./src/WriteRedis.vibe",
    "./WriteRedisHttp": "./src/WriteRedisHttp.vibe",
    "./WriteSecret": "./src/WriteSecret.vibe",
    "./WriteSecretHttp": "./src/WriteSecretHttp.vibe",
    "./*.vibe.raw": null,
    "./Bucket": "./src/Bucket.vibe",
    "./Credentials": "./src/Credentials.vibe",
    "./Secret": "./src/Secret.vibe",
    "./SecretKey": "./src/SecretKey.vibe",
    "./Website/AssetDeployment": "./src/Website/AssetDeployment.vibe",
    "./Website/StaticSite": "./src/Website/StaticSite.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./SecretKeyHttp.vibe.platform": null,
    "./Secret.platform": null,
    "./Website/StaticSite.platform": null,
    "./Website/AssetDeployment.platform": null,
    "./Credentials.helpers": null,
    "./SecretKey.helpers": null,
    "./Secret.helpers": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./Website": {
        "types": "./lib/Website/index.d.ts",
        "default": "./lib/Website/index.js"
      },
      "./*.vibe.raw": null,
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./SecretKeyHttp.vibe.platform": null,
      "./Secret.platform": null,
      "./Website/StaticSite.platform": null,
      "./Website/AssetDeployment.platform": null,
      "./Credentials.helpers": null,
      "./SecretKey.helpers": null,
      "./Secret.helpers": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/docker": "workspace:*",
    "@alchemy.run/redis": "workspace:*",
    "@alchemy.run/sql": "workspace:*",
    "@distilled.cloud/aws": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/fly-io": "workspace:*",
    "rolldown": "catalog:",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/fly/Contributions"
    ]
  }
}
