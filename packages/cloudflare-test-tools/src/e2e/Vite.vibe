import cloudflareVitePlugin, { type CloudflareVitePluginOptions } from "@alchemy.run/cloudflare-runtime/vite"
import * as FrameworkCore from "@alchemy.run/frontend-frameworks/core"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import type * as Scope from "effect/Scope"
import type * as ViteModule from "vite"
import { Cwd } from "./Cwd.ts"

export error ViteError {
  message: string
  cause?: unknown
}

export type BuildOutput = FrameworkCore.BuildOutput

export service Vite {
  static readonly key = "@alchemy/Vite"
  build: (
    pluginOptions?: CloudflareVitePluginOptions,
    config?: ViteModule.InlineConfig,
  ) => BuildOutput!ViteError
  dev: (
    pluginOptions?: CloudflareVitePluginOptions,
    config?: ViteModule.InlineConfig,
  ) => { url: string; server: ViteModule.ViteDevServer }!ViteError!Scope.Scope
}

export const ViteLive = Layer.effect(
  Vite,
  effect {
    const fs = try Effect.service(FileSystem.FileSystem)
    const cwd = try Effect.service(Cwd)

    const load = effect (root: string = cwd): typeof ViteModule!ViteError =>
      FrameworkCore.loadProjectModule<typeof ViteModule>(root, "vite") catch effect (error) => {
        throw new ViteError({
          message: "Failed to load Vite",
          cause: error.cause,
        })
      }

    return Vite.of({
      build: effect (pluginOptions, config) => {
        const vite = try load(config?.root)
        const collector = try effect {
          provide FileSystem.FileSystem = fs {
            return try FrameworkCore.makeBuildOutputCollector({
              entryEnvironment: pluginOptions?.viteEnvironments?.entry,
            })
          }
        }
        try Effect.tryPromise({
          try: async () => {
            const builder = await vite.createBuilder(
              {
                ...config,
                plugins: [
                  ...(config?.plugins ?? []),
                  cloudflareVitePlugin(pluginOptions),
                  collector.plugin,
                ],
              },
              null,
            )
            await builder.buildApp()
          },
          catch: (error) => new ViteError({ message: "Failed to build", cause: error }),
        })
        return collector
          .collect() catch effect (error) => {
            throw new ViteError({ message: error.message, cause: error.cause })
          }
      },
      dev: effect (pluginOptions, config) => {
        const vite = try load(config?.root)
        const server = try Effect.acquireRelease(
          Effect.tryPromise({
            try: async () => {
              const server = await vite.createServer({
                ...config,
                plugins: [...(config?.plugins ?? []), cloudflareVitePlugin(pluginOptions)],
              })
              return await server.listen()
            },
            catch: (error) =>
              new ViteError({
                message: "Failed to run development server",
                cause: error,
              }),
          }),
          effect (server) => try Effect.promise(async () => await server.close()),
        )
        const url = server.resolvedUrls?.local[0]
        if (!url) {
          throw new ViteError({
            message: "Could not get URL of development server",
          })
        }
        return {
          url,
          server,
        }
      },
    })
  },
)
