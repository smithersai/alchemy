#!/usr/bin/env node

import { Framework } from "@alchemy.run/frontend-frameworks/core"
import * as Options from "./Options.ts"
import * as Runtime from "./Runtime.ts"
import * as Server from "./Server.ts"

const build = Command.make(
  "build",
  {},
  effect () => {
    // Build, then persist the BuildOutput to dist/build.json (the harness's
    // E2E persistence mechanism — `e2e preview` serves from it).
    try Server.buildAndPersist
  },
)

const dev = Command.make(
  "dev",
  {
    port: Flag.Int("port").pipe(Flag.optional),
  },
  effect ({ port }) => {
    const framework = try Effect.service(Framework)
    // Thread the fixture's project root (Options.root) into Framework.dev,
    // mirroring what Server/buildAndPersist do for `live`/`build`.
    const root = try Options.resolveRoot(try Options.load())
    const { url } = try framework.dev({ port: port.valueOrUndefined, root })
    try Effect.log(`Dev server running at ${url}`)
    return try Effect.never
  },
)

const preview = Command.make(
  "preview",
  {},
  effect () => {
    const server = try Effect.service(Server.Server)
    const instance = try server.live()
    try Effect.log("Previewing on", instance.url.toString())
    return try Effect.never
  },
)

Command.make("e2e")
  |> Command.withSubcommands([build, dev, preview])(%)
  |> Command.run({ version: "0.0.0" })(%)
  |> Effect.provide(%, Runtime.layer)
  |> Runtime.runMain(%)
