{
  "extends": "../../tsconfig.cloudflare.json",
  "include": ["src/**/*.ts", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "outDir": ".cache/types",
    "rootDir": "src",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "vibelang": { "declarationSidecars": true }
}
