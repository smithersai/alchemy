{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vibe"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "references": [
    {
      "path": "../alchemy/tsconfig.json"
    },
    { "path": "../redis/tsconfig.json" },
    { "path": "../docker/tsconfig.json" },
    { "path": "../kubernetes/tsconfig.json" },
    {
      "path": "../../submodules/distilled/packages/aws/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/aws4signer/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/core/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/gcp/tsconfig.json"
    }
  ],
  "vibelang": { "declarationSidecars": true, "trustedPackages": ["@alchemy.run/docker", "@alchemy.run/gcp", "@alchemy.run/kubernetes", "@alchemy.run/redis", "@alchemy.run/sql", "@distilled.cloud/aws", "@distilled.cloud/aws4signer", "@distilled.cloud/core", "@distilled.cloud/gcp", "alchemy"] }
}
