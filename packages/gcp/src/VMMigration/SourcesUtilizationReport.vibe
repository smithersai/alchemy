import * as vm from "@distilled.cloud/gcp/vmmigration_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  encodeOwnershipLine,
  fingerprint,
  forEachSource,
  hasOwnershipMarker,
  normalizeLocation,
  ownedByAlchemy,
  parseName,
  parseOwnership,
  replaceOnIdentity,
  ResourceNotResolved,
  sourceOf,
  toPhysicalId,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type UtilizationReportTimeFrame = vm.UtilizationReportTimeFrameEnum | (string & {})
export type UtilizationReportState = vm.UtilizationReportStateEnum | (string & {})
export type VmUtilizationInfo = vm.VmUtilizationInfo

export type SourcesUtilizationReportProps = {
  /**
   * Parent source. Full name
   * `projects/{project}/locations/{location}/sources/{source}` or the
   * source id (combined with `location`). Immutable — changing it
   * replaces the report.
   */
  source: string
  /**
   * Region used when `source` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * Utilization report id. If omitted, a unique RFC1035 name is
   * generated. Immutable — changing it replaces the report.
   */
  utilizationReportId?: string
  /**
   * User-friendly display name. Reports have no labels field, so
   * Alchemy ownership is stored in a `[alchemy …]` prefix and stripped
   * from attributes.
   */
  displayName?: string
  /**
   * Time frame of the report.
   * @default "WEEK"
   */
  timeFrame?: UtilizationReportTimeFrame
  /**
   * VMs to include. Only `vmId` is honored on create; other fields are
   * filled by the service.
   */
  vms?: VmUtilizationInfo[]
}

export type SourcesUtilizationReport = Resource<
  "GCP.VMMigration.SourcesUtilizationReport",
  SourcesUtilizationReportProps,
  {
    /** Full resource name. */
    name: string
    /** Utilization report id (last path segment). */
    utilizationReportId: string
    /** Parent source resource name. */
    source: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** Time frame of the report. */
    timeFrame: string | undefined
    /** VMs included in the report. */
    vms: VmUtilizationInfo[] | undefined
    /** Number of VMs included. */
    vmCount: number | undefined
    /** Report state. */
    state: string | undefined
    /** End of the sampled time frame. */
    frameEndTime: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
  },
  never,
  Providers
>

/**
 * A VM Migration utilization report for selected VMs in a source
 * environment (CPU, memory, disk, network).
 *
 * Reports have no labels field — Alchemy stamps ownership into the
 * display name so `list` / nuke can find them. The API has no patch
 * method; changing time frame, VMs, or display name replaces the
 * report.
 *
 * ### Creating a Utilization Report
 * **Example:** Weekly report for selected VMs
 * ```typescript
 * const report = yield* GCP.VMMigration.SourcesUtilizationReport("Week", {
 *   source: source.name,
 *   timeFrame: "WEEK",
 *   vms: [{ vmId: "vm-123" }, { vmId: "vm-456" }],
 * });
 * ```
 *
 * @resource
 * @category VMMigration
 */
export const SourcesUtilizationReport = Resource<SourcesUtilizationReport>(
  "GCP.VMMigration.SourcesUtilizationReport",
)

const DEFAULT_TIME_FRAME: UtilizationReportTimeFrame = "WEEK"

const resourceName = (source: string, utilizationReportId: string): infer _ =>
  `${source}/utilizationReports/${utilizationReportId}`

const toAttrs = (report: vm.UtilizationReport, project: string, region: string): infer _ => {
  const name = report.name ?? ""
  const parsed = parseName(name, "utilizationReports", region)
  const ownership = parseOwnership(report.displayName)
  return {
    name,
    utilizationReportId: parsed.id,
    source: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    displayName: ownership.text,
    timeFrame: report.timeFrame,
    vms: report.vms,
    vmCount: report.vmCount,
    state: report.state,
    frameEndTime: report.frameEndTime,
    createTime: report.createTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : vm
  .getProjectsLocationsSourcesUtilizationReports({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listChildren = effect (parent: string) =>
  collectPages(
    vm.listProjectsLocationsSourcesUtilizationReports.pages({
      parent,
      pageSize: 1000,
      view: "BASIC",
    }),
    (page) => page.utilizationReports,
  ) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as vm.UtilizationReport[]; default: throw e; }

export const SourcesUtilizationReportProvider = (): infer _ =>
  Provider.succeed(SourcesUtilizationReport, {
    stables: ["name", "utilizationReportId", "source", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousSource = olds?.source ?? output?.source
      const previousFrame = olds?.timeFrame ?? output?.timeFrame ?? DEFAULT_TIME_FRAME
      const nextFrame = resolved.timeFrame ?? previousFrame
      const extra = previousFrame !== nextFrame
        || (try Effect.orDie(
            Effect.try({ try: () => fingerprint(resolved.vms?.map((vmInfo) => vmInfo.vmId)), catch: (e) => e }),
          ))
          !== (try Effect.orDie(
            Effect.try({
              try: () => fingerprint((olds?.vms ?? output?.vms)?.map((vmInfo) => vmInfo.vmId)),
              catch: (e) => e,
            }),
          ))
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.utilizationReportId ?? output?.utilizationReportId,
            nextId: resolved.utilizationReportId ?? olds?.utilizationReportId ?? output?.utilizationReportId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            previousParent: previousSource,
            nextParent: resolved.source ?? previousSource,
            extra,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const utilizationReportId = try toPhysicalId(
        id,
        olds?.utilizationReportId,
        output?.utilizationReportId,
        "utilreport",
      )
      const source = olds?.source !== undefined
        ? try Effect.orDie(Effect.try({ try: () => sourceOf(olds.source, env.project, location), catch: (e) => e }))
        : (output?.source ?? "")
      const name = output?.name ?? (source.length > 0 ? resourceName(source, utilizationReportId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try forEachSource(env.project, listChildren, env.region)
      return items
        .filter((item) => hasOwnershipMarker(item.displayName))
        .map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const source = try Effect.orDie(
        Effect.try({ try: () => sourceOf(news.source, env.project, location), catch: (e) => e }),
      )
      const utilizationReportId = try toPhysicalId(
        id,
        news.utilizationReportId,
        output?.utilizationReportId,
        "utilreport",
      )
      const name = resourceName(source, utilizationReportId)
      const ownership = try createInternalLabels(id)
      const displayName = try Effect.orDie(
        Effect.try({
          try: () => encodeOwnershipLine(ownership, news.displayName ?? utilizationReportId),
          catch: (e) => e,
        }),
      )
      const timeFrame = news.timeFrame ?? DEFAULT_TIME_FRAME

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = vm
          .createProjectsLocationsSourcesUtilizationReports({
            parent: source,
            utilizationReportId,
            body: {
              displayName,
              timeFrame,
              vms: news.vms,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          // ALREADY_EXISTS (6): a concurrent create won the race.
          waitForOperation(created) catch effect (error) => match (error) {
            when { _tag: "GCP.OperationFailed" }: try (error.code === 6 ? Effect.void : throw error);
            default: throw error;
          }
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (vm
          .deleteProjectsLocationsSourcesUtilizationReports({
            name: output.name,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        // NOT_FOUND (5): already gone.
        waitForOperation(operation) catch effect (error) => match (error) {
          when { _tag: "GCP.OperationFailed" }: try (error.code === 5 ? Effect.void : throw error);
          default: throw error;
        }
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
