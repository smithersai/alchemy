import * as vm from "@distilled.cloud/gcp/vmmigration_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  encodeOwnershipLine,
  forEachSource,
  hasOwnershipMarker,
  normalizeLocation,
  ownedByAlchemy,
  parseName,
  parseOwnership,
  replaceOnIdentity,
  ResourceNotResolved,
  sourceOf,
  toPhysicalId,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type DatacenterConnectorState = vm.DatacenterConnectorStateEnum | (string & {})

export type SourcesDatacenterConnectorProps = {
  /**
   * Parent source. Full name
   * `projects/{project}/locations/{location}/sources/{source}` or the
   * source id (combined with `location`). Immutable — changing it
   * replaces the connector.
   */
  source: string
  /**
   * Region used when `source` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * Datacenter connector id. If omitted, a unique RFC1035 name is
   * generated. Immutable — changing it replaces the connector.
   */
  datacenterConnectorId?: string
  /**
   * Unique registration key supplied by the OVA connector. Immutable —
   * changing it replaces the connector. Defaults to the connector id.
   */
  registrationId?: string
  /**
   * Appliance version. Connectors have no labels or description field,
   * so Alchemy ownership is stored in a `[alchemy …]` prefix and
   * stripped from attributes.
   */
  version?: string
  /**
   * Service account the connector uses when talking to Google Cloud.
   */
  serviceAccount?: string
}

export type SourcesDatacenterConnector = Resource<
  "GCP.VMMigration.SourcesDatacenterConnector",
  SourcesDatacenterConnectorProps,
  {
    /** Full resource name. */
    name: string
    /** Datacenter connector id (last path segment). */
    datacenterConnectorId: string
    /** Parent source resource name. */
    source: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Registration key. */
    registrationId: string | undefined
    /** Appliance version with the Alchemy ownership prefix stripped. */
    version: string | undefined
    /** Service account used by the connector. */
    serviceAccount: string | undefined
    /** Communication bucket. */
    bucket: string | undefined
    /** Health state. */
    state: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A VM Migration datacenter connector registered against a VMware
 * source. The on-prem OVA appliance uses the registration id to bind to
 * this resource.
 *
 * Connectors have no labels or description — Alchemy stamps ownership
 * into `version` so `list` / nuke can find them. The API has no patch
 * method; changing identity or registration replaces the connector.
 *
 * ### Creating a Datacenter Connector
 * **Example:** Register against a source
 * ```typescript
 * const source = yield* GCP.VMMigration.Source("Vcenter", {
 *   vmware: { vcenterIp: "10.0.0.4", username: "admin" },
 * });
 * const connector = yield* GCP.VMMigration.SourcesDatacenterConnector(
 *   "Appliance",
 *   {
 *     source: source.name,
 *     version: "1.0.0",
 *   },
 * );
 * ```
 *
 * @resource
 * @category VMMigration
 */
export const SourcesDatacenterConnector = Resource<SourcesDatacenterConnector>(
  "GCP.VMMigration.SourcesDatacenterConnector",
)

const resourceName = (source: string, datacenterConnectorId: string): infer _ =>
  `${source}/datacenterConnectors/${datacenterConnectorId}`

const toAttrs = (connector: vm.DatacenterConnector, project: string, region: string): infer _ => {
  const name = connector.name ?? ""
  const parsed = parseName(name, "datacenterConnectors", region)
  const ownership = parseOwnership(connector.version)
  return {
    name,
    datacenterConnectorId: parsed.id,
    source: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    registrationId: connector.registrationId,
    version: ownership.text,
    serviceAccount: connector.serviceAccount,
    bucket: connector.bucket,
    state: connector.state,
    createTime: connector.createTime,
    updateTime: connector.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : vm
  .getProjectsLocationsSourcesDatacenterConnectors({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listChildren = effect (parent: string) =>
  collectPages(
    vm.listProjectsLocationsSourcesDatacenterConnectors.pages({
      parent,
      pageSize: 1000,
    }),
    (page) => page.datacenterConnectors,
  ) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as vm.DatacenterConnector[]; default: throw e; }

export const SourcesDatacenterConnectorProvider = (): infer _ =>
  Provider.succeed(SourcesDatacenterConnector, {
    stables: ["name", "datacenterConnectorId", "source", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousSource = olds?.source ?? output?.source
      const extra = (resolved.registrationId !== undefined
        && (olds?.registrationId ?? output?.registrationId) !== undefined
        && resolved.registrationId !== (olds?.registrationId ?? output?.registrationId))
        || (resolved.serviceAccount !== undefined
          && (olds?.serviceAccount ?? output?.serviceAccount) !== undefined
          && resolved.serviceAccount !== (olds?.serviceAccount ?? output?.serviceAccount))
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.datacenterConnectorId ?? output?.datacenterConnectorId,
            nextId: resolved.datacenterConnectorId
              ?? olds?.datacenterConnectorId
              ?? output?.datacenterConnectorId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            previousParent: previousSource,
            nextParent: resolved.source ?? previousSource,
            extra,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const datacenterConnectorId = try toPhysicalId(
        id,
        olds?.datacenterConnectorId,
        output?.datacenterConnectorId,
        "connector",
      )
      const source = olds?.source !== undefined
        ? try Effect.orDie(Effect.try({ try: () => sourceOf(olds.source, env.project, location), catch: (e) => e }))
        : (output?.source ?? "")
      const name = output?.name ?? (source.length > 0 ? resourceName(source, datacenterConnectorId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try ownedByAlchemy(id, existing.version))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try forEachSource(env.project, listChildren, env.region)
      return items
        .filter((item) => hasOwnershipMarker(item.version))
        .map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const source = try Effect.orDie(
        Effect.try({ try: () => sourceOf(news.source, env.project, location), catch: (e) => e }),
      )
      const datacenterConnectorId = try toPhysicalId(
        id,
        news.datacenterConnectorId,
        output?.datacenterConnectorId,
        "connector",
      )
      const name = resourceName(source, datacenterConnectorId)
      const ownership = try createInternalLabels(id)
      const version = try Effect.orDie(
        Effect.try({ try: () => encodeOwnershipLine(ownership, news.version, 128), catch: (e) => e }),
      )
      const registrationId = news.registrationId ?? datacenterConnectorId

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = vm
          .createProjectsLocationsSourcesDatacenterConnectors({
            parent: source,
            datacenterConnectorId,
            body: {
              registrationId,
              version,
              serviceAccount: news.serviceAccount,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          // ALREADY_EXISTS (6): a concurrent create won the race.
          waitForOperation(created) catch effect (error) => match (error) {
            when { _tag: "GCP.OperationFailed" }: try (error.code === 6 ? Effect.void : throw error);
            default: throw error;
          }
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (vm
          .deleteProjectsLocationsSourcesDatacenterConnectors({
            name: output.name,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        // NOT_FOUND (5): already gone.
        waitForOperation(operation) catch effect (error) => match (error) {
          when { _tag: "GCP.OperationFailed" }: try (error.code === 5 ? Effect.void : throw error);
          default: throw error;
        }
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
