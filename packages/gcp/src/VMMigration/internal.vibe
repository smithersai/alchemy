import * as vm from "@distilled.cloud/gcp/vmmigration_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import { tagRecord } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import { alchemyLabelKeys, createInternalLabels, hasAlchemyLabels, stripInternalLabels } from "../Labels.ts"
import { waitForOperation as waitForGcpOperation } from "../Operation.ts"

export const GLOBAL_LOCATION = "global"
export const MAX_NAME_LENGTH = 63
export const MAX_DISPLAY_NAME_LENGTH = 63

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceNotResolved extends Data.TaggedError("GCP.VMMigration.ResourceNotResolved")<{
  mutable resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceStillExists extends Data.TaggedError("GCP.VMMigration.ResourceStillExists")<{
  mutable resourceName: string
}> {}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const rfc1035 = (name: string, fallback = "vm"): string => {
  let next = name
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "")
  if (!/^[a-z]/.test(next)) next = `v${next}`
  next = next.slice(0, MAX_NAME_LENGTH).replace(/-+$/g, "")
  if (next.length === 0) return fallback
  if (!/[a-z0-9]$/.test(next)) next = `${next.slice(0, MAX_NAME_LENGTH - 1)}0`
  return next.slice(0, MAX_NAME_LENGTH)
}

export const normalizeLocation = (location: string | undefined, fallback: string): infer _ =>
  lastSegment(location ?? fallback).toLowerCase()

export const locationParent = (project: string, location: string): infer _ =>
  `projects/${project}/locations/${lastSegment(location).toLowerCase()}`

export const globalParent = (project: string): infer _ => `projects/${project}/locations/${GLOBAL_LOCATION}`

export const parentOfName = (name: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  return parts.slice(0, -2).join("/")
}

export const toPhysicalId = effect (
  id: string,
  explicit: string | undefined,
  existing: string | undefined,
  fallback = "vm",
) => {
  if (explicit !== undefined) return rfc1035(explicit, fallback)
  if (existing !== undefined) return existing
  return rfc1035(
    try createPhysicalName({
      id,
      maxLength: MAX_NAME_LENGTH,
      lowercase: true,
    }),
    fallback,
  )
}

export const parseName = (name: string, collection: string, fallbackLocation: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const collectionAt = parts.lastIndexOf(collection)
  const locationsAt = parts.lastIndexOf("locations")
  const projectsAt = parts.lastIndexOf("projects")
  return {
    project: projectsAt >= 0 && parts[projectsAt + 1] ? parts[projectsAt + 1]! : "",
    location: locationsAt >= 0 && parts[locationsAt + 1] ? parts[locationsAt + 1]! : fallbackLocation,
    id: collectionAt >= 0 && parts[collectionAt + 1] ? parts[collectionAt + 1]! : lastSegment(name),
    parent: collectionAt > 0
      ? parts.slice(0, collectionAt).join("/")
      : parts.slice(0, Math.max(0, parts.length - 1)).join("/"),
  }
}

export const expandParent = (
  value: string,
  project: string,
  location: string,
  collection: string,
): infer _ => {
  if (value.includes("/")) return value.replace(/\/+$/, "")
  return `projects/${project}/locations/${location}/${collection}/${value}`
}

export const sourceOf = (value: string, project: string, location: string): infer _ =>
  expandParent(value, project, location, "sources")

export const userLabels = (
  labels: Record<string, string | undefined> | null | undefined,
): Record<string, string> => stripInternalLabels(tagRecord(labels))

export const hasAlchemyLabelMap = (labels: Record<string, string | undefined> | null | undefined): infer _ =>
  Object.keys(labels ?? {}).some((key) => key.startsWith("alchemy-"))

export const canonical = (value: unknown): unknown => {
  if (value === undefined || value === null) return undefined
  if (typeof value === "boolean" || typeof value === "number") return value
  if (typeof value === "string") {
    return value.length === 0 ? undefined : value
  }
  if (Array.isArray(value)) {
    const items = value.map(canonical).filter((item) => item !== undefined)
    return items.length === 0 ? undefined : items
  }
  if (typeof value === "object") {
    const entries = Object.entries(value as Record<string, unknown>)
      .map(([key, item]) => [key, canonical(item)] as const)
      .filter(([, item]) => item !== undefined)
      .sort(([left], [right]) => left.localeCompare(right))
    if (entries.length === 0) return undefined
    return Object.fromEntries(entries)
  }
  return undefined
}

export const fingerprint = (value: unknown): string => JSON.stringify(canonical(value) ?? null)

export const fieldMask = (fields: Array<string | false | undefined>): infer _ =>
  fields.filter((field): field is string => typeof field === "string").join(",")

export const replaceOnIdentity = (input: {
  mutable previousId: string | undefined
  mutable nextId: string | undefined
  mutable previousLocation: string
  mutable nextLocation: string
  mutable extra?: boolean
  mutable previousParent?: string
  mutable nextParent?: string
}): infer _ => {
  const parentChanged = (input.previousParent ?? "") !== ""
    && (input.nextParent ?? "") !== ""
    && (input.previousParent ?? "") !== (input.nextParent ?? "")
  const replace = (input.extra ?? false)
    || parentChanged
    || (input.previousId !== undefined
      && input.nextId !== undefined
      && input.nextId !== input.previousId)
    || input.previousLocation !== input.nextLocation
  if (!replace) return undefined
  const samePhysical = input.previousLocation === input.nextLocation
    && !parentChanged
    && input.previousId !== undefined
    && input.nextId === input.previousId
  return {
    action: "replace" as const,
    deleteFirst: samePhysical,
  }
}

/**
 * Wait for a Migrate to Virtual Machines long-running operation. Sources, groups, and utilization reports settle in minutes; migrating-VM and image-import operations take longer.
 */
export const waitForOperation = effect (operation: vm.Operation) =>
  try waitForGcpOperation(operation, effect (name) => try vm.getProjectsLocationsOperations({ name }), {
    budget: "20 minutes",
  })

export const waitUntilExists = effect <A, E, R>(
  get: A | undefined!E!R,
  name: string,
): Exclude<A, undefined>!E | ResourceNotResolved!R =>
  try (get
    |> Effect.filterOrFail(%, (value): value is Exclude<A, undefined> =>
      value !== undefined, () =>
      new ResourceNotResolved({ resourceName: name }))
    |> Effect.retry(%, {
      while: (error) =>
        error instanceof ResourceNotResolved,
      times: 8,
      schedule: Schedule.spaced("1 second"),
    }))

export const waitUntilGone = effect <A, E, R>(
  get: A | undefined!E!R,
  name: string,
): void!E | ResourceStillExists!R =>
  try (get
    |> Effect.filterOrFail(%, (value) => value === undefined, () => new ResourceStillExists({ resourceName: name }))
    |> Effect.asVoid(%)
    |> Effect.retry(%, {
      while: (error) => error instanceof ResourceStillExists,
      times: 10,
      schedule: Schedule.spaced("4 seconds"),
    }))

export const collectPages = effect <Page, A, E, R>(
  pages: Stream.Stream<Page, E, R>,
  items: (page: Page) => readonly A[] | undefined,
) =>
  Array.from(
    try (pages
      |> Stream.flatMap((page) => Stream.fromIterable(items(page) ?? []))(%)
      |> Stream.runCollect(%)),
  )

/** List across `locations/-`, falling back to the region if the wildcard 404s. */
export const listAtLocation = effect <A, E extends { readonly _tag: string }, R>(
  project: string,
  region: string,
  list: (parent: string) => A[]!E!R,
) =>
  try (list(`projects/${project}/locations/-`)
    |> Effect.catchIf(%, (error): error is E & { readonly _tag: "NotFound" } =>
      error._tag === "NotFound", effect () =>
      try list(`projects/${project}/locations/${region}`)))

export const listSources = effect (project: string, region: string) =>
  collectPages(
    vm.listProjectsLocationsSources.pages({
      parent: `projects/${project}/locations/-`,
      pageSize: 1000,
    }),
    (page) => page.sources,
  ) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: collectPages(
      vm.listProjectsLocationsSources.pages({
        parent: locationParent(project, region),
        pageSize: 1000,
      }),
      (page) => page.sources,
    ) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as vm.Source[]; default: throw e; };
    default: throw e;
  }

export const forEachSource = effect <A, E, R>(
  project: string,
  list: (parent: string) => A[]!E!R,
  region: string,
) => {
  const sources = try listSources(project, region)
  const named = sources.filter((source) => (source.name ?? "").length > 0)
  const groups = try Effect.forEach(named, effect (source) => try list(source.name!), { concurrency: 4 })
  return groups.flat()
}

const markerOf = (labels: Record<string, string>, stack: string, stage: string, id: string): infer _ =>
  `[alchemy ${alchemyLabelKeys.stack}=${stack} ${alchemyLabelKeys.stage}=${stage} ${alchemyLabelKeys.id}=${id}]`

const fitMarker = (labels: Record<string, string>, maxLength: number): infer _ => {
  let stack = labels[alchemyLabelKeys.stack] ?? "x"
  let stage = labels[alchemyLabelKeys.stage] ?? "x"
  let id = labels[alchemyLabelKeys.id] ?? "x"
  let marker = markerOf(labels, stack, stage, id)
  while (marker.length > maxLength && (stack.length > 1 || stage.length > 1 || id.length > 1)) {
    if (stack.length >= stage.length && stack.length >= id.length) {
      stack = stack.slice(0, -1)
    } else if (stage.length >= id.length) {
      stage = stage.slice(0, -1)
    } else {
      id = id.slice(0, -1)
    }
    marker = markerOf(labels, stack, stage, id)
  }
  return marker.slice(0, maxLength)
}

export const encodeOwnership = (
  labels: Record<string, string>,
  text: string | undefined,
): string => {
  const marker = fitMarker(labels, 8000)
  const trimmed = text?.trim()
  return trimmed && trimmed.length > 0 ? `${marker}\n${trimmed}` : marker
}

export const encodeOwnershipLine = (
  labels: Record<string, string>,
  text: string | undefined,
  maxLength = MAX_DISPLAY_NAME_LENGTH,
): string => {
  const trimmed = text?.replace(/[\r\n]+/g, " ").trim()
  if (!trimmed) return fitMarker(labels, maxLength)
  const minMarker = 24
  const reserved = Math.min(trimmed.length + 1, Math.max(0, maxLength - minMarker))
  const marker = fitMarker(labels, maxLength - reserved)
  return `${marker} ${trimmed}`.slice(0, maxLength)
}

export const parseOwnership = (
  text: string | undefined,
): {
  mutable labels: Record<string, string>
  mutable text: string | undefined
} => {
  if (!text?.startsWith("[alchemy ")) {
    return { labels: {}, text }
  }
  const end = text.indexOf("]")
  if (end < 0) return { labels: {}, text }
  const labels: Record<string, string> = {}
  for (const part of text.slice("[alchemy ".length, end).split(/\s+/)) {
    const eq = part.indexOf("=")
    if (eq > 0) {
      labels[part.slice(0, eq)] = part.slice(eq + 1)
    }
  }
  const rest = text.slice(end + 1).replace(/^[\s\n]+/, "")
  return { labels, text: rest.length > 0 ? rest : undefined }
}

export const hasOwnershipMarker = (text: string | undefined): infer _ =>
  Object.keys(parseOwnership(text).labels).some((key) => key.startsWith("alchemy-"))

const prefixMatch = (expected: string, observed: string): infer _ =>
  expected === observed || expected.startsWith(observed) || observed.startsWith(expected)

export const ownedByAlchemy = effect (id: string, text: string | undefined) => {
  const expected = try createInternalLabels(id)
  const { labels } = parseOwnership(text)
  if (!hasOwnershipMarker(text)) return false
  const exact = try hasAlchemyLabels(id, labels)
  if (exact) return true
  return (
    prefixMatch(expected[alchemyLabelKeys.stack] ?? "", labels[alchemyLabelKeys.stack] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.stage] ?? "", labels[alchemyLabelKeys.stage] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.id] ?? "", labels[alchemyLabelKeys.id] ?? "")
  )
}
