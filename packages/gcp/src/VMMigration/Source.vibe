import * as vm from "@distilled.cloud/gcp/vmmigration_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import {
  fieldMask,
  fingerprint,
  hasAlchemyLabelMap,
  locationParent,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  ResourceNotResolved,
  toPhysicalId,
  userLabels,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type AwsSourceDetails = vm.AwsSourceDetails
export type AzureSourceDetails = vm.AzureSourceDetails
export type VmwareSourceDetails = vm.VmwareSourceDetails
export type Encryption = vm.Encryption

export type SourceProps = {
  /**
   * Source id (the `{source}` segment of
   * `projects/{project}/locations/{location}/sources/{source}`). If
   * omitted, a unique RFC1035 name is generated. Immutable — changing it
   * replaces the source.
   */
  sourceId?: string
  /**
   * Region (`us-central1`, …). Immutable — changing it replaces the
   * source. `US-CENTRAL1` is accepted and normalized to `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * User-provided description of the source.
   */
  description?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Encryption of source data stored by the service. Immutable —
   * changing it replaces the source.
   */
  encryption?: Encryption
  /**
   * AWS source environment. Mutually exclusive with `azure` and
   * `vmware`. Switching source kinds replaces the source.
   */
  aws?: AwsSourceDetails
  /**
   * Azure source environment. Mutually exclusive with `aws` and
   * `vmware`. Switching source kinds replaces the source.
   */
  azure?: AzureSourceDetails
  /**
   * VMware vCenter source environment. Mutually exclusive with `aws`
   * and `azure`. Switching source kinds replaces the source.
   */
  vmware?: VmwareSourceDetails
}

export type Source = Resource<
  "GCP.VMMigration.Source",
  SourceProps,
  {
    /** Full resource name. */
    name: string
    /** Source id (last path segment). */
    sourceId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** User-provided description. */
    description: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Encryption of stored source data. */
    encryption: Encryption | undefined
    /** AWS source details as reported by the API. */
    aws: AwsSourceDetails | undefined
    /** Azure source details as reported by the API. */
    azure: AzureSourceDetails | undefined
    /** VMware source details as reported by the API. */
    vmware: VmwareSourceDetails | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A VM Migration source environment (AWS, Azure, or VMware vCenter)
 * that inventories VMs and disks for migration.
 *
 * `sourceId`, `location`, `encryption`, and the source kind
 * (`aws` / `azure` / `vmware`) plus immutable region/subscription
 * fields are replacement triggers. Description, labels, and credential
 * fields update in place.
 *
 * ### Creating a Source
 * **Example:** AWS source
 * ```typescript
 * const source = yield* GCP.VMMigration.Source("Aws", {
 *   aws: {
 *     awsRegion: "us-east-1",
 *     accessKeyCreds: {
 *       accessKeyId: process.env.AWS_ACCESS_KEY_ID,
 *       secretAccessKey: process.env.AWS_SECRET_ACCESS_KEY,
 *     },
 *   },
 *   labels: { env: "test" },
 * });
 * ```
 *
 * **Example:** VMware source
 * ```typescript
 * const source = yield* GCP.VMMigration.Source("Vcenter", {
 *   vmware: {
 *     vcenterIp: "10.0.0.4",
 *     username: "admin",
 *     password: process.env.VCENTER_PASSWORD,
 *     thumbprint: process.env.VCENTER_THUMBPRINT,
 *   },
 * });
 * ```
 *
 * @resource
 * @category VMMigration
 */
export const Source = Resource<Source>("GCP.VMMigration.Source")

const resourceName = (project: string, location: string, sourceId: string): infer _ =>
  `${locationParent(project, location)}/sources/${sourceId}`

const kindOf = (value: { aws?: unknown; azure?: unknown; vmware?: unknown }): infer _ =>
  value.aws ? "aws" : value.azure ? "azure" : value.vmware ? "vmware" : ""

const toAttrs = (source: vm.Source, project: string, region: string): infer _ => {
  const name = source.name ?? ""
  const parsed = parseName(name, "sources", region)
  return {
    name,
    sourceId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    description: source.description,
    labels: userLabels(source.labels),
    encryption: source.encryption,
    aws: source.aws,
    azure: source.azure,
    vmware: source.vmware,
    createTime: source.createTime,
    updateTime: source.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : vm
  .getProjectsLocationsSources({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listOwned = effect (project: string, region: string) =>
  (effect {
    return (Array.from(
      try (vm.listProjectsLocationsSources
        .pages({
          parent: `projects/${project}/locations/-`,
          pageSize: 1000,
        })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.sources ?? []))
        |> Stream.filter(%, (item) => hasAlchemyLabelMap(item.labels))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: (effect {
      return (Array.from(
        try (vm.listProjectsLocationsSources
          .pages({
            parent: try Effect.orDie(Effect.try({ try: () => locationParent(project, region), catch: (e) => e })),
            pageSize: 1000,
          })
          |> Stream.flatMap(%, (page) => Stream.fromIterable(page.sources ?? []))
          |> Stream.filter(%, (item) => hasAlchemyLabelMap(item.labels))
          |> Stream.runCollect(%)),
      ))
    }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as vm.Source[]; default: throw e; };
    default: throw e;
  }

const publicAws = (aws: AwsSourceDetails | undefined): infer _ =>
  aws === undefined
    ? undefined
    : {
      awsRegion: aws.awsRegion,
      inventorySecurityGroupNames: aws.inventorySecurityGroupNames,
      inventoryTagList: aws.inventoryTagList,
      migrationResourcesUserTags: aws.migrationResourcesUserTags,
      accessKeyCreds: aws.accessKeyCreds
        ? { accessKeyId: aws.accessKeyCreds.accessKeyId }
        : undefined,
    }

const publicAzure = (azure: AzureSourceDetails | undefined): infer _ =>
  azure === undefined
    ? undefined
    : {
      azureLocation: azure.azureLocation,
      subscriptionId: azure.subscriptionId,
      migrationResourcesUserTags: azure.migrationResourcesUserTags,
      clientSecretCreds: azure.clientSecretCreds
        ? {
          tenantId: azure.clientSecretCreds.tenantId,
          clientId: azure.clientSecretCreds.clientId,
        }
        : undefined,
    }

const publicVmware = (vmware: VmwareSourceDetails | undefined): infer _ =>
  vmware === undefined
    ? undefined
    : {
      vcenterIp: vmware.vcenterIp,
      username: vmware.username,
      thumbprint: vmware.thumbprint,
      resolvedVcenterHost: vmware.resolvedVcenterHost,
    }

export const SourceProvider = (): infer _ =>
  Provider.succeed(Source, {
    stables: ["name", "sourceId", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousKind = kindOf({
        aws: olds?.aws ?? output?.aws,
        azure: olds?.azure ?? output?.azure,
        vmware: olds?.vmware ?? output?.vmware,
      })
      const nextKind = kindOf(resolved) || previousKind
      const previousEncryption = olds?.encryption?.kmsKey ?? output?.encryption?.kmsKey
      const nextEncryption = resolved.encryption?.kmsKey ?? previousEncryption
      const previousAwsRegion = olds?.aws?.awsRegion ?? output?.aws?.awsRegion
      const nextAwsRegion = resolved.aws?.awsRegion ?? previousAwsRegion
      const previousAzureLocation = olds?.azure?.azureLocation ?? output?.azure?.azureLocation
      const nextAzureLocation = resolved.azure?.azureLocation ?? previousAzureLocation
      const previousSubscription = olds?.azure?.subscriptionId ?? output?.azure?.subscriptionId
      const nextSubscription = resolved.azure?.subscriptionId ?? previousSubscription
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.sourceId ?? output?.sourceId,
            nextId: resolved.sourceId ?? olds?.sourceId ?? output?.sourceId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            extra: previousKind !== nextKind
              || previousEncryption !== nextEncryption
              || previousAwsRegion !== nextAwsRegion
              || previousAzureLocation !== nextAzureLocation
              || previousSubscription !== nextSubscription,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const sourceId = try toPhysicalId(id, olds?.sourceId, output?.sourceId, "source")
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const name = output?.name ?? resourceName(env.project, location, sourceId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listOwned(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const sourceId = try toPhysicalId(id, news.sourceId, output?.sourceId, "source")
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const name = resourceName(env.project, location, sourceId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = vm
          .createProjectsLocationsSources({
            parent: locationParent(env.project, location),
            sourceId,
            body: {
              description: news.description,
              labels: desiredLabels,
              encryption: news.encryption,
              aws: news.aws,
              azure: news.azure,
              vmware: news.vmware,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          // ALREADY_EXISTS (6): a concurrent create won the race.
          waitForOperation(created) catch effect (error) => match (error) {
            when { _tag: "GCP.OperationFailed" }: try (error.code === 6 ? Effect.void : throw error);
            default: throw error;
          }
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = diffLabels(observedLabels, desiredLabels)
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const descriptionChanged = (current.description ?? "") !== (news.description ?? "")
      const awsChanged = news.aws !== undefined
        && ((try Effect.orDie(
              Effect.try({ try: fingerprint.bind(undefined, publicAws(current.aws)), catch: (e) => e }),
            ))
            !== (try Effect.orDie(Effect.try({
              try: fingerprint.bind(undefined, publicAws(news.aws)),
              catch: (e) => e,
            })))
          || news.aws.accessKeyCreds?.secretAccessKey !== undefined)
      const azureChanged = news.azure !== undefined
        && ((try Effect.orDie(
              Effect.try({ try: fingerprint.bind(undefined, publicAzure(current.azure)), catch: (e) => e }),
            ))
            !== (try Effect.orDie(Effect.try({
              try: fingerprint.bind(undefined, publicAzure(news.azure)),
              catch: (e) => e,
            })))
          || news.azure.clientSecretCreds?.clientSecret !== undefined)
      const vmwareChanged = news.vmware !== undefined
        && ((try Effect.orDie(
              Effect.try({ try: fingerprint.bind(undefined, publicVmware(current.vmware)), catch: (e) => e }),
            ))
            !== (try Effect.orDie(
              Effect.try({ try: fingerprint.bind(undefined, publicVmware(news.vmware)), catch: (e) => e }),
            ))
          || news.vmware.password !== undefined)
      const mask = fieldMask([
        labelsChanged && "labels",
        descriptionChanged && "description",
        awsChanged && "aws",
        azureChanged && "azure",
        vmwareChanged && "vmware",
      ])

      if (mask.length > 0) {
        const operation = try vm.patchProjectsLocationsSources({
          name: current.name ?? name,
          updateMask: mask,
          body: {
            name: current.name ?? name,
            description: news.description,
            labels: desiredLabels,
            aws: news.aws,
            azure: news.azure,
            vmware: news.vmware,
          },
        })
        try waitForOperation(operation)
        current = try waitUntilExists(getByName(current.name ?? name), current.name ?? name)
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (vm.deleteProjectsLocationsSources({ name: output.name })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        // NOT_FOUND (5): already gone.
        waitForOperation(operation) catch effect (error) => match (error) {
          when { _tag: "GCP.OperationFailed" }: try (error.code === 5 ? Effect.void : throw error);
          default: throw error;
        }
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
