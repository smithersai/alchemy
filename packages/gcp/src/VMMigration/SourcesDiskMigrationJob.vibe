import * as vm from "@distilled.cloud/gcp/vmmigration_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  fieldMask,
  fingerprint,
  forEachSource,
  hasAlchemyLabelMap,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  ResourceNotResolved,
  sourceOf,
  toPhysicalId,
  userLabels,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type DiskMigrationJobTargetDetails = vm.DiskMigrationJobTargetDetails
export type AwsSourceDiskDetails = vm.AwsSourceDiskDetails
export type DiskMigrationJobState = vm.DiskMigrationJobStateEnum | (string & {})

export type SourcesDiskMigrationJobProps = {
  /**
   * Parent source. Full name
   * `projects/{project}/locations/{location}/sources/{source}` or the
   * source id (combined with `location`). Immutable — changing it
   * replaces the job.
   */
  source: string
  /**
   * Region used when `source` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * Disk migration job id. If omitted, a unique RFC1035 name is
   * generated. Immutable — changing it replaces the job.
   */
  diskMigrationJobId?: string
  /**
   * Target disk in Compute Engine. Alchemy ownership labels are merged
   * into `targetDetails.labels` (the job itself has no labels field).
   */
  targetDetails: DiskMigrationJobTargetDetails
  /**
   * Unattached AWS source disk. Immutable volume id — changing it
   * replaces the job.
   */
  awsSourceDiskDetails?: AwsSourceDiskDetails
}

export type SourcesDiskMigrationJob = Resource<
  "GCP.VMMigration.SourcesDiskMigrationJob",
  SourcesDiskMigrationJobProps,
  {
    /** Full resource name. */
    name: string
    /** Disk migration job id (last path segment). */
    diskMigrationJobId: string
    /** Parent source resource name. */
    source: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Target disk details with Alchemy labels stripped. */
    targetDetails: DiskMigrationJobTargetDetails | undefined
    /** AWS source disk details. */
    awsSourceDiskDetails: AwsSourceDiskDetails | undefined
    /** Job state. */
    state: string | undefined
    /** Progress steps. */
    steps: vm.DiskMigrationStepList | undefined
    /** Errors that led to a failed state. */
    errors: vm.StatusList | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A VM Migration disk migration job that copies an unattached source
 * disk into a Compute Engine persistent disk.
 *
 * The job has no labels field — Alchemy stamps ownership into
 * `targetDetails.labels` so `list` / nuke can find them. Source, job
 * id, and AWS volume id are immutable. Target details update in place.
 *
 * ### Creating a Disk Migration Job
 * **Example:** AWS volume to Compute Engine
 * ```typescript
 * const job = yield* GCP.VMMigration.SourcesDiskMigrationJob("Boot", {
 *   source: source.name,
 *   awsSourceDiskDetails: { volumeId: "vol-123" },
 *   targetDetails: {
 *     targetProject: target.name,
 *     targetDisk: {
 *       zone: "projects/my-project/locations/us-central1-a",
 *       diskType: "COMPUTE_ENGINE_DISK_TYPE_STANDARD",
 *       diskId: "imported-boot",
 *     },
 *   },
 * });
 * ```
 *
 * @resource
 * @category VMMigration
 */
export const SourcesDiskMigrationJob = Resource<SourcesDiskMigrationJob>(
  "GCP.VMMigration.SourcesDiskMigrationJob",
)

const resourceName = (source: string, diskMigrationJobId: string): infer _ =>
  `${source}/diskMigrationJobs/${diskMigrationJobId}`

const stampTarget = (
  target: DiskMigrationJobTargetDetails,
  ownership: Record<string, string>,
): DiskMigrationJobTargetDetails => ({
  ...target,
  labels: {
    ...toLabels(tagRecord(target.labels)),
    ...ownership,
  },
})

const stripTarget = (
  target: DiskMigrationJobTargetDetails | undefined,
): DiskMigrationJobTargetDetails | undefined => {
  if (target === undefined) return undefined
  return {
    ...target,
    labels: userLabels(target.labels),
  }
}

const toAttrs = (job: vm.DiskMigrationJob, project: string, region: string): infer _ => {
  const name = job.name ?? ""
  const parsed = parseName(name, "diskMigrationJobs", region)
  return {
    name,
    diskMigrationJobId: parsed.id,
    source: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    targetDetails: stripTarget(job.targetDetails),
    awsSourceDiskDetails: job.awsSourceDiskDetails,
    state: job.state,
    steps: job.steps,
    errors: job.errors,
    createTime: job.createTime,
    updateTime: job.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : vm
  .getProjectsLocationsSourcesDiskMigrationJobs({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listChildren = effect (parent: string) =>
  collectPages(
    vm.listProjectsLocationsSourcesDiskMigrationJobs.pages({
      parent,
      pageSize: 1000,
    }),
    (page) => page.diskMigrationJobs,
  ) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as vm.DiskMigrationJob[]; default: throw e; }

export const SourcesDiskMigrationJobProvider = (): infer _ =>
  Provider.succeed(SourcesDiskMigrationJob, {
    stables: ["name", "diskMigrationJobId", "source", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousVolume = olds?.awsSourceDiskDetails?.volumeId ?? output?.awsSourceDiskDetails?.volumeId
      const nextVolume = resolved.awsSourceDiskDetails?.volumeId ?? previousVolume
      const previousSource = olds?.source ?? output?.source
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.diskMigrationJobId ?? output?.diskMigrationJobId,
            nextId: resolved.diskMigrationJobId ?? olds?.diskMigrationJobId ?? output?.diskMigrationJobId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            previousParent: previousSource,
            nextParent: resolved.source ?? previousSource,
            extra: previousVolume !== nextVolume,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const diskMigrationJobId = try toPhysicalId(
        id,
        olds?.diskMigrationJobId,
        output?.diskMigrationJobId,
        "diskmigration",
      )
      const source = olds?.source !== undefined
        ? try Effect.orDie(Effect.try({ try: () => sourceOf(olds.source, env.project, location), catch: (e) => e }))
        : (output?.source ?? "")
      const name = output?.name ?? (source.length > 0 ? resourceName(source, diskMigrationJobId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.targetDetails?.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try forEachSource(env.project, listChildren, env.region)
      return items
        .filter((item) => hasAlchemyLabelMap(item.targetDetails?.labels))
        .map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const source = try Effect.orDie(
        Effect.try({ try: () => sourceOf(news.source, env.project, location), catch: (e) => e }),
      )
      const diskMigrationJobId = try toPhysicalId(
        id,
        news.diskMigrationJobId,
        output?.diskMigrationJobId,
        "diskmigration",
      )
      const name = resourceName(source, diskMigrationJobId)
      const ownership = try createInternalLabels(id)
      const targetDetails = stampTarget(news.targetDetails, ownership)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = vm
          .createProjectsLocationsSourcesDiskMigrationJobs({
            parent: source,
            diskMigrationJobId,
            body: {
              targetDetails,
              awsSourceDiskDetails: news.awsSourceDiskDetails,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          // ALREADY_EXISTS (6): a concurrent create won the race.
          waitForOperation(created) catch effect (error) => match (error) {
            when { _tag: "GCP.OperationFailed" }: try (error.code === 6 ? Effect.void : throw error);
            default: throw error;
          }
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.targetDetails?.labels)
      const desiredLabels = try Effect.orDie(
        Effect.try({ try: () => tagRecord(targetDetails.labels), catch: (e) => e }),
      )
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const targetChanged = (try Effect.orDie(Effect.try({
        try: fingerprint.bind(undefined, {
          ...current.targetDetails,
          labels: undefined,
        }),
        catch: (e) => e,
      })))
        !== (try Effect.orDie(Effect.try({
          try: () =>
            fingerprint({
              ...targetDetails,
              labels: undefined,
            }),
          catch: (e) => e,
        })))
      const mask = try Effect.orDie(
        Effect.try({ try: () => fieldMask([(labelsChanged || targetChanged) && "targetDetails"]), catch: (e) => e }),
      )

      if (mask.length > 0) {
        const operation = try vm.patchProjectsLocationsSourcesDiskMigrationJobs({
          name: current.name ?? name,
          updateMask: mask,
          body: {
            name: current.name ?? name,
            targetDetails,
          },
        })
        try waitForOperation(operation)
        current = try waitUntilExists(getByName(current.name ?? name), current.name ?? name)
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (vm
          .deleteProjectsLocationsSourcesDiskMigrationJobs({
            name: output.name,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        // NOT_FOUND (5): already gone.
        waitForOperation(operation) catch effect (error) => match (error) {
          when { _tag: "GCP.OperationFailed" }: try (error.code === 5 ? Effect.void : throw error);
          default: throw error;
        }
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
