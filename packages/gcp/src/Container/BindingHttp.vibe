import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.vibe"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.vibe"
import type { Cluster } from "./Cluster.vibe"
import type { ClustersNodePool } from "./ClustersNodePool.vibe"
import type { NodePool } from "./NodePool.vibe"

/**
 * Shared HTTP scaffolding for GKE cluster and node pool bindings.
 * NOT exported from index.ts.
 */
export const makeContainerClusterHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (cluster: Cluster) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${cluster})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, cluster.name), catch: (e) => e }))],
      })
    }
    const name = try cluster.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${cluster.LogicalId})`,
      )
  }
}

export const makeContainerNodePoolHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (nodePool: NodePool) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${nodePool})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, nodePool.name), catch: (e) => e }))],
      })
    }
    const name = try nodePool.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${nodePool.LogicalId})`,
      )
  }
}

export const makeContainerClustersNodePoolHttpBinding = effect <
  I extends {
    projectId: string
    zone: string
    clusterId: string
    nodePoolId: string
    name?: string
  },
  A,
  E,
>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (nodePool: ClustersNodePool) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${nodePool})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, nodePool.name), catch: (e) => e }))],
      })
    }
    const name = try nodePool.name.asEffect()
    const project = try nodePool.project.asEffect()
    const zone = try nodePool.zone.asEffect()
    const clusterId = try nodePool.clusterId.asEffect()
    const nodePoolId = try nodePool.nodePoolId.asEffect()
    return effect (
      request?: Omit<I, "projectId" | "zone" | "clusterId" | "nodePoolId" | "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            projectId: try project,
            zone: try zone,
            clusterId: try clusterId,
            nodePoolId: try nodePoolId,
            name: try name,
          } as I)
        },
        `${options.tag}(${nodePool.LogicalId})`,
      )
  }
}
