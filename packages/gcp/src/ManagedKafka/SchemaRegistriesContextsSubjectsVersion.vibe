import * as kafka from "@distilled.cloud/gcp/managedkafka_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  expandParent,
  getContextSchemaVersion,
  hasAlchemyLabelMap,
  listSchemaRegistries,
  normalizeLocation,
  OWNERSHIP_SUBJECT,
  parseHttpJson,
  parseName,
  replaceOnIdentity,
  retryTransient,
  schemaRegistryOwnership,
  subjectParent,
  toSubjectId,
  versionName,
} from "./internal.ts"

export type ContextSchemaReference = {
  /** Name of the referenced schema. */
  name?: string
  /** Subject of the referenced schema. */
  subject?: string
  /** Version of the referenced schema. */
  version?: number
}

export type SchemaRegistriesContextsSubjectsVersionProps = {
  /**
   * Parent schema registry. Full name
   * `projects/{project}/locations/{location}/schemaRegistries/{id}` or
   * the registry id (combined with `location`). Immutable — changing it
   * replaces the version.
   */
  schemaRegistry: string
  /**
   * Schema context. Immutable — changing it replaces the version.
   */
  context: string
  /**
   * Region used when `schemaRegistry` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Subject name. If omitted, a unique name is generated. Immutable —
   * changing it replaces the version.
   */
  subject?: string
  /**
   * Version number. If omitted, the server assigns the next id.
   * Immutable — changing it replaces the version.
   */
  version?: number
  /**
   * Schema payload. Immutable — changing it replaces the version.
   */
  schema: string
  /**
   * Schema type.
   * @default "AVRO"
   */
  schemaType?: kafka.CreateVersionRequestSchemaTypeEnum | (string & {})
  /**
   * Normalize the schema before storing.
   * @default false
   */
  normalize?: boolean
  /**
   * Explicit schema id. Must not collide with a different schema.
   */
  id?: number
  /**
   * Schema references.
   */
  references?: ContextSchemaReference[]
}

export type SchemaRegistriesContextsSubjectsVersion = Resource<
  "GCP.ManagedKafka.SchemaRegistriesContextsSubjectsVersion",
  SchemaRegistriesContextsSubjectsVersionProps,
  {
    /** Full resource name `.../contexts/{context}/subjects/{subject}/versions/{version}`. */
    name: string
    /** Parent schema registry resource name. */
    schemaRegistry: string
    /** Context id. */
    context: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Subject name. */
    subject: string
    /** Version number. */
    version: number
    /** Schema id. */
    schemaId: number | undefined
    /** Schema payload. */
    schema: string | undefined
    /** Schema type. */
    schemaType: string | undefined
    /** Schema references. */
    references: ContextSchemaReference[]
  },
  never,
  Providers
>

/**
 * A schema version under a subject in a named context of a Managed Kafka
 * schema registry.
 *
 * Versions are immutable. Changing context, subject, registry, schema,
 * type, or version replaces the resource.
 *
 * ### Creating a Version
 * **Example:** Avro record in a context
 * ```typescript
 * const version =
 *   yield* GCP.ManagedKafka.SchemaRegistriesContextsSubjectsVersion(
 *     "OrderSchema",
 *     {
 *       schemaRegistry: registry.name,
 *       context: "prod",
 *       subject: "orders",
 *       schemaType: "AVRO",
 *       schema: JSON.stringify({
 *         type: "record",
 *         name: "Order",
 *         fields: [{ name: "id", type: "string" }],
 *       }),
 *     },
 *   );
 * ```
 *
 * @resource
 * @category ManagedKafka
 */
export const SchemaRegistriesContextsSubjectsVersion = Resource<SchemaRegistriesContextsSubjectsVersion>(
  "GCP.ManagedKafka.SchemaRegistriesContextsSubjectsVersion",
)

// @vibelang-diagnostics-next-line EK4830:off
export class SchemaRegistriesContextsSubjectsVersionNotResolved extends Data.TaggedError(
  "GCP.ManagedKafka.SchemaRegistriesContextsSubjectsVersionNotResolved",
)<{
  resourceName: string
}> {}

const registryOf = (value: string, project: string, location: string): infer _ =>
  expandParent(value, project, location, "schemaRegistries")

/**
 * Context-scoped subjects come back qualified as `:.{context}:{subject}`;
 * resource paths and attributes use the bare subject.
 */
const unqualifySubject = (subject: string | undefined, context: string): infer _ =>
  subject?.replace(`:.${context}:`, "")

const toAttrs = (
  version: kafka.SchemaVersion,
  schemaRegistry: string,
  context: string,
  project: string,
  location: string,
  name: string,
): infer _ => {
  const parsed = parseName(schemaRegistry, "schemaRegistries")
  return {
    name,
    schemaRegistry,
    context,
    project: parsed.project || project,
    location: parsed.location || location,
    subject: unqualifySubject(version.subject, context) ?? "",
    version: version.version ?? 0,
    schemaId: version.id,
    schema: version.schema,
    schemaType: version.schemaType,
    references: version.references ?? [],
  }
}

const parseVersionList = (value: unknown): number[] => {
  if (!Array.isArray(value)) return []
  return value
    .map((item) => {
      if (typeof item === "number") return item
      if (typeof item === "string") return Number(item)
      if (item && typeof item === "object" && "version" in item) {
        return Number((item as { version?: unknown }).version)
      }
      return Number.NaN
    })
    .filter((item) => Number.isFinite(item))
}

export const SchemaRegistriesContextsSubjectsVersionProvider = (): infer _ =>
  Provider.succeed(SchemaRegistriesContextsSubjectsVersion, {
    stables: [
      "name",
      "schemaRegistry",
      "context",
      "project",
      "location",
      "subject",
      "version",
      "schemaId",
    ],

    diff: effect ({ news, olds, output }) => {
      const resolved_ = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved_ === undefined) return undefined
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({
          try: () => normalizeLocation(resolved_.location ?? output?.location, env.region),
          catch: (e) => e,
        }),
      )
      const schemaChanged = (olds?.schema ?? output?.schema ?? "") !== resolved_.schema
        || (olds?.schemaType ?? output?.schemaType ?? "")
          !== (resolved_.schemaType ?? olds?.schemaType ?? output?.schemaType ?? "")
        || (olds?.context ?? output?.context ?? "") !== resolved_.context
      const input = {
        previousId: olds?.subject !== undefined && olds.version !== undefined
          ? `${olds.context}/${olds.subject}/${olds.version}`
          : output !== undefined
          ? `${output.context}/${output.subject}/${output.version}`
          : undefined,
        nextId: resolved_.subject !== undefined && resolved_.version !== undefined
          ? `${resolved_.context}/${resolved_.subject}/${resolved_.version}`
          : undefined,
        previousParent: olds?.schemaRegistry ?? output?.schemaRegistry,
        nextParent: registryOf(resolved_.schemaRegistry, env.project, location),
        extra: schemaChanged,
      }
      return try Effect.orDie(Effect.try({ try: () => replaceOnIdentity(input), catch: (e) => e }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const subject = try toSubjectId(id, olds?.subject, output?.subject)
      const context = olds?.context ?? output?.context ?? ""
      const schemaRegistry = olds?.schemaRegistry !== undefined
        ? registryOf(olds.schemaRegistry, env.project, location)
        : (output?.schemaRegistry ?? "")
      const version = olds?.version ?? output?.version ?? "latest"
      const name = output?.name
        ?? (schemaRegistry.length > 0 && context.length > 0
          ? try Effect.orDie(
            Effect.try({
              try: () => versionName(subjectParent(schemaRegistry, subject, context), version),
              catch: (e) => e,
            }),
          )
          : "")
      const existing = try getContextSchemaVersion(name)
      if (existing === undefined) return undefined
      const resolvedName = try Effect.orDie(Effect.try({
        try: () =>
          versionName(
            subjectParent(schemaRegistry, existing.subject ?? subject, context),
            existing.version ?? version,
          ),
        catch: (e) => e,
      }))
      const attrs = toAttrs(existing, schemaRegistry, context, env.project, location, resolvedName)
      return output !== undefined || olds !== undefined
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const registries = try listSchemaRegistries(env.project, env.region)
      const owned = try Effect.forEach(
        registries.filter((registry) => (registry.name ?? "").length > 0),
        effect (registry) => (hasAlchemyLabelMap(try schemaRegistryOwnership(registry.name!)) ? registry : undefined),
        { concurrency: 4 },
      )
      const versions = try Effect.forEach(
        owned.filter((registry): registry is kafka.SchemaRegistry => registry !== undefined),
        effect (registry) => {
          const contexts = (registry.contexts ?? []).filter(
            (context) => context.length > 0 && context !== ".",
          )
          return try Effect.forEach(
            contexts,
            effect (context) => {
              const contextName = context.includes("/")
                ? context
                : `${registry.name}/contexts/${context}`
              const body = kafka
                .listProjectsLocationsSchemaRegistriesContextsSubjects({
                  parent: contextName,
                }) catch effect (e) => match (e) {
                  when { _tag: "NotFound" } or { _tag: "SchemaRegistryRequiresCluster" }: {};
                  default: throw e;
                }
              const subjects = (try parseHttpJson(body)) as unknown
              const names = Array.isArray(subjects)
                ? subjects.filter(
                  (item): item is string => typeof item === "string" && item !== OWNERSHIP_SUBJECT,
                )
                : []
              const contextId = (try Effect.orDie(Effect.try({
                try: () => parseName(contextName, "contexts"),
                catch: (e) => e,
              }))).id
              return try Effect.forEach(
                names,
                effect (subject) => {
                  const listed = kafka
                    .listProjectsLocationsSchemaRegistriesContextsSubjectsVersions({
                      parent: subjectParent(registry.name!, subject, contextId),
                    }) catch effect (e) => match (e) {
                      when { _tag: "NotFound" } or { _tag: "SchemaRegistryRequiresCluster" }: {};
                      default: throw e;
                    }
                  const ids = parseVersionList(try parseHttpJson(listed))
                  return try Effect.forEach(
                    ids,
                    effect (version) =>
                      try effect {
                        const item = try getContextSchemaVersion(
                          versionName(
                            subjectParent(registry.name!, subject, contextId),
                            version,
                          ),
                        )
                        return item
                          ? toAttrs(
                            item,
                            registry.name!,
                            contextId,
                            env.project,
                            (try Effect.orDie(
                              Effect.try({ try: () => parseName(registry.name!, "schemaRegistries"), catch: (e) => e }),
                            )).location,
                            versionName(
                              subjectParent(registry.name!, subject, contextId),
                              version,
                            ),
                          )
                          : undefined
                      },
                    { concurrency: 4 },
                  )
                },
                { concurrency: 4 },
              )
            },
            { concurrency: 2 },
          )
        },
        { concurrency: 2 },
      )
      return versions
        .flat(3)
        .filter((item): item is NonNullable<typeof item> => item !== undefined)
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const schemaRegistry = registryOf(news.schemaRegistry, env.project, location)
      const subject = try toSubjectId(id, news.subject, output?.subject)
      const context = news.context
      const parent = try Effect.orDie(
        Effect.try({ try: () => subjectParent(schemaRegistry, subject, context), catch: (e) => e }),
      )
      const versionHint = news.version ?? output?.version
      const name = output?.name
        ?? (try Effect.orDie(Effect.try({ try: () => versionName(parent, versionHint ?? "latest"), catch: (e) => e })))

      let current = try getContextSchemaVersion(name)

      if (current === undefined) {
        const created = try retryTransient(
          effect {
            return kafka
              .createProjectsLocationsSchemaRegistriesContextsSubjectsVersions({
                parent,
                body: {
                  schemaType: news.schemaType,
                  version: news.version,
                  normalize: news.normalize,
                  id: news.id,
                  schema: news.schema,
                  references: news.references,
                },
              }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
          },
        )
        const lookedUp = kafka
          .lookupVersionProjectsLocationsSchemaRegistriesContextsSubjects({
            parent,
            body: {
              schema: news.schema,
              schemaType: news.schemaType,
              normalize: news.normalize,
              references: news.references,
            },
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
        current = lookedUp
          ?? (try getContextSchemaVersion(
            try Effect.orDie(
              Effect.try({ try: () => versionName(parent, news.version ?? "latest"), catch: (e) => e }),
            ),
          ))
        void created
      }

      if (current === undefined) {
        throw new SchemaRegistriesContextsSubjectsVersionNotResolved({
          resourceName: name,
        })
      }

      const subject2 = unqualifySubject(current.subject, context) ?? subject
      const parent2 = try Effect.orDie(Effect.try({
        try: () =>
          subjectParent(
            schemaRegistry,
            subject2,
            context,
          ),
        catch: (e) => e,
      }))
      const resolved = try Effect.orDie(Effect.try({
        try: () =>
          versionName(
            parent2,
            current.version ?? versionHint ?? "latest",
          ),
        catch: (e) => e,
      }))
      return toAttrs(current, schemaRegistry, context, env.project, location, resolved)
    },

    delete: effect ({ output }) => {
      kafka
        .deleteProjectsLocationsSchemaRegistriesContextsSubjectsVersions({
          name: output.name,
          permanent: false,
        }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "SchemaRegistryRequiresCluster" } or { _tag: "SchemaRegistryPathNotFound" }:
            try Effect.void;
          default: throw e;
        }
      kafka
        .deleteProjectsLocationsSchemaRegistriesContextsSubjectsVersions({
          name: output.name,
          permanent: true,
        }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "SchemaRegistryRequiresCluster" } or { _tag: "SchemaRegistryPathNotFound" }:
            try Effect.void;
          default: throw e;
        }
    },
  })
