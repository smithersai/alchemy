import * as kafka from "@distilled.cloud/gcp/managedkafka_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  getSchemaRegistry,
  hasAlchemyLabelMap,
  hasSchemaRegistryOwnership,
  listSchemaRegistries,
  locationParent,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  retryTransient,
  schemaRegistryIdOf,
  schemaRegistryOwnership,
  stampSchemaRegistryOwnership,
  toSchemaRegistryId,
} from "./internal.ts"

export type SchemaRegistryProps = {
  /**
   * Schema registry id. Letters, numbers, and underscores; max 63
   * characters; must not start with a number. If omitted, a unique id is
   * generated. Immutable — changing it replaces the registry.
   */
  schemaRegistryId?: string
  /**
   * Region (`us-central1`, …). Immutable.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
}

export type SchemaRegistry = Resource<
  "GCP.ManagedKafka.SchemaRegistry",
  SchemaRegistryProps,
  {
    /** Full resource name `.../schemaRegistries/{schemaRegistry}`. */
    name: string
    /** Schema registry id. */
    schemaRegistryId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Contexts currently present. */
    contexts: string[]
  },
  never,
  Providers
>

/**
 * A Managed Kafka schema registry instance.
 *
 * Schema registries have no labels field, so Alchemy stamps ownership on
 * a reserved `alchemy_ownership` subject. Name and location are identity
 * — changing either replaces the registry.
 *
 * ### Creating a Schema Registry
 * **Example:** Generated name
 * ```typescript
 * const registry = yield* GCP.ManagedKafka.SchemaRegistry("Schemas", {});
 * ```
 *
 * **Example:** Explicit id
 * ```typescript
 * const registry = yield* GCP.ManagedKafka.SchemaRegistry("Schemas", {
 *   schemaRegistryId: "app_schemas",
 *   location: "us-central1",
 * });
 * ```
 *
 * @resource
 * @category ManagedKafka
 */
export const SchemaRegistry = Resource<SchemaRegistry>("GCP.ManagedKafka.SchemaRegistry")

// @vibelang-diagnostics-next-line EK4830:off
export class SchemaRegistryNotResolved extends Data.TaggedError(
  "GCP.ManagedKafka.SchemaRegistryNotResolved",
)<{
  resourceName: string
}> {}

const resourceName = (project: string, location: string, schemaRegistryId: string): infer _ =>
  `projects/${project}/locations/${location}/schemaRegistries/${schemaRegistryId}`

const toAttrs = (registry: kafka.SchemaRegistry, project: string): infer _ => {
  const name = registry.name ?? ""
  const parsed = parseName(name, "schemaRegistries")
  return {
    name,
    schemaRegistryId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    contexts: registry.contexts ?? [],
  }
}

export const SchemaRegistryProvider = (): infer _ =>
  Provider.succeed(SchemaRegistry, {
    stables: ["name", "schemaRegistryId", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const input = {
        previousId: olds?.schemaRegistryId ?? output?.schemaRegistryId,
        nextId: resolved.schemaRegistryId
          ? schemaRegistryIdOf(resolved.schemaRegistryId)
          : (olds?.schemaRegistryId ?? output?.schemaRegistryId),
        previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
        nextLocation: normalizeLocation(resolved.location ?? output?.location, env.region),
      }
      return try Effect.orDie(Effect.try({ try: () => replaceOnIdentity(input), catch: (e) => e }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const schemaRegistryId = try toSchemaRegistryId(
        id,
        olds?.schemaRegistryId,
        output?.schemaRegistryId,
      )
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const name = output?.name ?? resourceName(env.project, location, schemaRegistryId)
      const existing = try getSchemaRegistry(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasSchemaRegistryOwnership(id, name))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const registries = try listSchemaRegistries(env.project, env.region)
      const owned = try Effect.forEach(
        registries.filter((registry) => (registry.name ?? "").length > 0),
        effect (registry) =>
          hasAlchemyLabelMap(try schemaRegistryOwnership(registry.name!)) ? toAttrs(registry, env.project) : undefined,
        { concurrency: 4 },
      )
      return owned.filter((attrs): attrs is NonNullable<typeof attrs> => attrs !== undefined)
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const schemaRegistryId = try toSchemaRegistryId(
        id,
        news.schemaRegistryId,
        output?.schemaRegistryId,
      )
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const name = output?.name ?? resourceName(env.project, location, schemaRegistryId)
      const labels = try createInternalLabels(id)

      let current = try getSchemaRegistry(name)

      if (current === undefined) {
        const created = try retryTransient(
          effect {
            return kafka
              .createProjectsLocationsSchemaRegistries({
                parent: locationParent(env.project, location),
                body: {
                  schemaRegistryId,
                  schemaRegistry: {},
                },
              }) catch effect (e) => match (e) {
                when { _tag: "Conflict" }: try getSchemaRegistry(name);
                default: throw e;
              }
          },
        )
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new SchemaRegistryNotResolved({ resourceName: name })
      }

      try stampSchemaRegistryOwnership(current.name ?? name, labels)
      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      kafka
        .deleteProjectsLocationsSchemaRegistries({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "SchemaRegistryRequiresCluster" }: try Effect.void;
          default: throw e;
        }
    },
  })
