import * as cci from "@distilled.cloud/gcp/contactcenterinsights_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import { waitForOperation } from "./operations.vibe"
import {
  encodeOwnershipLine,
  hasOwnershipMarker,
  jsonEqual,
  lastSegment,
  locationOf,
  locationParent,
  normalizeLocation,
  ownedByAlchemy,
  parseOwnership,
  toResourceId,
  updateMaskOf,
} from "./ownership.vibe"

export type QaQuestionTagProps = {
  /**
   * Question tag id (the `{qa_question_tag}` segment of
   * `projects/{project}/locations/{location}/qaQuestionTags/{qa_question_tag}`).
   * If omitted, a unique id is generated. Must match `^[a-z0-9-]{4,64}$`.
   * Immutable — changing it replaces the tag.
   */
  qaQuestionTagId?: string
  /**
   * Location (`us-central1`, …). Immutable — changing it replaces the
   * tag. `US-CENTRAL1` is accepted and normalized to `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Display name. Question tags have no labels field, so Alchemy
   * ownership is stored in a `[alchemy …]` prefix and stripped from
   * attributes.
   */
  displayName?: string
  /**
   * Scorecard question resource names this tag applies to.
   */
  qaQuestionIds?: string[]
}

export type QaQuestionTag = Resource<
  "GCP.ContactCenterInsights.QaQuestionTag",
  QaQuestionTagProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/qaQuestionTags/{qa_question_tag}`. */
    name: string
    /** Question tag id (last path segment). */
    qaQuestionTagId: string
    /** Location id. */
    location: string
    /** Project id. */
    project: string
    /** User display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** Question resource names this tag applies to. */
    qaQuestionIds: string[]
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Contact Center AI Insights QA question tag used to categorize
 * questions across scorecards.
 *
 * Question tags have no labels field — Alchemy stamps ownership into the
 * display name. Location and id are immutable. Display name and linked
 * question ids update in place. Patch and delete are long-running.
 *
 * ### Creating a QA Question Tag
 * **Example:** Billing tag
 * ```typescript
 * const tag = yield* GCP.ContactCenterInsights.QaQuestionTag("Billing", {
 *   displayName: "billing",
 * });
 * ```
 *
 * @resource
 * @category ContactCenterInsights
 */
export const QaQuestionTag = Resource<QaQuestionTag>("GCP.ContactCenterInsights.QaQuestionTag")

// @vibelang-diagnostics-next-line EK4830:off
export class QaQuestionTagNotResolved extends Data.TaggedError(
  "GCP.ContactCenterInsights.QaQuestionTagNotResolved",
)<{
  resourceName: string
}> {}

const resourceName = (project: string, location: string, qaQuestionTagId: string): infer _ =>
  `${locationParent(project, location)}/qaQuestionTags/${qaQuestionTagId}`

const toAttrs = (tag: cci.GoogleCloudContactcenterinsightsV1QaQuestionTag, project: string): infer _ => {
  const name = tag.name ?? ""
  const parsed = parseOwnership(tag.displayName)
  return {
    name,
    qaQuestionTagId: lastSegment(name),
    location: locationOf(name),
    project,
    displayName: parsed.text,
    qaQuestionIds: tag.qaQuestionIds ?? [],
    createTime: tag.createTime,
    updateTime: tag.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? undefined : cci
  .getProjectsLocationsQaQuestionTags({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string) =>
  (effect {
    return (((try cci.listProjectsLocationsQaQuestionTags({ parent })).qaQuestionTags ?? [])
      .filter((tag) => hasOwnershipMarker(tag.displayName))
      .map((tag) => toAttrs(tag, project)))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [];
    default: throw e;
  }

const findByDisplayName = effect (parent: string, displayName: string) =>
  (effect {
    return (((try cci.listProjectsLocationsQaQuestionTags({ parent })).qaQuestionTags ?? []).find((tag) =>
      tag.displayName === displayName
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined; default: throw e; }

const waitAndGet = effect (name: string, operation: cci.GoogleLongrunningOperation) => {
  if (operation.name !== undefined && operation.name.length > 0) {
    try waitForOperation(operation)
  }
  return try getByName(name)
}

export const QaQuestionTagProvider = (): infer _ =>
  Provider.succeed(QaQuestionTag, {
    stables: ["name", "qaQuestionTagId", "location", "project", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousLocation = olds?.location ?? output?.location
      if (
        previousLocation !== undefined
        && resolved.location !== undefined
        && normalizeLocation(previousLocation) !== normalizeLocation(resolved.location)
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.qaQuestionTagId ?? output?.qaQuestionTagId
      if (
        previousId !== undefined
        && resolved.qaQuestionTagId !== undefined
        && resolved.qaQuestionTagId !== previousId
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const qaQuestionTagId = try toResourceId(
        id,
        olds?.qaQuestionTagId,
        output?.qaQuestionTagId,
      )
      const location = normalizeLocation(olds?.location ?? output?.location ?? env.region)
      const name = output?.name ?? resourceName(env.project, location, qaQuestionTagId)
      let existing = try getByName(name)
      if (existing === undefined && output?.name === undefined) {
        const ownership = try createInternalLabels(id)
        existing = try findByDisplayName(
          locationParent(env.project, location),
          encodeOwnershipLine(ownership, olds?.displayName),
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      return try listAt(locationParent(env.project, env.region), env.project)
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(news.location ?? output?.location ?? env.region)
      const parent = locationParent(env.project, location)
      const qaQuestionTagId = try toResourceId(
        id,
        news.qaQuestionTagId,
        output?.qaQuestionTagId,
      )
      const name = resourceName(env.project, location, qaQuestionTagId)
      const ownership = try createInternalLabels(id)
      const displayName = encodeOwnershipLine(ownership, news.displayName)
      const qaQuestionIds = news.qaQuestionIds ?? []

      let current = try getByName(output?.name ?? name)
      if (current === undefined) {
        current = try findByDisplayName(parent, displayName)
      }

      if (current === undefined) {
        const created = cci
          .createProjectsLocationsQaQuestionTags({
            parent,
            qaQuestionTagId,
            body: {
              displayName,
              qaQuestionIds: qaQuestionIds.length > 0 ? qaQuestionIds : undefined,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? (try findByDisplayName(parent, displayName))
      }

      if (current === undefined) {
        throw new QaQuestionTagNotResolved({ resourceName: name })
      }

      const currentName = current.name ?? name
      const displayChanged = (current.displayName ?? "") !== displayName
      const questionsChanged = !jsonEqual(current.qaQuestionIds ?? [], qaQuestionIds)

      if (displayChanged || questionsChanged) {
        const operation = try cci.patchProjectsLocationsQaQuestionTags({
          name: currentName,
          updateMask: updateMaskOf(
            displayChanged ? "qa_question_tag_name" : undefined,
            questionsChanged ? "qa_question_ids" : undefined,
          ),
          body: {
            name: currentName,
            displayName,
            qaQuestionIds,
          },
        })
        current = (try waitAndGet(currentName, operation)) ?? current
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const operation = cci
        .deleteProjectsLocationsQaQuestionTags({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: undefined;
          default: throw e;
        }
      if (operation !== undefined && (operation.name ?? "").length > 0) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
