import * as datalineage from "@distilled.cloud/gcp/datalineage_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  createOwnership,
  desiredAttributes,
  findOwnedRun,
  hasAlchemyAttributeMap,
  listOwnedProcesses,
  listRuns,
  normalizeLocation,
  ownedByAlchemy,
  parseName,
  processOf,
  replaceOnIdentity,
  sameJson,
  sameText,
  toPhysicalId,
  userAttributes,
  waitForOperation,
  waitUntilGone,
} from "./internal.ts"

export type ProcessesRunProps = {
  /**
   * Parent process. Full name
   * `projects/{project}/locations/{location}/processes/{process}` or the
   * process id (combined with `location`). Immutable — changing it
   * replaces the run.
   */
  process: string
  /**
   * Run id (the `{run}` segment of
   * `.../processes/{process}/runs/{run}`). If omitted, a unique name is
   * generated. Max 200 characters: letters, digits, underscores, hyphens,
   * colons, periods. Immutable — changing it replaces the run.
   */
  runId?: string
  /**
   * Region used when `process` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * RFC3339 start time. Required by the API; Alchemy reuses the observed
   * value on updates when omitted.
   */
  startTime?: string
  /**
   * RFC3339 end time.
   */
  endTime?: string
  /**
   * Run state.
   * @default "STARTED"
   */
  state?: datalineage.GoogleCloudDatacatalogLineageV1RunStateEnum | (string & {})
  /**
   * Human-readable name shown in UIs. Max 200 characters.
   */
  displayName?: string
  /**
   * Non-semantic attributes. Runs have no labels field, so Alchemy stamps
   * `alchemy-stack` / `alchemy-stage` / `alchemy-id` here for `list` /
   * nuke and strips them from attributes.
   */
  attributes?: Record<string, unknown>
}

export type ProcessesRun = Resource<
  "GCP.DataLineage.ProcessesRun",
  ProcessesRunProps,
  {
    /** Full resource name `.../processes/{process}/runs/{run}`. */
    name: string
    /** Run id (last path segment). */
    runId: string
    /** Parent process resource name. */
    process: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** RFC3339 start time. */
    startTime: string | undefined
    /** RFC3339 end time. */
    endTime: string | undefined
    /** Run state (`STARTED`, `COMPLETED`, …). */
    state: string | undefined
    /** Human-readable display name. */
    displayName: string | undefined
    /** User attributes (Alchemy ownership keys stripped). */
    attributes: Record<string, unknown>
  },
  never,
  Providers
>

/**
 * A Data Lineage run — one execution of a process that produces lineage
 * events.
 *
 * Runs have no labels field, so Alchemy stamps ownership into
 * `attributes` for `list` / nuke. Parent process, `runId`, and location
 * are identity. State, timestamps, display name, and attributes update
 * in place.
 *
 * ### Creating a Run
 * **Example:** Started run under a process
 * ```typescript
 * const run = yield* GCP.DataLineage.ProcessesRun("Nightly", {
 *   process: process.name,
 *   startTime: "2024-01-01T00:00:00Z",
 *   state: "STARTED",
 *   attributes: { env: "dev" },
 * });
 * ```
 *
 * **Example:** Completed run
 * ```typescript
 * const run = yield* GCP.DataLineage.ProcessesRun("Nightly", {
 *   process: process.name,
 *   startTime: "2024-01-01T00:00:00Z",
 *   endTime: "2024-01-01T01:00:00Z",
 *   state: "COMPLETED",
 *   displayName: "nightly 2024-01-01",
 * });
 * ```
 *
 * @resource
 * @category DataLineage
 */
export const ProcessesRun = Resource<ProcessesRun>("GCP.DataLineage.ProcessesRun")

/** Alias matching the Data Lineage resource name. */
export const Run = ProcessesRun
export type Run = ProcessesRun

// @vibelang-diagnostics-next-line EK4830:off
export class ProcessesRunNotResolved extends Data.TaggedError(
  "GCP.DataLineage.ProcessesRunNotResolved",
)<{
  resourceName: string
}> {}

const resourceName = (process: string, runId: string): infer _ => `${process}/runs/${runId}`

const nowIso = effect () => new Date().toISOString()

const toAttrs = (
  run: datalineage.GoogleCloudDatacatalogLineageV1Run,
  project: string,
  region: string,
): infer _ => {
  const name = run.name ?? ""
  const parsed = parseName(name, "runs", region)
  return {
    name,
    runId: parsed.id,
    process: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    startTime: run.startTime,
    endTime: run.endTime,
    state: run.state,
    displayName: run.displayName,
    attributes: userAttributes(run.attributes),
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : datalineage
  .getProjectsLocationsProcessesRuns({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const ProcessesRunProvider = (): infer _ =>
  Provider.succeed(ProcessesRun, {
    stables: ["name", "runId", "process", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousLocation = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const nextLocation = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            resolved.location ?? olds?.location ?? output?.location,
            env.region,
          ),
        catch: (e) => e,
      }))
      const previousProcess = olds?.process ?? output?.process
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.runId ?? output?.runId,
            nextId: resolved.runId,
            previousParent: previousProcess,
            nextParent: resolved.process,
            extra: output !== undefined && previousLocation !== nextLocation,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const parentRef = olds?.process ?? output?.process
      // A recovery read of an interrupted create gets persisted props whose
      // unresolved parent reference was stripped; without the parent there
      // is no name to look up, so report nothing found rather than calling
      // the API with an empty path segment.
      if (output?.name === undefined && (typeof parentRef !== "string" || parentRef.length === 0)) {
        return undefined
      }
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const process = try Effect.orDie(
        Effect.try({
          try: () => processOf(olds?.process ?? output?.process ?? "", env.project, location),
          catch: (e) => e,
        }),
      )
      const runId = try toPhysicalId(id, olds?.runId, output?.runId)
      const name = output?.name ?? resourceName(process, runId)
      const existing = (try getByName(name)) ?? (try findOwnedRun(id, process))
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try ownedByAlchemy(id, existing.attributes))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const processes = try listOwnedProcesses(env.project, env.region)
      const groups = try Effect.forEach(processes, effect (process) => try listRuns(process.name ?? ""), {
        concurrency: 4,
      })
      return groups
        .flat()
        .filter((run) => hasAlchemyAttributeMap(run.attributes))
        .map((run) => toAttrs(run, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const process = try Effect.orDie(
        Effect.try({ try: () => processOf(news.process, env.project, location), catch: (e) => e }),
      )
      const runId = try toPhysicalId(id, news.runId, output?.runId)
      const name = output?.name ?? resourceName(process, runId)
      const ownership = try createOwnership(id)
      const attributes = try Effect.orDie(
        Effect.try({ try: () => desiredAttributes(news.attributes, ownership), catch: (e) => e }),
      )

      let current = (try getByName(name)) ?? (try findOwnedRun(id, process))

      if (current === undefined) {
        const startTime = news.startTime ?? (try nowIso())
        const created = datalineage
          .createProjectsLocationsProcessesRuns({
            parent: process,
            body: {
              name,
              startTime,
              endTime: news.endTime,
              state: news.state ?? "STARTED",
              displayName: news.displayName,
              attributes,
            },
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try effect {
              const row = try getByName(name)
              return (row ? row : try findOwnedRun(id, process))
            };
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new ProcessesRunNotResolved({ resourceName: name })
      }

      const resolvedName = current.name ?? name
      const startTime = news.startTime ?? current.startTime ?? (try nowIso())
      const endTime = news.endTime ?? current.endTime
      const state = news.state ?? current.state ?? "STARTED"
      const displayName = news.displayName ?? current.displayName
      const startChanged = !sameText(current.startTime, startTime)
      const endChanged = !sameText(current.endTime, endTime)
      const stateChanged = !sameText(current.state, state)
      const displayNameChanged = !sameText(current.displayName, displayName)
      const attributesChanged = !(try Effect.orDie(Effect.try({
        try: sameJson.bind(undefined, current.attributes, attributes),
        catch: (e) => e,
      })))

      if (startChanged || endChanged || stateChanged || displayNameChanged || attributesChanged) {
        current = try datalineage.patchProjectsLocationsProcessesRuns({
          name: resolvedName,
          body: {
            name: resolvedName,
            startTime,
            endTime,
            state,
            displayName,
            attributes,
          },
        })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      const operation = datalineage
        .deleteProjectsLocationsProcessesRuns({
          name: output.name,
          allowMissing: true,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
