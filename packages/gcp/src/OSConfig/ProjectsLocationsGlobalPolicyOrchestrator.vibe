import * as osconfig from "@distilled.cloud/gcp/osconfig_v2"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  DEFAULT_ACTION,
  DEFAULT_STATE,
  OsconfigNotResolved,
  collectOrchestrators,
  defaultOrchestratedResource,
  fieldMask,
  fingerprint,
  globalParent,
  hasAlchemyLabelMap,
  orchestratedPayload,
  parseName,
  projectParent,
  replaceOnIdentity,
  resourceName,
  toPhysicalId,
  userLabels,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
  type OrchestratedResource,
  type OrchestrationScope,
} from "./internal.vibe"

export type ProjectsLocationsGlobalPolicyOrchestratorProps = {
  /**
   * Orchestrator id (the `{policyOrchestrator}` segment of
   * `projects/{project}/locations/global/policyOrchestrators/{policyOrchestrator}`).
   * If omitted, a unique RFC1035 name is generated. Immutable — changing
   * it replaces the orchestrator.
   */
  policyOrchestratorId?: string
  /**
   * Action applied to matching OS policy assignments.
   * `UPSERT` creates or updates; `DELETE` removes them.
   * @default "UPSERT"
   */
  action?: string
  /**
   * Orchestrator state. `ACTIVE` applies changes; `STOPPED` is idle.
   * Defaults to `STOPPED` so create does not roll out assignments.
   * @default "STOPPED"
   */
  state?: string
  /**
   * Free-form description of the orchestrator.
   */
  description?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Resource the orchestrator creates, updates, or deletes. When omitted,
   * a no-op VALIDATION OS policy assignment is used.
   */
  orchestratedResource?: OrchestratedResource
  /**
   * Scope of projects, folders, and zones the orchestrator targets.
   * When omitted, the parent project is the entire scope.
   */
  orchestrationScope?: OrchestrationScope
}

export type ProjectsLocationsGlobalPolicyOrchestrator = Resource<
  "GCP.OSConfig.ProjectsLocationsGlobalPolicyOrchestrator",
  ProjectsLocationsGlobalPolicyOrchestratorProps,
  {
    /** Full resource name. */
    name: string
    /** Orchestrator id (last path segment). */
    policyOrchestratorId: string
    /** Parent `projects/{project}/locations/global`. */
    parent: string
    /** Project id. */
    project: string
    /** Orchestration action (`UPSERT` or `DELETE`). */
    action: string | undefined
    /** Orchestrator state (`ACTIVE` or `STOPPED`). */
    state: string | undefined
    /** User description. */
    description: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Orchestrated OS policy assignment payload. */
    orchestratedResource: OrchestratedResource | undefined
    /** Orchestration scope selectors. */
    orchestrationScope: OrchestrationScope | undefined
    /** Whether the orchestrator is currently applying changes. */
    reconciling: boolean | undefined
    /** Server checksum used on update and delete. */
    etag: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A project-scoped OS Config policy orchestrator.
 *
 * Policy orchestrators upsert or delete OS policy assignments across
 * zones in a project. Id is identity — changing `policyOrchestratorId`
 * replaces the resource. Action, state, description, labels, the
 * orchestrated payload, and scope update in place.
 *
 * ### Creating a Policy Orchestrator
 * **Example:** Generated name, stopped
 * ```typescript
 * const orch = yield* GCP.OSConfig.ProjectsLocationsGlobalPolicyOrchestrator(
 *   "Debian",
 *   { labels: { env: "test" } },
 * );
 * ```
 *
 * **Example:** Explicit id and description
 * ```typescript
 * const orch = yield* GCP.OSConfig.ProjectsLocationsGlobalPolicyOrchestrator(
 *   "Debian",
 *   {
 *     policyOrchestratorId: "debian-noop",
 *     description: "validation only",
 *     state: "STOPPED",
 *   },
 * );
 * ```
 *
 * ### Updating a Policy Orchestrator
 * **Example:** Change labels and description
 * ```typescript
 * const orch = yield* GCP.OSConfig.ProjectsLocationsGlobalPolicyOrchestrator(
 *   "Debian",
 *   {
 *     description: "updated",
 *     labels: { env: "prod" },
 *   },
 * );
 * ```
 *
 * @resource
 * @category OSConfig
 */
export const ProjectsLocationsGlobalPolicyOrchestrator = Resource<ProjectsLocationsGlobalPolicyOrchestrator>(
  "GCP.OSConfig.ProjectsLocationsGlobalPolicyOrchestrator",
)

const toAttrs = (item: osconfig.GoogleCloudOsconfigV2__PolicyOrchestrator, project: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name)
  return {
    name,
    policyOrchestratorId: parsed.id,
    parent: parsed.parent,
    project: parsed.project || project,
    action: item.action,
    state: item.state,
    description: item.description,
    labels: userLabels(item.labels),
    orchestratedResource: item.orchestratedResource,
    orchestrationScope: item.orchestrationScope,
    reconciling: item.reconciling,
    etag: item.etag,
    createTime: item.createTime,
    updateTime: item.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : osconfig
  .getProjectsLocationsGlobalPolicyOrchestrators({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const desiredBody = (
  news: ProjectsLocationsGlobalPolicyOrchestratorProps,
  policyOrchestratorId: string,
  desiredLabels: Record<string, string>,
): osconfig.GoogleCloudOsconfigV2__PolicyOrchestrator => ({
  action: news.action ?? DEFAULT_ACTION,
  state: news.state ?? DEFAULT_STATE,
  description: news.description,
  labels: desiredLabels,
  orchestratedResource: orchestratedPayload(
    news.orchestratedResource ?? defaultOrchestratedResource(rfcResourceId(policyOrchestratorId)),
  ),
  orchestrationScope: news.orchestrationScope,
})

const rfcResourceId = (policyOrchestratorId: string): infer _ => policyOrchestratorId.slice(0, 63)

export const ProjectsLocationsGlobalPolicyOrchestratorProvider = (): infer _ =>
  Provider.succeed(ProjectsLocationsGlobalPolicyOrchestrator, {
    stables: ["name", "policyOrchestratorId", "parent", "project", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousParent = output?.parent ?? ""
      const nextParent = previousParent
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.policyOrchestratorId ?? output?.policyOrchestratorId,
            nextId: resolved.policyOrchestratorId ?? olds?.policyOrchestratorId ?? output?.policyOrchestratorId,
            previousParent,
            nextParent,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const policyOrchestratorId = try toPhysicalId(
        id,
        olds?.policyOrchestratorId,
        output?.policyOrchestratorId,
      )
      const parent = try Effect.orDie(
        Effect.try({ try: () => globalParent(projectParent(env.project)), catch: (e) => e }),
      )
      const name = output?.name
        ?? (try Effect.orDie(Effect.try({ try: () => resourceName(parent, policyOrchestratorId), catch: (e) => e })))
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try collectOrchestrators(
        osconfig.listProjectsLocationsGlobalPolicyOrchestrators.pages({
          parent: try Effect.orDie(
            Effect.try({ try: () => globalParent(projectParent(env.project)), catch: (e) => e }),
          ),
          pageSize: 1000,
        }),
      )
      return items
        .filter((item) => hasAlchemyLabelMap(item.labels))
        .map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const policyOrchestratorId = try toPhysicalId(
        id,
        news.policyOrchestratorId,
        output?.policyOrchestratorId,
      )
      const parent = try Effect.orDie(
        Effect.try({ try: () => globalParent(projectParent(env.project)), catch: (e) => e }),
      )
      const name = try Effect.orDie(
        Effect.try({ try: () => resourceName(parent, policyOrchestratorId), catch: (e) => e }),
      )
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }
      const desired = desiredBody(news, policyOrchestratorId, desiredLabels)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = osconfig
          .createProjectsLocationsGlobalPolicyOrchestrators({
            parent,
            policyOrchestratorId,
            body: desired,
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new OsconfigNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const actionChanged = (current.action ?? DEFAULT_ACTION) !== (desired.action ?? DEFAULT_ACTION)
      const stateChanged = (current.state ?? DEFAULT_STATE) !== (desired.state ?? DEFAULT_STATE)
      const descriptionChanged = (current.description ?? "") !== (desired.description ?? "")
      const resourceChanged = (try Effect.orDie(
        Effect.try({
          try: fingerprint.bind(undefined, orchestratedPayload(current.orchestratedResource)),
          catch: (e) => e,
        }),
      ))
        !== (try Effect.orDie(Effect.try({ try: () => fingerprint(desired.orchestratedResource), catch: (e) => e })))
      const scopeChanged = desired.orchestrationScope !== undefined
        && (try Effect.orDie(
          Effect.try({ try: fingerprint.bind(undefined, current.orchestrationScope), catch: (e) => e }),
        ))
          !== (try Effect.orDie(
            Effect.try({ try: fingerprint.bind(undefined, desired.orchestrationScope), catch: (e) => e }),
          ))
      const mask = try Effect.orDie(Effect.try({
        try: () =>
          fieldMask([
            labelsChanged && "labels",
            actionChanged && "action",
            stateChanged && "state",
            descriptionChanged && "description",
            resourceChanged && "orchestratedResource",
            scopeChanged && "orchestrationScope",
          ]),
        catch: (e) => e,
      }))

      if (mask.length > 0) {
        const operation = try osconfig.patchProjectsLocationsGlobalPolicyOrchestrators({
          name: current.name ?? name,
          updateMask: mask,
          body: {
            ...desired,
            name: current.name ?? name,
            etag: current.etag,
          },
        })
        try waitForOperation(operation)
        current = try waitUntilExists(getByName(current.name ?? name), current.name ?? name)
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      const operation = (effect {
        return (try (osconfig
          .deleteProjectsLocationsGlobalPolicyOrchestrators({
            name: output.name,
            etag: output.etag,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
