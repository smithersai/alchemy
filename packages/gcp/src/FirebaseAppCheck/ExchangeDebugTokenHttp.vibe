import * as firebaseappcheck from "@distilled.cloud/gcp/firebaseappcheck_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import type { AppsDebugToken } from "./AppsDebugToken.vibe"
import { ExchangeDebugToken, type ExchangeDebugTokenRequest } from "./ExchangeDebugToken.vibe"

/**
 * HTTP implementation of {@link ExchangeDebugToken}.
 *
 * @layer
 * @provides GCP.FirebaseAppCheck.ExchangeDebugToken
 */
export const ExchangeDebugTokenHttp = Layer.effect(
  ExchangeDebugToken,
  effect {
    const bind = try GCPBindings.Bind
    const exchange = try GCPBindings.withCredentials(
      firebaseappcheck.exchangeDebugTokenProjectsApps,
    )
    return effect (debugToken: AppsDebugToken) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.FirebaseAppCheck.ExchangeDebugToken(${debugToken})`({
          // exchangeDebugToken is not IAM-gated; the debug token secret is the
          // credential.
          iam: [],
        })
      }
      const app = try debugToken.app.asEffect()
      const secret = try debugToken.token.asEffect()
      return effect (request?: ExchangeDebugTokenRequest | undefined) =>
        try withSpan(
          effect {
            return try exchange({
              app: try app,
              body: {
                debugToken: (try secret) ?? "",
                limitedUse: request?.limitedUse === true ? true : undefined,
              },
            })
          },
          `GCP.FirebaseAppCheck.ExchangeDebugToken(${debugToken.LogicalId})`,
        )
    }
  },
)
