import * as acm from "@distilled.cloud/gcp/accesscontextmanager_v1"
import * as resourcemanager from "@distilled.cloud/gcp/cloudresourcemanager_v3"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import * as Schedule from "effect/Schedule"
import * as Stream from "effect/Stream"
import { GcpEnvironment } from "../Environment.ts"
import { alchemyLabelKeys, createInternalLabels, hasAlchemyLabels } from "../Labels.ts"
import { waitForOperation as waitForGcpOperation } from "../Operation.ts"

export const MAX_TITLE_LENGTH = 256
export const MAX_DESCRIPTION_LENGTH = 1024
export const MAX_RESOURCE_ID_LENGTH = 50

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceNotResolved extends Data.TaggedError("GCP.AccessContextManager.NotResolved")<{
  mutable resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceStillExists extends Data.TaggedError("GCP.AccessContextManager.StillExists")<{
  mutable resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class OrganizationRequired extends Data.TaggedError(
  "GCP.AccessContextManager.OrganizationRequired",
)<{
  mutable project: string
}> {}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const organizationParent = (value: string): infer _ =>
  value.startsWith("organizations/") ? value : `organizations/${lastSegment(value)}`

export const policyNameOf = (policy: string): infer _ =>
  policy.startsWith("accessPolicies/") ? policy : `accessPolicies/${lastSegment(policy)}`

export const policyIdOf = (policy: string): infer _ => lastSegment(policyNameOf(policy))

export const resourceNameOf = (policy: string, collection: string, id: string): infer _ =>
  `${policyNameOf(policy)}/${collection}/${id}`

export const parseName = (name: string, collection: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const collectionAt = parts.lastIndexOf(collection)
  const policiesAt = parts.lastIndexOf("accessPolicies")
  const orgsAt = parts.lastIndexOf("organizations")
  return {
    name,
    policyId: policiesAt >= 0 && parts[policiesAt + 1] ? parts[policiesAt + 1]! : "",
    organization: orgsAt >= 0 && parts[orgsAt + 1] ? parts[orgsAt + 1]! : "",
    id: collectionAt >= 0 && parts[collectionAt + 1] ? parts[collectionAt + 1]! : lastSegment(name),
    parent: collectionAt > 0
      ? parts.slice(0, collectionAt).join("/")
      : parts.slice(0, Math.max(0, parts.length - 1)).join("/"),
  }
}

export const toAcmId = effect (
  id: string,
  requested: string | undefined,
  existing: string | undefined,
  maxLength = MAX_RESOURCE_ID_LENGTH,
) => {
  if (requested !== undefined) return requested
  if (existing !== undefined) return existing
  const generated = try createPhysicalName({
    id,
    maxLength,
    lowercase: true,
    delimiter: "_",
  })
  let next = generated.replace(/[^a-zA-Z0-9_]/g, "_").replace(/_+/g, "_")
  if (!/^[a-zA-Z]/.test(next)) {
    next = `a${next}`
  }
  next = next.slice(0, maxLength).replace(/_+$/, "")
  return next.length > 0 ? next : "a"
}

const parentOf = (name: string): infer _ =>
  name.startsWith("projects/")
    ? effect {
      return (try resourcemanager.getProjects({ name })).parent catch effect (e) => match (e) {
        when { _tag: "NotFound" }: try Effect.undefined;
        default: throw e;
      }
    }
    : name.startsWith("folders/")
    ? effect {
      return (try resourcemanager.getFolders({ name })).parent catch effect (e) => match (e) {
        when { _tag: "NotFound" }: try Effect.undefined;
        default: throw e;
      }
    }
    : Effect.undefined

export const tryResolveOrganization = effect () => {
  const env = try GcpEnvironment.current
  let current: string | undefined = `projects/${env.project}`
  for (let i = 0; i < 8; i++) {
    if (current === undefined) return undefined
    if (current.startsWith("organizations/")) return current
    current = try parentOf(current)
  }
  return undefined
}

export const resolveOrganization = effect (explicit: string | undefined, existing: string | undefined) => {
  if (explicit !== undefined) return organizationParent(explicit)
  if (existing !== undefined) return organizationParent(existing)
  const resolved = try tryResolveOrganization()
  if (resolved === undefined) {
    const env = try GcpEnvironment.current
    throw new OrganizationRequired({ project: env.project })
  }
  return resolved
}

export const projectNumberOf = effect (project: string) =>
  (lastSegment((try resourcemanager.getProjects({ name: `projects/${project}` })).name ?? "")) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  }

export const normalizeScope = (scope: string, projectNumber?: string): infer _ => {
  if (
    scope.startsWith("projects/")
    || scope.startsWith("folders/")
    || scope.startsWith("organizations/")
  ) {
    return scope
  }
  if (/^\d+$/.test(scope)) return `projects/${scope}`
  if (projectNumber !== undefined && projectNumber.length > 0) {
    return `projects/${projectNumber}`
  }
  return `projects/${scope}`
}

export const normalizeScopes = (scopes: readonly string[] | undefined, projectNumber?: string): infer _ =>
  (scopes ?? []).map((scope) => normalizeScope(scope, projectNumber))

const markerOf = (stack: string, stage: string, id: string): infer _ =>
  `[alchemy ${alchemyLabelKeys.stack}=${stack} ${alchemyLabelKeys.stage}=${stage} ${alchemyLabelKeys.id}=${id}]`

const fitMarker = (labels: Record<string, string>, maxLength: number): infer _ => {
  let stack = labels[alchemyLabelKeys.stack] ?? "x"
  let stage = labels[alchemyLabelKeys.stage] ?? "x"
  let id = labels[alchemyLabelKeys.id] ?? "x"
  let marker = markerOf(stack, stage, id)
  while (marker.length > maxLength && (stack.length > 1 || stage.length > 1 || id.length > 1)) {
    if (stack.length >= stage.length && stack.length >= id.length) {
      stack = stack.slice(0, -1)
    } else if (stage.length >= id.length) {
      stage = stage.slice(0, -1)
    } else {
      id = id.slice(0, -1)
    }
    marker = markerOf(stack, stage, id)
  }
  return marker.slice(0, maxLength)
}

export const encodeOwnership = (
  labels: Record<string, string>,
  text: string | undefined,
  maxLength = MAX_DESCRIPTION_LENGTH,
): string => {
  const marker = fitMarker(labels, maxLength)
  const trimmed = text?.trim()
  if (!trimmed) return marker.slice(0, maxLength)
  return `${marker}\n${trimmed}`.slice(0, maxLength)
}

export const encodeOwnershipLine = (
  labels: Record<string, string>,
  text: string | undefined,
  maxLength = MAX_TITLE_LENGTH,
): string => {
  const trimmed = text?.replace(/[\r\n]+/g, " ").trim()
  const reserved = trimmed && trimmed.length > 0 ? Math.min(trimmed.length + 1, Math.max(0, maxLength - 24)) : 0
  const marker = fitMarker(labels, Math.max(24, maxLength - reserved))
  if (!trimmed) return marker.slice(0, maxLength)
  return `${marker} ${trimmed}`.slice(0, maxLength)
}

export const parseOwnership = (
  text: string | undefined,
): {
  mutable labels: Record<string, string>
  mutable text: string | undefined
} => {
  if (!text?.startsWith("[alchemy ")) {
    return { labels: {}, text }
  }
  const end = text.indexOf("]")
  if (end < 0) return { labels: {}, text }
  const labels: Record<string, string> = {}
  for (const part of text.slice("[alchemy ".length, end).split(/\s+/)) {
    const eq = part.indexOf("=")
    if (eq > 0) {
      labels[part.slice(0, eq)] = part.slice(eq + 1)
    }
  }
  const rest = text.slice(end + 1).replace(/^[\s\n]+/, "")
  return { labels, text: rest.length > 0 ? rest : undefined }
}

export const hasOwnershipMarker = (text: string | undefined): infer _ =>
  Object.keys(parseOwnership(text).labels).some((key) => key.startsWith("alchemy-"))

const prefixMatch = (expected: string, observed: string): infer _ =>
  expected === observed || expected.startsWith(observed) || observed.startsWith(expected)

export const ownedByAlchemy = effect (id: string, text: string | undefined) => {
  const expected = try createInternalLabels(id)
  const { labels } = parseOwnership(text)
  if (!hasOwnershipMarker(text)) return false
  const exact = try hasAlchemyLabels(id, labels)
  if (exact) return true
  return (
    prefixMatch(expected[alchemyLabelKeys.stack] ?? "", labels[alchemyLabelKeys.stack] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.stage] ?? "", labels[alchemyLabelKeys.stage] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.id] ?? "", labels[alchemyLabelKeys.id] ?? "")
  )
}

export const jsonEqual = (left: unknown, right: unknown): infer _ =>
  JSON.stringify(left ?? null) === JSON.stringify(right ?? null)

export const sortedStrings = (values: readonly string[] | undefined): infer _ => [...(values ?? [])].slice().sort()

export const sameStringList = (
  left: readonly string[] | undefined,
  right: readonly string[] | undefined,
): infer _ => JSON.stringify(sortedStrings(left)) === JSON.stringify(sortedStrings(right))

export const collectPages = effect <Page, A, E, R>(
  pages: Stream.Stream<Page, E, R>,
  items: (page: Page) => readonly A[] | undefined,
) =>
  Array.from(
    try (pages
      |> Stream.flatMap(%, (page) => Stream.fromIterable(items(page) ?? []))
      |> Stream.runCollect(%)),
  )

export const listAccessPolicies = effect (organization: string) =>
  collectPages(
    acm.listAccessPolicies.pages({
      parent: organizationParent(organization),
      pageSize: 100,
    }),
    (page) => page.accessPolicies,
  ) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as acm.AccessPolicy[]; default: throw e; }

export const listOwnedPolicies = effect () => {
  const organization = try tryResolveOrganization()
  if (organization === undefined) return [] as acm.AccessPolicy[]
  const policies = try listAccessPolicies(organization)
  return policies.filter((policy) => hasOwnershipMarker(policy.title))
}

export const resourceNameFromOperation = (
  operation: acm.Operation,
  prefix?: string,
): string | undefined => {
  const name = operation.response?.name
  if (typeof name !== "string" || name.length === 0) return undefined
  if (prefix !== undefined && !name.startsWith(prefix)) return undefined
  return name
}

/**
 * Wait for an Access Context Manager operation (a few minutes at most) and
 * return the finished operation so callers can read its `response`.
 */
export const waitForOperation = effect (operation: acm.Operation) => {
  try waitForGcpOperation(operation, (name) => acm.getOperations({ name }), {
    budget: "10 minutes",
  })
  if (operation.done === true || !operation.name) return operation
  return try acm.getOperations({ name: operation.name })
}

export const waitUntilExists = effect <A, E extends { readonly _tag: string }, R>(
  get: A | undefined!E!R,
  name: string,
) =>
  try (effect {
    return try effect {
      const value = try get
      return (value ? value : throw new ResourceNotResolved({ resourceName: name }))
    }
  }
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.AccessContextManager.NotResolved",
      times: 8,
      schedule: Schedule.spaced("1 second"),
    }))

export const waitUntilGone = effect <A, E extends { readonly _tag: string }, R>(
  get: A | undefined!E!R,
  name: string,
) =>
  try (effect {
    return try ((try get) === undefined
      ? Effect.void
      : throw new ResourceStillExists({ resourceName: name }))
  }
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.AccessContextManager.StillExists",
      times: 10,
      schedule: Schedule.spaced("2 seconds"),
    }))

export const replaceOnIdentity = (changed: boolean): infer _ =>
  changed ? ({ action: "replace" as const, deleteFirst: false } as const) : undefined
