import * as acm from "@distilled.cloud/gcp/accesscontextmanager_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  encodeOwnershipLine,
  lastSegment,
  listAccessPolicies,
  MAX_TITLE_LENGTH,
  normalizeScopes,
  ownedByAlchemy,
  parseOwnership,
  projectNumberOf,
  replaceOnIdentity,
  resolveOrganization,
  resourceNameFromOperation,
  sameStringList,
  tryResolveOrganization,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type AccessPolicyProps = {
  /**
   * Organization parent (`organizations/{organization}` or the numeric
   * organization id). If omitted, Alchemy uses `GOOGLE_ORGANIZATION_ID`
   * or the project's Resource Manager parent. Immutable — changing it
   * replaces the policy.
   */
  parent?: string
  /**
   * Human-readable title. Access policies have no labels or description,
   * so Alchemy ownership (`alchemy-stack` / `alchemy-stage` /
   * `alchemy-id`) is stored in a `[alchemy …]` prefix and stripped from
   * attributes.
   */
  title?: string
  /**
   * Policy scopes. Format: `folders/{folder_number}` or
   * `projects/{project_number}`. At most one scope. Empty or omitted
   * creates the organization-wide default policy (one per organization).
   * Immutable — changing scopes replaces the policy.
   */
  scopes?: string[]
}

export type AccessPolicy = Resource<
  "GCP.AccessContextManager.AccessPolicy",
  AccessPolicyProps,
  {
    /** Resource name `accessPolicies/{policy}`. */
    name: string
    /** Policy id (last path segment). */
    policyId: string
    /** Parent `organizations/{organization}`. */
    parent: string
    /** User title with the Alchemy ownership prefix stripped. */
    title: string | undefined
    /** Policy scopes (`projects/{number}` or `folders/{number}`). */
    scopes: string[]
    /** Server etag for optimistic concurrency. */
    etag: string | undefined
  },
  never,
  Providers
>

/**
 * An Access Context Manager access policy.
 *
 * An access policy is the container for access levels, service
 * perimeters, and authorized-orgs descriptors. One unscoped
 * (organization-wide) policy is allowed per organization; additional
 * policies must set `scopes` to a folder or project.
 *
 * Access policies have no labels. Alchemy stamps ownership into `title`
 * so `list` / `pnpm nuke:gcp` can find them. `parent` and `scopes` are
 * immutable — changing them replaces the policy. `title` updates in
 * place. The policy id is assigned by the API.
 *
 * ### Creating an Access Policy
 * **Example:** Scoped to the current project
 * ```typescript
 * const policy = yield* GCP.AccessContextManager.AccessPolicy("Corp", {
 *   title: "corp access policy",
 *   scopes: ["projects/123456789"],
 * });
 * ```
 *
 * **Example:** Organization-wide default policy
 * ```typescript
 * const policy = yield* GCP.AccessContextManager.AccessPolicy("Default", {
 *   parent: "organizations/123456789",
 *   title: "default policy",
 * });
 * ```
 *
 * ### Updating an Access Policy
 * **Example:** Change the title
 * ```typescript
 * const policy = yield* GCP.AccessContextManager.AccessPolicy("Corp", {
 *   title: "corp access policy (prod)",
 *   scopes: ["projects/123456789"],
 * });
 * ```
 *
 * @resource
 * @category AccessContextManager
 */
export const AccessPolicy = Resource<AccessPolicy>("GCP.AccessContextManager.AccessPolicy")

// @vibelang-diagnostics-next-line EK4830:off
export class AccessPolicyNotResolved extends Data.TaggedError(
  "GCP.AccessContextManager.AccessPolicyNotResolved",
)<{
  resourceName: string
}> {}

const toAttrs = (policy: acm.AccessPolicy): AccessPolicy["Attributes"] => {
  const name = policy.name ?? ""
  const parsed = parseOwnership(policy.title)
  return {
    name,
    policyId: lastSegment(name),
    parent: policy.parent ?? "",
    title: parsed.text,
    scopes: policy.scopes ?? [],
    etag: policy.etag,
  }
}

const getByName = effect (name: string) =>
  acm.getAccessPolicies({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined;
    default: throw e;
  }

const findOwned = effect (id: string, organization: string) => {
  const policies = try listAccessPolicies(organization)
  for (const policy of policies) {
    if (try ownedByAlchemy(id, policy.title)) {
      return policy
    }
  }
  return undefined
}

const observe = effect (id: string, name: string | undefined, organization: string) => {
  if (name !== undefined && name.length > 0) {
    const byName = try getByName(name)
    if (byName !== undefined) return byName
  }
  return try findOwned(id, organization)
}

export const AccessPolicyProvider = (): infer _ =>
  Provider.succeed(AccessPolicy, {
    stables: ["name", "policyId", "parent"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousParent = olds?.parent ?? output?.parent
      const nextParent = resolved.parent ?? previousParent
      const parentChanged = previousParent !== undefined
        && nextParent !== undefined
        && lastSegment(previousParent) !== lastSegment(nextParent)

      const previousScopes = olds?.scopes ?? output?.scopes
      const scopesChanged = resolved.scopes !== undefined
        && previousScopes !== undefined
        && !sameStringList(resolved.scopes, previousScopes)

      return replaceOnIdentity(parentChanged || scopesChanged)
    },

    read: effect ({ id, olds, output }) => {
      const organization = try resolveOrganization(olds?.parent, output?.parent)
      const existing = try observe(id, output?.name, organization)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing)
      return (try ownedByAlchemy(id, existing.title))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const organization = try tryResolveOrganization()
      if (organization === undefined) return []
      const policies = try listAccessPolicies(organization)
      return policies
        .filter((policy) => parseOwnership(policy.title).labels["alchemy-id"])
        .map(toAttrs)
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const organization = try resolveOrganization(news.parent, output?.parent)
      const ownership = try createInternalLabels(id)
      const desiredTitle = encodeOwnershipLine(ownership, news.title, MAX_TITLE_LENGTH)
      const projectNumber = try projectNumberOf(env.project)
      const desiredScopes = news.scopes !== undefined
        ? normalizeScopes(news.scopes, projectNumber)
        : (output?.scopes ?? [])

      let current = try observe(id, output?.name, organization)

      if (current === undefined) {
        const created = acm
          .createAccessPolicies({
            body: {
              title: desiredTitle,
              parent: organization,
              scopes: desiredScopes.length > 0 ? desiredScopes : undefined,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: undefined; default: throw e; }
        if (created !== undefined) {
          // ALREADY_EXISTS (6): a concurrent create won the race.
          const settled = waitForOperation(created) catch effect (error) => match (error) {
            when { _tag: "GCP.OperationFailed" }: error.code === 6 ? created : throw error;
            default: throw error;
          }
          const createdName = resourceNameFromOperation(settled, "accessPolicies/")
            ?? resourceNameFromOperation(created, "accessPolicies/")
          current = createdName !== undefined
            ? try waitUntilExists(getByName(createdName), createdName)
            : try waitUntilExists(findOwned(id, organization), organization)
        } else {
          current = try waitUntilExists(findOwned(id, organization), organization)
        }
      }

      if (current === undefined || current.name === undefined) {
        throw new AccessPolicyNotResolved({
          resourceName: output?.name ?? organization,
        })
      }

      if ((current.title ?? "") !== desiredTitle) {
        const operation = try acm.patchAccessPolicies({
          name: current.name,
          updateMask: "title",
          body: {
            name: current.name,
            title: desiredTitle,
            etag: current.etag,
          },
        })
        try waitForOperation(operation)
        current = try waitUntilExists(getByName(current.name), current.name)
      }

      if (current === undefined) {
        throw new AccessPolicyNotResolved({
          resourceName: output?.name ?? organization,
        })
      }

      return toAttrs(current)
    },

    delete: effect ({ output }) => {
      const operation = acm
        .deleteAccessPolicies({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: undefined;
          default: throw e;
        }
      if (operation !== undefined) {
        // NOT_FOUND (5): already gone.
        waitForOperation(operation) catch effect (error) => match (error) {
          when { _tag: "GCP.OperationFailed" }: try (error.code === 5 ? Effect.void : throw error);
          default: throw error;
        }
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
