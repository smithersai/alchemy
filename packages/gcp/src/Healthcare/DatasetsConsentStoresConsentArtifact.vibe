import * as healthcare from "@distilled.cloud/gcp/healthcare_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels, hasAlchemyLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  expandParent,
  hasAlchemyLabelMap,
  listAlchemyConsentStores,
  normalizeLocation,
  parseResourceName,
  retryTransient,
  userLabels,
  waitUntilGone,
  withOwnershipMetadata,
} from "./internal.ts"

export type ConsentSignature = {
  /** Signing user id. */
  userId?: string
  /** RFC3339 signature time. */
  signatureTime?: string
  /** Signature metadata. */
  metadata?: Record<string, string>
}

export type DatasetsConsentStoresConsentArtifactProps = {
  /**
   * Parent consent store. Full name
   * `.../consentStores/{consentStore}` or the store id (combined with
   * `dataset` and `location`). Immutable — changing it replaces the
   * artifact.
   */
  consentStore: string
  /**
   * Parent dataset used when `consentStore` is a bare id.
   */
  dataset?: string
  /**
   * Region used when `consentStore` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * User UUID supplied by the client.
   */
  userId: string
  /**
   * Version string of the consent information shown to the user.
   */
  consentContentVersion?: string
  /**
   * Artifact metadata. Alchemy ownership keys are merged in
   * automatically (`alchemy-stack`, `alchemy-stage`, `alchemy-id`).
   */
  metadata?: Record<string, string>
  /**
   * User signature.
   */
  userSignature?: ConsentSignature
  /**
   * Guardian signature.
   */
  guardianSignature?: ConsentSignature
  /**
   * Witness signature.
   */
  witnessSignature?: ConsentSignature
}

export type DatasetsConsentStoresConsentArtifact = Resource<
  "GCP.Healthcare.DatasetsConsentStoresConsentArtifact",
  DatasetsConsentStoresConsentArtifactProps,
  {
    /** Full resource name `.../consentArtifacts/{consentArtifact}`. */
    name: string
    /** Server-assigned artifact id. */
    consentArtifactId: string
    /** Parent consent store resource name. */
    consentStore: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** User id. */
    userId: string | undefined
    /** Consent content version. */
    consentContentVersion: string | undefined
    /** User metadata (Alchemy ownership keys stripped). */
    metadata: Record<string, string>
  },
  never,
  Providers
>

/**
 * Documentation of a user's consent (artifact) in a consent store.
 *
 * Artifact ids are server-assigned. There is no patch API — changing
 * `userId`, version, metadata, or parent replaces the artifact.
 * Ownership is stamped into `metadata`.
 *
 * ### Creating a Consent Artifact
 * **Example:** Artifact for a user
 * ```typescript
 * const artifact = yield* GCP.Healthcare.DatasetsConsentStoresConsentArtifact(
 *   "Proof",
 *   {
 *     consentStore: store.name,
 *     userId: "user-123",
 *     consentContentVersion: "v1",
 *     metadata: { locale: "en" },
 *   },
 * );
 * ```
 *
 * @resource
 * @category Healthcare
 */
export const DatasetsConsentStoresConsentArtifact = Resource<DatasetsConsentStoresConsentArtifact>(
  "GCP.Healthcare.DatasetsConsentStoresConsentArtifact",
)

// @vibelang-diagnostics-next-line EK4830:off
export class DatasetsConsentStoresConsentArtifactNotResolved extends Data.TaggedError(
  "GCP.Healthcare.DatasetsConsentStoresConsentArtifactNotResolved",
)<{
  resourceName: string
}> {}

const storeOf = (
  consentStore: string,
  project: string,
  location: string,
  dataset: string | undefined,
): infer _ => {
  if (consentStore.includes("/")) return consentStore.replace(/\/+$/, "")
  if (dataset === undefined) {
    return expandParent(consentStore, project, location, "consentStores")
  }
  const datasetName = expandParent(dataset, project, location, "datasets")
  return `${datasetName}/consentStores/${consentStore}`
}

const toAttrs = (artifact: healthcare.ConsentArtifact, project: string, region: string): infer _ => {
  const name = artifact.name ?? ""
  const parsed = parseResourceName(name, "consentArtifacts", region)
  return {
    name,
    consentArtifactId: parsed.id,
    consentStore: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    userId: artifact.userId,
    consentContentVersion: artifact.consentContentVersion,
    metadata: userLabels(artifact.metadata),
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : healthcare
  .getProjectsLocationsDatasetsConsentStoresConsentArtifacts({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const DatasetsConsentStoresConsentArtifactProvider = (): infer _ =>
  Provider.succeed(DatasetsConsentStoresConsentArtifact, {
    stables: ["name", "consentArtifactId", "consentStore", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousParent = olds?.consentStore ?? output?.consentStore
      const nextParent = storeOf(
        resolved.consentStore,
        env.project,
        try Effect.orDie(
          Effect.try({
            try: () => normalizeLocation(resolved.location ?? output?.location, env.region),
            catch: (e) => e,
          }),
        ),
        resolved.dataset,
      )
      const parentChanged = previousParent !== undefined && previousParent !== nextParent
      const userChanged = olds?.userId !== undefined && olds.userId !== resolved.userId
      const versionChanged = (olds?.consentContentVersion ?? output?.consentContentVersion) !== undefined
        && (olds?.consentContentVersion ?? output?.consentContentVersion)
          !== resolved.consentContentVersion
      if (parentChanged || userChanged || versionChanged) {
        return {
          action: "replace" as const,
          deleteFirst: !parentChanged,
        }
      }
      return undefined
    },

    read: effect ({ id, output }) => {
      const env = try GcpEnvironment.current
      const existing = try getByName(output?.name ?? "")
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.metadata), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const stores = try listAlchemyConsentStores(env.project, env.region)
      const artifacts = try Effect.forEach(
        stores,
        effect (store) =>
          try collectPages(
            healthcare.listProjectsLocationsDatasetsConsentStoresConsentArtifacts.pages({
              parent: store.name ?? "",
              pageSize: 1000,
            }),
            (page) => page.consentArtifacts,
          ),
        { concurrency: 4 },
      )
      return artifacts
        .flat()
        .filter((artifact) => hasAlchemyLabelMap(artifact.metadata))
        .map((artifact) => toAttrs(artifact, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const consentStore = storeOf(news.consentStore, env.project, location, news.dataset)
      const ownership = try createInternalLabels(id)
      const metadata = try Effect.orDie(
        Effect.try({ try: () => withOwnershipMetadata(news.metadata, ownership), catch: (e) => e }),
      )

      let current = try getByName(output?.name ?? "")

      if (current === undefined) {
        current = try retryTransient(
          healthcare.createProjectsLocationsDatasetsConsentStoresConsentArtifacts({
            parent: consentStore,
            body: {
              userId: news.userId,
              consentContentVersion: news.consentContentVersion,
              metadata,
              userSignature: news.userSignature,
              guardianSignature: news.guardianSignature,
              witnessSignature: news.witnessSignature,
            },
          }),
        )
      }

      if (current === undefined) {
        throw new DatasetsConsentStoresConsentArtifactNotResolved({
          resourceName: consentStore,
        })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      retryTransient(
        healthcare.deleteProjectsLocationsDatasetsConsentStoresConsentArtifacts({
          name: output.name,
        }),
      ) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
