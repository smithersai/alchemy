import * as healthcare from "@distilled.cloud/gcp/healthcare_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  expandParent,
  forEachDataset,
  hasAlchemyLabelMap,
  normalizeLocation,
  parseResourceName,
  replaceOnIdentity,
  retryTransient,
  sameText,
  toPhysicalId,
  updateMaskOf,
  userLabels,
  waitUntilGone,
} from "./internal.vibe"

export type DatasetsConsentStoreProps = {
  /**
   * Parent dataset. Full name
   * `projects/{project}/locations/{location}/datasets/{dataset}` or the
   * dataset id (combined with `location`). Immutable — changing it
   * replaces the consent store.
   */
  dataset: string
  /**
   * Region used when `dataset` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Consent store id. Must match letters, numbers, underscores, hyphens,
   * and periods; 1-256 characters. Immutable — changing it replaces the
   * store.
   */
  consentStoreId?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Default TTL for Consents created in this store (e.g. `"86400s"`).
   * Must be at least 24 hours. Updating this does not change existing
   * consents.
   */
  defaultConsentTtl?: string
  /**
   * If true, `UpdateConsent` creates the Consent when it is missing.
   * @default false
   */
  enableConsentCreateOnUpdate?: boolean
}

export type DatasetsConsentStore = Resource<
  "GCP.Healthcare.DatasetsConsentStore",
  DatasetsConsentStoreProps,
  {
    /** Full resource name `.../datasets/{dataset}/consentStores/{consentStore}`. */
    name: string
    /** Consent store id. */
    consentStoreId: string
    /** Parent dataset resource name. */
    dataset: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Default consent TTL. */
    defaultConsentTtl: string | undefined
    /** Whether UpdateConsent creates missing Consents. */
    enableConsentCreateOnUpdate: boolean
  },
  never,
  Providers
>

/**
 * A Cloud Healthcare consent store inside a dataset.
 *
 * Dataset, store id, and location are immutable. Labels, default TTL, and
 * `enableConsentCreateOnUpdate` update in place.
 *
 * ### Creating a Consent Store
 * **Example:** Store with labels
 * ```typescript
 * const store = yield* GCP.Healthcare.DatasetsConsentStore("Consents", {
 *   dataset: dataset.name,
 *   labels: { env: "test" },
 * });
 * ```
 *
 * **Example:** Named store that creates consents on update
 * ```typescript
 * const store = yield* GCP.Healthcare.DatasetsConsentStore("Consents", {
 *   dataset: dataset.name,
 *   consentStoreId: "clinic-consents",
 *   enableConsentCreateOnUpdate: true,
 * });
 * ```
 *
 * @resource
 * @category Healthcare
 */
export const DatasetsConsentStore = Resource<DatasetsConsentStore>(
  "GCP.Healthcare.DatasetsConsentStore",
)

// @vibelang-diagnostics-next-line EK4830:off
export class DatasetsConsentStoreNotResolved extends Data.TaggedError(
  "GCP.Healthcare.DatasetsConsentStoreNotResolved",
)<{
  resourceName: string
}> {}

const datasetOf = (dataset: string, project: string, location: string): infer _ =>
  expandParent(dataset, project, location, "datasets")

const resourceName = (dataset: string, consentStoreId: string): infer _ => `${dataset}/consentStores/${consentStoreId}`

const toAttrs = (store: healthcare.ConsentStore, project: string, region: string): infer _ => {
  const name = store.name ?? ""
  const parsed = parseResourceName(name, "consentStores", region)
  return {
    name,
    consentStoreId: parsed.id,
    dataset: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    labels: userLabels(store.labels),
    defaultConsentTtl: store.defaultConsentTtl,
    enableConsentCreateOnUpdate: store.enableConsentCreateOnUpdate === true,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : healthcare
  .getProjectsLocationsDatasetsConsentStores({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const DatasetsConsentStoreProvider = (): infer _ =>
  Provider.succeed(DatasetsConsentStore, {
    stables: ["name", "consentStoreId", "dataset", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousParent = olds?.dataset ?? output?.dataset
      const nextParent = datasetOf(
        resolved.dataset,
        env.project,
        try Effect.orDie(
          Effect.try({
            try: () => normalizeLocation(resolved.location ?? output?.location, env.region),
            catch: (e) => e,
          }),
        ),
      )
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.consentStoreId ?? output?.consentStoreId,
            nextId: resolved.consentStoreId,
            previousParent,
            nextParent,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const consentStoreId = try toPhysicalId(id, olds?.consentStoreId, output?.consentStoreId)
      const dataset = olds?.dataset !== undefined
        ? datasetOf(olds.dataset, env.project, location)
        : (output?.dataset ?? "")
      const name = output?.name ?? (dataset.length > 0 ? resourceName(dataset, consentStoreId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const stores = try forEachDataset(env.project, env.region, effect (parent) =>
        try collectPages(
          healthcare.listProjectsLocationsDatasetsConsentStores.pages({
            parent,
            pageSize: 1000,
          }),
          (page) => page.consentStores,
        ))
      return stores
        .filter((store) => hasAlchemyLabelMap(store.labels))
        .map((store) => toAttrs(store, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const dataset = datasetOf(news.dataset, env.project, location)
      const consentStoreId = try toPhysicalId(id, news.consentStoreId, output?.consentStoreId)
      const name = output?.name ?? resourceName(dataset, consentStoreId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try getByName(name)

      if (current === undefined) {
        const created = retryTransient(
          healthcare.createProjectsLocationsDatasetsConsentStores({
            parent: dataset,
            consentStoreId,
            body: {
              labels: desiredLabels,
              defaultConsentTtl: news.defaultConsentTtl,
              enableConsentCreateOnUpdate: news.enableConsentCreateOnUpdate,
            },
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new DatasetsConsentStoreNotResolved({ resourceName: name })
      }

      const currentName = current.name ?? name
      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const ttlChanged = !sameText(current.defaultConsentTtl, news.defaultConsentTtl)
      const createOnUpdateChanged = (current.enableConsentCreateOnUpdate === true)
        !== (news.enableConsentCreateOnUpdate === true)

      if (labelsChanged || ttlChanged || createOnUpdateChanged) {
        current = try retryTransient(
          healthcare.patchProjectsLocationsDatasetsConsentStores({
            name: currentName,
            updateMask: try Effect.orDie(Effect.try({
              try: () =>
                updateMaskOf(
                  labelsChanged ? "labels" : undefined,
                  ttlChanged ? "defaultConsentTtl" : undefined,
                  createOnUpdateChanged ? "enableConsentCreateOnUpdate" : undefined,
                ),
              catch: (e) => e,
            })),
            body: {
              labels: desiredLabels,
              defaultConsentTtl: news.defaultConsentTtl,
              enableConsentCreateOnUpdate: news.enableConsentCreateOnUpdate,
            },
          }),
        )
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      retryTransient(
        healthcare.deleteProjectsLocationsDatasetsConsentStores({
          name: output.name,
        }),
      ) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
