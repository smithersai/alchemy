import * as ces from "@distilled.cloud/gcp/ces_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  collectPages,
  encodeOwnership,
  expandApp,
  forEachApp,
  hasOwnershipMarker,
  normalizeLocation,
  ownedByAlchemy,
  parseOwnership,
  parseResourceName,
  replaceOnIdentity,
  retryTransient,
  toPhysicalId,
  waitUntilGone,
} from "./internal.ts"

export type AppsVersionProps = {
  /**
   * Parent CES app. Full name
   * `projects/{project}/locations/{location}/apps/{app}` or the app id
   * (combined with `location`). Immutable — changing it replaces the
   * version.
   */
  app: string
  /**
   * Region used when `app` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * App version id. If omitted, a unique name is generated. Immutable —
   * changing it replaces the version.
   */
  appVersionId?: string
  /**
   * Human-readable name. Alchemy falls back to the generated version
   * id.
   */
  displayName?: string
  /**
   * Snapshot description. Versions have no labels field and no update
   * RPC, so Alchemy stamps ownership into this field at create time.
   * Later description edits are ignored.
   */
  description?: string
}

export type AppsVersion = Resource<
  "GCP.CES.AppsVersion",
  AppsVersionProps,
  {
    /** Full resource name `.../apps/{app}/versions/{version}`. */
    name: string
    /** Version id (last path segment). */
    appVersionId: string
    /** Parent app resource name. */
    app: string
    /** Location id. */
    location: string
    /** Project id. */
    project: string
    /** Display name. */
    displayName: string | undefined
    /** User description with the Alchemy ownership prefix stripped. */
    description: string | undefined
    /** Email of the user who created the version. */
    creator: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** Server-assigned etag. */
    etag: string | undefined
  },
  never,
  Providers
>

/**
 * A Customer Engagement Suite app version — an immutable snapshot of an
 * app at a point in time.
 *
 * Versions have no labels field and no patch RPC. Alchemy stamps
 * ownership into `description` so `list` / nuke can find them. Reconcile
 * is observe-ensure: if the snapshot is missing it is created; later
 * description edits are ignored.
 *
 * ### Creating an App Version
 * **Example:** Snapshot
 * ```typescript
 * const version = yield* GCP.CES.AppsVersion("v1", {
 *   app: app.name,
 *   displayName: "v1",
 *   description: "initial",
 * });
 * ```
 *
 * @resource
 * @category CES
 */
export const AppsVersion = Resource<AppsVersion>("GCP.CES.AppsVersion")

// @vibelang-diagnostics-next-line EK4830:off
export class AppsVersionNotResolved extends Data.TaggedError("GCP.CES.AppsVersionNotResolved")<{
  resourceName: string
}> {}

const resourceName = (app: string, appVersionId: string): infer _ => `${app}/versions/${appVersionId}`

const toAttrs = (version: ces.AppVersion, project: string, region: string, appHint?: string): infer _ => {
  const name = version.name ?? ""
  const parsed = parseResourceName(name, "versions", region)
  return {
    name,
    appVersionId: parsed.id,
    app: name.includes("/versions/") ? parsed.app : (appHint ?? parsed.parent),
    location: parsed.location,
    project: parsed.project || project,
    displayName: version.displayName,
    description: parseOwnership(version.description).text,
    creator: version.creator,
    createTime: version.createTime,
    etag: version.etag,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : ces
  .getProjectsLocationsAppsVersions({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string, region: string) =>
  (try collectPages(
    ces.listProjectsLocationsAppsVersions.pages({ parent, pageSize: 100 }),
    (page) => page.appVersions,
  ))
    .filter((version) => hasOwnershipMarker(version.description))
    .map((version) => toAttrs(version, project, region, parent))

export const AppsVersionProvider = (): infer _ =>
  Provider.succeed(AppsVersion, {
    stables: ["name", "appVersionId", "app", "location", "project", "createTime", "creator"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.appVersionId ?? output?.appVersionId,
            nextId: resolved.appVersionId,
            previousParent: olds?.app ?? output?.app,
            nextParent: resolved.app,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const app = olds?.app
        ? try Effect.orDie(Effect.try({ try: () => expandApp(olds.app, env.project, location), catch: (e) => e }))
        : output?.app
      const appVersionId = try toPhysicalId(id, olds?.appVersionId, output?.appVersionId)
      const name = output?.name ?? (app !== undefined ? resourceName(app, appVersionId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region, app)
      return (try ownedByAlchemy(id, existing.description))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      return try forEachApp(
        env.project,
        effect (parent) => try listAt(parent, env.project, env.region),
        env.region,
      )
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const app = try Effect.orDie(
        Effect.try({ try: () => expandApp(news.app, env.project, location), catch: (e) => e }),
      )
      const appVersionId = try toPhysicalId(id, news.appVersionId, output?.appVersionId)
      const name = output?.name ?? resourceName(app, appVersionId)
      const ownership = try createInternalLabels(id)
      const description = try Effect.orDie(
        Effect.try({ try: () => encodeOwnership(ownership, news.description), catch: (e) => e }),
      )
      const displayName = news.displayName ?? appVersionId

      let current = try getByName(name)

      if (current === undefined) {
        const created = retryTransient(
          ces.createProjectsLocationsAppsVersions({
            parent: app,
            appVersionId,
            body: {
              displayName,
              description,
            },
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new AppsVersionNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project, env.region, app)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      ;(effect {
        return (try (retryTransient(ces.deleteProjectsLocationsAppsVersions({ name: output.name }))
          |> Effect.retry(%, {
            while: (error) => error._tag === "AppVersionInUse",
            schedule: Schedule.spaced("3 seconds"),
            times: 20,
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name))
    },
  })
