import * as ces from "@distilled.cloud/gcp/ces_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  encodeOwnership,
  hasAlchemyLabelMap,
  hasOwnershipMarker,
  listApps,
  locationParent,
  normalizeLocation,
  ownedByAlchemy,
  ownedByAlchemyLabels,
  parseOwnership,
  parseResourceName,
  replaceOnIdentity,
  retryTransient,
  sameJson,
  sameText,
  toPhysicalId,
  updateMaskOf,
  userMetadata,
  waitForVisible,
  waitUntilGone,
} from "./internal.vibe"
import { waitForDeleteOperation, waitForOperation } from "./operations.vibe"

export type AppProps = {
  /**
   * App id (the `{app}` segment of
   * `projects/{project}/locations/{location}/apps/{app}`). If omitted, a
   * unique name is generated. Immutable — changing it replaces the app.
   */
  appId?: string
  /**
   * Location (`us-central1`, …). Immutable — changing it replaces the
   * app. `US-CENTRAL1` is accepted and normalized to `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * Human-readable name. Required by the API; Alchemy falls back to the
   * generated app id.
   */
  displayName?: string
  /**
   * Human-readable description. Apps have no labels field, so Alchemy
   * stamps ownership into `description` and `metadata`.
   */
  description?: string
  /**
   * Free-form metadata. Alchemy ownership keys (`alchemy-stack`,
   * `alchemy-stage`, `alchemy-id`) are merged in automatically.
   */
  metadata?: Record<string, string>
  /**
   * Instructions shared by every agent in the app.
   */
  globalInstruction?: string
  /**
   * Tool execution mode (`PARALLEL`, `SEQUENTIAL`).
   */
  toolExecutionMode?: string
  /**
   * IANA time zone (e.g. `America/Los_Angeles`). Maps onto
   * `timeZoneSettings.timeZone`.
   */
  timeZone?: string
  /**
   * Full time-zone settings. Wins over `timeZone` when both are set.
   */
  timeZoneSettings?: ces.TimeZoneSettings
  /**
   * Default LLM model id.
   */
  model?: string
  /**
   * Default LLM temperature.
   */
  temperature?: number
  /**
   * Full model settings. Wins over `model` / `temperature` when set.
   */
  modelSettings?: ces.ModelSettings
  /**
   * Root agent resource name
   * `projects/{project}/locations/{location}/apps/{app}/agents/{agent}`.
   */
  rootAgent?: string
  /**
   * Guardrail resource names attached to the app.
   */
  guardrails?: string[]
  /**
   * When true, mutations to app resources are rejected.
   * @default false
   */
  locked?: boolean
  /**
   * When true, the app is pinned in the app list.
   * @default false
   */
  pinned?: boolean
  /**
   * Default channel profile for the app.
   */
  defaultChannelProfile?: ces.ChannelProfile
  /**
   * Language settings.
   */
  languageSettings?: ces.LanguageSettings
}

export type App = Resource<
  "GCP.CES.App",
  AppProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/apps/{app}`. */
    name: string
    /** App id (last path segment). */
    appId: string
    /** Location id. */
    location: string
    /** Project id. */
    project: string
    /** Display name. */
    displayName: string | undefined
    /** User description with the Alchemy ownership prefix stripped. */
    description: string | undefined
    /** User metadata (Alchemy ownership keys stripped). */
    metadata: Record<string, string>
    /** Shared agent instructions. */
    globalInstruction: string | undefined
    /** Tool execution mode. */
    toolExecutionMode: string | undefined
    /** IANA time zone. */
    timeZone: string | undefined
    /** Default model settings. */
    modelSettings: ces.ModelSettings | undefined
    /** Root agent resource name. */
    rootAgent: string | undefined
    /** Guardrail resource names. */
    guardrails: string[] | undefined
    /** Whether the app is locked. */
    locked: boolean
    /** Whether the app is pinned. */
    pinned: boolean
    /** Default channel profile. */
    defaultChannelProfile: ces.ChannelProfile | undefined
    /** Language settings. */
    languageSettings: ces.LanguageSettings | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
    /** Server-assigned etag. */
    etag: string | undefined
  },
  never,
  Providers
>

/**
 * A Customer Engagement Suite (CES) app — the top-level container for
 * agents, tools, toolsets, guardrails, examples, versions, and
 * deployments.
 *
 * App create and delete are long-running operations. Location and app id
 * are immutable. CES apps have no labels API, so Alchemy stamps
 * ownership into `metadata` and `description` so `list` / nuke can find
 * them.
 *
 * ### Creating an App
 * **Example:** Generated name
 * ```typescript
 * const app = yield* GCP.CES.App("Support", {
 *   displayName: "support",
 * });
 * ```
 *
 * **Example:** Named app with a time zone and model
 * ```typescript
 * const app = yield* GCP.CES.App("Support", {
 *   appId: "support-desk",
 *   location: "us-central1",
 *   displayName: "Support desk",
 *   timeZone: "America/Los_Angeles",
 *   model: "gemini-2.0-flash",
 * });
 * ```
 *
 * @resource
 * @category CES
 */
export const App = Resource<App>("GCP.CES.App")

// @vibelang-diagnostics-next-line EK4830:off
export class AppNotResolved extends Data.TaggedError("GCP.CES.AppNotResolved")<{
  resourceName: string
}> {}

const resourceName = (project: string, location: string, appId: string): infer _ =>
  `${locationParent(project, location)}/apps/${appId}`

const timeZoneSettingsOf = (news: AppProps): ces.TimeZoneSettings | undefined =>
  news.timeZoneSettings ?? (news.timeZone !== undefined ? { timeZone: news.timeZone } : undefined)

const modelSettingsOf = (news: AppProps): ces.ModelSettings | undefined =>
  news.modelSettings
    ?? (news.model !== undefined || news.temperature !== undefined
      ? { model: news.model, temperature: news.temperature }
      : undefined)

const toAttrs = (app: ces.App, project: string, region: string): infer _ => {
  const name = app.name ?? ""
  const parsed = parseResourceName(name, "apps", region)
  return {
    name,
    appId: parsed.id,
    location: parsed.location,
    project: parsed.project || project,
    displayName: app.displayName,
    description: parseOwnership(app.description).text,
    metadata: userMetadata(app.metadata),
    globalInstruction: app.globalInstruction,
    toolExecutionMode: app.toolExecutionMode,
    timeZone: app.timeZoneSettings?.timeZone,
    modelSettings: app.modelSettings,
    rootAgent: app.rootAgent,
    guardrails: app.guardrails,
    locked: app.locked === true,
    pinned: app.pinned === true,
    defaultChannelProfile: app.defaultChannelProfile,
    languageSettings: app.languageSettings,
    createTime: app.createTime,
    updateTime: app.updateTime,
    etag: app.etag,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : ces
  .getProjectsLocationsApps({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const isOwnedApp = (app: ces.App): infer _ =>
  hasAlchemyLabelMap(app.metadata)
  || hasOwnershipMarker(app.description)
  || hasOwnershipMarker(app.displayName)

export const AppProvider = (): infer _ =>
  Provider.succeed(App, {
    stables: ["name", "appId", "location", "project", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousLocation = olds?.location ?? output?.location
      const nextLocation = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(resolved.location, env.region), catch: (e) => e }),
      )
      if (
        previousLocation !== undefined
        && resolved.location !== undefined
        && (try Effect.orDie(
          Effect.try({ try: () => normalizeLocation(previousLocation, env.region), catch: (e) => e }),
        )) !== nextLocation
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.appId ?? output?.appId,
            nextId: resolved.appId,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const appId = olds?.appId
        ?? output?.appId
        ?? (output?.name
          ? (try Effect.orDie(
            Effect.try({ try: () => parseResourceName(output.name, "apps", env.region), catch: (e) => e }),
          )).id
          : "")
      const name = output?.name ?? (appId.length > 0 ? resourceName(env.project, location, appId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      const labeled = try ownedByAlchemyLabels(id, existing.metadata)
      const described = try ownedByAlchemy(id, existing.description)
      return labeled || described
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const apps = try listApps(
        try Effect.orDie(Effect.try({ try: () => locationParent(env.project, env.region), catch: (e) => e })),
      )
      return apps.filter(isOwnedApp).map((app) => toAttrs(app, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const appId = try toPhysicalId(id, news.appId, output?.appId)
      const name = output?.name ?? resourceName(env.project, location, appId)
      const parent = try Effect.orDie(
        Effect.try({ try: () => locationParent(env.project, location), catch: (e) => e }),
      )
      const ownership = try createInternalLabels(id)
      const description = try Effect.orDie(
        Effect.try({ try: () => encodeOwnership(ownership, news.description), catch: (e) => e }),
      )
      const metadata = { ...news.metadata, ...ownership }
      const displayName = news.displayName ?? appId
      const timeZoneSettings = timeZoneSettingsOf(news)
      const modelSettings = modelSettingsOf(news)

      let current = try getByName(name)

      if (current === undefined) {
        const created = retryTransient(
          ces.createProjectsLocationsApps({
            parent,
            appId,
            body: {
              displayName,
              description,
              metadata,
              globalInstruction: news.globalInstruction,
              toolExecutionMode: news.toolExecutionMode,
              timeZoneSettings,
              modelSettings,
              rootAgent: news.rootAgent,
              guardrails: news.guardrails,
              locked: news.locked,
              pinned: news.pinned,
              defaultChannelProfile: news.defaultChannelProfile,
              languageSettings: news.languageSettings,
            },
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitForVisible(getByName(name))
      }

      if (current === undefined) {
        throw new AppNotResolved({ resourceName: name })
      }

      const currentName = current.name ?? name
      const displayChanged = !sameText(current.displayName, displayName)
      const descriptionChanged = !sameText(current.description, description)
      const metadataChanged =
        !(try Effect.orDie(Effect.try({ try: sameJson.bind(undefined, current.metadata, metadata), catch: (e) => e })))
      const instructionChanged = !sameText(current.globalInstruction, news.globalInstruction)
      const modeChanged = !sameText(current.toolExecutionMode, news.toolExecutionMode)
      const zoneChanged = !(try Effect.orDie(
        Effect.try({ try: sameJson.bind(undefined, current.timeZoneSettings, timeZoneSettings), catch: (e) => e }),
      ))
      const modelChanged = !(try Effect.orDie(
        Effect.try({ try: sameJson.bind(undefined, current.modelSettings, modelSettings), catch: (e) => e }),
      ))
      const rootChanged = !sameText(current.rootAgent, news.rootAgent)
      const guardrailsChanged = !(try Effect.orDie(
        Effect.try({ try: sameJson.bind(undefined, current.guardrails, news.guardrails), catch: (e) => e }),
      ))
      const lockedChanged = (current.locked === true) !== (news.locked === true)
      const pinnedChanged = (current.pinned === true) !== (news.pinned === true)
      const channelChanged = !(try Effect.orDie(
        Effect.try({
          try: sameJson.bind(undefined, current.defaultChannelProfile, news.defaultChannelProfile),
          catch: (e) => e,
        }),
      ))
      const languageChanged = !(try Effect.orDie(
        Effect.try({
          try: sameJson.bind(undefined, current.languageSettings, news.languageSettings),
          catch: (e) => e,
        }),
      ))

      if (
        displayChanged
        || descriptionChanged
        || metadataChanged
        || instructionChanged
        || modeChanged
        || zoneChanged
        || modelChanged
        || rootChanged
        || guardrailsChanged
        || lockedChanged
        || pinnedChanged
        || channelChanged
        || languageChanged
      ) {
        current = try retryTransient(
          ces.patchProjectsLocationsApps({
            name: currentName,
            updateMask: try Effect.orDie(Effect.try({
              try: () =>
                updateMaskOf(
                  displayChanged ? "display_name" : undefined,
                  descriptionChanged ? "description" : undefined,
                  metadataChanged ? "metadata" : undefined,
                  instructionChanged ? "global_instruction" : undefined,
                  modeChanged ? "tool_execution_mode" : undefined,
                  zoneChanged ? "time_zone_settings" : undefined,
                  modelChanged ? "model_settings" : undefined,
                  rootChanged ? "root_agent" : undefined,
                  guardrailsChanged ? "guardrails" : undefined,
                  lockedChanged ? "locked" : undefined,
                  pinnedChanged ? "pinned" : undefined,
                  channelChanged ? "default_channel_profile" : undefined,
                  languageChanged ? "language_settings" : undefined,
                ),
              catch: (e) => e,
            })),
            body: {
              displayName,
              description,
              metadata,
              globalInstruction: news.globalInstruction,
              toolExecutionMode: news.toolExecutionMode,
              timeZoneSettings,
              modelSettings,
              rootAgent: news.rootAgent,
              guardrails: news.guardrails,
              locked: news.locked,
              pinned: news.pinned,
              defaultChannelProfile: news.defaultChannelProfile,
              languageSettings: news.languageSettings,
            },
          }),
        )
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      const deleted = retryTransient(
        ces.deleteProjectsLocationsApps({ name: output.name }),
      ) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (deleted !== undefined) {
        try waitForDeleteOperation(deleted)
      }
      try waitUntilGone(getByName(output.name))
    },
  })
