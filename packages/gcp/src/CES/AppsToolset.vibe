import * as ces from "@distilled.cloud/gcp/ces_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  DEFAULT_OPENAPI_SCHEMA,
  expandApp,
  forEachApp,
  normalizeLocation,
  parseOwnership,
  parseResourceName,
  replaceOnIdentity,
  retryTransient,
  sameJson,
  sameText,
  toPhysicalId,
  toolsetKind,
  updateMaskOf,
  waitUntilGone,
} from "./internal.ts"

export type AppsToolsetProps = {
  /**
   * Parent CES app. Full name
   * `projects/{project}/locations/{location}/apps/{app}` or the app id
   * (combined with `location`). Immutable — changing it replaces the
   * toolset.
   */
  app: string
  /**
   * Region used when `app` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * Toolset id. If omitted, a unique name is generated. Immutable —
   * changing it replaces the toolset.
   */
  toolsetId?: string
  /**
   * Human-readable name. Must be unique within the app. Alchemy falls
   * back to the generated toolset id.
   */
  displayName?: string
  /**
   * Human-readable description.
   */
  description?: string
  /**
   * Execution type for tools in the toolset.
   */
  executionType?: string
  /**
   * Fake-mode configuration.
   */
  toolFakeConfig?: ces.ToolFakeConfig
  /**
   * OpenAPI toolset. Used when no other toolset variant is set.
   */
  openApiToolset?: ces.OpenApiToolset
  /** MCP toolset. */
  mcpToolset?: ces.McpToolset
  /** Integration Connectors toolset. */
  connectorToolset?: ces.ConnectorToolset
}

export type AppsToolset = Resource<
  "GCP.CES.AppsToolset",
  AppsToolsetProps,
  {
    /** Full resource name `.../apps/{app}/toolsets/{toolset}`. */
    name: string
    /** Toolset id (last path segment). */
    toolsetId: string
    /** Parent app resource name. */
    app: string
    /** Location id. */
    location: string
    /** Project id. */
    project: string
    /** Display name. */
    displayName: string | undefined
    /** User description with the Alchemy ownership prefix stripped. */
    description: string | undefined
    /** Execution type. */
    executionType: string | undefined
    /** Fake-mode configuration. */
    toolFakeConfig: ces.ToolFakeConfig | undefined
    /** OpenAPI toolset. */
    openApiToolset: ces.OpenApiToolset | undefined
    /** MCP toolset. */
    mcpToolset: ces.McpToolset | undefined
    /** Connector toolset. */
    connectorToolset: ces.ConnectorToolset | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
    /** Server-assigned etag. */
    etag: string | undefined
  },
  never,
  Providers
>

/**
 * A Customer Engagement Suite toolset — a dynamically managed group of
 * tools defined by OpenAPI, MCP, or Integration Connectors.
 *
 * Toolsets have no labels field, and the description reaches the model,
 * so Alchemy writes no ownership marker: a generated toolset id
 * identifies the toolset, and `read` reports an explicit id it has no
 * state for as unowned. Parent app, location, toolset id, and toolset
 * kind are immutable.
 *
 * ### Creating a Toolset
 * **Example:** OpenAPI ping toolset
 * ```typescript
 * const toolset = yield* GCP.CES.AppsToolset("Ping", {
 *   app: app.name,
 *   displayName: "ping",
 *   openApiToolset: {
 *     openApiSchema: JSON.stringify({
 *       openapi: "3.0.0",
 *       info: { title: "Ping", version: "1.0.0" },
 *       paths: {
 *         "/ping": {
 *           get: {
 *             operationId: "ping",
 *             responses: { "200": { description: "ok" } },
 *           },
 *         },
 *       },
 *     }),
 *   },
 * });
 * ```
 *
 * @resource
 * @category CES
 */
export const AppsToolset = Resource<AppsToolset>("GCP.CES.AppsToolset")

// @vibelang-diagnostics-next-line EK4830:off
export class AppsToolsetNotResolved extends Data.TaggedError("GCP.CES.AppsToolsetNotResolved")<{
  resourceName: string
}> {}

const resourceName = (app: string, toolsetId: string): infer _ => `${app}/toolsets/${toolsetId}`

const openApiOf = (news: AppsToolsetProps): ces.OpenApiToolset | undefined => {
  if (news.mcpToolset || news.connectorToolset) return news.openApiToolset
  return (
    news.openApiToolset ?? {
      openApiSchema: DEFAULT_OPENAPI_SCHEMA,
    }
  )
}

const toAttrs = (toolset: ces.Toolset, project: string, region: string, appHint?: string): infer _ => {
  const name = toolset.name ?? ""
  const parsed = parseResourceName(name, "toolsets", region)
  return {
    name,
    toolsetId: parsed.id,
    app: name.includes("/toolsets/") ? parsed.app : (appHint ?? parsed.parent),
    location: parsed.location,
    project: parsed.project || project,
    displayName: toolset.displayName,
    description: parseOwnership(toolset.description).text,
    executionType: toolset.executionType,
    toolFakeConfig: toolset.toolFakeConfig,
    openApiToolset: toolset.openApiToolset,
    mcpToolset: toolset.mcpToolset,
    connectorToolset: toolset.connectorToolset,
    createTime: toolset.createTime,
    updateTime: toolset.updateTime,
    etag: toolset.etag,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : ces
  .getProjectsLocationsAppsToolsets({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string, region: string) =>
  (try collectPages(
    ces.listProjectsLocationsAppsToolsets.pages({ parent, pageSize: 100 }),
    (page) => page.toolsets,
  )).map((toolset) => toAttrs(toolset, project, region, parent))

export const AppsToolsetProvider = (): infer _ =>
  Provider.succeed(AppsToolset, {
    stables: ["name", "toolsetId", "app", "location", "project", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousKind = try Effect.orDie(
        Effect.try({ try: () => toolsetKind(olds ?? output ?? {}), catch: (e) => e }),
      )
      const nextKind = try Effect.orDie(Effect.try({ try: () => toolsetKind(resolved), catch: (e) => e }))
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.toolsetId ?? output?.toolsetId,
            nextId: resolved.toolsetId,
            previousParent: olds?.app ?? output?.app,
            nextParent: resolved.app,
            extra: previousKind !== nextKind && previousKind !== "openApiToolset",
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const app = olds?.app
        ? try Effect.orDie(Effect.try({ try: () => expandApp(olds.app, env.project, location), catch: (e) => e }))
        : output?.app
      const toolsetId = try toPhysicalId(id, olds?.toolsetId, output?.toolsetId)
      const name = output?.name ?? (app !== undefined ? resourceName(app, toolsetId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region, app)
      return output !== undefined || olds?.toolsetId === undefined
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      return try forEachApp(
        env.project,
        effect (parent) => try listAt(parent, env.project, env.region),
        env.region,
      )
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const app = try Effect.orDie(
        Effect.try({ try: () => expandApp(news.app, env.project, location), catch: (e) => e }),
      )
      const toolsetId = try toPhysicalId(id, news.toolsetId, output?.toolsetId)
      const name = output?.name ?? resourceName(app, toolsetId)
      const description = news.description
      const displayName = news.displayName ?? toolsetId
      const openApiToolset = openApiOf(news)
      const kind = try Effect.orDie(Effect.try({
        try: () =>
          toolsetKind({
            openApiToolset,
            mcpToolset: news.mcpToolset,
            connectorToolset: news.connectorToolset,
          }),
        catch: (e) => e,
      }))

      let current = try getByName(name)

      if (current === undefined) {
        const created = retryTransient(
          ces.createProjectsLocationsAppsToolsets({
            parent: app,
            toolsetId,
            body: {
              displayName,
              description,
              executionType: news.executionType,
              toolFakeConfig: news.toolFakeConfig,
              openApiToolset,
              mcpToolset: news.mcpToolset,
              connectorToolset: news.connectorToolset,
            },
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new AppsToolsetNotResolved({ resourceName: name })
      }

      const currentName = current.name ?? name
      const displayChanged = !sameText(current.displayName, displayName)
      const descriptionChanged = !sameText(current.description, description)
      const executionChanged = !sameText(current.executionType, news.executionType)
      const fakeChanged = !(try Effect.orDie(
        Effect.try({ try: sameJson.bind(undefined, current.toolFakeConfig, news.toolFakeConfig), catch: (e) => e }),
      ))
      const variantChanged = kind === "openApiToolset"
        ? !(try Effect.orDie(
          Effect.try({ try: sameJson.bind(undefined, current.openApiToolset, openApiToolset), catch: (e) => e }),
        ))
        : kind === "mcpToolset"
        ? !(try Effect.orDie(
          Effect.try({ try: sameJson.bind(undefined, current.mcpToolset, news.mcpToolset), catch: (e) => e }),
        ))
        : !(try Effect.orDie(
          Effect.try({
            try: sameJson.bind(undefined, current.connectorToolset, news.connectorToolset),
            catch: (e) => e,
          }),
        ))

      if (
        displayChanged
        || descriptionChanged
        || executionChanged
        || fakeChanged
        || variantChanged
      ) {
        current = try retryTransient(
          ces.patchProjectsLocationsAppsToolsets({
            name: currentName,
            updateMask: try Effect.orDie(Effect.try({
              try: () =>
                updateMaskOf(
                  displayChanged ? "display_name" : undefined,
                  descriptionChanged ? "description" : undefined,
                  executionChanged ? "execution_type" : undefined,
                  fakeChanged ? "tool_fake_config" : undefined,
                  variantChanged
                    ? kind === "openApiToolset"
                      ? "open_api_toolset"
                      : kind === "mcpToolset"
                      ? "mcp_toolset"
                      : "connector_toolset"
                    : undefined,
                ),
              catch: (e) => e,
            })),
            body: {
              displayName,
              description,
              executionType: news.executionType,
              toolFakeConfig: news.toolFakeConfig,
              openApiToolset,
              mcpToolset: news.mcpToolset,
              connectorToolset: news.connectorToolset,
            },
          }),
        )
      }

      return toAttrs(current, env.project, env.region, app)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      retryTransient(
        ces.deleteProjectsLocationsAppsToolsets({
          name: output.name,
          force: true,
        }),
      ) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name))
    },
  })
