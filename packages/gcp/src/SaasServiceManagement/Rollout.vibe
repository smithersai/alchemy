import * as saasservicemgmt from "@distilled.cloud/gcp/saasservicemgmt_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  ResourceNotResolved,
  collectPages,
  expandName,
  fieldMask,
  fingerprint,
  hasAlchemyLabelKeys,
  lastSegment,
  normalizeLocation,
  parentOf,
  parseName,
  replaceOnIdentity,
  resourceName,
  sameRef,
  toPhysicalId,
  userAnnotations,
  userLabels,
  waitUntilGone,
} from "./internal.vibe"

const COLLECTION = "rollouts"

export type RolloutControlAction = saasservicemgmt.RolloutControlActionEnum | (string & {})

export type RolloutControl = {
  mutable action?: RolloutControlAction
  mutable runParams?: { mutable retryFailedOperations?: boolean }
}

export type RolloutStats = {
  mutable operationsByState?: Array<{ mutable count?: number; mutable group?: string }>
  mutable estimatedTotalUnitCount?: string
}

export type RolloutProps = {
  /**
   * Rollout id (the `{rollout_id}` segment of
   * `projects/{project}/locations/{location}/rollouts/{rollout_id}`). If
   * omitted, a unique RFC1035 name is generated. Immutable — changing
   * it replaces the rollout.
   */
  mutable rolloutId?: string
  /**
   * Region of the rollout (`us-central1`, …). Immutable — changing it
   * replaces the rollout. `US-CENTRAL1` is accepted and normalized to
   * `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  mutable location?: string
  /**
   * RolloutKind this rollout follows. Accepts a rollout kind id or a
   * full resource name. Immutable — changing it replaces the rollout.
   */
  mutable rolloutKind?: string
  /**
   * Release rolled out to target units. Mutually exclusive with
   * `flagRelease`. Immutable — changing it replaces the rollout.
   */
  mutable release?: string
  /**
   * Flag release rolled out to target units. Mutually exclusive with
   * `release`. Immutable — changing it replaces the rollout.
   */
  mutable flagRelease?: string
  /**
   * CEL filter reducing the eligible unit population for this rollout.
   */
  mutable unitFilter?: string
  /**
   * Orchestration strategy override. If omitted, the RolloutKind
   * strategy is used.
   */
  mutable rolloutOrchestrationStrategy?: string
  /**
   * Requested execution change (`ROLLOUT_ACTION_RUN`,
   * `ROLLOUT_ACTION_PAUSE`, `ROLLOUT_ACTION_CANCEL`).
   */
  mutable control?: RolloutControl
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  mutable labels?: Record<string, string>
  /**
   * Unstructured annotations preserved across updates.
   */
  mutable annotations?: Record<string, string>
}

export type Rollout = Resource<
  "GCP.SaasServiceManagement.Rollout",
  RolloutProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/rollouts/{rollout_id}`. */
    mutable name: string
    /** Rollout id (last path segment). */
    mutable rolloutId: string
    /** Project id. */
    mutable project: string
    /** Location id. */
    mutable location: string
    /** RolloutKind resource name. */
    mutable rolloutKind: string | undefined
    /** RolloutKind id (last path segment). */
    mutable rolloutKindId: string | undefined
    /** Release resource name. */
    mutable release: string | undefined
    /** Release id (last path segment). */
    mutable releaseId: string | undefined
    /** Flag release resource name. */
    mutable flagRelease: string | undefined
    /** CEL unit filter. */
    mutable unitFilter: string | undefined
    /** Effective unit filter snapshotted at start. */
    mutable effectiveUnitFilter: string | undefined
    /** Orchestration strategy. */
    mutable rolloutOrchestrationStrategy: string | undefined
    /** Requested control action. */
    mutable control: RolloutControl | undefined
    /** Lifecycle state. */
    mutable state: string | undefined
    /** Human-readable last-transition message. */
    mutable stateMessage: string | undefined
    /** Progress stats. */
    mutable stats: RolloutStats | undefined
    /** Root rollout this one stems from. */
    mutable rootRollout: string | undefined
    /** Direct parent rollout. */
    mutable parentRollout: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    mutable labels: Record<string, string>
    /** User annotations. */
    mutable annotations: Record<string, string>
    /** Server UUID. */
    mutable uid: string | undefined
    /** Server etag. */
    mutable etag: string | undefined
    /** RFC3339 creation timestamp. */
    mutable createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    mutable updateTime: string | undefined
    /** RFC3339 start timestamp. */
    mutable startTime: string | undefined
    /** RFC3339 end timestamp. */
    mutable endTime: string | undefined
  },
  never,
  Providers
>

/**
 * An App Lifecycle Manager rollout — one execution of a RolloutKind
 * against a Release (or FlagRelease).
 *
 * `rolloutId`, `location`, `rolloutKind`, `release`, and `flagRelease`
 * replace the rollout. Unit filter, strategy override, control action,
 * labels, and annotations update in place. Requests to pause or cancel
 * are only accepted while the rollout is non-terminal.
 *
 * ### Creating a Rollout
 * **Example:** Roll a release
 * ```typescript
 * const rollout = yield* GCP.SaasServiceManagement.Rollout("Wave1", {
 *   rolloutKind: kind.name,
 *   release: release.name,
 *   labels: { env: "prod" },
 * });
 * ```
 *
 * ### Updating a Rollout
 * **Example:** Pause
 * ```typescript
 * const rollout = yield* GCP.SaasServiceManagement.Rollout("Wave1", {
 *   rolloutId: rollout.rolloutId,
 *   rolloutKind: kind.name,
 *   release: release.name,
 *   control: { action: "ROLLOUT_ACTION_PAUSE" },
 * });
 * ```
 *
 * @resource
 * @category SaasServiceManagement
 */
export const Rollout = Resource<Rollout>("GCP.SaasServiceManagement.Rollout")

const toAttrs = (item: saasservicemgmt.Rollout, project: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, COLLECTION)
  return {
    name,
    rolloutId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    rolloutKind: item.rolloutKind,
    rolloutKindId: item.rolloutKind ? lastSegment(item.rolloutKind) : undefined,
    release: item.release,
    releaseId: item.release ? lastSegment(item.release) : undefined,
    flagRelease: item.flagRelease,
    unitFilter: item.unitFilter,
    effectiveUnitFilter: item.effectiveUnitFilter,
    rolloutOrchestrationStrategy: item.rolloutOrchestrationStrategy,
    control: item.control
      ? {
        action: item.control.action,
        runParams: item.control.runParams,
      }
      : undefined,
    state: item.state,
    stateMessage: item.stateMessage,
    stats: item.stats,
    rootRollout: item.rootRollout,
    parentRollout: item.parentRollout,
    labels: userLabels(item.labels),
    annotations: userAnnotations(item.annotations),
    uid: item.uid,
    etag: item.etag,
    createTime: item.createTime,
    updateTime: item.updateTime,
    startTime: item.startTime,
    endTime: item.endTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : saasservicemgmt
  .getProjectsLocationsRollouts({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listOwned = effect (project: string, location: string) =>
  try effect {
    const items = (try collectPages(
      saasservicemgmt.listProjectsLocationsRollouts.pages({
        parent: parentOf(project, "-"),
        pageSize: 1000,
      }),
      (page) => page.rollouts,
    )).filter((item) => hasAlchemyLabelKeys(item.labels))
    return (items.length > 0 ? items : (try collectPages(
      saasservicemgmt.listProjectsLocationsRollouts.pages({
        parent: parentOf(project, location),
        pageSize: 1000,
      }),
      (page) => page.rollouts,
    )).filter((item) => hasAlchemyLabelKeys(item.labels)))
  }

export const RolloutProvider = (): infer _ =>
  Provider.succeed(Rollout, {
    stables: [
      "name",
      "rolloutId",
      "project",
      "location",
      "rolloutKindId",
      "releaseId",
      "uid",
      "createTime",
    ],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const env = try GcpEnvironment.current
      return replaceOnIdentity({
        previousId: olds?.rolloutId ?? output?.rolloutId,
        nextId: news.rolloutId ?? olds?.rolloutId ?? output?.rolloutId,
        previousLocation: normalizeLocation(olds?.location ?? output?.location ?? env.region),
        nextLocation: normalizeLocation(
          news.location ?? olds?.location ?? output?.location ?? env.region,
        ),
        extra: (news.rolloutKind !== undefined
          && !sameRef(olds?.rolloutKind ?? output?.rolloutKind, news.rolloutKind))
          || (news.release !== undefined
            && !sameRef(olds?.release ?? output?.release, news.release))
          || (news.flagRelease !== undefined
            && (olds?.flagRelease ?? output?.flagRelease ?? "") !== news.flagRelease),
      })
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const rolloutId = try toPhysicalId(id, olds?.rolloutId, output?.rolloutId, "rlo")
      const location = normalizeLocation(olds?.location ?? output?.location ?? env.region)
      const name = output?.name ?? resourceName(env.project, location, COLLECTION, rolloutId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(id, tagRecord(existing.labels))) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listOwned(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const rolloutId = try toPhysicalId(id, news.rolloutId, output?.rolloutId, "rlo")
      const location = normalizeLocation(news.location ?? output?.location ?? env.region)
      const name = resourceName(env.project, location, COLLECTION, rolloutId)
      const desiredLabels = {
        ...toLabels(news.labels),
        ...(try createInternalLabels(id)),
      }
      const rolloutKind = news.rolloutKind === undefined
        ? undefined
        : expandName(news.rolloutKind, env.project, location, "rolloutKinds")
      const release = news.release === undefined
        ? undefined
        : expandName(news.release, env.project, location, "releases")
      const annotations = news.annotations

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = saasservicemgmt
          .createProjectsLocationsRollouts({
            parent: parentOf(env.project, location),
            rolloutId,
            body: {
              rolloutKind,
              release,
              flagRelease: news.flagRelease,
              unitFilter: news.unitFilter,
              rolloutOrchestrationStrategy: news.rolloutOrchestrationStrategy,
              control: news.control,
              labels: desiredLabels,
              annotations,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = diffLabels(observedLabels, desiredLabels)
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const annotationsChanged = annotations !== undefined
        && fingerprint(userAnnotations(current.annotations)) !== fingerprint(annotations)
      const filterChanged = news.unitFilter !== undefined && (current.unitFilter ?? "") !== news.unitFilter
      const strategyChanged = news.rolloutOrchestrationStrategy !== undefined
        && (current.rolloutOrchestrationStrategy ?? "") !== news.rolloutOrchestrationStrategy
      const controlChanged = news.control !== undefined && fingerprint(current.control) !== fingerprint(news.control)
      const mask = fieldMask([
        labelsChanged && "labels",
        annotationsChanged && "annotations",
        filterChanged && "unitFilter",
        strategyChanged && "rolloutOrchestrationStrategy",
        controlChanged && "control",
      ])

      if (mask.length > 0) {
        current = try saasservicemgmt.patchProjectsLocationsRollouts({
          name: current.name ?? name,
          updateMask: mask,
          body: {
            name: current.name ?? name,
            etag: current.etag,
            unitFilter: news.unitFilter,
            rolloutOrchestrationStrategy: news.rolloutOrchestrationStrategy,
            control: news.control,
            labels: desiredLabels,
            annotations,
          },
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      ;(try (saasservicemgmt.deleteProjectsLocationsRollouts({ name: output.name })
        |> Effect.retry(%, {
          while: (error) => error._tag === "Conflict",
          times: 8,
          schedule: Schedule.spaced("2 seconds"),
        }))) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
