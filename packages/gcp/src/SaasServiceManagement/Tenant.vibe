import * as saasservicemgmt from "@distilled.cloud/gcp/saasservicemgmt_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  ResourceNotResolved,
  collectPages,
  expandName,
  fieldMask,
  fingerprint,
  hasAlchemyLabelKeys,
  lastSegment,
  normalizeLocation,
  parentOf,
  parseName,
  replaceOnIdentity,
  resourceName,
  sameRef,
  toPhysicalId,
  userAnnotations,
  userLabels,
  waitUntilGone,
} from "./internal.vibe"

const COLLECTION = "tenants"

export type TenantProps = {
  /**
   * Tenant id (the `{tenant}` segment of
   * `projects/{project}/locations/{location}/tenants/{tenant}`). If
   * omitted, a unique RFC1035 name is generated. Immutable — changing
   * it replaces the tenant.
   */
  tenantId?: string
  /**
   * Region of the tenant (`us-central1`, …). Immutable — changing it
   * replaces the tenant. `US-CENTRAL1` is accepted and normalized to
   * `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * SaaS this tenant belongs to. Accepts a SaaS id or a full resource
   * name. Immutable — changing it replaces the tenant.
   */
  saas: string
  /**
   * Consumer resource this tenant represents, e.g. a Cloud resource
   * handed to the customer. Immutable — changing it replaces the
   * tenant.
   */
  consumerResource?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Unstructured annotations preserved across updates.
   */
  annotations?: Record<string, string>
}

export type Tenant = Resource<
  "GCP.SaasServiceManagement.Tenant",
  TenantProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/tenants/{tenant}`. */
    name: string
    /** Tenant id (last path segment). */
    tenantId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** SaaS resource name. */
    saas: string | undefined
    /** SaaS id (last path segment). */
    saasId: string | undefined
    /** Consumer resource this tenant represents. */
    consumerResource: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** User annotations. */
    annotations: Record<string, string>
    /** Server UUID. */
    uid: string | undefined
    /** Server etag. */
    etag: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * An App Lifecycle Manager tenant — the producer-side instance of a
 * SaaS created for one consumer.
 *
 * `tenantId`, `location`, `saas`, and `consumerResource` replace the
 * tenant. Labels and annotations update in place.
 *
 * ### Creating a Tenant
 * **Example:** Tenant of a SaaS
 * ```typescript
 * const product = yield* GCP.SaasServiceManagement.Saa("Inventory", {
 *   locations: [{ name: "us-central1" }],
 * });
 * const tenant = yield* GCP.SaasServiceManagement.Tenant("Acme", {
 *   saas: product.name,
 *   labels: { env: "prod" },
 * });
 * ```
 *
 * ### Updating a Tenant
 * **Example:** Relabel
 * ```typescript
 * const tenant = yield* GCP.SaasServiceManagement.Tenant("Acme", {
 *   tenantId: "acme",
 *   saas: product.name,
 *   labels: { env: "prod", customer: "acme" },
 * });
 * ```
 *
 * @resource
 * @category SaasServiceManagement
 */
export const Tenant = Resource<Tenant>("GCP.SaasServiceManagement.Tenant")

const toAttrs = (item: saasservicemgmt.Tenant, project: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, COLLECTION)
  return {
    name,
    tenantId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    saas: item.saas,
    saasId: item.saas ? lastSegment(item.saas) : undefined,
    consumerResource: item.consumerResource,
    labels: userLabels(item.labels),
    annotations: userAnnotations(item.annotations),
    uid: item.uid,
    etag: item.etag,
    createTime: item.createTime,
    updateTime: item.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : saasservicemgmt
  .getProjectsLocationsTenants({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listOwned = effect (project: string, location: string) =>
  try effect {
    const items = (try collectPages(
      saasservicemgmt.listProjectsLocationsTenants.pages({
        parent: parentOf(project, "-"),
        pageSize: 1000,
      }),
      (page) => page.tenants,
    )).filter((item) => hasAlchemyLabelKeys(item.labels))
    return (items.length > 0 ? items : (try collectPages(
      saasservicemgmt.listProjectsLocationsTenants.pages({
        parent: parentOf(project, location),
        pageSize: 1000,
      }),
      (page) => page.tenants,
    )).filter((item) => hasAlchemyLabelKeys(item.labels)))
  }

export const TenantProvider = (): infer _ =>
  Provider.succeed(Tenant, {
    stables: ["name", "tenantId", "project", "location", "saasId", "uid", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      return replaceOnIdentity({
        previousId: olds?.tenantId ?? output?.tenantId,
        nextId: resolved.tenantId ?? olds?.tenantId ?? output?.tenantId,
        previousLocation: normalizeLocation(olds?.location ?? output?.location ?? env.region),
        nextLocation: normalizeLocation(
          resolved.location ?? olds?.location ?? output?.location ?? env.region,
        ),
        extra: !sameRef(olds?.saas ?? output?.saas, resolved.saas)
          || (olds?.consumerResource ?? output?.consumerResource ?? "")
            !== (resolved.consumerResource ?? olds?.consumerResource ?? output?.consumerResource ?? ""),
      })
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const tenantId = try toPhysicalId(id, olds?.tenantId, output?.tenantId, "tnt")
      const location = normalizeLocation(olds?.location ?? output?.location ?? env.region)
      const name = output?.name ?? resourceName(env.project, location, COLLECTION, tenantId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listOwned(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const tenantId = try toPhysicalId(id, news.tenantId, output?.tenantId, "tnt")
      const location = normalizeLocation(news.location ?? output?.location ?? env.region)
      const name = resourceName(env.project, location, COLLECTION, tenantId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }
      const saas = expandName(news.saas, env.project, location, "saas")
      const annotations = news.annotations

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = (effect {
          return (try (saasservicemgmt
            .createProjectsLocationsTenants({
              parent: parentOf(env.project, location),
              tenantId,
              body: {
                saas,
                consumerResource: news.consumerResource,
                labels: desiredLabels,
                annotations,
              },
            })
            |> Effect.retry(%, {
              while: (error) => error._tag === "SaasNotFound",
              schedule: Schedule.spaced("2 seconds"),
              times: 15,
            })))
        }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const annotationsChanged = annotations !== undefined
        && fingerprint(userAnnotations(current.annotations)) !== fingerprint(annotations)
      const mask = fieldMask([labelsChanged && "labels", annotationsChanged && "annotations"])

      if (mask.length > 0) {
        current = try saasservicemgmt.patchProjectsLocationsTenants({
          name: current.name ?? name,
          updateMask: mask,
          body: {
            name: current.name ?? name,
            etag: current.etag,
            labels: desiredLabels,
            annotations,
          },
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      ;(effect {
        return (try (saasservicemgmt.deleteProjectsLocationsTenants({ name: output.name })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
