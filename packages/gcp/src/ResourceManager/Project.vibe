import * as resourcemanager from "@distilled.cloud/gcp/cloudresourcemanager_v3"
import * as resourcemanagerV1 from "@distilled.cloud/gcp/unstable/cloudresourcemanager_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import * as Schedule from "effect/Schedule"
import { createInternalLabels, diffLabels, hasAlchemyLabels, stripInternalLabels, toLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  PROJECT_DISPLAY_MAX,
  PROJECT_DISPLAY_MIN,
  PROJECT_ID_MAX,
  PROJECT_ID_MIN,
  collectPages,
  isDeleteRequested,
  lastSegment,
  projectIdFromOperation,
  normalizeHierarchyParent,
  resourceNameFromOperation,
  sameHierarchyParent,
  tryResolveParent,
  waitForOperation,
  waitForCreate,
} from "./internal.vibe"

export type ProjectProps = {
  /**
   * Globally unique project id. 6-30 lowercase letters, digits, or
   * hyphens; must start with a letter and must not end with a hyphen.
   * If omitted, a unique id is generated from the stack, stage, and
   * logical id. Immutable — changing it replaces the project.
   */
  projectId?: string
  /**
   * Parent `organizations/{org}` or `folders/{folder}`. Defaults to the
   * current project's parent; when the current project has none, the
   * project is created standalone. Changing parent moves the project.
   */
  parent?: string
  /**
   * User-assigned display name (4-30 characters). Defaults to the
   * project id when omitted.
   */
  displayName?: string
  /**
   * User labels. Alchemy ownership labels (`alchemy-stack`,
   * `alchemy-stage`, `alchemy-id`) are merged in automatically.
   */
  labels?: Record<string, string>
}

export type Project = Resource<
  "GCP.ResourceManager.Project",
  ProjectProps,
  {
    /** Resource name `projects/{project_number}`. */
    name: string
    /** User-assigned project id. */
    projectId: string
    /** Parent `organizations/{org}` or `folders/{folder}`; `undefined` when standalone. */
    parent: string | undefined
    /** User-assigned display name. */
    displayName: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Lifecycle state (`ACTIVE` or `DELETE_REQUESTED`). */
    state: string | undefined
    /** Server etag for optimistic concurrency. */
    etag: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
    /** RFC3339 time a delete was requested, if any. */
    deleteTime: string | undefined
    /** Configured capabilities when this is a management project. */
    configuredCapabilities: string[]
  },
  never,
  Providers
>

/**
 * A Google Cloud project — the container for APIs, IAM, billing, and
 * other resources.
 *
 * `projectId` is globally unique and immutable; changing it replaces
 * the project. `parent` is moved in place. `displayName` and `labels`
 * update in place. Delete is a 30-day soft-delete (`DELETE_REQUESTED`).
 * Alchemy ownership labels are applied so `list` / `pnpm nuke:gcp` can
 * find leftover projects.
 *
 * ### Creating a Project
 * **Example:** Generated project id under the current project's parent
 * ```typescript
 * const project = yield* GCP.ResourceManager.Project("Sandbox", {});
 * ```
 *
 * **Example:** Explicit id, parent, and labels
 * ```typescript
 * const project = yield* GCP.ResourceManager.Project("Sandbox", {
 *   projectId: "my-app-sandbox",
 *   parent: "folders/123456789",
 *   displayName: "Sandbox",
 *   labels: { env: "test" },
 * });
 * ```
 *
 * **Example:** Standalone project without an organization or folder
 * ```typescript
 * // With no `parent`, the project lands under the current project's
 * // organization or folder. When the current project has none, it is
 * // created standalone and `parent` is `undefined`. Google only lets user
 * // credentials create standalone projects, not service accounts.
 * const project = yield* GCP.ResourceManager.Project("Sandbox", {
 *   displayName: "Sandbox",
 * });
 * ```
 *
 * ### Updating a Project
 * **Example:** Change display name and labels
 * ```typescript
 * const project = yield* GCP.ResourceManager.Project("Sandbox", {
 *   projectId: "my-app-sandbox",
 *   displayName: "Sandbox prod",
 *   labels: { env: "prod" },
 * });
 * ```
 *
 * @resource
 * @category ResourceManager
 */
export const Project = Resource<Project>("GCP.ResourceManager.Project")

// @vibelang-diagnostics-next-line EK4830:off
export class ProjectNotResolved extends Data.TaggedError("GCP.ResourceManager.ProjectNotResolved")<{
  resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ProjectStillExists extends Data.TaggedError("GCP.ResourceManager.ProjectStillExists")<{
  resourceName: string
}> {}

const userLabels = (
  labels: Record<string, string | undefined> | null | undefined,
): Record<string, string> => stripInternalLabels(tagRecord(labels))

const sanitizeProjectId = (value: string): infer _ => {
  let next = value
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
  if (!/^[a-z]/.test(next)) next = `p${next}`
  next = next.replace(/-+$/g, "")
  if (next.length > PROJECT_ID_MAX) {
    next = next.slice(0, PROJECT_ID_MAX).replace(/-+$/g, "")
  }
  if (next.length < PROJECT_ID_MIN) {
    next = `${next}xxxxxx`.slice(0, PROJECT_ID_MIN)
  }
  return next
}

const toProjectId = effect (id: string, projectId: string | undefined, existing?: string) => {
  if (projectId !== undefined) return sanitizeProjectId(projectId)
  if (existing !== undefined) return existing
  const generated = try createPhysicalName({
    id,
    maxLength: PROJECT_ID_MAX,
    lowercase: true,
  })
  return sanitizeProjectId(generated)
}

const sanitizeDisplayName = (value: string | undefined, fallback: string): infer _ => {
  const source = (value ?? fallback).trim()
  let next = source
    .replace(/[^a-zA-Z0-9 '"\-!]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
  if (next.length === 0) next = fallback
  if (next.length > PROJECT_DISPLAY_MAX) next = next.slice(0, PROJECT_DISPLAY_MAX)
  if (next.length < PROJECT_DISPLAY_MIN) {
    next = `${next} proj`.slice(0, PROJECT_DISPLAY_MIN)
  }
  return next
}

const toAttrs = (project: resourcemanager.Project): infer _ => ({
  name: project.name ?? "",
  projectId: project.projectId ?? lastSegment(project.name ?? ""),
  parent: project.parent || undefined,
  displayName: project.displayName,
  labels: userLabels(project.labels),
  state: project.state,
  etag: project.etag,
  createTime: project.createTime,
  updateTime: project.updateTime,
  deleteTime: project.deleteTime,
  configuredCapabilities: project.configuredCapabilities ?? [],
})

const getByName = effect (name: string) =>
  resourcemanager
    .getProjects({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ProjectNotFound" }: try Effect.undefined;
      default: throw e;
    }

const observe = effect (resourceName: string | undefined, projectId: string) => {
  if (resourceName !== undefined && resourceName.length > 0) {
    const byName = try getByName(resourceName)
    if (byName !== undefined) return byName
  }
  return try getByName(`projects/${projectId}`)
}

const waitUntilExists = effect (resourceName: string | undefined, projectId: string) =>
  try (observe(resourceName, projectId)
    |> Effect.filterOrFail(
      %,
      (project): project is resourcemanager.Project => project !== undefined,
      () =>
        new ProjectNotResolved({
          resourceName: resourceName ?? `projects/${projectId}`,
        }),
    )
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.ResourceManager.ProjectNotResolved",
      times: 8,
      schedule: Schedule.spaced("1 second"),
    }))

const waitUntilGone = effect (name: string) =>
  try (effect {
    return try effect {
      const project = try getByName(name)
      return (project === undefined
          || (try Effect.orDie(Effect.try({ try: () => isDeleteRequested(project.state), catch: (e) => e })))
        ? try Effect.void
        : throw new ProjectStillExists({ resourceName: name }))
    }
  }
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.ResourceManager.ProjectStillExists",
      times: 10,
      schedule: Schedule.spaced("1 second"),
    }))

const ensureActive = effect (project: resourcemanager.Project) => {
  if (
    !(try Effect.orDie(Effect.try({ try: () => isDeleteRequested(project.state), catch: (e) => e })))
    || project.name === undefined
  ) {
    return project
  }
  const operation = try resourcemanager.undeleteProjects({
    name: project.name,
    body: {},
  })
  try waitForOperation(operation)
  return try waitUntilExists(project.name, project.projectId ?? lastSegment(project.name))
}

// Unlike folders, a project may be standalone (no organization or folder).
// No parent omits `parent` on create and never moves the project. A deployed
// project keeps the parent it has, so a standalone one stays out of the
// current project's hierarchy.
const resolveProjectParent = effect (
  explicit: string | undefined,
  output: { readonly parent: string | undefined } | undefined,
) => {
  if (explicit) return try Effect.orDie(Effect.try({ try: () => normalizeHierarchyParent(explicit), catch: (e) => e }))
  if (output !== undefined) {
    return try Effect.orDie(
      Effect.try({ try: () => output.parent ? normalizeHierarchyParent(output.parent) : undefined, catch: (e) => e }),
    )
  }
  return try tryResolveParent()
}

export const ProjectProvider = (): infer _ =>
  Provider.succeed(Project, {
    stables: ["name", "projectId", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved__ = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved__ === undefined) return undefined
      const previousId = olds?.projectId ?? output?.projectId
      const nextId = resolved__.projectId !== undefined ? sanitizeProjectId(resolved__.projectId) : previousId
      const idChanged = previousId !== undefined && resolved__.projectId !== undefined && nextId !== previousId
      if (!idChanged) return undefined
      return { action: "replace" as const, deleteFirst: false }
    },

    read: effect ({ id, olds, output }) => {
      const projectId = try toProjectId(id, olds?.projectId, output?.projectId)
      const existing = try observe(output?.name, projectId)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () =>
      (effect {
        return ((try collectPages(
          resourcemanager.searchProjects.pages({
            query: "labels.alchemy-stack:*",
            pageSize: 300,
          }),
          (page) => page.projects,
        ))
          .filter((project) => Object.keys(project.labels ?? {}).some((key) => key.startsWith("alchemy-")))
          .map(toAttrs))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; },

    reconcile: effect ({ id, news, output }) => {
      const projectId = try toProjectId(id, news.projectId, output?.projectId)
      const parent = try resolveProjectParent(news.parent, output)
      const displayName = sanitizeDisplayName(news.displayName, projectId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try observe(output?.name, projectId)

      if (current === undefined) {
        const created = resourcemanager
          .createProjects({
            body: {
              projectId,
              parent,
              displayName,
              labels: desiredLabels,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          const settled = try waitForCreate(created)
          current = try waitUntilExists(
            (try Effect.orDie(
              Effect.try({ try: () => resourceNameFromOperation(settled, "projects/"), catch: (e) => e }),
            ))
              ?? (try Effect.orDie(
                Effect.try({ try: () => resourceNameFromOperation(created, "projects/"), catch: (e) => e }),
              )),
            (try Effect.orDie(Effect.try({ try: () => projectIdFromOperation(settled), catch: (e) => e })))
              ?? (try Effect.orDie(Effect.try({ try: () => projectIdFromOperation(created), catch: (e) => e })))
              ?? projectId,
          )
        } else {
          current = try waitUntilExists(undefined, projectId)
        }
      }

      if (current === undefined || current.name === undefined) {
        throw new ProjectNotResolved({
          resourceName: `projects/${projectId}`,
        })
      }

      const name = current.name
      current = try ensureActive(current)

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const displayChanged = (current.displayName ?? "") !== displayName

      if (labelsChanged || displayChanged) {
        // v3 `projects.patch` merges labels, so it can never remove one.
        // v1 `projects.update` replaces them (v1 calls the display name `name`).
        const id = current.projectId ?? projectId
        const observed = try resourcemanagerV1.getProjects({ projectId: id })
        try resourcemanagerV1.updateProjects({
          projectId: id,
          body: { ...observed, name: displayName, labels: desiredLabels },
        })
        current = try waitUntilExists(current.name ?? name, projectId)
      }

      if (
        current.parent !== undefined
        && parent !== undefined
        && !sameHierarchyParent(current.parent, parent)
      ) {
        const operation = try resourcemanager.moveProjects({
          name: current.name ?? name,
          body: { destinationParent: parent },
        })
        try waitForOperation(operation)
        current = try waitUntilExists(current.name ?? name, projectId)
      }

      if (current === undefined) {
        throw new ProjectNotResolved({
          resourceName: `projects/${projectId}`,
        })
      }

      return toAttrs(current)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (resourcemanager.deleteProjects({ name: output.name })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) {
        when { _tag: "NotFound" } or { _tag: "ProjectNotFound" }: try Effect.undefined;
        default: throw e;
      }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(output.name)
    },
  })
