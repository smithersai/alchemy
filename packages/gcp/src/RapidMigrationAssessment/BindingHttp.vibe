import { Credentials } from "@distilled.cloud/gcp/Credentials"
import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, grantFor } from "../HttpBinding.ts"
import type { Collector } from "./Collector.vibe"

/**
 * Shared HTTP scaffolding for Rapid Migration Assessment collector
 * bindings. NOT exported from index.ts.
 *
 * Distilled ops are `OperationMethod`s: yield them once at Layer
 * construction (after providing Credentials + HttpClient.HttpClient) so the inner
 * runtime Effect is `Effect<A, E>` and does not leak `GcpOpContext`.
 */
export const makeCollectorHttpBinding = effect <I extends { mutable name?: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation:
    & (((input: I) => A!E)!never!Credentials | HttpClient.HttpClient)
    & ((input: I) => A!E!Credentials | HttpClient.HttpClient)
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (collector: Collector) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${collector})`({
        iam: [grantFor(options.iam, collector.name)],
      })
    }
    const name = try collector.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          const collectorName = try name
          return try run({
            ...request,
            name: collectorName,
          } as I)
        },
        `${options.tag}(${collector.LogicalId})`,
      )
  }
}
