import * as networkservices from "@distilled.cloud/gcp/networkservices_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import {
  DEFAULT_GLOBAL,
  changedFields,
  collectPages,
  hasAlchemyLabelKeys,
  normalizeLocation,
  parentOf,
  parseName,
  resourceName,
  rfc1035,
  toPhysicalId,
  userLabels,
  waitForOperation,
  waitUntilGone,
  waitUntilPresent,
} from "./internal.vibe"

const COLLECTION = "meshes"

export type MeshEnvoyHeaders = networkservices.MeshEnvoyHeadersEnum | (string & {})

export type MeshProps = {
  /**
   * Mesh id (the `{mesh}` segment of
   * `projects/{project}/locations/{location}/meshes/{mesh}`). If omitted,
   * a unique name is generated from the stack, stage, and logical id.
   * Must be 1-63 characters and not start with a number. Immutable —
   * changing it replaces the mesh.
   */
  meshId?: string
  /**
   * Location (`global`, `us-central1`, …). Meshes are typically
   * `global`. Immutable — changing it replaces the mesh. `US-CENTRAL1`
   * is accepted and normalized to `us-central1`.
   * @default "global"
   */
  location?: string
  /**
   * Human-readable description. Max 1024 characters.
   */
  description?: string
  /**
   * Localhost port the sidecar proxy intercepts (1-65535). Unset uses
   * `15001`. Sidecar deployments only.
   */
  interceptionPort?: number
  /**
   * Whether Envoy inserts debug headers on upstream requests.
   * `NONE` (default) or `DEBUG_HEADERS`.
   */
  envoyHeaders?: MeshEnvoyHeaders
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
}

export type Mesh = Resource<
  "GCP.NetworkServices.Mesh",
  MeshProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/meshes/{mesh}`. */
    name: string
    /** Mesh id (last path segment). */
    meshId: string
    /** Project id. */
    project: string
    /** Location id (`global`, `us-central1`, …). */
    location: string
    /** User-provided description. */
    description: string | undefined
    /** Sidecar interception port, if set. */
    interceptionPort: number | undefined
    /** Envoy debug-header insertion mode. */
    envoyHeaders: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Server-defined resource URL. */
    selfLink: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Cloud Service Mesh configuration grouping for workload-to-workload
 * traffic. Routes attached to the mesh decide how requests are routed
 * inside this logical boundary.
 *
 * Changing `meshId` or `location` replaces the mesh. Description,
 * labels, interception port, and Envoy header settings update in place.
 *
 * ### Creating a Mesh
 * **Example:** Generated name
 * ```typescript
 * const mesh = yield* GCP.NetworkServices.Mesh("Sidecar", {});
 * ```
 *
 * **Example:** Named mesh with interception port
 * ```typescript
 * const mesh = yield* GCP.NetworkServices.Mesh("Sidecar", {
 *   meshId: "app-mesh",
 *   description: "prod sidecar mesh",
 *   interceptionPort: 15001,
 *   labels: { env: "prod" },
 * });
 * ```
 *
 * @resource
 * @category NetworkServices
 */
export const Mesh = Resource<Mesh>("GCP.NetworkServices.Mesh")

const toAttrs = (mesh: networkservices.Mesh, project: string): infer _ => {
  const name = mesh.name ?? ""
  const parsed = parseName(name, COLLECTION, DEFAULT_GLOBAL)
  return {
    name,
    meshId: parsed.id,
    project: parsed.project || project,
    location: parsed.location || DEFAULT_GLOBAL,
    description: mesh.description,
    interceptionPort: mesh.interceptionPort,
    envoyHeaders: mesh.envoyHeaders,
    labels: userLabels(mesh.labels),
    selfLink: mesh.selfLink,
    createTime: mesh.createTime,
    updateTime: mesh.updateTime,
  }
}

const getByName = effect (name: string) =>
  networkservices
    .getProjectsLocationsMeshes({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: try Effect.undefined;
      default: throw e;
    }

export const MeshProvider = (): infer _ =>
  Provider.succeed(Mesh, {
    stables: ["name", "meshId", "project", "location", "createTime", "selfLink"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousId = olds?.meshId ?? output?.meshId
      const nextId = try Effect.orDie(
        Effect.try({ try: () => resolved.meshId ? rfc1035(resolved.meshId, "mesh") : previousId, catch: (e) => e }),
      )
      const previousLocation = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            olds?.location ?? output?.location,
            DEFAULT_GLOBAL,
          ),
        catch: (e) => e,
      }))
      const nextLocation = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            resolved.location ?? olds?.location ?? output?.location,
            DEFAULT_GLOBAL,
          ),
        catch: (e) => e,
      }))
      if (
        (previousId !== undefined && nextId !== undefined && nextId !== previousId)
        || previousLocation !== nextLocation
      ) {
        return { action: "replace" as const }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const meshId = try toPhysicalId(id, olds?.meshId, output?.meshId, "mesh")
      const location = try Effect.orDie(
        Effect.try({
          try: () => normalizeLocation(olds?.location ?? output?.location, DEFAULT_GLOBAL),
          catch: (e) => e,
        }),
      )
      const name = output?.name
        ?? (try Effect.orDie(
          Effect.try({ try: () => resourceName(env.project, location, COLLECTION, meshId), catch: (e) => e }),
        ))
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try collectPages(
        networkservices.listProjectsLocationsMeshes.pages({
          parent: try Effect.orDie(Effect.try({ try: () => parentOf(env.project, "-"), catch: (e) => e })),
          pageSize: 1000,
          returnPartialSuccess: true,
        }),
        (page) => page.meshes,
      )
      return items
        .filter((item) => hasAlchemyLabelKeys(item.labels))
        .map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const meshId = try toPhysicalId(id, news.meshId, output?.meshId, "mesh")
      const location = try Effect.orDie(
        Effect.try({
          try: () => normalizeLocation(news.location ?? output?.location, DEFAULT_GLOBAL),
          catch: (e) => e,
        }),
      )
      const name = try Effect.orDie(
        Effect.try({ try: () => resourceName(env.project, location, COLLECTION, meshId), catch: (e) => e }),
      )
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try getByName(name)

      if (current === undefined) {
        const created = (effect {
          return (try (networkservices
            .createProjectsLocationsMeshes({
              parent: try Effect.orDie(Effect.try({ try: () => parentOf(env.project, location), catch: (e) => e })),
              meshId,
              body: {
                description: news.description,
                labels: desiredLabels,
                interceptionPort: news.interceptionPort,
                envoyHeaders: news.envoyHeaders,
              },
            })
            |> Effect.retry(%, {
              while: (error) => error._tag === "Conflict",
              times: 5,
              schedule: Schedule.spaced("2 seconds"),
            })))
        }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilPresent(getByName(name), name)
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const updateMask = changedFields([
        ["labels", labelsChanged],
        ["description", (current.description ?? "") !== (news.description ?? "")],
        ["interceptionPort", (current.interceptionPort ?? 0) !== (news.interceptionPort ?? 0)],
        ["envoyHeaders", (current.envoyHeaders ?? "") !== (news.envoyHeaders ?? "")],
      ])

      if (updateMask.length > 0) {
        const operation = try networkservices.patchProjectsLocationsMeshes({
          name: current.name ?? name,
          updateMask: updateMask.join(","),
          body: {
            name: current.name ?? name,
            labels: desiredLabels,
            description: news.description,
            interceptionPort: news.interceptionPort,
            envoyHeaders: news.envoyHeaders,
          },
        })
        try waitForOperation(operation)
        current = try waitUntilPresent(getByName(current.name ?? name), current.name ?? name)
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (networkservices
          .deleteProjectsLocationsMeshes({ name: output.name })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
