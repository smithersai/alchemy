import * as mc from "@distilled.cloud/gcp/migrationcenter_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import {
  encodeOwnershipLine,
  expandParent,
  hasOwnershipMarker,
  locationParent,
  normalizeLocation,
  ownedByAlchemy,
  parseName,
  parseOwnership,
  replaceOnIdentity,
  ResourceNotResolved,
  toPhysicalId,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type ImportDataFileFormat = mc.ImportDataFileFormatEnum | (string & {})
export type ImportDataFileState = mc.ImportDataFileStateEnum | (string & {})

export type ImportJobsImportDataFileProps = {
  /**
   * Parent import job. Full name
   * `projects/{project}/locations/{location}/importJobs/{importJob}` or
   * the import job id (combined with `location`). Immutable — changing it
   * replaces the file.
   */
  importJob: string
  /**
   * Region used when `importJob` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, else the profile
   *   region, else `us-central1`)
   */
  location?: string
  /**
   * Import data file id (the `{importDataFile}` segment). If omitted, a
   * unique RFC1035 name is generated. Immutable — changing it replaces
   * the file.
   */
  importDataFileId?: string
  /**
   * Payload format. Immutable — changing it replaces the file.
   * @default "IMPORT_JOB_FORMAT_RVTOOLS_CSV"
   */
  format?: ImportDataFileFormat
  /**
   * User-friendly display name. Maximum length is 63 characters including
   * Alchemy's ownership marker. Import data files have no labels field,
   * so ownership is stored in a `[alchemy …]` prefix and stripped from
   * attributes.
   */
  displayName?: string
}

export type ImportJobsImportDataFile = Resource<
  "GCP.MigrationCenter.ImportJobsImportDataFile",
  ImportJobsImportDataFileProps,
  {
    /** Full resource name. */
    name: string
    /** Import data file id (last path segment). */
    importDataFileId: string
    /** Parent import job resource name. */
    importJob: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Payload format. */
    format: string | undefined
    /** User display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** Server-reported state. */
    state: string | undefined
    /** Signed upload URI. */
    signedUri: string | undefined
    /** Upload URI expiration. */
    uriExpirationTime: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
  },
  never,
  Providers
>

/**
 * A payload file attached to a Migration Center import job. Creating the
 * file returns a signed URI that the client uploads inventory CSV/XLSX
 * into.
 *
 * Import data files have no labels field — Alchemy stamps ownership into
 * the display name so `list` / nuke can find them. The API has no patch
 * method; changing format or display name replaces the file.
 *
 * ### Creating an Import Data File
 * **Example:** RVTools CSV payload
 * ```typescript
 * const job = yield* GCP.MigrationCenter.ImportJob("Rvtools", {
 *   assetSource: source.name,
 * });
 * const file = yield* GCP.MigrationCenter.ImportJobsImportDataFile("Payload", {
 *   importJob: job.name,
 *   format: "IMPORT_JOB_FORMAT_RVTOOLS_CSV",
 *   displayName: "inventory",
 * });
 * ```
 *
 * @resource
 * @category MigrationCenter
 */
export const ImportJobsImportDataFile = Resource<ImportJobsImportDataFile>(
  "GCP.MigrationCenter.ImportJobsImportDataFile",
)

const DEFAULT_FORMAT: ImportDataFileFormat = "IMPORT_JOB_FORMAT_RVTOOLS_CSV"

const jobNameOf = (value: string, project: string, location: string): infer _ =>
  expandParent(value, project, location, "importJobs")

const resourceName = (importJob: string, importDataFileId: string): infer _ =>
  `${importJob}/importDataFiles/${importDataFileId}`

const toAttrs = (item: mc.ImportDataFile, project: string, region: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, "importDataFiles", region)
  const ownership = parseOwnership(item.displayName)
  return {
    name,
    importDataFileId: parsed.id,
    importJob: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    format: item.format,
    displayName: ownership.text,
    state: item.state,
    signedUri: item.uploadFileInfo?.signedUri,
    uriExpirationTime: item.uploadFileInfo?.uriExpirationTime,
    createTime: item.createTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : mc
  .getProjectsLocationsImportJobsImportDataFiles({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listFiles = effect (parent: string) =>
  (effect {
    return (Array.from(
      try (mc.listProjectsLocationsImportJobsImportDataFiles.pages({ parent, pageSize: 1000 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.importDataFiles ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as mc.ImportDataFile[]; default: throw e; }

const listJobs = effect (project: string, region: string) =>
  (effect {
    return (Array.from(
      try (mc.listProjectsLocationsImportJobs
        .pages({
          parent: `projects/${project}/locations/-`,
          pageSize: 1000,
          view: "IMPORT_JOB_VIEW_BASIC",
        })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.importJobs ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: (effect {
      return (Array.from(
        try (mc.listProjectsLocationsImportJobs
          .pages({
            parent: try Effect.orDie(Effect.try({ try: () => locationParent(project, region), catch: (e) => e })),
            pageSize: 1000,
            view: "IMPORT_JOB_VIEW_BASIC",
          })
          |> Stream.flatMap(%, (page) => Stream.fromIterable(page.importJobs ?? []))
          |> Stream.runCollect(%)),
      ))
    }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as mc.ImportJob[]; default: throw e; };
    default: throw e;
  }

const listOwned = effect (project: string, region: string) => {
  const jobs = try listJobs(project, region)
  const files: mc.ImportDataFile[] = []
  for (const job of jobs) {
    if (job.name === undefined) continue
    const nested = try listFiles(job.name)
    for (const file of nested) {
      if (try Effect.orDie(Effect.try({ try: () => hasOwnershipMarker(file.displayName), catch: (e) => e }))) {
        files.push(file)
      }
    }
  }
  return files
}

export const ImportJobsImportDataFileProvider = (): infer _ =>
  Provider.succeed(ImportJobsImportDataFile, {
    stables: ["name", "importDataFileId", "importJob", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousFormat = olds?.format ?? output?.format ?? DEFAULT_FORMAT
      const nextFormat = resolved.format ?? previousFormat
      const previousJob = olds?.importJob ?? output?.importJob
      const nextJob = resolved.importJob
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.importDataFileId ?? output?.importDataFileId,
            nextId: resolved.importDataFileId ?? olds?.importDataFileId ?? output?.importDataFileId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            previousParent: previousJob,
            nextParent: nextJob,
            extra: previousFormat !== nextFormat,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const importJob = jobNameOf(
        olds?.importJob ?? output?.importJob ?? "",
        env.project,
        location,
      )
      const importDataFileId = try toPhysicalId(
        id,
        olds?.importDataFileId,
        output?.importDataFileId,
        "importdata",
      )
      const name = output?.name ?? (importJob.length > 0 ? resourceName(importJob, importDataFileId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listOwned(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const importJob = jobNameOf(news.importJob, env.project, location)
      const importDataFileId = try toPhysicalId(
        id,
        news.importDataFileId,
        output?.importDataFileId,
        "importdata",
      )
      const name = resourceName(importJob, importDataFileId)
      const ownership = try createInternalLabels(id)
      const displayName = try Effect.orDie(
        Effect.try({ try: () => encodeOwnershipLine(ownership, news.displayName), catch: (e) => e }),
      )
      const format = news.format ?? DEFAULT_FORMAT

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = mc
          .createProjectsLocationsImportJobsImportDataFiles({
            parent: importJob,
            importDataFileId,
            body: {
              displayName,
              format,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (mc
          .deleteProjectsLocationsImportJobsImportDataFiles({
            name: output.name,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
