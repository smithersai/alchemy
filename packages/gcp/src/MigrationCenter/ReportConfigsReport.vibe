import * as mc from "@distilled.cloud/gcp/migrationcenter_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  encodeOwnership,
  expandParent,
  fingerprint,
  hasOwnershipMarker,
  locationParent,
  normalizeLocation,
  ownedByAlchemy,
  parseName,
  parseOwnership,
  replaceOnIdentity,
  ResourceNotResolved,
  toPhysicalId,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type ReportType = mc.ReportTypeEnum | (string & {})
export type ReportState = mc.ReportStateEnum | (string & {})

export type ReportConfigsReportProps = {
  /**
   * Parent report config. Full name
   * `projects/{project}/locations/{location}/reportConfigs/{reportConfig}`
   * or the report config id (combined with `location`). Immutable —
   * changing it replaces the report.
   */
  mutable reportConfig: string
  /**
   * Region used when `reportConfig` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, else the profile
   *   region, else `us-central1`)
   */
  mutable location?: string
  /**
   * Report id (the `{report}` segment). If omitted, a unique RFC1035 name
   * is generated. Immutable — changing it replaces the report.
   */
  mutable reportId?: string
  /**
   * Report type. The API has no update method, so changing it replaces
   * the report.
   * @default "TOTAL_COST_OF_OWNERSHIP"
   */
  mutable type?: ReportType
  /**
   * User-friendly display name. Maximum length is 63 characters.
   */
  mutable displayName?: string
  /**
   * Free-text description. Reports have no labels field, so Alchemy
   * ownership is stored in a `[alchemy …]` prefix and stripped from
   * attributes.
   */
  mutable description?: string
}

export type ReportConfigsReport = Resource<
  "GCP.MigrationCenter.ReportConfigsReport",
  ReportConfigsReportProps,
  {
    /** Full resource name. */
    mutable name: string
    /** Report id (last path segment). */
    mutable reportId: string
    /** Parent report config resource name. */
    mutable reportConfig: string
    /** Project id. */
    mutable project: string
    /** Location id. */
    mutable location: string
    /** Report type. */
    mutable type: string | undefined
    /** User-friendly display name. */
    mutable displayName: string | undefined
    /** User description with the Alchemy ownership prefix stripped. */
    mutable description: string | undefined
    /** Server-reported state. */
    mutable state: string | undefined
    /** RFC3339 creation timestamp. */
    mutable createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    mutable updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A point-in-time Migration Center report rendered from a report config
 * (typically a total cost of ownership view).
 *
 * Reports have no labels field — Alchemy stamps ownership into the
 * description so `list` / nuke can find them. The API has no patch
 * method; changing type, display name, or description replaces the
 * report.
 *
 * ### Creating a Report
 * **Example:** TCO report
 * ```typescript
 * const report = yield* GCP.MigrationCenter.ReportConfigsReport("Tco", {
 *   reportConfig: config.name,
 *   type: "TOTAL_COST_OF_OWNERSHIP",
 *   displayName: "q1-tco",
 * });
 * ```
 *
 * @resource
 * @category MigrationCenter
 */
export const ReportConfigsReport = Resource<ReportConfigsReport>(
  "GCP.MigrationCenter.ReportConfigsReport",
)

const DEFAULT_TYPE: ReportType = "TOTAL_COST_OF_OWNERSHIP"

const configNameOf = (value: string, project: string, location: string): infer _ =>
  expandParent(value, project, location, "reportConfigs")

const resourceName = (reportConfig: string, reportId: string): infer _ => `${reportConfig}/reports/${reportId}`

const toAttrs = (item: mc.Report, project: string, region: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, "reports", region)
  const ownership = parseOwnership(item.description)
  return {
    name,
    reportId: parsed.id,
    reportConfig: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    type: item.type,
    displayName: item.displayName,
    description: ownership.text,
    state: item.state,
    createTime: item.createTime,
    updateTime: item.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : mc
  .getProjectsLocationsReportConfigsReports({
    name,
    view: "REPORT_VIEW_BASIC",
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; })

const listReports = effect (parent: string) =>
  (Array.from(
    try (mc.listProjectsLocationsReportConfigsReports
      .pages({
        parent,
        pageSize: 1000,
        view: "REPORT_VIEW_BASIC",
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.reports ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as mc.Report[]; default: throw e; }

const listConfigs = effect (project: string, region: string) =>
  (Array.from(
    try (mc.listProjectsLocationsReportConfigs
      .pages({
        parent: `projects/${project}/locations/-`,
        pageSize: 1000,
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.reportConfigs ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: (Array.from(
      try (mc.listProjectsLocationsReportConfigs
        .pages({
          parent: locationParent(project, region),
          pageSize: 1000,
        })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.reportConfigs ?? []))
        |> Stream.runCollect(%)),
    )) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as mc.ReportConfig[]; default: throw e; };
    default: throw e;
  }

const listOwned = effect (project: string, region: string) => {
  const configs = try listConfigs(project, region)
  const reports: mc.Report[] = []
  for (const config of configs) {
    if (config.name === undefined) continue
    const nested = try listReports(config.name)
    for (const report of nested) {
      if (hasOwnershipMarker(report.description)) reports.push(report)
    }
  }
  return reports
}

export const ReportConfigsReportProvider = (): infer _ =>
  Provider.succeed(ReportConfigsReport, {
    stables: ["name", "reportId", "reportConfig", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const env = try GcpEnvironment.current
      const payloadChanged = fingerprint({
        type: news.type ?? DEFAULT_TYPE,
        displayName: news.displayName,
        description: news.description,
      })
        !== fingerprint({
          type: olds?.type ?? output?.type ?? DEFAULT_TYPE,
          displayName: olds?.displayName ?? output?.displayName,
          description: olds?.description ?? output?.description,
        })
      return replaceOnIdentity({
        previousId: olds?.reportId ?? output?.reportId,
        nextId: news.reportId ?? olds?.reportId ?? output?.reportId,
        previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
        nextLocation: normalizeLocation(
          news.location ?? olds?.location ?? output?.location,
          env.region,
        ),
        previousParent: olds?.reportConfig ?? output?.reportConfig,
        nextParent: news.reportConfig,
        extra: payloadChanged,
      })
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(olds?.location ?? output?.location, env.region)
      const reportConfig = configNameOf(
        olds?.reportConfig ?? output?.reportConfig ?? "",
        env.project,
        location,
      )
      const reportId = try toPhysicalId(id, olds?.reportId, output?.reportId, "report")
      const name = output?.name ?? (reportConfig.length > 0 ? resourceName(reportConfig, reportId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      return (try ownedByAlchemy(id, existing.description)) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listOwned(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(news.location ?? output?.location, env.region)
      const reportConfig = configNameOf(news.reportConfig, env.project, location)
      const reportId = try toPhysicalId(id, news.reportId, output?.reportId, "report")
      const name = resourceName(reportConfig, reportId)
      const ownership = try createInternalLabels(id)
      const description = encodeOwnership(ownership, news.description)
      const displayName = news.displayName ?? reportId
      const type = news.type ?? DEFAULT_TYPE

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = mc
          .createProjectsLocationsReportConfigsReports({
            parent: reportConfig,
            reportId,
            body: {
              type,
              displayName,
              description,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      const operation = (try (mc
        .deleteProjectsLocationsReportConfigsReports({ name: output.name })
        |> Effect.retry(%, {
          while: (error) => error._tag === "Conflict",
          times: 8,
          schedule: Schedule.spaced("2 seconds"),
        }))) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
