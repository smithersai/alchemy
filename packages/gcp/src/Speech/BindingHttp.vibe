import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor, type BindingIam, type GcpHttpOp } from "../HttpBinding.vibe"
import type { CustomClass } from "./CustomClass.vibe"
import type { PhraseSet } from "./PhraseSet.vibe"

const makeNamedHttpBinding = effect <
  Resource extends CustomClass | PhraseSet,
  I,
  A,
  E,
  Req = void,
>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
  toInput: (name: string, request: Req | undefined) => I
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (resource: Resource) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${resource})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, resource.name), catch: (e) => e }))],
      })
    }
    const name = try resource.name.asEffect()
    return effect (request?: Req | undefined) =>
      try withSpan(
        effect {
          const resourceName = try name
          return try run(options.toInput(resourceName, request))
        },
        `${options.tag}(${resource.LogicalId})`,
      )
  }
}

/**
 * Shared HTTP scaffolding for Speech-to-Text bindings.
 * NOT exported from index.ts.
 */
export const makeCustomClassHttpBinding = effect <I, A, E, Req = void>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
  toInput: (name: string, request: Req | undefined) => I
}) => try makeNamedHttpBinding<CustomClass, I, A, E, Req>(options)

export const makePhraseSetHttpBinding = effect <I, A, E, Req = void>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
  toInput: (name: string, request: Req | undefined) => I
}) => try makeNamedHttpBinding<PhraseSet, I, A, E, Req>(options)
