import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor, type BindingIam, type GcpHttpOp } from "../HttpBinding.ts"
import type { Note } from "./Note.ts"
import type { Occurrence } from "./Occurrence.ts"

/**
 * Shared HTTP scaffolding for Container Analysis get bindings.
 * NOT exported from index.ts.
 */
export const makeNoteHttpBinding = effect <I extends { mutable name?: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (note: Note) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${note})`({
        iam: [grantFor(options.iam, note.name)],
      })
    }
    const name = try note.name.asEffect()
    return effect (request?: Omit<I, "name"> | undefined) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${note.LogicalId})`,
      )
  }
}

export const makeOccurrenceHttpBinding = effect <I extends { mutable name?: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (occurrence: Occurrence) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${occurrence})`({
        iam: [grantFor(options.iam, occurrence.name)],
      })
    }
    const name = try occurrence.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${occurrence.LogicalId})`,
      )
  }
}
