import * as binaryauthorization from "@distilled.cloud/gcp/binaryauthorization_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { GetPlatformsPolicy, type GetPlatformsPolicyRequest } from "./GetPlatformsPolicy.vibe"
import type { PlatformsPolicy } from "./PlatformsPolicy.vibe"

/**
 * HTTP implementation of {@link GetPlatformsPolicy}.
 *
 * @layer
 * @provides GCP.BinaryAuthorization.GetPlatformsPolicy
 */
export const GetPlatformsPolicyHttp = Layer.effect(
  GetPlatformsPolicy,
  effect {
    const bind = try GCPBindings.Bind
    const getPolicy = try GCPBindings.withCredentials(
      binaryauthorization.getProjectsPlatformsPolicies,
    )
    return effect (policy: PlatformsPolicy) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.BinaryAuthorization.GetPlatformsPolicy(${policy})`({
          // Platform policies have no resource-level IAM.
          iam: [{ role: "roles/binaryauthorization.policyViewer" }],
        })
      }
      const name = try policy.name.asEffect()
      return effect (request?: GetPlatformsPolicyRequest | undefined) =>
        try withSpan(
          effect {
            return try getPolicy({
              ...request,
              name: try name,
            })
          },
          `GCP.BinaryAuthorization.GetPlatformsPolicy(${policy.LogicalId})`,
        )
    }
  },
)
