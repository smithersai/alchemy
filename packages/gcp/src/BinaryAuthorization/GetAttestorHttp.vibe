import * as binaryauthorization from "@distilled.cloud/gcp/binaryauthorization_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor } from "../HttpBinding.ts"
import type { Attestor } from "./Attestor.vibe"
import { GetAttestor, type GetAttestorRequest } from "./GetAttestor.vibe"

/**
 * HTTP implementation of {@link GetAttestor}.
 *
 * @layer
 * @provides GCP.BinaryAuthorization.GetAttestor
 */
export const GetAttestorHttp = Layer.effect(
  GetAttestor,
  effect {
    const bind = try GCPBindings.Bind
    const getAttestor = try GCPBindings.withCredentials(
      binaryauthorization.getProjectsAttestors,
    )
    return effect (attestor: Attestor) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.BinaryAuthorization.GetAttestor(${attestor})`({
          iam: [
            try Effect.orDie(Effect.try({
              try: () =>
                grantFor(
                  {
                    role: "roles/binaryauthorization.attestorsViewer",
                    on: "binaryauthorization.attestor",
                  },
                  attestor.name,
                ),
              catch: (e) => e,
            })),
          ],
        })
      }
      const name = try attestor.name.asEffect()
      return effect (
        request?: GetAttestorRequest | undefined,
      ) =>
        try withSpan(
          effect {
            const attestorName = try name
            return try getAttestor({
              ...request,
              name: attestorName,
            })
          },
          `GCP.BinaryAuthorization.GetAttestor(${attestor.LogicalId})`,
        )
    }
  },
)
