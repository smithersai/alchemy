import * as binaryauthorization from "@distilled.cloud/gcp/binaryauthorization_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor } from "../HttpBinding.ts"
import type { Attestor } from "./Attestor.vibe"
import { ValidateAttestation, type ValidateAttestationRequest } from "./ValidateAttestation.vibe"

/**
 * HTTP implementation of {@link ValidateAttestation}.
 *
 * @layer
 * @provides GCP.BinaryAuthorization.ValidateAttestation
 */
export const ValidateAttestationHttp = Layer.effect(
  ValidateAttestation,
  effect {
    const bind = try GCPBindings.Bind
    const validate = try GCPBindings.withCredentials(
      binaryauthorization.validateAttestationOccurrenceProjectsAttestors,
    )
    return effect (attestor: Attestor) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.BinaryAuthorization.ValidateAttestation(${attestor})`({
          iam: [
            grantFor(
              {
                role: "roles/binaryauthorization.attestorsVerifier",
                on: "binaryauthorization.attestor",
              },
              attestor.name,
            ),
          ],
        })
      }
      const project = try attestor.project.asEffect()
      const attestorId = try attestor.attestorId.asEffect()
      const noteReference = try attestor.noteReference.asEffect()
      return effect (request: ValidateAttestationRequest) =>
        try withSpan(
          effect {
            const projectId = try project
            const id = try attestorId
            const occurrenceNote = request.occurrenceNote ?? (try noteReference)
            return try validate({
              attestor: `projects/${projectId}/attestors/${id}`,
              body: {
                occurrenceResourceUri: request.occurrenceResourceUri,
                occurrenceNote,
                attestation: request.attestation,
              },
            })
          },
          `GCP.BinaryAuthorization.ValidateAttestation(${attestor.LogicalId})`,
        )
    }
  },
)
