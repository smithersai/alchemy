import * as binaryauthorization from "@distilled.cloud/gcp/binaryauthorization_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import { EvaluateGkePolicy, type EvaluateGkePolicyRequest } from "./EvaluateGkePolicy.vibe"
import type { PlatformsPolicy } from "./PlatformsPolicy.vibe"

/**
 * HTTP implementation of {@link EvaluateGkePolicy}.
 *
 * @layer
 * @provides GCP.BinaryAuthorization.EvaluateGkePolicy
 */
export const EvaluateGkePolicyHttp = Layer.effect(
  EvaluateGkePolicy,
  effect {
    const bind = try GCPBindings.Bind
    const evaluate = try GCPBindings.withCredentials(
      binaryauthorization.evaluateProjectsPlatformsGkePolicies,
    )
    return effect (policy: PlatformsPolicy) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.BinaryAuthorization.EvaluateGkePolicy(${policy})`({
          // Platform policies have no resource-level IAM.
          iam: [{ role: "roles/binaryauthorization.policyEvaluator" }],
        })
      }
      const name = try policy.name.asEffect()
      return effect (
        request: EvaluateGkePolicyRequest,
      ) =>
        try withSpan(
          effect {
            return try evaluate({
              name: try name,
              body: request,
            })
          },
          `GCP.BinaryAuthorization.EvaluateGkePolicy(${policy.LogicalId})`,
        )
    }
  },
)
