export const makeSubscriptionHttpBinding = effect <
  I extends { mutable name?: string; mutable subscription?: string },
  A,
  E,
>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable field: "name" | "subscription"
  mutable operation: Op<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try (options.operation as ((input: I) => A!E)!never!Credentials | HttpClient.HttpClient)
  return effect (subscription: AdminSubscription) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${subscription})`({
        iam: [grantFor(options.iam, subscription.name)],
      })
    }
    const name = try subscription.name.asEffect()
    return effect (
      request?: Omit<I, "name" | "subscription"> | undefined,
    ) =>
      try withSpan(
        effect {
          const resolved = try name
          const input = options.field === "subscription"
            ? ({ ...request, subscription: resolved } as I)
            : ({ ...request, name: resolved } as I)
          return try run(input)
        },
        `${options.tag}(${subscription.LogicalId})`,
      )
  }
}
