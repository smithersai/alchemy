import { Credentials } from "@distilled.cloud/gcp/Credentials"
import type { GcpOpContext } from "@distilled.cloud/gcp/pubsublite_v1"
import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor, type BindingIam } from "../HttpBinding.ts"
import type { AdminReservation } from "./AdminReservation.vibe"
import type { AdminSubscription } from "./AdminSubscription.vibe"
import type { AdminTopic } from "./AdminTopic.vibe"

type Op<I, A, E> = ((input: I) => A!E)!!GcpOpContext

/**
 * Shared HTTP scaffolding for Pub/Sub Lite bindings.
 * NOT exported from index.ts.
 *
 * Distilled ops are `OperationMethod`s: yield them once at Layer
 * construction (after providing Credentials + HttpClient.HttpClient) so the inner
 * runtime Effect is `Effect<A, E>` and does not leak `GcpOpContext`.
 */
export const makeReservationHttpBinding = effect <I extends { mutable name?: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: Op<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try (options.operation as ((input: I) => A!E)!never!Credentials | HttpClient.HttpClient)
  return effect (reservation: AdminReservation) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${reservation})`({
        iam: [grantFor(options.iam, reservation.name)],
      })
    }
    const name = try reservation.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            name: try name,
          } as I)
        },
        `${options.tag}(${reservation.LogicalId})`,
      )
  }
}

export const makeTopicNameHttpBinding = effect <I extends { mutable name?: string }, A, E>(options: {
  mutable tag: string
