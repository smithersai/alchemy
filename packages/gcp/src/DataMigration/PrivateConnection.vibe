import * as dm from "@distilled.cloud/gcp/datamigration_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, hasAlchemyLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  fingerprint,
  hasAlchemyLabelMap,
  locationParent,
  networkOf,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  ResourceNotResolved,
  toPhysicalId,
  userLabels,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type PrivateConnectionState = dm.PrivateConnectionStateEnum | (string & {})
export type VpcPeeringConfig = dm.VpcPeeringConfig
export type PscInterfaceConfig = dm.PscInterfaceConfig
type Status = dm.Status

export type PrivateConnectionProps = {
  /**
   * Private connection id (the `{privateConnection}` segment of
   * `projects/{project}/locations/{location}/privateConnections/{privateConnection}`).
   * If omitted, a unique RFC1035 name is generated. Immutable — changing
   * it replaces the connection.
   */
  mutable privateConnectionId?: string
  /**
   * Region (`us-central1`, …). Immutable — changing it replaces the
   * connection. `US-CENTRAL1` is accepted and normalized to `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  mutable location?: string
  /**
   * User-friendly display name. The API has no patch method — changing
   * display name replaces the connection.
   */
  mutable displayName?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   * The API has no patch method — changing labels replaces the
   * connection.
   */
  mutable labels?: Record<string, string>
  /**
   * VPC peering configuration. Mutually exclusive with
   * `pscInterfaceConfig`. Immutable — changing it replaces the
   * connection. `vpcName` may be a full resource name or a bare network
   * id.
   */
  mutable vpcPeeringConfig?: {
    mutable vpcName: string
    mutable subnet: string
  }
  /**
   * PSC interface configuration. Mutually exclusive with
   * `vpcPeeringConfig`. Immutable — changing it replaces the connection.
   */
  mutable pscInterfaceConfig?: PscInterfaceConfig
  /**
   * Skip validations on create.
   */
  mutable skipValidation?: boolean
  /**
   * PSC interface only: resolve the tenant project without creating.
   */
  mutable validateOnly?: boolean
}

export type PrivateConnection = Resource<
  "GCP.DataMigration.PrivateConnection",
  PrivateConnectionProps,
  {
    /** Full resource name. */
    mutable name: string
    /** Private connection id (last path segment). */
    mutable privateConnectionId: string
    /** Project id. */
    mutable project: string
    /** Location id. */
    mutable location: string
    /** User-friendly display name. */
    mutable displayName: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    mutable labels: Record<string, string>
    /** VPC peering configuration. */
    mutable vpcPeeringConfig: VpcPeeringConfig | undefined
    /** PSC interface configuration. */
    mutable pscInterfaceConfig: PscInterfaceConfig | undefined
    /** Server-reported state. */
    mutable state: string | undefined
    /** Failure details when `state` is `FAILED`. */
    mutable error: Status | undefined
    /** RFC3339 creation timestamp. */
    mutable createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    mutable updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Database Migration Service private connection: VPC peering or a PSC
 * interface between DMS and a consumer network.
 *
 * The API has no patch method. `privateConnectionId`, `location`,
 * `vpcPeeringConfig`, `pscInterfaceConfig`, display name, and labels are
 * replacement triggers.
 *
 * ### Creating a Private Connection
 * **Example:** VPC peering
 * ```typescript
 * const network = yield* GCP.Compute.Network("DmsVpc", {
 *   autoCreateSubnetworks: false,
 * });
 * const peering = yield* GCP.DataMigration.PrivateConnection("DmsPeer", {
 *   displayName: "dms-peer",
 *   vpcPeeringConfig: {
 *     vpcName: network.selfLink ?? network.networkName,
 *     subnet: "10.8.0.0/29",
 *   },
 *   labels: { env: "test" },
 * });
 * ```
 *
 * @resource
 * @category DataMigration
 */
export const PrivateConnection = Resource<PrivateConnection>("GCP.DataMigration.PrivateConnection")

const resourceName = (project: string, location: string, privateConnectionId: string): infer _ =>
  `${locationParent(project, location)}/privateConnections/${privateConnectionId}`

const peeringOf = (
  value: PrivateConnectionProps["vpcPeeringConfig"] | VpcPeeringConfig | undefined,
  project: string,
): infer _ =>
  value?.vpcName === undefined && value?.subnet === undefined
    ? undefined
    : {
      vpcName: value?.vpcName ? networkOf(value.vpcName, project) : undefined,
      subnet: value?.subnet,
    }

const kindOf = (value: { mutable vpcPeeringConfig?: unknown; mutable pscInterfaceConfig?: unknown }): infer _ =>
  value.vpcPeeringConfig ? "vpc" : value.pscInterfaceConfig ? "psc" : ""

const toAttrs = (item: dm.PrivateConnection, project: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, "privateConnections")
  return {
    name,
    privateConnectionId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    displayName: item.displayName,
    labels: userLabels(item.labels),
    vpcPeeringConfig: item.vpcPeeringConfig,
    pscInterfaceConfig: item.pscInterfaceConfig,
    state: item.state,
    error: item.error,
    createTime: item.createTime,
    updateTime: item.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dm
  .getProjectsLocationsPrivateConnections({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listOwned = effect (project: string, region: string) =>
  (Array.from(
    try (dm.listProjectsLocationsPrivateConnections
      .pages({
        parent: `projects/${project}/locations/-`,
        pageSize: 1000,
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.privateConnections ?? []))
      |> Stream.filter(%, (item) => hasAlchemyLabelMap(item.labels))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: (Array.from(
      try (dm.listProjectsLocationsPrivateConnections
        .pages({
          parent: locationParent(project, region),
          pageSize: 1000,
        })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.privateConnections ?? []))
        |> Stream.filter(%, (item) => hasAlchemyLabelMap(item.labels))
        |> Stream.runCollect(%)),
    )) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as dm.PrivateConnection[]; default: throw e; };
    default: throw e;
  }

export const PrivateConnectionProvider = (): infer _ =>
  Provider.succeed(PrivateConnection, {
    stables: ["name", "privateConnectionId", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const env = try GcpEnvironment.current
      const previousKind = kindOf({
        vpcPeeringConfig: olds?.vpcPeeringConfig ?? output?.vpcPeeringConfig,
        pscInterfaceConfig: olds?.pscInterfaceConfig ?? output?.pscInterfaceConfig,
      })
      const nextKind = kindOf(news) || previousKind
      const previousPeering = fingerprint(olds?.vpcPeeringConfig ?? output?.vpcPeeringConfig)
      const nextPeering = fingerprint(news.vpcPeeringConfig)
      const previousPsc = fingerprint(olds?.pscInterfaceConfig ?? output?.pscInterfaceConfig)
      const nextPsc = fingerprint(news.pscInterfaceConfig)
      const previousDisplay = olds?.displayName ?? output?.displayName
      const nextDisplay = news.displayName ?? previousDisplay
      const previousLabels = fingerprint(olds?.labels ?? output?.labels)
      const nextLabels = fingerprint(news.labels ?? olds?.labels ?? output?.labels)
      return replaceOnIdentity({
        previousId: olds?.privateConnectionId ?? output?.privateConnectionId,
        nextId: news.privateConnectionId ?? olds?.privateConnectionId ?? output?.privateConnectionId,
        previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
        nextLocation: normalizeLocation(
          news.location ?? olds?.location ?? output?.location,
          env.region,
        ),
        extra: (olds !== undefined || output !== undefined)
          && (previousKind !== nextKind
            || (news.vpcPeeringConfig !== undefined && previousPeering !== nextPeering)
            || (news.pscInterfaceConfig !== undefined && previousPsc !== nextPsc)
            || previousDisplay !== nextDisplay
            || previousLabels !== nextLabels),
      })
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const privateConnectionId = try toPhysicalId(
        id,
        olds?.privateConnectionId,
        output?.privateConnectionId,
        "pconn",
      )
      const location = normalizeLocation(olds?.location ?? output?.location, env.region)
      const name = output?.name ?? resourceName(env.project, location, privateConnectionId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(id, tagRecord(existing.labels))) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listOwned(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const privateConnectionId = try toPhysicalId(
        id,
        news.privateConnectionId,
        output?.privateConnectionId,
        "pconn",
      )
      const location = normalizeLocation(news.location ?? output?.location, env.region)
      const name = resourceName(env.project, location, privateConnectionId)
      const desiredLabels = {
        ...toLabels(news.labels),
        ...(try createInternalLabels(id)),
      }
      const displayName = news.displayName ?? privateConnectionId
      const vpcPeeringConfig = peeringOf(news.vpcPeeringConfig, env.project)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = dm
          .createProjectsLocationsPrivateConnections({
            parent: locationParent(env.project, location),
            privateConnectionId,
            skipValidation: news.skipValidation,
            validateOnly: news.validateOnly,
            body: {
              displayName,
              labels: desiredLabels,
              vpcPeeringConfig,
              pscInterfaceConfig: news.pscInterfaceConfig,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      try (effect {
        const operation = (try (dm
          .deleteProjectsLocationsPrivateConnections({ name: output.name })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          }))) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
        if (operation !== undefined) {
          try waitForOperation(operation, { notFoundOk: true })
        }
      }
        |> Effect.retry(%, {
          while: (error) => error._tag === "GCP.OperationFailed" && error.code === 4,
          times: 5,
          schedule: Schedule.spaced("10 seconds"),
        }))
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
