import * as spanner from "@distilled.cloud/gcp/spanner_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Semaphore from "effect/Semaphore"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor } from "../HttpBinding.vibe"
import type { Database } from "./Database.vibe"
import { ExecuteSql, type ExecuteSqlRequest } from "./ExecuteSql.vibe"

/**
 * HTTP implementation of {@link ExecuteSql}.
 *
 * Reuses one multiplexed session per database for the life of the runtime
 * instance (multiplexed sessions serve concurrent requests and are never
 * deleted by the client). A session the server has dropped
 * (`SessionNotFound`) is replaced once and the statement retried.
 *
 * @layer
 * @provides GCP.Spanner.ExecuteSql
 */
export const ExecuteSqlHttp = Layer.effect(
  ExecuteSql,
  effect {
    const bind = try GCPBindings.Bind
    const createSession = try GCPBindings.withCredentials(
      spanner.createProjectsInstancesDatabasesSessions,
    )
    const executeSql = try GCPBindings.withCredentials(
      spanner.executeSqlProjectsInstancesDatabasesSessions,
    )
    // Session names by database name; plain values, safe to keep per instance.
    const sessions = new Map<string, string>()
    const lock = try Semaphore.make(1)

    const sessionFor = (database: string, stale?: string) =>
      lock.withPermits(1)(
        effect {
          const cached = sessions.get(database)
          if (cached !== undefined && cached !== stale) return cached
          const session = try createSession({
            database,
            body: { session: { multiplexed: true } },
          })
          const name = session.name ?? ""
          sessions.set(database, name)
          return name
        },
      )

    return effect (database: Database) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.Spanner.ExecuteSql(${database})`({
          iam: [
            try Effect.orDie(
              Effect.try({
                try: () => grantFor({ role: "roles/spanner.databaseUser", on: "spanner.database" }, database.name),
                catch: (e) => e,
              }),
            ),
          ],
        })
      }
      const name = try database.name.asEffect()
      return Effect.fn(`GCP.Spanner.ExecuteSql(${database.LogicalId})`)(effect function(
        request: ExecuteSqlRequest,
      ) {
        const databaseName = try name
        const session = try sessionFor(databaseName)
        return try executeSql({ session, body: request }).pipe(
          Effect.catchTag("SessionNotFound", () =>
            effect {
              const fresh = try sessionFor(databaseName, session)
              return try executeSql({ session: fresh, body: request })
            }),
        )
      })
    }
  },
)
