import * as spanner from "@distilled.cloud/gcp/spanner_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor } from "../HttpBinding.vibe"
import type { Database } from "./Database.ts"
import { GetDdl, type GetDdlRequest } from "./GetDdl.vibe"

/**
 * HTTP implementation of {@link GetDdl}.
 *
 * @layer
 * @provides GCP.Spanner.GetDdl
 */
export const GetDdlHttp = Layer.effect(
  GetDdl,
  effect {
    const bind = try GCPBindings.Bind
    const getDdlProjectsInstancesDatabases = try GCPBindings.withCredentials(
      spanner.getDdlProjectsInstancesDatabases,
    )
    return effect (database: Database) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.Spanner.GetDdl(${database})`({
          iam: [
            try Effect.orDie(Effect.try({
              try: () =>
                grantFor(
                  { role: "roles/spanner.databaseReader", on: "spanner.database" },
                  database.name,
                ),
              catch: (e) => e,
            })),
          ],
        })
      }
      const name = try database.name.asEffect()
      return effect (
        request?: GetDdlRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try getDdlProjectsInstancesDatabases({
              ...request,
              database: try name,
            })
          },
          `GCP.Spanner.GetDdl(${database.LogicalId})`,
        )
    }
  },
)
