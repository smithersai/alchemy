import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, diffLabels, hasAlchemyLabels, stripInternalLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import { listLocations } from "./names.vibe"
import { resourceNameFromOperation, waitForOperation } from "./operations.ts"
import { lastSegment, locationOf, locationParent, parentOf, toResourceId } from "./ownership.vibe"

export type ReasoningEnginesSessionProps = {
  /**
   * Parent ReasoningEngine resource name
   * (`projects/{project}/locations/{location}/reasoningEngines/{reasoning_engine}`).
   * Immutable — changing it replaces the session.
   */
  parent: string
  /**
   * Session id (the `{session}` segment). If omitted, a unique id is
   * generated. Immutable.
   */
  sessionId?: string
  /**
   * Immutable user id that owns the session.
   */
  userId: string
  /**
   * User-facing display name.
   */
  displayName?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Session TTL (for example `"86400s"`). Minimum 24 hours.
   */
  ttl?: string
  /**
   * RFC3339 expiration timestamp. Minimum 24 hours from create time.
   */
  expireTime?: string
  /**
   * Session-specific memory storing key conversation points.
   */
  sessionState?: Record<string, unknown>
}

export type ReasoningEnginesSession = Resource<
  "GCP.AIPlatform.ReasoningEnginesSession",
  ReasoningEnginesSessionProps,
  {
    /** Full resource name. */
    name: string
    /** Session id (last path segment). */
    sessionId: string
    /** Parent ReasoningEngine resource name. */
    parent: string
    /** Region id. */
    location: string
    /** Project id. */
    project: string
    /** User id that owns the session. */
    userId: string | undefined
    /** User-facing display name. */
    displayName: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Expiration timestamp. */
    expireTime: string | undefined
    /** Session memory. */
    sessionState: Record<string, unknown> | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Vertex AI Reasoning Engine session between a user and an agent.
 *
 * Parent engine, session id, and user id are immutable. Display name,
 * labels, expiration, and session state update in place.
 *
 * ### Creating a Session
 * **Example:** Session for a user
 * ```typescript
 * const session = yield* GCP.AIPlatform.ReasoningEnginesSession("Chat", {
 *   parent: engine.name,
 *   userId: "user-123",
 *   displayName: "support-chat",
 * });
 * ```
 *
 * @resource
 * @category AIPlatform
 */
export const ReasoningEnginesSession = Resource<ReasoningEnginesSession>(
  "GCP.AIPlatform.ReasoningEnginesSession",
)

// @vibelang-diagnostics-next-line EK4830:off
export class ReasoningEnginesSessionNotResolved extends Data.TaggedError(
  "GCP.AIPlatform.ReasoningEnginesSessionNotResolved",
)<{
  resourceName: string
}> {}

const userLabels = (
  labels: Record<string, string | undefined> | null | undefined,
): Record<string, string> => stripInternalLabels(tagRecord(labels))

const resourceName = (parent: string, sessionId: string): infer _ => `${parent}/sessions/${sessionId}`

const toAttrs = (session: aiplatform.GoogleCloudAiplatformV1Session, project: string): infer _ => {
  const name = session.name ?? ""
  return {
    name,
    sessionId: lastSegment(name),
    parent: parentOf(name),
    location: locationOf(name),
    project,
    userId: session.userId,
    displayName: session.displayName,
    labels: userLabels(session.labels),
    expireTime: session.expireTime,
    sessionState: session.sessionState,
    createTime: session.createTime,
    updateTime: session.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : aiplatform
  .getProjectsLocationsReasoningEnginesSessions({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const waitUntilExists = effect (name: string) =>
  try (effect {
    return try effect {
      const session = try getByName(name)
      return (session ? session : throw new ReasoningEnginesSessionNotResolved({ resourceName: name }))
    }
  }
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.AIPlatform.ReasoningEnginesSessionNotResolved",
      times: 8,
      schedule: Schedule.spaced("2 seconds"),
    }))

const listEngines = effect (project: string, location: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsReasoningEngines
        .pages({
          parent: locationParent(project, location),
          pageSize: 100,
        })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.reasoningEngines ?? []))
        |> Stream.map(%, (engine) => engine.name ?? "")
        |> Stream.filter(%, (name) => name.length > 0)
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as string[]; default: throw e; }

const listAtParent = effect (parent: string, project: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsReasoningEnginesSessions.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.sessions ?? []))
        |> Stream.filter(%, (session) => Object.keys(session.labels ?? {}).some((key) => key.startsWith("alchemy-")))
        |> Stream.map(%, (session) => toAttrs(session, project))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

export const ReasoningEnginesSessionProvider = (): infer _ =>
  Provider.succeed(ReasoningEnginesSession, {
    stables: ["name", "sessionId", "parent", "location", "project", "userId", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousParent = olds?.parent ?? output?.parent
      if (previousParent !== undefined && resolved.parent !== previousParent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.sessionId ?? output?.sessionId
      if (
        previousId !== undefined
        && resolved.sessionId !== undefined
        && resolved.sessionId !== previousId
      ) {
        return { action: "replace" as const, deleteFirst: true }
      }
      const previousUser = olds?.userId ?? output?.userId
      if (previousUser !== undefined && resolved.userId !== previousUser) {
        return { action: "replace" as const, deleteFirst: true }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const sessionId = try toResourceId(id, olds?.sessionId, output?.sessionId)
      const name = output?.name ?? (olds?.parent !== undefined ? resourceName(olds.parent, sessionId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const engines = (try Effect.forEach(listLocations(env.region), effect (location) =>
        try listEngines(env.project, location))).flat()
      const pages = try Effect.forEach(
        engines,
        effect (parent) =>
          try listAtParent(parent, env.project),
        { concurrency: 4 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const sessionId = try toResourceId(id, news.sessionId, output?.sessionId)
      const name = resourceName(news.parent, sessionId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = aiplatform
          .createProjectsLocationsReasoningEnginesSessions({
            parent: news.parent,
            sessionId,
            body: {
              userId: news.userId,
              displayName: news.displayName,
              labels: desiredLabels,
              ttl: news.ttl,
              expireTime: news.expireTime,
              sessionState: news.sessionState,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          const done = try waitForOperation(created, {
            alreadyExistsOk: true,
          })
          const createdName = (try Effect.orDie(Effect.try({
            try: () => resourceNameFromOperation(done),
            catch: (e) => e,
          }))) ?? name
          current = try waitUntilExists(createdName)
        } else {
          current = try getByName(name)
        }
      }

      if (current === undefined) {
        throw new ReasoningEnginesSessionNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const displayChanged = (current.displayName ?? "") !== (news.displayName ?? "")
      const expireChanged = news.expireTime !== undefined && (current.expireTime ?? "") !== news.expireTime
      const stateChanged = news.sessionState !== undefined
        && JSON.stringify(current.sessionState ?? {}) !== JSON.stringify(news.sessionState ?? {})

      if (labelsChanged || displayChanged || expireChanged || stateChanged) {
        current = try aiplatform.patchProjectsLocationsReasoningEnginesSessions({
          name: current.name ?? name,
          updateMask: [
            labelsChanged ? "labels" : undefined,
            displayChanged ? "displayName" : undefined,
            expireChanged ? "expireTime" : undefined,
            stateChanged ? "sessionState" : undefined,
          ]
            .filter((field): field is string => field !== undefined)
            .join(","),
          body: {
            name: current.name ?? name,
            displayName: news.displayName,
            labels: desiredLabels,
            expireTime: news.expireTime,
            sessionState: news.sessionState,
          },
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const existing = try getByName(output.name)
      if (existing === undefined) return
      const operation = aiplatform
        .deleteProjectsLocationsReasoningEnginesSessions({
          name: output.name,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
