import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, hasAlchemyLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  hasAlchemyLabelKeys,
  isJobTerminal,
  normalizeLocation,
  parentOf,
  parseResourceName,
  rfc1035,
  userLabels,
  waitForOperation,
} from "./internal.ts"
import { listLocations } from "./names.vibe"
import type { EncryptionSpec } from "./shared.vibe"

export type CustomJobSpec = aiplatform.GoogleCloudAiplatformV1CustomJobSpec

export type CustomJobProps = {
  /**
   * Region. Immutable — changing it replaces the job.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * User-facing display name (max 128 characters). Defaults to a generated
   * id. Immutable after create — CustomJob has no update API.
   */
  displayName?: string
  /**
   * Worker pools, container/python spec, networking, and scheduling.
   * Required. Immutable after create.
   */
  jobSpec: CustomJobSpec
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   * Set at create; CustomJob cannot patch labels.
   */
  labels?: Record<string, string>
  /**
   * Customer-managed encryption. Immutable after create.
   */
  encryptionSpec?: EncryptionSpec
}

export type CustomJob = Resource<
  "GCP.AIPlatform.CustomJob",
  CustomJobProps,
  {
    /** Full resource name `.../customJobs/{custom_job}`. */
    name: string
    /** Custom job id (last path segment). */
    customJobId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Display name. */
    displayName: string | undefined
    /** Job spec as stored by Vertex. */
    jobSpec: CustomJobSpec | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Detailed job state. */
    state: string | undefined
    /** Customer-managed KMS key, if any. */
    kmsKeyName: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 start timestamp. */
    startTime: string | undefined
    /** RFC3339 end timestamp. */
    endTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
    /** Failure/cancel status, if any. */
    error: { code?: number; message?: string } | undefined
  },
  never,
  Providers
>

/**
 * A Vertex AI CustomJob — a container or Python training workload.
 *
 * Creating a CustomJob starts it immediately. There is no update API, so
 * reconcile is observe-ensure (create if missing). Delete cancels a
 * running job, then deletes it. Alchemy ownership labels are merged into
 * `labels` so `list` / nuke can find the job.
 *
 * ### Creating a Custom Job
 * **Example:** Single-worker container job
 * ```typescript
 * const job = yield* GCP.AIPlatform.CustomJob("Train", {
 *   displayName: "echo-train",
 *   jobSpec: {
 *     workerPoolSpecs: [
 *       {
 *         machineSpec: { machineType: "n1-standard-4" },
 *         replicaCount: "1",
 *         containerSpec: {
 *           imageUri: "gcr.io/google-samples/hello-app:1.0",
 *           command: ["echo"],
 *           args: ["ok"],
 *         },
 *       },
 *     ],
 *     scheduling: { timeout: "600s" },
 *   },
 *   labels: { env: "test" },
 * });
 * ```
 *
 * @resource
 * @category AIPlatform
 */
export const CustomJob = Resource<CustomJob>("GCP.AIPlatform.CustomJob")

// @vibelang-diagnostics-next-line EK4830:off
export class CustomJobNotResolved extends Data.TaggedError("GCP.AIPlatform.CustomJobNotResolved")<{
  resourceName: string
}> {}

const toId = effect (id: string, existing?: string) => {
  if (existing !== undefined) return existing
  const name = try createPhysicalName({
    id,
    maxLength: 63,
    lowercase: true,
  })
  return try Effect.orDie(Effect.try({
    try: () =>
      rfc1035(
        name,
      ),
    catch: (e) => e,
  }))
}

const toAttrs = (job: aiplatform.GoogleCloudAiplatformV1CustomJob, project: string): infer _ => {
  const name = job.name ?? ""
  const parsed = parseResourceName(name, "customJobs")
  return {
    name,
    customJobId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    displayName: job.displayName,
    jobSpec: job.jobSpec,
    labels: userLabels(job.labels),
    state: job.state,
    kmsKeyName: job.encryptionSpec?.kmsKeyName,
    createTime: job.createTime,
    startTime: job.startTime,
    endTime: job.endTime,
    updateTime: job.updateTime,
    error: job.error ? { code: job.error.code, message: job.error.message } : undefined,
  }
}

const getByName = effect (name: string) =>
  aiplatform
    .getProjectsLocationsCustomJobs({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: try Effect.undefined;
      default: throw e;
    }

const listJobs = effect (project: string, region: string) => {
  const collect = effect (parent: string) =>
    Array.from(
      try (aiplatform.listProjectsLocationsCustomJobs.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.customJobs ?? []))
        |> Stream.filter(%, (job) => hasAlchemyLabelKeys(job.labels))
        |> Stream.runCollect(%)),
    )
  const fallback = effect {
    return (try Effect.forEach(
      listLocations(region),
      effect (location) => try collect(`projects/${project}/locations/${location}`),
    )).flat()
  }
  // Vertex AI has no `locations/-` wildcard; scan known locations.
  return (effect {
    return (try fallback)
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }
}

const findOwned = effect (id: string, project: string, region: string, hinted?: string) => {
  if (hinted !== undefined && hinted.length > 0) {
    const existing = try getByName(hinted)
    if (existing !== undefined) return existing
  }
  const jobs = try listJobs(project, region)
  for (const job of jobs) {
    if (
      try hasAlchemyLabels(
        id,
        try Effect.orDie(Effect.try({ try: () => tagRecord(job.labels), catch: (e) => e })),
      )
    ) return job
  }
  return undefined as aiplatform.GoogleCloudAiplatformV1CustomJob | undefined
}

const cancelAndDelete = effect (name: string) => {
  const existing = try getByName(name)
  if (existing === undefined) return
  if (!(try Effect.orDie(Effect.try({ try: () => isJobTerminal(existing.state), catch: (e) => e })))) {
    aiplatform
      .cancelProjectsLocationsCustomJobs({ name }) catch effect (e) => match (e) {
        when { _tag: "NotFound" }: try Effect.void;
        default: throw e;
      }
    ;(effect {
      return (try (getByName(name)
        |> Effect.filterOrFail(
          %,
          (job) => job === undefined || isJobTerminal(job.state),
          () => new CustomJobNotResolved({ resourceName: name }),
        )
        |> Effect.retry(%, {
          while: (error) => error._tag === "GCP.AIPlatform.CustomJobNotResolved",
          times: 8,
          schedule: Schedule.spaced("4 seconds"),
        })))
    }) catch effect (e) => match (e) {
      when { _tag: "GCP.AIPlatform.CustomJobNotResolved" }: try Effect.void;
      default: throw e;
    }
  }
  const operation = (effect {
    return (try (aiplatform.deleteProjectsLocationsCustomJobs({ name })
      |> Effect.retry(%, {
        while: (error) => error._tag === "Conflict",
        times: 8,
        schedule: Schedule.spaced("3 seconds"),
      })))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    when { _tag: "Conflict" }: try Effect.undefined;
    default: throw e;
  }
  if (operation !== undefined) {
    try waitForOperation(operation, { notFoundOk: true })
  }
}

export const CustomJobProvider = (): infer _ =>
  Provider.succeed(CustomJob, {
    stables: ["name", "customJobId", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const env = try GcpEnvironment.current
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousLocation = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const nextLocation = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            resolved.location ?? olds?.location ?? output?.location,
            env.region,
          ),
        catch: (e) => e,
      }))
      if (previousLocation !== nextLocation) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, output }) => {
      const env = try GcpEnvironment.current
      const existing = try findOwned(id, env.project, env.region, output?.name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const jobs = try listJobs(env.project, env.region)
      return jobs.map((job) => toAttrs(job, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const displayName = news.displayName ?? (try toId(id, output?.customJobId))
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try findOwned(id, env.project, env.region, output?.name)

      if (current === undefined) {
        const created = aiplatform
          .createProjectsLocationsCustomJobs({
            parent: parentOf(env.project, location),
            body: {
              displayName,
              jobSpec: news.jobSpec,
              labels: desiredLabels,
              encryptionSpec: news.encryptionSpec,
            },
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try findOwned(id, env.project, env.region);
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new CustomJobNotResolved({
          resourceName: output?.name ?? parentOf(env.project, location),
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      try cancelAndDelete(output.name)
    },
  })
