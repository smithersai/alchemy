import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.vibe"
import { hasAlchemyLabels } from "../Labels.vibe"
import type { Providers } from "../Providers.vibe"
import { isJobTerminal } from "./internal.ts"
import {
  alchemyIdFilter,
  createInternalLabels,
  hasAlchemyPrefix,
  listLocations,
  locationOf,
  lastSegment,
  normalizeLocation,
  projectOf,
  stableJson,
  toDisplayName,
  toLabels,
  userLabels,
} from "./names.vibe"
import { waitForOperation } from "./operations.vibe"

export type HyperparameterTuningJobProps = {
  /**
   * Vertex AI location. Immutable — changing it replaces the job.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Display name (max 128 Unicode characters). Generated from the stack,
   * stage, and logical id when omitted.
   */
  displayName?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Desired total number of Trials.
   */
  maxTrialCount: number
  /**
   * Desired number of Trials to run in parallel.
   */
  parallelTrialCount: number
  /**
   * Number of failed Trials before the job fails. `0` lets Vertex decide.
   */
  maxFailedTrialCount?: number
  /**
   * Study configuration (metrics and parameters).
   */
  studySpec: aiplatform.GoogleCloudAiplatformV1StudySpec
  /**
   * Spec of the CustomJob backing each Trial.
   */
  trialJobSpec: aiplatform.GoogleCloudAiplatformV1CustomJobSpec
  /**
   * Customer-managed encryption key. Immutable.
   */
  encryptionSpec?: aiplatform.GoogleCloudAiplatformV1EncryptionSpec
}

export type HyperparameterTuningJob = Resource<
  "GCP.AIPlatform.HyperparameterTuningJob",
  HyperparameterTuningJobProps,
  {
    /** Full resource name. */
    name: string
    /** Job id (last path segment). */
    hyperparameterTuningJobId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Display name. */
    displayName: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Job state. */
    state: string | undefined
    /** Desired total trial count. */
    maxTrialCount: number | undefined
    /** Parallel trial count. */
    parallelTrialCount: number | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 start timestamp. */
    startTime: string | undefined
    /** RFC3339 end timestamp. */
    endTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Vertex AI HyperparameterTuningJob that runs CustomJobs for each trial.
 *
 * The API assigns the job id. There is no update method — changing display
 * name, labels, trial counts, or specs replaces the job. Delete cancels a
 * running job first.
 *
 * ### Creating a HyperparameterTuningJob
 * **Example:** Maximize accuracy
 * ```typescript
 * const job = yield* GCP.AIPlatform.HyperparameterTuningJob("Tune", {
 *   maxTrialCount: 2,
 *   parallelTrialCount: 1,
 *   studySpec: {
 *     metrics: [{ metricId: "accuracy", goal: "MAXIMIZE" }],
 *     parameters: [{
 *       parameterId: "lr",
 *       doubleValueSpec: { minValue: 0.001, maxValue: 0.1 },
 *     }],
 *   },
 *   trialJobSpec: {
 *     workerPoolSpecs: [{
 *       machineSpec: { machineType: "n1-standard-4" },
 *       replicaCount: "1",
 *       containerSpec: { imageUri: "gcr.io/cloud-aiplatform/training/tf-cpu.2-8:latest" },
 *     }],
 *   },
 * });
 * ```
 *
 * @resource
 * @category AIPlatform
 */
export const HyperparameterTuningJob = Resource<HyperparameterTuningJob>(
  "GCP.AIPlatform.HyperparameterTuningJob",
)

// @vibelang-diagnostics-next-line EK4830:off
export class HyperparameterTuningJobNotResolved extends Data.TaggedError(
  "GCP.AIPlatform.HyperparameterTuningJobNotResolved",
)<{
  resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class HyperparameterTuningJobStillExists extends Data.TaggedError(
  "GCP.AIPlatform.HyperparameterTuningJobStillExists",
)<{
  resourceName: string
}> {}

const toAttrs = (
  job: aiplatform.GoogleCloudAiplatformV1HyperparameterTuningJob,
  project: string,
): infer _ => {
  const name = job.name ?? ""
  return {
    name,
    hyperparameterTuningJobId: lastSegment(name),
    project: projectOf(name, project),
    location: locationOf(name),
    displayName: job.displayName,
    labels: userLabels(job.labels),
    state: job.state,
    maxTrialCount: job.maxTrialCount,
    parallelTrialCount: job.parallelTrialCount,
    createTime: job.createTime,
    startTime: job.startTime,
    endTime: job.endTime,
  }
}

const getByName = effect (name: string) =>
  aiplatform
    .getProjectsLocationsHyperparameterTuningJobs({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: undefined;
      default: throw e;
    }

const listPage = effect (parent: string, filter?: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsHyperparameterTuningJobs
        .pages({ parent, pageSize: 100, filter })
        |> Stream.runCollect(%)),
    ).flatMap((page) => page.hyperparameterTuningJobs ?? []))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as aiplatform.GoogleCloudAiplatformV1HyperparameterTuningJob[];
    default: throw e;
  }

const findOwned = effect (project: string, location: string, labels: Record<string, string>) =>
  (try listPage(`projects/${project}/locations/${location}`, alchemyIdFilter(labels))).find((item) =>
    hasAlchemyPrefix(item.labels)
  ) ?? undefined

const waitUntilGone = effect (name: string) =>
  try (getByName(name)
    |> Effect.filterOrFail(
      %,
      (job) => job === undefined,
      () => new HyperparameterTuningJobStillExists({ resourceName: name }),
    )
    |> Effect.asVoid(%)
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.AIPlatform.HyperparameterTuningJobStillExists",
      times: 10,
      schedule: Schedule.spaced("2 seconds"),
    }))

export const HyperparameterTuningJobProvider = (): infer _ =>
  Provider.succeed(HyperparameterTuningJob, {
    stables: ["name", "hyperparameterTuningJobId", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const env = try GcpEnvironment.current
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousLocation = normalizeLocation(olds?.location ?? output?.location, env.region)
      const nextLocation = normalizeLocation(
        resolved.location ?? olds?.location ?? output?.location,
        env.region,
      )
      const previousDisplay = olds?.displayName ?? output?.displayName
      const displayChanged = resolved.displayName !== undefined
        && previousDisplay !== undefined
        && resolved.displayName !== previousDisplay
      const previousMax = olds?.maxTrialCount ?? output?.maxTrialCount
      const previousParallel = olds?.parallelTrialCount ?? output?.parallelTrialCount
      const specsChanged = (olds !== undefined && stableJson(olds.studySpec) !== stableJson(resolved.studySpec))
        || (olds !== undefined && stableJson(olds.trialJobSpec) !== stableJson(resolved.trialJobSpec))
      if (
        previousLocation !== nextLocation
        || displayChanged
        || (previousMax !== undefined && resolved.maxTrialCount !== previousMax)
        || (previousParallel !== undefined && resolved.parallelTrialCount !== previousParallel)
        || specsChanged
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(olds?.location ?? output?.location, env.region)
      const ownership = try createInternalLabels(id)
      const existing = (output?.name !== undefined ? try getByName(output.name) : undefined)
        ?? (try findOwned(env.project, location, ownership))
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const pages = try Effect.forEach(
        listLocations(env.region),
        effect (location) => try listPage(`projects/${env.project}/locations/${location}`),
        { concurrency: 4 },
      )
      return pages
        .flat()
        .filter((job) => hasAlchemyPrefix(job.labels))
        .map((job) => toAttrs(job, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(news.location ?? output?.location, env.region)
      const displayName = try toDisplayName(id, news.displayName, output?.displayName)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = (output?.name !== undefined ? try getByName(output.name) : undefined)
        ?? (try findOwned(env.project, location, desiredLabels))

      if (current === undefined) {
        const created = aiplatform
          .createProjectsLocationsHyperparameterTuningJobs({
            parent: `projects/${env.project}/locations/${location}`,
            body: {
              displayName,
              labels: desiredLabels,
              maxTrialCount: news.maxTrialCount,
              parallelTrialCount: news.parallelTrialCount,
              maxFailedTrialCount: news.maxFailedTrialCount,
              studySpec: news.studySpec,
              trialJobSpec: news.trialJobSpec,
              encryptionSpec: news.encryptionSpec,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: undefined; default: throw e; }
        current = created ?? (try findOwned(env.project, location, desiredLabels))
      }

      if (current === undefined || current.name === undefined) {
        throw new HyperparameterTuningJobNotResolved({
          resourceName: output?.name ?? `${location}/hyperparameterTuningJobs`,
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      aiplatform
        .cancelProjectsLocationsHyperparameterTuningJobs({
          name: output.name,
          body: {},
        }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "BadRequest" } or { _tag: "Conflict" }: undefined as void;
          default: throw e;
        }
      // Running jobs reject deletes; wait for the cancel to land.
      try (getByName(output.name)
        |> Effect.repeat(%, {
          schedule: Schedule.spaced("4 seconds"),
          until: (job) => job === undefined || isJobTerminal(job.state),
          times: 45,
        }))
      const operation = (effect {
        return (try (aiplatform
          .deleteProjectsLocationsHyperparameterTuningJobs({
            name: output.name,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(output.name)
    },
  })
