import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, diffLabels, hasAlchemyLabels, stripInternalLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import { listLocations } from "./names.vibe"
import { waitForOperation } from "./operations.ts"
import { lastSegment, locationOf, locationParent, parentOf, toResourceId } from "./ownership.vibe"

export type TensorboardsExperimentsRunProps = {
  /**
   * Parent TensorboardExperiment resource name
   * (`projects/{project}/locations/{location}/tensorboards/{tensorboard}/experiments/{experiment}`).
   * Immutable — changing it replaces the run.
   */
  parent: string
  /**
   * Run id (the `{run}` segment). If omitted, a unique id is generated.
   * Immutable.
   */
  runId?: string
  /**
   * User-facing display name. Must be unique among runs of the parent
   * experiment.
   */
  displayName?: string
  /**
   * Human-readable description.
   */
  description?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
}

export type TensorboardsExperimentsRun = Resource<
  "GCP.AIPlatform.TensorboardsExperimentsRun",
  TensorboardsExperimentsRunProps,
  {
    /** Full resource name. */
    name: string
    /** Run id (last path segment). */
    runId: string
    /** Parent experiment resource name. */
    parent: string
    /** Region id. */
    location: string
    /** Project id. */
    project: string
    /** User-facing display name. */
    displayName: string | undefined
    /** Description. */
    description: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Vertex AI TensorboardRun, one execution of a training job.
 *
 * Parent experiment and run id are immutable. Display name, description,
 * and labels update in place.
 *
 * ### Creating a Run
 * **Example:** Run under an experiment
 * ```typescript
 * const run = yield* GCP.AIPlatform.TensorboardsExperimentsRun("Pass", {
 *   parent: experiment.name,
 *   displayName: "pass-1",
 * });
 * ```
 *
 * @resource
 * @category AIPlatform
 */
export const TensorboardsExperimentsRun = Resource<TensorboardsExperimentsRun>(
  "GCP.AIPlatform.TensorboardsExperimentsRun",
)

// @vibelang-diagnostics-next-line EK4830:off
export class TensorboardsExperimentsRunNotResolved extends Data.TaggedError(
  "GCP.AIPlatform.TensorboardsExperimentsRunNotResolved",
)<{
  resourceName: string
}> {}

const userLabels = (
  labels: Record<string, string | undefined> | null | undefined,
): Record<string, string> => stripInternalLabels(tagRecord(labels))

const resourceName = (parent: string, runId: string): infer _ => `${parent}/runs/${runId}`

const toAttrs = (run: aiplatform.GoogleCloudAiplatformV1TensorboardRun, project: string): infer _ => {
  const name = run.name ?? ""
  return {
    name,
    runId: lastSegment(name),
    parent: parentOf(name),
    location: locationOf(name),
    project,
    displayName: run.displayName,
    description: run.description,
    labels: userLabels(run.labels),
    createTime: run.createTime,
    updateTime: run.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : aiplatform
  .getProjectsLocationsTensorboardsExperimentsRuns({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listTensorboards = effect (project: string, location: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsTensorboards
        .pages({
          parent: locationParent(project, location),
          pageSize: 100,
        })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.tensorboards ?? []))
        |> Stream.map(%, (board) => board.name ?? "")
        |> Stream.filter(%, (name) => name.length > 0)
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as string[]; default: throw e; }

const listExperiments = effect (parent: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsTensorboardsExperiments.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.tensorboardExperiments ?? []))
        |> Stream.map(%, (experiment) => experiment.name ?? "")
        |> Stream.filter(%, (name) => name.length > 0)
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as string[]; default: throw e; }

const listAtParent = effect (parent: string, project: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsTensorboardsExperimentsRuns.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.tensorboardRuns ?? []))
        |> Stream.filter(%, (run) => Object.keys(run.labels ?? {}).some((key) => key.startsWith("alchemy-")))
        |> Stream.map(%, (run) => toAttrs(run, project))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

export const TensorboardsExperimentsRunProvider = (): infer _ =>
  Provider.succeed(TensorboardsExperimentsRun, {
    stables: ["name", "runId", "parent", "location", "project", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousParent = olds?.parent ?? output?.parent
      if (previousParent !== undefined && resolved.parent !== previousParent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.runId ?? output?.runId
      if (previousId !== undefined && resolved.runId !== undefined && resolved.runId !== previousId) {
        return { action: "replace" as const, deleteFirst: true }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const runId = try toResourceId(id, olds?.runId, output?.runId)
      const name = output?.name ?? (olds?.parent !== undefined ? resourceName(olds.parent, runId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const boards = (try Effect.forEach(listLocations(env.region), effect (location) =>
        try listTensorboards(env.project, location))).flat()
      const experiments = (try Effect.forEach(boards, listExperiments, {
        concurrency: 4,
      })).flat()
      const pages = try Effect.forEach(
        experiments,
        effect (parent) =>
          try listAtParent(parent, env.project),
        { concurrency: 4 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const runId = try toResourceId(id, news.runId, output?.runId)
      const name = resourceName(news.parent, runId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({
          try: () =>
            toLabels(news.labels),
          catch: (e) =>
            e,
        })),
        ...(try createInternalLabels(id)),
      }
      const displayName = news.displayName ?? runId

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = aiplatform
          .createProjectsLocationsTensorboardsExperimentsRuns({
            parent: news.parent,
            tensorboardRunId: runId,
            body: {
              displayName,
              description: news.description,
              labels: desiredLabels,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new TensorboardsExperimentsRunNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const displayChanged = (current.displayName ?? "") !== displayName
      const descriptionChanged = (current.description ?? "") !== (news.description ?? "")

      if (labelsChanged || displayChanged || descriptionChanged) {
        current = try aiplatform.patchProjectsLocationsTensorboardsExperimentsRuns({
          name,
          updateMask: [
            labelsChanged ? "labels" : undefined,
            displayChanged ? "displayName" : undefined,
            descriptionChanged ? "description" : undefined,
          ]
            .filter((field): field is string => field !== undefined)
            .join(","),
          body: {
            name,
            displayName,
            description: news.description,
            labels: desiredLabels,
          },
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const existing = try getByName(output.name)
      if (existing === undefined) return
      const operation = aiplatform
        .deleteProjectsLocationsTensorboardsExperimentsRuns({
          name: output.name,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
