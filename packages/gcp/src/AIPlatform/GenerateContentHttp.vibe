import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Credentials } from "@distilled.cloud/gcp/Credentials"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { GcpProjectMissing } from "../Environment.vibe"
import * as GCPBindings from "../GCPBindings.vibe"
import {
  GenerateContent,
  type GenerateContentClient,
  type GenerateContentRequest,
  type PublisherModel,
} from "./GenerateContent.vibe"

const TAG = "GCP.AIPlatform.GenerateContent"

/**
 * HTTP implementation of {@link GenerateContent}.
 *
 * @layer
 * @provides GCP.AIPlatform.GenerateContent
 */
export const GenerateContentHttp = Layer.effect(
  GenerateContent,
  effect {
    const bind = try GCPBindings.Bind
    const generateContent = try GCPBindings.withCredentials(
      aiplatform.generateContentProjectsLocationsPublishersModels,
    )
    // The project is the caller's own: deploy credentials at plan time,
    // the metadata server inside Cloud Run / Cloud Functions.
    const credentials = effect {
      return try Context.get(
        try GCPBindings.withCredentials(Effect.context<Credentials>()),
        Credentials,
      )
    }
    const project = effect {
      return try effect {
        const { project } = try credentials
        return (project ? project : throw new GcpProjectMissing({
          message: `${TAG}: no GCP project id in the runtime credentials`,
        }))
      }
    }

    return effect (target: string | PublisherModel) => {
      const {
        model,
        location = "global",
        publisher = "google",
      } = typeof target === "string" ? { model: target } : target
      const id = `${publisher}/${model}@${location}`

      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`${TAG}(${{ LogicalId: id }})`({
          // Publisher models have no resource IAM policy; aiplatform.user is
          // the narrowest predefined role carrying aiplatform.endpoints.predict.
          iam: [{ role: "roles/aiplatform.user" }],
        })
      }

      const generate = effect (request: GenerateContentRequest) =>
        try withSpan(
          effect {
            return try generateContent({
              model: `projects/${try project}/locations/${location}/publishers/${publisher}/models/${model}`,
              body: request,
            })
          },
          `${TAG}(${id})`,
        )

      const client: GenerateContentClient = {
        generate,
        text: effect (prompt, options) =>
          ((try generate({
            ...options,
            contents: [{ role: "user", parts: [{ text: prompt }] }],
          })).candidates?.[0]?.content?.parts ?? [])
            .filter((part) => !part.thought)
            .map((part) => part.text ?? "")
            .join(""),
      }
      return client
    }
  },
)
