import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import { GcpEnvironment } from "../Environment.ts"
import { hasAlchemyLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import { isJobTerminal } from "./internal.ts"
import {
  alchemyIdFilter,
  createInternalLabels,
  hasAlchemyPrefix,
  listLocations,
  locationOf,
  lastSegment,
  normalizeLocation,
  projectOf,
  stableJson,
  toDisplayName,
  toLabels,
  userLabels,
} from "./names.vibe"
import { waitForOperation } from "./operations.ts"

export type NasJobProps = {
  /**
   * Vertex AI location. Immutable — changing it replaces the job.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  mutable location?: string
  /**
   * Display name (max 128 Unicode characters). Generated from the stack,
   * stage, and logical id when omitted.
   */
  mutable displayName?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  mutable labels?: Record<string, string>
  /**
   * Neural Architecture Search specification.
   */
  mutable nasJobSpec: aiplatform.GoogleCloudAiplatformV1NasJobSpec
  /**
   * Enable restricted-image training for the tenant project.
   * @default false
   */
  mutable enableRestrictedImageTraining?: boolean
  /**
   * Customer-managed encryption key. Immutable.
   */
  mutable encryptionSpec?: aiplatform.GoogleCloudAiplatformV1EncryptionSpec
}

export type NasJob = Resource<
  "GCP.AIPlatform.NasJob",
  NasJobProps,
  {
    /** Full resource name. */
    mutable name: string
    /** Job id (last path segment). */
    mutable nasJobId: string
    /** Project id. */
    mutable project: string
    /** Location id. */
    mutable location: string
    /** Display name. */
    mutable displayName: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    mutable labels: Record<string, string>
    /** Job state. */
    mutable state: string | undefined
    /** Whether restricted-image training is enabled. */
    mutable enableRestrictedImageTraining: boolean
    /** RFC3339 creation timestamp. */
    mutable createTime: string | undefined
    /** RFC3339 start timestamp. */
    mutable startTime: string | undefined
    /** RFC3339 end timestamp. */
    mutable endTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Vertex AI Neural Architecture Search job.
 *
 * The API assigns the job id. There is no update method — changing display
 * name, labels, or `nasJobSpec` replaces the job. Delete cancels a running
 * job first.
 *
 * ### Creating a NasJob
 * **Example:** Multi-trial search
 * ```typescript
 * const job = yield* GCP.AIPlatform.NasJob("Search", {
 *   nasJobSpec: {
 *     searchSpaceSpec: "{}",
 *     multiTrialAlgorithmSpec: {
 *       metric: { metricId: "accuracy", goal: "MAXIMIZE" },
 *       searchTrialSpec: {
 *         maxTrialCount: 1,
 *         maxParallelTrialCount: 1,
 *         searchTrialJobSpec: {
 *           workerPoolSpecs: [{
 *             machineSpec: { machineType: "n1-standard-4" },
 *             replicaCount: "1",
 *             containerSpec: { imageUri: "gcr.io/cloud-aiplatform/training/tf-cpu.2-8:latest" },
 *           }],
 *         },
 *       },
 *     },
 *   },
 * });
 * ```
 *
 * @resource
 * @category AIPlatform
 */
export const NasJob = Resource<NasJob>("GCP.AIPlatform.NasJob")

// @vibelang-diagnostics-next-line EK4830:off
export class NasJobNotResolved extends Data.TaggedError("GCP.AIPlatform.NasJobNotResolved")<{
  mutable resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class NasJobStillExists extends Data.TaggedError("GCP.AIPlatform.NasJobStillExists")<{
  mutable resourceName: string
}> {}

const toAttrs = (job: aiplatform.GoogleCloudAiplatformV1NasJob, project: string): infer _ => {
  const name = job.name ?? ""
  return {
    name,
    nasJobId: lastSegment(name),
    project: projectOf(name, project),
    location: locationOf(name),
    displayName: job.displayName,
    labels: userLabels(job.labels),
    state: job.state,
    enableRestrictedImageTraining: job.enableRestrictedImageTraining === true,
    createTime: job.createTime,
    startTime: job.startTime,
    endTime: job.endTime,
  }
}

const getByName = effect (name: string) =>
  aiplatform
    .getProjectsLocationsNasJobs({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: try Effect.undefined;
      default: throw e;
    }

const listPage = effect (parent: string, filter?: string) =>
  (Array.from(
    try (aiplatform.listProjectsLocationsNasJobs.pages({ parent, pageSize: 100, filter })
      |> Stream.runCollect(%)),
  ).flatMap((page) => page.nasJobs ?? [])) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as aiplatform.GoogleCloudAiplatformV1NasJob[];
    default: throw e;
  }

const findOwned = effect (project: string, location: string, labels: Record<string, string>) =>
  (try listPage(`projects/${project}/locations/${location}`, alchemyIdFilter(labels))).find((item) =>
    hasAlchemyPrefix(item.labels)
  ) ?? undefined

const waitUntilGone = effect (name: string) =>
  try (getByName(name)
    |> Effect.filterOrFail(%, (job) => job === undefined, () => new NasJobStillExists({ resourceName: name }))
    |> Effect.asVoid(%)
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.AIPlatform.NasJobStillExists",
      times: 10,
      schedule: Schedule.spaced("2 seconds"),
    }))

export const NasJobProvider = (): infer _ =>
  Provider.succeed(NasJob, {
    stables: ["name", "nasJobId", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const env = try GcpEnvironment.current
      if (!isResolved(news)) return undefined
      const previousLocation = normalizeLocation(olds?.location ?? output?.location, env.region)
      const nextLocation = normalizeLocation(
        news.location ?? olds?.location ?? output?.location,
        env.region,
      )
      const previousDisplay = olds?.displayName ?? output?.displayName
      const displayChanged = news.displayName !== undefined
        && previousDisplay !== undefined
        && news.displayName !== previousDisplay
      const specsChanged = olds !== undefined && stableJson(olds.nasJobSpec) !== stableJson(news.nasJobSpec)
      if (previousLocation !== nextLocation || displayChanged || specsChanged) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(olds?.location ?? output?.location, env.region)
      const ownership = try createInternalLabels(id)
      const existing = (output?.name !== undefined ? try getByName(output.name) : undefined)
        ?? (try findOwned(env.project, location, ownership))
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(id, tagRecord(existing.labels))) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const pages = try Effect.forEach(
        listLocations(env.region),
        effect (location) => try listPage(`projects/${env.project}/locations/${location}`),
        { concurrency: 4 },
      )
      return pages
        .flat()
        .filter((job) => hasAlchemyPrefix(job.labels))
        .map((job) => toAttrs(job, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = normalizeLocation(news.location ?? output?.location, env.region)
      const displayName = try toDisplayName(id, news.displayName, output?.displayName)
      const desiredLabels = {
        ...toLabels(news.labels),
        ...(try createInternalLabels(id)),
      }

      let current = (output?.name !== undefined ? try getByName(output.name) : undefined)
        ?? (try findOwned(env.project, location, desiredLabels))

      if (current === undefined) {
        const created = aiplatform
          .createProjectsLocationsNasJobs({
            parent: `projects/${env.project}/locations/${location}`,
            body: {
              displayName,
              labels: desiredLabels,
              nasJobSpec: news.nasJobSpec,
              enableRestrictedImageTraining: news.enableRestrictedImageTraining === true,
              encryptionSpec: news.encryptionSpec,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        current = created ?? (try findOwned(env.project, location, desiredLabels))
      }

      if (current === undefined || current.name === undefined) {
        throw new NasJobNotResolved({
          resourceName: output?.name ?? `${location}/nasJobs`,
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      aiplatform
        .cancelProjectsLocationsNasJobs({
          name: output.name,
          body: {},
        }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "BadRequest" } or { _tag: "Conflict" }: try Effect.void;
          default: throw e;
        }
      // Running jobs reject deletes; wait for the cancel to land.
      try (getByName(output.name)
        |> Effect.repeat(%, {
          schedule: Schedule.spaced("4 seconds"),
          until: (job) => job === undefined || isJobTerminal(job.state),
          times: 45,
        }))
      const operation = (try (aiplatform
        .deleteProjectsLocationsNasJobs({ name: output.name })
        |> Effect.retry(%, {
          while: (error) => error._tag === "Conflict",
          times: 8,
          schedule: Schedule.spaced("2 seconds"),
        }))) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(output.name)
    },
  })
