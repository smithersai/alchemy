import * as aiplatform from "@distilled.cloud/gcp/aiplatform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import { listLocations } from "./names.vibe"
import { resourceNameFromOperation, waitForOperation } from "./operations.ts"
import {
  encodeOwnershipLine,
  hasOwnershipMarker,
  lastSegment,
  locationOf,
  locationParent,
  ownedByAlchemy,
  parseOwnership,
} from "./ownership.vibe"

export type SpecialistPoolProps = {
  /**
   * Region (`us-central1`, …). Immutable — changing it replaces the pool.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * User-facing display name. Must be unique per project. Specialist pools
   * have no labels field, so Alchemy ownership is stored in a `[alchemy …]`
   * prefix.
   */
  displayName?: string
  /**
   * Email addresses of specialist managers.
   */
  specialistManagerEmails?: string[]
  /**
   * Email addresses of specialist workers.
   */
  specialistWorkerEmails?: string[]
}

export type SpecialistPool = Resource<
  "GCP.AIPlatform.SpecialistPool",
  SpecialistPoolProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/specialistPools/{specialist_pool}`. */
    name: string
    /** Pool id (last path segment). */
    specialistPoolId: string
    /** Region id. */
    location: string
    /** Project id. */
    project: string
    /** User display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** Manager emails. */
    specialistManagerEmails: string[]
    /** Worker emails. */
    specialistWorkerEmails: string[]
    /** Number of managers. */
    specialistManagersCount: number | undefined
    /** Pending data labeling jobs. */
    pendingDataLabelingJobs: string[]
  },
  never,
  Providers
>

/**
 * A Vertex AI SpecialistPool of managers and workers for data labeling.
 *
 * Specialist pools have no labels field — Alchemy stamps ownership into
 * the display name. Location is immutable. Manager and worker emails
 * update in place.
 *
 * ### Creating a Pool
 * **Example:** Empty pool with a display name
 * ```typescript
 * const pool = yield* GCP.AIPlatform.SpecialistPool("Labelers", {
 *   displayName: "labelers",
 * });
 * ```
 *
 * @resource
 * @category AIPlatform
 */
export const SpecialistPool = Resource<SpecialistPool>("GCP.AIPlatform.SpecialistPool")

// @vibelang-diagnostics-next-line EK4830:off
export class SpecialistPoolNotResolved extends Data.TaggedError(
  "GCP.AIPlatform.SpecialistPoolNotResolved",
)<{
  resourceName: string
}> {}

const sorted = (values: readonly string[] | undefined): infer _ =>
  [...(values ?? [])].sort((left, right) => left.localeCompare(right))

const sameEmails = (left: readonly string[] | undefined, right: readonly string[] | undefined): infer _ =>
  JSON.stringify(sorted(left)) === JSON.stringify(sorted(right))

const toAttrs = (pool: aiplatform.GoogleCloudAiplatformV1SpecialistPool, project: string): infer _ => {
  const name = pool.name ?? ""
  const parsed = parseOwnership(pool.displayName)
  return {
    name,
    specialistPoolId: lastSegment(name),
    location: locationOf(name),
    project,
    displayName: parsed.text,
    specialistManagerEmails: pool.specialistManagerEmails ?? [],
    specialistWorkerEmails: pool.specialistWorkerEmails ?? [],
    specialistManagersCount: pool.specialistManagersCount,
    pendingDataLabelingJobs: pool.pendingDataLabelingJobs ?? [],
  }
}

const getByName = effect (name: string) => (name.length === 0 ? undefined : aiplatform
  .getProjectsLocationsSpecialistPools({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined;
    default: throw e;
  })

const waitUntilExists = effect (name: string) =>
  try (effect {
    return try effect {
      const pool = try getByName(name)
      return (pool ? pool : throw new SpecialistPoolNotResolved({ resourceName: name }))
    }
  }
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.AIPlatform.SpecialistPoolNotResolved",
      times: 8,
      schedule: Schedule.spaced("2 seconds"),
    }))

const listAt = effect (parent: string, project: string) =>
  (effect {
    return (Array.from(
      try (aiplatform.listProjectsLocationsSpecialistPools.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.specialistPools ?? []))
        |> Stream.filter(%, (pool) => hasOwnershipMarker(pool.displayName))
        |> Stream.map(%, (pool) => toAttrs(pool, project))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const findByDisplayName = effect (parent: string, displayName: string) =>
  (effect {
    return (try effect {
      const option = try (aiplatform.listProjectsLocationsSpecialistPools.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.specialistPools ?? []))
        |> Stream.filter(%, (pool) => pool.displayName === displayName)
        |> Stream.runHead(%))
      return (option._tag === "Some" ? option.value : undefined)
    })
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined; default: throw e; }

export const SpecialistPoolProvider = (): infer _ =>
  Provider.succeed(SpecialistPool, {
    stables: ["name", "specialistPoolId", "location", "project"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousLocation = olds?.location ?? output?.location
      const nextLocation = resolved.location ?? previousLocation
      if (previousLocation !== undefined && previousLocation !== nextLocation) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const existing = try getByName(output?.name ?? "")
      if (existing !== undefined) {
        const attrs = toAttrs(existing, env.project)
        return (try ownedByAlchemy(id, existing.displayName))
          ? attrs
          : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
      }
      const location = olds?.location ?? output?.location ?? env.region
      const parent = locationParent(env.project, location)
      const ownership = try createInternalLabels(id)
      const displayName = encodeOwnershipLine(ownership, olds?.displayName)
      const found = try findByDisplayName(parent, displayName)
      if (found === undefined) return undefined
      const attrs = toAttrs(found, env.project)
      return (try ownedByAlchemy(id, found.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      return (try Effect.forEach(
        listLocations(env.region),
        effect (location) => try listAt(locationParent(env.project, location), env.project),
      )).flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = news.location ?? output?.location ?? env.region
      const parent = locationParent(env.project, location)
      const ownership = try createInternalLabels(id)
      const displayName = encodeOwnershipLine(ownership, news.displayName)
      const managers = news.specialistManagerEmails
      const workers = news.specialistWorkerEmails

      let current = try getByName(output?.name ?? "")
      if (current === undefined) {
        current = try findByDisplayName(parent, displayName)
      }

      if (current === undefined) {
        const created = aiplatform
          .createProjectsLocationsSpecialistPools({
            parent,
            body: {
              displayName,
              specialistManagerEmails: managers,
              specialistWorkerEmails: workers,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: undefined; default: throw e; }
        if (created !== undefined) {
          const done = try waitForOperation(created, {
            alreadyExistsOk: true,
          })
          const createdName = (try Effect.orDie(Effect.try({
            try: () => resourceNameFromOperation(done),
            catch: (e) => e,
          }))) ?? ""
          if (createdName.length > 0) {
            current = try waitUntilExists(createdName)
          }
        }
        if (current === undefined) {
          current = try findByDisplayName(parent, displayName)
        }
      }

      if (current === undefined) {
        throw new SpecialistPoolNotResolved({
          resourceName: output?.name ?? `${parent}/specialistPools/-`,
        })
      }

      const name = current.name ?? ""
      const displayChanged = (current.displayName ?? "") !== displayName
      const managersChanged = !sameEmails(current.specialistManagerEmails, managers)
      const workersChanged = !sameEmails(current.specialistWorkerEmails, workers)

      if (displayChanged || managersChanged || workersChanged) {
        const patched = try aiplatform.patchProjectsLocationsSpecialistPools({
          name,
          updateMask: [
            displayChanged ? "displayName" : undefined,
            managersChanged ? "specialistManagerEmails" : undefined,
            workersChanged ? "specialistWorkerEmails" : undefined,
          ]
            .filter((field): field is string => field !== undefined)
            .join(","),
          body: {
            name,
            displayName,
            specialistManagerEmails: managers,
            specialistWorkerEmails: workers,
          },
        })
        try waitForOperation(patched)
        current = try waitUntilExists(name)
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const existing = try getByName(output.name)
      if (existing === undefined) return
      const operation = aiplatform
        .deleteProjectsLocationsSpecialistPools({
          name: output.name,
          force: true,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
