import * as pubsub from "@distilled.cloud/gcp/pubsub_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import type { Schema } from "./Schema.vibe"
import { ValidateMessage, type ValidateMessageRequest } from "./ValidateMessage.vibe"

/**
 * HTTP implementation of {@link ValidateMessage}.
 *
 * @layer
 * @provides GCP.PubSub.ValidateMessage
 */
export const ValidateMessageHttp = Layer.effect(
  ValidateMessage,
  effect {
    const bind = try GCPBindings.Bind
    const validate = try GCPBindings.withCredentials(pubsub.validateMessageProjectsSchemas)
    return effect (schema: Schema) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.PubSub.ValidateMessage(${schema})`({
          // schemas.validate is checked on the parent project, not the schema.
          iam: [{ role: "roles/pubsub.viewer" }],
        })
      }
      const name = try schema.name.asEffect()
      const project = try schema.project.asEffect()
      return effect (
        request: ValidateMessageRequest,
      ) =>
        try withSpan(
          effect {
            return try validate({
              parent: `projects/${try project}`,
              body: {
                ...request,
                name: try name,
              },
            })
          },
          `GCP.PubSub.ValidateMessage(${schema.LogicalId})`,
        )
    }
  },
)
