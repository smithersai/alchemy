import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor, type BindingIam, type GcpHttpOp } from "../HttpBinding.vibe"
import type { Subscription } from "./Subscription.vibe"
import type { Topic } from "./Topic.vibe"

/**
 * Shared HTTP scaffolding for Pub/Sub bindings.
 * NOT exported from index.ts.
 */
export const makeTopicHttpBinding = effect <I extends { topic: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (topic: Topic) => {
    const name = try topic.name.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${topic})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, topic.name), catch: (e) => e }))],
      })
    }
    return effect (request: Omit<I, "topic">) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            topic: try name,
          } as I)
        },
        `${options.tag}(${topic.LogicalId})`,
      )
  }
}

export const makeSubscriptionHttpBinding = effect <I extends { subscription: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (subscription: Subscription) => {
    const name = try subscription.name.asEffect()
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${subscription})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, subscription.name), catch: (e) => e }))],
      })
    }
    return effect (
      request: Omit<I, "subscription">,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            subscription: try name,
          } as I)
        },
        `${options.tag}(${subscription.LogicalId})`,
      )
  }
}
