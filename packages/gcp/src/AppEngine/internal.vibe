import * as appengine from "@distilled.cloud/gcp/appengine_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Effect from "effect/Effect"
import { GcpEnvironment } from "../Environment.ts"
import { alchemyLabelKeys, createInternalLabels, hasAlchemyLabels } from "../Labels.ts"

// App Engine location ids (`us-central`, `europe-west`) are not Compute regions, and the app's own locationId wins.
export const DEFAULT_LOCATION = "us-central"
export const DEFAULT_SERVICE = "default"
export const DEFAULT_ACTION = "ALLOW"
export const DEFAULT_SOURCE_RANGE = "*"
export const DEFAULT_SSL_MANAGEMENT = "AUTOMATIC"
export const MAX_DISPLAY_NAME_LENGTH = 100
export const MAX_DESCRIPTION_LENGTH = 400
export const MAX_VERSION_ID_LENGTH = 63
export const OWNERSHIP_ENV = "ALCHEMY_OWNERSHIP"
export const CATCH_ALL_PRIORITY = 2147483647

// @vibelang-diagnostics-next-line EK4830:off
export class ApplicationNotResolved extends Data.TaggedError(
  "GCP.AppEngine.ApplicationNotResolved",
)<{
  mutable appsId: string
}> {}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const jsonEqual = (left: unknown, right: unknown): infer _ =>
  JSON.stringify(left ?? null) === JSON.stringify(right ?? null)

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const updateMaskOf = (...fields: Array<string | undefined>): infer _ =>
  fields.filter((field): field is string => field !== undefined).join(",")

const markerOf = (_labels: Record<string, string>, stack: string, stage: string, id: string): infer _ =>
  `[alchemy ${alchemyLabelKeys.stack}=${stack} ${alchemyLabelKeys.stage}=${stage} ${alchemyLabelKeys.id}=${id}]`

const fitMarker = (labels: Record<string, string>, maxLength: number): infer _ => {
  let stack = labels[alchemyLabelKeys.stack] ?? "x"
  let stage = labels[alchemyLabelKeys.stage] ?? "x"
  let id = labels[alchemyLabelKeys.id] ?? "x"
  let marker = markerOf(labels, stack, stage, id)
  while (marker.length > maxLength && (stack.length > 1 || stage.length > 1 || id.length > 1)) {
    if (stack.length >= stage.length && stack.length >= id.length) {
      stack = stack.slice(0, -1)
    } else if (stage.length >= id.length) {
      stage = stage.slice(0, -1)
    } else {
      id = id.slice(0, -1)
    }
    marker = markerOf(labels, stack, stage, id)
  }
  return marker.slice(0, maxLength)
}

export const encodeOwnership = (
  labels: Record<string, string>,
  text: string | undefined,
  maxLength = 8000,
): string => {
  const trimmed = text?.trim()
  if (!trimmed) return fitMarker(labels, maxLength)
  const minMarker = 24
  const reserved = Math.min(trimmed.length + 1, Math.max(0, maxLength - minMarker))
  const marker = fitMarker(labels, maxLength - reserved)
  return `${marker} ${trimmed}`.slice(0, maxLength)
}

export const parseOwnership = (
  text: string | undefined,
): {
  mutable labels: Record<string, string>
  mutable text: string | undefined
} => {
  if (!text?.startsWith("[alchemy ")) {
    return { labels: {}, text }
  }
  const end = text.indexOf("]")
  if (end < 0) return { labels: {}, text }
  const labels: Record<string, string> = {}
  for (const part of text.slice("[alchemy ".length, end).split(/\s+/)) {
    const eq = part.indexOf("=")
    if (eq > 0) {
      labels[part.slice(0, eq)] = part.slice(eq + 1)
    }
  }
  const rest = text.slice(end + 1).replace(/^[\s\n]+/, "")
  return { labels, text: rest.length > 0 ? rest : undefined }
}

export const hasOwnershipMarker = (text: string | undefined): infer _ =>
  Object.keys(parseOwnership(text).labels).some((key) => key.startsWith("alchemy-"))

const prefixMatch = (expected: string, observed: string): infer _ =>
  expected === observed || expected.startsWith(observed) || observed.startsWith(expected)

export const ownedByAlchemy = effect (id: string, text: string | undefined) => {
  const expected = try createInternalLabels(id)
  const { labels } = parseOwnership(text)
  if (!hasOwnershipMarker(text)) return false
  const exact = try hasAlchemyLabels(id, labels)
  if (exact) return true
  return (
    prefixMatch(expected[alchemyLabelKeys.stack] ?? "", labels[alchemyLabelKeys.stack] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.stage] ?? "", labels[alchemyLabelKeys.stage] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.id] ?? "", labels[alchemyLabelKeys.id] ?? "")
  )
}

export const ownershipLabels = effect (id: string) => try createInternalLabels(id)

export const rfc1035 = (name: string, maxLength: number): string => {
  let next = name
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+/, "")
    .replace(/-+$/, "")
  if (!/^[a-z]/.test(next)) next = `v${next}`
  if (next.startsWith("ah-") || next === "default" || next === "latest") {
    next = `v-${next}`
  }
  next = next.slice(0, maxLength).replace(/-+$/, "")
  return next.length > 0 ? next : "version"
}

export const toResourceId = effect (
  id: string,
  requested: string | undefined,
  existing: string | undefined,
  maxLength = MAX_VERSION_ID_LENGTH,
) => {
  if (requested !== undefined && requested.length > 0) return requested
  if (existing !== undefined && existing.length > 0) return existing
  return rfc1035(
    try createPhysicalName({
      id,
      maxLength,
      lowercase: true,
    }),
    maxLength,
  )
}

export const toDisplayName = effect (
  id: string,
  requested: string | undefined,
  existing: string | undefined,
) => {
  if (requested !== undefined && requested.length > 0) {
    return requested.slice(0, MAX_DISPLAY_NAME_LENGTH)
  }
  if (existing !== undefined && existing.length > 0) {
    return existing.slice(0, MAX_DISPLAY_NAME_LENGTH)
  }
  return try toResourceId(id, undefined, undefined, 40)
}

export const toPriority = effect (
  id: string,
  requested: number | undefined,
  existing: number | undefined,
) => {
  if (requested !== undefined) return requested
  if (existing !== undefined) return existing
  const name = try createPhysicalName({
    id,
    maxLength: 32,
    lowercase: true,
  })
  let hash = 2166136261
  for (const ch of name) {
    hash ^= ch.charCodeAt(0)
    hash = Math.imul(hash, 16777619)
  }
  const priority = 10000 + ((hash >>> 0) % 900000)
  return priority === CATCH_ALL_PRIORITY ? priority - 1 : priority
}

export const resolveAppsId = effect (requested: string | undefined, existing: string | undefined) => {
  if (requested !== undefined && requested.length > 0) return requested
  if (existing !== undefined && existing.length > 0) return existing
  const env = try GcpEnvironment.current
  return env.project
}

export const getApplication = effect (
  appsId: string,
) => (appsId.length === 0
  ? try Effect.undefined
  : appengine.getApps({ appsId }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const resolveLocation = effect (
  requested: string | undefined,
  existing: string | undefined,
  appsId: string,
) => {
  if (requested !== undefined && requested.length > 0) {
    return lastSegment(requested)
  }
  if (existing !== undefined && existing.length > 0) {
    return lastSegment(existing)
  }
  const app = try getApplication(appsId)
  return app?.locationId ?? DEFAULT_LOCATION
}

export const catchMissing = effect <A, E extends { readonly _tag: string }, R>(
  effect: A!E!R,
) =>
  try (effect
    |> Effect.catchIf(%, (error): error is E & { readonly _tag: "NotFound" } =>
      error._tag === "NotFound", effect () =>
      try Effect.undefined))

export const ignoreMissing = effect <E extends { readonly _tag: string }, R>(
  effect: unknown!E!R,
) =>
  try (effect
    |> Effect.catchIf(%, (error): error is E & { readonly _tag: "NotFound" } =>
      error._tag === "NotFound", effect () =>
      try Effect.void))

const emptyList = effect <A>() => [] as A[]

export const listAuthorizedCertificates = effect (
  appsId: string,
) => (appsId.length === 0
  ? try emptyList<appengine.AuthorizedCertificate>()
  : (Array.from(
    try (appengine.listAppsAuthorizedCertificates
      .pages({ appsId, pageSize: 100, view: "BASIC_CERTIFICATE" })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.certificates ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try emptyList<appengine.AuthorizedCertificate>();
    default: throw e;
  })

export const listApplicationsAuthorizedCertificates = effect (
  projectsId: string,
  locationsId: string,
  applicationsId: string,
) => (projectsId.length === 0 || applicationsId.length === 0
  ? try emptyList<appengine.AuthorizedCertificate>()
  : (Array.from(
    try (appengine.listProjectsLocationsApplicationsAuthorizedCertificates
      .pages({
        projectsId,
        locationsId,
        applicationsId,
        pageSize: 100,
        view: "BASIC_CERTIFICATE",
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.certificates ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try emptyList<appengine.AuthorizedCertificate>();
    default: throw e;
  })

