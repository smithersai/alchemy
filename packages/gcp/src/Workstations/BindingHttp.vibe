import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { WorkstationCluster } from "./WorkstationCluster.vibe"
import type { WorkstationClustersWorkstationConfig } from "./WorkstationClustersWorkstationConfig.vibe"
import type { WorkstationClustersWorkstationConfigsWorkstation } from "./WorkstationClustersWorkstationConfigsWorkstation.vibe"

/**
 * Shared HTTP scaffolding for Cloud Workstations bindings.
 * NOT exported from index.ts.
 */
export const makeClusterHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (cluster: WorkstationCluster) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${cluster})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, cluster.name), catch: (e) => e }))],
      })
    }
    const name = try cluster.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${cluster.LogicalId})`,
      )
  }
}

