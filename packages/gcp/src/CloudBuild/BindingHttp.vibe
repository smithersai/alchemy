import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Repository } from "./Repository.vibe"

/**
 * Shared HTTP scaffolding for Cloud Build v2 repository bindings.
 * NOT exported from index.ts.
 */
export const makeRepositoryHttpBinding = effect <I extends { repository: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E> | ((input: I) => A!E)
}) => {
  const bind = try GCPBindings.Bind
  const run = Effect.isEffect(options.operation)
    ? try (options.operation as GcpHttpOp<I, A, E>)
    : (options.operation as (input: I) => A!E)
  return effect <T extends Repository>(repository: T) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${repository})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, repository.name), catch: (e) => e }))],
      })
    }
    const name = try repository.name.asEffect()
    return effect (
      request?: Omit<I, "repository"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            repository: try name,
          } as I)
        },
        `${options.tag}(${repository.LogicalId})`,
      )
  }
}
