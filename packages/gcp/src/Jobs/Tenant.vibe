import * as jobs from "@distilled.cloud/gcp/jobs_v4"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  deleteTenant,
  encodeOwnershipLine,
  findOwnedTenant,
  getTenant,
  listOwnedTenants,
  MAX_EXTERNAL_ID_LENGTH,
  ownedByAlchemy,
  ownershipLabels,
  parseOwnership,
  parseTenantName,
  projectParent,
  replaceOnIdentity,
  sameText,
  tenantNameOf,
  toGeneratedName,
  waitUntilGone,
} from "./internal.vibe"

export type TenantProps = {
  /**
   * Server-assigned tenant id (the `{tenant}` segment of
   * `projects/{project}/tenants/{tenant}`). Leave blank on create.
   * Immutable — changing it replaces the tenant.
   */
  mutable tenantId?: string
  /**
   * Client-side tenant identifier (max 255 characters). Cloud Talent
   * tenants have no labels field, so Alchemy ownership is stored in a
   * `[alchemy …]` prefix and stripped from attributes.
   */
  mutable externalId?: string
}

export type Tenant = Resource<
  "GCP.Jobs.Tenant",
  TenantProps,
  {
    /** Full resource name `projects/{project}/tenants/{tenant}`. */
    mutable name: string
    /** Server-assigned tenant id. */
    mutable tenantId: string
    /** Project id. */
    mutable project: string
    /** Client identifier with the Alchemy ownership prefix stripped. */
    mutable externalId: string | undefined
  },
  never,
  Providers
>

/**
 * A Cloud Talent Solution tenant. Tenants isolate jobs and companies
 * for different customer groups.
 *
 * Tenants have no labels field, so Alchemy stamps ownership into
 * `externalId` for `list` / nuke. The server-assigned tenant id is
 * identity — changing `tenantId` replaces the tenant. `externalId`
 * updates in place.
 *
 * ### Creating a Tenant
 * **Example:** Generated identifier
 * ```typescript
 * const tenant = yield* GCP.Jobs.Tenant("Acme", {});
 * ```
 *
 * **Example:** Explicit external id
 * ```typescript
 * const tenant = yield* GCP.Jobs.Tenant("Acme", {
 *   externalId: "acme-corp",
 * });
 * ```
 *
 * ### Updating a Tenant
 * Re-declare the same logical id with changed props; the engine keeps the
 * physical resource and updates it in place.
 *
 * **Example:** Change the client identifier
 * ```typescript
 * const tenant = yield* GCP.Jobs.Tenant("Acme", {
 *   externalId: "acme-holdings",
 * });
 * ```
 *
 * @resource
 * @category Jobs
 */
export const Tenant = Resource<Tenant>("GCP.Jobs.Tenant")

// @vibelang-diagnostics-next-line EK4830:off
export class TenantNotResolved extends Data.TaggedError("GCP.Jobs.TenantNotResolved")<{
  mutable resourceName: string
}> {}

const toAttrs = (tenant: jobs.Tenant, project: string): infer _ => {
  const name = tenant.name ?? ""
  const parsed = parseTenantName(name, project)
  return {
    name,
    tenantId: parsed.tenantId,
    project: parsed.project || project,
    externalId: parseOwnership(tenant.externalId).text,
  }
}

export const TenantProvider = (): infer _ =>
  Provider.succeed(Tenant, {
    stables: ["name", "tenantId", "project"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      return replaceOnIdentity({
        previousId: olds?.tenantId ?? output?.tenantId,
        nextId: news.tenantId,
      })
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const name = output?.name ?? tenantNameOf(env.project, olds?.tenantId ?? output?.tenantId ?? "")
      let existing = try getTenant(name)
      if (existing === undefined) {
        existing = try findOwnedTenant(env.project, id)
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try ownedByAlchemy(id, existing.externalId)) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const tenants = try listOwnedTenants(env.project)
      return tenants.map((tenant) => toAttrs(tenant, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const ownership = try ownershipLabels(id)
      const clientId = try toGeneratedName(id, news.externalId, output?.externalId)
      const externalId = encodeOwnershipLine(ownership, clientId, MAX_EXTERNAL_ID_LENGTH)
      const name = output?.name ?? tenantNameOf(env.project, news.tenantId ?? "")

      let current = try getTenant(name)
      if (current === undefined) {
        current = try findOwnedTenant(env.project, id)
      }

      if (current === undefined) {
        const created = jobs
          .createProjectsTenants({
            parent: projectParent(env.project),
            body: { externalId },
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try findOwnedTenant(env.project, id);
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new TenantNotResolved({
          resourceName: name || `projects/${env.project}/tenants/${clientId}`,
        })
      }

      const currentName = current.name ?? name
      if (!sameText(current.externalId, externalId)) {
        current = try jobs.patchProjectsTenants({
          name: currentName,
          updateMask: "externalId",
          body: { name: currentName, externalId },
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      try deleteTenant(output.name)
      try waitUntilGone(getTenant(output.name))
    },
  })
