import * as firebaseappdistribution from "@distilled.cloud/gcp/firebaseappdistribution_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Effect from "effect/Effect"
import { isTransientGcpError } from "../Errors.vibe"

export const MAX_DISPLAY_NAME = 1024
export const MAX_GROUP_ID = 63
export const MIN_GROUP_ID = 4

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceNotResolved extends Data.TaggedError(
  "GCP.FirebaseAppDistribution.ResourceNotResolved",
)<{
  resourceName: string
}> {}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const projectParent = (project: string): infer _ =>
  project.startsWith("projects/") ? project : `projects/${project}`

export const groupName = (project: string, groupId: string): infer _ => `${projectParent(project)}/groups/${groupId}`

export const parseGroupName = (
  name: string,
  fallbackProject = "",
): { project: string; groupId: string; parent: string } => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const projectsAt = parts.lastIndexOf("projects")
  const groupsAt = parts.lastIndexOf("groups")
  const project = projectsAt >= 0 && parts[projectsAt + 1] ? parts[projectsAt + 1]! : fallbackProject
  return {
    project,
    groupId: groupsAt >= 0 && parts[groupsAt + 1] ? parts[groupsAt + 1]! : lastSegment(name),
    parent: project.length > 0 ? projectParent(project) : "",
  }
}

export const groupIdOf = (value: string | undefined): infer _ => {
  if (value === undefined) return undefined
  const trimmed = value.replace(/\/+$/, "").trim()
  if (trimmed.length === 0) return undefined
  return lastSegment(trimmed)
}

export const sanitizeGroupId = (value: string): infer _ => {
  let cleaned = value
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "")
  if (cleaned.length === 0) cleaned = "group"
  if (!/^[a-z]/.test(cleaned)) cleaned = `g${cleaned}`
  if (cleaned.length < MIN_GROUP_ID) {
    cleaned = `${cleaned}${"xxxx".slice(0, MIN_GROUP_ID - cleaned.length)}`
  }
  cleaned = cleaned.slice(0, MAX_GROUP_ID).replace(/-+$/g, "")
  if (cleaned.length < MIN_GROUP_ID) cleaned = "group"
  return cleaned
}

export const toGroupId = effect (id: string, requested: string | undefined, existing?: string) => {
  const explicit = groupIdOf(requested)
  if (explicit !== undefined) return sanitizeGroupId(explicit)
  const previous = groupIdOf(existing)
  if (previous !== undefined) return sanitizeGroupId(previous)
  const generated = try createPhysicalName({
    id,
    maxLength: MAX_GROUP_ID,
    lowercase: true,
  })
  return sanitizeGroupId(generated)
}

export const parseDisplayName = (
  displayName: string | undefined,
): {
  labels: Record<string, string>
  displayName: string | undefined
} => {
  if (!displayName?.startsWith("[alchemy ")) {
    return { labels: {}, displayName }
  }
  const end = displayName.indexOf("]")
  if (end < 0) return { labels: {}, displayName }
  const labels: Record<string, string> = {}
  for (const part of displayName.slice("[alchemy ".length, end).split(/\s+/)) {
    const eq = part.indexOf("=")
    if (eq > 0) {
      labels[part.slice(0, eq)] = part.slice(eq + 1)
    }
  }
  const rest = displayName.slice(end + 1).trim()
  return { labels, displayName: rest.length > 0 ? rest : undefined }
}

export const hasOwnershipMarker = (displayName: string | undefined): infer _ =>
  Object.keys(parseDisplayName(displayName).labels).some((key) => key.startsWith("alchemy-"))

export const toDisplayName = effect (id: string, explicit: string | undefined, existing?: string) => {
  if (explicit !== undefined && explicit.length > 0) return explicit
  if (existing !== undefined && existing.length > 0) return existing
  return try createPhysicalName({
    id,
    maxLength: 40,
    lowercase: true,
  })
}

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const replaceOnIdentity = (previous: string | undefined, next: string | undefined): infer _ =>
  previous !== undefined && next !== undefined && previous !== next
    ? ({ action: "replace" as const, deleteFirst: true } as const)
    : undefined

export const retryTransient = effect <A, E extends { readonly _tag: string }, R>(
  effect: A!E!R,
) =>
  try (effect
    |> Effect.retry(%, {
      while: isTransientGcpError,
      times: 8,
      schedule: Schedule.exponential("250 millis"),
    }))

export const getGroup = effect (name: string) => (name.length === 0 ? try Effect.undefined : firebaseappdistribution
  .getProjectsGroups({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const listGroups = effect (
  parent: string,
) => (parent.length === 0
  ? [] as firebaseappdistribution.GoogleFirebaseAppdistroV1Group[]
  : (Array.from(
    try (firebaseappdistribution.listProjectsGroups
      .pages({
        parent,
        pageSize: 100,
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.groups ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as firebaseappdistribution.GoogleFirebaseAppdistroV1Group[];
    default: throw e;
  })
