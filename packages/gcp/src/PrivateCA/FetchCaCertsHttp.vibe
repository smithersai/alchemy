import * as privateca from "@distilled.cloud/gcp/privateca_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor } from "../HttpBinding.ts"
import type { CaPool } from "./CaPool.ts"
import { FetchCaCerts, type FetchCaCertsRequest } from "./FetchCaCerts.vibe"

/**
 * HTTP implementation of {@link FetchCaCerts}.
 *
 * @layer
 * @provides GCP.PrivateCA.FetchCaCerts
 */
export const FetchCaCertsHttp = Layer.effect(
  FetchCaCerts,
  effect {
    const bind = try GCPBindings.Bind
    const fetchCaCertsProjectsLocationsCaPools = try GCPBindings.withCredentials(
      privateca.fetchCaCertsProjectsLocationsCaPools,
    )
    return effect <P extends CaPool>(pool: P) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.PrivateCA.FetchCaCerts(${pool})`({
          iam: [
            try Effect.orDie(
              Effect.try({
                try: () => grantFor({ role: "roles/privateca.poolReader", on: "privateca.caPool" }, pool.name),
                catch: (e) => e,
              }),
            ),
          ],
        })
      }
      const name = try pool.name.asEffect()
      return effect (
        request?: FetchCaCertsRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try fetchCaCertsProjectsLocationsCaPools({
              caPool: try name,
              body: request?.requestId !== undefined ? { requestId: request.requestId } : {},
            })
          },
          `GCP.PrivateCA.FetchCaCerts(${pool.LogicalId})`,
        )
    }
  },
)
