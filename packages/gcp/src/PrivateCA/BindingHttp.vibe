import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor, type BindingIam, type GcpHttpOp } from "../HttpBinding.ts"
import type { CertificateAuthority } from "./CertificateAuthority.ts"

/**
 * Shared HTTP scaffolding for Certificate Authority Service bindings.
 * NOT exported from index.ts.
 */
export const makeCertificateAuthorityHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (ca: CertificateAuthority) => {
    // CAs have no IAM policy of their own; access is granted on the parent pool.
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${ca})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, ca.caPool), catch: (e) => e }))],
      })
    }
    const name = try ca.name.asEffect()
    return effect (request?: Omit<I, "name"> | undefined) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${ca.LogicalId})`,
      )
  }
}
