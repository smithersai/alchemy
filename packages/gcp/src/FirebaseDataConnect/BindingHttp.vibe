import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Service } from "./Service.vibe"
import type { ServicesConnector } from "./ServicesConnector.vibe"

/**
 * Shared HTTP scaffolding for Firebase Data Connect bindings.
 * NOT exported from index.ts.
 */
export const makeServiceHttpBinding = effect <I extends { mutable name: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (service: Service) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${service})`({
        iam: [grantFor(options.iam, service.name)],
      })
    }
    const name = try service.name.asEffect()
    return effect (
      request: Omit<I, "name">,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            name: try name,
          } as I)
        },
        `${options.tag}(${service.LogicalId})`,
      )
  }
}

export const makeConnectorHttpBinding = effect <I extends { mutable name: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (connector: ServicesConnector) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${connector})`({
        iam: [grantFor(options.iam, connector.name)],
      })
    }
    const name = try connector.name.asEffect()
    return effect (
      request: Omit<I, "name">,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            name: try name,
          } as I)
        },
        `${options.tag}(${connector.LogicalId})`,
      )
  }
}
