import * as dlp from "@distilled.cloud/gcp/dlp_v2"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  DEFAULT_LOCATION,
  DlpNotResolved,
  fingerprint,
  lastSegment,
  normalizeLocation,
  organizationLocationParent,
  organizationIdOf,
  parseName,
  replaceOn,
  resolveOrganization,
  sameText,
  updateMaskOf,
} from "./internal.vibe"

export type CloudSqlProperties = dlp.GooglePrivacyDlpV2CloudSqlProperties
export type ConnectionState = dlp.GooglePrivacyDlpV2ConnectionStateEnum | (string & {})
export type ConnectionError = dlp.GooglePrivacyDlpV2Error

export type OrganizationsLocationsConnectionProps = {
  /**
   * Parent organization (`organizations/{organization}` or the numeric
   * id). Defaults to `GOOGLE_ORGANIZATION_ID` or the project's Resource
   * Manager ancestor. Immutable — changing it replaces the connection.
   */
  organization?: string
  /**
   * Location of the Cloud SQL instance (`us-central1`, …). Must match the
   * region of `cloudSql.connectionName`. Immutable — changing it replaces
   * the connection.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Connection lifecycle state.
   * @default "MISSING_CREDENTIALS"
   */
  state?: ConnectionState
  /**
   * Cloud SQL properties. `connectionName` and `databaseEngine` are
   * identity — changing either replaces the connection.
   */
  cloudSql: CloudSqlProperties
}

export type OrganizationsLocationsConnection = Resource<
  "GCP.DLP.OrganizationsLocationsConnection",
  OrganizationsLocationsConnectionProps,
  {
    /** Full resource name `organizations/{organization}/locations/{location}/connections/{connection}`. */
    name: string
    /** Connection id (last path segment). Assigned by the API. */
    connectionId: string
    /** Organization resource name. */
    organization: string
    /** Organization id. */
    organizationId: string
    /** Location id. */
    location: string
    /** Project id of the deploying stack. */
    project: string
    /** Connection lifecycle state. */
    state: string
    /** Cloud SQL properties. */
    cloudSql: CloudSqlProperties | undefined
    /** Recent connection errors, if any. */
    errors: ConnectionError[] | undefined
  },
  never,
  Providers
>

/**
 * An organization-scoped Sensitive Data Protection connection to an
 * external data source (Cloud SQL).
 *
 * Connections have no labels or description field, so `list` returns an
 * empty set — nuke cannot discover them from the cloud. Organization,
 * location, Cloud SQL `connectionName`, and `databaseEngine` are identity.
 * State, credentials, and `maxConnections` update in place. The connection
 * id is assigned by the API.
 *
 * ### Creating a Connection
 * **Example:** Cloud SQL IAM connection
 * ```typescript
 * const connection = yield* GCP.DLP.OrganizationsLocationsConnection(
 *   "Warehouse",
 *   {
 *     location: "us-central1",
 *     state: "AVAILABLE",
 *     cloudSql: {
 *       connectionName: "my-project:us-central1:warehouse",
 *       databaseEngine: "DATABASE_ENGINE_POSTGRES",
 *       maxConnections: 2,
 *       cloudSqlIam: {},
 *     },
 *   },
 * );
 * ```
 *
 * @resource
 * @category DLP
 */
export const OrganizationsLocationsConnection = Resource<OrganizationsLocationsConnection>(
  "GCP.DLP.OrganizationsLocationsConnection",
)

const DEFAULT_STATE = "MISSING_CREDENTIALS" satisfies ConnectionState

const toAttrs = (
  connection: dlp.GooglePrivacyDlpV2Connection,
  organization: string,
  project: string,
): infer _ => {
  const name = connection.name ?? ""
  const parsed = parseName(name, "connections")
  return {
    name,
    connectionId: parsed.id || lastSegment(name),
    organization,
    organizationId: organizationIdOf(organization),
    location: parsed.location || DEFAULT_LOCATION,
    project,
    state: connection.state ?? DEFAULT_STATE,
    cloudSql: connection.cloudSql,
    errors: connection.errors,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dlp
  .getOrganizationsLocationsConnections({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const findByConnectionName = effect (
  parent: string,
  connectionName: string,
) => (connectionName.length === 0 ? try Effect.undefined : (effect {
  return (try effect {
    const option = try (dlp.listOrganizationsLocationsConnections.pages({ parent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.connections ?? []))
      |> Stream.filter(%, (connection) => (connection.cloudSql?.connectionName ?? "") === connectionName)
      |> Stream.runHead(%))
    return (option._tag === "Some" ? option.value : undefined)
  })
}) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; })

const stateOf = (value: string | undefined): infer _ => value ?? DEFAULT_STATE

export const OrganizationsLocationsConnectionProvider = (): infer _ =>
  Provider.succeed(OrganizationsLocationsConnection, {
    stables: ["name", "connectionId", "organization", "organizationId", "location", "project"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousLocation = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const nextLocation = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            resolved.location ?? olds?.location ?? output?.location,
            env.region,
          ),
        catch: (e) => e,
      }))
      const previousInstance = olds?.cloudSql?.connectionName ?? output?.cloudSql?.connectionName
      const nextInstance = resolved.cloudSql.connectionName ?? previousInstance
      const previousEngine = olds?.cloudSql?.databaseEngine ?? output?.cloudSql?.databaseEngine
      const nextEngine = resolved.cloudSql.databaseEngine ?? previousEngine
      return (
        (try Effect.orDie(
          Effect.try({
            try: () => replaceOn(olds?.organization ?? output?.organization, resolved.organization),
            catch: (e) => e,
          }),
        ))
          ?? (try Effect.orDie(Effect.try({ try: () => replaceOn(previousLocation, nextLocation), catch: (e) => e })))
          ?? (try Effect.orDie(Effect.try({ try: () => replaceOn(previousInstance, nextInstance), catch: (e) => e })))
          ?? (try Effect.orDie(Effect.try({ try: () => replaceOn(previousEngine, nextEngine), catch: (e) => e })))
      )
    },

    read: effect ({ olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = try resolveOrganization(
        olds?.organization ?? output?.organization,
        output?.organization,
      )
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const parent = try Effect.orDie(
        Effect.try({ try: () => organizationLocationParent(organization, location), catch: (e) => e }),
      )
      let existing = try getByName(output?.name ?? "")
      if (existing === undefined) {
        existing = try findByConnectionName(
          parent,
          olds?.cloudSql?.connectionName ?? output?.cloudSql?.connectionName ?? "",
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, organization, env.project)
      return output !== undefined
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => [],

    reconcile: effect ({ news, output }) => {
      const env = try GcpEnvironment.current
      const organization = try resolveOrganization(news.organization, output?.organization)
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const parent = try Effect.orDie(
        Effect.try({ try: () => organizationLocationParent(organization, location), catch: (e) => e }),
      )
      const state = stateOf(news.state)
      const cloudSql = news.cloudSql

      let current = try getByName(output?.name ?? "")
      if (current === undefined) {
        current = try findByConnectionName(
          parent,
          cloudSql.connectionName ?? output?.cloudSql?.connectionName ?? "",
        )
      }

      if (current === undefined) {
        const created = dlp
          .createOrganizationsLocationsConnections({
            parent,
            body: {
              connection: {
                state,
                cloudSql,
              },
            },
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try findByConnectionName(parent, cloudSql.connectionName ?? "");
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new DlpNotResolved({
          resourceName: `${parent}/connections/${cloudSql.connectionName ?? "unknown"}`,
        })
      }

      const currentName = current.name ?? ""
      const stateChanged = !sameText(current.state, state)
      const sqlChanged =
        (try Effect.orDie(Effect.try({ try: fingerprint.bind(undefined, current.cloudSql), catch: (e) => e })))
        !== (try Effect.orDie(Effect.try({
          try: () => fingerprint(cloudSql),
          catch: (e) => e,
        })))
      const updateMask = try Effect.orDie(Effect.try({
        try: () =>
          updateMaskOf(
            stateChanged ? "state" : undefined,
            sqlChanged ? "cloudSql" : undefined,
          ),
        catch: (e) => e,
      }))

      if (updateMask.length > 0) {
        current = try dlp.patchOrganizationsLocationsConnections({
          name: currentName,
          body: {
            updateMask,
            connection: {
              state,
              cloudSql,
            },
          },
        })
      }

      return toAttrs(current, organization, env.project)
    },

    delete: effect ({ output }) => {
      dlp
        .deleteOrganizationsLocationsConnections({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: try Effect.void;
          default: throw e;
        }
    },
  })
