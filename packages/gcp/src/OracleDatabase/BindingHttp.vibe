import type { Output } from "alchemy/Output"
import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.vibe"
import { type BindingIam, type GcpHttpOp } from "../HttpBinding.vibe"

/**
 * Shared HTTP scaffolding for Oracle Database@Google Cloud bindings.
 * NOT exported from index.ts.
 */
export const makeOracleNameHttpBinding = effect <
  Resource extends {
    readonly name: Output<string, never>
    readonly LogicalId: string
  },
  I extends { name?: string },
  A,
  E,
>(options: {
  tag: string
  /** Oracle Database@Google Cloud has no resource-level IAM: project grant. */
  iam: Pick<BindingIam, "role">
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (resource: Resource) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${resource})`({ iam: [{ role: options.iam.role }] })
    }
    const name = try resource.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${resource.LogicalId})`,
      )
  }
}
