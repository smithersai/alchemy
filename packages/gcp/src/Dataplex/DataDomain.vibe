import * as dataplex from "@distilled.cloud/gcp/dataplex_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { tagRecord } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels, diffLabels, hasAlchemyLabels, toLabels } from "../Labels.ts"
import type { Providers } from "../Providers.ts"
import {
  DataplexNotResolved,
  collectPages,
  fingerprint,
  hasAlchemyLabelMap,
  listAtLocation,
  normalizeLocation,
  parentOf,
  parseName,
  replaceOnIdentity,
  retryQuota,
  toPhysicalId,
  userLabels,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type DataDomainContact = dataplex.GoogleCloudDataplexV1ContactIdentity
export type DataDomainContacts = dataplex.GoogleCloudDataplexV1Contacts

export type DataDomainProps = {
  /**
   * DataDomain id. If omitted, a unique name is generated. Must contain
   * only lowercase letters, numbers and hyphens, start with a letter,
   * end with a letter or number, and be 1-63 characters. Immutable —
   * changing it replaces the domain.
   */
  dataDomainId?: string
  /**
   * Region (`us-central1`, …). Immutable — changing it replaces the
   * domain.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * User-friendly display name. Required.
   */
  displayName: string
  /**
   * User-provided description.
   */
  description?: string
  /**
   * Immutable parent DataDomain resource name. Empty for a top-level
   * domain. Changing it replaces the domain.
   */
  parentDataDomain?: string
  /**
   * User labels. Alchemy ownership labels are merged in automatically.
   */
  labels?: Record<string, string>
  /**
   * Business contacts for the domain. Required.
   */
  contacts: DataDomainContacts
}

export type DataDomain = Resource<
  "GCP.Dataplex.DataDomain",
  DataDomainProps,
  {
    /** Full resource name. */
    name: string
    /** DataDomain id (last path segment). */
    dataDomainId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Display name. */
    displayName: string | undefined
    /** Description. */
    description: string | undefined
    /** Parent DataDomain resource name, if nested. */
    parentDataDomain: string | undefined
    /** User labels (Alchemy ownership labels stripped). */
    labels: Record<string, string>
    /** Business contacts. */
    contacts: DataDomainContacts | undefined
    /** System uid. */
    uid: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Dataplex DataDomain — a logical grouping of data resources for
 * governance, discovery, and management.
 *
 * Location, domain id, and parent domain are immutable. Display name,
 * description, contacts, and labels update in place.
 *
 * ### Creating a DataDomain
 * **Example:** Top-level domain
 * ```typescript
 * const domain = yield* GCP.Dataplex.DataDomain("Finance", {
 *   displayName: "Finance",
 *   labels: { env: "test" },
 *   contacts: {
 *     identities: [
 *       {
 *         contactName: "steward",
 *         contactRole: "steward",
 *         contactId: "steward@example.com",
 *       },
 *     ],
 *   },
 * });
 * ```
 *
 * @resource
 * @category Dataplex
 */
export const DataDomain = Resource<DataDomain>("GCP.Dataplex.DataDomain")

const resourceName = (project: string, location: string, dataDomainId: string): infer _ =>
  `projects/${project}/locations/${location}/dataDomains/${dataDomainId}`

const toAttrs = (domain: dataplex.GoogleCloudDataplexV1DataDomain, project: string): infer _ => {
  const name = domain.name ?? ""
  const parsed = parseName(name, "dataDomains")
  return {
    name,
    dataDomainId: parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    displayName: domain.displayName,
    description: domain.description,
    parentDataDomain: domain.parentDataDomain,
    labels: userLabels(domain.labels),
    contacts: domain.contacts,
    uid: domain.uid,
    createTime: domain.createTime,
    updateTime: domain.updateTime,
  }
}

const getByName = effect (name: string) =>
  retryQuota(dataplex.getProjectsLocationsDataDomains({ name })) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  }

const listDomains = effect (project: string, region: string) => {
  const collect = effect (parent: string) =>
    (effect {
      return ((try collectPages(
        dataplex.listProjectsLocationsDataDomains.pages({
          parent,
          pageSize: 100,
        }),
        (page) => page.dataDomains,
      )).filter((item) => hasAlchemyLabelMap(item.labels)))
    }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: [];
      default: throw e;
    }
  return try listAtLocation(project, region, collect)
}

export const listAlchemyDataDomains = effect (project: string, region: string) => try listDomains(project, region)

export const DataDomainProvider = (): infer _ =>
  Provider.succeed(DataDomain, {
    stables: [
      "name",
      "dataDomainId",
      "project",
      "location",
      "parentDataDomain",
      "uid",
      "createTime",
    ],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.dataDomainId ?? output?.dataDomainId,
            nextId: resolved.dataDomainId ?? olds?.dataDomainId ?? output?.dataDomainId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            previousParent: olds?.parentDataDomain ?? output?.parentDataDomain,
            nextParent: resolved.parentDataDomain ?? olds?.parentDataDomain,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const dataDomainId = try toPhysicalId(
        id,
        olds?.dataDomainId,
        output?.dataDomainId,
        "datadomain",
      )
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const name = output?.name ?? resourceName(env.project, location, dataDomainId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try hasAlchemyLabels(
          id,
          try Effect.orDie(Effect.try({ try: () => tagRecord(existing.labels), catch: (e) => e })),
        ))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const items = try listDomains(env.project, env.region)
      return items.map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const dataDomainId = try toPhysicalId(
        id,
        news.dataDomainId,
        output?.dataDomainId,
        "datadomain",
      )
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const name = resourceName(env.project, location, dataDomainId)
      const desiredLabels = {
        ...try Effect.orDie(Effect.try({ try: () => toLabels(news.labels), catch: (e) => e })),
        ...(try createInternalLabels(id)),
      }

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = retryQuota(
          dataplex.createProjectsLocationsDataDomains({
            parent: parentOf(env.project, location),
            dataDomainId,
            body: {
              displayName: news.displayName,
              description: news.description,
              parentDataDomain: news.parentDataDomain,
              labels: desiredLabels,
              contacts: news.contacts,
            },
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new DataplexNotResolved({ resourceName: name })
      }

      const observedLabels = tagRecord(current.labels)
      const { upsert, removed } = try Effect.orDie(
        Effect.try({ try: () => diffLabels(observedLabels, desiredLabels), catch: (e) => e }),
      )
      const labelsChanged = upsert.length > 0 || removed.length > 0
      const descriptionChanged = (current.description ?? "") !== (news.description ?? "")
      const displayNameChanged = (current.displayName ?? "") !== news.displayName
      const contactsChanged =
        (try Effect.orDie(Effect.try({ try: fingerprint.bind(undefined, current.contacts), catch: (e) => e })))
          !== (try Effect.orDie(Effect.try({
            try: () => fingerprint(news.contacts),
            catch: (e) => e,
          })))

      if (labelsChanged || descriptionChanged || displayNameChanged || contactsChanged) {
        const operation = try dataplex.patchProjectsLocationsDataDomains({
          name: current.name ?? name,
          updateMask: [
            labelsChanged ? "labels" : undefined,
            descriptionChanged ? "description" : undefined,
            displayNameChanged ? "displayName" : undefined,
            contactsChanged ? "contacts" : undefined,
          ]
            .filter((field): field is string => field !== undefined)
            .join(","),
          body: {
            name: current.name ?? name,
            displayName: news.displayName,
            description: news.description,
            labels: desiredLabels,
            contacts: news.contacts,
          },
        })
        try waitForOperation(operation)
        current = try waitUntilExists(getByName(current.name ?? name), current.name ?? name)
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (dataplex
          .deleteProjectsLocationsDataDomains({ name: output.name })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
