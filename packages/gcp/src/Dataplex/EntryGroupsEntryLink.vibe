import * as dataplex from "@distilled.cloud/gcp/dataplex_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  DataplexNotResolved,
  RELATED_ENTRY_LINK_TYPE,
  collectPages,
  expandParent,
  fingerprint,
  hasAlchemyLabelMap,
  lastSegment,
  listAtLocation,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  retryQuota,
  toPhysicalId,
  waitUntilExists,
  waitUntilGone,
} from "./internal.vibe"

export type EntryLinkReference = {
  /**
   * Referenced Entry resource name
   * `projects/{project}/locations/{location}/entryGroups/{entryGroup}/entries/{entry}`.
   * Immutable.
   */
  name: string
  /**
   * Path in the Entry. Empty means the Entry itself. Immutable.
   */
  path?: string
  /**
   * Reference type (`SOURCE` or `TARGET`). Immutable.
   */
  type?: dataplex.GoogleCloudDataplexV1EntryLinkEntryReferenceTypeEnum | (string & {})
}

export type EntryGroupsEntryLinkProps = {
  /**
   * Parent Entry Group. Full name
   * `projects/{project}/locations/{location}/entryGroups/{entryGroup}`
   * or the entry-group id (combined with `location`). Immutable —
   * changing it replaces the link.
   */
  entryGroup: string
  /**
   * Entry link id. If omitted, a unique name is generated from the
   * stack, stage, and logical id. Must be 1-63 characters, start with
   * a letter, and match `[a-z]([a-z0-9-]*[a-z0-9])?`. Immutable —
   * changing it replaces the link.
   */
  entryLinkId?: string
  /**
   * Region used when `entryGroup` is a bare id. Immutable — changing it
   * replaces the link.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Entry link type resource name. Immutable — changing it replaces
   * the link.
   * @default "projects/dataplex-types/locations/global/entryLinkTypes/related"
   */
  entryLinkType?: string
  /**
   * Exactly two entry references (`SOURCE` and `TARGET`). Immutable —
   * changing them replaces the link.
   */
  entryReferences: EntryLinkReference[]
  /**
   * Aspects attached to the link, keyed by
   * `{project}.{location}.{aspectType}`.
   */
  aspects?: dataplex.GoogleCloudDataplexV1AspectMap
}

export type EntryGroupsEntryLink = Resource<
  "GCP.Dataplex.EntryGroupsEntryLink",
  EntryGroupsEntryLinkProps,
  {
    /** Full resource name. */
    name: string
    /** Entry link id (last path segment). */
    entryLinkId: string
    /** Parent entry group resource name. */
    entryGroup: string
    /** Parent entry group id. */
    entryGroupId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Entry link type resource name. */
    entryLinkType: string | undefined
    /** Referenced entries. */
    entryReferences: EntryLinkReference[]
    /** Aspects attached to the link. */
    aspects: dataplex.GoogleCloudDataplexV1AspectMap | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Dataplex Entry Link between two Catalog Entries.
 *
 * Entry links have no labels field. `list` finds links by looking up
 * entries in alchemy-labeled entry groups. Changing `entryLinkId`,
 * `entryGroup`, `location`, `entryLinkType`, or `entryReferences`
 * replaces the link. Aspects update in place.
 *
 * ### Creating an Entry Link
 * **Example:** Related entries
 * ```typescript
 * const link = yield* GCP.Dataplex.EntryGroupsEntryLink("Related", {
 *   entryGroup: group.name,
 *   entryReferences: [
 *     { name: left.name, type: "SOURCE" },
 *     { name: right.name, type: "TARGET" },
 *   ],
 * });
 * ```
 *
 * @resource
 * @category Dataplex
 */
export const EntryGroupsEntryLink = Resource<EntryGroupsEntryLink>(
  "GCP.Dataplex.EntryGroupsEntryLink",
)

const resolveParent = (
  project: string,
  entryGroup: string,
  location: string | undefined,
  defaultLocation: string,
): infer _ => {
  const parent = expandParent(
    entryGroup,
    project,
    normalizeLocation(location, defaultLocation),
    "entryGroups",
  )
  const parsed = parseName(`${parent}/entryLinks/_`, "entryLinks")
  return {
    parent: parsed.parent,
    location: parsed.location,
    project: parsed.project || project,
    entryGroupId: lastSegment(parsed.parent),
  }
}

const resourceName = (parent: string, entryLinkId: string): infer _ => `${parent}/entryLinks/${entryLinkId}`

const linkTypeOf = (value: string | undefined): infer _ => value && value.length > 0 ? value : RELATED_ENTRY_LINK_TYPE

const refsOf = (
  refs:
    | readonly dataplex.GoogleCloudDataplexV1EntryLinkEntryReference[]
    | readonly EntryLinkReference[]
    | undefined,
): EntryLinkReference[] =>
  (refs ?? []).flatMap((ref) =>
    ref.name === undefined
      ? []
      : [
        {
          name: ref.name,
          path: ref.path,
          type: ref.type,
        },
      ]
  )

const refsKey = (refs: readonly EntryLinkReference[] | undefined): infer _ =>
  fingerprint(
    refsOf(refs)
      .map((ref) => ({
        name: ref.name,
        path: ref.path ?? "",
        type: (ref.type ?? "").toUpperCase(),
      }))
      .sort((left, right) => left.name.localeCompare(right.name)),
  )

const toAttrs = (link: dataplex.GoogleCloudDataplexV1EntryLink, project: string): infer _ => {
  const name = link.name ?? ""
  const parsed = parseName(name, "entryLinks")
  const group = parseName(parsed.parent, "entryGroups")
  return {
    name,
    entryLinkId: parsed.id,
    entryGroup: parsed.parent,
    entryGroupId: group.id,
    project: parsed.project || project,
    location: parsed.location,
    entryLinkType: link.entryLinkType,
    entryReferences: refsOf(link.entryReferences),
    aspects: link.aspects,
    createTime: link.createTime,
    updateTime: link.updateTime,
  }
}

const getByName = effect (name: string) =>
  retryQuota(dataplex.getProjectsLocationsEntryGroupsEntryLinks({ name })) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  }

const getGroup = effect (name: string) =>
  dataplex
    .getProjectsLocationsEntryGroups({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: try Effect.undefined;
      default: throw e;
    }

const lookupLinks = effect (locationParent: string, entry: string, project: string) =>
  (effect {
    return ((try collectPages(
      dataplex.lookupEntryLinksProjectsLocations.pages({
        name: locationParent,
        entry,
        pageSize: 10,
      }),
      (page) => page.entryLinks,
    )).map((item) => toAttrs(item, project)))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [];
    default: throw e;
  }

export const EntryGroupsEntryLinkProvider = (): infer _ =>
  Provider.succeed(EntryGroupsEntryLink, {
    stables: [
      "name",
      "entryLinkId",
      "entryGroup",
      "entryGroupId",
      "project",
      "location",
      "entryLinkType",
      "createTime",
    ],

    diff: effect ({ news, olds, output }) => {
      const resolved_ = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved_ === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousType = linkTypeOf(olds?.entryLinkType ?? output?.entryLinkType)
      const nextType = linkTypeOf(resolved_.entryLinkType ?? previousType)
      const previousRefs = refsKey(olds?.entryReferences ?? output?.entryReferences)
      const nextRefs = refsKey(resolved_.entryReferences ?? olds?.entryReferences)
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.entryLinkId ?? output?.entryLinkId,
            nextId: resolved_.entryLinkId ?? olds?.entryLinkId ?? output?.entryLinkId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved_.location ?? olds?.location ?? output?.location,
              env.region,
            ),
            previousParent: olds?.entryGroup ?? output?.entryGroup,
            nextParent: resolved_.entryGroup ?? olds?.entryGroup ?? output?.entryGroup,
            extra: nextType !== previousType || nextRefs !== previousRefs,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const resolved = resolveParent(
        env.project,
        olds?.entryGroup ?? output?.entryGroup ?? "",
        olds?.location ?? output?.location,
        env.region,
      )
      const entryLinkId = try toPhysicalId(
        id,
        olds?.entryLinkId,
        output?.entryLinkId,
        "entrylink",
      )
      const name = output?.name ?? resourceName(resolved.parent, entryLinkId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      const group = try getGroup(attrs.entryGroup)
      if (group === undefined) return try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
      return (try Effect.orDie(Effect.try({ try: () => hasAlchemyLabelMap(group.labels), catch: (e) => e })))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const groups = try listAtLocation(env.project, env.region, effect (parent) =>
        (try collectPages(
          dataplex.listProjectsLocationsEntryGroups.pages({
            parent,
            pageSize: 1000,
          }),
          (page) => page.entryGroups,
        )).filter((item) => hasAlchemyLabelMap(item.labels)))
      const seen = new Set<string>()
      const found: ReturnType<typeof toAttrs>[] = []
      try Effect.forEach(
        groups,
        effect (group) => {
          if (group.name === undefined) return
          const entries = collectPages(
            dataplex.listProjectsLocationsEntryGroupsEntries.pages({
              parent: group.name,
              pageSize: 100,
            }),
            (page) => page.entries,
          ) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }
          const name2 = group.name
          const locationParent = `projects/${env.project}/locations/${
            (try Effect.orDie(Effect.try({ try: () => parseName(name2, "entryGroups"), catch: (e) => e }))).location
          }`
          const pages = try Effect.forEach(
            entries,
            effect (entry) =>
              entry.name
                ? try lookupLinks(locationParent, entry.name, env.project)
                : [],
            { concurrency: 4 },
          )
          for (const link of pages.flat()) {
            if (seen.has(link.name)) continue
            seen.add(link.name)
            found.push(link)
          }
        },
        { concurrency: 2 },
      )
      return found
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const resolved = resolveParent(
        env.project,
        news.entryGroup,
        news.location ?? output?.location,
        env.region,
      )
      const entryLinkId = try toPhysicalId(
        id,
        news.entryLinkId,
        output?.entryLinkId,
        "entrylink",
      )
      const name = resourceName(resolved.parent, entryLinkId)
      const entryLinkType = linkTypeOf(news.entryLinkType)
      const entryReferences = refsOf(news.entryReferences)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = (effect {
          return (try (dataplex
            .createProjectsLocationsEntryGroupsEntryLinks({
              parent: resolved.parent,
              entryLinkId,
              body: {
                entryLinkType,
                entryReferences,
                aspects: news.aspects,
              },
            })
            |> retryQuota(%)))
        }) catch effect (e) => match (e) {
          when { _tag: "Conflict" }: try getByName(name);
          default: throw e;
        }
        current = created ?? undefined
        if (current === undefined) {
          current = try waitUntilExists(getByName(name), name)
        }
      }

      if (current === undefined) {
        throw new DataplexNotResolved({ resourceName: name })
      }

      const aspectsChanged = news.aspects !== undefined
        && (try Effect.orDie(Effect.try({ try: fingerprint.bind(undefined, news.aspects), catch: (e) => e })))
          !== (try Effect.orDie(Effect.try({ try: fingerprint.bind(undefined, current.aspects), catch: (e) => e })))

      if (aspectsChanged) {
        current = try retryQuota(
          dataplex.patchProjectsLocationsEntryGroupsEntryLinks({
            name: current.name ?? name,
            body: {
              name: current.name ?? name,
              aspects: news.aspects,
            },
          }),
        )
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      retryQuota(
        dataplex.deleteProjectsLocationsEntryGroupsEntryLinks({
          name: output.name,
        }),
      ) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
