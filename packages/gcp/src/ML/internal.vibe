import * as ml from "@distilled.cloud/gcp/ml_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import { tagRecord } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import {
  alchemyLabelKeys,
  ALCHEMY_LABEL_PREFIX,
  createInternalLabels,
  hasAlchemyLabels,
  stripInternalLabels,
} from "../Labels.vibe"

export const MAX_NAME_LENGTH = 63
export const MAX_DESCRIPTION_LENGTH = 8000

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceNotResolved extends Data.TaggedError("GCP.ML.ResourceNotResolved")<{
  resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceStillExists extends Data.TaggedError("GCP.ML.ResourceStillExists")<{
  resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class VersionNotReady extends Data.TaggedError("GCP.ML.VersionNotReady")<{
  resourceName: string
  state: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class VersionFailed extends Data.TaggedError("GCP.ML.VersionFailed")<{
  resourceName: string
  message: string
}> {}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const parentOf = (name: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  return parts.slice(0, -2).join("/")
}

export const rfc1035 = (name: string, fallback: string): string => {
  let next = name
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "")
  if (!/^[a-z]/.test(next)) next = `m${next}`
  next = next.slice(0, MAX_NAME_LENGTH).replace(/-+$/g, "")
  if (next.length === 0) return fallback
  if (!/[a-z0-9]$/.test(next)) next = `${next.slice(0, MAX_NAME_LENGTH - 1)}0`
  return next.slice(0, MAX_NAME_LENGTH)
}

export const toPhysicalId = effect (
  id: string,
  explicit: string | undefined,
  existing: string | undefined,
  fallback: string,
) => {
  if (explicit !== undefined && explicit.length > 0) {
    return rfc1035(lastSegment(explicit), fallback)
  }
  if (existing !== undefined && existing.length > 0) {
    return lastSegment(existing)
  }
  return rfc1035(
    try createPhysicalName({
      id,
      maxLength: MAX_NAME_LENGTH,
      lowercase: true,
    }),
    fallback,
  )
}

export const projectParent = (project: string): infer _ => `projects/${project}`

export const modelResourceName = (project: string, modelId: string): infer _ =>
  `${projectParent(project)}/models/${modelId}`

export const versionResourceName = (modelName: string, versionId: string): infer _ =>
  `${modelName}/versions/${versionId}`

export const expandModel = (project: string, value: string): infer _ => {
  const next = value.replace(/\/+$/, "")
  if (next.includes("/models/")) return next
  return modelResourceName(project, lastSegment(next))
}

export const parseModelName = (name: string, fallbackProject = ""): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const modelsAt = parts.lastIndexOf("models")
  const projectsAt = parts.lastIndexOf("projects")
  return {
    project: projectsAt >= 0 && parts[projectsAt + 1] ? parts[projectsAt + 1]! : fallbackProject,
    modelId: modelsAt >= 0 && parts[modelsAt + 1] ? parts[modelsAt + 1]! : lastSegment(name),
    parent: modelsAt > 0 ? parts.slice(0, modelsAt).join("/") : projectParent(""),
  }
}

export const parseVersionName = (name: string, fallbackProject = ""): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const versionsAt = parts.lastIndexOf("versions")
  const parsed = parseModelName(name, fallbackProject)
  return {
    ...parsed,
    versionId: versionsAt >= 0 && parts[versionsAt + 1] ? parts[versionsAt + 1]! : lastSegment(name),
    model: versionsAt > 0
      ? parts.slice(0, versionsAt).join("/")
      : modelResourceName(parsed.project, parsed.modelId),
  }
}

export const userLabels = (
  labels: Record<string, string | undefined> | null | undefined,
): Record<string, string> => stripInternalLabels(tagRecord(labels))

export const hasAlchemyLabelMap = (labels: Record<string, string | undefined> | null | undefined): infer _ =>
  Object.keys(labels ?? {}).some((key) => key.startsWith(ALCHEMY_LABEL_PREFIX))

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const sameStringList = (
  left: readonly string[] | undefined,
  right: readonly string[] | undefined,
): infer _ =>
  JSON.stringify([...(left ?? [])].map((value) => value.toLowerCase()).sort())
  === JSON.stringify([...(right ?? [])].map((value) => value.toLowerCase()).sort())

export const normalizeRegions = (
  regions: readonly string[] | undefined,
  fallback: readonly string[],
): string[] => {
  const next = [...(regions ?? [])]
    .map((region) => lastSegment(region).toLowerCase())
    .filter((region) => region.length > 0)
  return next.length > 0 ? next : [...fallback]
}

export const fieldMask = (fields: Array<string | false | undefined>): infer _ =>
  fields.filter((field): field is string => typeof field === "string").join(",")

const markerOf = (labels: Record<string, string>, stack: string, stage: string, id: string): infer _ =>
  `[alchemy ${alchemyLabelKeys.stack}=${stack} ${alchemyLabelKeys.stage}=${stage} ${alchemyLabelKeys.id}=${id}]`

const fitMarker = (labels: Record<string, string>, maxLength: number): infer _ => {
  let stack = labels[alchemyLabelKeys.stack] ?? "x"
  let stage = labels[alchemyLabelKeys.stage] ?? "x"
  let id = labels[alchemyLabelKeys.id] ?? "x"
  let marker = markerOf(labels, stack, stage, id)
  while (marker.length > maxLength && (stack.length > 1 || stage.length > 1 || id.length > 1)) {
    if (stack.length >= stage.length && stack.length >= id.length) {
      stack = stack.slice(0, -1)
    } else if (stage.length >= id.length) {
      stage = stage.slice(0, -1)
    } else {
      id = id.slice(0, -1)
    }
    marker = markerOf(labels, stack, stage, id)
  }
  return marker.length <= maxLength ? marker : `${marker.slice(0, Math.max(0, maxLength - 1))}]`
}

export const encodeOwnership = (
  labels: Record<string, string>,
  text: string | undefined,
  maxLength = MAX_DESCRIPTION_LENGTH,
): string => {
  const marker = fitMarker(labels, maxLength)
  const trimmed = text?.trim()
  if (!trimmed) return marker
  return `${marker}\n${trimmed}`.slice(0, maxLength)
}

export const parseOwnership = (
  text: string | undefined,
): {
  labels: Record<string, string>
  text: string | undefined
} => {
  if (!text?.startsWith("[alchemy ")) {
    return { labels: {}, text }
  }
  const end = text.indexOf("]")
  if (end < 0) return { labels: {}, text }
  const labels: Record<string, string> = {}
  for (const part of text.slice("[alchemy ".length, end).split(/\s+/)) {
    const eq = part.indexOf("=")
    if (eq > 0) {
      labels[part.slice(0, eq)] = part.slice(eq + 1)
    }
  }
  const rest = text.slice(end + 1).replace(/^[\s\n]+/, "")
  return { labels, text: rest.length > 0 ? rest : undefined }
}

export const hasOwnershipMarker = (text: string | undefined): infer _ =>
  Object.keys(parseOwnership(text).labels).some((key) => key.startsWith(ALCHEMY_LABEL_PREFIX))

const prefixMatch = (expected: string, observed: string): infer _ =>
  expected === observed || expected.startsWith(observed) || observed.startsWith(expected)

export const ownedByAlchemy = effect (id: string, text: string | undefined) => {
  const expected = try createInternalLabels(id)
  const { labels } = parseOwnership(text)
  if (!hasOwnershipMarker(text)) return false
  const exact = try hasAlchemyLabels(id, labels)
  if (exact) return true
  return (
    prefixMatch(expected[alchemyLabelKeys.stack] ?? "", labels[alchemyLabelKeys.stack] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.stage] ?? "", labels[alchemyLabelKeys.stage] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.id] ?? "", labels[alchemyLabelKeys.id] ?? "")
  )
}

export const modelOwnedByAlchemy = effect (id: string, model: ml.GoogleCloudMlV1__Model) => {
  if (
    try hasAlchemyLabels(
      id,
      try Effect.orDie(Effect.try({ try: () => tagRecord(model.labels), catch: (e) => e })),
    )
  ) return true
  return try ownedByAlchemy(id, model.description)
}

export const versionOwnedByAlchemy = effect (id: string, version: ml.GoogleCloudMlV1__Version) => {
  if (
    try hasAlchemyLabels(
      id,
      try Effect.orDie(Effect.try({ try: () => tagRecord(version.labels), catch: (e) => e })),
    )
  ) return true
  return try ownedByAlchemy(id, version.description)
}

export const modelHasOwnership = (model: ml.GoogleCloudMlV1__Model): infer _ =>
  hasAlchemyLabelMap(model.labels) || hasOwnershipMarker(model.description)

export const versionHasOwnership = (version: ml.GoogleCloudMlV1__Version): infer _ =>
  hasAlchemyLabelMap(version.labels) || hasOwnershipMarker(version.description)

export const replaceOnIdentity = (input: {
  previousId?: string
  nextId?: string
  previousParent?: string
  nextParent?: string
  extra?: boolean
}): infer _ => {
  const idChanged = input.previousId !== undefined
    && input.nextId !== undefined
    && input.previousId !== input.nextId
  const parentChanged = (input.previousParent ?? "") !== ""
    && (input.nextParent ?? "") !== ""
    && (input.previousParent ?? "") !== (input.nextParent ?? "")
  if (!idChanged && !parentChanged && input.extra !== true) {
    return undefined
  }
  return {
    action: "replace" as const,
    deleteFirst: !idChanged
      && !parentChanged
      && input.extra === true
      && input.previousId !== undefined
      && input.nextId === input.previousId,
  }
}

export const getModel = effect (
  name: string,
) => (name.length === 0
  ? undefined
  : ml.getProjectsModels({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined;
    default: throw e;
  })

export const getVersion = effect (name: string) => (name.length === 0 ? undefined : ml
  .getProjectsModelsVersions({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined;
    default: throw e;
  })

const emptyList = effect <A>() => [] as A[]

export const listModels = effect (project: string) =>
  (effect {
    return (Array.from(
      try (ml.listProjectsModels
        .pages({
          parent: projectParent(project),
          pageSize: 100,
        })
        |> Stream.runCollect(%)),
    ).flatMap((page) => page.models ?? []))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try emptyList<ml.GoogleCloudMlV1__Model>();
    default: throw e;
  }

export const listVersions = effect (
  parent: string,
) => (parent.length === 0
  ? try emptyList<ml.GoogleCloudMlV1__Version>()
  : (effect {
    return (Array.from(
      try (ml.listProjectsModelsVersions
        .pages({
          parent,
          pageSize: 100,
        })
        |> Stream.runCollect(%)),
    ).flatMap((page) => page.versions ?? []))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try emptyList<ml.GoogleCloudMlV1__Version>();
    default: throw e;
  })

export const listOwnedModels = effect (project: string) => (try listModels(project)).filter(modelHasOwnership)

export const listOwnedVersions = effect (project: string) => {
  const models = try listOwnedModels(project)
  const pages = try Effect.forEach(
    models,
    effect (model) => (model.name ? try listVersions(model.name) : try emptyList<ml.GoogleCloudMlV1__Version>()),
    { concurrency: 4 },
  )
  return pages.flat().filter((version) => versionHasOwnership(version))
}

type Tagged = { readonly _tag: string }

const versionState = (version: ml.GoogleCloudMlV1__Version): infer _ => (version.state ?? "").toUpperCase()

export const waitUntilGone = effect <A, R>(
  get: A!Tagged!R,
  name: string,
): void!Tagged!R =>
  try (get
    |> Effect.filterOrFail(%, (value) => value === undefined, () => new ResourceStillExists({ resourceName: name }))
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.ML.ResourceStillExists",
      times: 10,
      schedule: Schedule.spaced("2 seconds"),
    })
    |> Effect.asVoid(%))

export const waitUntilExists = effect <A, R>(
  get: A!Tagged!R,
  name: string,
): Exclude<A, undefined>!Tagged!R =>
  try (get
    |> Effect.filterOrFail(
      %,
      (value): value is Exclude<A, undefined> => value !== undefined,
      () => new ResourceNotResolved({ resourceName: name }),
    )
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.ML.ResourceNotResolved",
      times: 8,
      schedule: Schedule.spaced("1 second"),
    }))

export const waitUntilVersionReady = effect (
  name: string,
): ml.GoogleCloudMlV1__Version!(ml.Forbidden | ml.GcpOpError | ResourceNotResolved | VersionFailed | VersionNotReady)!ml.GcpOpContext =>
  try (effect {
    return try effect {
      const version = try (getVersion(name)
        |> Effect.filterOrFail(
          %,
          (version): version is ml.GoogleCloudMlV1__Version => version !== undefined,
          () => new ResourceNotResolved({ resourceName: name }),
        )
        |> Effect.filterOrFail(%, (version) => {
          const state = versionState(version)
          return state === "" || state === "READY" || state === "FAILED"
        }, (version) =>
          new VersionNotReady({
            resourceName: name,
            state: version.state ?? "",
          })))
      return (versionState(version) === "FAILED"
        ? throw new VersionFailed({
          resourceName: name,
          message: version.errorMessage ?? "version failed",
        })
        : version)
    }
  }
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.ML.ResourceNotResolved" || error._tag === "GCP.ML.VersionNotReady",
      times: 10,
      schedule: Schedule.spaced("5 seconds"),
    }))
