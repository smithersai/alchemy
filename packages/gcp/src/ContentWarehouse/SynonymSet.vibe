import * as cw from "@distilled.cloud/gcp/contentwarehouse_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  MAX_CONTEXT_LENGTH,
  ensureProject,
  locationParent,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  rfc1035,
  sameJson,
  sameText,
  toPhysicalId,
  userSynonyms,
  waitUntilExists,
  waitUntilGone,
  ResourceNotResolved,
} from "./internal.ts"

export type Synonym = cw.GoogleCloudContentwarehouseV1SynonymSetSynonym

export type SynonymSetProps = {
  /**
   * Context id (the `{context}` segment of
   * `projects/{project}/locations/{location}/synonymSets/{context}`).
   * If omitted, a unique RFC1035 context is generated. Immutable —
   * changing it replaces the synonym set.
   */
  context?: string
  /**
   * Multi-region location (`us` or `eu`). Immutable — changing it
   * replaces the synonym set. `US` is accepted and normalized to `us`.
   * @default "us"
   */
  location?: string
  /**
   * Groups of synonymous words.
   */
  synonyms?: Synonym[]
}

export type SynonymSet = Resource<
  "GCP.ContentWarehouse.SynonymSet",
  SynonymSetProps,
  {
    /** Full resource name. */
    name: string
    /** Context id (last path segment). */
    context: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Synonym groups. */
    synonyms: Synonym[] | undefined
  },
  never,
  Providers
>

const DEFAULT_SYNONYMS: Synonym[] = [{ words: ["sale", "invoice", "bill"] }]

/**
 * A Document AI Warehouse synonym set — custom search synonyms for a
 * query context (`sales`, `engineering`, …).
 *
 * Synonym sets have no labels field; Alchemy identifies one by its
 * context. Without state, a set found under an explicit `context` is
 * reported as unowned. Context and location are immutable. Synonym groups update in place.
 *
 * ### Creating a Synonym Set
 * **Example:** Sales synonyms
 * ```typescript
 * const synonyms = yield* GCP.ContentWarehouse.SynonymSet("Sales", {
 *   context: "sales",
 *   synonyms: [{ words: ["sale", "invoice", "bill"] }],
 * });
 * ```
 *
 * @resource
 * @category ContentWarehouse
 */
export const SynonymSet = Resource<SynonymSet>("GCP.ContentWarehouse.SynonymSet")

const resourceName = (project: string, location: string, context: string): infer _ =>
  `${locationParent(project, location)}/synonymSets/${context}`

const contextOf = effect (id: string, explicit: string | undefined, existing: string | undefined) => {
  if (explicit !== undefined) {
    return (try Effect.orDie(Effect.try({ try: () => rfc1035(explicit, "sales"), catch: (e) => e }))).slice(
      0,
      MAX_CONTEXT_LENGTH,
    )
  }
  if (existing !== undefined) return existing
  return try toPhysicalId(id, undefined, undefined, "syn")
}

const toAttrs = (item: cw.GoogleCloudContentwarehouseV1SynonymSet, project: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, "synonymSets")
  return {
    name,
    context: item.context ?? parsed.id,
    project: parsed.project || project,
    location: parsed.location,
    synonyms: userSynonyms(item.synonyms),
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : cw
  .getProjectsLocationsSynonymSets({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const SynonymSetProvider = (): infer _ =>
  Provider.succeed(SynonymSet, {
    stables: ["name", "context", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.context ?? output?.context,
            nextId: resolved.context,
            previousLocation: olds?.location ?? output?.location,
            nextLocation: resolved.location ?? olds?.location ?? output?.location,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location), catch: (e) => e }),
      )
      const context = try contextOf(id, olds?.context, output?.context)
      const existing = try getByName(
        output?.name ?? resourceName(env.project, location, context),
      )
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      // State or the generated context proves ownership.
      return output !== undefined || olds?.context === undefined
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location), catch: (e) => e }),
      )
      const parent = try Effect.orDie(
        Effect.try({ try: () => locationParent(env.project, location), catch: (e) => e }),
      )
      try ensureProject(parent)
      const context = try contextOf(id, news.context, output?.context)
      const name = resourceName(env.project, location, context)
      const synonyms = news.synonyms ?? DEFAULT_SYNONYMS

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = cw
          .createProjectsLocationsSynonymSets({
            parent,
            body: { context, synonyms },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? (try waitUntilExists(getByName(name), name))
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      const currentName = current.name ?? name
      const contextChanged = !sameText(current.context, context)
      // `current.synonyms` may still hold an ownership group written by an
      // earlier version; comparing raw groups removes it on the next patch.
      const synonymsChanged = !(try Effect.orDie(Effect.try({
        try: sameJson.bind(undefined, current.synonyms ?? [], synonyms),
        catch: (e) => e,
      })))
      if (contextChanged || synonymsChanged) {
        current = try cw.patchProjectsLocationsSynonymSets({
          name: currentName,
          body: {
            name: currentName,
            context,
            synonyms,
          },
        })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      cw
        .deleteProjectsLocationsSynonymSets({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: try Effect.void;
          default: throw e;
        }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
