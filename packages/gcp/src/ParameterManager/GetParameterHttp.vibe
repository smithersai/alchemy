import * as parametermanager from "@distilled.cloud/gcp/parametermanager_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor } from "../HttpBinding.vibe"
import { GetParameter } from "./GetParameter.vibe"
import type { Parameter } from "./Parameter.vibe"

/**
 * HTTP implementation of {@link GetParameter}.
 *
 * @layer
 * @provides GCP.ParameterManager.GetParameter
 */
export const GetParameterHttp = Layer.effect(
  GetParameter,
  effect {
    const bind = try GCPBindings.Bind
    const getParameter = try GCPBindings.withCredentials(
      parametermanager.getProjectsLocationsParameters,
    )
    return effect (parameter: Parameter) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.ParameterManager.GetParameter(${parameter})`({
          // Parameter Manager has no resource-level IAM; an IAM Condition on
          // the parameter name scopes the project grant to this parameter.
          iam: [
            try Effect.orDie(Effect.try({
              try: () =>
                grantFor(
                  {
                    role: "roles/parametermanager.parameterViewer",
                    scopeByCondition: true,
                  },
                  parameter.name,
                ),
              catch: (e) => e,
            })),
          ],
        })
      }
      const name = try parameter.name.asEffect()
      return effect () =>
        try withSpan(
          effect {
            return try getParameter({ name: try name })
          },
          `GCP.ParameterManager.GetParameter(${parameter.LogicalId})`,
        )
    }
  },
)
