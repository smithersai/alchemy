import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor, type BindingIam, type GcpHttpOp } from "../HttpBinding.vibe"
import type { ParametersVersion } from "./ParametersVersion.vibe"

/**
 * Shared HTTP scaffolding for Parameter Manager version bindings.
 * NOT exported from index.ts.
 */
export const makeParameterVersionHttpBinding = effect <I, A, E, Req = void>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
  toInput: (versionName: string, request: Req | undefined) => I
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (version: ParametersVersion) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${version})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, version.name), catch: (e) => e }))],
      })
    }
    const name = try version.name.asEffect()
    return effect (request?: Req | undefined) =>
      try withSpan(
        effect {
          return try run(options.toInput(try name, request))
        },
        `${options.tag}(${version.LogicalId})`,
      )
  }
}
