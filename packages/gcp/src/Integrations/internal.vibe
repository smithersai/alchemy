import * as integrations from "@distilled.cloud/gcp/integrations_v1"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import { isDeleted, lastSegment, locationParent } from "./ownership.vibe"

export const parseResourceName = (name: string, collection: string, defaultLocation: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const collectionAt = parts.lastIndexOf(collection)
  const locationsAt = parts.lastIndexOf("locations")
  const projectsAt = parts.lastIndexOf("projects")
  const instancesAt = parts.lastIndexOf("sfdcInstances")
  return {
    project: projectsAt >= 0 && parts[projectsAt + 1] ? parts[projectsAt + 1]! : "",
    location: locationsAt >= 0 && parts[locationsAt + 1] ? parts[locationsAt + 1]! : defaultLocation,
    id: collectionAt >= 0 && parts[collectionAt + 1] ? parts[collectionAt + 1]! : lastSegment(name),
    sfdcInstanceId: instancesAt >= 0 && parts[instancesAt + 1] ? parts[instancesAt + 1]! : "",
    sfdcInstance: instancesAt >= 0
      ? parts.slice(0, instancesAt + 2).join("/")
      : parts.slice(0, Math.max(0, parts.length - 2)).join("/"),
    parent: collectionAt > 0
      ? parts.slice(0, collectionAt).join("/")
      : parts.slice(0, Math.max(0, parts.length - 1)).join("/"),
  }
}

const collectPages = effect <Page, A, E, R>(
  pages: Stream.Stream<Page, E, R>,
  items: (page: Page) => readonly A[] | undefined,
) =>
  Array.from(
    try (pages
      |> Stream.flatMap((page) => Stream.fromIterable(items(page) ?? []))(%)
      |> Stream.runCollect(%)),
  )

export const listSfdcInstances = effect (parent: string) =>
  (collectPages(
    integrations.listProjectsLocationsSfdcInstances.pages({
      parent,
      pageSize: 1000,
    }),
    (page) => page.sfdcInstances,
  ) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as integrations.GoogleCloudIntegrationsV1alphaSfdcInstance[];
    default: throw e;
  }).filter((item) => !isDeleted(item))

export const listSfdcChannels = effect (parent: string) =>
  (collectPages(
    integrations.listProjectsLocationsSfdcInstancesSfdcChannels.pages({
      parent,
      pageSize: 1000,
    }),
    (page) => page.sfdcChannels,
  ) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as integrations.GoogleCloudIntegrationsV1alphaSfdcChannel[];
    default: throw e;
  }).filter((item) => !isDeleted(item))

export const listTemplates = effect (parent: string) =>
  collectPages(
    integrations.listProjectsLocationsTemplates.pages({
      parent,
      // A page of 200+ makes Integrations scan a template the project can't
      // see and fail the whole list with 400 "Template ... is not visible to
      // the current project"; 100 lists normally.
      pageSize: 100,
    }),
    (page) => page.templates,
  ) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as integrations.GoogleCloudIntegrationsV1alphaTemplate[];
    default: throw e;
  }

export const listOwnedSfdcChannels = effect (project: string, location: string) => {
  const instances = try listSfdcInstances(locationParent(project, location))
  const groups = try Effect.forEach(
    instances.filter((instance) => (instance.name ?? "").length > 0),
    (instance) => listSfdcChannels(instance.name!),
    { concurrency: 4 },
  )
  return groups.flat()
}

export const findSfdcInstanceByDescription = effect (parent: string, description: string) =>
  (try listSfdcInstances(parent)).find((item) => item.description === description)

export const findSfdcChannelByDescription = effect (parent: string, description: string) =>
  (try listSfdcChannels(parent)).find((item) => item.description === description)

export const findTemplateByDescription = effect (parent: string, description: string) =>
  (try listTemplates(parent)).find((item) => item.description === description)
