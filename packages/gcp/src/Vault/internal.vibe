import * as vault from "@distilled.cloud/gcp/vault_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Effect from "effect/Effect"
import { alchemyLabelKeys, createInternalLabels, hasAlchemyLabels } from "../Labels.vibe"

export const MAX_MATTER_NAME_LENGTH = 100
export const MAX_HOLD_NAME_LENGTH = 100
export const MAX_EXPORT_NAME_LENGTH = 100
export const MAX_SAVED_QUERY_NAME_LENGTH = 100

const markerOf = (_labels: Record<string, string>, stack: string, stage: string, id: string): infer _ =>
  `[alchemy ${alchemyLabelKeys.stack}=${stack} ${alchemyLabelKeys.stage}=${stage} ${alchemyLabelKeys.id}=${id}]`

const fitMarker = (labels: Record<string, string>, maxLength: number): infer _ => {
  let stack = labels[alchemyLabelKeys.stack] ?? "x"
  let stage = labels[alchemyLabelKeys.stage] ?? "x"
  let id = labels[alchemyLabelKeys.id] ?? "x"
  let marker = markerOf(labels, stack, stage, id)
  while (marker.length > maxLength && (stack.length > 1 || stage.length > 1 || id.length > 1)) {
    if (stack.length >= stage.length && stack.length >= id.length) {
      stack = stack.slice(0, -1)
    } else if (stage.length >= id.length) {
      stage = stage.slice(0, -1)
    } else {
      id = id.slice(0, -1)
    }
    marker = markerOf(labels, stack, stage, id)
  }
  return marker.slice(0, maxLength)
}

export const encodeOwnership = (
  labels: Record<string, string>,
  text: string | undefined,
): string => {
  const marker = fitMarker(labels, 8000)
  const trimmed = text?.trim()
  return trimmed && trimmed.length > 0 ? `${marker}\n${trimmed}` : marker
}

export const encodeOwnershipLine = (
  labels: Record<string, string>,
  text: string | undefined,
  maxLength = MAX_HOLD_NAME_LENGTH,
): string => {
  const trimmed = text?.replace(/[\r\n]+/g, " ").trim()
  if (!trimmed) return fitMarker(labels, maxLength)
  const minMarker = 24
  const reserved = Math.min(trimmed.length + 1, Math.max(0, maxLength - minMarker))
  const marker = fitMarker(labels, maxLength - reserved)
  return `${marker} ${trimmed}`.slice(0, maxLength)
}

export const parseOwnership = (
  text: string | undefined,
): {
  labels: Record<string, string>
  text: string | undefined
} => {
  if (!text?.startsWith("[alchemy ")) {
    return { labels: {}, text }
  }
  const end = text.indexOf("]")
  if (end < 0) return { labels: {}, text }
  const labels: Record<string, string> = {}
  for (const part of text.slice("[alchemy ".length, end).split(/\s+/)) {
    const eq = part.indexOf("=")
    if (eq > 0) {
      labels[part.slice(0, eq)] = part.slice(eq + 1)
    }
  }
  const rest = text.slice(end + 1).replace(/^[\s\n]+/, "")
  return { labels, text: rest.length > 0 ? rest : undefined }
}

export const hasOwnershipMarker = (text: string | undefined): infer _ =>
  Object.keys(parseOwnership(text).labels).some((key) => key.startsWith("alchemy-"))

const prefixMatch = (expected: string, observed: string): infer _ =>
  expected === observed || expected.startsWith(observed) || observed.startsWith(expected)

export const ownedByAlchemy = effect (id: string, text: string | undefined) => {
  const expected = try createInternalLabels(id)
  const { labels } = parseOwnership(text)
  if (!hasOwnershipMarker(text)) return false
  const exact = try hasAlchemyLabels(id, labels)
  if (exact) return true
  return (
    prefixMatch(expected[alchemyLabelKeys.stack] ?? "", labels[alchemyLabelKeys.stack] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.stage] ?? "", labels[alchemyLabelKeys.stage] ?? "")
    && prefixMatch(expected[alchemyLabelKeys.id] ?? "", labels[alchemyLabelKeys.id] ?? "")
  )
}

export const ownershipLabels = effect (id: string) => try createInternalLabels(id)

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const jsonEqual = (left: unknown, right: unknown): infer _ =>
  JSON.stringify(left ?? null) === JSON.stringify(right ?? null)

export const toGeneratedName = effect (
  id: string,
  requested: string | undefined,
  existing: string | undefined,
  maxLength = 40,
) => {
  if (requested !== undefined && requested.length > 0) {
    return requested.slice(0, maxLength)
  }
  if (existing !== undefined && existing.length > 0) {
    return existing.slice(0, maxLength)
  }
  const generated = try createPhysicalName({
    id,
    maxLength,
    lowercase: true,
  })
  const next = /^[a-z]/.test(generated) ? generated : `v${generated}`.slice(0, maxLength)
  return next.length >= 4 ? next : `${next}xxxx`.slice(0, maxLength)
}

const emptyList = effect <A>() => [] as A[]

export const catchMissing = effect <A, E extends { readonly _tag: string }, R>(
  effect: A!E!R,
) =>
  try (effect
    |> Effect.catchIf(
      %,
      (error): error is E & { readonly _tag: "NotFound" } => error._tag === "NotFound",
      effect () => undefined,
    ))

export const ignoreMissing = effect <E extends { readonly _tag: string }, R>(
  effect: unknown!E!R,
) =>
  try (effect
    |> Effect.catchIf(
      %,
      (error): error is E & { readonly _tag: "NotFound" } => error._tag === "NotFound",
      effect () => (undefined as void),
    ))

export const getMatter = effect (
  matterId: string,
) => (matterId.length === 0 ? undefined : try catchMissing(vault.getMatters({ matterId, view: "FULL" })))

export const listMatters = effect () =>
  (effect {
    return (Array.from(
      try (vault.listMatters.pages({ pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.matters ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try emptyList<vault.Matter>(); default: throw e; }

export const listActiveMatters = effect () =>
  (try listMatters()).filter((matter) => matter.state !== "DELETED" && (matter.matterId ?? "").length > 0)

export const findOwnedMatter = effect (id: string) => {
  const matters = try listMatters()
  for (const matter of matters) {
    if (try ownedByAlchemy(id, matter.description)) {
      return matter
    }
  }
  return undefined
}

export const closeThenDeleteMatter = effect (matterId: string) => {
  if (matterId.length === 0) return
  const current = try getMatter(matterId)
  if (current === undefined || current.state === "DELETED") return
  if (current.state === "OPEN") {
    vault.closeMatters({ matterId, body: {} }) catch effect (e) => match (e) {
      when { _tag: "NotFound" }: undefined as void;
      when { _tag: "BadRequest" }: undefined as void;
      when { _tag: "Conflict" }: undefined as void;
      default: throw e;
    }
  }
  vault.deleteMatters({ matterId }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined as void;
    when { _tag: "BadRequest" }: undefined as void;
    when { _tag: "Conflict" }: undefined as void;
    default: throw e;
  }
}

export const getHold = effect (
  matterId: string,
  holdId: string,
) => (matterId.length === 0 || holdId.length === 0 ? undefined : try catchMissing(
  vault.getMattersHolds({
    matterId,
    holdId,
    view: "FULL_HOLD",
  }),
))

export const listHolds = effect (
  matterId: string,
) => (matterId.length === 0
  ? try emptyList<vault.Hold>()
  : (effect {
    return (Array.from(
      try (vault.listMattersHolds.pages({ matterId, pageSize: 100, view: "FULL_HOLD" })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.holds ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try emptyList<vault.Hold>(); default: throw e; })

export const findHoldByName = effect (matterId: string, name: string) =>
  (try listHolds(matterId)).find((hold) => hold.name === name)

export const findOwnedHold = effect (id: string, matterId?: string) => {
  const parents = matterId !== undefined && matterId.length > 0 ? [{ matterId }] : try listActiveMatters()
  for (const parent of parents) {
    const parentId = parent.matterId ?? ""
    const holds = try listHolds(parentId)
    for (const hold of holds) {
      if (try ownedByAlchemy(id, hold.name)) {
        return { hold, matterId: parentId }
      }
    }
  }
  return undefined
}

export const getExport = effect (
  matterId: string,
  exportId: string,
) => (matterId.length === 0 || exportId.length === 0
  ? undefined
  : try catchMissing(vault.getMattersExports({ matterId, exportId })))

export const listExports = effect (
  matterId: string,
) => (matterId.length === 0
  ? try emptyList<vault.Export>()
  : (effect {
    return (Array.from(
      try (vault.listMattersExports.pages({ matterId, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.exports ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try emptyList<vault.Export>(); default: throw e; })

export const findExportByName = effect (matterId: string, name: string) =>
  (try listExports(matterId)).find((item) => item.name === name)

export const findOwnedExport = effect (id: string, matterId?: string) => {
  const parents = matterId !== undefined && matterId.length > 0 ? [{ matterId }] : try listActiveMatters()
  for (const parent of parents) {
    const parentId = parent.matterId ?? ""
    const items = try listExports(parentId)
    for (const item of items) {
      if (try ownedByAlchemy(id, item.name)) {
        return item
      }
    }
  }
  return undefined
}

export const getSavedQuery = effect (
  matterId: string,
  savedQueryId: string,
) => (matterId.length === 0 || savedQueryId.length === 0
  ? undefined
  : try catchMissing(vault.getMattersSavedQueries({ matterId, savedQueryId })))

export const listSavedQueries = effect (
  matterId: string,
) => (matterId.length === 0
  ? try emptyList<vault.SavedQuery>()
  : (effect {
    return (Array.from(
      try (vault.listMattersSavedQueries.pages({ matterId, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.savedQueries ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try emptyList<vault.SavedQuery>(); default: throw e; })

export const findSavedQueryByName = effect (matterId: string, displayName: string) =>
  (try listSavedQueries(matterId)).find((item) => item.displayName === displayName)

export const findOwnedSavedQuery = effect (id: string, matterId?: string) => {
  const parents = matterId !== undefined && matterId.length > 0 ? [{ matterId }] : try listActiveMatters()
  for (const parent of parents) {
    const parentId = parent.matterId ?? ""
    const items = try listSavedQueries(parentId)
    for (const item of items) {
      if (try ownedByAlchemy(id, item.displayName)) {
        return item
      }
    }
  }
  return undefined
}

export const accountKey = (account: vault.HeldAccount): infer _ =>
  (account.email ?? account.accountId ?? "").toLowerCase()

export const sameAccounts = (
  left: readonly vault.HeldAccount[] | undefined,
  right: readonly vault.HeldAccount[] | undefined,
): infer _ =>
  jsonEqual(
    [...(left ?? [])].map(accountKey).filter(Boolean).sort(),
    [...(right ?? [])].map(accountKey).filter(Boolean).sort(),
  )

export const sameOrgUnit = (
  left: vault.HeldOrgUnit | undefined,
  right: vault.HeldOrgUnit | undefined,
): infer _ => sameText(left?.orgUnitId, right?.orgUnitId)

export const desiredAccounts = (
  accounts: readonly vault.HeldAccount[] | undefined,
): vault.HeldAccount[] | undefined => {
  if (accounts === undefined) return undefined
  return accounts.map((account) => ({
    email: account.email,
    accountId: account.accountId,
  }))
}
