import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor, type BindingIam, type GcpHttpOp } from "../HttpBinding.ts"
import type { CatalogsServingConfig } from "./CatalogsServingConfig.vibe"

/**
 * Shared HTTP scaffolding for Retail serving-config bindings.
 * NOT exported from index.ts.
 */
export const makeServingConfigHttpBinding = effect <I extends { mutable placement: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (servingConfig: CatalogsServingConfig) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${servingConfig})`({
        iam: [grantFor(options.iam, servingConfig.name)],
      })
    }
    const name = try servingConfig.name.asEffect()
    return effect (
      request: Omit<I, "placement">,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            placement: try name,
          } as I)
        },
        `${options.tag}(${servingConfig.LogicalId})`,
      )
  }
}
