import { Credentials } from "@distilled.cloud/gcp/Credentials"
import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor, type BindingIam } from "../HttpBinding.vibe"
import type { Job } from "./Job.vibe"

/**
 * Shared HTTP scaffolding for Cloud Scheduler job bindings.
 * NOT exported from index.ts.
 *
 * Distilled ops are `OperationMethod`s: yield them once at Layer construction
 * (after providing Credentials + HttpClient) so the inner runtime Effect is
 * `Effect<A, E>` and does not leak `GcpOpContext`.
 */
export const makeJobHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation:
    & (((input: I) => A!E)!never!(Credentials | HttpClient.HttpClient))
    & ((input: I) => A!E!(Credentials | HttpClient.HttpClient))
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (job: Job) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${job})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, job.name), catch: (e) => e }))],
      })
    }
    const name = try job.name.asEffect()
    return effect (request?: Omit<I, "name"> | undefined) =>
      try withSpan(
        effect {
          const jobName = try name
          return try run({
            ...request,
            name: jobName,
          } as I)
        },
        `${options.tag}(${job.LogicalId})`,
      )
  }
}
