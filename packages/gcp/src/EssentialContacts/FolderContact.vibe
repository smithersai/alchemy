import * as essentialcontacts from "@distilled.cloud/gcp/essentialcontacts_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  desiredCategories,
  desiredLanguage,
  encodeEmail,
  findOwnedContact,
  folderParent,
  hasOwnershipMarker,
  lastSegment,
  listContacts,
  listFolderParents,
  normalizeEmail,
  ownedByAlchemy,
  ownershipLabels,
  resolveFolder,
  sameCategories,
  sameText,
  toCoreAttrs,
  toCreateBody,
  toEmail,
  UPDATE_MASK,
  type NotificationCategory,
} from "./internal.ts"

export type FolderContactProps = {
  /**
   * Parent folder (`folders/{folder}` or the numeric id). Defaults to
   * the project's Resource Manager folder
   * ancestor. Immutable — changing it replaces the contact.
   */
  folderId?: string
  /**
   * Email address that receives Google Cloud notifications. Does not
   * need to be a Google Account. Immutable — changing it replaces the
   * contact. If omitted, a unique `example.com` address is generated.
   * Essential Contacts have no labels field, so Alchemy stamps
   * ownership into a `+alc.{stack}.{stage}.{id}` plus-tag and strips it
   * from attributes.
   */
  email?: string
  /**
   * Preferred notification language as a BCP-47 / ISO 639-1 tag
   * (`en-US`, `en-GB`, `ja`, …).
   * @default "en-US"
   */
  languageTag?: string
  /**
   * Notification categories this contact subscribes to.
   * @default ["ALL"]
   */
  notificationCategorySubscriptions?: NotificationCategory[]
}

export type FolderContact = Resource<
  "GCP.EssentialContacts.FolderContact",
  FolderContactProps,
  {
    /** Full resource name `folders/{folder}/contacts/{contact}`. */
    name: string
    /** Server-assigned contact id (last path segment). */
    contactId: string
    /** Parent resource `folders/{folder}`. */
    parent: string
    /** Folder id (last path segment of `parent`). */
    folderId: string
    /** Project id used when the contact was reconciled. */
    project: string
    /** User email with the Alchemy plus-tag stripped. */
    email: string
    /** Preferred notification language. */
    languageTag: string
    /** Subscribed notification categories. */
    notificationCategorySubscriptions: NotificationCategory[]
    /** Server-reported validation state. */
    validationState: string | undefined
    /** RFC3339 time the validation state was last updated. */
    validateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A folder-level Google Cloud Essential Contact.
 *
 * Essential Contacts have no labels field, so Alchemy stamps ownership
 * into the email plus-tag for `list` / nuke. Folder and email are
 * identity — changing either replaces the contact. Language and
 * notification categories update in place.
 *
 * ### Creating a Folder Contact
 * **Example:** Technical contact on a folder
 * ```typescript
 * const contact = yield* GCP.EssentialContacts.FolderContact("Ops", {
 *   folderId: "folders/123",
 *   email: "ops@example.com",
 *   languageTag: "en-US",
 *   notificationCategorySubscriptions: ["TECHNICAL"],
 * });
 * ```
 *
 * **Example:** Subscribe to every category
 * ```typescript
 * const contact = yield* GCP.EssentialContacts.FolderContact("Ops", {
 *   folderId: "123",
 *   email: "ops@example.com",
 *   notificationCategorySubscriptions: ["ALL"],
 * });
 * ```
 *
 * ### Updating a Folder Contact
 * **Example:** Change language and categories
 * ```typescript
 * const contact = yield* GCP.EssentialContacts.FolderContact("Ops", {
 *   folderId: "folders/123",
 *   email: "ops@example.com",
 *   languageTag: "en-GB",
 *   notificationCategorySubscriptions: ["SECURITY", "TECHNICAL"],
 * });
 * ```
 *
 * @resource
 * @category EssentialContacts
 */
export const FolderContact = Resource<FolderContact>("GCP.EssentialContacts.FolderContact")

// @vibelang-diagnostics-next-line EK4830:off
export class FolderContactNotResolved extends Data.TaggedError(
  "GCP.EssentialContacts.FolderContactNotResolved",
)<{
  resourceName: string
}> {}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : essentialcontacts
  .getFoldersContacts({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string) => (parent.length === 0 ? [] : try listContacts(
  essentialcontacts.listFoldersContacts.pages({
    parent,
    pageSize: 200,
  }),
))

const toAttrs = (
  contact: essentialcontacts.GoogleCloudEssentialcontactsV1Contact,
  parent: string,
  project: string,
): infer _ => {
  const core = toCoreAttrs(contact, parent, project)
  return {
    ...core,
    folderId: lastSegment(core.parent),
  }
}

export const FolderContactProvider = (): infer _ =>
  Provider.succeed(FolderContact, {
    stables: ["name", "contactId", "parent", "folderId", "project", "email"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousEmail = olds?.email ?? output?.email
      if (
        try Effect.orDie(Effect.try({
          try: () =>
            resolved.email !== undefined
            && previousEmail !== undefined
            && normalizeEmail(resolved.email) !== normalizeEmail(previousEmail),
          catch: (e) => e,
        }))
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousFolder = olds?.folderId ?? output?.folderId
      if (
        try Effect.orDie(Effect.try({
          try: () =>
            resolved.folderId !== undefined
            && previousFolder !== undefined
            && folderParent(resolved.folderId) !== folderParent(previousFolder),
          catch: (e) => e,
        }))
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const parent = try resolveFolder(olds?.folderId ?? output?.folderId, output?.parent)
      let existing = try getByName(output?.name ?? "")
      if (existing === undefined) {
        existing = try findOwnedContact(
          try listAt(parent),
          id,
          output?.name,
          olds?.email ?? output?.email,
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, parent, env.project)
      return (try ownedByAlchemy(id, existing.email))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const parents = try listFolderParents()
      const pages = try Effect.forEach(parents, listAt, {
        concurrency: 4,
      })
      return pages.flatMap((contacts, index) =>
        contacts
          .filter((contact) => hasOwnershipMarker(contact.email))
          .map((contact) => toAttrs(contact, parents[index] ?? "", env.project))
      )
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const parent = try resolveFolder(news.folderId ?? output?.folderId, output?.parent)
      const ownership = try ownershipLabels(id)
      const userEmail = try toEmail(id, news.email, output?.email)
      const stampedEmail = try Effect.orDie(
        Effect.try({ try: () => encodeEmail(ownership, userEmail), catch: (e) => e }),
      )
      const languageTag = try Effect.orDie(
        Effect.try({ try: () => desiredLanguage(news.languageTag), catch: (e) => e }),
      )
      const categories = try Effect.orDie(
        Effect.try({ try: () => desiredCategories(news.notificationCategorySubscriptions), catch: (e) => e }),
      )
      const body = try Effect.orDie(Effect.try({
        try: () =>
          toCreateBody({
            email: stampedEmail,
            languageTag,
            notificationCategorySubscriptions: categories,
          }),
        catch: (e) => e,
      }))

      let current = try getByName(output?.name ?? "")
      if (current === undefined) {
        current = try findOwnedContact(try listAt(parent), id, output?.name, userEmail)
      }

      if (current === undefined) {
        const created = essentialcontacts
          .createFoldersContacts({ parent, body }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try findOwnedContact(try listAt(parent), id, undefined, userEmail);
            default: throw e;
          }
        current = created ?? undefined
        if (current?.name) {
          current = (try getByName(current.name)) ?? current
        }
      }

      if (current === undefined) {
        throw new FolderContactNotResolved({
          resourceName: output?.name ?? `${parent}/contacts`,
        })
      }

      const languageChanged = !sameText(current.languageTag, languageTag)
      const categoriesChanged = !sameCategories(
        current.notificationCategorySubscriptions,
        categories,
      )
      if (languageChanged || categoriesChanged) {
        current = try essentialcontacts.patchFoldersContacts({
          name: current.name ?? "",
          updateMask: UPDATE_MASK,
          body: {
            languageTag,
            notificationCategorySubscriptions: categories,
          },
        })
      }

      return toAttrs(current, parent, env.project)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      essentialcontacts
        .deleteFoldersContacts({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: try Effect.void;
          default: throw e;
        }
    },
  })
