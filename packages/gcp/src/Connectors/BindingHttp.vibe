import { Credentials } from "@distilled.cloud/gcp/Credentials"
import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import * as GCPBindings from "../GCPBindings.vibe"
import { type BindingIam, grantFor } from "../HttpBinding.vibe"
import type { ConnectionsEntityTypesEntity } from "./ConnectionsEntityTypesEntity.vibe"

type GcpHttpOp<I, A, E> =
  & (((input: I) => A!E)!!(Credentials | HttpClient.HttpClient))
  & ((input: I) => A!E!(Credentials | HttpClient.HttpClient))

/**
 * Shared HTTP scaffolding for Integration Connectors entity bindings.
 * NOT exported from index.ts.
 */
export const makeEntityHttpBinding = effect <I extends { name: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (entity: ConnectionsEntityTypesEntity) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${entity})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, entity.name), catch: (e) => e }))],
      })
    }
    const name = try entity.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...request,
            name: try name,
          } as I)
        },
        `${options.tag}(${entity.LogicalId})`,
      )
  }
}
