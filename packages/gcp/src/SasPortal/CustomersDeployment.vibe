import * as sasportal from "@distilled.cloud/gcp/sasportal_v1alpha1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  encodeOwnershipLine,
  expandCustomer,
  findOwnedCustomerDeployment,
  getCustomerDeployment,
  hasOwnershipMarker,
  lastSegment,
  listCustomerDeployments,
  listCustomers,
  MAX_DISPLAY_NAME_LENGTH,
  ownedByAlchemy,
  ownershipLabels,
  parentOf,
  parseOwnership,
  replaceOnIdentity,
  retryDelete,
  sameStringList,
  sameText,
  scanOwnedCustomerDeployment,
  toDisplayName,
  updateMaskOf,
  waitUntilGone,
} from "./internal.ts"

export type CustomersDeploymentProps = {
  /**
   * Parent SAS customer, as `customers/{customer}` or the customer id.
   * Immutable — changing it replaces the deployment.
   */
  parent: string
  /**
   * Server-assigned deployment resource name
   * (`customers/{customer}/deployments/{deployment}`). Immutable —
   * changing it replaces the deployment.
   */
  name?: string
  /**
   * Display name. SAS Portal deployments have no labels field, so
   * Alchemy stamps ownership into a `[alchemy …]` prefix and strips it
   * from attributes.
   */
  displayName?: string
  /**
   * SAS user ids used by devices that belong to this deployment. Each
   * deployment should have one unique user id.
   */
  sasUserIds?: string[]
}

export type CustomersDeployment = Resource<
  "GCP.SasPortal.CustomersDeployment",
  CustomersDeploymentProps,
  {
    /** Resource name `customers/{customer}/deployments/{deployment}`. */
    name: string
    /** Deployment id (last path segment). */
    deploymentId: string
    /** Parent customer resource name. */
    parent: string
    /** Project id used when the deployment was reconciled. */
    project: string
    /** User-facing display name with the Alchemy prefix stripped. */
    displayName: string | undefined
    /** SAS user ids on the deployment. */
    sasUserIds: string[] | undefined
    /** FCC Registration Numbers inherited from the parent. */
    frns: string[] | undefined
  },
  never,
  Providers
>

/**
 * A Spectrum Access System (SAS) Portal deployment under a customer.
 *
 * SAS Portal deployments have no labels field, so Alchemy stamps
 * ownership into `displayName` for `list` / nuke. Parent customer is
 * identity. Display name and SAS user ids update in place. `frns` is
 * output-only.
 *
 * ### Creating a Deployment
 * **Example:** Generated display name
 * ```typescript
 * const deployment = yield* GCP.SasPortal.CustomersDeployment("Site", {
 *   parent: "customers/123",
 * });
 * ```
 *
 * **Example:** Explicit name and SAS user id
 * ```typescript
 * const deployment = yield* GCP.SasPortal.CustomersDeployment("Site", {
 *   parent: "customers/123",
 *   displayName: "downtown",
 *   sasUserIds: ["operator-1"],
 * });
 * ```
 *
 * ### Updating a Deployment
 * Change props on the same logical id; the engine keeps the physical id.
 *
 * **Example:** Rename
 * ```typescript
 * const deployment = yield* GCP.SasPortal.CustomersDeployment("Site", {
 *   parent: "customers/123",
 *   displayName: "downtown-west",
 *   sasUserIds: ["operator-1"],
 * });
 * ```
 *
 * @resource
 * @category SasPortal
 */
export const CustomersDeployment = Resource<CustomersDeployment>(
  "GCP.SasPortal.CustomersDeployment",
)

// @vibelang-diagnostics-next-line EK4830:off
export class CustomersDeploymentNotResolved extends Data.TaggedError(
  "GCP.SasPortal.CustomersDeploymentNotResolved",
)<{
  parent: string
  resourceName: string
}> {}

const toAttrs = (deployment: sasportal.SasPortalDeployment, parent: string, project: string): infer _ => {
  const name = deployment.name ?? ""
  return {
    name,
    deploymentId: lastSegment(name),
    parent: parentOf(name) || parent,
    project,
    displayName: parseOwnership(deployment.displayName).text,
    sasUserIds: deployment.sasUserIds,
    frns: deployment.frns,
  }
}

export const CustomersDeploymentProvider = (): infer _ =>
  Provider.succeed(CustomersDeployment, {
    stables: ["name", "deploymentId", "parent", "project"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousParent: olds?.parent ?? output?.parent,
            nextParent: expandCustomer(resolved.parent),
            previousId: olds?.name ?? output?.name,
            nextId: resolved.name,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const parent = try Effect.orDie(
        Effect.try({ try: () => expandCustomer(olds?.parent ?? output?.parent ?? ""), catch: (e) => e }),
      )
      const name = olds?.name ?? output?.name ?? ""
      let existing = try getCustomerDeployment(name)
      let locatedParent = existing ? parentOf(existing.name ?? "") || parent : parent
      if (existing === undefined) {
        const found = (try findOwnedCustomerDeployment(id, parent))
          ?? (try scanOwnedCustomerDeployment(id))
        existing = found?.row
        locatedParent = found?.parent ?? locatedParent
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, locatedParent, env.project)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const customers = try listCustomers()
      const pages = try Effect.forEach(
        customers,
        effect (customer) => (customer.name
          ? (try listCustomerDeployments(customer.name))
            .filter((row) => hasOwnershipMarker(row.displayName))
            .map((row) => toAttrs(row, customer.name ?? "", env.project))
          : []),
        { concurrency: 4 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const parent = try Effect.orDie(Effect.try({ try: () => expandCustomer(news.parent), catch: (e) => e }))
      const ownership = try ownershipLabels(id)
      const text = try toDisplayName(id, news.displayName, output?.displayName)
      const displayName = try Effect.orDie(Effect.try({
        try: () =>
          encodeOwnershipLine(
            ownership,
            text,
            MAX_DISPLAY_NAME_LENGTH,
          ),
        catch: (e) => e,
      }))
      const desired: sasportal.SasPortalDeployment = {
        displayName,
        sasUserIds: news.sasUserIds,
      }

      let current = try getCustomerDeployment(news.name ?? output?.name ?? "")
      if (current === undefined) {
        const found = (try findOwnedCustomerDeployment(id, parent))
          ?? (try scanOwnedCustomerDeployment(id))
        current = found?.row
      }

      if (current === undefined) {
        const created = sasportal
          .createCustomersDeployments({
            parent,
            body: desired,
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: (try findOwnedCustomerDeployment(id, parent))?.row;
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new CustomersDeploymentNotResolved({
          parent,
          resourceName: news.name ?? output?.name ?? displayName,
        })
      }

      const name = current.name ?? news.name ?? output?.name ?? ""
      const nameChanged = !sameText(current.displayName, displayName)
      const usersChanged = news.sasUserIds !== undefined && !sameStringList(current.sasUserIds, news.sasUserIds)
      if (nameChanged || usersChanged) {
        current = try sasportal.patchCustomersDeployments({
          name,
          updateMask: try Effect.orDie(Effect.try({
            try: () =>
              updateMaskOf(
                "displayName",
                news.sasUserIds !== undefined ? "sasUserIds" : undefined,
              ),
            catch: (e) => e,
          })),
          body: desired,
        })
      }

      return toAttrs(current, parent, env.project)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      retryDelete(sasportal.deleteCustomersDeployments({ name: output.name })) catch effect (e) => match (e) {
        when { _tag: "NotFound" }: try Effect.void;
        default: throw e;
      }
      try waitUntilGone(getCustomerDeployment(output.name))
    },
  })
