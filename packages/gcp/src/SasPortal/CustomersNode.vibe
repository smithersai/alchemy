import * as sasportal from "@distilled.cloud/gcp/sasportal_v1alpha1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  encodeOwnershipLine,
  expandCustomer,
  findOwnedCustomerNode,
  getCustomerNode,
  hasOwnershipMarker,
  lastSegment,
  listCustomerNodes,
  listCustomers,
  MAX_DISPLAY_NAME_LENGTH,
  ownedByAlchemy,
  ownershipLabels,
  parentOf,
  parseOwnership,
  replaceOnIdentity,
  retryDelete,
  sameStringList,
  sameText,
  scanOwnedCustomerNode,
  toDisplayName,
  updateMaskOf,
  waitUntilGone,
} from "./internal.ts"

export type CustomersNodeProps = {
  /**
   * Parent SAS customer, as `customers/{customer}` or the customer id.
   * Immutable — changing it replaces the node.
   */
  parent: string
  /**
   * Server-assigned node resource name
   * (`customers/{customer}/nodes/{node}`). Immutable — changing it
   * replaces the node.
   */
  name?: string
  /**
   * Display name. SAS Portal nodes have no labels field, so Alchemy
   * stamps ownership into a `[alchemy …]` prefix and strips it from
   * attributes.
   */
  displayName?: string
  /**
   * SAS user ids used by devices that belong to this node.
   */
  sasUserIds?: string[]
}

export type CustomersNode = Resource<
  "GCP.SasPortal.CustomersNode",
  CustomersNodeProps,
  {
    /** Resource name `customers/{customer}/nodes/{node}`. */
    name: string
    /** Node id (last path segment). */
    nodeId: string
    /** Parent customer resource name. */
    parent: string
    /** Project id used when the node was reconciled. */
    project: string
    /** User-facing display name with the Alchemy prefix stripped. */
    displayName: string | undefined
    /** SAS user ids on the node. */
    sasUserIds: string[] | undefined
  },
  never,
  Providers
>

/**
 * A Spectrum Access System (SAS) Portal node under a customer.
 *
 * SAS Portal nodes have no labels field, so Alchemy stamps ownership
 * into `displayName` for `list` / nuke. Parent customer is identity.
 * Display name and SAS user ids update in place.
 *
 * ### Creating a Node
 * **Example:** Generated display name
 * ```typescript
 * const node = yield* GCP.SasPortal.CustomersNode("Region", {
 *   parent: "customers/123",
 * });
 * ```
 *
 * **Example:** Explicit name and SAS user ids
 * ```typescript
 * const node = yield* GCP.SasPortal.CustomersNode("Region", {
 *   parent: "customers/123",
 *   displayName: "west",
 *   sasUserIds: ["operator-1"],
 * });
 * ```
 *
 * ### Updating a Node
 * Change props on the same logical id; the engine keeps the physical id.
 *
 * **Example:** Rename
 * ```typescript
 * const node = yield* GCP.SasPortal.CustomersNode("Region", {
 *   parent: "customers/123",
 *   displayName: "west-2",
 * });
 * ```
 *
 * @resource
 * @category SasPortal
 */
export const CustomersNode = Resource<CustomersNode>("GCP.SasPortal.CustomersNode")

// @vibelang-diagnostics-next-line EK4830:off
export class CustomersNodeNotResolved extends Data.TaggedError(
  "GCP.SasPortal.CustomersNodeNotResolved",
)<{
  parent: string
  resourceName: string
}> {}

const toAttrs = (node: sasportal.SasPortalNode, parent: string, project: string): infer _ => {
  const name = node.name ?? ""
  return {
    name,
    nodeId: lastSegment(name),
    parent: parentOf(name) || parent,
    project,
    displayName: parseOwnership(node.displayName).text,
    sasUserIds: node.sasUserIds,
  }
}

export const CustomersNodeProvider = (): infer _ =>
  Provider.succeed(CustomersNode, {
    stables: ["name", "nodeId", "parent", "project"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousParent: olds?.parent ?? output?.parent,
            nextParent: expandCustomer(resolved.parent),
            previousId: olds?.name ?? output?.name,
            nextId: resolved.name,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const parent = try Effect.orDie(
        Effect.try({ try: () => expandCustomer(olds?.parent ?? output?.parent ?? ""), catch: (e) => e }),
      )
      const name = olds?.name ?? output?.name ?? ""
      let existing = try getCustomerNode(name)
      let locatedParent = existing ? parentOf(existing.name ?? "") || parent : parent
      if (existing === undefined) {
        const found = (try findOwnedCustomerNode(id, parent)) ?? (try scanOwnedCustomerNode(id))
        existing = found?.row
        locatedParent = found?.parent ?? locatedParent
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, locatedParent, env.project)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const customers = try listCustomers()
      const pages = try Effect.forEach(
        customers,
        effect (customer) => (customer.name
          ? (try listCustomerNodes(customer.name))
            .filter((row) => hasOwnershipMarker(row.displayName))
            .map((row) => toAttrs(row, customer.name ?? "", env.project))
          : []),
        { concurrency: 4 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const parent = try Effect.orDie(Effect.try({ try: () => expandCustomer(news.parent), catch: (e) => e }))
      const ownership = try ownershipLabels(id)
      const text = try toDisplayName(id, news.displayName, output?.displayName)
      const displayName = try Effect.orDie(Effect.try({
        try: () =>
          encodeOwnershipLine(
            ownership,
            text,
            MAX_DISPLAY_NAME_LENGTH,
          ),
        catch: (e) => e,
      }))
      const desired: sasportal.SasPortalNode = {
        displayName,
        sasUserIds: news.sasUserIds,
      }

      let current = try getCustomerNode(news.name ?? output?.name ?? "")
      if (current === undefined) {
        const found = (try findOwnedCustomerNode(id, parent)) ?? (try scanOwnedCustomerNode(id))
        current = found?.row
      }

      if (current === undefined) {
        const created = sasportal
          .createCustomersNodes({
            parent,
            body: desired,
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: (try findOwnedCustomerNode(id, parent))?.row;
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new CustomersNodeNotResolved({
          parent,
          resourceName: news.name ?? output?.name ?? displayName,
        })
      }

      const name = current.name ?? news.name ?? output?.name ?? ""
      const nameChanged = !sameText(current.displayName, displayName)
      const usersChanged = news.sasUserIds !== undefined && !sameStringList(current.sasUserIds, news.sasUserIds)
      if (nameChanged || usersChanged) {
        current = try sasportal.patchCustomersNodes({
          name,
          updateMask: try Effect.orDie(Effect.try({
            try: () =>
              updateMaskOf(
                "displayName",
                news.sasUserIds !== undefined ? "sasUserIds" : undefined,
              ),
            catch: (e) => e,
          })),
          body: desired,
        })
      }

      return toAttrs(current, parent, env.project)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      retryDelete(sasportal.deleteCustomersNodes({ name: output.name })) catch effect (e) => match (e) {
        when { _tag: "NotFound" }: try Effect.void;
        default: throw e;
      }
      try waitUntilGone(getCustomerNode(output.name))
    },
  })
