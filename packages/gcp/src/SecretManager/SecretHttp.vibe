import * as secretmanager from "@distilled.cloud/gcp/secretmanager_v1"
import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.vibe"
import { grantFor, type BindingIam } from "../HttpBinding.vibe"
import type { SecretBindingTarget } from "./BindingHttp.vibe"
import type { ReadSecretClient } from "./ReadSecret.vibe"
import type { WriteSecretClient } from "./WriteSecret.vibe"
import { bufferFromBytes, bufferFromString } from "./SecretHttp.platform.js"

/**
 * Shared HTTP scaffolding for the Secret Manager Read/Write/ReadWrite
 * bindings. NOT exported from `index.ts`.
 */

export const readSecretGrants: BindingIam[] = [
  { role: "roles/secretmanager.secretAccessor", on: "secretmanager.secret" },
]

export const writeSecretGrants: BindingIam[] = [
  {
    role: "roles/secretmanager.secretVersionManager",
    on: "secretmanager.secret",
  },
]

// No predefined role covers access + version management short of
// secretmanager.admin, so ReadWrite grants both narrow roles.
export const readWriteSecretGrants: BindingIam[] = [...readSecretGrants, ...writeSecretGrants]

const versionName = (secretName: string, version: string) =>
  version.includes("/versions/") ? version : `${secretName}/versions/${version}`

export const makeSecretHelpers = effect {
  const access = try GCPBindings.withCredentials(secretmanager.accessProjectsSecretsVersions)
  const addVersion = try GCPBindings.withCredentials(secretmanager.addVersionProjectsSecrets)
  const disable = try GCPBindings.withCredentials(secretmanager.disableProjectsSecretsVersions)
  const destroy = try GCPBindings.withCredentials(secretmanager.destroyProjectsSecretsVersions)

  const makeRead = (secretName: Effect.Effect<string>): ReadSecretClient => {
    const accessBytes = (version?: string) =>
      effect {
        const response = try access({
          name: versionName(try secretName, version ?? "latest"),
        })
        const data = response.payload?.data ?? ""
        return try Effect.sync(() => new Uint8Array(bufferFromString(data, "base64")))
      }.pipe(
        // Missing, disabled, and destroyed versions have no readable payload.
        Effect.catchTag(["NotFound", "SecretVersionNotEnabled"], () => Effect.undefined),
      )
    return {
      accessBytes,
      access: (version) =>
        effect {
          const bytes = try accessBytes(version)
          return bytes === undefined
            ? undefined
            : try Effect.orDie(Effect.try({ try: () => new TextDecoder().decode(bytes), catch: (e) => e }))
        },
    }
  }

  const makeWrite = (secretName: Effect.Effect<string>): WriteSecretClient => ({
    addVersion: (value) =>
      effect {
        const data = try Effect.sync(() =>
          (typeof value === "string"
            ? bufferFromString(value, "utf8")
            : bufferFromBytes(value)).toString("base64")
        )
        const version = try addVersion({
          parent: try secretName,
          body: { payload: { data } },
        })
        return version.name ?? ""
      },
    disableVersion: (version) =>
      effect {
        try disable({ name: versionName(try secretName, version) })
      },
    destroyVersion: (version) =>
      effect {
        try destroy({ name: versionName(try secretName, version) })
      }.pipe(Effect.catchTag("NotFound", () => Effect.void)),
  })

  return { makeRead, makeWrite }
}

/** Build a secret binding that grants `grants` and returns `makeClient`'s client. */
export const makeSecretAccessBinding = <Client>(options: {
  tag: string
  grants: BindingIam[]
  makeClient: (
    helpers: Effect.Success<typeof makeSecretHelpers>,
    secretName: Effect.Effect<string>,
  ) => Client
}) =>
  effect {
    const bind = try GCPBindings.Bind
    const helpers = try makeSecretHelpers
    return effect (secret: SecretBindingTarget) => {
      // `name` is `projects/p/secrets/s` or, for regional secrets,
      // `projects/p/locations/l/secrets/s`; both are secret IAM targets.
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`${options.tag}(${secret})`({
          iam: options.grants.map((grant) => grantFor(grant, secret.name)),
        })
      }
      const secretName = try secret.name.asEffect()
      return options.makeClient(helpers, secretName)
    }
  }
