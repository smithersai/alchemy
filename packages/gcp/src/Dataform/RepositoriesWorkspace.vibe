import * as dataform from "@distilled.cloud/gcp/dataform_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  expandRepository,
  forEachOwnedRepository,
  hasAlchemyLabelMap,
  listWorkspaces,
  normalizeLocation,
  parseResourceName,
  replaceOnIdentity,
  retryTransient,
  toPhysicalId,
  waitUntilExists,
  waitUntilGone,
} from "./internal.ts"

export type RepositoriesWorkspaceProps = {
  /**
   * Parent repository. Full name
   * `projects/{project}/locations/{location}/repositories/{repository}`
   * or the repository id (combined with `location`). Immutable —
   * changing it replaces the workspace.
   */
  repository: string
  /**
   * Region used when `repository` is a bare id.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Workspace id (the `{workspace}` segment). If omitted, a unique
   * RFC1035 name is generated. Immutable — changing it replaces the
   * workspace. Workspaces have no labels field; ownership is the
   * generated physical id and the parent repository's Alchemy labels.
   */
  workspaceId?: string
  /**
   * When true, the workspace is deleted instead of moved if its
   * repository is moved. Immutable after create.
   * @default false
   */
  disableMoves?: boolean
}

export type RepositoriesWorkspace = Resource<
  "GCP.Dataform.RepositoriesWorkspace",
  RepositoriesWorkspaceProps,
  {
    /** Full resource name `.../repositories/{repository}/workspaces/{workspace}`. */
    name: string
    /** Workspace id (last path segment). */
    workspaceId: string
    /** Parent repository resource name. */
    repository: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** Whether the workspace is deleted on repository move. */
    disableMoves: boolean
    /** Whether the workspace is user-scoped. */
    userScoped: boolean | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Dataform Git workspace inside a repository.
 *
 * Workspaces have no update API. Changing `workspaceId`, `repository`,
 * `location`, or `disableMoves` replaces the workspace. Ownership for
 * `list` / nuke is the parent repository's Alchemy labels.
 *
 * ### Creating a Workspace
 * **Example:** Generated name
 * ```typescript
 * const workspace = yield* GCP.Dataform.RepositoriesWorkspace("Dev", {
 *   repository: repo.name,
 * });
 * ```
 *
 * **Example:** Named workspace
 * ```typescript
 * const workspace = yield* GCP.Dataform.RepositoriesWorkspace("Dev", {
 *   repository: repo.name,
 *   workspaceId: "dev",
 * });
 * ```
 *
 * @resource
 * @category Dataform
 */
export const RepositoriesWorkspace = Resource<RepositoriesWorkspace>(
  "GCP.Dataform.RepositoriesWorkspace",
)

// @vibelang-diagnostics-next-line EK4830:off
export class RepositoriesWorkspaceNotResolved extends Data.TaggedError(
  "GCP.Dataform.RepositoriesWorkspaceNotResolved",
)<{
  resourceName: string
}> {}

const resourceName = (repository: string, workspaceId: string): infer _ => `${repository}/workspaces/${workspaceId}`

const toAttrs = (workspace: dataform.Workspace, project: string, region: string): infer _ => {
  const name = workspace.name ?? ""
  const parsed = parseResourceName(name, "workspaces", region)
  return {
    name,
    workspaceId: parsed.id,
    repository: parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    disableMoves: workspace.disableMoves === true,
    userScoped: workspace.privateResourceMetadata?.userScoped,
    createTime: workspace.createTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 || name.includes("//") ? try Effect.undefined : dataform
  .getProjectsLocationsRepositoriesWorkspaces({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const RepositoriesWorkspaceProvider = (): infer _ =>
  Provider.succeed(RepositoriesWorkspace, {
    stables: ["name", "workspaceId", "repository", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            resolved.location ?? olds?.location ?? output?.location,
            env.region,
          ),
        catch: (e) => e,
      }))
      const previousRepo = olds?.repository ?? output?.repository
      const nextRepo = try Effect.orDie(
        Effect.try({ try: () => expandRepository(resolved.repository, env.project, location), catch: (e) => e }),
      )
      const previousMoves = olds?.disableMoves ?? output?.disableMoves
      const input = {
        previousId: olds?.workspaceId ?? output?.workspaceId,
        nextId: resolved.workspaceId ?? olds?.workspaceId ?? output?.workspaceId,
        previousLocation: olds?.location ?? output?.location,
        nextLocation: resolved.location ?? olds?.location ?? output?.location,
        previousParent: previousRepo,
        nextParent: nextRepo,
        extra: previousMoves !== undefined
          && resolved.disableMoves !== undefined
          && resolved.disableMoves !== previousMoves,
      }
      return try Effect.orDie(Effect.try({ try: () => replaceOnIdentity(input), catch: (e) => e }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const repository = try Effect.orDie(Effect.try({
        try: () =>
          expandRepository(
            olds?.repository
              ?? output?.repository
              ?? parseResourceName(output?.name ?? "", "workspaces", env.region).parent,
            env.project,
            location,
          ),
        catch: (e) => e,
      }))
      const workspaceId = try toPhysicalId(id, olds?.workspaceId, output?.workspaceId)
      const name = output?.name ?? resourceName(repository, workspaceId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      const parent = dataform
        .getProjectsLocationsRepositories({ name: attrs.repository }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: try Effect.undefined;
          default: throw e;
        }
      if (parent === undefined) return try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
      return (try Effect.orDie(Effect.try({ try: () => hasAlchemyLabelMap(parent.labels), catch: (e) => e })))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const workspaces = try forEachOwnedRepository(
        env.project,
        env.region,
        effect (repo) => try listWorkspaces(repo.name ?? ""),
      )
      return workspaces.map((item) => toAttrs(item, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const repository = try Effect.orDie(
        Effect.try({ try: () => expandRepository(news.repository, env.project, location), catch: (e) => e }),
      )
      const workspaceId = try toPhysicalId(id, news.workspaceId, output?.workspaceId)
      const name = resourceName(repository, workspaceId)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = retryTransient(
          dataform.createProjectsLocationsRepositoriesWorkspaces({
            parent: repository,
            workspaceId,
            body: {
              disableMoves: news.disableMoves === true ? true : undefined,
            },
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
        if (current === undefined) {
          current = try waitUntilExists(getByName(name), name)
        }
      }

      if (current === undefined) {
        throw new RepositoriesWorkspaceNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      retryTransient(
        dataform.deleteProjectsLocationsRepositoriesWorkspaces({
          name: output.name,
        }),
      ) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      try waitUntilGone(getByName(output.name))
    },
  })
