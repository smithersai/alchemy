import * as Output from "alchemy/Output"
import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Instance } from "./Instance.vibe"

/**
 * Shared HTTP scaffolding for Compute Engine instance bindings.
 * NOT exported from index.ts.
 */
export const makeInstanceHttpBinding = effect <
  I extends { mutable instance?: string; mutable zone?: string; mutable project?: string },
  A,
  E,
>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (instance: Instance) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${instance})`({
        iam: [
          grantFor(
            options.iam,
            Output.interpolate`projects/${instance.project}/zones/${instance.zone}/instances/${instance.instanceName}`,
          ),
        ],
      })
    }
    const instanceName = try instance.instanceName.asEffect()
    const zone = try instance.zone.asEffect()
    const project = try instance.project.asEffect()
    return effect (
      request?: Omit<I, "instance" | "zone" | "project"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            instance: try instanceName,
            zone: try zone,
            project: try project,
          } as I)
        },
        `${options.tag}(${instance.LogicalId})`,
      )
  }
}
