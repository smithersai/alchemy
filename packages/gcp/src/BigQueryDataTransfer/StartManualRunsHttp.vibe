import * as bqdt from "@distilled.cloud/gcp/bigquerydatatransfer_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { StartManualRuns, type StartManualRunsRequest } from "./StartManualRuns.vibe"
import type { TransferConfig } from "./TransferConfig.vibe"

/**
 * HTTP implementation of {@link StartManualRuns}.
 *
 * @layer
 * @provides GCP.BigQueryDataTransfer.StartManualRuns
 */
export const StartManualRunsHttp = Layer.effect(
  StartManualRuns,
  effect {
    const bind = try GCPBindings.Bind
    const startManualRunsProjectsLocationsTransferConfigs = try GCPBindings.withCredentials(
      bqdt.startManualRunsProjectsLocationsTransferConfigs,
    )
    return effect (config: TransferConfig) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.BigQueryDataTransfer.StartManualRuns(${config})`({
          // bigquery.transfers.update is in no narrower predefined role, and
          // transfer configs have no resource-level IAM, so this is a project
          // grant (see StartManualRuns JSDoc).
          iam: [{ role: "roles/bigquery.admin" }],
        })
      }
      const name = try config.name.asEffect()
      return effect (
        request?: StartManualRunsRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try startManualRunsProjectsLocationsTransferConfigs({
              ...request,
              parent: try name,
            })
          },
          `GCP.BigQueryDataTransfer.StartManualRuns(${config.LogicalId})`,
        )
    }
  },
)
