import * as apphub from "@distilled.cloud/gcp/apphub_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  GLOBAL_LOCATION,
  locationParent,
  parseName,
  projectIdOf,
  projectNameOf,
  replaceOnIdentity,
  ResourceNotResolved,
  waitForOperation,
  waitUntilExists,
  waitUntilGone,
  waitUntilReady,
} from "./internal.ts"

export type ServiceProjectAttachmentProps = {
  /**
   * Service project to attach, as `projects/{project}` or a bare project
   * id. Immutable — changing it replaces the attachment. The attachment
   * id must equal this project's id. Defaults to the stack project.
   */
  serviceProject?: string
  /**
   * Attachment id. Must equal the project id of `serviceProject`. If
   * omitted, that project id is used. Immutable — changing it replaces
   * the attachment.
   */
  serviceProjectAttachmentId?: string
  /**
   * Location of the host project. App Hub only supports `global`.
   * @default "global"
   */
  location?: string
}

export type ServiceProjectAttachment = Resource<
  "GCP.AppHub.ServiceProjectAttachment",
  ServiceProjectAttachmentProps,
  {
    /** Full resource name. */
    name: string
    /** Attachment id (last path segment, equal to the service project id). */
    serviceProjectAttachmentId: string
    /** Host project id. */
    project: string
    /** Location id (`global`). */
    location: string
    /** Service project resource name (`projects/{number}` on output). */
    serviceProject: string | undefined
    /** Server-reported state. */
    state: string | undefined
    /** Server-generated resource uid. */
    uid: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
  },
  never,
  Providers
>

/**
 * An App Hub service project attachment. Service projects hold the
 * underlying cloud resources and expose them to a host project so App
 * Hub can provide an aggregated view.
 *
 * Attachments have no labels, description, or display name, and the id
 * is forced to the service project id, so `list` cannot stamp ownership.
 * Location is always `global`. The resource is existence-only: service
 * project is identity, and there is nothing mutable to sync.
 *
 * ### Creating a Service Project Attachment
 * **Example:** Attach the stack project
 * ```typescript
 * const attachment = yield* GCP.AppHub.ServiceProjectAttachment(
 *   "Host",
 *   {},
 * );
 * ```
 *
 * **Example:** Attach a specific service project
 * ```typescript
 * const attachment = yield* GCP.AppHub.ServiceProjectAttachment(
 *   "Payments",
 *   { serviceProject: "projects/my-service" },
 * );
 * ```
 *
 * @resource
 * @category AppHub
 */
export const ServiceProjectAttachment = Resource<ServiceProjectAttachment>(
  "GCP.AppHub.ServiceProjectAttachment",
)

const resourceName = (project: string, location: string, attachmentId: string): infer _ =>
  `${locationParent(project, location)}/serviceProjectAttachments/${attachmentId}`

const toAttrs = (item: apphub.ServiceProjectAttachment, project: string): infer _ => {
  const name = item.name ?? ""
  const parsed = parseName(name, "serviceProjectAttachments", GLOBAL_LOCATION)
  return {
    name,
    serviceProjectAttachmentId: parsed.id,
    project: parsed.project || project,
    location: parsed.location || GLOBAL_LOCATION,
    serviceProject: item.serviceProject,
    state: item.state,
    uid: item.uid,
    createTime: item.createTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : apphub
  .getProjectsLocationsServiceProjectAttachments({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const ServiceProjectAttachmentProvider = (): infer _ =>
  Provider.succeed(ServiceProjectAttachment, {
    stables: [
      "name",
      "serviceProjectAttachmentId",
      "project",
      "location",
      "serviceProject",
      "uid",
      "createTime",
    ],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousProject = try Effect.orDie(
        Effect.try({ try: () => projectIdOf(olds?.serviceProject ?? output?.serviceProject, ""), catch: (e) => e }),
      )
      const nextProject = try Effect.orDie(Effect.try({
        try: () =>
          projectIdOf(
            resolved.serviceProject ?? olds?.serviceProject ?? output?.serviceProject,
            previousProject,
          ),
        catch: (e) => e,
      }))
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.serviceProjectAttachmentId ?? output?.serviceProjectAttachmentId,
            nextId: resolved.serviceProjectAttachmentId
              ?? olds?.serviceProjectAttachmentId
              ?? output?.serviceProjectAttachmentId,
            previousLocation: GLOBAL_LOCATION,
            nextLocation: GLOBAL_LOCATION,
            extra: previousProject.length > 0 && nextProject.length > 0 && previousProject !== nextProject,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ olds, output }) => {
      const env = try GcpEnvironment.current
      const serviceProjectId = try Effect.orDie(Effect.try({
        try: () =>
          projectIdOf(
            olds?.serviceProject ?? output?.serviceProject,
            env.project,
          ),
        catch: (e) => e,
      }))
      const attachmentId = olds?.serviceProjectAttachmentId ?? output?.serviceProjectAttachmentId ?? serviceProjectId
      const name = output?.name ?? resourceName(env.project, GLOBAL_LOCATION, attachmentId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return attrs.serviceProjectAttachmentId === attachmentId
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      return (effect {
        return (Array.from(
          try (apphub.listProjectsLocationsServiceProjectAttachments
            .pages({
              parent: try Effect.orDie(
                Effect.try({ try: () => locationParent(env.project, GLOBAL_LOCATION), catch: (e) => e }),
              ),
              pageSize: 1000,
            })
            |> Stream.flatMap(%, (page) => Stream.fromIterable(page.serviceProjectAttachments ?? []))
            |> Stream.filter(%, (item) =>
              projectIdOf(item.serviceProject, "") === env.project
              || parseName(item.name ?? "", "serviceProjectAttachments", GLOBAL_LOCATION).id
                === env.project)
            |> Stream.map(%, (item) => toAttrs(item, env.project))
            |> Stream.runCollect(%)),
        ))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }
    },

    reconcile: effect ({ news, output }) => {
      const env = try GcpEnvironment.current
      const serviceProject = try Effect.orDie(
        Effect.try({ try: () => projectNameOf(news.serviceProject, env.project), catch: (e) => e }),
      )
      const attachmentId = news.serviceProjectAttachmentId
        ?? output?.serviceProjectAttachmentId
        ?? (try Effect.orDie(Effect.try({ try: () => projectIdOf(serviceProject, env.project), catch: (e) => e })))
      const name = resourceName(env.project, GLOBAL_LOCATION, attachmentId)
      const parent = try Effect.orDie(
        Effect.try({ try: () => locationParent(env.project, GLOBAL_LOCATION), catch: (e) => e }),
      )

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = apphub
          .createProjectsLocationsServiceProjectAttachments({
            parent,
            serviceProjectAttachmentId: attachmentId,
            body: {
              serviceProject,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try waitUntilExists(getByName(name), name)
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      current = try waitUntilReady(
        getByName(current.name ?? name),
        current.name ?? name,
        (item) => item.state,
      )

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const operation = (effect {
        return (try (apphub
          .deleteProjectsLocationsServiceProjectAttachments({
            name: output.name,
          })
          |> Effect.retry(%, {
            while: (error) => error._tag === "Conflict",
            times: 8,
            schedule: Schedule.spaced("2 seconds"),
          })))
      }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
      try waitUntilGone(getByName(output.name), output.name)
    },
  })
