import * as storage from "@distilled.cloud/gcp/storage_v1"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { DeleteNotConfirmed } from "../Errors.vibe"
import type { Providers } from "../Providers.vibe"
import { listAlchemyBuckets, toFolderName, withTrailingSlash } from "./internal.vibe"

export type ManagedProps = {
  /**
   * Name of the uniform-access bucket that contains this managed folder.
   * Immutable — changing it replaces the folder.
   */
  bucketName: string
  /**
   * Managed folder path. A trailing slash is added if omitted. If
   * omitted entirely, a unique name is generated from the stack, stage,
   * and logical id. Immutable — changing it replaces the folder.
   */
  managedFolderName?: string
}

export type Managed = Resource<
  "GCP.Storage.Managed",
  ManagedProps,
  {
    /** Parent bucket name. */
    bucketName: string
    /** Managed folder path, including the trailing slash. */
    managedFolderName: string
    /** Server-assigned id (`{bucket}/{folder}`). */
    id: string | undefined
    /** Metadata generation. */
    metageneration: string | undefined
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
    /** GCS self-link. */
    selfLink: string | undefined
  },
  never,
  Providers
>

/**
 * A Cloud Storage managed folder.
 *
 * Managed folders provide IAM on an object-name prefix in a bucket with
 * uniform bucket-level access. Identity is `(bucket, folder name)`.
 * Managed folders have no mutable fields and no labels, so `list` /
 * `pnpm nuke:gcp` discover them by enumerating alchemy-labeled buckets.
 *
 * ### Creating a Managed Folder
 * **Example:** Generated name
 * ```typescript
 * const bucket = yield* GCP.Storage.Bucket("assets", {
 *   uniformBucketLevelAccess: true,
 *   forceDestroy: true,
 * });
 * const folder = yield* GCP.Storage.Managed("team", {
 *   bucketName: bucket.bucketName,
 * });
 * ```
 *
 * **Example:** Explicit path
 * ```typescript
 * const folder = yield* GCP.Storage.Managed("team", {
 *   bucketName: bucket.bucketName,
 *   managedFolderName: "teams/payments/",
 * });
 * ```
 *
 * @resource
 * @category Storage
 */
export const Managed = Resource<Managed>("GCP.Storage.Managed")

// @vibelang-diagnostics-next-line EK4830:off
export class ManagedNotResolved extends Data.TaggedError("GCP.Storage.ManagedNotResolved")<{
  bucketName: string
  managedFolderName: string
}> {}

const toAttrs = (folder: storage.ManagedFolder, bucketName: string): infer _ => ({
  bucketName: folder.bucket ?? bucketName,
  managedFolderName: withTrailingSlash(folder.name ?? ""),
  id: folder.id,
  metageneration: folder.metageneration,
  createTime: folder.createTime,
  updateTime: folder.updateTime,
  selfLink: folder.selfLink,
})

const getByName = effect (bucketName: string, managedFolderName: string) =>
  storage
    .getManagedFolders({
      bucket: bucketName,
      managedFolder: managedFolderName,
    }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined; default: throw e; }

const listOnBucket = effect (bucketName: string) =>
  (effect {
    return (Array.from(
      try (storage.listManagedFolders.items({ bucket: bucketName, pageSize: 1000 })
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as storage.ManagedFolder[]; default: throw e; }

const waitUntilGone = effect (bucketName: string, managedFolderName: string) =>
  try ((try (effect {
      return ((try getByName(bucketName, managedFolderName)) === undefined ? ("gone" as const) : ("found" as const))
    }
      |> Effect.repeat(%, {
        schedule: Schedule.spaced("1 second"),
        until: (status) => status === "gone",
        times: 30,
      }))) === "gone"
    ? Effect.void
    : throw new DeleteNotConfirmed({
      resource: `${bucketName}/managedFolders/${managedFolderName}`,
    }))

export const ManagedProvider = (): infer _ =>
  Provider.succeed(Managed, {
    stables: ["bucketName", "managedFolderName", "id", "selfLink", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousBucket = olds?.bucketName ?? output?.bucketName
      if (previousBucket !== undefined && resolved.bucketName !== previousBucket) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousName = olds?.managedFolderName ?? output?.managedFolderName
      if (
        resolved.managedFolderName !== undefined
        && previousName !== undefined
        && withTrailingSlash(resolved.managedFolderName) !== withTrailingSlash(previousName)
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const bucketName = olds?.bucketName ?? output?.bucketName
      if (!bucketName) return undefined
      const managedFolderName = try toFolderName(
        id,
        olds?.managedFolderName,
        output?.managedFolderName,
      )
      const existing = try getByName(bucketName, managedFolderName)
      if (existing === undefined) return undefined
      return toAttrs(existing, bucketName)
    },

    list: effect () => {
      const buckets = try listAlchemyBuckets()
      const pages = try Effect.forEach(
        buckets,
        effect (bucket) => {
          const bucketName = bucket.name
          if (
            !bucketName
            || bucket.iamConfiguration?.uniformBucketLevelAccess?.enabled !== true
          ) {
            return [] as Array<Managed["Attributes"]>
          }
          return (try listOnBucket(bucketName)).map((item) => toAttrs(item, bucketName))
        },
        { concurrency: 8 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const bucketName = news.bucketName
      const managedFolderName = try toFolderName(
        id,
        news.managedFolderName,
        output?.managedFolderName,
      )

      let current = try getByName(bucketName, managedFolderName)

      if (current === undefined) {
        const created = storage
          .insertManagedFolders({
            bucket: bucketName,
            body: { name: managedFolderName },
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try getByName(bucketName, managedFolderName);
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined || !(current.name ?? current.id)) {
        throw new ManagedNotResolved({
          bucketName,
          managedFolderName,
        })
      }

      return toAttrs(current, bucketName)
    },

    delete: effect ({ output }) => {
      const bucketName = output.bucketName
      const managedFolderName = output.managedFolderName
      if (!bucketName || !managedFolderName) return
      storage
        .deleteManagedFolders({
          bucket: bucketName,
          managedFolder: managedFolderName,
          allowNonEmpty: true,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined as void; default: throw e; }
      try waitUntilGone(bucketName, managedFolderName)
    },
  })
