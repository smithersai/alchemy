import * as storage from "@distilled.cloud/gcp/storage_v1"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { DeleteNotConfirmed } from "../Errors.vibe"
import type { Providers } from "../Providers.ts"
import { isUserManagedAclEntity, listAlchemyBuckets, normalizeEntity, normalizeRole } from "./internal.vibe"

export type ObjectAccessControlProps = {
  /**
   * Name of the bucket that contains the object. Immutable — changing it
   * replaces the entry.
   */
  mutable bucketName: string
  /**
   * Object name this ACL entry is attached to. Immutable — changing it
   * replaces the entry.
   */
  mutable object: string
  /**
   * Principal granted the role. Forms include `user-{email}`,
   * `group-{email}`, `domain-{domain}`, `allUsers`, and
   * `allAuthenticatedUsers`. Immutable — changing it replaces the entry.
   */
  mutable entity: string
  /**
   * Access permission for the entity (`OWNER` or `READER`).
   */
  mutable role: string
  /**
   * Object generation. When omitted, the live generation is used.
   * Immutable — changing it replaces the entry.
   */
  mutable generation?: string
}

export type ObjectAccessControl = Resource<
  "GCP.Storage.ObjectAccessControl",
  ObjectAccessControlProps,
  {
    /** Parent bucket name. */
    mutable bucketName: string
    /** Object name. */
    mutable object: string
    /** Principal granted the role. */
    mutable entity: string
    /** Access permission (`OWNER` or `READER`). */
    mutable role: string
    /** Object generation, if the entry is generation-scoped. */
    mutable generation: string | undefined
    /** Server-assigned ACL id. */
    mutable id: string | undefined
    /** Domain associated with the entity, if any. */
    mutable domain: string | undefined
    /** Email associated with the entity, if any. */
    mutable email: string | undefined
    /** Numeric entity id, if any. */
    mutable entityId: string | undefined
    /** HTTP etag. */
    mutable etag: string | undefined
    /** GCS self-link. */
    mutable selfLink: string | undefined
  },
  never,
  Providers
>

/**
 * A Cloud Storage object ACL entry.
 *
 * Fine-grained object ACLs are identity `(bucket, object, entity)`. Role
 * is mutable; changing `bucketName`, `object`, or `entity` replaces the
 * entry. Entries have no labels field, so `list` / `pnpm nuke:gcp`
 * discover them by enumerating objects in alchemy-labeled buckets and
 * skipping project-team and numeric-owner defaults.
 *
 * Uniform bucket-level access buckets do not support object ACLs.
 *
 * ### Creating an Object ACL
 * **Example:** Grant a service account reader access
 * ```typescript
 * const bucket = yield* GCP.Storage.Bucket("assets", {
 *   forceDestroy: true,
 * });
 * const acl = yield* GCP.Storage.ObjectAccessControl("reader", {
 *   bucketName: bucket.bucketName,
 *   object: "hello.txt",
 *   entity: "user-app@project.iam.gserviceaccount.com",
 *   role: "READER",
 * });
 * ```
 *
 * **Example:** Update the role
 * ```typescript
 * const acl = yield* GCP.Storage.ObjectAccessControl("reader", {
 *   bucketName: bucket.bucketName,
 *   object: "hello.txt",
 *   entity: "user-app@project.iam.gserviceaccount.com",
 *   role: "OWNER",
 * });
 * ```
 *
 * @resource
 * @category Storage
 */
export const ObjectAccessControl = Resource<ObjectAccessControl>("GCP.Storage.ObjectAccessControl")

// @vibelang-diagnostics-next-line EK4830:off
export class ObjectAccessControlNotResolved extends Data.TaggedError(
  "GCP.Storage.ObjectAccessControlNotResolved",
)<{
  mutable bucketName: string
  mutable object: string
  mutable entity: string
}> {}

const toAttrs = (acl: storage.ObjectAccessControl, bucketName: string, object: string): infer _ => ({
  bucketName: acl.bucket ?? bucketName,
  object: acl.object ?? object,
  entity: acl.entity ?? "",
  role: acl.role ?? "",
  generation: acl.generation,
  id: acl.id,
  domain: acl.domain,
  email: acl.email,
  entityId: acl.entityId,
  etag: acl.etag,
  selfLink: acl.selfLink,
})

const getByEntity = effect (bucketName: string, object: string, entity: string, generation?: string) =>
  storage
    .getObjectAccessControls({
      bucket: bucketName,
      object,
      entity,
      generation,
    }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }

const listOnObject = effect (bucketName: string, object: string) =>
  ((try storage.listObjectAccessControls({ bucket: bucketName, object })).items ?? []) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: [] as storage.ObjectAccessControl[];
    default: throw e;
  }

const listObjectsOnBucket = effect (bucketName: string) =>
  (Array.from(
    try (storage.listObjects.items({ bucket: bucketName, maxResults: 1000 })
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) { when { _tag: "NotFound" }: [] as storage.Storage_Object[]; default: throw e; }

const waitUntilGone = effect (bucketName: string, object: string, entity: string, generation?: string) =>
  try ((try (effect {
      return ((try getByEntity(bucketName, object, entity, generation)) === undefined
        ? ("gone" as const)
        : ("found" as const))
    }
      |> Effect.repeat(%, {
        schedule: Schedule.spaced("1 second"),
        until: (status) => status === "gone",
        times: 30,
      }))) === "gone"
    ? Effect.void
    : throw new DeleteNotConfirmed({
      resource: `${bucketName}/o/${object}/acl/${entity}`,
    }))

export const ObjectAccessControlProvider = (): infer _ =>
  Provider.succeed(ObjectAccessControl, {
    stables: ["bucketName", "object", "entity", "generation", "id", "selfLink"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const previousBucket = olds?.bucketName ?? output?.bucketName
      const previousObject = olds?.object ?? output?.object
      const previousEntity = olds?.entity ?? output?.entity
      const previousGeneration = olds?.generation ?? output?.generation
      if (previousBucket !== undefined && news.bucketName !== previousBucket) {
        return { action: "replace" as const, deleteFirst: false }
      }
      if (previousObject !== undefined && news.object !== previousObject) {
        return { action: "replace" as const, deleteFirst: false }
      }
      if (
        previousEntity !== undefined
        && normalizeEntity(news.entity) !== normalizeEntity(previousEntity)
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      if (
        news.generation !== undefined
        && previousGeneration !== undefined
        && news.generation !== previousGeneration
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ olds, output }) => {
      const bucketName = olds?.bucketName ?? output?.bucketName
      const object = olds?.object ?? output?.object
      const entity = olds?.entity ?? output?.entity
      if (!bucketName || !object || !entity) return undefined
      const generation = olds?.generation ?? output?.generation
      const existing = try getByEntity(bucketName, object, entity, generation)
      if (existing === undefined) return undefined
      return toAttrs(existing, bucketName, object)
    },

    list: effect () => {
      const buckets = try listAlchemyBuckets()
      const pages = try Effect.forEach(
        buckets,
        effect (bucket) => {
          const bucketName = bucket.name
          // Legacy ACL APIs reject uniform bucket-level access buckets.
          if (
            !bucketName
            || bucket.iamConfiguration?.uniformBucketLevelAccess?.enabled === true
          ) {
            return [] as Array<ObjectAccessControl["Attributes"]>
          }
          return (try Effect.forEach(
            try listObjectsOnBucket(bucketName),
            effect (object) => {
              const objectName = object.name
              if (!objectName) {
                return [] as Array<ObjectAccessControl["Attributes"]>
              }
              return (try listOnObject(bucketName, objectName))
                .filter((item) => isUserManagedAclEntity(item.entity))
                .map((item) => toAttrs(item, bucketName, objectName))
            },
            { concurrency: 8 },
          )).flat()
        },
        { concurrency: 4 },
      )
      return pages.flat()
    },

    reconcile: effect ({ news, output }) => {
      const bucketName = news.bucketName
      const object = news.object
      const entity = normalizeEntity(news.entity)
      const role = normalizeRole(news.role)
      const generation = news.generation

      let current = output?.entity !== undefined && output.object !== undefined
        ? try getByEntity(
          output.bucketName ?? bucketName,
          output.object,
          normalizeEntity(output.entity),
          output.generation,
        )
        : undefined
      if (current === undefined) {
        current = try getByEntity(bucketName, object, entity, generation)
      }

      if (current === undefined) {
        const created = storage
          .insertObjectAccessControls({
            bucket: bucketName,
            object,
            generation,
            body: { entity, role },
          }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try getByEntity(bucketName, object, entity, generation);
            default: throw e;
          }
        current = created ?? undefined
      }

      if (current === undefined || !current.entity) {
        throw new ObjectAccessControlNotResolved({
          bucketName,
          object,
          entity,
        })
      }

      if (normalizeRole(current.role ?? "") !== role) {
        current = try storage.patchObjectAccessControls({
          bucket: bucketName,
          object,
          entity,
          generation,
          body: { entity, role },
        })
      }

      return toAttrs(current, bucketName, object)
    },

    delete: effect ({ output }) => {
      const bucketName = output.bucketName
      const object = output.object
      const entity = output.entity
      if (!bucketName || !object || !entity) return
      const removed = (try (storage
        .deleteObjectAccessControls({
          bucket: bucketName,
          object,
          entity,
          generation: output.generation,
        })
        |> Effect.as(%, true))) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: true;
          when { _tag: "ObjectOwnerAclRequired" }: false;
          default: throw e;
        }
      if (removed) {
        try waitUntilGone(bucketName, object, entity, output.generation)
      }
    },
  })
