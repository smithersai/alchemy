import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import type { Bucket } from "./Bucket.ts"
import { GrantOnBucket } from "./ObjectHttp.ts"
import { makeObjectMedia } from "./ObjectMedia.ts"
import { PutObject, type PutObjectRequest } from "./PutObject.ts"

/**
 * HTTP implementation of {@link PutObject}.
 *
 * @layer
 * @provides GCP.Storage.PutObject
 */
export const PutObjectHttp = Layer.effect(
  PutObject,
  effect {
    const grantOnBucket = try GrantOnBucket
    const media = try makeObjectMedia
    return effect (bucket: Bucket) => {
      try grantOnBucket("GCP.Storage.PutObject", bucket, "roles/storage.objectUser")
      const bucketName = try bucket.bucketName.asEffect()
      return effect (
        request: PutObjectRequest,
      ) =>
        try withSpan(
          effect {
            const name = try bucketName
            return try media.upload(name, request)
          },
          `GCP.Storage.PutObject(${bucket.LogicalId})`,
        )
    }
  },
)
