import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Connection } from "./Connection.ts"

/**
 * Shared HTTP scaffolding for BigQuery Connection bindings.
 * NOT exported from index.ts.
 */
export const makeConnectionHttpBinding = effect <I extends { mutable name?: string }, A, E>(options: {
  mutable tag: string
  mutable iam: BindingIam
  mutable operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (connection: Connection) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${connection})`({
        iam: [grantFor(options.iam, connection.name)],
      })
    }
    const name = try connection.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${connection.LogicalId})`,
      )
  }
}
