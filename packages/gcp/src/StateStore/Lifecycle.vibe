import * as storage from "@distilled.cloud/gcp/storage_v1"
import type { StateStoreImpl, StateStoreLifecycle } from "alchemy/Contributions"
import * as Provisioning from "alchemy/State/Provisioning"
import * as Effect from "effect/Effect"
import * as Schedule from "effect/Schedule"
import * as Stream from "effect/Stream"
import { GcpEnvironment } from "../Environment.vibe"
import { createStateBucketName, provisionStateBucket, state, stateBucketExists, stateEnvironment } from "./State.vibe"

/**
 * Ensure a state bucket (by default the project's) with the settings first
 * use would give it.
 */
const bootstrapStateBucket = effect (name?: string | undefined) =>
  try withSpan(
    effect {
      const { project, region } = try GcpEnvironment.current
      if (name !== undefined) try Provisioning.storeName(name)
      const bucketName = try Effect.orDie(
        Effect.try({ try: () => createStateBucketName(project, name), catch: (e) => e }),
      )
      const existed = try stateBucketExists(bucketName)
      try provisionStateBucket(bucketName, project, region)
      return { project, region, bucketName, existed }
    },
    "GCP.state.bootstrap",
  )

/**
 * Empty and delete a state bucket (by default the project's), every object
 * generation included. A missing bucket is not an error.
 */
const teardownStateBucket = effect (name?: string | undefined) =>
  try withSpan(
    effect {
      const { project } = try GcpEnvironment.current
      if (name !== undefined) try Provisioning.storeName(name)
      const bucketName = try Effect.orDie(
        Effect.try({ try: () => createStateBucketName(project, name), catch: (e) => e }),
      )
      if (!(try stateBucketExists(bucketName))) {
        return { bucketName, deleted: false }
      }
      try storage.listObjects.pages({ bucket: bucketName, versions: true }).pipe(
        Stream.flatMap((page) => Stream.fromIterable(page.items ?? [])),
        Stream.runForEach(effect (object) => (object.name === undefined ? (undefined as void) : storage
          .deleteObjects({
            bucket: bucketName,
            object: object.name,
            generation: object.generation,
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined as void; default: throw e; })
        ),
      )
      try (effect {
        return storage.deleteBuckets({ bucket: bucketName }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: undefined as void;
          default: throw e;
        }
      }
        |> Effect.retry(%, {
          while: (error) => error._tag === "Conflict",
          schedule: Schedule.max([Schedule.exponential("500 millis"), Schedule.recurs(6)]),
        }))
      return { bucketName, deleted: true }
    },
    "GCP.state.teardown",
  )

/** The GCP environment of the profile core runs the operation under. */
const environment = stateEnvironment()

/**
 * The Cloud Storage state store's lifecycle, for `alchemy state`. The store
 * also creates its bucket on first use, so bootstrapping is only needed to
 * provision it ahead of time (CI).
 */
export const lifecycle: StateStoreLifecycle = {
  bootstrap: effect ({ name }) =>
    try effect {
      provide environment {
        return try effect {
          const { bucketName, project, region, existed } = try bootstrapStateBucket(name)
          return ({
            status: existed ? ("adopted" as const) : ("created" as const),
            store: bucketName,
            location: { account: project, region },
          })
        }
      }
    },
  teardown: effect ({ name }) =>
    try effect {
      provide environment {
        return try effect {
          const { bucketName, deleted } = try teardownStateBucket(name)
          return ({ deleted: deleted ? [bucketName] : [] })
        }
      }
    },
}

/** The state store GCP contributes. */
export const stateStore: StateStoreImpl = { layer: state, lifecycle }
