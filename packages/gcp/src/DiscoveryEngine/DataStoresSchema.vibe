import * as discoveryengine from "@distilled.cloud/gcp/discoveryengine_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  expandDataStore,
  fingerprint,
  parseJsonObject,
  parseResourceName,
  rfc1035,
  toPhysical,
  withSchemaVersion,
} from "./internal.vibe"
import { waitForOperation } from "./operations.vibe"

export type DataStoresSchemaProps = {
  /**
   * Parent Data Store resource name
   * `projects/{project}/locations/{location}/dataStores/{dataStore}`.
   * Immutable — changing it replaces the schema.
   */
  dataStore: string
  /**
   * Schema id (RFC-1034, max 63 characters). If omitted, a unique id is
   * generated. Immutable — changing it replaces the schema.
   */
  schemaId?: string
  /**
   * JSON Schema document.
   */
  jsonSchema?: string
  /**
   * Structured schema representation. Ignored when `jsonSchema` is set.
   */
  structSchema?: Record<string, unknown>
}

export type DataStoresSchema = Resource<
  "GCP.DiscoveryEngine.DataStoresSchema",
  DataStoresSchemaProps,
  {
    /** Full resource name `.../dataStores/{dataStore}/schemas/{schema}`. */
    name: string
    /** Schema id (last path segment). */
    schemaId: string
    /** Parent data store resource name. */
    dataStore: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** JSON schema document, if set. */
    jsonSchema: string | undefined
    /** Structured schema, if set. */
    structSchema: Record<string, unknown> | undefined
  },
  never,
  Providers
>

/**
 * A Vertex AI Search Schema attached to a Data Store.
 *
 * Without labels, ownership rests on the deterministic id: `read` reports a
 * resource it finds without prior state as unowned (adopt it with `--adopt`).
 * Parent and schema id are immutable; the schema document updates in place
 * (LRO).
 *
 * ### Creating a Schema
 * **Example:** JSON schema
 * ```typescript
 * const schema = yield* GCP.DiscoveryEngine.DataStoresSchema("Catalog", {
 *   dataStore: dataStore.name,
 *   jsonSchema: JSON.stringify({
 *     type: "object",
 *     properties: {
 *       title: { type: "string" },
 *       sku: { type: "string" },
 *     },
 *   }),
 * });
 * ```
 *
 * ### Updating a Schema
 * **Example:** Add a field
 * ```typescript
 * // Same logical id as before; only the changed props differ.
 * const schema = yield* GCP.DiscoveryEngine.DataStoresSchema("Catalog", {
 *   dataStore: dataStore.name,
 *   jsonSchema: JSON.stringify({
 *     type: "object",
 *     properties: {
 *       title: { type: "string" },
 *       sku: { type: "string" },
 *       price: { type: "number" },
 *     },
 *   }),
 * });
 * ```
 *
 * @resource
 * @category DiscoveryEngine
 */
export const DataStoresSchema = Resource<DataStoresSchema>("GCP.DiscoveryEngine.DataStoresSchema")

// @vibelang-diagnostics-next-line EK4830:off
export class DataStoresSchemaNotResolved extends Data.TaggedError(
  "GCP.DiscoveryEngine.DataStoresSchemaNotResolved",
)<{
  resourceName: string
}> {}

const resourceName = (dataStore: string, schemaId: string): infer _ => `${dataStore}/schemas/${schemaId}`

const toAttrs = (schema: discoveryengine.GoogleCloudDiscoveryengineV1Schema, project: string): infer _ => {
  const name = schema.name ?? ""
  const parsed = parseResourceName(name, "schemas")
  const json = schema.jsonSchema
  const obj = parseJsonObject(json)
  if (obj && "$comment" in obj) {
    delete obj.$comment
  }
  return {
    name,
    schemaId: parsed.id,
    dataStore: parsed.dataStore,
    project: parsed.project || project,
    location: parsed.location,
    jsonSchema: obj ? JSON.stringify(obj) : json,
    structSchema: schema.structSchema as Record<string, unknown> | undefined,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? undefined : discoveryengine
  .getProjectsLocationsDataStoresSchemas({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: undefined;
    default: throw e;
  })

export const DataStoresSchemaProvider = (): infer _ =>
  Provider.succeed(DataStoresSchema, {
    stables: ["name", "schemaId", "dataStore", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousParent = olds?.dataStore ?? output?.dataStore
      if (previousParent !== undefined && resolved.dataStore !== previousParent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.schemaId ?? output?.schemaId
      if (previousId !== undefined && resolved.schemaId !== undefined && resolved.schemaId !== previousId) {
        return { action: "replace" as const, deleteFirst: true }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const schemaId = try toPhysical(id, olds?.schemaId, output?.schemaId, rfc1035)
      const parent = olds?.dataStore
        ? expandDataStore(olds.dataStore, env.project, output?.location ?? "global")
        : undefined
      const name = output?.name ?? (parent ? resourceName(parent, schemaId) : "")
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      // No labels field: without prior state it may not be ours.
      return output !== undefined
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const parent = expandDataStore(news.dataStore, env.project, output?.location ?? "global")
      const schemaId = try toPhysical(id, news.schemaId, output?.schemaId, rfc1035)
      const name = resourceName(parent, schemaId)
      const jsonSchema = withSchemaVersion(news.jsonSchema)
      const body: discoveryengine.GoogleCloudDiscoveryengineV1Schema = {
        jsonSchema,
        structSchema: news.jsonSchema === undefined ? news.structSchema : undefined,
      }

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = (effect {
          return (try (discoveryengine
            .createProjectsLocationsDataStoresSchemas({
              parent,
              schemaId,
              body,
            })
            |> Effect.retry(%, {
              while: (error) => error._tag === "DataStoreNotReady",
              times: 8,
              schedule: Schedule.spaced("5 seconds"),
            })))
        }) catch effect (e) => match (e) { when { _tag: "Conflict" }: undefined; default: throw e; }
        if (created !== undefined) {
          try waitForOperation(created)
        }
        current = try getByName(name)
      }

      if (current === undefined) {
        throw new DataStoresSchemaNotResolved({ resourceName: name })
      }

      const stripComment = (json: string | undefined): infer _ => {
        const obj = parseJsonObject(json)
        if (obj && "$comment" in obj) delete obj.$comment
        return fingerprint(obj ?? json)
      }
      const schemaChanged = stripComment(current.jsonSchema) !== stripComment(jsonSchema)
        || (news.jsonSchema === undefined
          && fingerprint(current.structSchema) !== fingerprint(news.structSchema))

      if (schemaChanged) {
        const patched = try discoveryengine.patchProjectsLocationsDataStoresSchemas({
          name: current.name ?? name,
          body: {
            ...body,
            name: current.name ?? name,
          },
        })
        try waitForOperation(patched)
        current = (try getByName(current.name ?? name)) ?? current
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      const existing = try getByName(output.name)
      if (existing === undefined) return
      const operation = discoveryengine
        .deleteProjectsLocationsDataStoresSchemas({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: undefined;
          default: throw e;
        }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
