import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Endpoint } from "./Endpoint.vibe"

/**
 * Shared HTTP scaffolding for Service Directory endpoint bindings.
 * NOT exported from index.ts.
 */
export const makeEndpointHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (endpoint: Endpoint) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${endpoint})`({
        iam: [grantFor(options.iam, endpoint.service)],
      })
    }
    const name = try endpoint.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${endpoint.LogicalId})`,
      )
  }
}
