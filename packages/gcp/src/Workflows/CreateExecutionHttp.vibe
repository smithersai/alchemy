import * as workflowexecutions from "@distilled.cloud/gcp/workflowexecutions_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import { CreateExecution, type CreateExecutionRequest } from "./CreateExecution.vibe"
import type { Workflow } from "./Workflow.vibe"

/**
 * HTTP implementation of {@link CreateExecution}.
 *
 * @layer
 * @provides GCP.Workflows.CreateExecution
 */
export const CreateExecutionHttp = Layer.effect(
  CreateExecution,
  effect {
    const bind = try GCPBindings.Bind
    const createExecution = try GCPBindings.withCredentials(
      workflowexecutions.createProjectsLocationsWorkflowsExecutions,
    )
    return effect (workflow: Workflow) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.Workflows.CreateExecution(${workflow})`({
          // Workflows has no resource-level IAM; invoker is granted on the project.
          iam: [{ role: "roles/workflows.invoker" }],
        })
      }
      const name = try workflow.name.asEffect()
      return effect (
        request?: CreateExecutionRequest | undefined,
      ) =>
        try withSpan(
          effect {
            const parent = try name
            return try createExecution({ ...request, parent })
          },
          `GCP.Workflows.CreateExecution(${workflow.LogicalId})`,
        )
    }
  },
)
