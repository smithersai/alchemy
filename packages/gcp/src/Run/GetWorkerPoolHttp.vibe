import * as cloudrun from "@distilled.cloud/gcp/run_v2"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor } from "../HttpBinding.ts"
import { GetWorkerPool, type GetWorkerPoolRequest } from "./GetWorkerPool.vibe"
import type { WorkerPool } from "./WorkerPool.ts"

/**
 * HTTP implementation of {@link GetWorkerPool}.
 *
 * @layer
 * @provides GCP.Run.GetWorkerPool
 */
export const GetWorkerPoolHttp = Layer.effect(
  GetWorkerPool,
  effect {
    const bind = try GCPBindings.Bind
    const getProjectsLocationsWorkerPools = try GCPBindings.withCredentials(
      cloudrun.getProjectsLocationsWorkerPools,
    )
    return effect <T extends WorkerPool>(pool: T) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.Run.GetWorkerPool(${pool})`({
          iam: [try Effect.orDie(Effect.try({ try: () => grantFor({ role: "roles/run.viewer", on: "run.workerPool" }, pool.name), catch: (e) => e }))],
        })
      }
      const name = try pool.name.asEffect()
      return effect (
        request?: GetWorkerPoolRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try getProjectsLocationsWorkerPools({
              ...request,
              name: try name,
            })
          },
          `GCP.Run.GetWorkerPool(${pool.LogicalId})`,
        )
    }
  },
)
