import * as cloudrun from "@distilled.cloud/gcp/run_v2"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor } from "../HttpBinding.ts"
import { GetService, type GetServiceRequest } from "./GetService.vibe"
import type { Service } from "./Service.ts"

/**
 * HTTP implementation of {@link GetService}.
 *
 * @layer
 * @provides GCP.Run.GetService
 */
export const GetServiceHttp = Layer.effect(
  GetService,
  effect {
    const bind = try GCPBindings.Bind
    const get = try GCPBindings.withCredentials(cloudrun.getProjectsLocationsServices)
    return effect <T extends Service>(service: T) => {
      const name = try service.name.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.Run.GetService(${service})`({
          iam: [
            try Effect.orDie(Effect.try({
              try: () => grantFor({ role: "roles/run.viewer", on: "run.service" }, service.name),
              catch: (e) => e,
            })),
          ],
        })
      }
      return effect (
        request?: GetServiceRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try get({
              ...request,
              name: try name,
            })
          },
          `GCP.Run.GetService(${service.LogicalId})`,
        )
    }
  },
)
