import * as cloudrun from "@distilled.cloud/gcp/run_v2"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { grantFor } from "../HttpBinding.ts"
import type { Job } from "./Job.ts"
import { RunJob, type RunJobRequest } from "./RunJob.vibe"

/**
 * HTTP implementation of {@link RunJob}.
 *
 * @layer
 * @provides GCP.Run.RunJob
 */
export const RunJobHttp = Layer.effect(
  RunJob,
  effect {
    const bind = try GCPBindings.Bind
    const run = try GCPBindings.withCredentials(cloudrun.runProjectsLocationsJobs)
    return effect <T extends Job>(job: T) => {
      const name = try job.name.asEffect()
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.Run.RunJob(${job})`({
          iam: [
            // runWithOverrides: RunJobRequest accepts `body.overrides`.
            try Effect.orDie(Effect.try({ try: () => grantFor({ role: "roles/run.jobsExecutorWithOverrides", on: "run.job" }, job.name), catch: (e) => e })),
          ],
        })
      }
      return effect (request?: RunJobRequest | undefined) =>
        try withSpan(
          effect {
            return try run({
              ...request,
              name: try name,
            })
          },
          `GCP.Run.RunJob(${job.LogicalId})`,
        )
    }
  },
)
