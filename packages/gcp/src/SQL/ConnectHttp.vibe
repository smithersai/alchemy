import * as Binding from "alchemy/Binding"
import type { Input } from "alchemy/Input"
import * as Output from "alchemy/Output"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import type { GcpHostBinding } from "../Host.ts"
import { CLOUD_SQL_MOUNT_PATH } from "../HostRuntime.ts"
import { grantFor } from "../HttpBinding.vibe"
import { ReadSecret } from "../SecretManager/ReadSecret.vibe"
import { ReadSecretHttp } from "../SecretManager/ReadSecretHttp.vibe"
import { Connect, PasswordMissing, type ConnectionInfo, type ConnectOptions } from "./Connect.vibe"
import type { Instance } from "./Instance.vibe"

const socketUrl = (options: {
  databaseVersion: string | undefined
  socketPath: string
  database: string
  username: string
  password: string
}): infer _ => {
  const mysql = (options.databaseVersion ?? "").toUpperCase().startsWith("MYSQL_")
  // The socket travels as a query parameter; `localhost` only satisfies
  // URL parsers that reject credentials with an empty host.
  const url = new URL(
    `${mysql ? "mysql" : "postgresql"}://localhost/${encodeURIComponent(options.database)}`,
  )
  url.username = encodeURIComponent(options.username)
  url.password = encodeURIComponent(options.password)
  url.searchParams.set(mysql ? "socketPath" : "host", options.socketPath)
  return url.toString()
}

/**
 * HTTP implementation of {@link Connect}: reads the password through
 * `GCP.SecretManager.ReadSecret` and connects over the Cloud Run
 * `cloudsql` socket volume.
 *
 * @layer
 * @provides GCP.SQL.Connect
 * @category SQL
 */
export const ConnectHttp = Layer.effect(
  Connect,
  effect {
    const bind = try GCPBindings.Bind
    const readSecret = try Effect.service(ReadSecret)
    return effect (instance: Instance, options: ConnectOptions) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        // Connects over the socket volume Cloud Run mounts for the host.
        try GCPBindings.requireServiceAccountHost("GCP.SQL.Connect")
        try bind`GCP.SQL.Connect(${instance})`({
          // Cloud SQL has no instance-level IAM policy; an IAM Condition
          // scopes the project grant to this instance.
          iam: [
            try Effect.orDie(Effect.try({
              try: () =>
                grantFor(
                  { role: "roles/cloudsql.client", scopeByCondition: true },
                  Output.interpolate`projects/${instance.project}/instances/${instance.instanceName}`,
                ),
              catch: (e) => e,
            })),
          ],
        })
        const host = try Binding.Host
        if (host !== undefined) {
          const bindHost = (host as unknown as { bind: unknown }).bind as (
            label: TemplateStringsArray,
            ...args: unknown[]
          ) => (data: {
            cloudSqlInstances: Input<GcpHostBinding["cloudSqlInstances"]>
          }) => void!!
          try bindHost`GCP.SQL.Socket(${instance})`({
            cloudSqlInstances: [
              Output.interpolate`${instance.project}:${instance.region}:${instance.instanceName}`,
            ],
          })
        }
      }
      const password = try readSecret(options.passwordSecret)
      const project = try instance.project.asEffect()
      const region = try instance.region.asEffect()
      const instanceName = try instance.instanceName.asEffect()
      const databaseVersion = try instance.databaseVersion.asEffect()
      const database = try options.database.databaseName.asEffect()
      const username = try options.user.userName.asEffect()
      const secretName = try options.passwordSecret.name.asEffect()

      return effect {
        const value = try password.access()
        if (value === undefined) {
          throw new PasswordMissing({ secret: try secretName })
        }
        const connectionName = `${try project}:${try region}:${try instanceName}`
        const socketPath = `${CLOUD_SQL_MOUNT_PATH}/${connectionName}`
        const databaseName = try database
        const userName = try username
        const info: ConnectionInfo = {
          connectionName,
          socketPath,
          database: databaseName,
          username: userName,
          password: Redacted.make(value),
          url: Redacted.make(
            socketUrl({
              databaseVersion: try databaseVersion,
              socketPath,
              database: databaseName,
              username: userName,
              password: value,
            }),
          ),
        }
        return info
      }
    }
  },
).pipe(Layer.provide(ReadSecretHttp))
