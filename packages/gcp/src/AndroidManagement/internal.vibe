import * as androidmanagement from "@distilled.cloud/gcp/androidmanagement_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"

export const ENTERPRISE_PREFIX = "enterprises/"
export const MAX_DISPLAY_NAME_LENGTH = 100
export const MAX_WEB_APP_TITLE_LENGTH = 100
export const MAX_ADDITIONAL_DATA_LENGTH = 1024
export const DEFAULT_DURATION = "315360000s"
export const DEFAULT_DISPLAY_MODE = "STANDALONE"
export const DEFAULT_START_URL = "https://example.com/"

export const DEFAULT_WEB_APP_ICON: androidmanagement.WebAppIcon = {
  imageData: "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const parentOf = (name: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  return parts.slice(0, -2).join("/")
}

export const normalizeName = (value: string): infer _ => value.replace(/\/+$/, "")

export const toEnterpriseName = (value: string): infer _ => {
  const trimmed = normalizeName(value)
  if (trimmed.length === 0) return ""
  if (trimmed.startsWith(ENTERPRISE_PREFIX)) return trimmed
  return `${ENTERPRISE_PREFIX}${trimmed}`
}

export const toEnrollmentTokenName = (parent: string, tokenId?: string): infer _ => {
  if (tokenId !== undefined && tokenId.includes("/enrollmentTokens/")) {
    return normalizeName(tokenId)
  }
  if (tokenId !== undefined && tokenId.length > 0 && parent.length > 0) {
    return `${toEnterpriseName(parent)}/enrollmentTokens/${lastSegment(tokenId)}`
  }
  return ""
}

export const toWebAppName = (parent: string, webAppId?: string): infer _ => {
  if (webAppId !== undefined && webAppId.includes("/webApps/")) {
    return normalizeName(webAppId)
  }
  if (webAppId !== undefined && webAppId.length > 0 && parent.length > 0) {
    return `${toEnterpriseName(parent)}/webApps/${lastSegment(webAppId)}`
  }
  return ""
}

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const sameBoolean = (left: boolean | undefined, right: boolean | undefined): infer _ =>
  (left ?? false) === (right ?? false)

export const jsonEqual = (left: unknown, right: unknown): infer _ =>
  JSON.stringify(left ?? null) === JSON.stringify(right ?? null)

export const sameStringList = (
  left: readonly string[] | undefined,
  right: readonly string[] | undefined,
): infer _ => jsonEqual([...(left ?? [])].slice().sort(), [...(right ?? [])].slice().sort())

export const updateMaskOf = (...fields: Array<string | undefined>): infer _ =>
  fields.filter((field): field is string => field !== undefined).join(",")

export const replaceOnIdentity = (input: {
  previousId?: string
  nextId?: string
  previousParent?: string
  nextParent?: string
  extra?: boolean
}): infer _ => {
  if (input.extra === true) {
    return { action: "replace" as const, deleteFirst: false }
  }
  if (
    input.previousId !== undefined
    && input.nextId !== undefined
    && input.previousId !== input.nextId
  ) {
    return { action: "replace" as const, deleteFirst: false }
  }
  if (
    input.previousParent !== undefined
    && input.nextParent !== undefined
    && toEnterpriseName(input.previousParent) !== toEnterpriseName(input.nextParent)
  ) {
    return { action: "replace" as const, deleteFirst: true }
  }
  return undefined
}

export const toDisplayName = effect (
  id: string,
  requested: string | undefined,
  existing: string | undefined,
  maxLength = MAX_DISPLAY_NAME_LENGTH,
) => {
  if (requested !== undefined && requested.length > 0) {
    return requested.slice(0, maxLength)
  }
  if (existing !== undefined && existing.length > 0) {
    return existing.slice(0, maxLength)
  }
  return try createPhysicalName({
    id,
    maxLength: Math.min(40, maxLength),
    lowercase: true,
  })
}

const emptyList = effect <A>() => [] as A[]

export const collectPages = effect <Page, A, E, R>(
  pages: Stream.Stream<Page, E, R>,
  items: (page: Page) => readonly A[] | undefined,
) =>
  Array.from(
    try (pages
      |> Stream.flatMap(%, (page) => Stream.fromIterable(items(page) ?? []))
      |> Stream.runCollect(%)),
  )

export const getEnterprise = effect (name: string) => (name.length === 0 ? try Effect.undefined : androidmanagement
  .getEnterprises({ name: toEnterpriseName(name) }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const getEnrollmentToken = effect (name: string) => (name.length === 0 ? try Effect.undefined : androidmanagement
  .getEnterprisesEnrollmentTokens({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const getWebApp = effect (name: string) => (name.length === 0 ? try Effect.undefined : androidmanagement
  .getEnterprisesWebApps({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const listEnterprisesAt = effect (
  projectId: string,
) => (projectId.length === 0 ? try emptyList<androidmanagement.Enterprise>() : collectPages(
  androidmanagement.listEnterprises.pages({
    projectId,
    view: "BASIC",
    pageSize: 100,
  }),
  (page) => page.enterprises,
) catch effect (e) => match (e) {
  when { _tag: "NotFound" }: try emptyList<androidmanagement.Enterprise>();
  default: throw e;
})

export const listWebAppsAt = effect (
  parent: string,
) => (parent.length === 0 ? try emptyList<androidmanagement.WebApp>() : collectPages(
  androidmanagement.listEnterprisesWebApps.pages({
    parent: toEnterpriseName(parent),
    pageSize: 100,
  }),
  (page) => page.webApps,
) catch effect (e) => match (e) {
  when { _tag: "NotFound" }: try emptyList<androidmanagement.WebApp>();
  default: throw e;
})

const hydrateEnterprise = effect (enterprise: androidmanagement.Enterprise) => {
  if (
    enterprise.enterpriseDisplayName !== undefined
    && enterprise.enterpriseDisplayName.length > 0
  ) {
    return enterprise
  }
  const name = enterprise.name ?? ""
  if (name.length === 0) return enterprise
  return (try getEnterprise(name)) ?? enterprise
}

/** Find an enterprise of `projectId` by its display name. */
export const findEnterpriseByDisplayName = effect (projectId: string, displayName: string) => {
  const listed = try listEnterprisesAt(projectId)
  for (const enterprise of listed) {
    const hydrated = try hydrateEnterprise(enterprise)
    if (hydrated.enterpriseDisplayName === displayName) return hydrated
  }
  return undefined
}

/** Find a web app of `parent` by its title. */
export const findWebAppByTitle = effect (parent: string, title: string) =>
  (try listWebAppsAt(parent)).find((app) => app.title === title)

export const defaultWebAppIcons = (
  icons: readonly androidmanagement.WebAppIcon[] | undefined,
): androidmanagement.WebAppIcon[] => icons && icons.length > 0 ? [...icons] : [DEFAULT_WEB_APP_ICON]
