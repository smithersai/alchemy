import * as biglake from "@distilled.cloud/gcp/biglake_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  BiglakeNotResolved,
  listLocations,
  MAX_ID_LENGTH,
  hasAlchemyLabels,
  hasOwnershipMarker,
  ignoreGone,
  listCatalogs,
  listDatabases,
  listTables,
  locationParent,
  missingGet,
  namedOf,
  normalizeLocation,
  parseOwnershipMarker,
  parseResourceName,
  replaceOnIdentity,
  retryTransient,
  rfc1035,
  toPhysicalId,
  waitUntilGone,
} from "./internal.ts"

export type CatalogProps = {
  /**
   * Catalog id (the `{catalog}` segment of
   * `projects/{project}/locations/{location}/catalogs/{catalog}`). If
   * omitted, a unique id is generated. Immutable — changing it replaces
   * the catalog.
   */
  catalogId?: string
  /**
   * Location (`us-central1`, `US`, …). Immutable — changing it replaces
   * the catalog. `US-CENTRAL1` is accepted and normalized to
   * `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
}

export type Catalog = Resource<
  "GCP.BigLake.Catalog",
  CatalogProps,
  {
    /** Full resource name. */
    name: string
    /** Catalog id (last path segment). */
    catalogId: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** RFC3339 creation timestamp. */
    createTime: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
    /** RFC3339 deletion timestamp, if the catalog is soft-deleted. */
    deleteTime: string | undefined
    /** RFC3339 expire timestamp after delete. */
    expireTime: string | undefined
  },
  never,
  Providers
>

/**
 * A BigLake Metastore catalog — the top-level container for Hive
 * databases and tables.
 *
 * Catalogs have no labels, description, or annotations, and Alchemy does
 * not write ownership into the catalog IAM policy: generated ids carry an
 * `alc_` prefix that `list` / nuke match, and `read` reports an explicit
 * id it has no state for as unowned.
 * Location and catalog id are immutable. There is nothing else to
 * update in place.
 *
 * ### Creating a Catalog
 * **Example:** Generated id
 * ```typescript
 * const catalog = yield* GCP.BigLake.Catalog("Lake", {});
 * ```
 *
 * **Example:** Named catalog in a multi-region
 * ```typescript
 * const catalog = yield* GCP.BigLake.Catalog("Lake", {
 *   catalogId: "analytics",
 *   location: "US",
 * });
 * ```
 *
 * @resource
 * @category BigLake
 */
export const Catalog = Resource<Catalog>("GCP.BigLake.Catalog")

const OWNERSHIP_TITLE = "alchemy-ownership"
const resourceName = (project: string, location: string, catalogId: string): infer _ =>
  `${locationParent(project, location)}/catalogs/${catalogId}`

const toAttrs = (catalog: biglake.Catalog, project: string): infer _ => {
  const name = catalog.name ?? ""
  const parsed = parseResourceName(name, "catalogs")
  return {
    name,
    catalogId: parsed.id,
    project,
    location: parsed.location,
    createTime: catalog.createTime,
    updateTime: catalog.updateTime,
    deleteTime: catalog.deleteTime,
    expireTime: catalog.expireTime,
  }
}

const getByName = missingGet(biglake.getProjectsLocationsCatalogs)

const policyHasOwnership = (policy: biglake.Policy | undefined): infer _ =>
  (policy?.bindings ?? []).some(
    (binding) =>
      binding.condition?.title === OWNERSHIP_TITLE
      || hasOwnershipMarker(binding.condition?.description),
  )

const getPolicy = effect (name: string) => (name.length === 0 ? try Effect.undefined : biglake
  .getIamPolicyProjectsCatalogs({
    resource: name,
    "options.requestedPolicyVersion": 3,
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" } or { _tag: "BigLakeResourceNotFound" }: try Effect.undefined;
    default: throw e;
  })

const toCatalogId = effect (id: string, explicit: string | undefined, existing: string | undefined) => {
  if (explicit !== undefined) return explicit
  if (existing !== undefined) return existing
  const generated = try toPhysicalId(id, undefined, undefined)
  if (generated.startsWith("alc_")) return generated
  return try Effect.orDie(Effect.try({ try: () => rfc1035(`alc_${generated}`, MAX_ID_LENGTH), catch: (e) => e }))
}

const lastIdOwned = (name: string | undefined): infer _ => {
  const id = parseResourceName(name ?? "", "catalogs").id
  return id.startsWith("alc_")
}

const isOwnedCatalog = (catalog: biglake.Catalog, policy?: biglake.Policy): infer _ =>
  policyHasOwnership(policy) || lastIdOwned(catalog.name)

const ownedFromPolicy = effect (id: string, policy: biglake.Policy | undefined) => {
  for (const binding of policy?.bindings ?? []) {
    const labels = try Effect.orDie(
      Effect.try({ try: () => parseOwnershipMarker(binding.condition?.description), catch: (e) => e }),
    )
    if (try hasAlchemyLabels(id, labels)) return true
  }
  return false
}

const emptyCatalog = effect (name: string) => {
  const databases = try listDatabases(name)
  try Effect.forEach(
    try Effect.orDie(Effect.try({ try: () => namedOf(databases), catch: (e) => e })),
    effect (database) => try emptyAndDeleteDatabase(database.name!),
    { concurrency: 1 },
  )
}

const emptyAndDeleteDatabase = effect (name: string) => {
  const tables = try listTables(name)
  try Effect.forEach(
    try Effect.orDie(Effect.try({ try: () => namedOf(tables), catch: (e) => e })),
    effect (table) =>
      try ignoreGone(
        biglake.deleteProjectsLocationsCatalogsDatabasesTables({
          name: table.name!,
        }),
      ),
    { concurrency: 4 },
  )
  try ignoreGone(biglake.deleteProjectsLocationsCatalogsDatabases({ name }))
}

export const CatalogProvider = (): infer _ =>
  Provider.succeed(Catalog, {
    stables: ["name", "catalogId", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      const env = try GcpEnvironment.current
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId: olds?.catalogId ?? output?.catalogId,
            nextId: resolved.catalogId,
            previousLocation: normalizeLocation(olds?.location ?? output?.location, env.region),
            nextLocation: normalizeLocation(
              resolved.location ?? olds?.location ?? output?.location,
              env.region,
            ),
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const catalogId = try toCatalogId(id, olds?.catalogId, output?.catalogId)
      const name = output?.name ?? resourceName(env.project, location, catalogId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      // Catalogs have no labels. A generated `alc_` id derives from this
      // stack, stage, logical id and instance; an explicit id is ours when
      // state has it or an earlier Alchemy version stamped the IAM policy.
      if (output !== undefined || olds?.catalogId === undefined) return attrs
      const policy = try getPolicy(existing.name ?? name)
      return (try ownedFromPolicy(id, policy))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const catalogs = (try Effect.forEach(
        try Effect.orDie(Effect.try({
          try: () => listLocations(env.region),
          catch: (e) => e,
        })),
        effect (location) =>
          try listCatalogs(
            try Effect.orDie(Effect.try({ try: () => locationParent(env.project, location), catch: (e) => e })),
          ),
      )).flat()
      const owned = try Effect.forEach(
        try Effect.orDie(Effect.try({
          try: () => namedOf(catalogs),
          catch: (e) => e,
        })),
        effect (catalog) => {
          const policy = try getPolicy(catalog.name!)
          return isOwnedCatalog(catalog, policy) ? catalog : undefined
        },
        { concurrency: 4 },
      )
      return owned
        .filter((item): item is biglake.Catalog => item !== undefined)
        .map((item) => toAttrs(item, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(news.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const catalogId = try toCatalogId(id, news.catalogId, output?.catalogId)
      const parent = try Effect.orDie(
        Effect.try({ try: () => locationParent(env.project, location), catch: (e) => e }),
      )
      const name = output?.name ?? resourceName(env.project, location, catalogId)
      let current = try getByName(name)

      if (current === undefined) {
        const created = retryTransient(
          biglake.createProjectsLocationsCatalogs({
            parent,
            catalogId,
            body: {},
          }),
        ) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new BiglakeNotResolved({ resourceName: name })
      }

      return toAttrs(current, env.project)
    },

    delete: effect ({ output }) => {
      if (!output.name) return
      try emptyCatalog(output.name)
      try ignoreGone(biglake.deleteProjectsLocationsCatalogs({ name: output.name }))
      try waitUntilGone(getByName(output.name))
    },
  })
