import * as firebaserules from "@distilled.cloud/gcp/firebaserules_v1"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import type { Ruleset } from "./Ruleset.vibe"
import { TestRuleset, type TestRulesetRequest } from "./TestRuleset.vibe"

/**
 * HTTP implementation of {@link TestRuleset}.
 *
 * Grants `roles/firebaserules.admin` on the project because it is the
 * narrowest predefined role containing `firebaserules.rulesets.test`, and Firebase
 * Rules has no resource-level IAM.
 *
 * @layer
 * @provides GCP.FirebaseRules.TestRuleset
 */
export const TestRulesetHttp = Layer.effect(
  TestRuleset,
  effect {
    const bind = try GCPBindings.Bind
    const testProjects = try GCPBindings.withCredentials(firebaserules.testProjects)
    return effect (ruleset: Ruleset) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.FirebaseRules.TestRuleset(${ruleset})`({
          iam: [{ role: "roles/firebaserules.admin" }],
        })
      }
      const name = try ruleset.name.asEffect()
      return effect (
        request: TestRulesetRequest = {},
      ) =>
        try withSpan(
          effect {
            return try testProjects({
              ...request,
              name: try name,
            })
          },
          `GCP.FirebaseRules.TestRuleset(${ruleset.LogicalId})`,
        )
    }
  },
)
