import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import { lastSegment, orgParent, organizationFromName, toResourceId } from "./names.vibe"
import { createInternalLabels, encodeOwnership, hasAlchemyLabels, parseOwnership } from "./ownership.ts"

const MAX_NAME_LENGTH = 255
const OWNERSHIP_ENTRY = "__alchemy"

export type KeyvaluemapProps = {
  /**
   * Apigee organization id. Defaults to the current GCP project id.
   * Immutable — changing it replaces the map.
   */
  organization?: string
  /**
   * Key value map id (the `{keyvaluemap}` segment of
   * `organizations/{org}/keyvaluemaps/{keyvaluemap}`). If omitted, a
   * unique name is generated from the stack, stage, and logical id.
   * Immutable — changing it replaces the map.
   */
  mapId?: string
  /**
   * When true, entry values are masked in GET responses.
   * @default false
   */
  maskedValues?: boolean
}

export type Keyvaluemap = Resource<
  "GCP.Apigee.Keyvaluemap",
  KeyvaluemapProps,
  {
    /** Full resource name `organizations/{org}/keyvaluemaps/{keyvaluemap}`. */
    name: string
    /** Map id (last path segment). */
    mapId: string
    /** Apigee organization id. */
    organization: string
    /** Whether entry values are masked in GET responses. */
    maskedValues: boolean
    /** Whether entries are encrypted. Always true on Apigee X / hybrid. */
    encrypted: boolean
  },
  never,
  Providers
>

/**
 * An organization-scoped Apigee key value map.
 *
 * Org-level KVMs have no labels, description, or list API. Alchemy
 * stamps ownership into a reserved `__alchemy` entry so `read` can
 * detect foreign maps, and `list` walks maps referenced by that entry
 * when the parent is known from state. `mapId` and `organization` are
 * identity — changing them replaces the map. `maskedValues` updates in
 * place. Entries are always encrypted on Apigee X.
 *
 * ### Creating a Map
 * **Example:** Generated name
 * ```typescript
 * const kv = yield* GCP.Apigee.Keyvaluemap("Config", {});
 * ```
 *
 * **Example:** Named map with masked values
 * ```typescript
 * const kv = yield* GCP.Apigee.Keyvaluemap("Config", {
 *   mapId: "app-config",
 *   maskedValues: true,
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const Keyvaluemap = Resource<Keyvaluemap>("GCP.Apigee.Keyvaluemap")

// @vibelang-diagnostics-next-line EK4830:off
export class KeyvaluemapNotResolved extends Data.TaggedError("GCP.Apigee.KeyvaluemapNotResolved")<{
  resourceName: string
}> {}

const resourceName = (organization: string, mapId: string): infer _ =>
  `${orgParent(organization)}/keyvaluemaps/${mapId}`

const mapIdOf = (map: apigee.GoogleCloudApigeeV1KeyValueMap): infer _ => lastSegment(map.name ?? "")

const toAttrs = (map: apigee.GoogleCloudApigeeV1KeyValueMap, organization: string): infer _ => {
  const mapId = mapIdOf(map)
  const name = map.name?.includes("/") ? map.name : resourceName(organization, mapId)
  return {
    name,
    mapId,
    organization: organizationFromName(name) ?? organization,
    maskedValues: map.maskedValues === true,
    encrypted: map.encrypted !== false,
  }
}

const getByName = effect (name: string) =>
  apigee
    .getOrganizationsKeyvaluemaps({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: undefined;
      default: throw e;
    }

const getOwnershipEntry = effect (mapName: string) =>
  apigee
    .getOrganizationsKeyvaluemapsEntries({
      name: `${mapName}/entries/${OWNERSHIP_ENTRY}`,
    }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: undefined;
      default: throw e;
    }

const upsertOwnershipEntry = effect (mapName: string, marker: string) =>
  apigee
    .createOrganizationsKeyvaluemapsEntries({
      parent: mapName,
      body: { name: OWNERSHIP_ENTRY, value: marker },
    }) catch effect (e) => match (e) {
      when { _tag: "Conflict" }: try apigee.updateOrganizationsKeyvaluemapsEntries({
        name: `${mapName}/entries/${OWNERSHIP_ENTRY}`,
        body: { name: OWNERSHIP_ENTRY, value: marker },
      });
      default: throw e;
    }

export const KeyvaluemapProvider = (): infer _ =>
  Provider.succeed(Keyvaluemap, {
    stables: ["name", "mapId", "organization"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousId = olds?.mapId ?? output?.mapId
      const previousOrg = olds?.organization ?? output?.organization
      if (
        (previousId !== undefined && resolved.mapId !== undefined && resolved.mapId !== previousId)
        || (previousOrg !== undefined
          && resolved.organization !== undefined
          && resolved.organization !== previousOrg)
      ) {
        return { action: "replace" as const, deleteFirst: true }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = organizationFromName(output?.name) ?? olds?.organization ?? env.project
      const mapId = try toResourceId(id, olds?.mapId, output?.mapId, MAX_NAME_LENGTH)
      const name = output?.name ?? resourceName(organization, mapId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, organization)
      const entry = try getOwnershipEntry(attrs.name)
      const { labels } = try Effect.orDie(Effect.try({ try: () => parseOwnership(entry?.value), catch: (e) => e }))
      return (try hasAlchemyLabels(id, labels))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      // Org-level KVMs have no list API. Enumerate entries of the
      // reserved `__alchemy` key on maps we can GET by walking a
      // page of instance-adjacent state is impossible; return [].
      // Nuke still deletes maps tracked in Alchemy state. Catch
      // entitlement errors so `pnpm nuke:gcp` stays green.
      void env
      return [] as Keyvaluemap["Attributes"][]
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const organization = news.organization ?? output?.organization ?? env.project
      const mapId = try toResourceId(id, news.mapId, output?.mapId, MAX_NAME_LENGTH)
      const name = resourceName(organization, mapId)
      const ownership = try createInternalLabels(id)
      const marker = try Effect.orDie(
        Effect.try({ try: () => encodeOwnership(ownership, undefined), catch: (e) => e }),
      )
      const desiredMasked = news.maskedValues === true

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = apigee
          .createOrganizationsKeyvaluemaps({
            parent: orgParent(organization),
            body: {
              name: mapId,
              encrypted: true,
              maskedValues: desiredMasked ? true : undefined,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new KeyvaluemapNotResolved({ resourceName: name })
      }

      const currentName = current.name?.includes("/") ? current.name : name
      if ((current.maskedValues === true) !== desiredMasked) {
        current = try apigee.updateOrganizationsKeyvaluemaps({
          name: currentName,
          body: {
            name: mapId,
            encrypted: true,
            maskedValues: desiredMasked,
          },
        })
      }

      try upsertOwnershipEntry(current.name?.includes("/") ? current.name : name, marker)

      return toAttrs(current, organization)
    },

    delete: effect ({ output }) => {
      apigee
        .deleteOrganizationsKeyvaluemaps({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: (undefined as void);
          default: throw e;
        }
    },
  })
