import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import { lastSegment, orgParent, organizationFromName, toResourceId } from "./names.vibe"

const MAX_NAME_LENGTH = 255

export type KeyvaluemapsEntryProps = {
  /**
   * Apigee organization id. Defaults to the current GCP project id.
   * Immutable — changing it replaces the entry.
   */
  organization?: string
  /**
   * Parent key value map id or full name
   * (`organizations/{org}/keyvaluemaps/{keyvaluemap}`). Immutable —
   * changing it replaces the entry.
   */
  map: string
  /**
   * Entry key (the `{entry}` segment of
   * `organizations/{org}/keyvaluemaps/{keyvaluemap}/entries/{entry}`).
   * If omitted, a unique name is generated from the stack, stage, and
   * logical id. Immutable — changing it replaces the entry. Must not be
   * `__alchemy` (reserved by {@link Keyvaluemap} for ownership).
   */
  entryId?: string
  /**
   * Payload associated with the key, stored verbatim.
   */
  value: string
}

export type KeyvaluemapsEntry = Resource<
  "GCP.Apigee.KeyvaluemapsEntry",
  KeyvaluemapsEntryProps,
  {
    /** Full resource name `organizations/{org}/keyvaluemaps/{map}/entries/{entry}`. */
    name: string
    /** Entry key (last path segment). */
    entryId: string
    /** Parent map id. */
    mapId: string
    /** Apigee organization id. */
    organization: string
    /** Payload associated with the key. */
    value: string
  },
  never,
  Providers
>

/**
 * An organization-scoped Apigee key value map entry.
 *
 * Entries have no labels field and the value is read by proxies, so
 * Alchemy stores it verbatim and identifies its entries by the generated
 * key: `read` reports an entry with an explicit `entryId` as unowned
 * (adopt it with `--adopt`). Organization, map, and key are identity —
 * changing them replaces the entry. `value` updates in place.
 *
 * ### Creating an Entry
 * **Example:** Generated key on a map
 * ```typescript
 * const kv = yield* GCP.Apigee.Keyvaluemap("Config", {});
 * const entry = yield* GCP.Apigee.KeyvaluemapsEntry("ApiKey", {
 *   map: kv.name,
 *   value: "secret-value",
 * });
 * ```
 *
 * **Example:** Explicit key
 * ```typescript
 * const entry = yield* GCP.Apigee.KeyvaluemapsEntry("ApiKey", {
 *   map: kv.name,
 *   entryId: "api-key",
 *   value: "secret-value",
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const KeyvaluemapsEntry = Resource<KeyvaluemapsEntry>("GCP.Apigee.KeyvaluemapsEntry")

// @vibelang-diagnostics-next-line EK4830:off
export class KeyvaluemapsEntryNotResolved extends Data.TaggedError(
  "GCP.Apigee.KeyvaluemapsEntryNotResolved",
)<{
  resourceName: string
}> {}

const mapIdOf = (map: string): infer _ => lastSegment(map)

const mapName = (organization: string, map: string): infer _ =>
  map.includes("/") ? map : `${orgParent(organization)}/keyvaluemaps/${map}`

const resourceName = (organization: string, map: string, entryId: string): infer _ =>
  `${mapName(organization, map)}/entries/${entryId}`

const toAttrs = (
  entry: apigee.GoogleCloudApigeeV1KeyValueEntry,
  organization: string,
  mapId: string,
): infer _ => {
  const raw = entry.name ?? ""
  const name = raw.includes("/") ? raw : resourceName(organization, mapId, raw)
  return {
    name,
    entryId: lastSegment(name),
    mapId,
    organization: organizationFromName(name) ?? organization,
    value: entry.value ?? "",
  }
}

const getByName = effect (name: string) =>
  apigee
    .getOrganizationsKeyvaluemapsEntries({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: undefined;
      default: throw e;
    }

export const KeyvaluemapsEntryProvider = (): infer _ =>
  Provider.succeed(KeyvaluemapsEntry, {
    stables: ["name", "entryId", "mapId", "organization"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousId = olds?.entryId ?? output?.entryId
      const previousMap = olds?.map ?? output?.mapId
      const previousOrg = olds?.organization ?? output?.organization
      if (
        (previousId !== undefined && resolved.entryId !== undefined && resolved.entryId !== previousId)
        || (previousMap !== undefined && mapIdOf(resolved.map) !== mapIdOf(previousMap))
        || (previousOrg !== undefined
          && resolved.organization !== undefined
          && resolved.organization !== previousOrg)
      ) {
        return { action: "replace" as const, deleteFirst: true }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = organizationFromName(output?.name) ?? olds?.organization ?? env.project
      const mapId = mapIdOf(olds?.map ?? output?.mapId ?? "")
      if (mapId.length === 0) return undefined
      const entryId = try toResourceId(id, olds?.entryId, output?.entryId, MAX_NAME_LENGTH)
      const name = output?.name ?? resourceName(organization, mapId, entryId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, organization, mapId)
      const generated = try toResourceId(id, undefined, undefined, MAX_NAME_LENGTH)
      return attrs.entryId === generated
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const organization = news.organization ?? output?.organization ?? env.project
      const mapId = mapIdOf(news.map)
      const entryId = try toResourceId(id, news.entryId, output?.entryId, MAX_NAME_LENGTH)
      const parent = mapName(organization, news.map)
      const name = resourceName(organization, mapId, entryId)
      const desiredValue = news.value

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = apigee
          .createOrganizationsKeyvaluemapsEntries({
            parent,
            body: { name: entryId, value: desiredValue },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new KeyvaluemapsEntryNotResolved({ resourceName: name })
      }

      if ((current.value ?? "") !== desiredValue) {
        current = try apigee.updateOrganizationsKeyvaluemapsEntries({
          name: current.name?.includes("/") ? current.name : name,
          body: { name: entryId, value: desiredValue },
        })
      }

      return toAttrs(current, organization, mapId)
    },

    delete: effect ({ output }) => {
      apigee
        .deleteOrganizationsKeyvaluemapsEntries({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: undefined as void;
          default: throw e;
        }
    },
  })
