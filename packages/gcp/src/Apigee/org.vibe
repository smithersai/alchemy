import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import * as Effect from "effect/Effect"
import { GcpEnvironment } from "../Environment.ts"
import { orgParent, organizationOf } from "./names.vibe"
import { hasOwnershipMarker } from "./ownership.ts"

export const currentOrganization = effect (explicit: string | undefined, existing?: string) => {
  const env = try GcpEnvironment.current
  return organizationOf(explicit, existing, env.project)
}

export const listOwnedInstances = effect (organization: string) =>
  (effect { return (Array.from(
    try (apigee.listOrganizationsInstances
      .pages({
        parent: orgParent(organization),
        pageSize: 1000,
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.instances ?? []))
      |> Stream.filter(%, (instance) => hasOwnershipMarker(instance.description))
      |> Stream.runCollect(%)),
  )) }) catch effect (e) => match (e) {
    when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: [] as apigee.GoogleCloudApigeeV1Instance[];
    default: throw e;
  }
