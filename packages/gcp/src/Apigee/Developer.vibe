import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  attributesToRecord,
  createOwnership,
  defaultOrgName,
  desiredAttributes,
  lastSegment,
  listOrgNames,
  orgIdOf,
  orgNameOf,
  ownedBy,
  recordToAttributes,
  sameRecord,
  userAttributes,
} from "./operations.vibe"

export type DeveloperProps = {
  /**
   * Apigee organization id or `organizations/{org}`. Defaults to the
   * current GCP project id. Immutable — changing it replaces the developer.
   */
  mutable organization?: string
  /**
   * Developer email (unique within the organization, lowercase). If omitted,
   * a unique `{physical}@alchemy.example` address is generated. Immutable —
   * changing it replaces the developer.
   */
  mutable email?: string
  /**
   * First name.
   * @default "Alchemy"
   */
  mutable firstName?: string
  /**
   * Last name.
   * @default "Developer"
   */
  mutable lastName?: string
  /**
   * User name. If omitted, the local-part of `email` is used.
   */
  mutable userName?: string
  /**
   * Developer app family.
   */
  mutable appFamily?: string
  /**
   * Access type.
   */
  mutable accessType?: string
  /**
   * Custom attributes (name/value pairs, max 18). Alchemy ownership
   * attributes (`alchemy-stack`, `alchemy-stage`, `alchemy-id`) are merged
   * in automatically.
   */
  mutable attributes?: Record<string, string>
}

export type Developer = Resource<
  "GCP.Apigee.Developer",
  DeveloperProps,
  {
    /** Full resource name `organizations/{org}/developers/{email}`. */
    mutable name: string
    /** Developer email. */
    mutable email: string
    /** Apigee organization id. */
    mutable organization: string
    /** Server-generated developer id. */
    mutable developerId: string | undefined
    /** First name. */
    mutable firstName: string | undefined
    /** Last name. */
    mutable lastName: string | undefined
    /** User name. */
    mutable userName: string | undefined
    /** Developer app family. */
    mutable appFamily: string | undefined
    /** Access type. */
    mutable accessType: string | undefined
    /** User attributes (Alchemy ownership attributes stripped). */
    mutable attributes: Record<string, string>
    /** Status (`active` or `inactive`). */
    mutable status: string | undefined
    /** Associated app names. */
    mutable apps: string[]
    /** Associated company names. */
    mutable companies: string[]
    /** Creation time in milliseconds since epoch. */
    mutable createdAt: string | undefined
    /** Last modification time in milliseconds since epoch. */
    mutable lastModifiedAt: string | undefined
  },
  never,
  Providers
>

/**
 * An Apigee developer that can register apps and obtain API keys.
 *
 * Apigee developers have no labels field, so Alchemy stamps ownership into
 * custom attributes for `list` / nuke. Email is identity — changing `email`
 * replaces the developer. Name, attributes, and access type update in place.
 *
 * ### Creating a Developer
 * **Example:** Generated email
 * ```typescript
 * const developer = yield* GCP.Apigee.Developer("Owner", {
 *   firstName: "Ada",
 *   lastName: "Lovelace",
 * });
 * ```
 *
 * **Example:** Explicit email and attributes
 * ```typescript
 * const developer = yield* GCP.Apigee.Developer("Owner", {
 *   email: "ada@example.com",
 *   firstName: "Ada",
 *   lastName: "Lovelace",
 *   userName: "ada",
 *   attributes: { team: "platform" },
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const Developer = Resource<Developer>("GCP.Apigee.Developer")

// @vibelang-diagnostics-next-line EK4830:off
export class DeveloperNotResolved extends Data.TaggedError("GCP.Apigee.DeveloperNotResolved")<{
  mutable resourceName: string
}> {}

const resourceName = (organization: string, email: string): infer _ => `${orgNameOf(organization)}/developers/${email}`

const toEmail = effect (id: string, email: string | undefined, existing?: string) => {
  if (email !== undefined) return email.toLowerCase()
  if (existing !== undefined) return existing.toLowerCase()
  const generated = try createPhysicalName({
    id,
    maxLength: 48,
    lowercase: true,
  })
  return `${generated}@alchemy.example`
}

const toAttrs = (developer: apigee.GoogleCloudApigeeV1Developer, organization: string): infer _ => {
  const email = (developer.email ?? "").toLowerCase()
  return {
    name: resourceName(organization, email),
    email,
    organization: orgIdOf(organization),
    developerId: developer.developerId,
    firstName: developer.firstName,
    lastName: developer.lastName,
    userName: developer.userName,
    appFamily: developer.appFamily,
    accessType: developer.accessType,
    attributes: userAttributes(attributesToRecord(developer.attributes)),
    status: developer.status,
    apps: developer.apps ?? [],
    companies: developer.companies ?? [],
    createdAt: developer.createdAt,
    lastModifiedAt: developer.lastModifiedAt,
  }
}

const getByName = effect (name: string) =>
  apigee
    .getOrganizationsDevelopers({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
      default: throw e;
    }

export const DeveloperProvider = (): infer _ =>
  Provider.succeed(Developer, {
    stables: ["name", "email", "organization", "developerId", "createdAt"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const previousEmail = olds?.email ?? output?.email
      const previousOrg = olds?.organization ?? output?.organization
      const emailChanged = previousEmail !== undefined
        && news.email !== undefined
        && news.email.toLowerCase() !== previousEmail.toLowerCase()
      const orgChanged = previousOrg !== undefined
        && news.organization !== undefined
        && orgIdOf(news.organization) !== orgIdOf(previousOrg)
      if (emailChanged || orgChanged) {
        return {
          action: "replace" as const,
          deleteFirst: emailChanged && !orgChanged,
        }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = defaultOrgName(env.project, olds?.organization ?? output?.organization)
      const email = try toEmail(id, olds?.email, output?.email)
      const name = output?.name ?? resourceName(organization, email)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, organization)
      return (try ownedBy(id, attributesToRecord(existing.attributes))) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const orgs = try listOrgNames()
      const rows: Developer["Attributes"][] = []
      for (const organization of orgs) {
        const page = apigee
          .listOrganizationsDevelopers({
            parent: organization,
            expand: true,
            count: "1000",
          }) catch effect (e) => match (e) {
            when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: {
              developer: [] as apigee.GoogleCloudApigeeV1Developer[],
            };
            default: throw e;
          }
        for (const developer of page.developer ?? []) {
          const labels = attributesToRecord(developer.attributes)
          if (Object.keys(labels).some((key) => key.startsWith("alchemy-"))) {
            rows.push(toAttrs(developer, organization))
          }
        }
      }
      return rows
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const organization = defaultOrgName(env.project, news.organization)
      const email = try toEmail(id, news.email, output?.email)
      const name = resourceName(organization, email)
      const firstName = news.firstName ?? "Alchemy"
      const lastName = news.lastName ?? "Developer"
      const userName = news.userName ?? lastSegment(email.split("@")[0] ?? email)
      const ownership = try createOwnership(id)
      const attributes = desiredAttributes(news.attributes, ownership)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = apigee
          .createOrganizationsDevelopers({
            parent: organization,
            body: {
              email,
              firstName,
              lastName,
              userName,
              appFamily: news.appFamily,
              accessType: news.accessType,
              attributes: recordToAttributes(attributes),
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new DeveloperNotResolved({ resourceName: name })
      }

      const observed = {
        firstName: current.firstName ?? "",
        lastName: current.lastName ?? "",
        userName: current.userName ?? "",
        appFamily: current.appFamily ?? "",
        accessType: current.accessType ?? "",
        attributes: attributesToRecord(current.attributes),
      }
      const desired = {
        firstName,
        lastName,
        userName,
        appFamily: news.appFamily ?? "",
        accessType: news.accessType ?? "",
        attributes,
      }
      const changed = observed.firstName !== desired.firstName
        || observed.lastName !== desired.lastName
        || observed.userName !== desired.userName
        || observed.appFamily !== desired.appFamily
        || observed.accessType !== desired.accessType
        || !sameRecord(observed.attributes, desired.attributes)

      if (changed) {
        current = try apigee.updateOrganizationsDevelopers({
          name,
          body: {
            email,
            firstName,
            lastName,
            userName,
            appFamily: news.appFamily,
            accessType: news.accessType,
            attributes: recordToAttributes(attributes),
          },
        })
      }

      return toAttrs(current, organization)
    },

    delete: effect ({ output }) => {
      apigee
        .deleteOrganizationsDevelopers({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.void;
          default: throw e;
        }
    },
  })
