import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import { orgIdOf, orgParent } from "./ownership.ts"

const MAX_NAME_LENGTH = 255

export type SitesApicategoryProps = {
  /**
   * Portal site id (the `{site}` segment of
   * `organizations/{org}/sites/{site}`). Required. Immutable — changing
   * it replaces the category.
   */
  siteId: string
  /**
   * Apigee organization id. Defaults to the stack GCP project. Immutable —
   * changing it replaces the category.
   */
  organization?: string
  /**
   * Server-assigned category UUID. Set when adopting an existing category.
   * Immutable — changing it replaces the category.
   */
  categoryId?: string
  /**
   * User-facing category name shown on the portal. If omitted, a unique
   * name is generated from the stack, stage, and logical id.
   */
  name?: string
}

export type SitesApicategory = Resource<
  "GCP.Apigee.SitesApicategory",
  SitesApicategoryProps,
  {
    /** Full resource name `organizations/{org}/sites/{site}/apicategories/{id}`. */
    name: string
    /** Server-assigned category UUID. */
    categoryId: string
    /** Apigee organization id. */
    organization: string
    /** Portal site id. */
    siteId: string
    /** User-facing category name. */
    categoryName: string | undefined
    /** Last-modified time in milliseconds since epoch. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * An API category on an Apigee integrated portal. Catalog items can be
 * tagged with categories so portal users can browse by topic.
 *
 * API categories have no labels field and the name is shown to portal
 * users, so Alchemy finds its category by name: `read` reports a
 * category as owned only when it carries the generated name (an explicit
 * `name` is reported as unowned — adopt it with `--adopt`), and nuke
 * cannot discover categories. `siteId` and `organization` are identity —
 * changing either replaces the category. The display name updates in
 * place.
 *
 * ### Creating an API Category
 * **Example:** Named category
 * ```typescript
 * const category = yield* GCP.Apigee.SitesApicategory("Payments", {
 *   siteId: portal.siteId,
 *   name: "Payments",
 * });
 * ```
 *
 * ### Updating an API Category
 * **Example:** Rename
 * ```typescript
 * const category = yield* GCP.Apigee.SitesApicategory("Payments", {
 *   siteId: portal.siteId,
 *   name: "Billing",
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const SitesApicategory = Resource<SitesApicategory>("GCP.Apigee.SitesApicategory")

// @vibelang-diagnostics-next-line EK4830:off
export class SitesApicategoryNotResolved extends Data.TaggedError(
  "GCP.Apigee.SitesApicategoryNotResolved",
)<{
  resourceName: string
}> {}

const siteParent = (org: string, siteId: string): infer _ => `${orgParent(org)}/sites/${siteId}`

const resourceName = (org: string, siteId: string, categoryId: string): infer _ =>
  `${siteParent(org, siteId)}/apicategories/${categoryId}`

const toDisplayName = effect (id: string, name: string | undefined, existing?: string) => {
  if (name !== undefined) return name
  if (existing !== undefined) return existing
  return try createPhysicalName({
    id,
    maxLength: MAX_NAME_LENGTH,
    lowercase: true,
  })
}

const unwrap = (
  response: apigee.GoogleCloudApigeeV1ApiCategoryResponse | undefined,
): apigee.GoogleCloudApigeeV1ApiCategory | undefined => response?.data

const toAttrs = (category: apigee.GoogleCloudApigeeV1ApiCategory, org: string, siteId: string): infer _ => {
  const categoryId = category.id ?? ""
  return {
    name: categoryId ? resourceName(org, siteId, categoryId) : "",
    categoryId,
    organization: org,
    siteId: category.siteId ?? siteId,
    categoryName: category.name,
    updateTime: category.updateTime,
  }
}

const getByName = effect (name: string) =>
  (effect {
    return (unwrap(try apigee.getOrganizationsSitesApicategories({ name })))
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
    default: throw e;
  }

const listBySite = effect (org: string, siteId: string) =>
  (effect {
    return ((try apigee
      .listOrganizationsSitesApicategories({
        parent: siteParent(org, siteId),
      })).data ?? [])
  }) catch effect (e) => match (e) {
    when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: [];
    default: throw e;
  }

const findByDisplayName = effect (org: string, siteId: string, displayName: string) =>
  (try listBySite(org, siteId)).find((category) => category.name === displayName)

export const SitesApicategoryProvider = (): infer _ =>
  Provider.succeed(SitesApicategory, {
    stables: ["name", "categoryId", "organization", "siteId"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousSite = olds?.siteId ?? output?.siteId
      const siteChanged = previousSite !== undefined && resolved.siteId !== previousSite
      const previousOrg = olds?.organization ?? output?.organization
      const orgChanged = try Effect.orDie(Effect.try({
        try: () =>
          previousOrg !== undefined
          && resolved.organization !== undefined
          && orgIdOf(resolved.organization, previousOrg) !== previousOrg,
        catch: (e) => e,
      }))
      const previousId = olds?.categoryId ?? output?.categoryId
      const idChanged = previousId !== undefined && resolved.categoryId !== undefined
        && resolved.categoryId !== previousId
      if (siteChanged || orgChanged || idChanged) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const org = try Effect.orDie(
        Effect.try({ try: () => orgIdOf(olds?.organization ?? output?.organization, env.project), catch: (e) => e }),
      )
      const siteId = olds?.siteId ?? output?.siteId
      if (siteId === undefined) return undefined
      const categoryId = olds?.categoryId ?? output?.categoryId
      const name = output?.name
        ?? (categoryId !== undefined ? resourceName(org, siteId, categoryId) : undefined)
      const generated = try toDisplayName(id, undefined)
      const displayName = olds?.name ?? output?.categoryName ?? generated
      const existing = name !== undefined
        ? try getByName(name)
        : try findByDisplayName(org, siteId, displayName)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, org, siteId)
      return existing.name === generated
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const org = try Effect.orDie(
        Effect.try({ try: () => orgIdOf(news.organization ?? output?.organization, env.project), catch: (e) => e }),
      )
      const siteId = news.siteId
      const displayName = try toDisplayName(id, news.name, output?.categoryName)
      const desiredName = displayName

      let current = output?.name !== undefined
        ? try getByName(output.name)
        : news.categoryId !== undefined
        ? try getByName(resourceName(org, siteId, news.categoryId))
        : try findByDisplayName(org, siteId, desiredName)

      if (current === undefined) {
        const created = (effect {
          return (unwrap(
            try apigee
              .createOrganizationsSitesApicategories({
                parent: siteParent(org, siteId),
                body: {
                  name: desiredName,
                  siteId,
                },
              }),
          ))
        }) catch effect (e) => match (e) {
          when { _tag: "Conflict" }: try findByDisplayName(org, siteId, desiredName);
          default: throw e;
        }
        current = created ?? undefined
      }

      if (current === undefined || !(current.id ?? "").length) {
        throw new SitesApicategoryNotResolved({
          resourceName: siteParent(org, siteId),
        })
      }

      const resource = resourceName(org, siteId, current.id ?? "")
      if ((current.name ?? "") !== desiredName) {
        const patched = try apigee.patchOrganizationsSitesApicategories({
          name: resource,
          body: {
            name: desiredName,
            siteId,
            id: current.id,
          },
        })
        current = unwrap(patched) ?? current
      }

      return toAttrs(current, org, siteId)
    },

    delete: effect ({ output }) => {
      apigee
        .deleteOrganizationsSitesApicategories({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.void;
          default: throw e;
        }
    },
  })
