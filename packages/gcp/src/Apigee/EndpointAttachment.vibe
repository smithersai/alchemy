import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import { createPhysicalName } from "alchemy/PhysicalName"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  defaultOrgName,
  lastSegment,
  listOrgNames,
  orgIdOf,
  orgNameOf,
  waitForOperation,
} from "./operations.vibe"

const MAX_ID_LENGTH = 32

export type EndpointAttachmentProps = {
  /**
   * Apigee organization id or `organizations/{org}`. Defaults to the
   * current GCP project id. Immutable — changing it replaces the
   * attachment.
   */
  organization?: string
  /**
   * Endpoint attachment id (the `{endpoint_attachment}` segment of
   * `organizations/{org}/endpointAttachments/{endpoint_attachment}`).
   * Must start with a lowercase letter, be 2-32 characters of lowercase
   * letters, numbers, or hyphens, and must not end with a hyphen. If
   * omitted, a unique `alc-` prefixed name is generated so `list` / nuke
   * can find it (the API has no labels or description). Immutable —
   * changing it replaces the attachment.
   */
  endpointAttachmentId?: string
  /**
   * Location of the endpoint attachment. Immutable — changing it replaces
   * the attachment. `US-CENTRAL1` is accepted and normalized to
   * `us-central1`.
   * @default the stack's GCP region (`GCP.Region`, else the profile region, else `us-central1`)
   */
  location?: string
  /**
   * Service attachment in
   * `projects/{project}/regions/{region}/serviceAttachments/{attachment}`.
   * Immutable — changing it replaces the attachment.
   */
  serviceAttachment: string
}

export type EndpointAttachment = Resource<
  "GCP.Apigee.EndpointAttachment",
  EndpointAttachmentProps,
  {
    /** Full resource name `organizations/{org}/endpointAttachments/{id}`. */
    name: string
    /** Endpoint attachment id (last path segment). */
    endpointAttachmentId: string
    /** Apigee organization id. */
    organization: string
    /** Location. */
    location: string
    /** Service attachment resource name. */
    serviceAttachment: string | undefined
    /** Host that can be used as an HTTP target. */
    host: string | undefined
    /** Server-reported state (`CREATING`, `ACTIVE`, …). */
    state: string | undefined
    /** Connection state to the service attachment. */
    connectionState: string | undefined
  },
  never,
  Providers
>

/**
 * An Apigee endpoint attachment for southbound Private Service Connect.
 *
 * The API has no labels or description, so Alchemy prefixes generated ids
 * with `alc-` so `list` / nuke can find them. All properties are identity —
 * changing any of them replaces the attachment.
 *
 * ### Creating an Endpoint Attachment
 * **Example:** Attach a service attachment in us-central1
 * ```typescript
 * const attachment = yield* GCP.Apigee.EndpointAttachment("Backend", {
 *   location: "us-central1",
 *   serviceAttachment:
 *     "projects/my-project/regions/us-central1/serviceAttachments/backend",
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const EndpointAttachment = Resource<EndpointAttachment>("GCP.Apigee.EndpointAttachment")

// @vibelang-diagnostics-next-line EK4830:off
export class EndpointAttachmentNotResolved extends Data.TaggedError(
  "GCP.Apigee.EndpointAttachmentNotResolved",
)<{
  resourceName: string
}> {}

const normalizeLocation = (location: string | undefined, defaultLocation: string): infer _ =>
  (location ?? defaultLocation).toLowerCase()

const toId = effect (id: string, explicit: string | undefined, existing?: string) => {
  if (explicit !== undefined) return explicit
  if (existing !== undefined) return existing
  const generated = try createPhysicalName({
    id,
    maxLength: MAX_ID_LENGTH - 4,
    lowercase: true,
  })
  const body = generated.replace(/-+$/g, "")
  const prefixed = body.startsWith("alc") ? body : `alc-${body}`
  return prefixed.slice(0, MAX_ID_LENGTH).replace(/-+$/g, "") || "alc-a"
}

const resourceName = (organization: string, endpointAttachmentId: string): infer _ =>
  `${orgNameOf(organization)}/endpointAttachments/${endpointAttachmentId}`

const toAttrs = (
  attachment: apigee.GoogleCloudApigeeV1EndpointAttachment,
  organization: string,
  region: string,
): infer _ => {
  const name = attachment.name ?? ""
  return {
    name,
    endpointAttachmentId: lastSegment(name),
    organization: orgIdOf(organization),
    location: attachment.location ?? region,
    serviceAttachment: attachment.serviceAttachment,
    host: attachment.host,
    state: attachment.state,
    connectionState: attachment.connectionState,
  }
}

const getByName = effect (name: string) =>
  apigee
    .getOrganizationsEndpointAttachments({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
      default: throw e;
    }

const isAlchemyId = (endpointAttachmentId: string): infer _ => endpointAttachmentId.startsWith("alc")

export const EndpointAttachmentProvider = (): infer _ =>
  Provider.succeed(EndpointAttachment, {
    stables: ["name", "endpointAttachmentId", "organization", "location", "serviceAttachment"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousId = olds?.endpointAttachmentId ?? output?.endpointAttachmentId
      const previousOrg = olds?.organization ?? output?.organization
      const previousLocation = olds?.location ?? output?.location
      const previousSa = olds?.serviceAttachment ?? output?.serviceAttachment
      const idChanged = previousId !== undefined
        && resolved.endpointAttachmentId !== undefined
        && resolved.endpointAttachmentId !== previousId
      const orgChanged = try Effect.orDie(Effect.try({
        try: () =>
          previousOrg !== undefined
          && resolved.organization !== undefined
          && orgIdOf(resolved.organization) !== orgIdOf(previousOrg),
        catch: (e) => e,
      }))
      const locationChanged = previousLocation !== undefined
        && normalizeLocation(resolved.location ?? previousLocation, env.region)
          !== normalizeLocation(previousLocation, env.region)
      const saChanged = previousSa !== undefined && resolved.serviceAttachment !== previousSa
      if (idChanged || orgChanged || locationChanged || saChanged) {
        return {
          action: "replace" as const,
          deleteFirst: idChanged && !orgChanged,
        }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = try Effect.orDie(
        Effect.try({
          try: () => defaultOrgName(env.project, olds?.organization ?? output?.organization),
          catch: (e) => e,
        }),
      )
      const endpointAttachmentId = try toId(
        id,
        olds?.endpointAttachmentId,
        output?.endpointAttachmentId,
      )
      const name = output?.name ?? resourceName(organization, endpointAttachmentId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, organization, env.region)
      return isAlchemyId(attrs.endpointAttachmentId)
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const orgs = try listOrgNames()
      const rows: EndpointAttachment["Attributes"][] = []
      for (const organization of orgs) {
        const attachments = collectPages(
          apigee.listOrganizationsEndpointAttachments.pages({
            parent: organization,
            pageSize: 1000,
          }),
          (page) => page.endpointAttachments,
        ) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }:
            [] as apigee.GoogleCloudApigeeV1EndpointAttachment[];
          default: throw e;
        }
        for (const attachment of attachments) {
          const attrs = toAttrs(attachment, organization, env.region)
          if (isAlchemyId(attrs.endpointAttachmentId)) {
            rows.push(attrs)
          }
        }
      }
      return rows
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const organization = try Effect.orDie(
        Effect.try({ try: () => defaultOrgName(env.project, news.organization), catch: (e) => e }),
      )
      const endpointAttachmentId = try toId(
        id,
        news.endpointAttachmentId,
        output?.endpointAttachmentId,
      )
      const name = resourceName(organization, endpointAttachmentId)
      const location = normalizeLocation(news.location ?? output?.location, env.region)

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const operation = apigee
          .createOrganizationsEndpointAttachments({
            parent: organization,
            endpointAttachmentId,
            body: {
              location,
              serviceAttachment: news.serviceAttachment,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (operation !== undefined) {
          try waitForOperation(operation)
        }
        current = try getByName(name)
      }

      if (current === undefined) {
        throw new EndpointAttachmentNotResolved({ resourceName: name })
      }

      return toAttrs(current, organization, env.region)
    },

    delete: effect ({ output }) => {
      const operation = apigee
        .deleteOrganizationsEndpointAttachments({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
          default: throw e;
        }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
