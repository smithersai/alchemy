import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  childName,
  collectPages,
  defaultOrgName,
  hasOwnershipMarker,
  lastSegment,
  listOrgNames,
  orgIdOf,
  orgNameOf,
  stringField,
  waitForOperation,
} from "./operations.ts"

export type EnvgroupsAttachmentProps = {
  /**
   * Apigee organization id or `organizations/{org}`. Defaults to the
   * current GCP project id. Immutable — changing it replaces the
   * attachment.
   */
  organization?: string
  /**
   * Parent environment group id or
   * `organizations/{org}/envgroups/{envgroup}`. Immutable — changing it
   * replaces the attachment.
   */
  envgroup: string
  /**
   * Attached environment id (the `{env}` segment of
   * `organizations/{org}/environments/{env}`). Immutable — changing it
   * replaces the attachment.
   */
  environment: string
}

export type EnvgroupsAttachment = Resource<
  "GCP.Apigee.EnvgroupsAttachment",
  EnvgroupsAttachmentProps,
  {
    /** Full resource name `organizations/{org}/envgroups/{envgroup}/attachments/{attachment}`. */
    name: string
    /** Attachment id (last path segment). */
    attachmentId: string
    /** Parent environment group id. */
    envgroup: string
    /** Attached environment id. */
    environment: string
    /** Apigee organization id. */
    organization: string
    /** Server-reported environment group id. */
    environmentGroupId: string | undefined
    /** Creation time in milliseconds since epoch. */
    createdAt: string | undefined
  },
  never,
  Providers
>

/**
 * An attachment of an Apigee environment to an environment group.
 *
 * Existence-only: the identity is the (envgroup, environment) pair. The
 * API has no labels or description, so `list` / nuke returns attachments
 * whose attached environment carries an Alchemy description marker.
 *
 * ### Creating an Environment Group Attachment
 * **Example:** Attach an environment to a group
 * ```typescript
 * const attachment = yield* GCP.Apigee.EnvgroupsAttachment("ProdApi", {
 *   envgroup: group.envgroupId,
 *   environment: environment.environmentId,
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const EnvgroupsAttachment = Resource<EnvgroupsAttachment>("GCP.Apigee.EnvgroupsAttachment")

// @vibelang-diagnostics-next-line EK4830:off
export class EnvgroupsAttachmentNotResolved extends Data.TaggedError(
  "GCP.Apigee.EnvgroupsAttachmentNotResolved",
)<{
  parent: string
  environment: string
}> {}

const envgroupIdOf = (envgroup: string): infer _ => envgroup.includes("/envgroups/") ? lastSegment(envgroup) : envgroup

const environmentIdOf = (environment: string): infer _ =>
  environment.includes("/environments/") ? lastSegment(environment) : environment

const parentOf = (organization: string, envgroup: string): infer _ =>
  childName(orgNameOf(organization), "envgroups", envgroupIdOf(envgroup))

const toAttrs = (
  attachment: apigee.GoogleCloudApigeeV1EnvironmentGroupAttachment,
  organization: string,
  envgroup: string,
): infer _ => {
  const name = attachment.name ?? ""
  return {
    name,
    attachmentId: lastSegment(name),
    envgroup: envgroupIdOf(envgroup),
    environment: attachment.environment ?? "",
    organization: orgIdOf(organization),
    environmentGroupId: attachment.environmentGroupId,
    createdAt: attachment.createdAt,
  }
}

const getByName = effect (name: string) =>
  apigee
    .getOrganizationsEnvgroupsAttachments({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
      default: throw e;
    }

const listAttachments = effect (parent: string) =>
  collectPages(
    apigee.listOrganizationsEnvgroupsAttachments.pages({
      parent,
      pageSize: 1000,
    }),
    (page) => page.environmentGroupAttachments,
  ) catch effect (e) => match (e) {
    when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }:
      [] as apigee.GoogleCloudApigeeV1EnvironmentGroupAttachment[];
    default: throw e;
  }

const findByEnvironment = effect (
  parent: string,
  environment: string,
  organization: string,
  envgroup: string,
) => {
  const attachments = try listAttachments(parent)
  const match = attachments.find((attachment) => attachment.environment === environment)
  return match === undefined ? undefined : toAttrs(match, organization, envgroup)
}

export const EnvgroupsAttachmentProvider = (): infer _ =>
  Provider.succeed(EnvgroupsAttachment, {
    stables: ["name", "attachmentId", "envgroup", "environment", "organization", "createdAt"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousGroup = olds?.envgroup ?? output?.envgroup
      const previousEnv = olds?.environment ?? output?.environment
      const previousOrg = olds?.organization ?? output?.organization
      const groupChanged = previousGroup !== undefined
        && envgroupIdOf(resolved.envgroup) !== envgroupIdOf(previousGroup)
      const envChanged = previousEnv !== undefined
        && environmentIdOf(resolved.environment) !== environmentIdOf(previousEnv)
      const orgChanged = try Effect.orDie(Effect.try({
        try: () =>
          previousOrg !== undefined
          && resolved.organization !== undefined
          && orgIdOf(resolved.organization) !== orgIdOf(previousOrg),
        catch: (e) => e,
      }))
      if (groupChanged || envChanged || orgChanged) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = try Effect.orDie(
        Effect.try({
          try: () => defaultOrgName(env.project, olds?.organization ?? output?.organization),
          catch: (e) => e,
        }),
      )
      const envgroup = olds?.envgroup ?? output?.envgroup
      const environment = olds?.environment ?? output?.environment
      if (envgroup === undefined || environment === undefined) return undefined
      const parent = parentOf(organization, envgroup)
      if (output?.name !== undefined) {
        const existing = try getByName(output.name)
        if (existing !== undefined) {
          return toAttrs(existing, organization, envgroup)
        }
      }
      return try findByEnvironment(parent, environmentIdOf(environment), organization, envgroup)
    },

    list: effect () => {
      const orgs = try listOrgNames()
      const rows: EnvgroupsAttachment["Attributes"][] = []
      for (const organization of orgs) {
        const groups = collectPages(
          apigee.listOrganizationsEnvgroups.pages({
            parent: organization,
            pageSize: 1000,
          }),
          (page) => page.environmentGroups,
        ) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }:
            [] as apigee.GoogleCloudApigeeV1EnvironmentGroup[];
          default: throw e;
        }
        const org = apigee
          .getOrganizations({ name: organization }) catch effect (e) => match (e) {
            when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
            default: throw e;
          }
        const ownedEnvs = new Set<string>()
        for (const environmentId of org?.environments ?? []) {
          const environment = apigee
            .getOrganizationsEnvironments({
              name: `${organization}/environments/${environmentId}`,
            }) catch effect (e) => match (e) {
              when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
              default: throw e;
            }
          if (
            try Effect.orDie(Effect.try({ try: () => hasOwnershipMarker(environment?.description), catch: (e) => e }))
          ) {
            ownedEnvs.add(environmentId)
          }
        }
        for (const group of groups) {
          const envgroupId = try Effect.orDie(
            Effect.try({ try: () => lastSegment(group.name ?? ""), catch: (e) => e }),
          )
          if (envgroupId.length === 0) continue
          const parent = `${organization}/envgroups/${envgroupId}`
          const attachments = try listAttachments(parent)
          for (const attachment of attachments) {
            const environment = attachment.environment ?? ""
            if (ownedEnvs.has(environment)) {
              rows.push(toAttrs(attachment, organization, envgroupId))
            }
          }
        }
      }
      return rows
    },

    reconcile: effect ({ news, output }) => {
      const env = try GcpEnvironment.current
      const organization = try Effect.orDie(
        Effect.try({ try: () => defaultOrgName(env.project, news.organization), catch: (e) => e }),
      )
      const envgroup = envgroupIdOf(news.envgroup)
      const environment = environmentIdOf(news.environment)
      const parent = parentOf(organization, envgroup)

      let current = output?.name !== undefined ? try getByName(output.name) : undefined
      if (current === undefined) {
        const found = try findByEnvironment(parent, environment, organization, envgroup)
        if (found !== undefined) {
          current = try getByName(found.name)
        }
      }

      if (current === undefined) {
        const operation = apigee
          .createOrganizationsEnvgroupsAttachments({
            parent,
            body: { environment },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try Effect.undefined; default: throw e; }
        if (operation !== undefined) {
          const done = try waitForOperation(operation)
          const createdName = try Effect.orDie(
            Effect.try({ try: () => stringField(done.response, "name"), catch: (e) => e }),
          )
          if (createdName !== undefined) {
            current = try getByName(createdName)
          }
        }
        if (current === undefined) {
          const found = try findByEnvironment(parent, environment, organization, envgroup)
          if (found !== undefined) {
            current = try getByName(found.name)
          }
        }
      }

      if (current === undefined) {
        throw new EnvgroupsAttachmentNotResolved({
          parent,
          environment,
        })
      }

      return toAttrs(current, organization, envgroup)
    },

    delete: effect ({ output }) => {
      const operation = apigee
        .deleteOrganizationsEnvgroupsAttachments({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
          default: throw e;
        }
      if (operation !== undefined) {
        try waitForOperation(operation, { notFoundOk: true })
      }
    },
  })
