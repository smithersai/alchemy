import * as apigee from "@distilled.cloud/gcp/apigee_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.vibe"
import type { Providers } from "../Providers.vibe"
import {
  collectPages,
  createOwnership,
  dcCollectorId,
  defaultOrgName,
  encodeDescription,
  hasOwnershipMarker,
  lastSegment,
  listOrgNames,
  orgIdOf,
  orgNameOf,
  ownedBy,
  parseDescription,
} from "./operations.vibe"

export type DataCollectorType = apigee.GoogleCloudApigeeV1DataCollectorTypeEnum | (string & {})

export type DatacollectorProps = {
  /**
   * Apigee organization id or `organizations/{org}`. Defaults to the
   * current GCP project id. Immutable — changing it replaces the collector.
   */
  organization?: string
  /**
   * Data collector id (the `{data_collector}` segment of
   * `organizations/{org}/datacollectors/{data_collector}`). Must begin with
   * `dc_` and contain only letters, numbers, and underscores. If omitted,
   * a unique `dc_` name is generated. Immutable — changing it replaces the
   * collector.
   */
  dataCollectorId?: string
  /**
   * Human-readable description. Alchemy ownership is stored in a
   * `[alchemy …]` prefix and stripped from attributes.
   */
  description?: string
  /**
   * Type of data this collector records. Immutable — changing it replaces
   * the collector.
   * @default "STRING"
   */
  type?: DataCollectorType
}

export type Datacollector = Resource<
  "GCP.Apigee.Datacollector",
  DatacollectorProps,
  {
    /** Full resource name `organizations/{org}/datacollectors/{id}`. */
    name: string
    /** Data collector id (last path segment). */
    dataCollectorId: string
    /** Apigee organization id. */
    organization: string
    /** User description with the Alchemy ownership prefix stripped. */
    description: string | undefined
    /** Collector value type. */
    type: string | undefined
    /** Creation time in milliseconds since epoch. */
    createdAt: string | undefined
    /** Last modification time in milliseconds since epoch. */
    lastModifiedAt: string | undefined
  },
  never,
  Providers
>

/**
 * An Apigee data collector used to capture custom analytics dimensions.
 *
 * Apigee collectors have no labels field, so Alchemy stamps ownership into
 * the description for `list` / nuke. Name and type are identity — changing
 * `dataCollectorId` or `type` replaces the collector. Description updates
 * in place.
 *
 * ### Creating a Data Collector
 * **Example:** Generated `dc_` name
 * ```typescript
 * const collector = yield* GCP.Apigee.Datacollector("Latency", {
 *   type: "INTEGER",
 * });
 * ```
 *
 * **Example:** Explicit id and description
 * ```typescript
 * const collector = yield* GCP.Apigee.Datacollector("Latency", {
 *   dataCollectorId: "dc_proxy_latency",
 *   type: "INTEGER",
 *   description: "proxy latency in milliseconds",
 * });
 * ```
 *
 * @resource
 * @category Apigee
 */
export const Datacollector = Resource<Datacollector>("GCP.Apigee.Datacollector")

// @vibelang-diagnostics-next-line EK4830:off
export class DatacollectorNotResolved extends Data.TaggedError(
  "GCP.Apigee.DatacollectorNotResolved",
)<{
  resourceName: string
}> {}

const DEFAULT_TYPE = "STRING"

const resourceName = (organization: string, dataCollectorId: string): infer _ =>
  `${orgNameOf(organization)}/datacollectors/${dataCollectorId}`

const toAttrs = (collector: apigee.GoogleCloudApigeeV1DataCollector, organization: string): infer _ => {
  const name = collector.name ?? ""
  const parsed = parseDescription(collector.description)
  return {
    name,
    dataCollectorId: lastSegment(name),
    organization: orgIdOf(organization),
    description: parsed.description,
    type: collector.type,
    createdAt: collector.createdAt,
    lastModifiedAt: collector.lastModifiedAt,
  }
}

const getByName = effect (name: string) =>
  apigee
    .getOrganizationsDatacollectors({ name }) catch effect (e) => match (e) {
      when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.undefined;
      default: throw e;
    }

export const DatacollectorProvider = (): infer _ =>
  Provider.succeed(Datacollector, {
    stables: ["name", "dataCollectorId", "organization", "type", "createdAt"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousId = olds?.dataCollectorId ?? output?.dataCollectorId
      const previousOrg = olds?.organization ?? output?.organization
      const previousType = olds?.type ?? output?.type ?? DEFAULT_TYPE
      const nextType = resolved.type ?? DEFAULT_TYPE
      const idChanged = previousId !== undefined
        && resolved.dataCollectorId !== undefined
        && resolved.dataCollectorId !== previousId
      const orgChanged = try Effect.orDie(Effect.try({
        try: () =>
          previousOrg !== undefined
          && resolved.organization !== undefined
          && orgIdOf(resolved.organization) !== orgIdOf(previousOrg),
        catch: (e) => e,
      }))
      const typeChanged = previousType !== nextType
      if (idChanged || orgChanged || typeChanged) {
        const sameName = !idChanged && !orgChanged && (resolved.dataCollectorId ?? previousId) === previousId
        return { action: "replace" as const, deleteFirst: sameName }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const organization = try Effect.orDie(
        Effect.try({
          try: () => defaultOrgName(env.project, olds?.organization ?? output?.organization),
          catch: (e) => e,
        }),
      )
      const dataCollectorId = try dcCollectorId(
        id,
        olds?.dataCollectorId,
        output?.dataCollectorId,
      )
      const name = output?.name ?? resourceName(organization, dataCollectorId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, organization)
      const { labels } = try Effect.orDie(
        Effect.try({ try: () => parseDescription(existing.description), catch: (e) => e }),
      )
      return (try ownedBy(id, labels))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const orgs = try listOrgNames()
      const rows: Datacollector["Attributes"][] = []
      for (const organization of orgs) {
        const collectors = collectPages(
          apigee.listOrganizationsDatacollectors.pages({
            parent: organization,
            pageSize: 1000,
          }),
          (page) => page.dataCollectors,
        ) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }:
            [] as apigee.GoogleCloudApigeeV1DataCollector[];
          default: throw e;
        }
        for (const collector of collectors) {
          if (
            try Effect.orDie(Effect.try({ try: () => hasOwnershipMarker(collector.description), catch: (e) => e }))
          ) {
            rows.push(toAttrs(collector, organization))
          }
        }
      }
      return rows
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const organization = try Effect.orDie(
        Effect.try({ try: () => defaultOrgName(env.project, news.organization), catch: (e) => e }),
      )
      const dataCollectorId = try dcCollectorId(
        id,
        news.dataCollectorId,
        output?.dataCollectorId,
      )
      const name = resourceName(organization, dataCollectorId)
      const type = news.type ?? DEFAULT_TYPE
      const ownership = try createOwnership(id)
      const desiredDescription = try Effect.orDie(
        Effect.try({ try: () => encodeDescription(ownership, news.description), catch: (e) => e }),
      )

      let current = try getByName(output?.name ?? name)

      if (current === undefined) {
        const created = apigee
          .createOrganizationsDatacollectors({
            parent: organization,
            dataCollectorId,
            body: {
              name: dataCollectorId,
              description: desiredDescription,
              type,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new DatacollectorNotResolved({ resourceName: name })
      }

      if ((current.description ?? "") !== desiredDescription) {
        current = try apigee.patchOrganizationsDatacollectors({
          name,
          updateMask: "description",
          body: { description: desiredDescription },
        })
      }

      return toAttrs(current, organization)
    },

    delete: effect ({ output }) => {
      apigee
        .deleteOrganizationsDatacollectors({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" } or { _tag: "ApigeeResourceNotFound" }: try Effect.void;
          default: throw e;
        }
    },
  })
