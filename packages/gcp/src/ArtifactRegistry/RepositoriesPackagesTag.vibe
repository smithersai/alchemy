import * as artifactregistry from "@distilled.cloud/gcp/artifactregistry_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  ResourceNotResolved,
  expandRepository,
  hasAlchemyLabelMap,
  lastSegment,
  listAlchemyRepositories,
  listChildResources,
  listPackages,
  listTags,
  locationFromRepository,
  missingGet,
  normalizeLocation,
  parseName,
  replaceOnIdentity,
  sameText,
  toPhysicalId,
} from "./internal.ts"

export type RepositoriesPackagesTagProps = {
  /**
   * Parent repository. Full name
   * `projects/{project}/locations/{location}/repositories/{repository}`
   * or the repository id (combined with `location`). Immutable —
   * changing it replaces the tag.
   */
  repository: string
  /**
   * Package that owns the tag. Full name
   * `.../repositories/{repository}/packages/{package}` or the package
   * id. Immutable — changing it replaces the tag.
   */
  packageId: string
  /**
   * Region used when `repository` is a bare id.
   * @default the repository's location, else the stack's GCP region (`GCP.Region`, profile region, `us-central1`)
   */
  location?: string
  /**
   * Tag id (the `{tag}` segment of `.../packages/{package}/tags/{tag}`).
   * If omitted, a unique name is generated. Allowed characters:
   * `[a-zA-Z0-9-._~:@]`. Immutable — changing it replaces the tag.
   */
  tagId?: string
  /**
   * Version this tag points at. Full name
   * `.../packages/{package}/versions/{version}` or the version id.
   */
  version: string
}

export type RepositoriesPackagesTag = Resource<
  "GCP.ArtifactRegistry.RepositoriesPackagesTag",
  RepositoriesPackagesTagProps,
  {
    /** Full resource name `projects/{project}/locations/{location}/repositories/{repository}/packages/{package}/tags/{tag}`. */
    name: string
    /** Tag id (last path segment). */
    tagId: string
    /** Parent package resource name. */
    package: string
    /** Package id (last path segment). */
    packageId: string
    /** Parent repository resource name. */
    repository: string
    /** Project id. */
    project: string
    /** Location id (`us-central1`). */
    location: string
    /** Version resource name this tag currently points at. */
    version: string | undefined
  },
  never,
  Providers
>

/**
 * An Artifact Registry package tag — an alternate name for a version.
 *
 * Tags have no labels field. `list` / nuke find tags whose parent
 * repository carries Alchemy labels. Changing `repository`, `packageId`,
 * `location`, or `tagId` replaces the tag. `version` updates in place.
 *
 * The package and version must already exist (for example a Docker
 * image digest). Generic repositories reject tag create with HTTP 501.
 *
 * ### Creating a RepositoriesPackagesTag
 * **Example:** Point `stable` at a version
 * ```typescript
 * const tag = yield* GCP.ArtifactRegistry.RepositoriesPackagesTag("Stable", {
 *   repository: images.name,
 *   packageId: "app",
 *   tagId: "stable",
 *   version: "sha256:abc123",
 * });
 * ```
 *
 * **Example:** Move the tag to a new version
 * ```typescript
 * const tag = yield* GCP.ArtifactRegistry.RepositoriesPackagesTag("Stable", {
 *   repository: images.name,
 *   packageId: "app",
 *   tagId: "stable",
 *   version: "sha256:def456",
 * });
 * ```
 *
 * @resource
 * @category ArtifactRegistry
 */
export const RepositoriesPackagesTag = Resource<RepositoriesPackagesTag>(
  "GCP.ArtifactRegistry.RepositoriesPackagesTag",
)

const expandPackage = (repository: string, packageId: string): infer _ => {
  const next = packageId.replace(/\/+$/, "")
  if (next.includes("/packages/")) return next
  return `${repository}/packages/${next}`
}

const expandVersion = (packageName: string, version: string): infer _ => {
  const next = version.replace(/\/+$/, "")
  if (next.includes("/versions/")) return next
  return `${packageName}/versions/${next}`
}

const resourceNameOf = (packageName: string, tagId: string): infer _ => `${packageName}/tags/${tagId}`

const toAttrs = (tag: artifactregistry.Tag, project: string, region: string): infer _ => {
  const name = tag.name ?? ""
  const parsed = parseName(name, "tags", region)
  const pkg = parsed.parent
  return {
    name,
    tagId: parsed.id,
    package: pkg,
    packageId: lastSegment(pkg),
    repository: parseName(pkg, "packages", region).parent,
    project: parsed.project || project,
    location: parsed.location,
    version: tag.version,
  }
}

const getByName = missingGet(artifactregistry.getProjectsLocationsRepositoriesPackagesTags)

const getRepository = missingGet(artifactregistry.getProjectsLocationsRepositories)

export const RepositoriesPackagesTagProvider = (): infer _ =>
  Provider.succeed(RepositoriesPackagesTag, {
    stables: ["name", "tagId", "package", "packageId", "repository", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const env = try GcpEnvironment.current
      const previousId = olds?.tagId ?? output?.tagId
      const nextId = resolved.tagId ?? previousId
      const previousLocation = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location, env.region), catch: (e) => e }),
      )
      const nextLocation = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            resolved.location ?? locationFromRepository(resolved.repository, previousLocation),
            env.region,
          ),
        catch: (e) => e,
      }))
      const previousPackage = try Effect.orDie(
        Effect.try({ try: () => lastSegment(olds?.packageId ?? output?.packageId ?? ""), catch: (e) => e }),
      )
      const nextPackage = try Effect.orDie(Effect.try({ try: () => lastSegment(resolved.packageId), catch: (e) => e }))
      return try Effect.orDie(Effect.try({
        try: () =>
          replaceOnIdentity({
            previousId,
            nextId,
            previousLocation,
            nextLocation,
            previousParent: previousPackage,
            nextParent: nextPackage,
            extra: lastSegment(olds?.repository ?? output?.repository ?? "")
                !== lastSegment(resolved.repository) && (olds?.repository ?? output?.repository) !== undefined,
          }),
        catch: (e) => e,
      }))
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            olds?.location
              ?? output?.location
              ?? locationFromRepository(olds?.repository ?? output?.repository, env.region),
            env.region,
          ),
        catch: (e) => e,
      }))
      const repository = try Effect.orDie(Effect.try({
        try: () =>
          expandRepository(
            olds?.repository ?? output?.repository ?? "",
            env.project,
            location,
          ),
        catch: (e) => e,
      }))
      const packageName = expandPackage(repository, olds?.packageId ?? output?.packageId ?? "")
      const tagId = try toPhysicalId(id, olds?.tagId, output?.tagId, "tag")
      const name = output?.name ?? resourceNameOf(packageName, tagId)
      const existing = try getByName(name)
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, env.region)
      const repo = try getRepository(attrs.repository)
      return (try Effect.orDie(Effect.try({ try: () => hasAlchemyLabelMap(repo?.labels), catch: (e) => e })))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const repos = try listAlchemyRepositories(env.project)
      const packages = try listChildResources(repos, listPackages)
      const tags = try listChildResources(packages, listTags)
      return tags.map((tag) => toAttrs(tag, env.project, env.region))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(Effect.try({
        try: () =>
          normalizeLocation(
            news.location ?? output?.location ?? locationFromRepository(news.repository, env.region),
            env.region,
          ),
        catch: (e) => e,
      }))
      const repository = try Effect.orDie(
        Effect.try({ try: () => expandRepository(news.repository, env.project, location), catch: (e) => e }),
      )
      const packageName = expandPackage(repository, news.packageId)
      const tagId = try toPhysicalId(id, news.tagId, output?.tagId, "tag")
      const name = resourceNameOf(packageName, tagId)
      const version = expandVersion(packageName, news.version)

      let current = try getByName(name)

      if (current === undefined) {
        const created = artifactregistry
          .createProjectsLocationsRepositoriesPackagesTags({
            parent: packageName,
            tagId,
            body: {
              version,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try getByName(name); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new ResourceNotResolved({ resourceName: name })
      }

      const observed = current.name ?? name
      if (!sameText(current.version, version)) {
        current = try artifactregistry.patchProjectsLocationsRepositoriesPackagesTags({
          name: observed,
          updateMask: "version",
          body: {
            name: observed,
            version,
          },
        })
      }

      return toAttrs(current, env.project, env.region)
    },

    delete: effect ({ output }) => {
      artifactregistry
        .deleteProjectsLocationsRepositoriesPackagesTags({
          name: output.name,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
    },
  })
