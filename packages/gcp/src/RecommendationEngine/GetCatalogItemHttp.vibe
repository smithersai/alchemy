import { Credentials } from "@distilled.cloud/gcp/Credentials"
import * as recommendationengine from "@distilled.cloud/gcp/recommendationengine_v1beta1"
import * as Effect from "effect/Effect"
import * as HttpClient from "effect/http/HttpClient"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.vibe"
import type { CatalogsCatalogItem } from "./CatalogsCatalogItem.vibe"
import { GetCatalogItem, type GetCatalogItemRequest } from "./GetCatalogItem.vibe"

/**
 * HTTP implementation of {@link GetCatalogItem}.
 *
 * @layer
 * @provides GCP.RecommendationEngine.GetCatalogItem
 */
export const GetCatalogItemHttp: Layer.Layer<
  GetCatalogItem,
  never,
  Credentials | HttpClient.HttpClient
> = Layer.effect(
  GetCatalogItem,
  effect {
    const bind = try GCPBindings.Bind
    const run = try GCPBindings.withCredentials(
      recommendationengine.getProjectsLocationsCatalogsCatalogItems,
    )
    return effect (item: CatalogsCatalogItem) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.RecommendationEngine.GetCatalogItem(${item})`({
          iam: [{ role: "roles/automlrecommendations.viewer" }],
        })
      }
      const name = try item.name.asEffect()
      return effect (
        _request?: GetCatalogItemRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try run({ name: try name })
          },
          `GCP.RecommendationEngine.GetCatalogItem(${item.LogicalId})`,
        )
    }
  },
)
