import * as oslogin from "@distilled.cloud/gcp/oslogin_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  DEFAULT_USER,
  findKeyByText,
  fingerprintOf,
  getSshPublicKey,
  ignoreMissing,
  resourceName,
  retryConflict,
  sameText,
  toUserId,
  toUserParent,
} from "./internal.vibe"

export type UsersSshPublicKeyProps = {
  /**
   * Google account that owns the key. Email, `"me"`, or
   * `users/{user}`. `"me"` only works for user credentials; with a
   * service account, pass its email (`users/me` fails with
   * `UserCredentialMismatch`). Immutable — changing it replaces the key.
   * @default "me"
   */
  user?: string
  /**
   * Public key text in SSH format (RFC4253). The fingerprint covers the
   * whole text (comment included), so any change replaces the key.
   */
  key: string
  /**
   * Expiration time in microseconds since epoch. Omit for no expiry.
   */
  expirationTimeUsec?: string
}

export type UsersSshPublicKey = Resource<
  "GCP.OSLogin.UsersSshPublicKey",
  UsersSshPublicKeyProps,
  {
    /** Canonical name `users/{user}/sshPublicKeys/{fingerprint}`. */
    name: string
    /** User id used when the key was reconciled (`me` or email). */
    user: string
    /** SHA-256 fingerprint of the SSH public key. */
    fingerprint: string
    /** SSH public key text. */
    key: string
    /** Expiration time in microseconds since epoch, if set. */
    expirationTimeUsec: string | undefined
    /** Project id used when the key was reconciled. */
    project: string
  },
  never,
  Providers
>

/**
 * An OS Login SSH public key on a Google account.
 *
 * SSH public keys have no labels field, so Alchemy tracks a key by the
 * name in state; without state an identical key on the account is
 * reported as unowned. `user` and the key text are identity — changing
 * either replaces the key. Expiration updates in place. `"me"` works for
 * user credentials; service accounts must pass their email as `user`.
 *
 * ### Creating a Key
 * **Example:** Current user
 * ```typescript
 * const sshKey = yield* GCP.OSLogin.UsersSshPublicKey("Laptop", {
 *   key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... laptop",
 * });
 * ```
 *
 * **Example:** With expiration
 * ```typescript
 * const sshKey = yield* GCP.OSLogin.UsersSshPublicKey("Laptop", {
 *   user: "me",
 *   key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... laptop",
 *   expirationTimeUsec: "4102444800000000",
 * });
 * ```
 *
 * **Example:** Key for a service account
 * ```typescript
 * const sshKey = yield* GCP.OSLogin.UsersSshPublicKey("Deploy", {
 *   user: "deployer@my-project.iam.gserviceaccount.com",
 *   key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... deploy",
 * });
 * ```
 *
 * ### Updating a Key
 * Change props on the same logical id; the engine keeps the physical id.
 *
 * **Example:** Extend expiration
 * ```typescript
 * const sshKey = yield* GCP.OSLogin.UsersSshPublicKey("Laptop", {
 *   key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... laptop",
 *   expirationTimeUsec: "4133980800000000",
 * });
 * ```
 *
 * @resource
 * @category OSLogin
 */
export const UsersSshPublicKey = Resource<UsersSshPublicKey>("GCP.OSLogin.UsersSshPublicKey")

// @vibelang-diagnostics-next-line EK4830:off
export class UsersSshPublicKeyNotResolved extends Data.TaggedError(
  "GCP.OSLogin.UsersSshPublicKeyNotResolved",
)<{
  resourceName: string
}> {}

const toAttrs = (key: oslogin.SshPublicKey, user: string, project: string): infer _ => {
  const name = key.name ?? ""
  return {
    name,
    user,
    fingerprint: key.fingerprint ?? fingerprintOf(name),
    key: key.key ?? "",
    expirationTimeUsec: key.expirationTimeUsec,
    project,
  }
}

export const UsersSshPublicKeyProvider = (): infer _ =>
  Provider.succeed(UsersSshPublicKey, {
    stables: ["name", "user", "fingerprint", "project"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousUser = olds?.user ?? output?.user ?? DEFAULT_USER
      const nextUser = try Effect.orDie(
        Effect.try({ try: () => toUserId(resolved.user, resolved.user), catch: (e) => e }),
      )
      const oldUser = try Effect.orDie(
        Effect.try({ try: () => toUserId(previousUser, previousUser), catch: (e) => e }),
      )
      if (
        resolved.user !== undefined
        && nextUser !== oldUser
        && nextUser !== DEFAULT_USER
        && oldUser !== DEFAULT_USER
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousKey = olds?.key ?? output?.key
      if (
        previousKey !== undefined
        && resolved.key !== undefined
        && !(try Effect.orDie(
          Effect.try({ try: () => sameText(resolved.key.trim(), previousKey.trim()), catch: (e) => e }),
        ))
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ olds, output }) => {
      const env = try GcpEnvironment.current
      const user = try Effect.orDie(Effect.try({ try: () => toUserId(olds?.user, output?.user), catch: (e) => e }))
      const byName = try getSshPublicKey(
        output?.name ?? (output?.fingerprint
          ? try Effect.orDie(Effect.try({ try: () => resourceName(user, output.fingerprint), catch: (e) => e }))
          : ""),
      )
      if (byName !== undefined) return toAttrs(byName, user, env.project)
      if (olds === undefined) return undefined
      // No labels: an identical key without state may belong to anyone.
      const found = try findKeyByText(user, olds.key, env.project)
      return found === undefined
        ? undefined
        : (try Effect.orDie(Effect.try({ try: () => Unowned(toAttrs(found, user, env.project)), catch: (e) => e })))
    },

    reconcile: effect ({ news, output }) => {
      const env = try GcpEnvironment.current
      const user = try Effect.orDie(Effect.try({ try: () => toUserId(news.user, output?.user), catch: (e) => e }))
      const desiredKey = news.key.trim()

      let current = try getSshPublicKey(output?.name ?? "")
      if (current === undefined) {
        current = try findKeyByText(user, desiredKey, env.project)
      }

      if (current === undefined) {
        const created = retryConflict(
          oslogin.createUsersSshPublicKeys({
            parent: (try Effect.orDie(Effect.try({ try: toUserParent.bind(undefined, user), catch: (e) => e }))),
            body: {
              key: desiredKey,
              expirationTimeUsec: news.expirationTimeUsec,
            },
          }),
        ) catch effect (e) => match (e) {
          when { _tag: "Conflict" }: try findKeyByText(user, desiredKey, env.project);
          default: throw e;
        }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new UsersSshPublicKeyNotResolved({
          resourceName: output?.name
            ?? (try Effect.orDie(
              Effect.try({ try: () => resourceName(user, output?.fingerprint ?? ""), catch: (e) => e }),
            )),
        })
      }

      const name = current.name ?? resourceName(user, current.fingerprint ?? output?.fingerprint ?? "")
      // The fingerprint covers the full key text, so `key` is never patched.
      const expirationChanged = (current.expirationTimeUsec ?? "") !== (news.expirationTimeUsec ?? "")

      if (expirationChanged) {
        current = try retryConflict(
          oslogin.patchUsersSshPublicKeys({
            name,
            updateMask: "expirationTimeUsec",
            body: {
              expirationTimeUsec: news.expirationTimeUsec,
            },
          }),
        )
      }

      return toAttrs(current, user, env.project)
    },

    delete: effect ({ output }) => {
      const name = output.name
        || (output.fingerprint
          ? try Effect.orDie(
            Effect.try({ try: () => resourceName(output.user || DEFAULT_USER, output.fingerprint), catch: (e) => e }),
          )
          : "")
      if (name.length === 0) return
      try (oslogin.deleteUsersSshPublicKeys({ name })
        |> retryConflict(%)
        |> ignoreMissing(%))
    },
  })
