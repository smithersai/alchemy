import * as apikeys from "@distilled.cloud/gcp/apikeys_v2"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as GCPBindings from "../GCPBindings.ts"
import { GetKeyString } from "./GetKeyString.vibe"
import type { Key } from "./Key.ts"

/**
 * HTTP implementation of {@link GetKeyString}.
 *
 * @layer
 * @provides GCP.ApiKeys.GetKeyString
 */
export const GetKeyStringHttp = Layer.effect(
  GetKeyString,
  effect {
    const bind = try GCPBindings.Bind;
    const getKeyStringProjectsLocationsKeys = try GCPBindings.withCredentials(
      apikeys.getKeyStringProjectsLocationsKeys,
    );
    return effect <K extends Key>(key: K) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        try bind`GCP.ApiKeys.GetKeyString(${key})`({
          // API keys have no resource-level IAM.
          iam: [{ role: "roles/serviceusage.apiKeysViewer" }],
        });
      }
      const name = try key.name.asEffect();
      return effect () => try withSpan(effect {
        return try getKeyStringProjectsLocationsKeys({
          name: try name,
        });
      }, `GCP.ApiKeys.GetKeyString(${key.LogicalId})`);
    };
  },
);
