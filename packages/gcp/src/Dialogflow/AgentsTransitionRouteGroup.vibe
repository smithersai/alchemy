import * as dialogflow from "@distilled.cloud/gcp/dialogflow_v3"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  collectionParent,
  DEFAULT_LOCATION,
  encodeOwnershipLine,
  expandAgent,
  fingerprint,
  hasOwnershipMarker,
  internalLabels,
  lastSegment,
  locationOf,
  MAX_ROUTE_GROUP_DISPLAY_NAME_LENGTH,
  namedAgents,
  normalizeLocation,
  ownedByAlchemy,
  parentOf,
  parseOwnership,
  projectOf,
  sameText,
  toResourceId,
  updateMaskOf,
  retryQuota,
} from "./internal.ts"

type TransitionRoute = {
  /** Intent that triggers this route. */
  intent?: string
  /** Condition expression. At least one of `intent` or `condition` is required. */
  condition?: string
  /** Target flow resource name. */
  targetFlow?: string
  /** Target page resource name. */
  targetPage?: string
  /** Description of the route (max 500 characters). */
  description?: string
  /** Fulfillment run when the route matches. */
  triggerFulfillment?: {
    messages?: Array<{
      text?: { text?: string[]; allowPlaybackInterruption?: boolean }
    }>
    tag?: string
  }
}

export type AgentsTransitionRouteGroupProps = {
  /**
   * Parent agent resource name
   * `projects/{project}/locations/{location}/agents/{agent}` or a bare
   * agent id (combined with `location`). Immutable — changing it
   * replaces the route group.
   */
  agent: string
  /**
   * Transition route group id (the `{transitionRouteGroup}` segment).
   * Server-assigned on create. Immutable — changing it replaces the
   * group.
   */
  transitionRouteGroupId?: string
  /**
   * Location used when `agent` is a bare id.
   * @default "global"
   */
  location?: string
  /**
   * Human-readable name, unique within the agent (max 30 characters
   * including Alchemy's ownership marker). Route groups have no labels
   * field, so ownership is stored in a compact `[alc …]` prefix and
   * stripped from attributes.
   */
  displayName?: string
  /** Transition routes in the group. */
  transitionRoutes?: TransitionRoute[]
  /** Language code of the route group. */
  languageCode?: string
}

export type AgentsTransitionRouteGroup = Resource<
  "GCP.Dialogflow.AgentsTransitionRouteGroup",
  AgentsTransitionRouteGroupProps,
  {
    /** Full resource name `.../agents/{agent}/transitionRouteGroups/{id}`. */
    name: string
    /** Route group id (last path segment). */
    transitionRouteGroupId: string
    /** Parent agent resource name. */
    agent: string
    /** Project id. */
    project: string
    /** Location id. */
    location: string
    /** User display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** Transition routes. */
    transitionRoutes: TransitionRoute[]
  },
  never,
  Providers
>

/**
 * A Dialogflow CX agent-level transition route group.
 *
 * Agent-level groups are shared across flows. Route groups have no labels
 * field, so Alchemy stamps ownership into `displayName` (30-character
 * limit; compact `[alc …]` marker) for `list` / nuke. Parent agent and id
 * are immutable. Display name and routes update in place.
 *
 * ### Creating a Route Group
 * **Example:** Fallback routes
 * ```typescript
 * const group = yield* GCP.Dialogflow.AgentsTransitionRouteGroup("Fallback", {
 *   agent: agent.name,
 *   displayName: "fb",
 *   transitionRoutes: [
 *     {
 *       condition: "true",
 *       triggerFulfillment: {
 *         messages: [{ text: { text: ["I did not get that."] } }],
 *       },
 *     },
 *   ],
 * });
 * ```
 *
 * ### Updating a Route Group
 * Change props on the same logical id; the engine keeps the physical id.
 *
 * **Example:** Rename
 * ```typescript
 * const group = yield* GCP.Dialogflow.AgentsTransitionRouteGroup("Fallback", {
 *   agent: agent.name,
 *   displayName: "g2",
 *   transitionRoutes: [
 *     {
 *       condition: "true",
 *       triggerFulfillment: {
 *         messages: [{ text: { text: ["Sorry."] } }],
 *       },
 *     },
 *   ],
 * });
 * ```
 *
 * @resource
 * @category Dialogflow
 */
export const AgentsTransitionRouteGroup = Resource<AgentsTransitionRouteGroup>(
  "GCP.Dialogflow.AgentsTransitionRouteGroup",
)

// @vibelang-diagnostics-next-line EK4830:off
export class AgentsTransitionRouteGroupNotResolved extends Data.TaggedError(
  "GCP.Dialogflow.AgentsTransitionRouteGroupNotResolved",
)<{
  resourceName: string
}> {}

const resourceName = (agent: string, transitionRouteGroupId: string): infer _ =>
  `${agent}/transitionRouteGroups/${transitionRouteGroupId}`

const routesOf = (
  list: readonly dialogflow.GoogleCloudDialogflowCxV3TransitionRoute[] | undefined,
): TransitionRoute[] =>
  (list ?? []).map((route) => ({
    intent: route.intent,
    condition: route.condition,
    targetFlow: route.targetFlow,
    targetPage: route.targetPage,
    description: route.description,
    triggerFulfillment: route.triggerFulfillment
      ? {
        messages: route.triggerFulfillment.messages?.map((message) => ({
          text: message.text
            ? {
              text: [...(message.text.text ?? [])],
              allowPlaybackInterruption: message.text.allowPlaybackInterruption,
            }
            : undefined,
        })),
        tag: route.triggerFulfillment.tag,
      }
      : undefined,
  }))

const toAttrs = (
  group: dialogflow.GoogleCloudDialogflowCxV3TransitionRouteGroup,
  project: string,
  agentHint?: string,
): infer _ => {
  const name = group.name ?? ""
  return {
    name,
    transitionRouteGroupId: lastSegment(name),
    agent: name.includes("/transitionRouteGroups/")
      ? collectionParent(name, "agents")
      : (agentHint ?? parentOf(name)),
    project: projectOf(name) || project,
    location: locationOf(name),
    displayName: parseOwnership(group.displayName).text,
    transitionRoutes: routesOf(group.transitionRoutes),
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dialogflow
  .getProjectsLocationsAgentsTransitionRouteGroups({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string) =>
  (effect {
    return (Array.from(
      try (dialogflow.listProjectsLocationsAgentsTransitionRouteGroups.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.transitionRouteGroups ?? []))
        |> Stream.filter(%, (group) => hasOwnershipMarker(group.displayName))
        |> Stream.map(%, (group) => toAttrs(group, project, parent))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const findByDisplayName = effect (parent: string, displayName: string) =>
  (effect {
    return (try effect {
      const option = try (dialogflow.listProjectsLocationsAgentsTransitionRouteGroups.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.transitionRouteGroups ?? []))
        |> Stream.filter(%, (group) => group.displayName === displayName)
        |> Stream.runHead(%))
      return (option._tag === "Some" ? option.value : undefined)
    })
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }

export const AgentsTransitionRouteGroupProvider = (): infer _ =>
  Provider.succeed(AgentsTransitionRouteGroup, {
    stables: ["name", "transitionRouteGroupId", "agent", "project", "location"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousAgent = olds?.agent ?? output?.agent
      if (previousAgent !== undefined && resolved.agent !== previousAgent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.transitionRouteGroupId ?? output?.transitionRouteGroupId
      if (
        previousId !== undefined
        && resolved.transitionRouteGroupId !== undefined
        && resolved.transitionRouteGroupId !== previousId
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousLocation = olds?.location ?? output?.location
      if (
        try Effect.orDie(Effect.try({
          try: () =>
            previousLocation !== undefined
            && resolved.location !== undefined
            && normalizeLocation(previousLocation) !== normalizeLocation(resolved.location),
          catch: (e) => e,
        }))
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location), catch: (e) => e }),
      )
      const agent = olds?.agent
        ? try Effect.orDie(Effect.try({ try: () => expandAgent(olds.agent, env.project, location), catch: (e) => e }))
        : output?.agent
      const transitionRouteGroupId = try toResourceId(
        id,
        olds?.transitionRouteGroupId,
        output?.transitionRouteGroupId,
      )
      const name = output?.name ?? (agent !== undefined ? resourceName(agent, transitionRouteGroupId) : "")
      let existing = try getByName(name)
      if (existing === undefined && agent !== undefined) {
        const ownership = try internalLabels(id)
        existing = try findByDisplayName(
          agent,
          try Effect.orDie(
            Effect.try({
              try: () => encodeOwnershipLine(ownership, olds?.displayName, MAX_ROUTE_GROUP_DISPLAY_NAME_LENGTH),
              catch: (e) => e,
            }),
          ),
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, agent)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const agents = try namedAgents(env.project)
      const pages = try Effect.forEach(agents, effect (agent) => try listAt(agent.name, env.project), {
        concurrency: 4,
      })
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) =>
      try (effect {
        const env = try GcpEnvironment.current
        const location = try Effect.orDie(
          Effect.try({
            try: () => normalizeLocation(news.location ?? output?.location ?? DEFAULT_LOCATION),
            catch: (e) => e,
          }),
        )
        const agent = try Effect.orDie(
          Effect.try({ try: () => expandAgent(news.agent, env.project, location), catch: (e) => e }),
        )
        const transitionRouteGroupId = try toResourceId(
          id,
          news.transitionRouteGroupId,
          output?.transitionRouteGroupId,
        )
        const name = output?.name ?? resourceName(agent, transitionRouteGroupId)
        const ownership = try internalLabels(id)
        const displayName = try Effect.orDie(Effect.try({
          try: () =>
            encodeOwnershipLine(
              ownership,
              news.displayName,
              MAX_ROUTE_GROUP_DISPLAY_NAME_LENGTH,
            ),
          catch: (e) => e,
        }))
        const body: dialogflow.GoogleCloudDialogflowCxV3TransitionRouteGroup = {
          displayName,
          transitionRoutes: news.transitionRoutes,
        }

        let current = try getByName(output?.name ?? name)
        if (current === undefined) {
          current = try findByDisplayName(agent, displayName)
        }

        if (current === undefined) {
          const created = dialogflow
            .createProjectsLocationsAgentsTransitionRouteGroups({
              parent: agent,
              languageCode: news.languageCode,
              body,
            }) catch effect (e) => match (e) {
              when { _tag: "Conflict" }: try findByDisplayName(agent, displayName);
              default: throw e;
            }
          current = created ?? undefined
        }

        if (current === undefined) {
          throw new AgentsTransitionRouteGroupNotResolved({ resourceName: name })
        }

        const currentName = current.name ?? name
        const displayChanged = !sameText(current.displayName, displayName)
        const value = routesOf(current.transitionRoutes)
        const routesChanged = (try Effect.orDie(Effect.try({
          try: () => fingerprint(value),
          catch: (e) => e,
        }))) !== (try Effect.orDie(Effect.try({ try: () => fingerprint(news.transitionRoutes), catch: (e) => e })))

        if (displayChanged || routesChanged) {
          current = try dialogflow.patchProjectsLocationsAgentsTransitionRouteGroups({
            name: currentName,
            languageCode: news.languageCode,
            updateMask: try Effect.orDie(Effect.try({
              try: () =>
                updateMaskOf(
                  displayChanged ? "display_name" : undefined,
                  routesChanged ? "transition_routes" : undefined,
                ),
              catch: (e) => e,
            })),
            body: { ...body, name: currentName },
          })
        }

        return toAttrs(current, env.project, agent)
      }
        |> retryQuota(%)),

    delete: effect ({ output }) =>
      try (effect {
        dialogflow
          .deleteProjectsLocationsAgentsTransitionRouteGroups({
            name: output.name,
            force: true,
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      }
        |> retryQuota(%)),
  })
