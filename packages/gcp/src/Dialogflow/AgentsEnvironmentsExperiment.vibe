import * as dialogflow from "@distilled.cloud/gcp/dialogflow_v3"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  encodeOwnership,
  listAgents,
  listEnvironments,
  listExperiments,
  ownedByAlchemy,
  ownershipLabels,
  ownershipText,
  parseOwnership,
  parseResourceName,
  sameJson,
  sameText,
  updateMaskOf,
  retryQuota,
} from "./internal.ts"

export type ExperimentVariant = {
  /** Flow version resource name. */
  mutable version: string
  /** Traffic fraction in `[0, 1]`. */
  mutable trafficAllocation?: number
  /** Whether this variant is the control group. */
  mutable isControlGroup?: boolean
}

export type ExperimentDefinition = {
  /** Condition selecting sessions that enter the experiment. */
  mutable condition?: string
  /** Version variants and traffic split. */
  mutable versionVariants?: {
    mutable variants?: ExperimentVariant[]
  }
}

export type AgentsEnvironmentsExperimentProps = {
  /**
   * Parent environment resource name
   * `projects/{project}/locations/{location}/agents/{agent}/environments/{environment}`.
   * Immutable — changing it replaces the experiment.
   */
  mutable environment: string
  /**
   * Experiment id. Server-assigned on create. Immutable — changing it
   * replaces the experiment.
   */
  mutable experimentId?: string
  /** Human-readable name, unique within the environment. */
  mutable displayName?: string
  /**
   * Description. Experiments have no labels field, so Alchemy stamps
   * ownership into this field for `list` / nuke.
   */
  mutable description?: string
  /** Experiment definition (condition and version variants). */
  mutable definition?: ExperimentDefinition
  /** Experiment duration (e.g. `"86400s"`). */
  mutable experimentLength?: string
}

export type AgentsEnvironmentsExperiment = Resource<
  "GCP.Dialogflow.AgentsEnvironmentsExperiment",
  AgentsEnvironmentsExperimentProps,
  {
    /** Full resource name. */
    mutable name: string
    /** Experiment id (last path segment). */
    mutable experimentId: string
    /** Parent environment resource name. */
    mutable environment: string
    /** Project id. */
    mutable project: string
    /** Location id. */
    mutable location: string
    /** Display name. */
    mutable displayName: string | undefined
    /** User description with the Alchemy ownership prefix stripped. */
    mutable description: string | undefined
    /** Experiment definition. */
    mutable definition: ExperimentDefinition | undefined
    /** Experiment duration. */
    mutable experimentLength: string | undefined
    /** Experiment state. */
    mutable state: string | undefined
    /** RFC3339 creation timestamp. */
    mutable createTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Dialogflow CX experiment under an environment.
 *
 * Experiments have no labels field, so Alchemy stamps ownership into
 * `description` for `list` / nuke. Parent environment and experiment id
 * are immutable. Display name, description, definition, and length
 * update in place.
 *
 * ### Creating an Experiment
 * **Example:** A/B test two flow versions
 * ```typescript
 * const experiment = yield* GCP.Dialogflow.AgentsEnvironmentsExperiment(
 *   "Ab",
 *   {
 *     environment: environment.name,
 *     displayName: "checkout-ab",
 *     definition: {
 *       versionVariants: {
 *         variants: [
 *           {
 *             version: control.name,
 *             trafficAllocation: 0.5,
 *             isControlGroup: true,
 *           },
 *           { version: treatment.name, trafficAllocation: 0.5 },
 *         ],
 *       },
 *     },
 *   },
 * );
 * ```
 *
 * @resource
 * @category Dialogflow
 */
export const AgentsEnvironmentsExperiment = Resource<AgentsEnvironmentsExperiment>(
  "GCP.Dialogflow.AgentsEnvironmentsExperiment",
)

// @vibelang-diagnostics-next-line EK4830:off
export class AgentsEnvironmentsExperimentNotResolved extends Data.TaggedError(
  "GCP.Dialogflow.AgentsEnvironmentsExperimentNotResolved",
)<{
  mutable resourceName: string
}> {}

const definitionOf = (
  definition: dialogflow.GoogleCloudDialogflowCxV3ExperimentDefinition | undefined,
): ExperimentDefinition | undefined => {
  if (definition === undefined) return undefined
  return {
    condition: definition.condition,
    versionVariants: definition.versionVariants
      ? {
        variants: (definition.versionVariants.variants ?? []).map((variant) => ({
          version: variant.version ?? "",
          trafficAllocation: variant.trafficAllocation,
          isControlGroup: variant.isControlGroup,
        })),
      }
      : undefined,
  }
}

const toAttrs = (experiment: dialogflow.GoogleCloudDialogflowCxV3Experiment, project: string): infer _ => {
  const name = experiment.name ?? ""
  const parsed = parseResourceName(name, "experiments")
  return {
    name,
    experimentId: parsed.id,
    environment: parsed.environment || parsed.parent,
    project: parsed.project || project,
    location: parsed.location,
    displayName: experiment.displayName,
    description: parseOwnership(experiment.description).text,
    definition: definitionOf(experiment.definition),
    experimentLength: experiment.experimentLength,
    state: experiment.state,
    createTime: experiment.createTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dialogflow
  .getProjectsLocationsAgentsEnvironmentsExperiments({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const findOwned = effect (id: string, environment: string, hinted?: string) => {
  if (hinted !== undefined && hinted.length > 0) {
    const existing = try getByName(hinted)
    if (existing !== undefined) return existing
  }
  const experiments = try listExperiments(environment)
  for (const experiment of experiments) {
    if (try ownedByAlchemy(id, ownershipText(experiment))) {
      return experiment
    }
  }
  return undefined as dialogflow.GoogleCloudDialogflowCxV3Experiment | undefined
}

const listOwned = effect (project: string) => {
  const agents = try listAgents(project)
  const environments = (try Effect.forEach(
    agents,
    effect (agent) => (agent.name ? try listEnvironments(agent.name) : []),
    { concurrency: 4 },
  )).flat()
  const experiments = (try Effect.forEach(
    environments,
    effect (environment) => (environment.name ? try listExperiments(environment.name) : []),
    { concurrency: 4 },
  )).flat()
  return experiments
    .filter(
      (experiment) =>
        parseOwnership(experiment.description).labels["alchemy-id"] !== undefined
        || parseOwnership(experiment.displayName).labels["alchemy-id"] !== undefined,
    )
    .map((experiment) => toAttrs(experiment, project))
}

export const AgentsEnvironmentsExperimentProvider = (): infer _ =>
  Provider.succeed(AgentsEnvironmentsExperiment, {
    stables: ["name", "experimentId", "environment", "project", "location", "createTime"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const previousParent = olds?.environment ?? output?.environment
      const previousId = olds?.experimentId ?? output?.experimentId
      if (
        (previousParent !== undefined && news.environment !== previousParent)
        || (previousId !== undefined
          && news.experimentId !== undefined
          && news.experimentId !== previousId)
      ) {
        return {
          action: "replace" as const,
          deleteFirst: previousParent === news.environment
            && previousId !== undefined
            && news.experimentId === previousId,
        }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const environment = olds?.environment ?? output?.environment
      const existing = output?.name !== undefined
        ? try getByName(output.name)
        : environment !== undefined
        ? try findOwned(id, environment)
        : undefined
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project)
      return (try ownedByAlchemy(id, ownershipText(existing))) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      return try listOwned(env.project)
    },

    reconcile: effect ({ id, news, output }) =>
      try (effect {
        const env = try GcpEnvironment.current
        const environment = news.environment
        const ownership = try ownershipLabels(id)
        const description = encodeOwnership(ownership, news.description)
        const displayName = news.displayName ?? "experiment"
        const body: dialogflow.GoogleCloudDialogflowCxV3Experiment = {
          displayName,
          description,
          definition: news.definition,
          experimentLength: news.experimentLength,
        }

        let current = try findOwned(id, environment, output?.name)

        if (current === undefined) {
          const created = dialogflow
            .createProjectsLocationsAgentsEnvironmentsExperiments({
              parent: environment,
              body,
            }) catch effect (e) => match (e) {
              when { _tag: "Conflict" }: try findOwned(id, environment, output?.name);
              default: throw e;
            }
          current = created ?? undefined
        }

        if (current === undefined) {
          throw new AgentsEnvironmentsExperimentNotResolved({
            resourceName: output?.name ?? `${environment}/experiments/${news.experimentId ?? "unknown"}`,
          })
        }

        const currentName = current.name ?? output?.name ?? ""
        const displayChanged = !sameText(current.displayName, displayName)
        const descriptionChanged = !sameText(current.description, description)
        const definitionChanged = !sameJson(definitionOf(current.definition), news.definition)
        const lengthChanged = !sameText(current.experimentLength, news.experimentLength)

        if (displayChanged || descriptionChanged || definitionChanged || lengthChanged) {
          current = try dialogflow.patchProjectsLocationsAgentsEnvironmentsExperiments({
            name: currentName,
            updateMask: updateMaskOf(
              displayChanged ? "display_name" : undefined,
              descriptionChanged ? "description" : undefined,
              definitionChanged ? "definition" : undefined,
              lengthChanged ? "experiment_length" : undefined,
            ),
            body: { ...body, name: currentName },
          })
        }

        return toAttrs(current, env.project)
      }
        |> retryQuota(%)),

    delete: effect ({ output }) =>
      try (effect {
        dialogflow
          .deleteProjectsLocationsAgentsEnvironmentsExperiments({
            name: output.name,
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      }
        |> retryQuota(%)),
  })
