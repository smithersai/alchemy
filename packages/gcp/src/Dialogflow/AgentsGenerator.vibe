import * as dialogflow from "@distilled.cloud/gcp/dialogflow_v3"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.vibe"
import {
  collectionParent,
  DEFAULT_LOCATION,
  encodeOwnershipLine,
  expandAgent,
  fingerprint,
  hasOwnershipMarker,
  internalLabels,
  lastSegment,
  locationOf,
  namedAgents,
  normalizeLocation,
  ownedByAlchemy,
  parentOf,
  parseOwnership,
  projectOf,
  sameText,
  toResourceId,
  updateMaskOf,
  retryQuota,
} from "./internal.ts"

export type GeneratorModelParameter = {
  /** Sampling temperature. */
  temperature?: number
  /** Maximum decode steps. */
  maxDecodeSteps?: number
  /** Top-K sampling. */
  topK?: number
  /** Top-P (nucleus) sampling. */
  topP?: number
}

export type GeneratorPlaceholder = {
  /** Placeholder id referenced from the prompt. */
  id?: string
  /** Human-readable placeholder name. */
  name?: string
}

export type GeneratorLlmModelSettings = {
  /** LLM model id. */
  model?: string
  /** Model prompt text. */
  promptText?: string
}

export type AgentsGeneratorProps = {
  /**
   * Parent agent resource name
   * `projects/{project}/locations/{location}/agents/{agent}`.
   * Immutable — changing it replaces the generator.
   */
  agent: string
  /**
   * Generator id (the `{generator}` segment). Server-assigned when
   * omitted. Immutable — changing it replaces the generator.
   */
  generatorId?: string
  /**
   * Location used when `agent` is an id rather than a resource name.
   * Immutable — changing it replaces the generator.
   * @default "global"
   */
  location?: string
  /**
   * Human-readable name. Generators have no labels field, so Alchemy
   * stamps ownership into this field and strips it from attributes.
   */
  displayName?: string
  /**
   * Prompt phrase the generator fills in.
   * @default "Say hello."
   */
  promptText?: string
  /** Language code for the prompt (`en`, `en-US`, …). */
  languageCode?: string
  /** Decoding parameters. */
  modelParameter?: GeneratorModelParameter
  /** Placeholders referenced from `promptText`. */
  placeholders?: GeneratorPlaceholder[]
  /** LLM model settings. */
  llmModelSettings?: GeneratorLlmModelSettings
}

export type AgentsGenerator = Resource<
  "GCP.Dialogflow.AgentsGenerator",
  AgentsGeneratorProps,
  {
    /** Full resource name `.../agents/{agent}/generators/{generator}`. */
    name: string
    /** Generator id (last path segment). */
    generatorId: string
    /** Parent agent resource name. */
    agent: string
    /** Location id. */
    location: string
    /** Project id. */
    project: string
    /** User display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** Prompt text. */
    promptText: string | undefined
    /** Decoding parameters. */
    modelParameter: GeneratorModelParameter | undefined
    /** Placeholders. */
    placeholders: GeneratorPlaceholder[] | undefined
    /** LLM model settings. */
    llmModelSettings: GeneratorLlmModelSettings | undefined
  },
  never,
  Providers
>

/**
 * A Dialogflow CX generator that produces LLM-backed response text.
 *
 * Generators have no labels field — Alchemy stamps ownership into
 * `displayName` so `list` / nuke can find them. Parent agent and id are
 * immutable. Display name, prompt, model parameters, placeholders, and
 * LLM settings update in place.
 *
 * ### Creating a Generator
 * **Example:** Prompt generator
 * ```typescript
 * const generator = yield* GCP.Dialogflow.AgentsGenerator("Greeting", {
 *   agent: agentName,
 *   displayName: "greeting",
 *   promptText: "Greet the user by name.",
 * });
 * ```
 *
 * ### Updating a Generator
 * Change props on the same logical id; the engine keeps the physical id.
 *
 * **Example:** Change the prompt
 * ```typescript
 * const generator = yield* GCP.Dialogflow.AgentsGenerator("Greeting", {
 *   agent: agentName,
 *   displayName: "greeting",
 *   promptText: "Greet the user warmly.",
 * });
 * ```
 *
 * @resource
 * @category Dialogflow
 */
export const AgentsGenerator = Resource<AgentsGenerator>("GCP.Dialogflow.AgentsGenerator")

// @vibelang-diagnostics-next-line EK4830:off
export class AgentsGeneratorNotResolved extends Data.TaggedError(
  "GCP.Dialogflow.AgentsGeneratorNotResolved",
)<{
  resourceName: string
}> {}

const DEFAULT_PROMPT = "Say hello."

const resourceName = (agent: string, generatorId: string): infer _ => `${agent}/generators/${generatorId}`

const modelParameterOf = (
  parameter: dialogflow.GoogleCloudDialogflowCxV3GeneratorModelParameter | undefined,
): GeneratorModelParameter | undefined => {
  if (parameter === undefined) return undefined
  return {
    temperature: parameter.temperature,
    maxDecodeSteps: parameter.maxDecodeSteps,
    topK: parameter.topK,
    topP: parameter.topP,
  }
}

const placeholdersOf = (
  placeholders: dialogflow.GoogleCloudDialogflowCxV3GeneratorPlaceholderList | undefined,
): GeneratorPlaceholder[] | undefined => {
  if (placeholders === undefined) return undefined
  return placeholders.map((placeholder) => ({
    id: placeholder.id,
    name: placeholder.name,
  }))
}

const llmSettingsOf = (
  settings: dialogflow.GoogleCloudDialogflowCxV3LlmModelSettings | undefined,
): GeneratorLlmModelSettings | undefined => {
  if (settings === undefined) return undefined
  return { model: settings.model, promptText: settings.promptText }
}

const toAttrs = (
  generator: dialogflow.GoogleCloudDialogflowCxV3Generator,
  project: string,
  agentHint?: string,
): infer _ => {
  const name = generator.name ?? ""
  const parsed = parseOwnership(generator.displayName)
  return {
    name,
    generatorId: lastSegment(name),
    agent: name.includes("/generators/")
      ? collectionParent(name, "agents")
      : (agentHint ?? parentOf(name)),
    location: locationOf(name),
    project: projectOf(name) || project,
    displayName: parsed.text,
    promptText: generator.promptText?.text,
    modelParameter: modelParameterOf(generator.modelParameter),
    placeholders: placeholdersOf(generator.placeholders),
    llmModelSettings: llmSettingsOf(generator.llmModelSettings),
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dialogflow
  .getProjectsLocationsAgentsGenerators({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string) =>
  (effect {
    return (Array.from(
      try (dialogflow.listProjectsLocationsAgentsGenerators.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.generators ?? []))
        |> Stream.filter(%, (generator) => hasOwnershipMarker(generator.displayName))
        |> Stream.map(%, (generator) => toAttrs(generator, project, parent))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const findByDisplayName = effect (parent: string, displayName: string) =>
  (effect {
    return (try effect {
      const option = try (dialogflow.listProjectsLocationsAgentsGenerators.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.generators ?? []))
        |> Stream.filter(%, (generator) => generator.displayName === displayName)
        |> Stream.runHead(%))
      return (option._tag === "Some" ? option.value : undefined)
    })
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }

export const AgentsGeneratorProvider = (): infer _ =>
  Provider.succeed(AgentsGenerator, {
    stables: ["name", "generatorId", "agent", "location", "project"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previousAgent = olds?.agent ?? output?.agent
      if (previousAgent !== undefined && resolved.agent !== previousAgent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.generatorId ?? output?.generatorId
      if (
        previousId !== undefined
        && resolved.generatorId !== undefined
        && resolved.generatorId !== previousId
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousLocation = olds?.location ?? output?.location
      if (
        try Effect.orDie(Effect.try({
          try: () =>
            previousLocation !== undefined
            && resolved.location !== undefined
            && normalizeLocation(previousLocation) !== normalizeLocation(resolved.location),
          catch: (e) => e,
        }))
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const location = try Effect.orDie(
        Effect.try({ try: () => normalizeLocation(olds?.location ?? output?.location), catch: (e) => e }),
      )
      const agent = olds?.agent
        ? try Effect.orDie(Effect.try({ try: () => expandAgent(olds.agent, env.project, location), catch: (e) => e }))
        : output?.agent
      const generatorId = try toResourceId(id, olds?.generatorId, output?.generatorId)
      const name = output?.name ?? (agent !== undefined ? resourceName(agent, generatorId) : "")
      let existing = try getByName(name)
      if (existing === undefined && agent !== undefined) {
        const ownership = try internalLabels(id)
        existing = try findByDisplayName(
          agent,
          try Effect.orDie(
            Effect.try({ try: () => encodeOwnershipLine(ownership, olds?.displayName), catch: (e) => e }),
          ),
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, agent)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const agents = try namedAgents(env.project)
      const pages = try Effect.forEach(agents, effect (agent) => try listAt(agent.name, env.project), {
        concurrency: 4,
      })
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) =>
      try (effect {
        const env = try GcpEnvironment.current
        const location = try Effect.orDie(
          Effect.try({
            try: () => normalizeLocation(news.location ?? output?.location ?? DEFAULT_LOCATION),
            catch: (e) => e,
          }),
        )
        const agent = try Effect.orDie(
          Effect.try({ try: () => expandAgent(news.agent, env.project, location), catch: (e) => e }),
        )
        const generatorId = try toResourceId(id, news.generatorId, output?.generatorId)
        const name = output?.name ?? resourceName(agent, generatorId)
        const ownership = try internalLabels(id)
        const displayName = try Effect.orDie(
          Effect.try({ try: () => encodeOwnershipLine(ownership, news.displayName), catch: (e) => e }),
        )
        const promptText = news.promptText ?? DEFAULT_PROMPT
        const body: dialogflow.GoogleCloudDialogflowCxV3Generator = {
          displayName,
          promptText: { text: promptText },
          modelParameter: news.modelParameter,
          placeholders: news.placeholders,
          llmModelSettings: news.llmModelSettings,
        }

        let current = try getByName(output?.name ?? name)
        if (current === undefined) {
          current = try findByDisplayName(agent, displayName)
        }

        if (current === undefined) {
          const created = dialogflow
            .createProjectsLocationsAgentsGenerators({
              parent: agent,
              languageCode: news.languageCode,
              body,
            }) catch effect (e) => match (e) {
              when { _tag: "Conflict" }: try findByDisplayName(agent, displayName);
              default: throw e;
            }
          current = created ?? undefined
        }

        if (current === undefined) {
          throw new AgentsGeneratorNotResolved({ resourceName: name })
        }

        const currentName = current.name ?? name
        const displayChanged = (current.displayName ?? "") !== displayName
        const promptChanged = !sameText(current.promptText?.text, promptText)
        const value = modelParameterOf(current.modelParameter)
        const modelChanged = (try Effect.orDie(Effect.try({
          try: () => fingerprint(value),
          catch: (e) => e,
        }))) !== (try Effect.orDie(Effect.try({ try: () => fingerprint(news.modelParameter), catch: (e) => e })))
        const value2 = placeholdersOf(current.placeholders)
        const placeholdersChanged = (try Effect.orDie(Effect.try({
          try: () => fingerprint(value2),
          catch: (e) => e,
        }))) !== (try Effect.orDie(Effect.try({ try: () => fingerprint(news.placeholders), catch: (e) => e })))
        const value3 = llmSettingsOf(current.llmModelSettings)
        const llmChanged = (try Effect.orDie(Effect.try({
          try: () => fingerprint(value3),
          catch: (e) => e,
        }))) !== (try Effect.orDie(Effect.try({ try: () => fingerprint(news.llmModelSettings), catch: (e) => e })))

        if (displayChanged || promptChanged || modelChanged || placeholdersChanged || llmChanged) {
          current = try dialogflow.patchProjectsLocationsAgentsGenerators({
            name: currentName,
            languageCode: news.languageCode,
            updateMask: try Effect.orDie(Effect.try({
              try: () =>
                updateMaskOf(
                  displayChanged ? "display_name" : undefined,
                  promptChanged ? "prompt_text" : undefined,
                  modelChanged ? "model_parameter" : undefined,
                  placeholdersChanged ? "placeholders" : undefined,
                  llmChanged ? "llm_model_settings" : undefined,
                ),
              catch: (e) => e,
            })),
            body: { ...body, name: currentName },
          })
        }

        return toAttrs(current, env.project, agent)
      }
        |> retryQuota(%)),

    delete: effect ({ output }) =>
      try (effect {
        dialogflow
          .deleteProjectsLocationsAgentsGenerators({
            name: output.name,
            force: true,
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      }
        |> retryQuota(%)),
  })
