import * as dialogflow from "@distilled.cloud/gcp/dialogflow_v3"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  collectionParent,
  encodeOwnership,
  hasOwnershipMarker,
  internalLabels,
  lastSegment,
  locationOf,
  namedAgents,
  ownedByAlchemy,
  parentOf,
  parseOwnership,
  projectOf,
  toResourceId,
  retryQuota,
} from "./internal.ts"

export type AgentsPlaybooksVersionProps = {
  /**
   * Parent playbook resource name
   * `projects/{project}/locations/{location}/agents/{agent}/playbooks/{playbook}`.
   * Immutable — changing it replaces the version.
   */
  mutable playbook: string
  /**
   * Version id (the `{version}` segment). Server-assigned when omitted.
   * Immutable — changing it replaces the version.
   */
  mutable versionId?: string
  /**
   * Snapshot description. Playbook versions have no labels field, so
   * Alchemy stamps ownership into this field and strips it from
   * attributes. Versions are immutable snapshots — changing the
   * description after create is a no-op.
   */
  mutable description?: string
}

export type AgentsPlaybooksVersion = Resource<
  "GCP.Dialogflow.AgentsPlaybooksVersion",
  AgentsPlaybooksVersionProps,
  {
    /** Full resource name `.../playbooks/{playbook}/versions/{version}`. */
    mutable name: string
    /** Version id (last path segment). */
    mutable versionId: string
    /** Parent playbook resource name. */
    mutable playbook: string
    /** Location id. */
    mutable location: string
    /** Project id. */
    mutable project: string
    /** User description with the Alchemy ownership prefix stripped. */
    mutable description: string | undefined
    /** RFC3339 snapshot timestamp. */
    mutable updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Dialogflow CX playbook version (immutable snapshot of a playbook).
 *
 * Versions have no labels field and no update RPC — Alchemy stamps
 * ownership into `description` so `list` / nuke can find them. Reconcile
 * is observe-ensure: if the snapshot is missing it is created; later
 * description edits are ignored.
 *
 * ### Creating a Playbook Version
 * **Example:** Snapshot
 * ```typescript
 * const version = yield* GCP.Dialogflow.AgentsPlaybooksVersion("v1", {
 *   playbook: playbook.name,
 *   description: "initial",
 * });
 * ```
 *
 * @resource
 * @category Dialogflow
 */
export const AgentsPlaybooksVersion = Resource<AgentsPlaybooksVersion>(
  "GCP.Dialogflow.AgentsPlaybooksVersion",
)

// @vibelang-diagnostics-next-line EK4830:off
export class AgentsPlaybooksVersionNotResolved extends Data.TaggedError(
  "GCP.Dialogflow.AgentsPlaybooksVersionNotResolved",
)<{
  mutable resourceName: string
}> {}

const resourceName = (playbook: string, versionId: string): infer _ => `${playbook}/versions/${versionId}`

const toAttrs = (
  version: dialogflow.GoogleCloudDialogflowCxV3PlaybookVersion,
  project: string,
  playbookHint?: string,
): infer _ => {
  const name = version.name ?? ""
  return {
    name,
    versionId: lastSegment(name),
    playbook: name.includes("/versions/")
      ? collectionParent(name, "playbooks")
      : (playbookHint ?? parentOf(name)),
    location: locationOf(name),
    project: projectOf(name) || project,
    description: parseOwnership(version.description).text,
    updateTime: version.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dialogflow
  .getProjectsLocationsAgentsPlaybooksVersions({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string) =>
  (Array.from(
    try (dialogflow.listProjectsLocationsAgentsPlaybooksVersions.pages({ parent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.playbookVersions ?? []))
      |> Stream.filter(%, (version) => hasOwnershipMarker(version.description))
      |> Stream.map(%, (version) => toAttrs(version, project, parent))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const listPlaybooks = effect (agent: string) =>
  (Array.from(
    try (dialogflow.listProjectsLocationsAgentsPlaybooks.pages({ parent: agent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.playbooks ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const findByDescription = effect (parent: string, description: string) =>
  (try effect {
    const option = try (dialogflow.listProjectsLocationsAgentsPlaybooksVersions.pages({ parent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.playbookVersions ?? []))
      |> Stream.filter(%, (version) => version.description === description)
      |> Stream.runHead(%))
    return (option._tag === "Some" ? option.value : undefined)
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }

export const AgentsPlaybooksVersionProvider = (): infer _ =>
  Provider.succeed(AgentsPlaybooksVersion, {
    stables: ["name", "versionId", "playbook", "location", "project", "updateTime"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const previousParent = olds?.playbook ?? output?.playbook
      if (previousParent !== undefined && news.playbook !== previousParent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.versionId ?? output?.versionId
      if (
        previousId !== undefined
        && news.versionId !== undefined
        && news.versionId !== previousId
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const playbook = olds?.playbook ?? output?.playbook
      const name =
        // Version ids are assigned by the server, so only a recorded name can
        // be fetched directly (a guessed id is rejected as malformed).
        output?.name ?? ""
      let existing = try getByName(name)
      if (existing === undefined && playbook !== undefined) {
        const ownership = try internalLabels(id)
        existing = try findByDescription(
          playbook,
          encodeOwnership(ownership, olds?.description),
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, playbook)
      return (try ownedByAlchemy(id, existing.description)) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const agents = try namedAgents(env.project)
      const pages = try Effect.forEach(
        agents,
        effect (agent) => {
          const playbooks = try listPlaybooks(agent.name)
          const versions = try Effect.forEach(
            playbooks,
            effect (playbook) => (playbook.name ? try listAt(playbook.name, env.project) : []),
            { concurrency: 4 },
          )
          return versions.flat()
        },
        { concurrency: 2 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) =>
      try (effect {
        const env = try GcpEnvironment.current
        const playbook = news.playbook
        const versionId = try toResourceId(id, news.versionId, output?.versionId)
        const name = output?.name ?? resourceName(playbook, versionId)
        const ownership = try internalLabels(id)
        const description = encodeOwnership(ownership, news.description)

        let current = try getByName(output?.name ?? "")
        if (current === undefined) {
          current = try findByDescription(playbook, description)
        }

        if (current === undefined) {
          const created = dialogflow
            .createProjectsLocationsAgentsPlaybooksVersions({
              parent: playbook,
              body: { description },
            }) catch effect (e) => match (e) {
              when { _tag: "Conflict" }: try findByDescription(playbook, description);
              default: throw e;
            }
          current = created ?? undefined
        }

        if (current === undefined) {
          throw new AgentsPlaybooksVersionNotResolved({ resourceName: name })
        }

        return toAttrs(current, env.project, playbook)
      }
        |> retryQuota(%)),

    delete: effect ({ output }) =>
      try (effect {
        dialogflow
          .deleteProjectsLocationsAgentsPlaybooksVersions({
            name: output.name,
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      }
        |> retryQuota(%)),
  })
