import * as dialogflow from "@distilled.cloud/gcp/dialogflow_v3"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import type { Providers } from "../Providers.ts"
import {
  collectionParent,
  encodeOwnershipLine,
  hasOwnershipMarker,
  internalLabels,
  lastSegment,
  locationOf,
  namedAgents,
  ownedByAlchemy,
  parentOf,
  parseOwnership,
  projectOf,
  toResourceId,
  retryQuota,
} from "./internal.ts"

export type AgentsToolsVersionProps = {
  /**
   * Parent tool resource name
   * `projects/{project}/locations/{location}/agents/{agent}/tools/{tool}`.
   * Immutable — changing it replaces the version.
   */
  mutable tool: string
  /**
   * Version id (the `{version}` segment). Server-assigned when omitted.
   * Immutable — changing it replaces the version.
   */
  mutable versionId?: string
  /**
   * Human-readable name. Tool versions have no labels field, so Alchemy
   * stamps ownership into this field. Versions are immutable snapshots —
   * changing the display name after create is a no-op.
   */
  mutable displayName?: string
}

export type AgentsToolsVersion = Resource<
  "GCP.Dialogflow.AgentsToolsVersion",
  AgentsToolsVersionProps,
  {
    /** Full resource name `.../tools/{tool}/versions/{version}`. */
    mutable name: string
    /** Version id (last path segment). */
    mutable versionId: string
    /** Parent tool resource name. */
    mutable tool: string
    /** Location id. */
    mutable location: string
    /** Project id. */
    mutable project: string
    /** User display name with the Alchemy ownership prefix stripped. */
    mutable displayName: string | undefined
    /** RFC3339 create timestamp. */
    mutable createTime: string | undefined
    /** RFC3339 update timestamp. */
    mutable updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A Dialogflow CX tool version (immutable snapshot of a tool).
 *
 * Versions have no labels field and no update RPC — Alchemy stamps
 * ownership into `displayName` so `list` / nuke can find them. Reconcile
 * is observe-ensure: if the snapshot is missing it is created; later
 * display-name edits are ignored.
 *
 * ### Creating a Tool Version
 * **Example:** Snapshot
 * ```typescript
 * const version = yield* GCP.Dialogflow.AgentsToolsVersion("v1", {
 *   tool: tool.name,
 *   displayName: "initial",
 * });
 * ```
 *
 * @resource
 * @category Dialogflow
 */
export const AgentsToolsVersion = Resource<AgentsToolsVersion>("GCP.Dialogflow.AgentsToolsVersion")

// @vibelang-diagnostics-next-line EK4830:off
export class AgentsToolsVersionNotResolved extends Data.TaggedError(
  "GCP.Dialogflow.AgentsToolsVersionNotResolved",
)<{
  mutable resourceName: string
}> {}

const resourceName = (tool: string, versionId: string): infer _ => `${tool}/versions/${versionId}`

const toAttrs = (
  version: dialogflow.GoogleCloudDialogflowCxV3ToolVersion,
  project: string,
  toolHint?: string,
): infer _ => {
  const name = version.name ?? ""
  return {
    name,
    versionId: lastSegment(name),
    tool: name.includes("/versions/")
      ? collectionParent(name, "tools")
      : (toolHint ?? parentOf(name)),
    location: locationOf(name),
    project: projectOf(name) || project,
    displayName: parseOwnership(version.displayName).text,
    createTime: version.createTime,
    updateTime: version.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : dialogflow
  .getProjectsLocationsAgentsToolsVersions({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string, project: string) =>
  (Array.from(
    try (dialogflow.listProjectsLocationsAgentsToolsVersions.pages({ parent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.toolVersions ?? []))
      |> Stream.filter(%, (version) => hasOwnershipMarker(version.displayName))
      |> Stream.map(%, (version) => toAttrs(version, project, parent))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const listTools = effect (agent: string) =>
  (Array.from(
    try (dialogflow.listProjectsLocationsAgentsTools.pages({ parent: agent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.tools ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const findByDisplayName = effect (parent: string, displayName: string) =>
  (try effect {
    const option = try (dialogflow.listProjectsLocationsAgentsToolsVersions.pages({ parent, pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.toolVersions ?? []))
      |> Stream.filter(%, (version) => version.displayName === displayName)
      |> Stream.runHead(%))
    return (option._tag === "Some" ? option.value : undefined)
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; }

export const AgentsToolsVersionProvider = (): infer _ =>
  Provider.succeed(AgentsToolsVersion, {
    stables: ["name", "versionId", "tool", "location", "project", "createTime"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const previousParent = olds?.tool ?? output?.tool
      if (previousParent !== undefined && news.tool !== previousParent) {
        return { action: "replace" as const, deleteFirst: false }
      }
      const previousId = olds?.versionId ?? output?.versionId
      if (
        previousId !== undefined
        && news.versionId !== undefined
        && news.versionId !== previousId
      ) {
        return { action: "replace" as const, deleteFirst: false }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const tool = olds?.tool ?? output?.tool
      const name =
        // Version ids are assigned by the server, so only a recorded name can
        // be fetched directly (a guessed id is rejected as malformed).
        output?.name ?? ""
      let existing = try getByName(name)
      if (existing === undefined && tool !== undefined) {
        const ownership = try internalLabels(id)
        existing = try findByDisplayName(
          tool,
          encodeOwnershipLine(ownership, olds?.displayName),
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, env.project, tool)
      return (try ownedByAlchemy(id, existing.displayName)) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const agents = try namedAgents(env.project)
      const pages = try Effect.forEach(
        agents,
        effect (agent) => {
          const tools = try listTools(agent.name)
          const versions = try Effect.forEach(
            tools,
            effect (tool) => (tool.name ? try listAt(tool.name, env.project) : []),
            { concurrency: 4 },
          )
          return versions.flat()
        },
        { concurrency: 2 },
      )
      return pages.flat()
    },

    reconcile: effect ({ id, news, output }) =>
      try (effect {
        const env = try GcpEnvironment.current
        const tool = news.tool
        const versionId = try toResourceId(id, news.versionId, output?.versionId)
        const name = output?.name ?? resourceName(tool, versionId)
        const ownership = try internalLabels(id)
        const displayName = encodeOwnershipLine(ownership, news.displayName)

        let current = try getByName(output?.name ?? "")
        if (current === undefined) {
          current = try findByDisplayName(tool, displayName)
        }

        if (current === undefined) {
          const created = dialogflow
            .createProjectsLocationsAgentsToolsVersions({
              parent: tool,
              body: { displayName },
            }) catch effect (e) => match (e) {
              when { _tag: "Conflict" }: try findByDisplayName(tool, displayName);
              default: throw e;
            }
          current = created ?? undefined
        }

        if (current === undefined) {
          throw new AgentsToolsVersionNotResolved({ resourceName: name })
        }

        return toAttrs(current, env.project, tool)
      }
        |> retryQuota(%)),

    delete: effect ({ output }) =>
      try (effect {
        dialogflow
          .deleteProjectsLocationsAgentsToolsVersions({
            name: output.name,
            force: true,
          }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
      }
        |> retryQuota(%)),
  })
