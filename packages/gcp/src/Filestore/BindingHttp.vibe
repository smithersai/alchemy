import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Backup } from "./Backup.vibe"
import type { Instance } from "./Instance.ts"
import type { InstancesSnapshot } from "./InstancesSnapshot.vibe"

/**
 * Shared HTTP scaffolding for Filestore instance, backup, and snapshot
 * bindings. NOT exported from index.ts.
 */
export const makeFilestoreInstanceHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (instance: Instance) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${instance})`({
        iam: [grantFor(options.iam, instance.name)],
      })
    }
    const name = try instance.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${instance.LogicalId})`,
      )
  }
}

