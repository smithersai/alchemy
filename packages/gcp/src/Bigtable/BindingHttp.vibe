import * as Output from "alchemy/Output"
import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Cluster } from "./Cluster.ts"
import type { Instance } from "./Instance.ts"
import type { Table } from "./Table.ts"

/**
 * Shared HTTP scaffolding for Bigtable instance, cluster, and table
 * bindings. NOT exported from index.ts.
 */
export const makeBigtableInstanceHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (instance: Instance) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${instance})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, instance.name), catch: (e) => e }))],
      })
    }
    const name = try instance.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${instance.LogicalId})`,
      )
  }
}

export const makeBigtableClusterHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (cluster: Cluster) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${cluster})`({
        iam: [
          try Effect.orDie(Effect.try({
            try: () =>
              grantFor(
                options.iam,
                Output.interpolate`projects/${cluster.project}/instances/${cluster.instanceId}`,
              ),
            catch: (e) => e,
          })),
        ],
      })
    }
    const name = try cluster.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${cluster.LogicalId})`,
      )
  }
}

export const makeBigtableTableHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (table: Table) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${table})`({
        iam: [try Effect.orDie(Effect.try({ try: () => grantFor(options.iam, table.name), catch: (e) => e }))],
      })
    }
    const name = try table.name.asEffect()
    return effect (request?: Omit<I, "name"> | undefined) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${table.LogicalId})`,
      )
  }
}
