import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Node } from "./Node.vibe"
import type { QueuedResource } from "./QueuedResource.vibe"

/**
 * Shared HTTP scaffolding for Cloud TPU node bindings.
 * NOT exported from index.ts.
 */
export const makeTpuNodeHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (node: Node) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${node})`({
        iam: [grantFor(options.iam, node.name)],
      })
    }
    const name = try node.name.asEffect()
    return effect (request?: Omit<I, "name"> | undefined) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${node.LogicalId})`,
      )
  }
}

/**
 * Shared HTTP scaffolding for Cloud TPU queued resource bindings.
 * NOT exported from index.ts.
 */
export const makeTpuQueuedResourceHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (resource: QueuedResource) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${resource})`({
        iam: [grantFor(options.iam, resource.name)],
      })
    }
    const name = try resource.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${resource.LogicalId})`,
      )
  }
}
