import * as cloudidentity from "@distilled.cloud/gcp/cloudidentity_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.ts"
import {
  encodeOwnershipLine,
  findOwnedSamlProfile,
  getSamlProfile,
  hasOwnershipMarker,
  lastSegment,
  listSamlProfiles,
  MAX_DISPLAY_NAME_LENGTH,
  normalizeCustomer,
  ownedByAlchemy,
  ownershipLabels,
  parseOwnership,
  replaceOnIdentity,
  sameJson,
  sameText,
  toPhysicalId,
  updateMaskOf,
} from "./internal.vibe"
import { resourceNameFromOperation, waitForOperation, waitUntilPresent } from "./operations.vibe"

export type InboundSamlSsoProfileIdpConfig = {
  /** HTTPS SingleSignOnService URL (HTTP-Redirect binding). */
  mutable singleSignOnServiceUri?: string
  /** SAML Entity ID of the identity provider. */
  mutable entityId?: string
  /** HTTPS logout redirect URL. */
  mutable logoutRedirectUri?: string
  /** HTTPS change-password URL. */
  mutable changePasswordUri?: string
}

export type InboundSamlSsoProfileProps = {
  /**
   * Customer (`customers/C0123abc` or `customers/my_customer`).
   * Immutable — changing it replaces the profile.
   * @default "customers/my_customer"
   */
  mutable customer?: string
  /**
   * Human-readable name. Profiles have no labels field, so Alchemy
   * stamps ownership into `displayName` for `list` / nuke.
   */
  mutable displayName?: string
  /**
   * SAML identity provider configuration.
   */
  mutable idpConfig?: InboundSamlSsoProfileIdpConfig
}

export type InboundSamlSsoProfile = Resource<
  "GCP.CloudIdentity.InboundSamlSsoProfile",
  InboundSamlSsoProfileProps,
  {
    /** Resource name `inboundSamlSsoProfiles/{id}`. */
    mutable name: string
    /** Profile id (last path segment). */
    mutable profileId: string
    /** Customer. */
    mutable customer: string | undefined
    /** Display name with the Alchemy ownership prefix stripped. */
    mutable displayName: string | undefined
    /** IdP configuration. */
    mutable idpConfig: InboundSamlSsoProfileIdpConfig | undefined
    /** Google-provided SP ACS URL. */
    mutable assertionConsumerServiceUri: string | undefined
    /** Google-provided SP Entity ID. */
    mutable spEntityId: string | undefined
  },
  never,
  Providers
>

/**
 * An inbound SAML 2.0 SSO profile for a Google enterprise customer.
 *
 * Profiles have no labels field, so Alchemy stamps ownership into
 * `displayName` for `list` / nuke. `customer` is identity; display
 * name and IdP config update in place.
 *
 * ### Creating a Profile
 * **Example:** Basic SAML IdP
 * ```typescript
 * const profile = yield* GCP.CloudIdentity.InboundSamlSsoProfile("Okta", {
 *   displayName: "Okta",
 *   idpConfig: {
 *     entityId: "https://idp.example.com/metadata",
 *     singleSignOnServiceUri: "https://idp.example.com/sso",
 *   },
 * });
 * ```
 *
 * @resource
 * @category CloudIdentity
 */
export const InboundSamlSsoProfile = Resource<InboundSamlSsoProfile>(
  "GCP.CloudIdentity.InboundSamlSsoProfile",
)

// @vibelang-diagnostics-next-line EK4830:off
export class InboundSamlSsoProfileNotResolved extends Data.TaggedError(
  "GCP.CloudIdentity.InboundSamlSsoProfileNotResolved",
)<{
  mutable resourceName: string
}> {}

const toAttrs = (profile: cloudidentity.InboundSamlSsoProfile): infer _ => {
  const name = profile.name ?? ""
  return {
    name,
    profileId: lastSegment(name),
    customer: profile.customer,
    displayName: parseOwnership(profile.displayName).text,
    idpConfig: profile.idpConfig
      ? {
        singleSignOnServiceUri: profile.idpConfig.singleSignOnServiceUri,
        entityId: profile.idpConfig.entityId,
        logoutRedirectUri: profile.idpConfig.logoutRedirectUri,
        changePasswordUri: profile.idpConfig.changePasswordUri,
      }
      : undefined,
    assertionConsumerServiceUri: profile.spConfig?.assertionConsumerServiceUri,
    spEntityId: profile.spConfig?.entityId,
  }
}

const observeProfile = effect (input: { mutable id: string; mutable name?: string }) => {
  const byName = try getSamlProfile(input.name ?? "")
  if (byName !== undefined) return byName
  return try findOwnedSamlProfile(input.id)
}

export const InboundSamlSsoProfileProvider = (): infer _ =>
  Provider.succeed(InboundSamlSsoProfile, {
    stables: ["name", "profileId", "customer"],

    diff: effect ({ news, olds, output }) => {
      if (!isResolved(news)) return undefined
      const previous = olds?.customer ?? output?.customer
      const next = news.customer !== undefined ? normalizeCustomer(news.customer) : previous
      return replaceOnIdentity({
        previousParent: previous,
        nextParent: next,
      })
    },

    read: effect ({ id, output }) => {
      const existing = try observeProfile({ id, name: output?.name })
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing)
      return (try ownedByAlchemy(id, existing.displayName)) ? attrs : Unowned(attrs)
    },

    list: effect () => {
      const profiles = try listSamlProfiles()
      return profiles.filter((profile) => hasOwnershipMarker(profile.displayName)).map(toAttrs)
    },

    reconcile: effect ({ id, news, output }) => {
      const ownership = try ownershipLabels(id)
      const customer = normalizeCustomer(news.customer ?? output?.customer)
      const displayName = encodeOwnershipLine(
        ownership,
        try toPhysicalId(id, news.displayName, output?.displayName, MAX_DISPLAY_NAME_LENGTH),
        MAX_DISPLAY_NAME_LENGTH,
      )
      const desired: cloudidentity.InboundSamlSsoProfile = {
        customer,
        displayName,
        idpConfig: news.idpConfig,
      }

      let current = try observeProfile({ id, name: output?.name })

      if (current === undefined) {
        const created = cloudidentity
          .createInboundSamlSsoProfiles({ body: desired }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: try Effect.undefined;
            default: throw e;
          }
        if (created !== undefined) {
          waitForOperation(created) catch effect (e) => match (e) {
            when { _tag: "GCP.CloudIdentity.OperationPending" }: try Effect.void;
            default: throw e;
          }
          const createdName = resourceNameFromOperation(created)
          if (createdName !== undefined) {
            current = try getSamlProfile(createdName)
          }
        }
        if (current === undefined) {
          current = waitUntilPresent(
            observeProfile({ id, name: output?.name }),
            displayName,
          ) catch effect (e) => match (e) {
            when { _tag: "GCP.CloudIdentity.OperationPending" }: try observeProfile({ id });
            default: throw e;
          }
        }
      }

      if (current === undefined) {
        throw new InboundSamlSsoProfileNotResolved({
          resourceName: output?.name ?? displayName,
        })
      }

      const name = current.name ?? output?.name ?? ""
      const displayChanged = !sameText(current.displayName, displayName)
      const idpChanged = !sameJson(current.idpConfig, news.idpConfig ?? {})
      const updateMask = updateMaskOf(
        displayChanged ? "display_name" : undefined,
        idpChanged ? "idp_config" : undefined,
      )

      if (updateMask.length > 0 && name.length > 0) {
        const patched = try cloudidentity.patchInboundSamlSsoProfiles({
          name,
          updateMask,
          body: {
            displayName,
            idpConfig: news.idpConfig,
          },
        })
        waitForOperation(patched) catch effect (e) => match (e) {
          when { _tag: "GCP.CloudIdentity.OperationPending" }: try Effect.void;
          default: throw e;
        }
        current = (try getSamlProfile(name)) ?? current
      }

      return toAttrs(current)
    },

    delete: effect ({ output }) => {
      if (output.name.length === 0) return
      const deleted = cloudidentity
        .deleteInboundSamlSsoProfiles({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: try Effect.undefined;
          default: throw e;
        }
      if (deleted !== undefined) {
        try waitForOperation(deleted, { notFoundOk: true })
      }
    },
  })
