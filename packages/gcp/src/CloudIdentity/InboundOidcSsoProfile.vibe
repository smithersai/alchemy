import * as cloudidentity from "@distilled.cloud/gcp/cloudidentity_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import type { Providers } from "../Providers.ts"
import {
  encodeOwnershipLine,
  findOwnedOidcProfile,
  getOidcProfile,
  hasOwnershipMarker,
  lastSegment,
  listOidcProfiles,
  MAX_DISPLAY_NAME_LENGTH,
  normalizeCustomer,
  ownedByAlchemy,
  ownershipLabels,
  parseOwnership,
  replaceOnIdentity,
  sameJson,
  sameText,
  toPhysicalId,
  updateMaskOf,
} from "./internal.vibe"
import { resourceNameFromOperation, waitForOperation, waitUntilPresent } from "./operations.vibe"

export type InboundOidcSsoProfileIdpConfig = {
  /** IdP issuer URL. Discovery is derived from this URI. */
  issuerUri?: string
  /** HTTPS change-password URL. */
  changePasswordUri?: string
}

export type InboundOidcSsoProfileRpConfig = {
  /** OAuth2 client id. */
  clientId?: string
  /** OAuth2 client secret (input only). */
  clientSecret?: string
}

export type InboundOidcSsoProfileProps = {
  /**
   * Customer (`customers/C0123abc` or `customers/my_customer`).
   * Immutable — changing it replaces the profile.
   * @default "customers/my_customer"
   */
  customer?: string
  /**
   * Human-readable name. Profiles have no labels field, so Alchemy
   * stamps ownership into `displayName` for `list` / nuke.
   */
  displayName?: string
  /**
   * OIDC identity provider configuration.
   */
  idpConfig?: InboundOidcSsoProfileIdpConfig
  /**
   * OIDC relying-party configuration. `clientSecret` is input-only.
   */
  rpConfig?: InboundOidcSsoProfileRpConfig
}

export type InboundOidcSsoProfile = Resource<
  "GCP.CloudIdentity.InboundOidcSsoProfile",
  InboundOidcSsoProfileProps,
  {
    /** Resource name `inboundOidcSsoProfiles/{id}`. */
    name: string
    /** Profile id (last path segment). */
    profileId: string
    /** Customer. */
    customer: string | undefined
    /** Display name with the Alchemy ownership prefix stripped. */
    displayName: string | undefined
    /** IdP configuration. */
    idpConfig: InboundOidcSsoProfileIdpConfig | undefined
    /** RP configuration (secret omitted). */
    rpConfig:
      | {
        clientId?: string
        redirectUris?: string[]
      }
      | undefined
  },
  never,
  Providers
>

/**
 * An inbound OIDC SSO profile for a Google enterprise customer.
 *
 * Profiles have no labels field, so Alchemy stamps ownership into
 * `displayName` for `list` / nuke. `customer` is identity; display
 * name and IdP / RP config update in place.
 *
 * ### Creating a Profile
 * **Example:** Basic OIDC IdP
 * ```typescript
 * const profile = yield* GCP.CloudIdentity.InboundOidcSsoProfile("Okta", {
 *   displayName: "Okta",
 *   idpConfig: { issuerUri: "https://idp.example.com" },
 *   rpConfig: { clientId: "google-rp", clientSecret: "secret" },
 * });
 * ```
 *
 * @resource
 * @category CloudIdentity
 */
export const InboundOidcSsoProfile = Resource<InboundOidcSsoProfile>(
  "GCP.CloudIdentity.InboundOidcSsoProfile",
)

// @vibelang-diagnostics-next-line EK4830:off
export class InboundOidcSsoProfileNotResolved extends Data.TaggedError(
  "GCP.CloudIdentity.InboundOidcSsoProfileNotResolved",
)<{
  resourceName: string
}> {}

const rpOf = (rp: cloudidentity.OidcRpConfig | undefined): infer _ => {
  if (rp === undefined) return undefined
  return {
    clientId: rp.clientId,
    redirectUris: rp.redirectUris,
  }
}

const toAttrs = (profile: cloudidentity.InboundOidcSsoProfile): infer _ => {
  const name = profile.name ?? ""
  return {
    name,
    profileId: lastSegment(name),
    customer: profile.customer,
    displayName: parseOwnership(profile.displayName).text,
    idpConfig: profile.idpConfig
      ? {
        issuerUri: profile.idpConfig.issuerUri,
        changePasswordUri: profile.idpConfig.changePasswordUri,
      }
      : undefined,
    rpConfig: rpOf(profile.rpConfig),
  }
}

const observeProfile = effect (input: { id: string; name?: string }) => {
  const byName = try getOidcProfile(input.name ?? "")
  if (byName !== undefined) return byName
  return try findOwnedOidcProfile(input.id)
}

export const InboundOidcSsoProfileProvider = (): infer _ =>
  Provider.succeed(InboundOidcSsoProfile, {
    stables: ["name", "profileId", "customer"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      const previous = olds?.customer ?? output?.customer
      const next = resolved.customer !== undefined ? normalizeCustomer(resolved.customer) : previous
      return replaceOnIdentity({
        previousParent: previous,
        nextParent: next,
      })
    },

    read: effect ({ id, output }) => {
      const existing = try observeProfile({ id, name: output?.name })
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing)
      return (try ownedByAlchemy(id, existing.displayName))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const profiles = try listOidcProfiles()
      return profiles.filter((profile) => hasOwnershipMarker(profile.displayName)).map(toAttrs)
    },

    reconcile: effect ({ id, news, output }) => {
      const ownership = try ownershipLabels(id)
      const customer = normalizeCustomer(news.customer ?? output?.customer)
      const displayName = encodeOwnershipLine(
        ownership,
        try toPhysicalId(id, news.displayName, output?.displayName, MAX_DISPLAY_NAME_LENGTH),
        MAX_DISPLAY_NAME_LENGTH,
      )
      const desired: cloudidentity.InboundOidcSsoProfile = {
        customer,
        displayName,
        idpConfig: news.idpConfig,
        rpConfig: news.rpConfig,
      }

      let current = try observeProfile({ id, name: output?.name })

      if (current === undefined) {
        const created = cloudidentity
          .createInboundOidcSsoProfiles({ body: desired }) catch effect (e) => match (e) {
            when { _tag: "Conflict" }: undefined;
            default: throw e;
          }
        if (created !== undefined) {
          waitForOperation(created) catch effect (e) => match (e) {
            when { _tag: "GCP.CloudIdentity.OperationPending" }: (undefined as void);
            default: throw e;
          }
          const createdName = resourceNameFromOperation(created)
          if (createdName !== undefined) {
            current = try getOidcProfile(createdName)
          }
        }
        if (current === undefined) {
          current = waitUntilPresent(
            observeProfile({ id, name: output?.name }),
            displayName,
          ) catch effect (e) => match (e) {
            when { _tag: "GCP.CloudIdentity.OperationPending" }: try observeProfile({ id });
            default: throw e;
          }
        }
      }

      if (current === undefined) {
        throw new InboundOidcSsoProfileNotResolved({
          resourceName: output?.name ?? displayName,
        })
      }

      const name = current.name ?? output?.name ?? ""
      const displayChanged = !sameText(current.displayName, displayName)
      const idpChanged = !sameJson(current.idpConfig, news.idpConfig ?? {})
      const rpChanged = news.rpConfig !== undefined
        && (!sameText(current.rpConfig?.clientId, news.rpConfig.clientId)
          || news.rpConfig.clientSecret !== undefined)
      const updateMask = updateMaskOf(
        displayChanged ? "display_name" : undefined,
        idpChanged ? "idp_config" : undefined,
        rpChanged ? "rp_config" : undefined,
      )

      if (updateMask.length > 0 && name.length > 0) {
        const patched = try cloudidentity.patchInboundOidcSsoProfiles({
          name,
          updateMask,
          body: {
            displayName,
            idpConfig: news.idpConfig,
            rpConfig: news.rpConfig,
          },
        })
        waitForOperation(patched) catch effect (e) => match (e) {
          when { _tag: "GCP.CloudIdentity.OperationPending" }: (undefined as void);
          default: throw e;
        }
        current = (try getOidcProfile(name)) ?? current
      }

      return toAttrs(current)
    },

    delete: effect ({ output }) => {
      if (output.name.length === 0) return
      const deleted = cloudidentity
        .deleteInboundOidcSsoProfiles({ name: output.name }) catch effect (e) => match (e) {
          when { _tag: "NotFound" }: undefined;
          default: throw e;
        }
      if (deleted !== undefined) {
        try waitForOperation(deleted, { notFoundOk: true })
      }
    },
  })
