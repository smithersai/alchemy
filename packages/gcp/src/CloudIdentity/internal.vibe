export const getSsoAssignment = effect (name: string) => (name.length === 0 ? try Effect.undefined : cloudidentity
  .getInboundSsoAssignments({
    name: expandName(name, "inboundSsoAssignments"),
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.undefined; default: throw e; })

export const listSsoAssignments = effect () =>
  (Array.from(
    try (cloudidentity.listInboundSsoAssignments.pages({ pageSize: 100 })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.inboundSsoAssignments ?? []))
      |> Stream.runCollect(%)),
  )) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try emptyList<cloudidentity.InboundSsoAssignment>();
    default: throw e;
  }

export const findSsoAssignment = effect (input: {
  name?: string
  targetGroup?: string
  targetOrgUnit?: string
  ssoMode?: string
}) => {
  if (input.name !== undefined && input.name.length > 0) {
    const existing = try getSsoAssignment(input.name)
    if (existing !== undefined) return existing
  }
  const assignments = try listSsoAssignments()
  return assignments.find((assignment) => {
    if (
      input.targetGroup !== undefined
      && !sameText(assignment.targetGroup, expandGroup(input.targetGroup))
    ) {
      return false
    }
    if (
      input.targetOrgUnit !== undefined
      && !sameText(assignment.targetOrgUnit, input.targetOrgUnit)
    ) {
      return false
    }
    if (input.ssoMode !== undefined && !sameText(assignment.ssoMode, input.ssoMode)) {
      return false
    }
    return input.targetGroup !== undefined || input.targetOrgUnit !== undefined
  })
}
