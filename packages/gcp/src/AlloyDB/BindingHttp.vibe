import * as Effect from "effect/Effect"
import * as GCPBindings from "../GCPBindings.ts"
import { type BindingIam, type GcpHttpOp, grantFor } from "../HttpBinding.ts"
import type { Backup } from "./Backup.ts"
import type { Cluster } from "./Cluster.ts"
import type { ClustersUser } from "./ClustersUser.ts"
import type { Instance } from "./Instance.ts"

/**
 * Shared HTTP scaffolding for AlloyDB cluster, instance, backup, and
 * user bindings. NOT exported from index.ts.
 */
export const makeAlloyDbClusterHttpBinding = effect <I extends { name?: string }, A, E>(options: {
  tag: string
  iam: BindingIam
  operation: GcpHttpOp<I, A, E>
}) => {
  const bind = try GCPBindings.Bind
  const run = try GCPBindings.withCredentials(options.operation)
  return effect (cluster: Cluster) => {
    if (!globalThis.__ALCHEMY_RUNTIME__) {
      try bind`${options.tag}(${cluster})`({
        iam: [grantFor(options.iam, cluster.name)],
      })
    }
    const name = try cluster.name.asEffect()
    return effect (
      request?: Omit<I, "name"> | undefined,
    ) =>
      try withSpan(
        effect {
          return try run({
            ...(request as I),
            name: try name,
          } as I)
        },
        `${options.tag}(${cluster.LogicalId})`,
      )
  }
}

