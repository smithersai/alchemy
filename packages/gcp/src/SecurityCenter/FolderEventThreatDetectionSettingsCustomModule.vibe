import * as scc from "@distilled.cloud/gcp/securitycenter_v1"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import { GcpEnvironment } from "../Environment.ts"
import { createInternalLabels } from "../Labels.ts"
import type { Providers } from "../Providers.vibe"
import {
  DEFAULT_CLOUD_PROVIDER,
  DEFAULT_ENABLEMENT,
  DEFAULT_ETD_TYPE,
  defaultEtdConfig,
  encodeDescription,
  etdSettingsParent,
  fingerprint,
  folderIdOf,
  folderParent,
  hasOwnershipMarker,
  lastSegment,
  ownedByAlchemy,
  parseName,
  parseOwnership,
  replaceOn,
  resolveFolder,
  sameText,
  SecuritycenterNotResolved,
  tryResolveFolder,
  updateMaskOf,
} from "./internal.ts"

export type FolderEventThreatDetectionSettingsCustomModuleProps = {
  /**
   * Parent folder (`folders/{folder}` or the numeric id). Defaults to
   * the project's Resource Manager folder ancestor.
   * Immutable — changing it replaces the module.
   */
  folder?: string
  /**
   * Custom module type (for example `CONFIGURABLE_BAD_IP`). Immutable —
   * changing it replaces the module.
   * @default "CONFIGURABLE_BAD_IP"
   */
  type?: string
  /**
   * Module configuration matching `type`.
   */
  config?: scc.DocumentMap
  /**
   * Enablement state.
   * @default "ENABLED"
   */
  enablementState?: scc.EventThreatDetectionCustomModuleEnablementStateEnum | (string & {})
  /**
   * Cloud provider this module applies to.
   * @default "GOOGLE_CLOUD_PLATFORM"
   */
  cloudProvider?: scc.EventThreatDetectionCustomModuleCloudProviderEnum | (string & {})
  /**
   * Human-readable display name.
   */
  displayName?: string
  /**
   * Human-readable description. Event Threat Detection custom modules
   * have no labels field, so Alchemy ownership is stored in a
   * `[alchemy …]` prefix and stripped from attributes.
   */
  description?: string
}

export type FolderEventThreatDetectionSettingsCustomModule = Resource<
  "GCP.SecurityCenter.FolderEventThreatDetectionSettingsCustomModule",
  FolderEventThreatDetectionSettingsCustomModuleProps,
  {
    /** Full resource name `{folder}/eventThreatDetectionSettings/customModules/{module}`. */
    name: string
    /** Module id (last path segment; server assigned). */
    moduleId: string
    /** Folder resource name. */
    folder: string
    /** Folder id. */
    folderId: string
    /** Project id of the deploying stack. */
    project: string
    /** Custom module type. */
    type: string | undefined
    /** Module configuration. */
    config: scc.DocumentMap | undefined
    /** Enablement state. */
    enablementState: string | undefined
    /** Cloud provider. */
    cloudProvider: string | undefined
    /** Display name. */
    displayName: string | undefined
    /** User description with the Alchemy ownership prefix stripped. */
    description: string | undefined
    /** Ancestor module this one inherits from, if any. */
    ancestorModule: string | undefined
    /** Last editor of the module. */
    lastEditor: string | undefined
    /** RFC3339 last-update timestamp. */
    updateTime: string | undefined
  },
  never,
  Providers
>

/**
 * A folder-scoped Event Threat Detection custom module.
 *
 * Custom modules have no labels field — Alchemy stamps ownership into the
 * description so `list` / nuke can find them. The module id is assigned by
 * the API. Folder and type are identity. Config, enablement, display name,
 * and description update in place.
 *
 * ### Creating a Custom Module
 * **Example:** Flag a test IP
 * ```typescript
 * const module = yield* GCP.SecurityCenter.FolderEventThreatDetectionSettingsCustomModule(
 *   "BadIp",
 *   {
 *     type: "CONFIGURABLE_BAD_IP",
 *     config: {
 *       metadata: { severity: "LOW" },
 *       ips: ["192.0.2.1"],
 *     },
 *     description: "test bad ip",
 *   },
 * );
 * ```
 *
 * @resource
 * @category SecurityCenter
 */
export const FolderEventThreatDetectionSettingsCustomModule = Resource<FolderEventThreatDetectionSettingsCustomModule>(
  "GCP.SecurityCenter.FolderEventThreatDetectionSettingsCustomModule",
)

const toAttrs = (module: scc.EventThreatDetectionCustomModule, folder: string, project: string): infer _ => {
  const name = module.name ?? ""
  const parsed = parseName(name, "customModules")
  const ownership = parseOwnership(module.description)
  return {
    name,
    moduleId: parsed.id || lastSegment(name),
    folder,
    folderId: folderIdOf(folder),
    project,
    type: module.type,
    config: module.config,
    enablementState: module.enablementState,
    cloudProvider: module.cloudProvider,
    displayName: module.displayName,
    description: ownership.text,
    ancestorModule: module.ancestorModule,
    lastEditor: module.lastEditor,
    updateTime: module.updateTime,
  }
}

const getByName = effect (name: string) => (name.length === 0 ? try Effect.undefined : scc
  .getFoldersEventThreatDetectionSettingsCustomModules({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

const listAt = effect (parent: string) =>
  (effect {
    return (Array.from(
      try (scc.listFoldersEventThreatDetectionSettingsCustomModules.pages({ parent, pageSize: 100 })
        |> Stream.flatMap(%, (page) => Stream.fromIterable(page.eventThreatDetectionCustomModules ?? []))
        |> Stream.runCollect(%)),
    ))
  }) catch effect (e) => match (e) { when { _tag: "NotFound" }: []; default: throw e; }

const findOwned = effect (parent: string, id: string) => {
  const modules = try listAt(parent)
  for (const module of modules) {
    if (try ownedByAlchemy(id, module.description)) return module
  }
  return undefined
}

export const FolderEventThreatDetectionSettingsCustomModuleProvider = (): infer _ =>
  Provider.succeed(FolderEventThreatDetectionSettingsCustomModule, {
    stables: ["name", "moduleId", "folder", "folderId", "project", "type"],

    diff: effect ({ news, olds, output }) => {
      const resolved = try Effect.orDie(
        Effect.try({ try: () => isResolved(news) ? news : undefined, catch: (e) => e }),
      )
      if (resolved === undefined) return undefined
      return (
        try Effect.orDie(Effect.try({
          try: () =>
            replaceOn(
              olds?.folder ?? output?.folder,
              resolved.folder !== undefined ? folderParent(resolved.folder) : undefined,
            ) ?? replaceOn(olds?.type ?? output?.type, resolved.type),
          catch: (e) => e,
        }))
      )
    },

    read: effect ({ id, olds, output }) => {
      const env = try GcpEnvironment.current
      const folder = try resolveFolder(olds?.folder ?? output?.folder, output?.folder)
      let existing = try getByName(output?.name ?? "")
      if (existing === undefined) {
        existing = try findOwned(
          try Effect.orDie(Effect.try({ try: () => etdSettingsParent(folder), catch: (e) => e })),
          id,
        )
      }
      if (existing === undefined) return undefined
      const attrs = toAttrs(existing, folder, env.project)
      return (try ownedByAlchemy(id, existing.description))
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const env = try GcpEnvironment.current
      const folder = try tryResolveFolder()
      if (folder === undefined) return []
      const modules = try listAt(
        try Effect.orDie(Effect.try({ try: () => etdSettingsParent(folder), catch: (e) => e })),
      )
      return modules
        .filter((module) => hasOwnershipMarker(module.description))
        .map((module) => toAttrs(module, folder, env.project))
    },

    reconcile: effect ({ id, news, output }) => {
      const env = try GcpEnvironment.current
      const folder = try resolveFolder(news.folder, output?.folder)
      const parent = try Effect.orDie(Effect.try({ try: () => etdSettingsParent(folder), catch: (e) => e }))
      const ownership = try createInternalLabels(id)
      const description = try Effect.orDie(
        Effect.try({ try: () => encodeDescription(ownership, news.description), catch: (e) => e }),
      )
      const type = news.type ?? DEFAULT_ETD_TYPE
      const config = news.config ?? defaultEtdConfig
      const enablementState = news.enablementState ?? DEFAULT_ENABLEMENT
      const cloudProvider = news.cloudProvider ?? DEFAULT_CLOUD_PROVIDER
      const displayName = news.displayName

      let current = try getByName(output?.name ?? "")
      if (current === undefined) {
        current = try findOwned(parent, id)
      }

      if (current === undefined) {
        const created = scc
          .createFoldersEventThreatDetectionSettingsCustomModules({
            parent,
            body: {
              type,
              config,
              enablementState,
              cloudProvider,
              displayName,
              description,
            },
          }) catch effect (e) => match (e) { when { _tag: "Conflict" }: try findOwned(parent, id); default: throw e; }
        current = created ?? undefined
      }

      if (current === undefined) {
        throw new SecuritycenterNotResolved({
          resourceName: `${parent}/customModules`,
        })
      }

      const currentName = current.name ?? ""
      const updateMask = updateMaskOf(
        (try Effect.orDie(Effect.try({ try: fingerprint.bind(undefined, current.config), catch: (e) => e })))
            !== (try Effect.orDie(Effect.try({ try: fingerprint.bind(undefined, config), catch: (e) => e })))
          ? "config"
          : undefined,
        !sameText(current.enablementState, enablementState) ? "enablementState" : undefined,
        !sameText(current.displayName, displayName) ? "displayName" : undefined,
        !sameText(current.description, description) ? "description" : undefined,
      )

      if (updateMask.length > 0) {
        current = try scc.patchFoldersEventThreatDetectionSettingsCustomModules({
          name: currentName,
          updateMask,
          body: { config, enablementState, displayName, description },
        })
      }

      return toAttrs(current, folder, env.project)
    },

    delete: effect ({ output }) => {
      scc
        .deleteFoldersEventThreatDetectionSettingsCustomModules({
          name: output.name,
        }) catch effect (e) => match (e) { when { _tag: "NotFound" }: try Effect.void; default: throw e; }
    },
  })
