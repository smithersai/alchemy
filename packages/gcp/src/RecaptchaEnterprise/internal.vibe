import * as recaptchaenterprise from "@distilled.cloud/gcp/recaptchaenterprise_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import { tagRecord } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import { hasAlchemyLabels } from "../Labels.ts"

export const MAX_DESCRIPTION_LENGTH = 256
export const MAX_DISPLAY_NAME_LENGTH = 63
export const MAX_PATH_LENGTH = 200

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const projectParent = (project: string): infer _ => `projects/${project}`

export const keyNameOf = (project: string, keyId: string): infer _ => `projects/${project}/keys/${keyId}`

export const firewallNameOf = (project: string, firewallpolicyId: string): infer _ =>
  `projects/${project}/firewallpolicies/${firewallpolicyId}`

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const sameJson = (left: unknown, right: unknown): infer _ =>
  JSON.stringify(left ?? null) === JSON.stringify(right ?? null)

export const sortedStrings = (values: readonly string[] | undefined): infer _ => [...(values ?? [])].slice().sort()

export const stringList = (values: readonly (string | undefined)[] | null | undefined): string[] =>
  (values ?? []).filter((value): value is string => typeof value === "string")

export const updateMaskOf = (...fields: Array<string | undefined>): infer _ =>
  fields.filter((field): field is string => field !== undefined).join(",")

export const toDisplayName = effect (
  id: string,
  requested: string | undefined,
  existing: string | undefined,
  maxLength = MAX_DISPLAY_NAME_LENGTH,
) => {
  if (requested !== undefined && requested.length > 0) return requested
  if (existing !== undefined && existing.length > 0) return existing
  return try createPhysicalName({
    id,
    maxLength,
    lowercase: true,
  })
}

export const toGeneratedPath = effect (id: string, requested: string | undefined) => {
  if (requested !== undefined) return requested
  const generated = try createPhysicalName({
    id,
    maxLength: 40,
    lowercase: true,
  })
  const path = `/alc/${generated}`.slice(0, MAX_PATH_LENGTH)
  return path.length > 0 ? path : "/alc"
}

export const getKey = effect (name: string) => (name.length === 0 ? try Effect.undefined : recaptchaenterprise
  .getProjectsKeys({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const getFirewallPolicy = effect (
  name: string,
) => (name.length === 0 ? try Effect.undefined : recaptchaenterprise
  .getProjectsFirewallpolicies({ name }) catch effect (e) => match (e) {
    when { _tag: "NotFound" }: try Effect.undefined;
    default: throw e;
  })

export const listKeys = effect (project: string) =>
  Array.from(
    try (recaptchaenterprise.listProjectsKeys
      .pages({
        parent: projectParent(project),
        pageSize: 1000,
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.keys ?? []))
      |> Stream.runCollect(%)),
  )

export const listFirewallPolicies = effect (project: string) =>
  Array.from(
    try (recaptchaenterprise.listProjectsFirewallpolicies
      .pages({
        parent: projectParent(project),
        pageSize: 1000,
      })
      |> Stream.flatMap(%, (page) => Stream.fromIterable(page.firewallPolicies ?? []))
      |> Stream.runCollect(%)),
  )

export const findOwnedKey = effect (project: string, id: string, name?: string) => {
  if (name !== undefined && name.length > 0) {
    const existing = try getKey(name)
    if (existing !== undefined) return existing
  }
  const keys = try listKeys(project)
  for (const key of keys) {
    if (try hasAlchemyLabels(id, tagRecord(key.labels))) {
      return key
    }
  }
  return undefined
}
