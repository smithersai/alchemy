import * as workloadmanager from "@distilled.cloud/gcp/workloadmanager_v1"
import { createPhysicalName } from "alchemy/PhysicalName"
import { tagRecord } from "alchemy/Tags"
import * as Effect from "effect/Effect"
import * as Stream from "effect/Stream"
import { stripInternalLabels } from "../Labels.ts"
import { waitForOperation as waitForGcpOperation } from "../Operation.ts"

export const MAX_NAME_LENGTH = 63
export const ACTUATION_ID_PREFIX = "alch-"

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceNotResolved extends Data.TaggedError(
  "GCP.WorkloadManager.ResourceNotResolved",
)<{
  mutable resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceStillExists extends Data.TaggedError(
  "GCP.WorkloadManager.ResourceStillExists",
)<{
  mutable resourceName: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceNotReady extends Data.TaggedError("GCP.WorkloadManager.ResourceNotReady")<{
  mutable resourceName: string
  mutable state: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ResourceFailed extends Data.TaggedError("GCP.WorkloadManager.ResourceFailed")<{
  mutable resourceName: string
  mutable state: string
  mutable details: string | undefined
}> {}

export const lastSegment = (value: string): infer _ => {
  const trimmed = value.replace(/\/+$/, "")
  const parts = trimmed.split("/")
  return parts[parts.length - 1] || trimmed
}

export const rfc1035 = (name: string, fallback = "workloadmanager"): string => {
  let next = name
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "")
  if (!/^[a-z]/.test(next)) next = `w${next}`
  next = next.slice(0, MAX_NAME_LENGTH).replace(/-+$/g, "")
  if (next.length === 0) return fallback
  if (!/[a-z0-9]$/.test(next)) next = `${next.slice(0, MAX_NAME_LENGTH - 1)}0`
  return next.slice(0, MAX_NAME_LENGTH)
}

export const normalizeLocation = (location: string | undefined, fallback: string): infer _ =>
  lastSegment(location ?? fallback).toLowerCase()

export const parentOf = (project: string, location: string): infer _ =>
  `projects/${project}/locations/${lastSegment(location).toLowerCase()}`

export const toPhysicalId = effect (
  id: string,
  explicit: string | undefined,
  existing: string | undefined,
  fallback = "workloadmanager",
) => {
  if (explicit !== undefined) return rfc1035(explicit, fallback)
  if (existing !== undefined) return existing
  return rfc1035(
    try createPhysicalName({
      id,
      maxLength: MAX_NAME_LENGTH,
      lowercase: true,
    }),
    fallback,
  )
}

/**
 * Actuations have no labels or description. Generated ids are prefixed
 * `alch-` so `list` / nuke can find Alchemy-owned rows.
 */
export const toActuationId = effect (
  id: string,
  explicit: string | undefined,
  existing: string | undefined,
) => {
  if (explicit !== undefined) return rfc1035(explicit, "alch")
  if (existing !== undefined) return existing
  const generated = rfc1035(
    try createPhysicalName({
      id,
      maxLength: MAX_NAME_LENGTH - ACTUATION_ID_PREFIX.length,
      lowercase: true,
    }),
    "actuation",
  )
  const prefixed = generated.startsWith(ACTUATION_ID_PREFIX)
    ? generated
    : `${ACTUATION_ID_PREFIX}${generated}`
  return prefixed.slice(0, MAX_NAME_LENGTH).replace(/-+$/g, "")
}

export const hasAlchemyActuationId = (actuationId: string): infer _ => actuationId.startsWith(ACTUATION_ID_PREFIX)

export const parseName = (name: string, collection: string, fallbackLocation: string): infer _ => {
  const parts = name.split("/").filter((part) => part.length > 0)
  const collectionAt = parts.lastIndexOf(collection)
  const locationsAt = parts.lastIndexOf("locations")
  const projectsAt = parts.lastIndexOf("projects")
  return {
    project: projectsAt >= 0 && parts[projectsAt + 1] ? parts[projectsAt + 1]! : "",
    location: locationsAt >= 0 && parts[locationsAt + 1] ? parts[locationsAt + 1]! : fallbackLocation,
    id: collectionAt >= 0 && parts[collectionAt + 1] ? parts[collectionAt + 1]! : lastSegment(name),
    parent: collectionAt > 0
      ? parts.slice(0, collectionAt).join("/")
      : parts.slice(0, Math.max(0, parts.length - 1)).join("/"),
  }
}

export const expandNamed = (
  value: string,
  project: string,
  location: string,
  collection: string,
): infer _ => {
  if (value.includes("/")) return value.replace(/\/+$/, "")
  return `projects/${project}/locations/${location}/${collection}/${value}`
}

export const userLabels = (
  labels: Record<string, string | undefined> | null | undefined,
): Record<string, string> => stripInternalLabels(tagRecord(labels))

export const stringMap = (
  value: Record<string, string | undefined> | null | undefined,
): Record<string, string> =>
  Object.fromEntries(
    Object.entries(value ?? {}).filter(
      (entry): entry is [string, string] => typeof entry[1] === "string",
    ),
  )

export const hasAlchemyLabelMap = (labels: Record<string, string | undefined> | null | undefined): infer _ =>
  Object.keys(labels ?? {}).some((key) => key.startsWith("alchemy-"))

export const canonical = (value: unknown): unknown => {
  if (value === undefined || value === null) return undefined
  if (typeof value === "boolean" || typeof value === "number") return value
  if (typeof value === "string") {
    return value.length === 0 ? undefined : value
  }
  if (Array.isArray(value)) {
    const items = value.map(canonical).filter((item) => item !== undefined)
    return items.length === 0 ? undefined : items
  }
  if (typeof value === "object") {
    const entries = Object.entries(value as Record<string, unknown>)
      .map(([key, item]) => [key, canonical(item)] as const)
      .filter(([, item]) => item !== undefined)
      .sort(([left], [right]) => left.localeCompare(right))
    if (entries.length === 0) return undefined
    return Object.fromEntries(entries)
  }
  return undefined
}

export const fingerprint = (value: unknown): string => JSON.stringify(canonical(value) ?? null)

export const fieldMask = (fields: Array<string | false | undefined>): infer _ =>
  fields.filter((field): field is string => typeof field === "string").join(",")

export const sameText = (left: string | undefined, right: string | undefined): infer _ => (left ?? "") === (right ?? "")

export const sameStringList = (
  left: readonly string[] | undefined,
  right: readonly string[] | undefined,
): infer _ => fingerprint([...(left ?? [])].slice().sort()) === fingerprint([...(right ?? [])].slice().sort())

export const replaceOnIdentity = (input: {
  mutable previousId: string | undefined
  mutable nextId: string | undefined
  mutable previousLocation: string
  mutable nextLocation: string
  mutable extra?: boolean
  mutable previousParent?: string
  mutable nextParent?: string
}): infer _ => {
  const parentChanged = (input.previousParent ?? "") !== ""
    && (input.nextParent ?? "") !== ""
    && (input.previousParent ?? "") !== (input.nextParent ?? "")
  const replace = (input.extra ?? false)
    || parentChanged
    || (input.previousId !== undefined
      && input.nextId !== undefined
      && input.nextId !== input.previousId)
    || input.previousLocation !== input.nextLocation
  if (!replace) return undefined
  const samePhysical = input.previousLocation === input.nextLocation
    && !parentChanged
    && input.previousId !== undefined
    && input.nextId === input.previousId
  return {
    action: "replace" as const,
    deleteFirst: samePhysical,
  }
}

const READY_STATES = new Set(["READY", "SUCCEEDED", "ACTIVE"])
const FAILED_STATES = new Set(["FAILED", "ERROR", "TIMEOUT"])

export const isReadyState = (state: string | undefined): infer _ => READY_STATES.has((state ?? "").toUpperCase())

export const isFailedState = (state: string | undefined): infer _ => FAILED_STATES.has((state ?? "").toUpperCase())

export const resourceNameFromOperation = (
  operation: workloadmanager.Operation,
): string | undefined => {
  const response = operation.response
  if (response && typeof response.name === "string" && response.name.length > 0) {
    return response.name
  }
  const metadata = operation.metadata
  if (metadata && typeof metadata.target === "string" && metadata.target.length > 0) {
    return metadata.target
  }
  if (metadata && typeof metadata.name === "string" && metadata.name.length > 0) {
    return metadata.name
  }
  return undefined
}

/**
 * Wait for a Workload Manager long-running operation (evaluations settle in minutes; deployment actuations run infrastructure changes).
 */
export const waitForOperation = effect (operation: workloadmanager.Operation) =>
  waitForGcpOperation(
    operation,
    effect (name) => try workloadmanager.getProjectsLocationsOperations({ name }),
    { budget: "20 minutes" },
  )

export const waitUntilExists = effect <A, E extends { readonly _tag: string }, R>(
  get: A!E!R,
  name: string,
): Exclude<A, undefined>!E | ResourceNotResolved!R =>
  try (get
    |> Effect.filterOrFail(%, (value): value is Exclude<A, undefined> =>
      value !== undefined, () =>
      new ResourceNotResolved({ resourceName: name }))
    |> Effect.retry(%, {
      while: (error) =>
        error._tag === "GCP.WorkloadManager.ResourceNotResolved",
      times: 8,
      schedule: Schedule.spaced("1 second"),
    }))

export const waitUntilGone = effect <A, E extends { readonly _tag: string }, R>(
  get: A!E!R,
  name: string,
): void!E | ResourceStillExists!R =>
  try (get
    |> Effect.filterOrFail(%, (value) => value === undefined, () => new ResourceStillExists({ resourceName: name }))
    |> Effect.retry(%, {
      while: (error) => error._tag === "GCP.WorkloadManager.ResourceStillExists",
      times: 10,
      schedule: Schedule.spaced("2 seconds"),
    })
    |> Effect.asVoid(%))

export const waitUntilReady = effect <A, E extends { readonly _tag: string }, R>(
  get: A!E!R,
  name: string,
  stateOf: (value: Exclude<A, undefined>) => string | undefined,
  detailsOf?: (value: Exclude<A, undefined>) => string | undefined,
  options?: {
    mutable times?: number
    mutable interval?: `${number} seconds`
  },
): Exclude<A, undefined>!E | ResourceNotResolved | ResourceFailed | ResourceNotReady!R =>
  try (get
    |> Effect.filterOrFail(%, (value): value is Exclude<A, undefined> =>
      value !== undefined, () =>
      new ResourceNotResolved({ resourceName: name }))
    |> Effect.filterOrFail(%, (value) =>
      !isFailedState(stateOf(value)), (value) =>
      new ResourceFailed({
        resourceName: name,
        state: stateOf(value) ?? "",
        details: detailsOf?.(value),
      }))
    |> Effect.filterOrFail(%, (value) => {
      const state = stateOf(value) ?? ""
      return isReadyState(state) || state.length === 0
    }, (value) => new ResourceNotReady({ resourceName: name, state: stateOf(value) ?? "" }))
    |> Effect.retry(%, {
      while: (error) =>
        error._tag === "GCP.WorkloadManager.ResourceNotReady"
        || error._tag === "GCP.WorkloadManager.ResourceNotResolved",
      times: options?.times ?? 10,
      schedule: Schedule.spaced(options?.interval ?? "2 seconds"),
    }))

const isNotFound = <E extends { readonly _tag: string }>(
  error: E,
): error is E & { readonly _tag: "NotFound" } => error._tag === "NotFound"

/** List across `locations/-`, falling back to the region if the wildcard 404s. */
export const listAtLocation = effect <A, E extends { readonly _tag: string }, R>(
  project: string,
  region: string,
  list: (parent: string) => A[]!E!R,
) =>
  try (list(`projects/${project}/locations/-`)
    |> Effect.catchIf(%, isNotFound, effect () => try list(`projects/${project}/locations/${region}`)))

export const listAtNested = effect <A, E extends { readonly _tag: string }, R>(
  project: string,
  region: string,
  nested: string,
  list: (parent: string) => A[]!E!R,
) =>
  try (list(`projects/${project}/locations/-/${nested}`)
    |> Effect.catchIf(%, isNotFound, effect () => try list(`projects/${project}/locations/${region}/${nested}`)))

export const listLabeledPages = effect <Page, A, E, R>(
  pages: Stream.Stream<Page, E, R>,
  items: (page: Page) => readonly A[] | undefined,
  labelsOf: (item: A) => Record<string, string | undefined> | null | undefined,
): A[]!E!R =>
  Array.from(
    try (pages
      |> Stream.flatMap((page) => Stream.fromIterable(items(page) ?? []))(%)
      |> Stream.filter((item) => hasAlchemyLabelMap(labelsOf(item)))(%)
      |> Stream.runCollect(%)),
  )

export const listPages = effect <Page, A, E, R>(
  pages: Stream.Stream<Page, E, R>,
  items: (page: Page) => readonly A[] | undefined,
  keep: (item: A) => boolean,
): A[]!E!R =>
  Array.from(
    try (pages
      |> Stream.flatMap((page) => Stream.fromIterable(items(page) ?? []))(%)
      |> Stream.filter(keep)(%)
      |> Stream.runCollect(%)),
  )
