import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"
import { SystemError } from "../RuntimeError.shared.ts"
import * as System from "./System.ts"

export service Paths {
  static readonly key = "cloudflare-runtime/Paths"
  cache: (...prefix: Array<string>) => string!SystemError
  config: (...prefix: Array<string>) => string!SystemError
  data: (...prefix: Array<string>) => string!SystemError
  state: (...prefix: Array<string>) => string!SystemError
}

export const PathsLive = Layer.effect(
  Paths,
  effect {
    const fs = try Effect.service(FileSystem.FileSystem)
    const path = try Effect.service(Path.Path)
    const home = try System.home

    const makeWith =
      (options: { mutable env: string; mutable fallback: Array<string> }): infer _ =>
      effect (...prefix: Array<string>) =>
        try (effect {
          return path.join(Config.String(options.env) catch () => path.join(home, ...options.fallback), ...prefix)
        }
          |> Effect.tap(%, effect (path) =>
            fs.makeDirectory(path, { recursive: true }) catch effect (error) => match (error) {
              when { _tag: "PlatformError" }: throw SystemError.make({
                subtag: "Paths",
                message: `Failed to create directory "${path}".`,
                cause: error,
                detail: { path, env: options.env },
              });
              default: throw error;
            }))

    return Paths.of({
      cache: makeWith({ env: "XDG_CACHE_HOME", fallback: [".cache"] }),
      config: makeWith({ env: "XDG_CONFIG_HOME", fallback: [".config"] }),
      data: makeWith({ env: "XDG_DATA_HOME", fallback: [".local", "share"] }),
      state: makeWith({ env: "XDG_STATE_HOME", fallback: [".local", "state"] }),
    })
  },
)

export const data = effect (...prefix: Array<string>) => try Paths.use(effect (Paths) => try Paths.data(...prefix))

export const config = effect (...prefix: Array<string>) => try Paths.use(effect (Paths) => try Paths.config(...prefix))

export const cache = effect (...prefix: Array<string>) => try Paths.use(effect (Paths) => try Paths.cache(...prefix))

export const state = effect (...prefix: Array<string>) => try Paths.use(effect (Paths) => try Paths.state(...prefix))
