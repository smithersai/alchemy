{
  "extends": "../../tsconfig.cloudflare.json",
  "include": ["src/**/*.ts", "src/internal/workers-shared/shared/testdata/*.json", "src/**/*.vibe"],
  "exclude": [
    "src/core/test/**",
    "src/rolldown/test/**",
    "src/**/fixtures/**",
    "src/core/scripts/**"
  ],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "outDir": ".cache/types",
    "rootDir": "src",
    "emitDeclarationOnly": true,
    "types": ["bun", "@cloudflare/workers-types/experimental", "@cloudflare/vitest-plugin/types"]
  },
  "vibelang": {
    "declarationSidecars": true,
    "trustedPackages": [
      "@alchemy.run/cloudflare-runtime",
      "@alchemy.run/node-utils",
      "@distilled.cloud/cloudflare"
    ]
  }
}
