import { hashDockerBuildInputs, selectDockerBuildContext } from "@alchemy.run/docker/BuildHash"
import { initialCwd } from "alchemy/Util/Node"
import { sha256Object } from "alchemy/Util/sha256"
import { tarGzipDirectory } from "alchemy/Util/tarGzip"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"

const DEFAULT_DOCKERFILE = "Dockerfile"
const RAILWAY_BUILD_PLATFORM = "linux/amd64"
const MAX_CONTEXT_BYTES = 32 * 1024 * 1024
const MAX_CONTEXT_ENTRIES = 10_000
const TAR_BLOCK_BYTES = 512

export interface RailwayLocalContextSource {
  readonly context: string
  readonly dockerfilePath?: string
}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceImageOrMainRequired extends Data.TaggedError(
  "Railway.ServiceImageOrMainRequired",
)<{ mutable message: string }> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceSourceInvalid extends Data.TaggedError("Railway.ServiceSourceInvalid")<{
  mutable message: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceDockerfilePathInvalid extends Data.TaggedError(
  "Railway.ServiceDockerfilePathInvalid",
)<{ mutable dockerfilePath: string; mutable message: string }> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceContextPathInvalid extends Data.TaggedError(
  "Railway.ServiceContextPathInvalid",
)<{ mutable path: string; mutable expected: "directory" | "file" }> {
  override get message() {
    return `Railway.Service expected ${this.path} to be an existing ${this.expected}`
  }
}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceDockerfileOutsideContext extends Data.TaggedError(
  "Railway.ServiceDockerfileOutsideContext",
)<{ mutable context: string; mutable dockerfile: string }> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceContextSymlinkUnsupported extends Data.TaggedError(
  "Railway.ServiceContextSymlinkUnsupported",
)<{ mutable path: string }> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceContextPathUnsupported extends Data.TaggedError(
  "Railway.ServiceContextPathUnsupported",
)<{ mutable path: string }> {}

// @vibelang-diagnostics-next-line EK4830:off
export class ServiceContextTooLarge extends Data.TaggedError("Railway.ServiceContextTooLarge")<{
  mutable limit: number
  mutable size: number
}> {}

export type RailwayServiceSource =
  | { readonly mode: "main"; readonly main: string }
  | {
    readonly mode: "context"
    readonly context: string
    readonly dockerfilePath: string | undefined
  }
  | { readonly mode: "image"; readonly image: string }
  | { readonly mode: "repo"; readonly repo: string }

const nonEmpty = (value: string | undefined): value is string => value !== undefined && value.length > 0

export const resolveRailwayServiceSource = effect (props: {
  readonly main?: string
  readonly context?: string
  readonly image?: string
  readonly repo?: string
  readonly dockerfilePath?: string
}) => {
  const main = nonEmpty(props.main) ? props.main : undefined
  const context = nonEmpty(props.context) ? props.context : undefined
  const image = nonEmpty(props.image) ? props.image : undefined
  const repo = nonEmpty(props.repo) ? props.repo : undefined
  const modes = [
    main === undefined ? undefined : "main",
    context === undefined ? undefined : "context",
    repo === undefined ? undefined : "repo",
    main === undefined && image !== undefined ? "image" : undefined,
  ].filter((mode): mode is RailwayServiceSource["mode"] => mode !== undefined)

  if (modes.length === 0) {
    throw new ServiceImageOrMainRequired({
      message: "Railway.Service requires `image`, `main`, `context`, or `repo`.",
    })
  }
  if (modes.length !== 1) {
    throw new ServiceSourceInvalid({
      message:
        "Railway.Service requires exactly one source: `main`, `context`, `image`, or `repo` (`image` may configure the base image for `main`).",
    })
  }
  switch (modes[0]) {
    case "main":
      return { mode: "main", main: main! } as const
    case "context":
      return {
        mode: "context",
        context: context!,
        dockerfilePath: props.dockerfilePath,
      } as const
    case "image":
      return { mode: "image", image: image! } as const
    case "repo":
      return { mode: "repo", repo: repo! } as const
    default:
      throw new ServiceSourceInvalid({
        message: "Railway.Service source could not be resolved",
      })
  }
}

const resolveBuild = effect (source: RailwayLocalContextSource) => {
  const fs = try Effect.service(FileSystem.FileSystem)
  const path = try Effect.service(Path.Path)
  const context = path.resolve(initialCwd, source.context)
  const dockerfilePath = source.dockerfilePath ?? DEFAULT_DOCKERFILE
  if (dockerfilePath.length === 0 || path.isAbsolute(dockerfilePath)) {
    throw new ServiceDockerfilePathInvalid({
      dockerfilePath,
      message: "Railway.Service `dockerfilePath` must be a non-empty path relative to `context`",
    })
  }
  if (!(try fs.exists(context))) {
    throw new ServiceContextPathInvalid({
      path: context,
      expected: "directory",
    })
  }
  if (Result.isSuccess(try Effect.result(fs.readLink(context)))) {
    throw new ServiceContextSymlinkUnsupported({ path: context })
  }
  const contextInfo = try fs.stat(context)
  if (contextInfo.type !== "Directory") {
    throw new ServiceContextPathInvalid({
      path: context,
      expected: "directory",
    })
  }
  const dockerfile = path.resolve(context, dockerfilePath)
  if (!(try fs.exists(dockerfile))) {
    throw new ServiceContextPathInvalid({
      path: dockerfile,
      expected: "file",
    })
  }
  const selected = try selectDockerBuildContext({ context, dockerfile })
  if (selected.dockerfilePath === undefined) {
    throw new ServiceDockerfileOutsideContext({
      context,
      dockerfile,
    })
  }
  const parts = selected.dockerfilePath.split("/")
  let current = context
  for (const part of parts) {
    current = path.join(current, part)
    if (Result.isSuccess(try Effect.result(fs.readLink(current)))) {
      throw new ServiceContextSymlinkUnsupported({ path: current })
    }
  }
  const dockerfileInfo = try fs.stat(dockerfile)
  if (dockerfileInfo.type !== "File") {
    throw new ServiceContextPathInvalid({
      path: dockerfile,
      expected: "file",
    })
  }
  return {
    build: {
      context,
      dockerfile,
      platform: RAILWAY_BUILD_PLATFORM,
    },
    selected,
  }
}

const paddedTarBytes = (size: number): infer _ => Math.ceil(size / TAR_BLOCK_BYTES) * TAR_BLOCK_BYTES

const fitsUstarPath = (relativePath: string): infer _ => {
  if (relativePath.length <= 100) return true
  for (let index = relativePath.length - 101; index >= 1; index--) {
    if (relativePath[index] !== "/") continue
    const nameLength = relativePath.length - index - 1
    if (index <= 155 && nameLength > 0 && nameLength <= 100) return true
  }
  return false
}

const tarEntryBytes = (relativePath: string, type: "Directory" | "File", size: number): infer _ => {
  const tarPath = type === "Directory" ? `${relativePath}/` : relativePath
  const longNameBytes = fitsUstarPath(tarPath)
    ? 0
    : TAR_BLOCK_BYTES + paddedTarBytes(tarPath.length + 1)
  return longNameBytes + TAR_BLOCK_BYTES + (type === "File" ? paddedTarBytes(size) : 0)
}

const checkContextLimit = effect (
  size: number,
  entries: number,
) => (size > MAX_CONTEXT_BYTES || entries > MAX_CONTEXT_ENTRIES
  ? throw new ServiceContextTooLarge({
    limit: MAX_CONTEXT_BYTES,
    size,
  })
  : try Effect.void)

const selectedEntries = effect (selected: {
  mutable context: string
  mutable includes: (relativePath: string) => boolean
}) => {
  const fs = try Effect.service(FileSystem.FileSystem)
  const path = try Effect.service(Path.Path)
  const entries: Array<{
    mutable entry: string
    mutable sourcePath: string
    mutable type: "Directory" | "File"
    mutable mode: number
  }> = []
  let size = 2 * TAR_BLOCK_BYTES
  let entryCount = 0
  for (
    const entry of (try fs.readDirectory(selected.context, {
      recursive: true,
    })).sort()
  ) {
    const relative = entry.replaceAll("\\", "/")
    if (!selected.includes(relative)) continue
    const sourcePath = path.join(selected.context, entry)
    if (/[^\x20-\x7e]/.test(relative)) {
      throw new ServiceContextPathUnsupported({ path: sourcePath })
    }
    if (Result.isSuccess(try Effect.result(fs.readLink(sourcePath)))) {
      throw new ServiceContextSymlinkUnsupported({ path: sourcePath })
    }
    const info = try fs.stat(sourcePath)
    if (info.type !== "Directory" && info.type !== "File") continue
    entryCount += 1
    size += tarEntryBytes(relative, info.type, Number(info.size))
    try checkContextLimit(size, entryCount)
    entries.push({
      entry,
      sourcePath,
      type: info.type,
      mode: info.mode & 0o7777,
    })
  }
  return entries
}

const codeHash = effect (input: { mutable context: string; mutable dockerfilePath: string }) => {
  const contextHash = try hashDockerBuildInputs(
    {
      context: input.context,
      dockerfile: input.dockerfilePath,
      platform: RAILWAY_BUILD_PLATFORM,
    },
    "effective",
  )
  return (try sha256Object({
    contextHash,
    dockerfilePath: input.dockerfilePath,
  })).slice(0, 16)
}

export const hashRailwayLocalContext = effect (source: RailwayLocalContextSource) => {
  const { build, selected } = try resolveBuild(source)
  try selectedEntries(selected)
  return try codeHash({
    context: build.context,
    dockerfilePath: selected.dockerfilePath!,
  })
}

export const prepareRailwayLocalContext = effect (source: RailwayLocalContextSource) => {
  const fs = try Effect.service(FileSystem.FileSystem)
  const path = try Effect.service(Path.Path)
  const { selected } = try resolveBuild(source)
  const snapshot = try fs.makeTempDirectoryScoped({
    prefix: "alchemy-railway-context-",
  })
  const entries = try selectedEntries(selected)
  let copiedSize = 2 * TAR_BLOCK_BYTES
  let copiedEntries = 0
  for (const entry of entries) {
    const destination = path.join(snapshot, entry.entry)
    copiedEntries += 1
    if (entry.type === "Directory") {
      copiedSize += tarEntryBytes(entry.entry, entry.type, 0)
      try checkContextLimit(copiedSize, copiedEntries)
      try fs.makeDirectory(destination, { recursive: true })
      try fs.chmod(destination, entry.mode)
    } else {
      try fs.makeDirectory(path.dirname(destination), { recursive: true })
      const contents = try fs.readFile(entry.sourcePath)
      copiedSize += tarEntryBytes(entry.entry, entry.type, contents.byteLength)
      try checkContextLimit(copiedSize, copiedEntries)
      try fs.writeFile(destination, contents)
      try fs.chmod(destination, entry.mode)
    }
  }
  const dockerfilePath = selected.dockerfilePath!
  const hash = try codeHash({ context: snapshot, dockerfilePath })
  const tarball = try tarGzipDirectory(snapshot, { preserveMode: true })
  return { codeHash: hash, dockerfilePath, tarball }
}
