import { Query } from "@distilled.cloud/core/query"
import {
  type Bucket,
  type Group,
  Railway,
  type Service,
  type ServiceInstance,
  type VolumeInstance,
} from "@distilled.cloud/railway"
import * as Data from "effect/Data"
import * as Effect from "effect/Effect"

/**
 * Collect every node of a connection. `select` projects one node, e.g.
 * `(service) => ({ id: service.id, name: service.name })`.
 */
const collect = effect <Item, Error>(connection: Query<ReadonlyArray<Item> | null, Error>) =>
  Array.from(try Stream.runCollect(Query.items(connection)))

/** Every service of a project, projected by `select`. */
export const projectServices = effect <Mapped>(
  projectId: string,
  select: (service: Query<Service>) => Mapped,
) => try collect(Railway.project({ id: projectId }).services({ first: 50 }).pipe(Query.map(select)))

/** Every bucket of a project, projected by `select`. */
export const projectBuckets = effect <Mapped>(
  projectId: string,
  select: (bucket: Query<Bucket>) => Mapped,
) => try collect(Railway.project({ id: projectId }).buckets({ first: 50 }).pipe(Query.map(select)))

/** Every group of a project, projected by `select`. */
export const projectGroups = effect <Mapped>(projectId: string, select: (group: Query<Group>) => Mapped) =>
  try collect(Railway.project({ id: projectId }).groups({ first: 50 }).pipe(Query.map(select)))

const environmentDeleted = Query.fn((id: string, projectId: string) => ({
  deletedAt: Railway.environment({ id, projectId }).deletedAt,
}))

/** Volumes are read through their environment so access checks remain scoped. */
export const environmentVolumes = effect <Mapped>(
  environmentId: string,
  projectId: string,
  select: (volume: Query<VolumeInstance>) => Mapped,
) => {
  const { deletedAt } = try environmentDeleted(environmentId, projectId)
  if (deletedAt !== null) return []
  return try collect(
    Railway.environment({ id: environmentId, projectId })
      .volumeInstances({ first: 50 })
      .pipe(Query.map(select)),
  )
}

/** Enumerate existing service instances without probing absent service/environment pairs. */
export const environmentServiceInstances = effect <Mapped>(
  environmentId: string,
  projectId: string,
  select: (instance: Query<ServiceInstance>) => Mapped,
) => {
  const { deletedAt } = try environmentDeleted(environmentId, projectId)
  if (deletedAt !== null) return []
  return try collect(
    Railway.environment({ id: environmentId, projectId })
      .serviceInstances({ first: 50 })
      .pipe(Query.map(select)),
  )
}

/** A delete remains pending until its read path confirms absence. */
// @vibelang-diagnostics-next-line EK4830:off
export class ResourceDeletionPending extends Data.TaggedError("Railway.ResourceDeletionPending")<{
  mutable resourceType: string
  mutable resourceId: string
}> {}

export const waitUntilDeleted = effect <E, R>(
  resourceType: string,
  resourceId: string,
  absent: boolean!E!R,
  times: 4 | 8 | 10 = 8,
) =>
  try ((try (absent
      |> Effect.repeat(%, { schedule: Schedule.spaced("1 second"), until: (gone) => gone, times })))
    ? Effect.void
    : throw new ResourceDeletionPending({ resourceType, resourceId }))
