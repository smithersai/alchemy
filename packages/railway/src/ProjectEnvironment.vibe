import { Query, type UnwrapPlan } from "@distilled.cloud/core/query"
import { Railway, type Environment as RailwayEnvironment } from "@distilled.cloud/railway"
import { Unowned } from "alchemy/AdoptPolicy"
import { isResolved } from "alchemy/Diff"
import * as Provider from "alchemy/Provider"
import { Resource } from "alchemy/Resource"
import * as Effect from "effect/Effect"
import { waitUntilDeleted } from "./GraphQL.vibe"
import {
  createRailwayEnvironmentName,
  matchesAlchemyPhysicalName,
  sanitizeRailwayEnvironmentName,
} from "./Metadata.vibe"
import { ownedProjects, type Project } from "./Project.vibe"
import type { Providers } from "./Providers.vibe"
import { waitOutCreateRateLimit } from "./transient.vibe"

const environmentFields = <E>(env: Query<RailwayEnvironment, E>): infer _ => ({
  id: env.id,
  name: env.name,
  projectId: env.projectId,
  isEphemeral: env.isEphemeral,
  deletedAt: env.deletedAt,
})
type CloudEnvironment = UnwrapPlan<ReturnType<typeof environmentFields>>

/**
 * A resource-valued prop: the resource itself, or an Effect that produces
 * it (so `yield* Project(...)` and `Project(...)` both type-check).
 */
type Ref<T> = T | (T!!Providers)

export interface EnvironmentProps {
  /**
   * Parent Railway Project. Accepts a `Railway.Project` resource or an
   * Effect that produces one. Changing it replaces the Environment.
   */
  project: Ref<Project>
  /**
   * Environment name. Unique per project. If omitted, a unique name is
   * generated from the stack, stage and logical ID. Changing it updates
   * the environment in place via `environmentRename`.
   */
  name?: string
  /**
   * Whether to create an ephemeral (PR) environment, listed under
   * PR Environments in Railway. Create-only; ignored on update. Does not
   * enable Railway's automatic PR deployments.
   * @default false
   */
  ephemeral?: boolean
  /**
   * Fork this environment from an existing one (`sourceEnvironmentId`).
   * Create-only; ignored on update. Pass the project's `environmentId` to
   * copy production's services, volumes, and variables.
   */
  sourceEnvironmentId?: string
}

export type Environment = Resource<
  "Railway.Environment",
  EnvironmentProps,
  {
    /** Railway environment id. */
    environmentId: string
    /** Physical environment name (unique per project). */
    name: string
    /** Parent Railway project id. */
    projectId: string
    /** Whether this is an ephemeral (PR) environment. */
    isEphemeral: boolean
    /** Dashboard URL for this environment. */
    url: string
  },
  never,
  Providers
>

const EnvironmentResource = Resource<Environment>("Railway.Environment")

const resolveEnvironmentProps = effect (
  props: EnvironmentProps | (EnvironmentProps!!Providers),
): EnvironmentProps!!Providers => {
  const resolved = Effect.isEffect(props) ? try props : props
  if (globalThis.__ALCHEMY_RUNTIME__) return resolved
  const project = Effect.isEffect(resolved.project)
    ? try (resolved.project as Project!!Providers)
    : resolved.project
  return { ...resolved, project }
}

/**
 * A Railway.Environment is an extra deploy environment under a Project
 * (staging, preview, …). The production environment is created with the
 * Project — do not recreate it as an Environment resource.
 *
 * @see https://docs.railway.com/guides/environments
 *
 * ### Create an extra environment
 * Alchemy generates a unique name unless you pass one. Production is
 * already on the Project as `environmentId`.
 *
 * **Example:** Staging next to production
 * ```typescript
 * const site = yield* Railway.Project("Site");
 * const staging = yield* Railway.Environment("Staging", {
 *   project: site,
 * });
 * ```
 *
 * :::note
 * Prefer omitting `name` in tests and CI so names stay unique and
 * reclaimable.
 * :::
 *
 * ### A stable name
 * Pass `name` when you need a stable environment name (`staging`).
 * Changing it later updates the environment in place.
 *
 * **Example:** Explicit name
 * ```typescript
 * const staging = yield* Railway.Environment("Staging", {
 *   project: site,
 *   name: "staging",
 * });
 * ```
 *
 * ### Create a PR preview
 * `ephemeral: true` lists the environment under PR Environments in Railway.
 * Create-only; existing environments are not converted on update.
 *
 * **Example:** Ephemeral preview environment
 * ```typescript
 * const preview = yield* Railway.Environment("Preview", {
 *   project: site,
 *   name: "pr-123",
 *   ephemeral: true,
 * });
 * ```
 *
 * ### Fork from production
 * `sourceEnvironmentId` copies services, volumes, configuration, and
 * variables from another environment. Create-only.
 *
 * **Example:** Fork production
 * ```typescript
 * const staging = yield* Railway.Environment("Staging", {
 *   project: site,
 *   sourceEnvironmentId: site.environmentId,
 * });
 * ```
 *
 * ### Module-scope declarations
 * Declare the Project once. Pass it into every child. Resource-valued
 * props accept the resource or an Effect producing it.
 *
 * **Example:** Module-scope Environment
 * ```typescript
 * // src/project.ts
 * import * as Railway from "@alchemy.run/railway";
 *
 * export const Site = Railway.Project("Site");
 * export const Staging = Railway.Environment("Staging", {
 *   project: Site,
 * });
 * ```
 *
 * @resource
 * @product Project
 */
export const Environment: typeof EnvironmentResource = Object.assign(
  effect (id: string, props: EnvironmentProps | (EnvironmentProps!never!Providers)) =>
    try EnvironmentResource(id, resolveEnvironmentProps(props)),
  EnvironmentResource,
)

// @vibelang-diagnostics-next-line EK4830:off
export class EnvironmentNotCreated extends Data.TaggedError("Railway.EnvironmentNotCreated")<{
  resourceName: string
  projectId: string
}> {}

// @vibelang-diagnostics-next-line EK4830:off
export class EnvironmentProjectRequired extends Data.TaggedError(
  "Railway.EnvironmentProjectRequired",
)<{ message: string }> {}

const toAttrs = (
  env: CloudEnvironment,
  fallback?: { name?: string; projectId?: string },
): Environment["Attributes"] => {
  const name = env.name || fallback?.name || ""
  const projectId = env.projectId || fallback?.projectId || ""
  return {
    environmentId: env.id,
    name,
    projectId,
    isEphemeral: env.isEphemeral,
    url: `https://railway.com/project/${projectId}?environmentId=${env.id}`,
  }
}

const resolveName = effect (id: string, name: string | undefined, existing?: string) => {
  if (name !== undefined) return sanitizeRailwayEnvironmentName(name)
  if (existing !== undefined) return existing
  return try createRailwayEnvironmentName(id)
}

const isGone = (env: CloudEnvironment | undefined): infer _ => env === undefined || env.deletedAt != null

const projectIdOf = (value: unknown): string | undefined => {
  if (value === null || typeof value !== "object") return undefined
  const rec = value as { projectId?: unknown }
  return typeof rec.projectId === "string" && rec.projectId.length > 0 ? rec.projectId : undefined
}

const readEnvironment = Query.fn((id: string, projectId?: string) =>
  environmentFields(Railway.environment({ id, ...(projectId !== undefined ? { projectId } : {}) }))
)

const projectEnvironments = (projectId: string): infer _ =>
  Stream.unwrap(
    Effect.orDie(Effect.try({
      try: () => Query.items(Railway.environments({ projectId, first: 50 }).pipe(Query.map(environmentFields))),
      catch: (e) => e,
    })),
  )

const environmentCreate = Query.fn(
  (
    input: {
      name: string
      projectId: string
      ephemeral?: boolean
      sourceEnvironmentId?: string
    },
  ) => environmentFields(Railway.environmentCreate({ input })),
)

const environmentRename = Query.fn((id: string, name: string) =>
  environmentFields(Railway.environmentRename({ id, input: { name } }))
)

const environmentDelete = Query.fn((id: string) => Railway.environmentDelete({ id }))

const getById = effect (environmentId: string, projectId?: string) =>
  (effect {
    return (try effect {
      const env = try readEnvironment(environmentId, projectId)
      return (isGone(env) ? undefined : env)
    })
  }) catch effect (e) => match (e) { when { _tag: "RailwayNotFound" }: undefined; default: throw e; }

const findByName = effect (projectId: string, name: string) =>
  (effect {
    return (try effect {
      const option = try (projectEnvironments(projectId)
        |> Stream.filter(%, (env) => !isGone(env) && env.name === name)
        |> Stream.take(%, 1)
        |> Stream.runHead(%))
      return (option._tag === "Some" ? option.value : undefined)
    })
  }) catch effect (e) => match (e) { when { _tag: "RailwayNotFound" }: undefined; default: throw e; }

export const EnvironmentProvider = (): infer _ =>
  Provider.succeed(Environment, {
    stables: ["environmentId", "projectId"],
    nuke: { dependsOn: ["Railway.Project"] },

    diff: effect ({ news, output }) => {
      if (news === undefined) return undefined
      const resolved = try Effect.orDie(Effect.try({
        try: () => isResolved(news) ? { value: news } : undefined,
        catch: (cause) => cause,
      }))
      if (!resolved) return undefined
      const resolvedNews = resolved.value
      if (output === undefined) return undefined
      const nextProjectId = projectIdOf(resolvedNews.project)
      if (nextProjectId !== undefined && nextProjectId !== output.projectId) {
        return { action: "replace" as const }
      }
      return undefined
    },

    read: effect ({ id, olds, output }) => {
      const name = try resolveName(id, olds?.name, output?.name)
      const projectId = output?.projectId ?? (olds !== undefined ? projectIdOf(olds.project) : undefined)
      const found = (output?.environmentId !== undefined
        ? try getById(output.environmentId, output.projectId)
        : undefined)
        ?? (projectId !== undefined ? try findByName(projectId, name) : undefined)
      if (found === undefined) return undefined
      const attrs = toAttrs(found, { name, projectId })
      if (output !== undefined) return attrs
      return matchesAlchemyPhysicalName(found.name)
        ? attrs
        : try Effect.orDie(Effect.try({ try: () => Unowned(attrs), catch: (e) => e }))
    },

    list: effect () => {
      const projects = try ownedProjects()
      const rows = try Effect.forEach(projects, effect (project) =>
        (effect {
          return (Array.from(
            try (projectEnvironments(project.projectId)
              |> Stream.filter(%, (env) => env.deletedAt == null && matchesAlchemyPhysicalName(env.name))
              |> Stream.runCollect(%)),
          ).map((env) => {
            const projectId = env.projectId || project.projectId
            return {
              environmentId: env.id,
              name: env.name,
              projectId,
              isEphemeral: env.isEphemeral,
              url: `https://railway.com/project/${projectId}?environmentId=${env.id}`,
            }
          }))
        }) catch effect (e) => match (e) {
          when { _tag: "RailwayNotFound" }: [] as Environment["Attributes"][];
          default: throw e;
        })
      return rows.flat()
    },

    reconcile: effect ({ id, news, output }) => {
      const props = news ?? ({} as EnvironmentProps)
      const projectId = projectIdOf(props.project) ?? output?.projectId
      if (projectId === undefined) {
        throw new EnvironmentProjectRequired({
          message: "Environment requires a resolved Railway.Project",
        })
      }
      const name = try resolveName(id, props.name, output?.name)

      let current: CloudEnvironment | undefined = output?.environmentId !== undefined
        ? try getById(output.environmentId, output.projectId)
        : undefined
      if (current === undefined) {
        current = try findByName(projectId, name)
      }

      if (current === undefined) {
        const created = waitOutCreateRateLimit(
          environmentCreate({
            name,
            projectId,
            ...(props.ephemeral !== undefined ? { ephemeral: props.ephemeral } : {}),
            ...(props.sourceEnvironmentId !== undefined
              ? { sourceEnvironmentId: props.sourceEnvironmentId }
              : {}),
          }),
        ) catch effect (e) => match (e) {
          when { _tag: "RailwayValidationError" }: undefined;
          default: throw e;
        }
        current = created ?? (try findByName(projectId, name))
      }

      if (current === undefined || isGone(current)) {
        throw new EnvironmentNotCreated({ resourceName: name, projectId })
      }

      if (current.name !== name) {
        current = try environmentRename(current.id, name)
      }

      return toAttrs(current, { name, projectId })
    },

    delete: effect ({ output }) => {
      const environmentId = output.environmentId
      if (environmentId.length === 0) {
        return
      }
      environmentDelete(environmentId) catch effect (e) => match (e) {
        when { _tag: "RailwayNotFound" }: (undefined as void);
        default: throw e;
      }
      try waitUntilDeleted(
        "Environment",
        environmentId,
        effect {
          return (try getById(environmentId, output.projectId)) === undefined
        },
      )
    },
  })
