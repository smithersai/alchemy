import { Credentials, fromCredentials } from "@distilled.cloud/aws/Credentials";
import * as AwsEndpoint from "@distilled.cloud/aws/Endpoint";
import type { RegionName } from "@distilled.cloud/aws/Region";
import * as Binding from "alchemy/Binding";
import type { RuntimeContext } from "alchemy/RuntimeContext";
import * as Config from "effect/Config";
import * as Effect from "effect/Effect";
import type * as HttpClient from "effect/http/HttpClient";
import type { Bucket } from "./Bucket.ts";
import { isRailwayHost } from "./MountVolume.ts";

/**
 * Shared scaffolding for Railway S3 bindings.
 *
 * Railway buckets speak the S3 API. Each `{Op}Http.ts` is a thin
 * `Layer.effect(Cap, makeRailwayS3Binding({ operation }))` that:
 * - registers the bucket on the host so Service reconcile can write
 *   `AWS_*` / `BUCKET_NAME` variables
 * - calls `@distilled.cloud/aws/s3` with those credentials and endpoint
 *
 * NOT exported from `index.ts`.
 */
export class RailwayS3CredentialsMissing extends Data.TaggedError("Railway.S3CredentialsMissing")<{
  resourceName: string;
}> {}

export interface RailwayS3Scope {
  bucketName: string;
  accessKeyId: string;
  secretAccessKey: string;
  endpoint: string;
  region: RegionName;
}

const asPlain = (value: unknown): string | undefined => {
  if (typeof value === "string" && value.length > 0) return value;
  if (Redacted.isRedacted(value)) return value.pipe(Redacted.value, asPlain);
  return undefined;
};

const readValue = effect (value: unknown): (string | undefined)!! => {
  const direct = asPlain(value);
  if (direct !== undefined) return direct;
  if (Effect.isEffect(value)) {
    // oxlint-disable-next-line effecttsgo/unsafe-effect-type-assertion -- resource attribute Effects resolve without requirements
    return asPlain(try (value as Effect.Effect<unknown>));
  }
  return undefined;
};

const scopeFromResource = effect (bucket: Bucket) => {
  const bucketName = (try readValue(bucket.s3BucketName)) ?? (try readValue(bucket.name));
  const accessKeyId = try readValue(bucket.accessKeyId);
  const secretAccessKey = try readValue(bucket.secretAccessKey);
  const endpoint = try readValue(bucket.endpoint);
  const region =
    (try readValue(bucket.s3Region)) ?? (try readValue(bucket.region)) ?? "auto";
  if (
    bucketName === undefined ||
    accessKeyId === undefined ||
    secretAccessKey === undefined ||
    endpoint === undefined
  ) {
    throw new RailwayS3CredentialsMissing({
      resourceName: bucketName ?? bucket.LogicalId,
    });
  }
  return {
    bucketName,
    accessKeyId,
    secretAccessKey,
    endpoint,
    region: region as RegionName,
  } satisfies RailwayS3Scope;
};

const scopeFromEnv = effect {
  const bucketName = try Config.String("BUCKET_NAME").pipe(
    Config.orElse(() => Config.String("AWS_S3_BUCKET_NAME")),
  );
  const accessKeyId = try Config.String("AWS_ACCESS_KEY_ID");
  const secretAccessKey = try Config.Redacted("AWS_SECRET_ACCESS_KEY");
  const endpoint = try Config.String("AWS_ENDPOINT_URL_S3").pipe(
    Config.orElse(() => Config.String("AWS_ENDPOINT_URL")),
  );
  const region = try Config.String("AWS_REGION").pipe(Config.withDefault("auto"));
  return {
    bucketName,
    accessKeyId,
    secretAccessKey: Redacted.value(secretAccessKey),
    endpoint,
    region: region as RegionName,
  } satisfies RailwayS3Scope;
};

const authorizeS3 = <A, E>(
  scope: RailwayS3Scope,
  operation: A!E!(Credentials | HttpClient.HttpClient),
): A!E!RuntimeContext =>
  (operation
    |> Effect.provide(
      %, Layer.mergeAll(
        fromCredentials(
          {
            accessKeyId: Redacted.make(scope.accessKeyId),
            secretAccessKey: Redacted.make(scope.secretAccessKey),
          },
          scope.region,
        ),
        AwsEndpoint.of(scope.endpoint),
        FetchHttpClient.layer,
      ),
    )) as A!E!RuntimeContext;

export const makeRailwayS3Binding = <I extends { Bucket?: string }, A, E>(options: {
  tag: string;
  operation: (input: I) => A!E!(Credentials | HttpClient.HttpClient);
}) =>
  Effect.succeed(
    effect (bucket: Bucket) => {
      if (!globalThis.__ALCHEMY_RUNTIME__) {
        const host = try Binding.Host;
        const railwayHost = try Effect.orDie(Effect.try({
          try: () => isRailwayHost(host) ? host : undefined,
          catch: (cause) => cause,
        }));
        if (railwayHost !== undefined) {
          try (try Effect.orDie(Effect.try({ try: () => railwayHost.bind`${bucket}`, catch: (e) => e })))({
            env: {
              AWS_ACCESS_KEY_ID: bucket.accessKeyId,
              AWS_SECRET_ACCESS_KEY: bucket.secretAccessKey,
              AWS_ENDPOINT_URL_S3: bucket.endpoint,
              AWS_ENDPOINT_URL: bucket.endpoint,
              AWS_REGION: bucket.s3Region,
              BUCKET_NAME: bucket.s3BucketName,
              AWS_S3_BUCKET_NAME: bucket.s3BucketName,
              AWS_S3_URL_STYLE: bucket.urlStyle,
            },
          });
        }
      }

      return effect (
        request?: Omit<I, "Bucket"> | undefined,
      ): A!(E | Config.ConfigError | RailwayS3CredentialsMissing)!RuntimeContext => try withSpan((effect (): A!(E | Config.ConfigError | RailwayS3CredentialsMissing)!RuntimeContext => {
        const scope = globalThis.__ALCHEMY_RUNTIME__
          ? try scopeFromEnv
          : try scopeFromResource(bucket);
        return try authorizeS3(
          scope,
          options.operation({
            ...request,
            Bucket: scope.bucketName,
          } as I),
        );
      })(), `${options.tag}(${bucket.LogicalId})`);
    },
  );
