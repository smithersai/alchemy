{
  "name": "@alchemy.run/railway",
  "version": "2.0.0-beta.84",
  "description": "Railway projects, services and databases for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "railway"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/railway"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./Website": "./src/Website/index.ts",
    "./Catalog": "./src/Catalog.vibe",
    "./CloudAgent": "./src/CloudAgent.vibe",
    "./ConnectMongo": "./src/ConnectMongo.vibe",
    "./ConnectMySQL": "./src/ConnectMySQL.vibe",
    "./ConnectPostgres": "./src/ConnectPostgres.vibe",
    "./Credentials": "./src/Credentials.vibe",
    "./CustomDomain": "./src/CustomDomain.vibe",
    "./DeleteObject": "./src/DeleteObject.vibe",
    "./DeleteObjectHttp": "./src/DeleteObjectHttp.vibe",
    "./GetObject": "./src/GetObject.vibe",
    "./GetObjectHttp": "./src/GetObjectHttp.vibe",
    "./GraphQL": "./src/GraphQL.vibe",
    "./Group": "./src/Group.vibe",
    "./HeadObject": "./src/HeadObject.vibe",
    "./HeadObjectHttp": "./src/HeadObjectHttp.vibe",
    "./InferEnv": "./src/InferEnv.vibe",
    "./ListObjectsV2": "./src/ListObjectsV2.vibe",
    "./ListObjectsV2Http": "./src/ListObjectsV2Http.vibe",
    "./LoginSession": "./src/LoginSession.vibe",
    "./Metadata": "./src/Metadata.vibe",
    "./ProjectEnvironment": "./src/ProjectEnvironment.vibe",
    "./PutObject": "./src/PutObject.vibe",
    "./PutObjectHttp": "./src/PutObjectHttp.vibe",
    "./ReadRedis": "./src/ReadRedis.vibe",
    "./ReadRedisHttp": "./src/ReadRedisHttp.vibe",
    "./ReadWriteRedis": "./src/ReadWriteRedis.vibe",
    "./ReadWriteRedisHttp": "./src/ReadWriteRedisHttp.vibe",
    "./SandboxCheckpoint": "./src/SandboxCheckpoint.vibe",
    "./ServiceProvider": "./src/ServiceProvider.vibe",
    "./ServiceRegion": "./src/ServiceRegion.vibe",
    "./TcpProxy": "./src/TcpProxy.vibe",
    "./transient": "./src/transient.vibe",
    "./Up": "./src/Up.vibe",
    "./Website/Cdn": "./src/Website/Cdn.vibe",
    "./Website/FrameworkSite": "./src/Website/FrameworkSite.vibe",
    "./Website/Vinext": "./src/Website/Vinext.vibe",
    "./WriteRedis": "./src/WriteRedis.vibe",
    "./WriteRedisHttp": "./src/WriteRedisHttp.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./LoginSession.vibe.platform": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./Website": {
        "types": "./lib/Website/index.d.ts",
        "default": "./lib/Website/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./LoginSession.vibe.platform": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/docker": "workspace:*",
    "@alchemy.run/redis": "workspace:*",
    "@distilled.cloud/aws": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/railway": "workspace:*",
    "rolldown": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-2fe05486ecc6.tgz"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mongodb": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-316a192f4c8a.tgz"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mongodb": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/railway/Contributions"
    ]
  }
}
