import { GetTaxSettings } from "@distilled.cloud/stripe/stripe"
import * as Binding from "alchemy/Binding"
import type { ResourceLike } from "alchemy/Resource"
import * as Layer from "effect/Layer"
import { RetrieveTaxSettings, type RetrieveTaxSettingsRequest } from "./RetrieveTaxSettings.vibe"
import { attachStripeToken, authorizeWith, resolveStripeAuth } from "./StripeHttp.ts"
import type { TaxSettings } from "./TaxSettings.vibe"

/**
 * HTTP implementation of {@link RetrieveTaxSettings}. Provide it on the
 * Function or Worker Effect. Tax Settings has no Stripe id — only the API
 * key is bound.
 *
 * @layer
 * @product Tax
 * @provides Stripe.RetrieveTaxSettings
 */
export const RetrieveTaxSettingsHttp = Layer.effect(
  RetrieveTaxSettings,
  effect {
    const ambient = try resolveStripeAuth

    return effect (settings: TaxSettings) => {
      const host = try Binding.Host
      const bound = try attachStripeToken(
        settings as unknown as ResourceLike,
        ["tax_read"],
        "Stripe.RetrieveTaxSettings",
      )
      const auth = host !== undefined ? try Effect.orDie(Effect.try({ try: () => authorizeWith(bound), catch: (e) => e })) : ambient.authorize
      return effect (
        request?: RetrieveTaxSettingsRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try auth(GetTaxSettings(request ?? {}))
          },
          `Stripe.RetrieveTaxSettings(${settings.LogicalId})`,
        )
    }
  },
)
