  /** Display preference for Alipay. */
  mutable alipay?: PaymentMethodPreferenceInput
  /** Display preference for Alma. */
  mutable alma?: PaymentMethodPreferenceInput
  /** Display preference for Amazon Pay. */
  mutable amazonPay?: PaymentMethodPreferenceInput
  /** Display preference for Apple Pay. */
  mutable applePay?: PaymentMethodPreferenceInput
  /** Display preference for AU BECS Debit. */
  mutable auBecsDebit?: PaymentMethodPreferenceInput
  /** Display preference for Bacs Direct Debit. */
  mutable bacsDebit?: PaymentMethodPreferenceInput
  /** Display preference for Bancontact. */
  mutable bancontact?: PaymentMethodPreferenceInput
  /** Display preference for Billie. */
  mutable billie?: PaymentMethodPreferenceInput
  /** Display preference for Bizum. */
  mutable bizum?: PaymentMethodPreferenceInput
  /** Display preference for BLIK. */
  mutable blik?: PaymentMethodPreferenceInput
  /** Display preference for Boleto. */
  mutable boleto?: PaymentMethodPreferenceInput
  /** Display preference for cards. */
  mutable card?: PaymentMethodPreferenceInput
