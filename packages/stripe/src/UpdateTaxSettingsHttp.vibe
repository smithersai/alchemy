import { CreateTaxSettings } from "@distilled.cloud/stripe/stripe"
import * as Binding from "alchemy/Binding"
import type { ResourceLike } from "alchemy/Resource"
import * as Layer from "effect/Layer"
import { attachStripeToken, authorizeWith, resolveStripeAuth } from "./StripeHttp.ts"
import type { TaxSettings } from "./TaxSettings.ts"
import { UpdateTaxSettings, type UpdateTaxSettingsRequest } from "./UpdateTaxSettings.ts"

/**
 * HTTP implementation of {@link UpdateTaxSettings}. Provide it on the
 * Function or Worker Effect. Tax Settings has no Stripe id — only the API
 * key is bound.
 *
 * @layer
 * @product Tax
 * @provides Stripe.UpdateTaxSettings
 */
export const UpdateTaxSettingsHttp = Layer.effect(
  UpdateTaxSettings,
  effect {
    const ambient = try resolveStripeAuth

    return effect (settings: TaxSettings) => {
      const host = try Binding.Host
      const bound = try attachStripeToken(
        settings as unknown as ResourceLike,
        ["tax_write"],
        "Stripe.UpdateTaxSettings",
      )
      const auth = host !== undefined ? authorizeWith(bound) : ambient.authorize
      return effect (
        request?: UpdateTaxSettingsRequest | undefined,
      ) =>
        try withSpan(
          effect {
            return try auth(CreateTaxSettings(request ?? {}))
          },
          `Stripe.UpdateTaxSettings(${settings.LogicalId})`,
        )
    }
  },
)
