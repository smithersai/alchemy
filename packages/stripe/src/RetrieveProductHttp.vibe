import { GetProduct } from "@distilled.cloud/stripe/stripe"
import * as Binding from "alchemy/Binding"
import type { ResourceLike } from "alchemy/Resource"
import * as Layer from "effect/Layer"
import type { Product } from "./Product.ts"
import { RetrieveProduct } from "./RetrieveProduct.ts"
import { asStringEffect, attachStripeToken, authorizeWith, resolveStripeAuth } from "./StripeHttp.ts"

type ProductInput = string | Product

/**
 * HTTP implementation of {@link RetrieveProduct}. Provide it on the
 * Function or Worker Effect. Accepts a Product resource, a `prod_…` id
 * string, or an Effect resolving to a Product.
 *
 * @layer
 * @product Product
 * @provides Stripe.RetrieveProduct
 */
export const RetrieveProductHttp = Layer.effect(
  RetrieveProduct,
  effect {
    const ambient = try resolveStripeAuth

    return effect (product: ProductInput) => {
      const host = try Binding.Host
      const isId = typeof product === "string"
      const resource = isId ? undefined : (product as unknown as ResourceLike)
      const bound = try attachStripeToken(resource, ["products_read"], "Stripe.RetrieveProduct")
      const id = asStringEffect(isId ? product : (product as Product).id)
      const auth = host !== undefined ? authorizeWith(bound) : ambient.authorize
      const label = isId ? product : (product as Product).LogicalId

      return effect (request?: {
        mutable expand?: string[]
      }) =>
        try withSpan(
          effect {
            return try auth(
              GetProduct({
                ...request,
                id: try id,
              }),
            )
          },
          `Stripe.RetrieveProduct(${label})`,
        )
    }
  },
)
