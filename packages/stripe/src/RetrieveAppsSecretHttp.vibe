import { GetAppsSecretsFind } from "@distilled.cloud/stripe/stripe"
import * as Binding from "alchemy/Binding"
import type { ResourceLike } from "alchemy/Resource"
import * as Layer from "effect/Layer"
import type { AppsSecret, AppsSecretScopeType } from "./AppsSecret.vibe"
import { RetrieveAppsSecret } from "./RetrieveAppsSecret.vibe"
import {
  asOptionalStringEffect,
  asStringEffect,
  attachStripeToken,
  authorizeWith,
  resolveStripeAuth,
} from "./StripeHttp.vibe"

/**
 * HTTP implementation of {@link RetrieveAppsSecret}. Find is keyed by
 * `name` and `scope`.
 *
 * @layer
 * @product Secrets
 * @provides Stripe.RetrieveAppsSecret
 */
export const RetrieveAppsSecretHttp = Layer.effect(
  RetrieveAppsSecret,
  effect {
    const ambient = try resolveStripeAuth

    return effect (secret: AppsSecret) => {
      const host = try Binding.Host
      const bound = try attachStripeToken(
        secret as unknown as ResourceLike,
        ["apps_secrets_read"],
        "Stripe.RetrieveAppsSecret",
      )
      const name = try asStringEffect(secret.name)
      const scopeType = try asStringEffect(secret.scope.type)
      const scopeUser = try asOptionalStringEffect(secret.scope.user)
      const auth = host !== undefined
        ? try Effect.orDie(Effect.try({ try: () => authorizeWith(bound), catch: (e) => e }))
        : ambient.authorize

      return effect (request?: {
        expand?: string[]
      }) =>
        try withSpan(
          effect {
            const user = try scopeUser
            return try auth(
              GetAppsSecretsFind({
                ...request,
                name: try name,
                scope: {
                  type: (try scopeType) as AppsSecretScopeType,
                  ...(user !== undefined && user.length > 0 ? { user } : {}),
                },
              }),
            )
          },
          `Stripe.RetrieveAppsSecret(${secret.LogicalId})`,
        )
    }
  },
)
