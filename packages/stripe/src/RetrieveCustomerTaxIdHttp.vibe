import { GetCustomerTaxIdsById } from "@distilled.cloud/stripe/stripe"
import * as Binding from "alchemy/Binding"
import type { ResourceLike } from "alchemy/Resource"
import * as Layer from "effect/Layer"
import type { CustomerTaxId } from "./CustomerTaxId.vibe"
import { RetrieveCustomerTaxId } from "./RetrieveCustomerTaxId.ts"
import { asStringEffect, attachStripeToken, authorizeWith, resolveStripeAuth } from "./StripeHttp.ts"

/**
 * HTTP implementation of {@link RetrieveCustomerTaxId}. The nested
 * retrieve takes both `customer` and `id`.
 *
 * @layer
 * @product Customer
 * @provides Stripe.RetrieveCustomerTaxId
 */
export const RetrieveCustomerTaxIdHttp = Layer.effect(
  RetrieveCustomerTaxId,
  effect {
    const ambient = try resolveStripeAuth

    return effect (taxId: CustomerTaxId) => {
      const host = try Binding.Host
      const bound = try attachStripeToken(
        taxId as unknown as ResourceLike,
        ["customers_read"],
        "Stripe.RetrieveCustomerTaxId",
      )
      const id = asStringEffect(taxId.id)
      const customer = asStringEffect(taxId.customer)
      const auth = host !== undefined ? authorizeWith(bound) : ambient.authorize

      return effect (request?: {
        mutable expand?: string[]
      }) =>
        try withSpan(
          effect {
            return try auth(
              GetCustomerTaxIdsById({
                ...request,
                id: try id,
                customer: try customer,
              }),
            )
          },
          `Stripe.RetrieveCustomerTaxId(${taxId.LogicalId})`,
        )
    }
  },
)
