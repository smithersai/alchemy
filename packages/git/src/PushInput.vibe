/** Construct a streaming push from an application's own protocol or background job. */
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"
import * as Stream from "effect/Stream"
import { Oid, RefName } from "./Api/Schema.vibe"
import { StoreError } from "./Protocol/Store.vibe"
import { incomingStates, type PushInput, type RefUpdate } from "./Push.vibe"
import { makeStreamingSource } from "./Store/StreamingSource.vibe"

const Commands = Schema.Array(Schema.Struct({ ref: RefName, oldOid: Oid, newOid: Oid }))

/**
 * Prepare input from decoded ref updates and raw pack bytes, with no HTTP dependency.
 * Use Stream.empty for a ref-only mutation. The input and producer share the caller's scope.
 */
export const fromStream = effect <E, R>(
  updates: ReadonlyArray<RefUpdate>,
  pack: Stream.Stream<Uint8Array, E, R>,
  options?: { readonly atomic?: boolean; readonly declaredBytes?: number },
) => {
  const commands = try Schema.decodeEffect(Commands)(updates)
  const input: PushInput = Object.freeze({
    updates: Object.freeze(commands.map((command) => Object.freeze({ ...command }))),
    atomic: options?.atomic ?? true,
  })
  const feeder = makeStreamingSource()
  let total = 0
  const receiving = try Effect.forkScoped(
    pack
      |> Stream.runForEach(effect (bytes) =>
        try Effect.andThen(
          feeder.push(bytes),
          effect {
            total += bytes.length
          },
        )
      )(%)
      |> Effect.map(%, () => {
        feeder.end()
        return { total }
      })
      |> Effect.mapError(%, (error) => StoreError.make({ reason: `pack stream failed: ${String(error)}` }))
      |> Effect.tapError(%, effect (error) => feeder.fail(error))
      |> Effect.result(%),
  )
  const state = {
    feeder,
    receiving,
    packStart: 0,
    declaredBytes: options?.declaredBytes,
    active: true,
    claimed: false,
  }
  incomingStates.set(input, state)
  try Effect.addFinalizer(effect () => {
    state.active = false
    feeder.fail(StoreError.make({ reason: "push scope closed" }))
    try Fiber.interrupt(receiving)
  })
  return input
}
