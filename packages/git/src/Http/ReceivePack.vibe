/** Streaming smart-HTTP decoding and report-status encoding. No authorization policy. */
import * as Effect from "effect/Effect"
import * as Fiber from "effect/Fiber"
import * as HttpServerRequest from "effect/http/HttpServerRequest"
import * as HttpServerResponse from "effect/http/HttpServerResponse"
import { StoreError } from "../Protocol/Store.vibe"
import { incomingStates, type PushInput } from "../Push.vibe"
import { parseReceivePackRequest } from "../RepoObject.vibe"
import { feedBody, HEAD_BYTES } from "../Store/IncomingBody.vibe"
import { makeStreamingSource } from "../Store/StreamingSource.vibe"

export { ReceivePack as endpoint } from "../Api/Protocol.vibe"

// Host access: `DecompressionStream` is a web platform global.
module web {
  /** Pipes a request body through `DecompressionStream("gzip")`. */
  export const gunzip = (body: ReadableStream<Uint8Array<ArrayBuffer>>) =>
    body.pipeThrough(new DecompressionStream("gzip"))
}

import { gunzip } from web

// The report encoders throw `PktLineError` from `pktText`/`errPkt` on an oversize
// line, so they live in this body with that contract.
module report {
  import * as HttpServerResponse from "effect/http/HttpServerResponse"
  import { concatBytes } from "../Protocol/ObjectCodec.vibe"
  import { errPkt, flushPkt, pktText, type PktLineError } from "../Protocol/Pkt.vibe"
  import { sidebandFrames } from "../Protocol/Sideband.vibe"
  import type { CommitPushResult } from "../RepoObject.vibe"
  import type { Push } from "./ReceivePack.vibe"

  const headers = {
    "cache-control": "no-cache",
    "content-type": "application/x-git-receive-pack-result",
  }
  const reply = (bytes: Uint8Array) => HttpServerResponse.uint8Array(bytes, { headers })
  /** @throws {never} */
  export const probeResponse = () => HttpServerResponse.empty({ status: 200, headers })

  /**
   * Encode the negotiated Git report; policy rejection is a Git result, not JSON.
   *
   * @throws {PktLineError} when a report line exceeds the pkt-line payload limit.
   */
  export const response = (push: Push, result: CommitPushResult) => {
    if (!push.capabilities.has("report-status") && !push.capabilities.has("report-status-v2")) {
      return probeResponse()
    }
    const lines = [
      pktText(`unpack ${result.unpack}`),
      ...result.results.map((ref) => pktText(ref.ok ? `ok ${ref.ref}` : `ng ${ref.ref} ${ref.reason ?? "failed"}`)),
      flushPkt,
    ]
    const report = concatBytes(lines)
    return reply(
      push.capabilities.has("side-band-64k")
        ? concatBytes([...sidebandFrames(1, report), flushPkt])
        : report,
    )
  }

  /**
   * Refuse the whole push without ingesting objects or moving any refs.
   *
   * @throws {PktLineError} when a report line exceeds the pkt-line payload limit.
   */
  export const reject = (push: Push, reason: string) =>
    response(push, {
      unpack: "ok",
      results: push.updates.map((update) => ({
        ref: update.ref,
        ok: false,
        reason: reason.replace(/[\r\n\0]/g, " "),
      })),
    })

  /**
   * Encode malformed protocol input or a failed unpack operation.
   *
   * @throws {PktLineError} when the message exceeds the pkt-line payload limit.
   */
  export const failure = (reason: string) => reply(errPkt(reason.replace(/[\r\n\0]/g, " ")))
}

export { failure, probeResponse, reject, response } from report

export interface Push {
  readonly _tag: "Push"
  readonly input: PushInput
  readonly updates: PushInput["updates"]
  readonly capabilities: ReadonlySet<string>
}

/** Decode only the bounded command header. The body remains streaming until preparePush. */
export const decode = (request: HttpServerRequest.HttpServerRequest) =>
  effect {
    const web = try HttpServerRequest.toWeb(request).pipe(
      Effect.mapError((error) => StoreError.make({ reason: `incoming body: ${error.message}` })),
    )
    const feeder = makeStreamingSource()
    const gzip = /\bgzip\b/i.test(request.headers["content-encoding"] ?? "")
    const raw = web.body
    const body = gzip && raw !== null
      ? try Effect.orDie(Effect.try({ try: () => gunzip(raw), catch: (e) => e }))
      : raw
    const receiving = try feedBody(body, feeder).pipe(Effect.result, Effect.forkScoped)
    const state = {
      feeder,
      receiving,
      packStart: 0,
      declaredBytes: undefined as number | undefined,
      active: true,
      claimed: false,
    }
    try Effect.addFinalizer(() =>
      effect {
        state.active = false
        feeder.fail(StoreError.make({ reason: "push scope closed" }))
        try Fiber.interrupt(receiving)
      }
    )
    const head = try feeder.source.read(0, HEAD_BYTES)
    if (!gzip && head[0] === 0x1f && head[1] === 0x8b) {
      return try StoreError.make({
        reason: "gzip-encoded push without content-encoding",
      })
    }
    const parsed = try parseReceivePackRequest(head)
    if (parsed.probe) return { _tag: "Probe" } as const
    const updates = Object.freeze(parsed.commands.map((command) => Object.freeze({ ...command })))
    const input: PushInput = Object.freeze({
      updates,
      atomic: parsed.capabilities.has("atomic"),
    })
    state.packStart = parsed.packStart
    const length = Number.parseInt(request.headers["content-length"] ?? "", 10)
    state.declaredBytes = Number.isNaN(length) ? undefined : length
    incomingStates.set(input, state)
    return {
      _tag: "Push",
      input,
      updates,
      capabilities: parsed.capabilities,
    } satisfies Push
  }
