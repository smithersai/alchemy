{
  "name": "@alchemy.run/git",
  "version": "2.0.0-beta.84",
  "description": "Git hosting building blocks for Alchemy: protocol, stores, hasher and server.",
  "keywords": [
    "alchemy",
    "effect",
    "git",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/git"
  },
  "files": [
    "lib",
    "src",
    "lib-bun"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Hasher": "./src/Hasher/index.ts",
    "./Api": "./src/Api.vibe",
    "./Api/GitHub": "./src/Api/GitHub.vibe",
    "./Api/Internal": "./src/Api/Internal.vibe",
    "./Api/Objects": "./src/Api/Objects.vibe",
    "./Api/Protocol": "./src/Api/Protocol.vibe",
    "./Api/Pulls": "./src/Api/Pulls.vibe",
    "./Api/Refs": "./src/Api/Refs.vibe",
    "./Api/Repos": "./src/Api/Repos.vibe",
    "./Hasher/Protocol": "./src/Hasher/Protocol.vibe",
    "./Jobs/Bundle": "./src/Jobs/Bundle.vibe",
    "./Jobs/Compact": "./src/Jobs/Compact.vibe",
    "./Jobs/Purge": "./src/Jobs/Purge.vibe",
    "./Protocol/PackWriter": "./src/Protocol/PackWriter.vibe",
    "./Protocol/PartialScan": "./src/Protocol/PartialScan.vibe",
    "./Protocol/Sideband": "./src/Protocol/Sideband.vibe",
    "./Protocol/Store": "./src/Protocol/Store.vibe",
    "./Protocol/TreeDiff": "./src/Protocol/TreeDiff.vibe",
    "./Push": "./src/Push.vibe",
    "./PushInput": "./src/PushInput.vibe",
    "./RegistryD1": "./src/RegistryD1.vibe",
    "./Store/StreamingSource": "./src/Store/StreamingSource.vibe",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./Hasher": {
        "types": "./lib/Hasher/index.d.ts",
        "default": "./lib/Hasher/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./Hasher/WorkerLoader": {
        "types": "./lib/Hasher/WorkerLoader.d.ts",
        "bun": "./lib-bun/Hasher/WorkerLoader.js",
        "worker": "./lib-bun/Hasher/WorkerLoader.js",
        "default": "./lib/Hasher/WorkerLoader.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-2fe05486ecc6.tgz"
  },
  "devDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/cloudflare": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-316a192f4c8a.tgz"
  },
  "peerDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/cloudflare": "workspace:*",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/aws": {
      "optional": true
    }
  }
}
