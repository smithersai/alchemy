{
  "name": "@alchemy.run/turso",
  "version": "2.0.0-beta.84",
  "description": "Turso databases, groups and tokens for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "libsql",
    "turso"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/turso"
  },
  "files": [
    "lib",
    "src",
    "!lib/Database.platform.d.ts",
    "!lib/Database.platform.d.ts.map",
    "!lib/Hrana.platform.d.ts",
    "!lib/Hrana.platform.d.ts.map",
    "!lib/DatabaseToken.platform.d.ts",
    "!lib/DatabaseToken.platform.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ApiToken": "./src/ApiToken.vibe",
    "./AuthProvider": "./src/AuthProvider.vibe",
    "./Connect": "./src/Connect.vibe",
    "./Credentials": "./src/Credentials.vibe",
    "./Database": "./src/Database.vibe",
    "./DatabaseToken": "./src/DatabaseToken.vibe",
    "./Group": "./src/Group.vibe",
    "./GroupToken": "./src/GroupToken.vibe",
    "./Hrana": "./src/Hrana.vibe",
    "./ManageDatabases": "./src/ManageDatabases.vibe",
    "./OrganizationInvite": "./src/OrganizationInvite.vibe",
    "./OrganizationMember": "./src/OrganizationMember.vibe",
    "./OrganizationSettings": "./src/OrganizationSettings.vibe",
    "./Providers": "./src/Providers.vibe",
    "./*.vibe.raw": null,
    "./*": "./src/*.ts",
    "./package.json": "./package.json",
    "./Database.platform": null,
    "./Hrana.platform": null,
    "./DatabaseToken.platform": null
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*.vibe.raw": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json",
      "./Database.platform": null,
      "./Hrana.platform": null,
      "./DatabaseToken.platform": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/sql": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/turso": "workspace:*",
    "vibelang-runtime": "0.0.14-pre.56c503966164"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.14-pre.56c503966164",
    "vibelang-vite": "0.0.14-pre.56c503966164"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/turso/Contributions"
    ]
  }
}
