import { Credentials, DEFAULT_API_BASE_URL } from "@distilled.cloud/turso/Credentials"
import * as turso from "@distilled.cloud/turso/turso"
import * as Binding from "alchemy/Binding"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { ApiToken } from "./ApiToken.vibe"
import type { ConnectClient } from "./Connect.ts"
import type { DatabaseSeed } from "./Database.ts"
import type { Group } from "./Group.vibe"
import { GroupToken } from "./GroupToken.vibe"

/** A database in the managed group. */
export interface ManagedDatabase {
  /** Database name. */
  name: string
  /** Database UUID. */
  dbId: string
  /** DNS hostname of the database. */
  hostname: string
  /** libSQL URL (`libsql://<hostname>`). */
  url: string
}

export interface CreateManagedDatabaseOptions {
  /** Seed the new database from an existing database (e.g. a template). */
  seed?: DatabaseSeed
  /** Maximum size of the database, e.g. `"256mb"`. */
  sizeLimit?: string
}

export interface ManageDatabasesClient {
  /** Create a database in the group. */
  create(
    name: string,
    options?: CreateManagedDatabaseOptions,
  ): ManagedDatabase!turso.CreateDatabaseError!RuntimeContext
  /** Look up a database by name; `undefined` when it doesn't exist. */
  get(
    name: string,
  ): (ManagedDatabase | undefined)!turso.GetDatabaseError!RuntimeContext
  /** List every database in the group. */
  list(): ManagedDatabase[]!turso.ListDatabasesError!RuntimeContext
  /** Delete a database. Deleting a missing database succeeds. */
  delete(name: string): void!turso.DeleteDatabaseError!RuntimeContext
  /**
   * libSQL connection accessors for a database in the group, authorized by
   * a group-wide SQL token. Pass to `SQL.LibSQL` or `Drizzle.LibSQL`.
   */
  connect(name: string): ConnectClient
}

/**
 * Let a Worker create, list, delete, and query databases in one Turso
 * {@link Group}. Use it to give each customer their own database.
 *
 * The Worker gets an {@link ApiToken} that only works on that group, and a
 * {@link GroupToken} for running SQL. It can't touch databases in any other
 * group, and your own Turso API token stays on your machine.
 *
 * ### Database per tenant
 * **Example:** Create a tenant database on signup and query it
 * ```typescript
 * Effect.gen(function* () {
 *   const tenants = yield* Turso.ManageDatabases(Tenants);
 *   return {
 *     fetch: Effect.gen(function* () {
 *       const db = yield* tenants.create("acme");
 *       const sql = yield* SQL.LibSQL(tenants.connect(db.name));
 *       yield* sql`CREATE TABLE IF NOT EXISTS notes (body TEXT)`;
 *       return HttpServerResponse.text(db.url);
 *     }),
 *   };
 * }).pipe(Effect.provide(Turso.ManageDatabasesHttp));
 * ```
 *
 * @binding
 * @product Group
 */
export interface ManageDatabases extends
  Binding.Service<
    ManageDatabases,
    "Turso.ManageDatabases",
    (group: Group) => ManageDatabasesClient!!
  >
{}

export const ManageDatabases = Binding.Service<ManageDatabases>("Turso.ManageDatabases")

/** Implementation over the Turso Platform API, usable from any Platform host. */
export const ManageDatabasesHttp = Layer.effect(
  ManageDatabases,
  effect {
    const PlatformToken = try ApiToken
    const SqlToken = try GroupToken
    return effect (group: Group) => {
      const host = try Binding.Host
      const prefix = `${host?.LogicalId ?? ""}${group.LogicalId}`
      const apiToken = try PlatformToken(`${prefix}ManageToken`, {
        group: group.name,
        scopes: ["read", "db:create", "db:delete", "db:configure"],
      })
      const sqlToken = try SqlToken(`${prefix}SqlToken`, {
        group: group.name,
      })
      const apiKey = try apiToken.token.asEffect()
      const authToken = try sqlToken.token.asEffect()
      const organization = try group.organization.asEffect()
      const groupName = try group.name.asEffect()
      const location = try group.location.asEffect()

      const authorize = effect <A, E>(
        effect: A!E!(Credentials | HttpClient.HttpClient),
      ): A!E!RuntimeContext =>
        try effect {
          provide Layer.mergeAll(
                  Layer.succeed(
                    Credentials,
                    Effect.map(apiKey, (key) => ({ apiKey: key, apiBaseUrl: DEFAULT_API_BASE_URL })),
                  ),
                  FetchHttpClient.layer,
                ) {
            return try effect
          }
        }

      const toManaged = (db: {
        Name?: string
        DbId?: string
        Hostname?: string
      }): ManagedDatabase => ({
        name: db.Name ?? "",
        dbId: db.DbId ?? "",
        hostname: db.Hostname ?? "",
        url: `libsql://${db.Hostname}`,
      })

      const client: ManageDatabasesClient = {
        create: effect (name, options) =>
          try authorize(
            effect {
              const { database } = try turso.createDatabase({
                organizationSlug: try organization,
                name,
                group: try groupName,
                seed: options?.seed,
                size_limit: options?.sizeLimit,
              })
              return toManaged(database ?? {})
            },
          ),
        get: effect (name) =>
          try authorize(
            effect {
              return (effect { return (try effect {
                const { database } = try turso.getDatabase({
                  organizationSlug: try organization,
                  databaseName: name,
                })
                return database && database.group === (try groupName)
                  ? toManaged(database)
                  : undefined
              }) }) catch effect (e) => match (e) { when { _tag: "NotFound" }: undefined; default: throw e; }
            },
          ),
        list: effect () =>
          try authorize(
            effect {
              const { databases } = try turso.listDatabases({
                organizationSlug: try organization,
                group: try groupName,
              })
              return (databases ?? []).map(toManaged)
            },
          ),
        delete: effect (name) =>
          try authorize(
            effect {
              return (effect { return (try effect {
                try turso.deleteDatabase({
                  organizationSlug: try organization,
                  databaseName: name,
                })
              }) }) catch effect (e) => match (e) { when { _tag: "NotFound" }: (undefined as void); default: throw e; }
            },
          ),
        connect: (name) => ({
          // Turso hostnames are `<database>-<organization>.<location>.turso.io`,
          // so the URL is derived without a Platform API round-trip.
          url: effect {
            return `libsql://${name}-${try organization}.${try location}.turso.io`
          },
          authToken,
        }),
      }
      return client
    }
  },
)
